<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cortex.loop</string>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>WorkingDirectory</key>
  <string>.</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>bin/cortex-loop</string>
    <string>tick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin</string>
    <key>HTTP_PROXY</key>
    <string></string>
    <key>HTTPS_PROXY</key>
    <string></string>
    <key>CORTEX_DEFAULT_EXECUTOR</key>
    <string>cheap</string>
    <key>CORTEX_LAUNCHD_LABEL</key>
    <string>com.cortex.loop</string>
  </dict>
</dict>
</plist>
