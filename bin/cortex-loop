                      help="ok 才放开 llm-light/llm-heavy；其它一律 fail-closed 只放行 local-only")
    sel.set_defaults(func=cmd_select)

    exp = sub.add_parser("explain", help="统一底层真值解释：--node/--task/--topic 摊开现状/原因/证据三段")
    exp_grp = exp.add_mutually_exclusive_group(required=True)
    exp_grp.add_argument("--node", help="节点 id，如 laptop / worker")
    exp_grp.add_argument("--task", help="line/task_id，如 cortex-immune/IMM-T20")
    exp_grp.add_argument("--topic", choices=sorted(EXPLAIN_TOPICS),
                          help="机制名：%s" % ", ".join(sorted(EXPLAIN_TOPICS)))
    exp.set_defaults(func=cmd_explain)

    mi = sub.add_parser("match-idle", help="IMM-T33：只读诊断——owner 忙碌+未认领 pending+蜂群有空闲达标节点 时报配对建议")
    mi.add_argument("--line", help="只看这一条线（默认扫描 CLOCK.md 里全部 enabled 的线）")
    mi.add_argument("--no-fetch", action="store_true",
                    help="跳过网络 fetch_refs()，只读本地已缓存 ref（同 trust --no-fetch 的修复，见 IMM-T29）")
    mi.set_defaults(func=cmd_match_idle)

    args = parser.parse_args()
    if args.cmd in {
        "tick", "task-run", "submit", "try-complete", "run", "revive",
    }:
        ensure_guardrail_event_sources()
    # 账本命令不再和长 Worker 共用 tick 锁。每次字段写入由 set_cells() 在对应
    # TASKS.md 上做毫秒级原子 read-modify-replace；模型、网络、short_test 期间无锁。
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
