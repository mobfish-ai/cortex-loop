LOG = os.environ.get("CORTEX_LOOP_LOG", "/tmp/spotlight/cortex-loop.log")
ADAPTERS = os.environ.get("OC_ADAPTERS_DIR") or os.path.join(ROOT, "bin", "cortex-loop-adapters")
FAILURE_STATE = os.environ.get(
    "CORTEX_FAILURE_STATE",
    os.path.join(ROOT, ".git", "cortex-loop-state", "failures.json"),
)
_TASK_LOCK_HANDLES = {}
