#!/usr/bin/env python3
"""cortex-loop — CORTEX heartbeat engine (ledger / heartbeat / muscle, three parts)

Design invariants (read reports/2026-07-28/_standalone/cortex-loop-intent.md before changing):
  1. The ledger lives in git: CLOCK.md is scheduling truth, TASKS.md is execution truth
  2. The heartbeat has no LLM: tick/next/submit/try-complete/reconcile/health make zero model calls
  3. Muscle is swappable: the only LLM call site is the adapter; the loop knows no runtime
  4. Single writer: only try-complete may write status=done
  5. Never report green while the driver is red: health red → tick refuses to auto-advance

Subcommands:
  tick          scan every enabled line and compute tasks whose window is due (--auto really advances one round)
  next          render the next self-contained prompt to stdout (--claim also claims the slot as running)
  submit        take an execution result → write evidence / push the window; never writes done
  try-complete  independent completion gate: write done only when artifact + short_test pass
  reconcile     CLOCK declaration vs actual driver → report drift
  health        driver self-check; red means exit code 1
  status        human-readable overview

exit code: 0=ok / 1=red or failure / 2=usage error
"""

import argparse
import fcntl
import fnmatch
import hashlib
import json
import os
import re
import signal
import shlex
import shutil
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DIRECTIONS = os.path.join(ROOT, "brain-network", "directions")
CLOCK = os.path.join(DIRECTIONS, "CLOCK.md")
LOG = os.environ.get("CORTEX_LOOP_LOG", "/tmp/spotlight/cortex-loop.log")
ADAPTERS = os.environ.get("OC_ADAPTERS_DIR") or os.path.join(ROOT, "bin", "cortex-loop-adapters")
FAILURE_STATE = os.environ.get(
    "CORTEX_FAILURE_STATE",
    os.path.join(ROOT, ".git", "cortex-loop-state", "failures.json"),
)
_TASK_LOCK_HANDLES = {}
_ACTIVE_CHILD_PROC = None
_RUNNING_AS_CLI = __name__ == "__main__"
LEDGER_MUTATION_COMMANDS = frozenset({
    "task-add", "task-retry", "task-reopen", "task-hold", "task-resume",
    "task-route", "submit", "try-complete", "decompose",
})

TERMINAL = {"done"}
# settling = short_test has passed and only git propagation remains; not terminal, and not a claimable pending
SKIP = {"waiting_external", "blocked", "done", "settling"}
# A content conflict is not a transport wait: retrying the same candidate
# against an unchanged canonical tree cannot converge forever.  Keep one
# settling retry for a canonical tip that may move, then fail closed as an
# explicit machine blocker.
INTEGRATION_CONTENT_CONFLICT_MAX_RETRIES = 2
# Full set of task statuses (aligned with knowledge-contract-gate LOOP_TASK_STATUS)
TASK_STATUSES = {
    "pending", "running", "done", "waiting_external", "blocked", "settling",
}
TS = "%Y-%m-%dT%H:%M%z"
LEGACY_TS = "%Y-%m-%dT%H:%M"
# Measured anchor (2026-07-29): worker git ls-remote direct is 0-1s; laptop goes through the proxy chain
# mean 4s, and history has seen batch failures on 75s timeouts. 3s sits between the two and does not flap.
NET_GITHUB_FAST_THRESHOLD_S = 3


def swarm_name():
    """The swarm's own name. Without a name there can be only one swarm, and swarms cannot see each other.

    Source of truth = CLOCK.md frontmatter `swarm:`; CORTEX_SWARM may override it (used when several swarms share one repo).
    """
    if os.environ.get("CORTEX_SWARM"):
        return os.environ["CORTEX_SWARM"]
    if os.path.isfile(CLOCK):
        with open(CLOCK, encoding="utf-8") as fh:
            head = fh.read(2000)
        match = re.search(r"(?m)^swarm:\s*([A-Za-z0-9._-]+)\s*$", head)
        if match:
            return match.group(1)
    return "cortex"


SWARM_NAME = swarm_name()


def now():
    return datetime.now().astimezone()


def fmt(dt):
    return dt.strftime(TS)


def parse_ts(value):
    value = (value or "").strip()
    if not value or value == "-":
        return None
    for pattern in (TS, LEGACY_TS, "%Y-%m-%d"):
        try:
            parsed = datetime.strptime(value, pattern)
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=now().tzinfo)
            return parsed
        except ValueError:
            continue
    return None


def log(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a", encoding="utf-8") as fh:
        fh.write("%s | %s\n" % (fmt(now()), msg))


# ── Three classes of safety events: production decision point → atomic JSONL ──

def _incident_recording_enabled():
    """Enabled by default for real CLI runs; disabled by default on import unit tests, so a user HOME is not polluted."""
    configured = (os.environ.get("CORTEX_INCIDENT_RECORDING") or "").strip().lower()
    if configured:
        return configured in ("1", "true", "yes", "on")
    return _RUNNING_AS_CLI


def _guardrail_event_id(prefix, *parts):
    digest = hashlib.sha256("\0".join(str(v) for v in parts).encode("utf-8")).hexdigest()
    return "%s-%s" % (prefix, digest[:24])


def _run_incident_atom(script_name, argv):
    if not _incident_recording_enabled():
        return False
    script = os.path.join(ROOT, "bin", script_name)
    try:
        proc = subprocess.run(
            ["bash", script] + [str(v) for v in argv],
            cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=20, check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        log("guardrail-event ERROR %s %s" % (script_name, exc))
        return False
    if proc.returncode != 0:
        log("guardrail-event ERROR %s rc=%d %s" % (
            script_name, proc.returncode, proc.stderr.strip()[:240]))
        return False
    return True


def ensure_guardrail_event_sources():
    """Initialized atomically by the real engine; a Dashboard or human touch must not pretend it is already wired."""
    for script in (
        "cortex-authorization-incident.sh",
        "cortex-independent-verification-incident.sh",
        "cortex-budget-incident.sh",
    ):
        _run_incident_atom(script, ["init"])


def guardrail_bridge_status():
    script = os.path.join(ROOT, "bin", "cortex-guardrail-bridge-audit.py")
    try:
        proc = subprocess.run(
            ["python3", script, "status", "--json"],
            cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=20, check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return {"state": "UNKNOWN", "reason": str(exc)}
    if proc.returncode != 0:
        return {"state": "UNKNOWN", "reason": proc.stderr.strip()[:240]}
    try:
        return json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        return {"state": "UNKNOWN", "reason": "guardrail bridge status is not JSON"}


def auto_execution_allowed_by_guardrails():
    if (os.environ.get("CORTEX_ALLOW_GUARDRAIL_BREACH_AUTO") or "").lower() in (
        "1", "true", "yes", "on",
    ):
        return True, "breakglass override"
    status = guardrail_bridge_status()
    if status.get("incident_count", 0):
        return False, (
            "%s incidents; bridge_state=%s; recovery_gate=%s" % (
                status.get("incident_count"),
                status.get("state", "UNKNOWN"),
                status.get("recovery_gate", "human_review_required_before_resume"),
            )
        )
    return True, "no guardrail incidents"


def record_authorization_incident(line, task_id, incident_type, evidence, identity=None):
    event_id = _guardrail_event_id(
        "a", line, task_id, incident_type, evidence)
    return _run_incident_atom("cortex-authorization-incident.sh", [
        "record", task_id or "%s/unknown" % line, identity or node_id(),
        incident_type, evidence, event_id,
    ])


def record_budget_incident(line, task_id, incident_type, evidence, identity=None,
                           idempotency_key=""):
    event_id = _guardrail_event_id(
        "b", line, task_id, incident_type, idempotency_key or evidence)
    return _run_incident_atom("cortex-budget-incident.sh", [
        "record", task_id or "%s/unknown" % line, identity or node_id(),
        incident_type, evidence, event_id,
    ])


def is_model_quota_breach(text):
    """Only real quota exhaustion is a breach; a bare 429/rate-limit is just transient flow control."""
    low = (text or "").lower()
    return bool(re.search(
        r"quota(?:\s+|[-_])?(?:exhausted|exceeded|depleted)|"
        r"usage limit(?:\s+|[-_])?(?:reached|exceeded)|"
        r"insufficient (?:credit|quota)|out of (?:credit|quota)|"
        r"credit(?:s)? (?:exhausted|depleted)|"
        "\u989d\u5ea6(?:\u8017\u5c3d|\u7528\u5c3d|\u8d85\u9650|\u4e0d\u8db3)|\u914d\u989d(?:\u8017\u5c3d|\u7528\u5c3d|\u8d85\u9650|\u4e0d\u8db3)",
        low,
    ))


def record_model_quota_if_breach(line, task_id, executor, text, rule, rc=None):
    if not is_model_quota_breach(text):
        return False
    suppression = suppress_exec(executor, "quota")
    detail = (text or "").strip().split("\n")[-1][:240]
    evidence = ("rule=%s measured=1 budget=0 unit=successful-call "
                "executor=%s%s detail=%s" % (
                    rule, executor, " rc=%s" % rc if rc is not None else "", detail))
    return record_budget_incident(
        line, task_id, "model_quota_breach", evidence,
        idempotency_key="%s|%s|%s" % (
            executor, task_id, suppression.get("since", "unknown")))


def _explicit_completion_claim(body):
    """Accept only an explicit terminal declaration; an ordinary note or one test failure is not a false completion."""
    for raw in (body or "").splitlines():
        line = raw.strip()
        if re.fullmatch(r"(?i)(?:status|result|verdict)\s*[:=]\s*"
                        r"(?:done|pass(?:ed)?|accept(?:ed)?|complete(?:d)?)", line):
            return line[:240]
        if re.fullmatch(r"(?i)(?:done|pass(?:ed)?|accept(?:ed)?|complete(?:d)?)", line):
            return line[:240]
        if re.fullmatch("(?:\u72b6\u6001|\u7ed3\u679c|\u7ed3\u8bba)\\s*[:\uff1a]\\s*(?:\u5df2\u5b8c\u6210|\u5b8c\u6210|\u901a\u8fc7|\u9a8c\u6536\u901a\u8fc7|\u5df2\u9a8c\u6536)", line):
            return line[:240]
    return ""


def record_false_completion_if_claimed(line, task_id, result_file, failure,
                                        identity=None):
    try:
        with open(result_file, encoding="utf-8", errors="replace") as fh:
            body = fh.read(16000)
    except OSError:
        return False
    claim = _explicit_completion_claim(body)
    if not claim:
        return False
    failure = failure if isinstance(failure, dict) else {}
    stage = str(failure.get("stage") or "independent_check")
    detail = str(failure.get("detail") or "independent completion gate rejected")[:800]
    verification_kind = "short_test" if stage == "short_test" else (
        "try_complete" if stage in ("artifact", "contract", "judge", "state-cas")
        else "cross_artifact")
    evidence = "%s/%s stage=%s detail=%s" % (line, task_id, stage, detail)
    event_id = _guardrail_event_id("v", line, task_id, claim, stage, detail)
    return _run_incident_atom("cortex-independent-verification-incident.sh", [
        "record", task_id, identity or node_id(), "false_done_claim",
        verification_kind, claim, "rejected:%s" % stage, evidence, event_id,
    ])


# ── Markdown table read/write (the only truth is this table; do not keep a second cache) ──

def read_table(path, key="id"):
    """Return (lines, header, rows); rows = [(line number, {column name: value})].

    One file may contain several tables (a legend table + a data table). Recognize only the table whose **header contains the key column**,
    otherwise the "column meaning" legend is treated as the data table -- a real bug from the first smoke test on 2026-07-28.
    """
    if not os.path.isfile(path):
        return [], [], []
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().split("\n")
    header, rows, in_table, in_data = [], [], False, False
    for idx, line in enumerate(lines):
        stripped = line.strip()
        if not stripped.startswith("|"):
            in_table = in_data = False
            continue
        cells = [c.strip() for c in stripped.strip("|").split("|")]
        if not in_table:
            in_table = True
            # Recognize only the first table that hits the primary key; **a later table must not overwrite a header already accepted**.
            # The old code reset header on every new table, so "a legend table after the data table" would
            # wipe the header empty -- rows looked fine, header was empty, and the only writer set_cell raised
            # ValueError and crashed (not a red report: the whole tick aborted). This used to be an unspoken
            # constraint that "the data table must be the last table in the file". Found by test suite D-01.
            in_data = bool(key in cells and not header)
            if in_data:
                header = cells
            continue
        if not in_data or set("".join(cells)) <= set("-: "):
            continue                    # non-data-table row, or a separator row
        rows.append((idx, dict(zip(header, cells))))
    return lines, header, rows


def set_cell(path, row_id, column, value):
    """Atomic single-cell edit; the lock covers only the local read-modify-replace, not the network, tests, or a model."""
    return set_cells(path, row_id, {column: value})


def _ledger_lock_path(path):
    digest = hashlib.sha256(os.path.abspath(path).encode("utf-8")).hexdigest()[:20]
    return "/tmp/spotlight/cortex-ledger-%s.lock" % digest


def _atomic_write_lines(path, lines):
    tmp = "%s.%s.%s.tmp" % (path, os.getpid(), time.time_ns())
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines))
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def set_cells(path, row_id, updates, expected_status=None):
    """Atomically write several fields of one task; if concurrent state already changed, CAS refuses to overwrite the new truth."""
    for column, value in updates.items():
        if "|" in str(value):
            raise ValueError("field value must not contain '|' (it would break the table): %s" % value)
    os.makedirs("/tmp/spotlight", exist_ok=True)
    with open(_ledger_lock_path(path), "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        lines, header, rows = read_table(path)
        missing = [column for column in updates if column not in header]
        if missing:
            raise ValueError("column not in table: %s" % ",".join(missing))
        for idx, row in rows:
            if row.get("id") != row_id:
                continue
            if expected_status is not None:
                allowed = (expected_status if isinstance(expected_status, (tuple, list, set))
                           else (expected_status,))
                if row.get("status") not in allowed:
                    return False
            cells = [c.strip() for c in lines[idx].strip().strip("|").split("|")]
            while len(cells) < len(header):
                cells.append("")
            for column, value in updates.items():
                cells[header.index(column)] = str(value)
            lines[idx] = "| " + " | ".join(cells) + " |"
            _atomic_write_lines(path, lines)
            return True
    return False


# ── Swarm: node identity - self-awareness - group awareness ──
# Design point: many nodes writing one git ledger are a conflict source. The fix is not consensus; it is **sharding**:
# CLOCK.owner is kept only as a scheduling-affinity hint; it is no longer an execution admission gate.
# Real single-writer coordination is a short line lease plus task-level CAS/locks, so one machine cannot turn a whole line
# into a single point of failure.

SWARM = os.path.join(DIRECTIONS, "_swarm")


def node_id():
    """Stable node id.

    CORTEX_NODE wins. Otherwise the hostname is sanitized to [a-z0-9-].
    Optional CORTEX_NODE_ALIASES is a comma-separated substring=id list
    matched against the lowercased hostname, for operators who want a
    stable nickname without baking machine names into the source.
    Example: CORTEX_NODE_ALIASES=studio=worker,laptop=laptop
    """
    if os.environ.get("CORTEX_NODE"):
        return os.environ["CORTEX_NODE"]
    _, host = run("hostname", timeout=10)
    host = host.strip().lower()
    for pair in os.environ.get("CORTEX_NODE_ALIASES", "").split(","):
        if "=" not in pair:
            continue
        key, name = pair.split("=", 1)
        key, name = key.strip().lower(), name.strip().lower()
        if key and name and key in host:
            alias = re.sub(r"[^a-z0-9-]", "-", name)[:24]
            if alias:
                return alias
    return re.sub(r"[^a-z0-9-]", "-", host)[:24] or "unknown"


# A raw minimax/glm adapter can only generate text; it cannot read or write the workspace. It may be an atomic text tool,
# but it must never declare exec.* or enter the Worker ladder. The only cheap workspace executor is cheap:
# Claude Code tool layer + a CC Switch MiniMax account.
CHEAP_ADAPTER_PROVIDERS = {
    "minimax": "minimax,minimax-cn",
    "glm": "zhipu",
    "cheap": "minimax,minimax-cn",
}
WORKSPACE_CHEAP_EXECUTORS = ("cheap",)
# L2 headless policy lane (Grok-first - DECIDE auto-continue); it does not join the default ladder to compete with cheap
L2_HEADLESS_EXECUTORS = ("acp-lane",)
TEXT_ONLY_ADAPTERS = ("minimax", "glm")


def _oc_provider_key_present(providers_csv):
    """Whether models.providers.<name> in openclaw.json has at least one apiKey (either the single field or
    any entry of the apiKeys[] array). providers_csv is comma-separated and can test several candidate providers (true if one hits).
    If openclaw.json cannot be read or parsed → return False honestly; do not guess."""
    oj_path = os.environ.get("OPENCLAW_JSON_PATH",
                              os.path.expanduser("~/.openclaw/openclaw.json"))
    try:
        with open(oj_path, encoding="utf-8") as fh:
            oj = json.load(fh)
    except Exception:                                  # noqa: BLE001
        return False
    providers = oj.get("models", {}).get("providers", {})
    for name in providers_csv.split(","):
        p = providers.get(name.strip())
        if isinstance(p, dict) and (p.get("apiKey") or p.get("apiKeys")):
            return True
    return False


def _cheap_worker_ready(adapter):
    """Check the real workspace surface: Claude CLI + a CC Switch MiniMax account."""
    code, out = run("timeout 30 bash %s --check-ready 2>&1"
                    % shlex.quote(adapter), timeout=40)
    return code == 0, out.strip().split("\n")[-1][:160]


def _acp_lane_ready(adapter):
    """Check acp-lane: the adapter + acp-policy-client can dry-run / are ready."""
    code, out = run("timeout 20 bash %s --check-ready 2>&1"
                    % shlex.quote(adapter), timeout=30)
    return code == 0, out.strip().split("\n")[-1][:160]


def resolve_task_executor(task, line_executor):
    """Task-level executor resolution (explicit wins).

    Order:
      1) task.requires_executor (non-empty and not -)
      2) CLOCK line default executor
      3) CORTEX_DEFAULT_EXECUTOR
      4) human
    So when "CLOCK=cheap", a single task can still set requires_executor=acp-lane and take the L2 lane.
    """
    req = ""
    if isinstance(task, dict):
        req = (task.get("requires_executor") or "").strip()
    if req and req not in ("-", ""):
        return req
    line_ex = (line_executor or "").strip()
    if line_ex and line_ex not in ("-", ""):
        return line_ex
    env_ex = (os.environ.get("CORTEX_DEFAULT_EXECUTOR") or "").strip()
    if env_ex:
        return env_ex
    return "human"


# Task contracts retain the provider-facing executor identity, while adapter
# filenames use a safe vocabulary (POSIX `:` is legal but needlessly fragile
# across shells, archives, and pathspec tooling).
EXECUTOR_ADAPTER_ALIASES = {
    "acp-native:mmx-a": "acp-native-mmx-a",
    "acp-native:mmx-b": "acp-native-mmx-b",
    "acp-native:mmx-d": "acp-native-mmx-d",
    "acp-native:deepseek": "acp-native-deepseek",
    "acp-native:codex-luna": "acp-native-codex-luna",
    "acp-native:codex-spark": "acp-native-codex-spark",
}


def executor_adapter_name(executor):
    return EXECUTOR_ADAPTER_ALIASES.get(executor, executor)


def executor_adapter_path(executor):
    return os.path.join(ADAPTERS, "%s.sh" % executor_adapter_name(executor))


def node_profile():
    """Self-awareness: what this machine is, what it can do, and whether it may sleep.

    can_sleep is a critical swarm field -- it decides whether "this node went quiet" should count as a fault:
    a laptop going quiet with the lid closed is normal; a server going quiet is offline.

    IMM-T38: also carries joined_at / samples_total -- join time + cumulative heartbeat sample count.
    Both come entirely from local disk via _peek_node_state() (the state file), not computed inside this function,
    and last_seen must not be passed off as joined_at; that is the negative lesson of E004.

    IMM-T39: also carries trust_target / trust_now / trust_gap -- the node-level trust target.
    trust_target defaults to L3 (G5 swarm-wide trust floor = 0.70, same source as EXPECTATIONS EX03).
    The G6 health-score target is not pushed down to node level: node trust is C2's concern, G6 is the health score's concern.
    trust_now computes haas_score(me) once; trust_gap is the gap string between trust_target and current actual trust,
    shown by explain / swarm / dashboard so "how far short" is visible.
    """
    code, batt = run("pmset -g batt 2>/dev/null", timeout=10)
    is_laptop = "InternalBattery" in batt
    _, pm = run("pmset -g 2>/dev/null | grep SleepDisabled", timeout=10)
    sleep_disabled = "1" in pm.split()[-1:] if pm.strip() else False
    executors = []
    for name, probe in (("claude", "claude"), ("codex", "codex"),
                        ("openclaw", "openclaw"), ("ollama", "ollama"),
                        ("human", None), ("mock", None)):
        adapter = os.path.join(ADAPTERS, "%s.sh" % name)
        if not os.path.isfile(adapter):
            continue
        if probe is None or run("command -v %s" % probe, timeout=10)[0] == 0:
            executors.append(name)
    for name in WORKSPACE_CHEAP_EXECUTORS:
        adapter = os.path.join(ADAPTERS, "%s.sh" % name)
        ready, _ = _cheap_worker_ready(adapter) if os.path.isfile(adapter) else (False, "")
        if ready:
            executors.append(name)
    for name in L2_HEADLESS_EXECUTORS:
        adapter = os.path.join(ADAPTERS, "%s.sh" % name)
        if not os.path.isfile(adapter):
            continue
        ready, _ = _acp_lane_ready(adapter)
        if ready:
            executors.append(name)
    _, tg = run("curl -s -o /dev/null -w '%{http_code}' --max-time 8 "
                "https://api.telegram.org  # 2026-10-04 migration: proxy 10794 retired (dead-proxy shim retirement prerequisite), exit node tunnel direct egress", timeout=20)
    me = node_id()
    joined_at, samples_total = _peek_node_state(me)
    # IMM-T39 EX10: node-level trust target = L3 (>=0.70), aligned with the G5 group floor.
    # Orchestrator nodes orchestrator-* are an independent role (architecture.md § six laws, three gates),
    # and their trust_target must be L4: irreversible tasks require >=L4 and a human signature (C3).
    # If the orchestrator is only L1, the swarm effectively has no edit authority -- the score path is self_credit / fault.
    is_orchestrator = me == orchestrator_id()
    trust_target = "L4" if is_orchestrator else "L3"
    # Current actual trust = haas_score computed now; no samples (meta.samples=0) means UNKNOWN.
    # Consume it immediately after computing -- this is "snapshot" semantics, not a "fake promise". EX10 acceptance only checks that the field
    # is persisted and can be read back; it does not require recomputing on every profile read (recompute slows query-heavy paths,
    # same lesson as IMM-T29 trust-perf).
    trust_now_score, trust_now_meta = haas_score(me)
    trust_now_samples = int((trust_now_meta or {}).get("samples", 0) or 0)
    if trust_now_samples == 0:
        trust_now = "unknown"
        trust_gap = "?"
    else:
        trust_now = trust_level(trust_now_score)
        # Gap = target rank index - current rank index; negative = already past the target, positive = still N ranks short.
        _order = [name for name, _ in TRUST_LEVELS]
        _gap = _order.index(trust_target) - _order.index(trust_now)
        trust_gap = "exceed by %d" % -_gap if _gap < 0 else (
            "?" if _gap == 0 and trust_now == "unknown" else "short by %d" % _gap)
    return {
        "node": me,
        "swarm": SWARM_NAME,
        "caps": " ".join(node_capabilities()),
        "kind": "laptop" if is_laptop else "always-on",
        "can_sleep": "no" if (not is_laptop or sleep_disabled) else "yes",
        "executors": " ".join(executors) or "-",
        "telegram_reach": "yes" if tg.strip().startswith(("2", "3")) else "no",
        "last_seen": now().strftime("%Y-%m-%dT%H:00"),  # hour precision = no diff within one hour, so git stays quiet
        "joined_at": joined_at or fmt(now()),  # IMM-T38 EX09: join time; if state is missing, persist "now" and force a write
        "samples_total": samples_total,        # IMM-T38 EX09: cumulative heartbeat samples; 0 means unobserved, not zero beats
        "owns": " ".join(e["line"] for e in clock_lines()
                         if e.get("owner") == me) or "-",
        # IMM-T39 EX10: node-level trust target (aligned with the G5 group floor, plus one rank for the orchestrator)
        "trust_target": trust_target,
        "trust_now": trust_now,
        "trust_gap": trust_gap,
    }



# ── Capability schema (minimal atomic form) ──
# A capability is a set of string IDs. Declare = one line in the beat payload; discover = read every swarm beat;
# route = a set-membership test. That simple, and enough to evolve: a capability ID can later carry a version or params without breaking the protocol.
#
# Namespace convention (dot-separated levels; the prefix is the category):
#   exec.*     which executor can run (claude / codex / openclaw / human / mock)
#   host.*     machine shape (always-on / laptop)
#   os.*       operating system (darwin / linux)
#   runtime.*  local scheduler (launchd / systemd / cron)
#   net.*      network reachability (telegram / github)
#   tool.*     which tools are installed (git / python3 / docker / ollama)

EXEC_STATE = "/tmp/spotlight/cortex-loop-exec-state.json"
NODE_STATE = "/tmp/spotlight/cortex-loop-node-state.json"   # IMM-T38 node-profile join time + cumulative samples
QUOTA_WINDOW_H = 5      # subscription quota resets on a 5-hour window; once the window passes it recovers on its own


def _load_exec_state():
    import json as _json
    if not os.path.isfile(EXEC_STATE):
        return {}
    try:
        with open(EXEC_STATE, encoding="utf-8") as fh:
            return _json.load(fh)
    except Exception:                              # noqa: BLE001
        return {}


def _save_exec_state(state):
    import json as _json
    os.makedirs(os.path.dirname(EXEC_STATE), exist_ok=True)
    with open(EXEC_STATE, "w", encoding="utf-8") as fh:
        _json.dump(state, fh, ensure_ascii=False, indent=2)


def _load_node_state():
    """Per-node local ledger: the timestamp when each node was first seen, plus the cumulative heartbeat sample count.
    Persisted at /tmp/spotlight/cortex-loop-node-state.json -- the heartbeat does not use it to write identity,
    only to record "when this node joined the swarm" and "how many beats have been counted", so later profile writes
    get real on-disk values for joined_at / samples_total and avoid drift from computing them at runtime
    (IMM-T38: an empty runtime print was called out for this)."""
    import json as _json
    if not os.path.isfile(NODE_STATE):
        return {}
    try:
        with open(NODE_STATE, encoding="utf-8") as fh:
            data = _json.load(fh)
        return data if isinstance(data, dict) else {}
    except Exception:                              # noqa: BLE001
        return {}


def _save_node_state(state):
    import json as _json
    os.makedirs(os.path.dirname(NODE_STATE), exist_ok=True)
    with open(NODE_STATE, "w", encoding="utf-8") as fh:
        _json.dump(state, fh, ensure_ascii=False, indent=2)


def _bump_node_state(node):
    """Read and update this node's state in place: the first sighting writes joined_at;
    each call increments samples_total and returns (joined_at, samples_total).

    The return value is not flattened to hour precision -- heartbeat counts are a monotonic integer, and the profile writer
    chooses display precision itself (a different meaning from last_seen hour precision)."""
    state = _load_node_state()
    rec = state.get(node) if isinstance(state.get(node), dict) else {}
    if not rec.get("joined_at"):
        rec["joined_at"] = fmt(now())
    rec["samples_total"] = int(rec.get("samples_total", 0) or 0) + 1
    state[node] = rec
    try:
        _save_node_state(state)
    except Exception as exc:                       # noqa: BLE001
        log("node state persist failed node=%s err=%s" % (node, exc))
    return rec["joined_at"], rec["samples_total"]


def _peek_node_state(node):
    """Read-only: for pure query paths (when node_profile does not write disk).
    Missing records return an empty string / 0 -- under the DIMENSIONAL law this is the tri-state "unobserved",
    and the caller must not misread it as "just joined" or "zero samples"."""
    rec = _load_node_state().get(node) or {}
    return rec.get("joined_at", "") or "", int(rec.get("samples_total", 0) or 0)


def exec_suppressed(name):
    """Is this executor in a suppression window? Returns (suppressed?, reason, minutes left).

    Why it must exist: `command -v claude` **still succeeds when quota is exhausted** -- the command is there, it just cannot run.
    Declaring a capability from command presence alone is a **false declaration**: the task is dispatched, one call is burned, then it cannot do the work,
    and the failure also deducts HAAS. Capability declarations must consult revive's latest diagnosis, not only whether the command exists.

    Quota suppression **expires on its own** (5-hour window reset) → the capability returns at that time with no human intervention.
    That is "quota-window crash immunity": step out automatically when exhausted, rejoin automatically when the window passes.
    """
    rec = _load_exec_state().get(name)
    if not rec:
        return False, "", 0
    until = parse_ts(rec.get("until"))
    if until is None or until <= now():
        return False, "", 0
    return True, rec.get("kind", "unknown"), int((until - now()).total_seconds() // 60)


def suppress_exec(name, kind, hours=None):
    """Mark an executor as entering suppression. Quota kinds expire on the 5-hour window; auth kinds need a human, so they are marked longer."""
    hours = hours if hours is not None else (QUOTA_WINDOW_H if kind == "quota" else 12)
    state = _load_exec_state()
    existing = state.get(name) or {}
    until = parse_ts(existing.get("until"))
    if existing.get("kind") == kind and until is not None and until > now():
        return existing
    state[name] = {"kind": kind, "since": fmt(now()),
                   "until": fmt(now() + timedelta(hours=hours))}
    _save_exec_state(state)
    return state[name]


def clear_exec(name):
    state = _load_exec_state()
    if state.pop(name, None) is not None:
        _save_exec_state(state)


# ── Model tiering: when quota is tight, step down a tier instead of stopping ──
# operator 2026-07-29: Opus burns quota fast, Sonnet can run longer -- the system should allocate intelligently.
# Core judgment: **stepping down a tier != a degraded failure**. Filling contract fields, registering a skill, writing ERRORS --
# Sonnet is fully enough for that work, and Opus is pure quota waste. So the default should be balanced,
# and only tasks that explicitly need strong reasoning get frontier. When quota is critical, step down one tier at a time, and stop only at the end.
MODEL_TIERS = [
    ("frontier", "cortex.tier.frontier", "strong reasoning: architecture decisions / cross-domain inference / adversarial review"),
    ("balanced", "cortex.tier.balanced", "default tier: most structured fixes, field backfill, and docs"),
    ("fast",     "cortex.tier.fast",     "quota-saving: formatting, extraction, simple rewrites"),
    ("local",    "",                     "local fallback: ollama, when offline or quota is fully exhausted"),
]


def tier_model(policy_role):
    """Read the unified policy source before every call; env/file hot-swap is supported; unreadable means fail closed."""
    if not policy_role:
        return ""
    resolver = os.path.join(ROOT, "bin", "model-policy.sh")
    try:
        proc = subprocess.run(
            ["bash", resolver, "get", policy_role],
            cwd=ROOT, text=True, capture_output=True, timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return proc.stdout.strip().splitlines()[-1] if proc.returncode == 0 and proc.stdout.strip() else ""


def pick_model(task=None):
    """Pick a tier from "task need x current quota state". Returns (tier, model, reason).

    Step-down order is frontier → balanced → fast → local, **one tier at a time**, not a single jump to a full stop.
    A task may declare requires=tier.frontier when it really needs strong reasoning; with no declaration it uses balanced.
    """
    need = ""
    if task:
        need = next((c.split(".", 1)[1] for c in (task.get("requires") or "").split()
                     if c.startswith("tier.")), "")
    start = 0 if need == "frontier" else 1          # start at balanced by default; do not burn Opus by default
    for idx in range(start, len(MODEL_TIERS)):
        tier, policy_role, why = MODEL_TIERS[idx]
        if tier == "local":
            hushed, _, _ = exec_suppressed("ollama")
            if not hushed and "exec.ollama" in " ".join(node_capabilities()):
                return tier, model, "stepped down to local fallback: %s" % why
            continue
        model = tier_model(policy_role)
        if not model:
            continue
        hushed, kind, left = exec_suppressed("claude:%s" % tier)
        if hushed:
            continue                                 # this tier is in suppression; step down
        note = why if idx == start else "stepped down from %s (upper tier quota-limited)" % MODEL_TIERS[start][0]
        return tier, model, note
    return None, "", "every model tier is unavailable → fall back to L2 pure-code mode"


def cmd_model(args):
    """Show each tier's availability and the pick result -- quota state at a glance."""
    print("swarm %s | node %s | model tiers" % (SWARM_NAME, node_id()))
    print("| tier | model | status | purpose |")
    print("|------|------|------|------|")
    for tier, policy_role, why in MODEL_TIERS:
        model = tier_model(policy_role) if policy_role else ""
        key = "ollama" if tier == "local" else "claude:%s" % tier
        hushed, kind, left = exec_suppressed(key)
        state = "suppressed (%s, %d minutes left)" % (kind, left) if hushed else "available"
        print("| %s | %s | %s | %s |" % (tier, model or "ollama", state, why))
    t, m, why = pick_model()
    print("\nCurrent default tier: **%s** (%s) -- %s" % (t or "none", m or "-", why))
    print("The default does not start at frontier -- Sonnet is enough for most work, and Opus wastes quota.")
    print("When a task really needs strong reasoning, set requires=tier.frontier.")
    return 0


def probe_executor_model(name):
    """What model **actually** runs behind an executor, and who pays for it.

    Measured on 2026-07-29: both nodes declared exec.claude, but the laptop was Opus (Max subscription),
    and the worker was a Claude Code shell pointed at MiniMax-M2.7 on api.minimax.io (API key).
    **Same name, different thing**. Reporting only the executor name hides "the capability gap is huge" --
    a task is silently sent to a node that cannot run it, and the ledger shows nothing wrong.

    Returns (model_id, billing, tier); if it cannot be read, mark unknown honestly and do not guess.

    **Why it must be probed, not self-reported**: if a node can declare "I am Opus", the swarm is led by a disguise --
    the task is actually finished by a small model, and the ledger still shows everything normal.
    This reads the **process's real environment variables**; a harder layer is `cortex-loop attest`, where the model signs for itself.
    """
    if name == "claude":
        base = os.environ.get("ANTHROPIC_BASE_URL", "")
        model = os.environ.get("ANTHROPIC_MODEL", "")
        if base or model:
            host = re.sub(r"^https?://|/.*$", "", base) or "unknown-host"
            provider = host.split(".")[-2] if "." in host else host
            return (model or "unknown").lower(), "api-key", provider
        if os.environ.get("ANTHROPIC_API_KEY"):
            return "anthropic-default", "api-key", "anthropic"
        return "anthropic-subscription", "subscription", "anthropic"
    if name == "codex":
        return "openai-codex", "subscription", "openai"
    if name == "acp-native:codex-luna":
        return "gpt-5.6-luna", "subscription-codex-luna", "openai"
    if name == "acp-native:codex-spark":
        return os.environ.get("CORTEX_CODEX_SPARK_MODEL", "gpt-5.3-codex-spark"), "subscription-codex-spark", "openai"
    if name == "openclaw":
        return "openclaw-routed", "mixed", "openclaw"
    if name == "minimax":
        return "minimax-m2.7", "api-key", "minimax"
    if name == "glm":
        return "glm-4-flash", "api-key", "zhipu"
    if name == "cheap":
        # cheap has been upgraded to a MiniMax-backed Claude Code tool layer; raw GLM completion
        # has no workspace execution capability and must not pose again as a swappable executor fallback.
        return "minimax-m2.7", "api-key", "minimax"
    if name == "acp-lane":
        # L2 headless: Grok backend by default + DECIDE auto-continue; the model follows policy/backend
        backend = (os.environ.get("CORTEX_ACP_BACKEND") or "grok").strip().lower()
        return "acp-lane-%s" % backend, "api-key", backend
    return name, "none", "local"


def node_capabilities():
    """Probe the capabilities this node really has -- all live probes, no config reads, no declarations.

    Exception: cheap-tier (minimax/glm/cheap) has no CLI command to probe; `command -v` cannot see an
    HTTP adapter. "Live probe" falls back to an equally honest substitute -- check whether the matching
    provider in openclaw.json has a key configured (present = allowed to declare, not proof a real request succeeded). The real
    call outcome is still covered by the adapter's own multi-key rotation + exec_suppressed(); do not repeat that here.
    """
    caps = []
    for name, probe in (("claude", "claude"), ("codex", "codex"),
                        ("openclaw", "openclaw"), ("human", None), ("mock", None)):
        if not os.path.isfile(os.path.join(ADAPTERS, "%s.sh" % name)):
            continue
        if probe is None or run("command -v %s" % probe, timeout=10)[0] == 0:
            hushed, why, left = exec_suppressed(name)
            if hushed:
                # command exists but cannot run -- do not declare it, or a dispatched task burns one call for nothing
                continue
            caps.append("exec.%s" % name)
            if probe is not None:      # only executors that really call a model report model and billing
                model, billing, provider = probe_executor_model(name)
                caps.append("model.%s.%s" % (provider, re.sub(r"[^a-z0-9.-]", "-", model)))
                caps.append("billing.%s" % billing)

    for name in WORKSPACE_CHEAP_EXECUTORS:
        if not os.path.isfile(os.path.join(ADAPTERS, "%s.sh" % name)):
            continue
        ready, _ = _cheap_worker_ready(os.path.join(ADAPTERS, "%s.sh" % name))
        if not ready:
            continue
        hushed, why, left = exec_suppressed(name)
        if hushed:
            continue
        caps.append("exec.%s" % name)
        model, billing, provider = probe_executor_model(name)
        caps.append("model.%s.%s" % (provider, re.sub(r"[^a-z0-9.-]", "-", model)))
        caps.append("billing.%s" % billing)

    for name in L2_HEADLESS_EXECUTORS:
        adapter = os.path.join(ADAPTERS, "%s.sh" % name)
        if not os.path.isfile(adapter):
            continue
        ready, _ = _acp_lane_ready(adapter)
        if not ready:
            continue
        hushed, why, left = exec_suppressed(name)
        if hushed:
            continue
        caps.append("exec.%s" % name)
        model, billing, provider = probe_executor_model(name)
        caps.append("model.%s.%s" % (provider, re.sub(r"[^a-z0-9.-]", "-", model)))
        caps.append("billing.%s" % billing)
        caps.append("lane.l2-headless")

    # Raw completion may still be used by atomic tools, but it stays explicitly in the text.* namespace,
    # so a selector cannot mistake them for a Worker that can Edit/Bash.
    for name in TEXT_ONLY_ADAPTERS:
        providers_csv = CHEAP_ADAPTER_PROVIDERS[name]
        if os.path.isfile(os.path.join(ADAPTERS, "%s.sh" % name)) \
                and _oc_provider_key_present(providers_csv):
            caps.append("text.%s" % name)

    code, batt = run("pmset -g batt 2>/dev/null", timeout=10)
    is_laptop = "InternalBattery" in batt
    caps.append("host.laptop" if is_laptop else "host.always-on")

    _, uname = run("uname -s", timeout=10)
    caps.append("os.%s" % uname.strip().lower() or "os.unknown")

    for tool in ("git", "python3", "docker", "ollama", "rsync"):
        if run("command -v %s" % tool, timeout=10)[0] == 0:
            caps.append("tool.%s" % tool)

    if run("command -v launchctl", timeout=10)[0] == 0:
        caps.append("runtime.launchd")
    if run("command -v systemctl", timeout=10)[0] == 0:
        caps.append("runtime.systemd")

    _, tg = run("curl -s -o /dev/null -w '%{http_code}' --max-time 8 "
                "https://api.telegram.org  # 2026-10-04 migration: proxy 10794 retired (dead-proxy shim retirement prerequisite), exit node tunnel direct egress", timeout=20)
    if tg.strip().startswith(("2", "3")):
        caps.append("net.telegram")
    started = time.time()
    ok = run("git ls-remote --exit-code origin HEAD >/dev/null 2>&1", timeout=90)[0] == 0
    latency = time.time() - started
    caps.extend(_github_latency_caps(ok, latency))
    return sorted(set(caps))


def _github_latency_caps(ok, latency):
    """git ls-remote probe result → capability label. Split into a pure function only so it is testable (no real network).

    Measured anchor (2026-07-29): worker direct is 0-1s; laptop via the proxy chain is normally 4s,
    and history has seen batch failures on 75s timeouts. A task with dense ledger writes may declare requires:
    net.github.fast, and automatically avoid nodes whose proxy chain is longer and more prone to jitter.
    """
    if not ok:
        return []
    return ["net.github",
            "net.github.fast" if latency < NET_GITHUB_FAST_THRESHOLD_S else "net.github.slow"]


def cmd_caps(args):
    """Capability discovery: who in the swarm has what, and the swarm-wide capability union."""
    fetch_refs()
    nodes = read_swarm()
    if not nodes:
        print("swarm empty (run sync first)")
        return 1
    all_caps = sorted({c for n in nodes.values() for c in (n.get("caps") or "").split()})
    print("swarm %s | %d nodes | %d capabilities" % (SWARM_NAME, len(nodes), len(all_caps)))
    print()
    width = max(len(c) for c in all_caps) if all_caps else 10
    header = "| %-*s |" % (width, "capability") + "".join(" %-9s |" % n for n in sorted(nodes))
    print(header)
    print("|" + "-" * (width + 2) + "|" + "".join("-" * 11 + "|" for _ in nodes))
    for cap in all_caps:
        row = "| %-*s |" % (width, cap)
        for name in sorted(nodes):
            has = cap in (nodes[name].get("caps") or "").split()
            row += " %-9s |" % ("✅" if has else "·")
        print(row)
    print()
    # A single-node capability is a swarm weak point: if that machine dies, the capability is gone
    single = [c for c in all_caps
              if sum(1 for n in nodes.values() if c in (n.get("caps") or "").split()) == 1]
    if single:
        print("⚠️ Single-point capabilities (only one node has them; if that node dies, the capability is lost):")
        for cap in single:
            owner = [n for n, v in nodes.items() if cap in (v.get("caps") or "").split()][0]
            print("   %-22s only %s" % (cap, owner))
    return 0


def write_profile(prof=None):
    """Write a node profile. Passing prof can write a node that is not this machine (the main thread uses it for the orchestrator profile) --
    parity requires sharing one persist path, not a second format just for the main thread.

    IMM-T38: write joined_at / samples_total into the profile markdown table, so
    "join time + cumulative samples" is part of git history rather than a runtime computation.
    Field values come from _bump_node_state() / _peek_node_state() -- already forced to disk,
    and last_seen is no longer passed off as first_seen (E004 negative lesson).

    IMM-T39: write trust_target / trust_now / trust_gap into the profile markdown table.
    Node-level trust target = L3 (orchestrator nodes step up to L4), aligned with the G5 group floor (>=0.70 = L3) --
    swarm-wide trust is limited by the weakest node, and without a node-level target G5 stays nominal forever.
    trust_now and trust_gap are persisted together, so the next swarm / dashboard / explain beat can read them
    without computing on the spot -- EX10 acceptance only checks that the fields are in the profile, not that every read recomputes haas_score.

    Only the self-refresh path (prof=None, i.e. a self tick / swarm command) bumps the cumulative sample count;
    an externally passed prof (writing the orchestrator / a debug write of another node) only peeks and does not bump, so
    a remote write does not also scramble another node's sample count.
    """
    os.makedirs(SWARM, exist_ok=True)
    if prof is None:
        prof = node_profile()
        # Self-refresh = hard evidence of "I am here": write the file and the local state.
        joined_at, samples_total = _bump_node_state(prof["node"])
        prof["joined_at"] = joined_at
        prof["samples_total"] = samples_total
    path = os.path.join(SWARM, "%s.md" % prof["node"])
    body = ["---", "type: loop_node", "node: %s" % prof["node"],
            "status: active", "---", "",
            "# Node profile — %s" % prof["node"], "",
            "> Auto-generated (`cortex-loop swarm`). `last_seen` uses hour precision:",
            "> repeated ticks within one hour do not change the content → no git diff → swarm heartbeats do not create commit noise.",
            "> `joined_at` join time + `samples_total` cumulative heartbeat samples come from the local ledger (IMM-T38),",
            "> do not replace the former with `last_seen`, and do not allow print-only with no persist.",
            "> `trust_target` node-level trust target (IMM-T39 EX10):",
            "> aligned with the G5 group floor L3 (>=0.70); orchestrator nodes step up to L4.",
            "> `trust_now` / `trust_gap` are computed once by `node_profile()` on self-refresh and then persisted,",
            "> not computed on the query path -- same lesson as IMM-T29 trust-perf.", "",
            "| field | value |", "|------|-----|"]
    for key in ("node", "kind", "can_sleep", "executors", "telegram_reach",
                "last_seen", "joined_at", "samples_total", "owns",
                "trust_target", "trust_now", "trust_gap"):
        body.append("| %s | %s |" % (key, prof.get(key, "-" if key != "joined_at" else "unknown")))
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(body) + "\n")
    return prof


def commit_own_profile(prof):
    """Commit the profile file just written by write_profile() into git history (IMM-T30 root-cause fix).

    Root cause: write_profile() only writes the worktree file and never commits. On a machine with a human/agent session
    (laptop) the file rides along on some other human commit; a pure systemd/launchd
    unattended heartbeat machine (worker) never has a human commit -- the file stays forever at
    "modified, not committed", so the profile the laptop fetches is always a snapshot from days ago and looks
    offline, while the heartbeat (journalctl beat=ok) has been beating the whole time; only the check-in signal never comes back.
    The 30-minute sync window in `git-sync-v4.sh` does not cover this path either (its
    commit_worker_jobs() only recognizes jobs.json) -- each side assumes the other is handling it.

    Commit only this one file (the producer:path allowlist in `git-commit-transaction.sh` already
    includes `cortex-loop-checkin:brain-network/directions/_swarm/*.md`; see that file).
    Commit only, do not push -- push is left to the next git-sync beat's safe transaction
    (acquire_tx_lock + validate_candidate_range + push_exact),
    and do not reimplement push/conflict handling here, or the two push paths will fight.
    """
    node = prof.get("node") if prof else None
    if not node:
        return
    path = os.path.join(SWARM, "%s.md" % node)
    if not os.path.isfile(path):
        return
    rel = os.path.relpath(os.path.abspath(path), ROOT)
    # Decouple the execution plane from the settlement plane: if the commit transaction lock is held, skip the profile commit and never block this beat's claim.
    # A profile is only a heartbeat-visibility optimization; claim/short_test do not depend on it reaching origin.
    tx_lock = os.path.join(ROOT, ".git", "ob1-transaction.lock.d")
    code_gp, gp = git("rev-parse --git-path ob1-transaction.lock.d", timeout=10)
    if code_gp == 0 and (gp or "").strip():
        tx_lock = (gp or "").strip()
        if not os.path.isabs(tx_lock):
            tx_lock = os.path.join(ROOT, tx_lock)
    if os.path.isdir(tx_lock):
        log("commit_own_profile: skip — git commit transaction lock busy (does not block claim)")
        return
    code, out = git("status --porcelain -- %s" % shlex.quote(rel), timeout=15)
    if code != 0:
        log("commit_own_profile: git status failed rc=%s" % code)
        return
    if not out.strip():
        return   # no change: under hour precision most beats hit this and must not create commit noise
    helper = os.path.join(ROOT, "bin", "git-auto-commit.sh")
    if not os.path.isfile(helper):
        log("commit_own_profile: %s missing, skip" % helper)
        return
    msg = "sync(checkin): refresh %s node profile last_seen" % node
    cmd = "%s --producer cortex-loop-checkin -m %s -- %s" % (
        shlex.quote(helper), shlex.quote(msg), shlex.quote(rel))
    # Short timeout: a profile commit may be deferred and must not stall the whole beat
    code, out = run("cd %s && %s" % (shlex.quote(ROOT), cmd), timeout=25)
    if code == 0:
        log("commit_own_profile: %s committed" % rel)
    elif code == 3:
        pass  # transaction layer decided "no substantive change", same judgment as this function, not an error
    elif code == 75:
        log("commit_own_profile: skip rc=75 transaction busy (does not block claim)")
    else:
        log("commit_own_profile: %s commit failed rc=%s out=%s"
            % (rel, code, out.strip()[-200:]))


def beat_publish(prof):
    """Push this node's own heartbeat to refs/swarm/beat/<node>.

    Write only our own ref → other nodes never touch it → a conflict is structurally impossible.
    parent points at our previous beat, so it fast-forwards and does not need --force.
    """
    ref = "%s/%s" % (BEAT_NS, prof["node"])
    old = rev_ref(ref)
    payload = "\n".join("%s=%s" % (k, v) for k, v in prof.items())
    ok, commit = write_ref(ref, payload, parent=old)
    if ok:
        # After a successful remote push the local ref must be updated too, or the node **cannot see the heartbeat it just sent**
        # (write_ref pushes the remote and does not move the local ref) -- the worker's first report "swarm sees 1 node: laptop" was this cause
        git("update-ref %s %s" % (ref, commit), timeout=30)
    return ok


def read_swarm():
    """Group awareness: prefer refs (the truth); fall back to the file snapshot when no ref exists."""
    nodes = {}
    for ref in list_refs(BEAT_NS):
        prof = {}
        for row in read_ref(ref).split("\n"):
            if "=" in row:
                key, _, val = row.partition("=")
                prof[key.strip()] = val.strip()
        if prof.get("node"):
            nodes[prof["node"]] = prof
    if nodes:
        return nodes
    if not os.path.isdir(SWARM):
        return nodes
    print("⚠️ ref layer sees no nodes; falling back to the local file snapshot (fetch may have failed, or refs were not pushed)",
          file=sys.stderr)
    for name in sorted(os.listdir(SWARM)):
        if not name.endswith(".md"):
            continue
        _, _, rows = read_table(os.path.join(SWARM, name), key="field")
        prof = {r["field"]: r["value"] for _, r in rows if r.get("field")}
        if prof.get("node"):
            nodes[prof["node"]] = prof
    return nodes


def quiet_limit(prof):
    """Different machines, different rulers: a laptop lid closed overnight is normal; an always-on host quiet for 3 hours is not."""
    return 14 if prof.get("can_sleep") == "yes" else 3


def beat_ref_precise_seen(prof):
    """Read an exact last_seen from the commit time of the local refs/swarm/<swarm>/beat/<node>.

    last_seen in the profile is hour precision (deliberately flattened when the heartbeat is written, so that "ticks within one hour
    do not change content → no git diff → the heartbeat does not create commit noise"). Side effect: you can see
    "heartbeat just pushed, but it shows 0.9h quiet", a contradiction -- a concrete case measured on the worker on 2026-07-29.
    The beat ref commit time is the truth, exact to the second.

    Read only refs already present locally; do not fetch extra here -- the caller decides whether to refresh
    (same existing "read the local cache" behavior as cmd_swarm; no new implicit network call;
    tick/dashboard and others already called fetch_refs() in an outer layer).

    Returns a datetime or None. None = the exact time cannot be read locally (maybe never fetched /
    the node never sent a heartbeat / the git command failed) -- the caller must fall back to the profile
    last_seen field, and must not treat it as "no heartbeat" (that is fail-closed mistaken for the opposite of fail-open,
    equally wrong; UNVERIFIABLE tri-state: unreadable != judged not alive).
    """
    node = prof.get("node")
    if not node:
        return None
    ref = "%s/%s" % (BEAT_NS, node)
    code, out = git("log -1 --format=%%ci %s" % ref, timeout=15)
    if code != 0 or not out.strip():
        return None
    ts = out.strip().split("\n")[-1]
    try:
        # %ci looks like "2026-07-29 10:55:11 +0800". Keep the offset so it can be compared with
        # timezone-aware now()/receipt across nodes, and no longer depends on machines sharing a timezone.
        return datetime.strptime(ts, "%Y-%m-%d %H:%M:%S %z")
    except ValueError:
        return None


def node_alive(prof):
    precise = beat_ref_precise_seen(prof)
    seen = precise if precise is not None else parse_ts(prof.get("last_seen"))
    if seen is None:
        return False, "no heartbeat record"
    quiet = (now() - seen).total_seconds() / 3600
    limit = quiet_limit(prof)
    precision = "beat ref exact time" if precise is not None else "profile hour precision"
    if quiet <= limit:
        return True, "quiet %.1fh (threshold %dh | %s)" % (quiet, limit, precision)
    reason = "lid-closed sleep does not explain it either" if prof.get("can_sleep") == "yes" else "an always-on host should not be quiet"
    return False, "quiet %.1fh exceeds threshold %dh - %s (%s)" % (quiet, limit, reason, precision)


def takeover_ready(prof):
    """Takeover is allowed only after quiet exceeds **2x** the threshold.

    Grabbing a node just because it is "offline" causes false harm: a laptop just past 14h may only have slept in with the lid closed over a weekend.
    Leave one extra buffer; better to take over late than to grab it and hand it back (flapping hurts more than a stall).

    Use the same ruler as node_alive() (beat ref exact time first, else profile hour
    precision) -- two sites using two clocks would create a new "which criterion is the truth" split,
    the same disease being fixed today where a high-dimensional state is crushed into inconsistent low-dimensional values.
    """
    precise = beat_ref_precise_seen(prof)
    seen = precise if precise is not None else parse_ts(prof.get("last_seen"))
    if seen is None:
        return True
    return (now() - seen).total_seconds() / 3600 > quiet_limit(prof) * 2


SYNC_STAMP = "/tmp/spotlight/cortex-loop.sync"
# A line lease protects only one scheduler pass; it does not cover a detached worker's lifetime.
# A long lease wrongly equates "owner is busy" with "other nodes are unavailable", forming a cross-node
# single point of failure; worker dedup and fencing are handled by task-level claim/ledger CAS.
SCHEDULER_LEASE_MIN = 5

# ── Decentralized task dispatch (spec: reports/2026-07-28/_standalone/cortex-loop-swarm-dispatch-spec.md)
# CLOCK.owner only provides everyday affinity; any healthy node may compete for the short scheduler lease.
# This layer solves "how one plan is split, claimed autonomously by several machines, and rolled up". No leader, no election,
# no quorum -- the git server only provides storage plus atomic CAS on refs.
PLAN_NS = "refs/swarm/%s/plan" % SWARM_NAME
CLAIM_NS = "refs/swarm/%s/claim" % SWARM_NAME
RESULT_NS = "refs/swarm/%s/result" % SWARM_NAME
# Immutable terminal projections live beside the swarm ledger instead of in an
# attempt worktree.  An attempt root is intentionally disposable after its
# candidate is integrated, so it cannot be the only reader-facing source.
RUN_CONTRACT_NS = "refs/swarm/%s/run-contract" % SWARM_NAME
# A candidate/integrator landing can become visible to a reader just before the
# terminal publisher's immutable ref is locally visible.  Keep this wait tiny:
# it covers same-process/ref propagation, not a second delivery workflow.
TERMINAL_REF_READ_RETRIES = 3
TERMINAL_REF_READ_DELAY_SEC = 0.05
# [EX14 | T36] Failure cooldown: after one failed, do not retry for N minutes; after that it may be claimed again.
# Shorter than 0 = not implemented; longer than the TTL = other nodes wait for nothing. 5 minutes is enough for a gateway/model to half-recover,
# and short enough not to drag the swarm into unavailability.
FAIL_COOLDOWN_MIN = 5
# [EX15 | T37] When a long task exceeds the advance window (typically 240min) the heartbeat must be touched in between,
# or pulse/dashboard cannot tell "doing heavy work" from "node offline" -- both states leave
# last_seen frozen, and crushing two states into one signal is a classic DIMENSIONAL collapse.
#
# Tri-state design (complements the two-state boolean of node_alive, together a 3x2 matrix):
#   running + heartbeat_fresh  → busy          doing heavy work (green, not red)
#   running + heartbeat_stale  → stale-running looks like it is running but is dead (red)
#   !running + heartbeat_fresh → alive         idle and online
#   !running + heartbeat_stale → offline       node offline
# 60s touch interval + 180s stale threshold → at least one fresh probe between heartbeat beats (15min),
# so pulse/dashboard running alone can see "this node is doing heavy work".
LONG_TASK_HEARTBEAT_SEC = 60
LONG_TASK_HEARTBEAT_STALE_SEC = 180
# Discovery is an immutable snapshot before a candidate enters a plan; learning only stores candidates and does not edit any Skill directly.
DISCOVERY_NS = "refs/swarm/%s/discovery" % SWARM_NAME
LEARNING_NS = "refs/swarm/%s/learning" % SWARM_NAME
# [Fourth state] A task's fate is not three states (pending / done / failed); it is **four states**:
#   pending  nobody has touched it
#   done     finished successfully   → counts as credit
#   failed   attempted and failed    → counts as a fault
#   moot     the criterion was already met → **neither credit nor fault, but it is terminal**
# The idle-spin gate (2026-07-29) recognized the fourth state but only `continue`d, with nowhere to put it, so it was
# folded back into pending -- the plan could therefore never close, and tick's "resume old work" branch was locked by the same
# already-empty plan for 6 beats of zero output. Give the fourth state **its own namespace** instead of stuffing it into result:
# stuffing it into result pollutes HAAS and the pass rate (an idle spin should neither add nor deduct score),
# and an independent namespace lets "no work to do" be remembered and skipped without entering any credit ledger.
MOOT_NS = "refs/swarm/%s/moot" % SWARM_NAME
ADVANCE_NS = "refs/swarm/%s/advance" % SWARM_NAME

# [EX15 | T37] Mid-write heartbeat for long tasks -- the physical basis of busy != offline
# The landing point is /tmp/spotlight because it is local to each node, has zero network dependency, and maps 1:1 to node identity,
# so it will not be mistaken for swarm consensus; the downside is a node restart loses it, so it is **only a liveness probe**, not a log.
# Do not reuse BEAT_NS: a beat is the whole-node heartbeat at 30-second integer granularity for "the node is alive",
# and what we want is a task-level mid-heartbeat at second granularity; mixing them would make the beat ref commit often
# and break the design that "unchanged tick content within one hour means no git diff" (cortex-loop:579).
RUNNING_HEARTBEAT_DIR = "/tmp/spotlight"


def touch_running_heartbeat(line, task_id):
    """Mid-heartbeat probe for a long task -- called by the background ticker every LONG_TASK_HEARTBEAT_SEC seconds.

    Write one **purely local** small file: node identity (line+task+node+ts), single-node read and single-node write,
    fully independent of the swarm beat ref. pulse/dashboard reads this file's mtime to judge
    "how long ago the last long-task heartbeat was" -- two orders of magnitude finer than last_seen hour precision.
    """
    os.makedirs(RUNNING_HEARTBEAT_DIR, exist_ok=True)
    fname = "%s/cortex-loop-running-heartbeat-%s-%s" % (
        RUNNING_HEARTBEAT_DIR, line, task_id)
    ts = fmt(now())
    try:
        with open(fname, "w", encoding="utf-8") as fh:
            fh.write("line=%s\ntask=%s\nnode=%s\ntouched_at=%s\n" % (
                line, task_id, node_id(), ts))
    except OSError as exc:
        # A failed probe write != a failed task -- only log, do not raise, and let the adapter keep running
        log("running-heartbeat touch FAIL %s/%s: %s" % (line, task_id, exc))
        return False
    return True


def read_running_heartbeat(line, task_id):
    """Read the timestamp of the latest long-task heartbeat; missing or unreadable file → None (UNKNOWN state)."""
    fname = "%s/cortex-loop-running-heartbeat-%s-%s" % (
        RUNNING_HEARTBEAT_DIR, line, task_id)
    if not os.path.isfile(fname):
        return None
    try:
        mtime = os.path.getmtime(fname)
    except OSError:
        return None
    return datetime.fromtimestamp(mtime, tz=timezone.utc)


def list_running_heartbeats():
    """Scan every long-task heartbeat probe and return a list of [(line, task_id, mtime_iso)].

    pulse/dashboard uses this one call for a mid-heartbeat view of every task on this node,
    so each node does not keep its own state machine -- /tmp/spotlight is single-machine truth anyway.
    """
    if not os.path.isdir(RUNNING_HEARTBEAT_DIR):
        return []
    out = []
    for entry in sorted(os.listdir(RUNNING_HEARTBEAT_DIR)):
        if not entry.startswith("cortex-loop-running-heartbeat-"):
            continue
        rest = entry[len("cortex-loop-running-heartbeat-"):]
        if "-" not in rest:
            continue
        line, _, task_id = rest.partition("-")
        path = os.path.join(RUNNING_HEARTBEAT_DIR, entry)
        try:
            mtime = datetime.fromtimestamp(os.path.getmtime(path), tz=timezone.utc)
        except OSError:
            continue
        out.append((line, task_id, mtime))
    return out


def start_long_task_heartbeat(line, task_id):
    """Start a background ticker that touches once every LONG_TASK_HEARTBEAT_SEC seconds; return the pid file path.

    The ticker process shares the lifetime of the main cmd_tick: when the parent gets SIGTERM, an EXIT trap reaps it
    (see the stop_long_task_heartbeat caller). **This is the key to busy != offline** --
    without a ticker, a 30-minute advance_once does not update the node beat ref,
    and pulse only sees "heartbeat 30 minutes ago" while the node is actually doing heavy work.
    """
    os.makedirs(RUNNING_HEARTBEAT_DIR, exist_ok=True)
    pidfile = "%s/cortex-loop-running-heartbeat-%s-%s.pid" % (
        RUNNING_HEARTBEAT_DIR, line, task_id)
    # Prevent a leftover old ticker: try kill -0 first, then clear it
    if os.path.isfile(pidfile):
        try:
            old = int(open(pidfile).read().strip() or "0")
        except (OSError, ValueError):
            old = 0
        if old > 0:
            try:
                os.kill(old, 0)  # liveness probe; send no signal
                log("long-task heartbeat ticker already running pid=%s, reuse" % old)
                return pidfile
            except OSError:
                pass
        try:
            os.remove(pidfile)
        except OSError:
            pass
    # Touch once immediately, to avoid the blind window "just started → pulse sees no probe for 30s"
    touch_running_heartbeat(line, task_id)
    ticker_cmd = (
        "while true; do sleep %d; "
        "python3 -c 'import sys, importlib.util, importlib.machinery; "
        "from pathlib import Path; "
        "p=Path(\"%s/bin/cortex-loop\"); "
        "ld=importlib.machinery.SourceFileLoader(\"cl\", str(p)); "
        "sp=importlib.util.spec_from_loader(ld.name, ld); "
        "m=importlib.util.module_from_spec(sp); ld.exec_module(m); "
        "m.touch_running_heartbeat(\"%s\", \"%s\")' "
        "|| exit 0; done" % (
            LONG_TASK_HEARTBEAT_SEC, ROOT, line, task_id))
    code, _ = run("sh -c '%s' &" % ticker_cmd.replace("'", "'\\''"),
                  timeout=10)
    # run uses timeout as a backstop; the real pid comes from sh, then we rescan the pidfile the ticker writes itself
    # Simplification: the sh command above did not persist the pid, so take the child pid directly on the nohup path
    # -- step back: fork directly instead of depending on run(); the block below is the preferred path
    pid = os.fork()
    if pid == 0:
        # Child: write its own pid to the pidfile, then loop sleep+touch
        try:
            with open(pidfile, "w", encoding="utf-8") as fh:
                fh.write(str(os.getpid()))
        except OSError:
            os._exit(1)
        try:
            while True:
                time.sleep(LONG_TASK_HEARTBEAT_SEC)
                touch_running_heartbeat(line, task_id)
        except KeyboardInterrupt:
            pass
        finally:
            try:
                os.remove(pidfile)
            except OSError:
                pass
        os._exit(0)
    # Parent: persist the child pid (write it again as insurance even if the fork path above already wrote it)
    try:
        with open(pidfile, "w", encoding="utf-8") as fh:
            fh.write(str(pid))
    except OSError:
        pass
    return pidfile


def stop_long_task_heartbeat(pidfile):
    """Reap the ticker child. SIGTERM → wait 2s → SIGKILL if it is still alive; then clear the pidfile.

    Three steps: polite first, then force-kill, then clear the books. Any failed step is logged and not raised --
    this is a cleanup path, and it **must never** let a cleanup failure hide the real result of advance_once.
    """
    if not pidfile or not os.path.isfile(pidfile):
        return
    try:
        pid = int(open(pidfile).read().strip() or "0")
    except (OSError, ValueError):
        pid = 0
    if pid > 0:
        try:
            os.kill(pid, 15)  # SIGTERM
        except OSError:
            pass
        # Wait 2s so the ticker can exit gracefully
        for _ in range(20):
            time.sleep(0.1)
            try:
                os.kill(pid, 0)
            except OSError:
                pid = 0
                break
        if pid > 0:
            try:
                os.kill(pid, 9)  # SIGKILL backstop
            except OSError:
                pass
    try:
        os.remove(pidfile)
    except OSError:
        pass


def reap_stale_running_tasks(line):
    """A long-task heartbeat older than LONG_TASK_HEARTBEAT_STALE_SEC while status=running → reclaim to pending.

    Unlike reclaim_inherited_running: this function looks only at tasks **this node is running**,
    not orphans of an already-dead process. Called once when a new tick starts: expose zombie running tasks
    so the later half of the beat can claim and take them normally.

    Criterion = running status + no recent heartbeat + the stale window has already passed.
    Three states:
      (1) no heartbeat file → ticker failed to start, or the node restarted; reclaim conservatively
      (2) heartbeat file exists but is stale → the ticker died but the task did not; must reclaim
      (3) heartbeat file is fresh → really running; skip

    Do not wait longer on purpose: doubling the timeout will not revive a dead task; it will only misjudge a live task on the next reclaim.
    """
    if not line:
        return []
    path = tasks_path(line)
    if not os.path.isfile(path):
        return []
    tasks = load_tasks(line)
    if not tasks:
        return []
    reclaimed = []
    cutoff = datetime.now(tz=timezone.utc) - timedelta(seconds=LONG_TASK_HEARTBEAT_STALE_SEC)
    for task in tasks:
        if task.get("status") != "running":
            continue
        touched = read_running_heartbeat(line, task["id"])
        if touched is not None and touched >= cutoff:
            # really running: heartbeat is fresh → leave it alone
            continue
        why = "no running heartbeat file" if touched is None else \
            "heartbeat stale %.0fs (threshold %ds)" % (
                (datetime.now(tz=timezone.utc) - touched).total_seconds(),
                LONG_TASK_HEARTBEAT_STALE_SEC)
        if not set_cells(path, task["id"], {
                "status": "pending", "next_advance_after": "-",
                "updated_at": fmt(now()),
        }, expected_status="running"):
            continue
        reclaimed.append(task["id"])
        msg = "reap-stale-running %s/%s → pending (%s, EX15 defense point)" % (
            line, task["id"], why)
        print(msg)
        log(msg)
    return reclaimed

# ── Git-native swarm bus (zero external dependencies - no Redis - does not touch the worktree) ──
#
# Core insight: `git push` updating a remote ref is an **atomic compare-and-swap**.
# Two nodes take the same old parent, build a new commit, and push together; the server lets only one fast-forward
# succeed, and the other must be rejected -- that is a natural distributed lease lock, semantically equivalent to Redis SETNX,
# and it needs no external service.
#
# Heartbeats work the same way: each node pushes only its own refs/swarm/beat/<node>, so a collision is structurally impossible.
# The whole path uses plumbing (hash-object / mktree / commit-tree), **no checkout and no worktree touch**,
# so the worker's 267 uncommitted files cannot block it either.

BEAT_NS = "refs/swarm/%s/beat" % SWARM_NAME
LEASE_NS = "refs/swarm/%s/lease" % SWARM_NAME


def git(cmd, timeout=120):
    # Swarm plumbing writes commits. A fresh checkout often has no
    # user.name, and a developer machine may have commit.gpgsign on.
    # Pin a fixture identity and do not sign, so tick does not depend
    # on a personal git config.
    return run(
        "cd %s && git -c user.name=cortex-loop "
        "-c user.email=cortex-loop@example.invalid "
        "-c commit.gpgsign=false %s" % (ROOT, cmd),
        timeout=timeout,
    )


def write_ref(ref, payload, parent=None):
    """Seal a piece of text into a ref. Returns (ok, new commit sha)."""
    code, blob = git("hash-object -w --stdin <<'CORTEXEOF'\n%s\nCORTEXEOF" % payload)
    if code != 0:
        return False, ""
    blob = blob.strip().split("\n")[-1]
    code, tree = git("mktree <<'CORTEXEOF'\n100644 blob %s\tpayload\nCORTEXEOF" % blob)
    if code != 0:
        return False, ""
    tree = tree.strip().split("\n")[-1]
    parent_arg = "-p %s " % parent if parent else ""
    code, commit = git("commit-tree %s %s-m swarm" % (tree, parent_arg))
    if code != 0:
        return False, ""
    commit = commit.strip().split("\n")[-1]
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        return False, ""      # never push an empty or abnormal sha: `push origin :ref` deletes the remote ref, which is fatal
    # Do not add --force: a non-fast-forward must be rejected, and rejection is exactly the signal that the lock worked
    code, out = _git_net_retry(
        "push origin %s:%s 2>&1" % (commit, ref),
        timeout=180, attempts=3, label="push_swarm_ref",
    )
    if code != 0:
        # "Rejected by CAS" and "the network is down" must be reported apart -- collapsing both into one False makes a pure network fault
        # sound like "another node grabbed it first", so tick silently skips that line while the log looks healthy.
        # GitHub from this machine goes through Privoxy; measured about 1 SSL_ERROR_SYSCALL jitter per 6 tries (test suite O-01).
        tail = out.strip().split("\n")[-1][:160]
        if re.search(
                r"non-fast-forward|\[rejected\]|fetch first|cannot lock ref|"
                r"failed to update ref|reference already exists|stale info",
                out, re.I):
            print("CAS rejected %s (another node pushed first)" % ref, file=sys.stderr)
            return False, "REJECTED"
        print("push %s network/permission failure (**not** a CAS reject): %s" % (ref, tail), file=sys.stderr)
        return False, "ERROR"
    # origin CAS has already succeeded, so the local ref must point at the same object immediately. Otherwise the same process, next,
    # `rev_ref/read_ref` cannot see the claim it just obtained: the remote ledger says "you hold it",
    # but the local execution gate says "no valid claim", and the whole beat produces 0. This is not a second verdict;
    # it only syncs a fact origin has already accepted into the local cache.
    local_code, local_out = git("update-ref %s %s" % (ref, commit), timeout=30)
    if local_code != 0:
        print("origin wrote the ref but the local ref update failed %s: %s"
              % (ref, local_out.strip().split("\n")[-1][:160]), file=sys.stderr)
        return False, "LOCAL_REF_ERROR"
    return True, commit


def _git_net_retry(args, timeout=180, attempts=3, label="git-net"):
    """The proxy chain occasionally hits LibreSSL SSL_ERROR_SYSCALL: retry briefly; a real outage still fails."""
    last_code, last_out = 1, ""
    for attempt in range(max(1, attempts)):
        last_code, last_out = git(args, timeout=timeout)
        if last_code == 0:
            return 0, last_out
        if attempt + 1 < attempts:
            time.sleep(2 * (attempt + 1))
    return last_code, last_out


def fetch_refs():
    code, _ = _git_net_retry(
        "fetch origin '+refs/swarm/*:refs/swarm/*' --prune --quiet",
        timeout=180,
        attempts=3,
        label="fetch_swarm",
    )
    return code == 0


def _safe_ref_component(value):
    """Converge a ledger primary key into a legal, stable ref path component."""
    return re.sub(r"[^A-Za-z0-9._-]+", "-", (value or "").strip()).strip("-") or "unknown"


def reserve_daily_advance(line, day_cap, retries=5, task_id=""):
    """Atomically pre-reserve one local-calendar-day advance of quota on a git ref.

    Reserve before every real Worker call, so a failed attempt counts against quota too (otherwise a bad executor can
    burn calls without limit). A fast-forward push of the remote ref is the CAS; only one concurrent node can write,
    and the loser fetches and recomputes. When network or permission is unknown, fail closed, and do not treat "cannot see the counter" as
    "unused today".
    """
    try:
        cap = max(0, int(day_cap))
    except (TypeError, ValueError):
        cap = 0
    day = now().strftime("%Y-%m-%d")
    ref = "%s/%s" % (ADVANCE_NS, _safe_ref_component(line))
    token = hashlib.sha256(
        ("%s|%s|%s|%s|%s" % (line, day, node_id(), os.getpid(), time.time_ns()))
        .encode("utf-8")
    ).hexdigest()[:20]

    for _attempt in range(max(1, retries)):
        if not fetch_refs():
            return False, 0, "daily quota ref cannot sync (network/permission UNKNOWN)"
        old = rev_ref(ref)
        kv = parse_kv(read_ref(ref)) if old else {}
        reservations = []
        if kv.get("day") == day:
            reservations = [
                item for item in (kv.get("reservations") or "").split(",")
                if re.fullmatch(r"[0-9a-f]{20}", item)
            ]
        if token in reservations:
            return True, len(reservations), "reserved"
        if len(reservations) >= cap:
            evidence = ("rule=daily-cas-cap measured=%d budget=%d unit=advances/day "
                        "line=%s day=%s" % (len(reservations) + 1, cap, line, day))
            record_budget_incident(
                line, task_id, "daily_cas_overage", evidence,
                idempotency_key="%s|%s|%d" % (line, day, cap))
            return False, len(reservations), "local calendar-day cap reached %d/%d" % (
                len(reservations), cap)
        reservations.append(token)
        payload = "\n".join([
            "schema=daily-advance-v1",
            "line=%s" % line,
            "day=%s" % day,
            "count=%d" % len(reservations),
            "reservations=%s" % ",".join(reservations),
            "last_node=%s" % node_id(),
            "updated_at=%s" % fmt(now()),
        ])
        ok, why = write_ref(ref, payload, parent=old)
        if ok:
            return True, len(reservations), "reserved %d/%d" % (len(reservations), cap)
        if why not in ("REJECTED", "LOCAL_REF_ERROR"):
            return False, len(reservations) - 1, "daily quota ref write failed (network/permission UNKNOWN)"
        # Another node won the CAS update first, or origin succeeded but the local cache update failed: fetch again,
        # and if this token is already on the remote it is an idempotent success; otherwise retry from the new count.
    if fetch_refs():
        kv = parse_kv(read_ref(ref))
        reservations = (kv.get("reservations") or "").split(",")
        if kv.get("day") == day and token in reservations:
            return True, len([x for x in reservations if x]), "reserved"
    return False, 0, "daily quota CAS conflicted repeatedly; fail closed and do not advance"


def _bounded_failure_context(line, task_id, failure):
    """Keep only the fields the Repair Controller really needs in the failure context, and redact them first."""
    failure = failure or {}
    detail = str(failure.get("detail") or "uncaught failure output")
    detail = detail.replace("CORTEXEOF", "[REDACTED]")
    detail = re.sub(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]+", "Bearer [REDACTED]", detail)
    detail = re.sub(
        r"(?i)\b(authorization|api[_-]?key|token|secret|password)\b"
        r"(\s*[:=]\s*|\s+)([^\s,;]+)",
        lambda m: "%s%s[REDACTED]" % (m.group(1), m.group(2)),
        detail,
    )
    detail = re.sub(r"\b(?:sk|ak)-[A-Za-z0-9_-]{12,}\b", "[REDACTED]", detail)
    detail = re.sub(r"\s+", " ", detail).strip()[:600]
    try:
        rc = int(failure.get("rc"))
    except (TypeError, ValueError):
        rc = -1
    return {
        "line": str(line)[:80],
        "task": str(task_id)[:80],
        "stage": re.sub(r"[^A-Za-z0-9._-]+", "-", str(
            failure.get("stage") or "unknown"))[:80],
        "rc": rc,
        "detail": detail,
        "at": fmt(now()),
        "at_epoch": time.time(),
        "node": node_id()[:120],
    }


def _load_failure_state():
    if not os.path.isfile(FAILURE_STATE):
        return {}
    try:
        with open(FAILURE_STATE, encoding="utf-8") as fh:
            state = json.load(fh)
        return state if isinstance(state, dict) else {}
    except (OSError, ValueError):
        return {}


def persist_failure_context(line, task_id, failure):
    """Write the latest failure into a bounded source of truth outside /tmp; atomic replace, and lock across processes.

    The `/tmp` result is still the raw execution receipt, but a reboot loses it. Here we save only each task's latest
    redacted diagnostic input, and cap the total task count at 128; that both restores the Repair Controller across reboots
    and does not append model output and possible credentials without limit into a permanent log.
    """
    record = _bounded_failure_context(line, task_id, failure)
    state_dir = os.path.dirname(FAILURE_STATE)
    os.makedirs(state_dir, exist_ok=True)
    lock_path = FAILURE_STATE + ".lock"
    with open(lock_path, "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        state = _load_failure_state()
        state["%s/%s" % (line, task_id)] = record
        if len(state) > 128:
            ordered = sorted(
                state.items(),
                key=lambda item: (
                    float(item[1].get("at_epoch") or 0)
                    if isinstance(item[1], dict) else 0
                ),
                reverse=True,
            )
            state = dict(ordered[:128])
        tmp = "%s.%s.%s.tmp" % (FAILURE_STATE, os.getpid(), time.time_ns())
        try:
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(state, fh, ensure_ascii=False, sort_keys=True, indent=2)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, FAILURE_STATE)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    return record


def load_failure_context(line, task_id):
    """Restart-recovery entry for the Repair Controller: read only a task's latest persisted failure."""
    record = _load_failure_state().get("%s/%s" % (line, task_id), {})
    return record if isinstance(record, dict) else {}


# ── ref batch-read snapshot (T29 performance fix) ──
# The root cause is not "not enough cache"; it is **the wrong call pattern**: read_ref starts 2 git processes per ref (rev-parse +
# cat-file), and git() also wraps each one in `sh -c "cd ... && git ..."` -- 4 processes in practice.
# haas_score reads 120 result refs one by one, and cmd_trust calls haas_score another 8 times
# ⇒ ~2200 git calls ⇒ measured 94.85s (39.7s user / 41.5s system; system taking half is exactly
# the fingerprint of process-creation cost), far past the dashboard's 20s CORTEX_DASH_TRUST_TIMEOUT,
# and one `timeout` cut leaves the whole trust table only half emitted (the visible face of T29).
#
# The fix is a different call pattern: one `git cat-file --batch` child emits all N payloads
# (measured 120 refs in 0.021s). The snapshot **must be turned on explicitly and wrap only the read-only report path** --
# never an always-on global cache: the write_ref footnote called out that "the same process, on the very next read_ref,
# cannot see the claim it just obtained", and an always-on cache reproduces exactly that fatal path,
# which is also this task's failure_modes case "adding only a cache, without fixing the root cause, leaves data stale for a long time".
_REF_SNAPSHOT = None          # None = disabled; dict = ref → payload (includes a confirmed-missing "")
_REF_LIST_SNAPSHOT = None     # None = disabled; dict = namespace → ref list


# ── ref tri-state return contract (EX11 - DIMENSIONAL theme, site 5) ──
# In the old contract, read_ref shared "" between "git error" and "the ref really has no payload",
# and list_refs shared [] between "for-each-ref error" and "the namespace really has no refs".
# 30 downstream call sites go through parse_kv / .split / set and cannot see the two states apart →
# "git failed" is silently crushed into "confirmed no data", and downstream then judges done/failed/health
# on a lie. EX11 splits the two states so a caller can tell "ok / empty / error" apart.
#
# Implementation: str / list subclasses. The string / list interface stays 100% compatible with old call sites,
# but every return carries .status / .reason metadata, so a caller can judge finely when it needs to.
class ReadRefResult(str):
    """Tri-state return from read_ref (an str subclass; behavior 100% equivalent to the old return)."""

    __slots__ = ("status", "reason")

    def __new__(cls, status, payload="", reason=""):
        instance = super().__new__(cls, payload)
        instance.status = status      # "ok" | "empty" | "error"
        instance.reason = reason      # cause of the error state (human-readable, for debugging)
        return instance

    def __repr__(self):
        return "ReadRefResult(status=%r, payload=%r, reason=%r)" % (
            self.status, str.__str__(self), self.reason)

    @property
    def is_ok(self):
        return self.status == "ok"

    @property
    def is_empty(self):
        return self.status == "empty"

    @property
    def is_error(self):
        return self.status == "error"


class ListRefsResult(list):
    """Tri-state return from list_refs (a list subclass; behavior 100% equivalent to the old return)."""

    __slots__ = ("status", "reason")

    def __new__(cls, status, refs=None, reason=""):
        # list.__new__ does not accept an iterable argument (unlike str.__new__),
        # so content initialization must live in __init__; here we only build an empty shell.
        return super().__new__(cls)

    def __init__(self, status, refs=None, reason=""):
        # type.__call__ invokes both __new__ and __init__ with (status, refs, reason),
        # and list.__init__ accepts only 1 iterable -- take over initialization ourselves.
        super().__init__(list(refs) if refs else [])
        self.status = status      # "ok" | "empty" | "error"
        self.reason = reason

    def __repr__(self):
        return "ListRefsResult(status=%r, refs=%r, reason=%r)" % (
            self.status, list.__repr__(self), self.reason)

    @property
    def is_ok(self):
        return self.status == "ok"

    @property
    def is_empty(self):
        return self.status == "empty"

    @property
    def is_error(self):
        return self.status == "error"


def read_refs_batch(refs):
    """One git cat-file --batch child reads the payloads of N refs.

    Returns a dict (ref → payload; a confirmed missing payload is stored as ""). If the instrument itself is unavailable, return
    **None**, so the caller falls back to the slow per-ref path (fail-safe) -- never crush "unreadable" into
    "confirmed no data"; that is the third-state collapse the DIMENSIONAL law names.
    """
    refs = list(dict.fromkeys(r for r in refs if r))
    if not refs:
        return {}
    stdin_payload = "".join("%s:payload\n" % r for r in refs)
    try:
        proc = subprocess.run(
            ["git", "cat-file", "--batch"], cwd=ROOT,
            input=stdin_payload.encode(), stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, timeout=60,
        )
    except (subprocess.TimeoutExpired, OSError) as exc:
        print("read_refs_batch unavailable (fall back to per-ref reads, **not** 'no data'): %s" % exc,
              file=sys.stderr)
        return None
    if proc.returncode != 0:
        print("read_refs_batch exit code %d (fall back to per-ref reads): %s"
              % (proc.returncode,
                 proc.stderr.decode("utf-8", "replace").strip().split("\n")[-1][:120]),
              file=sys.stderr)
        return None
    out, got, pos = proc.stdout, {}, 0
    for ref in refs:
        nl = out.find(b"\n", pos)
        if nl < 0:
            print("read_refs_batch output ended early at %s (fall back to per-ref reads)" % ref, file=sys.stderr)
            return None
        header = out[pos:nl].decode("utf-8", "replace").split()
        pos = nl + 1
        # `<input> missing` / `<input> ambiguous` = git confirms it cannot get a payload; that is a normal empty state,
        # consistent with read_ref's existing contract of returning "" for "ref does not exist".
        if len(header) >= 2 and header[-1] in ("missing", "ambiguous"):
            got[ref] = ""
            continue
        if len(header) != 3 or not header[2].isdigit():
            print("read_refs_batch header cannot be parsed %r (fall back to per-ref reads)" % (header[:3],),
                  file=sys.stderr)
            return None
        size = int(header[2])
        got[ref] = out[pos:pos + size].decode("utf-8", "replace")
        pos += size + 1       # skip the newline git appends after the payload
    return got


class ref_snapshot(object):
    """For read-only report paths only: prefetch every payload of several namespaces; while that is active, read_ref /
    list_refs read from memory and start no more child processes.

    If prefetch fails → do not enable the snapshot; the whole section falls back to the original per-ref path (identical result, only slower).
    Clear unconditionally on exit -- a snapshot must never survive across commands.
    """

    def __init__(self, *namespaces):
        self.namespaces = namespaces
        self.active = False

    def __enter__(self):
        global _REF_SNAPSHOT, _REF_LIST_SNAPSHOT
        lists, refs = {}, []
        for ns in self.namespaces:
            lists[ns] = list_refs(ns)      # snapshot is not enabled yet, so this hits real git and gets the current truth
            refs.extend(lists[ns])
        got = read_refs_batch(refs)
        if got is None:
            return self                    # instrument unavailable → slow path, but do not hand back a wrong number
        _REF_SNAPSHOT, _REF_LIST_SNAPSHOT = got, lists
        self.active = True
        return self

    def __exit__(self, *exc):
        global _REF_SNAPSHOT, _REF_LIST_SNAPSHOT
        _REF_SNAPSHOT, _REF_LIST_SNAPSHOT = None, None
        self.active = False
        return False


def read_ref(ref):
    """EX11 - DIMENSIONAL theme, site 5 -- tri-state return contract.

    Returns ReadRefResult (an str subclass). The string interface is 100% compatible with the old 30 call sites
    (parse_kv / .split / print / +), but every return carries .status metadata:
        status = "ok"     → payload is non-empty; a payload was confirmed read
        status = "empty"  → payload is empty, but git/rev-parse confirms this ref really has no payload
                            (includes rev-parse not finding it / git "invalid object name")
        status = "error"  → payload is empty and the git command really failed (timeout / non-zero exit / IO),
                            and the caller **must not** treat it as "confirmed no data" for a downstream decision

    DIMENSIONAL law: the third state stands alone as "error" and is never collapsed back into "empty".
    "invalid object name" / "not a valid object name" = git confirms there is no payload → empty.
    """
    # For the caller, absence is a normal empty state. Use rev-parse first to see whether the local ref exists, so
    # a locale change cannot translate Git's "invalid object name" and flood us with false errors.
    # A snapshot hit tests membership with `in`, not truthiness -- "" is a legal cached value for "confirmed no payload",
    # and a truthiness test would miss and fall through to 2 child processes every time, which is no optimization.
    if _REF_SNAPSHOT is not None and ref in _REF_SNAPSHOT:
        payload = _REF_SNAPSHOT[ref]
        status = "empty" if not payload else "ok"
        return ReadRefResult(status, payload, "snapshot hit")
    if not rev_ref(ref):
        return ReadRefResult("empty", "", "rev-parse returned no sha — confirmed absent")
    code, out = git("cat-file -p %s:payload 2>&1" % ref, timeout=60)
    if code == 0:
        return ReadRefResult("ok", out, "")
    if code == 124:
        print("read_ref %s timed out (cannot confirm whether it exists; this is not 'confirmed no data')" % ref, file=sys.stderr)
        return ReadRefResult("error", "", "git cat-file timeout")
    if re.search(r"invalid object name|not a valid object name", out, re.I):
        # git explicitly says this ref has no payload -- confirmed empty, not an error.
        return ReadRefResult("empty", "", "git says ref has no payload")
    print("read_ref %s error (not 'confirmed no data'): %s"
          % (ref, out.strip().split("\n")[-1][:120]), file=sys.stderr)
    return ReadRefResult("error", "", "git cat-file exit %d" % code)


def list_refs(namespace):
    """EX11 tri-state: ok / empty / error. ListRefsResult is a list subclass and keeps
    old uses such as [r for r in list_refs(NS)] / len() / sorted(), but the caller can read
    `.status` to tell "confirmed empty" from "git command error".
    """
    # During a snapshot the same namespace hits git only once, and the 8 haas_score calls in one report
    # see **the same ref set** (which also removes the inconsistency of "the ledger changed between reads").
    if _REF_LIST_SNAPSHOT is not None and namespace in _REF_LIST_SNAPSHOT:
        refs = list(_REF_LIST_SNAPSHOT[namespace])
        status = "empty" if not refs else "ok"
        return ListRefsResult(status, refs, "snapshot hit")
    code, out = git("for-each-ref --format='%(refname)' " + namespace + " 2>&1", timeout=60)
    if code == 0:
        refs = [l.strip() for l in out.split("\n") if l.strip().startswith(namespace)]
        status = "empty" if not refs else "ok"
        return ListRefsResult(status, refs, "")
    print("list_refs %s failed (not 'confirmed no refs'): %s"
          % (namespace, out.strip().split("\n")[-1][:120] if out.strip() else "exit code %d" % code),
          file=sys.stderr)
    return ListRefsResult("error", [], "git for-each-ref exit %d" % code)


def rev_ref(ref):
    """Local ref → sha. If it cannot be obtained, return None (never an empty string; see the fatal footnote in write_ref)."""
    code, out = git("rev-parse --verify --quiet %s" % ref, timeout=30)
    sha = out.strip().split("\n")[-1] if code == 0 else ""
    return sha if re.fullmatch(r"[0-9a-f]{40}", sha or "") else None


def acquire_lease(line, ttl_min=60):
    """Grab the execution lease for a line. If two nodes grab at once, the git server guarantees only one succeeds."""
    ref = "%s/%s" % (LEASE_NS, line)
    fetch_refs()          # must sync first: a missing local ref would be misread as "nobody holds it"
    old = rev_ref(ref)
    holder, expires = None, None
    if old:
        for row in read_ref(ref).split("\n"):
            if row.startswith("holder="):
                holder = row.split("=", 1)[1].strip()
            if row.startswith("expires="):
                expires = parse_ts(row.split("=", 1)[1].strip())
    me = node_id()
    if holder and holder != me and expires and expires > now():
        return False, "lease held by %s, expires at %s" % (holder, fmt(expires))
    payload = "holder=%s\nexpires=%s\nsince=%s" % (
        me, fmt(now() + timedelta(minutes=ttl_min)), fmt(now()))
    ok, why = write_ref(ref, payload, parent=old)
    if ok:
        return True, "lease held until %s" % fmt(now() + timedelta(minutes=ttl_min))
    if why == "ERROR":
        return False, "**network/permission failure, not grabbed by another node** -- this node cannot see the swarm right now, so fencing says do not act"
    return False, "lease grab rejected (another node pushed first in the same instant - CAS held)"


def cmd_sync(args):
    """Swarm bus -- entirely on the ref layer, zero external dependencies, **does not touch the worktree**.

    Why it cannot go through worktree files: on 2026-07-28 the worker had 267 files uncommitted and auto-sync was already broken,
    so any pull/rebase/checkout was blocked by the dirty tree and the swarm went blind with it.
    The ref layer bypasses the worktree entirely -- a dirty tree, conflicts, and a stuck auto-sync cannot affect the heartbeat.
    """
    prof = node_profile()
    fetch_refs()
    ok = beat_publish(prof)
    if not ok:                      # very rare: two processes on the same node push at once
        fetch_refs()
        ok = beat_publish(prof)
    if ok:
        with open(SYNC_STAMP, "w", encoding="utf-8") as fh:
            fh.write(fmt(now()))
    nodes = read_swarm()
    print("sync %s | swarm sees %d nodes: %s | beat=%s"
          % (prof["node"], len(nodes), " ".join(sorted(nodes)) or "-", "ok" if ok else "FAIL"))
    log("sync nodes=%d beat=%s" % (len(nodes), ok))
    return 0 if ok else 1


def sync_fresh(max_min=90):
    """Have I successfully reconciled with the swarm recently? -- the basis for fencing."""
    if not os.path.isfile(SYNC_STAMP):
        return False
    with open(SYNC_STAMP, encoding="utf-8") as fh:
        stamp = parse_ts(fh.read().strip())
    return bool(stamp) and (now() - stamp).total_seconds() / 60 <= max_min


def parse_kv(text):
    out = {}
    for row in text.split("\n"):
        if "=" in row and not row.startswith("task\t"):
            key, _, val = row.partition("=")
            out[key.strip()] = val.strip()
    return out


def plan_tasks(plan_id):
    """Read the subtasks inside a plan. Once published, a plan is immutable -- avoid the hardest conflicts, such as "a plan rewritten concurrently"."""
    text = read_ref("%s/%s" % (PLAN_NS, plan_id))
    tasks = []
    for row in text.split("\n"):
        if not row.startswith("task\t"):
            continue
        parts = row.split("\t")[1:]
        if len(parts) < 7:
            continue
        if len(parts) >= 11:
            tasks.append(dict(zip(
                ("id", "title", "requires", "bounds", "min_trust", "reversible",
                 "value", "weight", "artifact", "short_test", "approved_by", "source",
                 "discovery_id"), parts[:13])))
            # 11 fields are the old contract of an already published plan; reading them must not abort, but they have no auditable source.
            tasks[-1].setdefault("source", "legacy-plan")
            tasks[-1].setdefault("discovery_id", "-")
        else:   # compatible with the early 7-field format
            tasks.append(dict(zip(
                ("id", "title", "requires_executor", "requires_kind",
                 "weight", "artifact", "short_test"), parts[:7])))
    return tasks


PLAN_TASK_FIELDS = ("id", "title", "requires", "bounds", "min_trust", "reversible",
                    "value", "weight", "artifact", "short_test", "approved_by", "source",
                    "discovery_id")


def plan_task_line(candidate):
    """Encoding shared by every automatic plan; source is fixed as field 12, with the frozen discovery appended at the end."""
    return "task\t" + "\t".join(str(candidate.get(field, "unknown"))
                                  for field in PLAN_TASK_FIELDS)


def stable_discovery_id(source, candidate):
    """The same source+candidate always points at the same discovery cohort, and the ref name is not affected by input characters."""
    material = (str(source) + "\0" + str(candidate)).encode("utf-8")
    return "d-" + hashlib.sha256(material).hexdigest()[:24]


def _discovery_matches(kv, discovery_id, candidate):
    return (kv.get("discovery_id") == discovery_id
            and kv.get("source") == str(candidate.get("source", "unknown"))
            and kv.get("candidate") == str(candidate.get("id", "")))


def freeze_discovery(candidate, plan_id):
    """Freeze an autonomous candidate once; if it already exists, only reuse it, and never rewrite the original cohort."""
    source = str(candidate.get("source", "unknown"))
    task_id = str(candidate.get("id", ""))
    discovery_id = stable_discovery_id(source, task_id)
    ref = "%s/%s" % (DISCOVERY_NS, discovery_id)
    existing = rev_ref(ref)
    if existing:
        if not _discovery_matches(parse_kv(read_ref(ref)), discovery_id, candidate):
            print("discovery %s already exists but the lineage conflicts; refuse to overwrite" % discovery_id)
            return None
        candidate["discovery_id"] = discovery_id
        return discovery_id
    payload = "\n".join([
        "discovery_id=%s" % discovery_id,
        "discovered_at=%s" % fmt(now()),
        "source=%s" % source,
        "eligibility=min_trust=%s;requires=%s" % (candidate.get("min_trust", "-"),
                                                    candidate.get("requires", "-")),
        "authorization=approved_by=%s;reversible=%s" % (candidate.get("approved_by", "-"),
                                                           candidate.get("reversible", "-")),
        "owner=%s" % candidate.get("owner", node_id()),
        "plan=%s" % plan_id,
        "candidate=%s" % task_id,
    ])
    ok, _ = write_ref(ref, payload)
    if not ok:
        # When two nodes discover the same cohort at once, the side that loses CAS fetches and reuses the winner; it must not mint another batch.
        fetch_refs()
        if rev_ref(ref) and _discovery_matches(parse_kv(read_ref(ref)), discovery_id, candidate):
            candidate["discovery_id"] = discovery_id
            return discovery_id
        print("discovery %s freeze failed; plan is not published" % discovery_id)
        return None
    candidate["discovery_id"] = discovery_id
    return discovery_id


def freeze_discoveries(candidates, plan_id):
    """Before a plan enters the bus, freeze every autonomous candidate; if any one has no lineage, reject the whole batch."""
    return all(freeze_discovery(candidate, plan_id) for candidate in candidates)


def receipt_has_frozen_discovery(kv):
    """A human plan may complete but has no G1 lineage; only a discovery that was really frozen may enter learning."""
    discovery_id = kv.get("discovery_id")
    if not re.fullmatch(r"d-[0-9a-f]{24}", discovery_id or ""):
        return False
    ref = "%s/%s" % (DISCOVERY_NS, discovery_id)
    if not rev_ref(ref):
        return False
    found = parse_kv(read_ref(ref))
    return (found.get("discovery_id") == discovery_id
            and found.get("candidate") == kv.get("candidate")
            and found.get("source") == kv.get("candidate_source"))


def publish_learning_candidate(kv, result_ref):
    """Build a read-only learning candidate from an accepted world result; at most one per discovery, and never overwrite."""
    discovery_id = kv.get("discovery_id")
    ref = "%s/%s" % (LEARNING_NS, discovery_id)
    if rev_ref(ref):
        return True
    discovery_ref = "%s/%s" % (DISCOVERY_NS, discovery_id)
    discovery_oid = rev_ref(discovery_ref)
    result_oid = rev_ref(result_ref)
    if not discovery_oid or not result_oid:
        return False
    payload = "\n".join([
        "discovery=%s" % discovery_id,
        "discovery_ref=%s" % discovery_ref,
        "discovery_oid=%s" % discovery_oid,
        "result=%s" % result_ref,
        "result_oid=%s" % result_oid,
        "artifact=%s" % kv.get("artifact", "-"),
        "origin=%s" % kv.get("origin_commit", "-"),
        "candidate_oid=%s" % kv.get("candidate_oid", kv.get("origin_commit", "-")),
        "landed_oid=%s" % kv.get("landed_oid", kv.get("origin_commit", "-")),
        "verification=%s" % kv.get("verification_command", "-"),
        "world_verified_at=%s" % kv.get("world_verified_at", "-"),
        "trigger_kind=%s" % kv.get("trigger_kind", "manual"),
        "created_by=%s" % node_id(),
        "created_at=%s" % fmt(now()),
    ])
    ok, _ = write_ref(ref, payload)
    if ok:
        return True
    # A node gathering at the same time may already have published first; accept only that the content exists, and do not overwrite.
    fetch_refs()
    return bool(rev_ref(ref))


def _commit_on_local_origin_refs(commit):
    """Read only local refs/remotes/origin/*: if already fetched, zero network."""
    code, refs = git("for-each-ref --format='%(objectname)' refs/remotes/origin", timeout=60)
    if code != 0:
        return False, "origin UNKNOWN: cannot read origin branches"
    for remote_sha in refs.split():
        if not re.fullmatch(r"[0-9a-f]{40}", remote_sha):
            continue
        if git("merge-base --is-ancestor %s %s" % (commit, remote_sha), timeout=60)[0] == 0:
            return True, commit
    return False, "output commit is not in the currently reachable origin history"


def commit_origin_reachable(commit):
    """Confirm the given commit is still in some origin branch history right now; never report green when the network is unknown.

    Order: (1) local origin tracking ref (zero network, so SSL jitter does not falsely kill settling)
         (2) fetch + 3 retries (the proxy chain occasionally hits SSL_ERROR_SYSCALL)
         (3) check the local ref once more.
    """
    if not re.fullmatch(r"[0-9a-f]{40}", commit or ""):
        return False, "origin_commit illegal or missing"
    ok, detail = _commit_on_local_origin_refs(commit)
    if ok:
        return True, detail
    # Fetch the ref only; do not checkout, so a dirty worktree is unaffected.
    code, out = _git_net_retry(
        "fetch --quiet origin '+refs/heads/*:refs/remotes/origin/*'",
        timeout=180,
        attempts=3,
        label="fetch_heads",
    )
    if code != 0:
        # Prefer a result already held locally; fetch failure plus a local miss → UNKNOWN
        return False, "origin UNKNOWN: %s" % (out.strip().split("\n")[-1][:120] or "no output")
    return _commit_on_local_origin_refs(commit)


def canonical_origin_ref():
    """Completion source of truth; tests may override it explicitly, and production trusts only origin/master by default."""
    raw = (os.environ.get("CORTEX_CANONICAL_REF") or
           "refs/remotes/origin/master").strip()
    if raw.startswith("origin/"):
        return "refs/remotes/%s" % raw
    return raw


def commit_canonical_landed(commit, canonical_ref=None):
    """Verify that the candidate has become an ancestor of the canonical ref, and return both kinds of OID.

    `candidate_oid` is the commit the artifact's current content is bound to; `landed_oid` is, at verification time,
    the tip of the canonical ref. Even if the candidate is already reachable on some other origin branch, that cannot replace
    canonical landing. An isolated fixture with no origin must turn the test switch on explicitly; in production,
    a missing remote or a missing canonical ref always fails closed.
    """
    ref = canonical_ref or canonical_origin_ref()
    binding = {
        "candidate_oid": commit or "",
        "landed_oid": "",
        "canonical_ref": ref,
    }
    if not re.fullmatch(r"[0-9a-f]{40}", commit or ""):
        binding["detail"] = "candidate_oid illegal or missing"
        return False, binding

    remote_code, remote_url = git("remote get-url origin", timeout=60)
    if remote_code != 0:
        if os.environ.get("CORTEX_ALLOW_NO_ORIGIN_FIXTURE") == "1":
            fixture_ref = os.environ.get("CORTEX_CANONICAL_REF") or "HEAD"
            binding["canonical_ref"] = fixture_ref
            code, tip = git("rev-parse --verify %s^{commit}" % shlex.quote(fixture_ref), timeout=60)
            tip = tip.strip().split("\n")[-1] if tip.strip() else ""
            if code == 0 and re.fullmatch(r"[0-9a-f]{40}", tip):
                binding["landed_oid"] = tip
                if git("merge-base --is-ancestor %s %s" % (commit, tip), timeout=60)[0] == 0:
                    binding["detail"] = "isolated fixture canonical landed"
                    return True, binding
            binding["detail"] = "isolated-fixture candidate has not entered %s" % fixture_ref
            return False, binding
        binding["detail"] = "origin UNKNOWN: repository has no origin; the production completion gate refuses to degrade"
        return False, binding

    # Existing isolated fixtures treat main of a local bare repo as canonical; that is compatible only for file/local
    # origins. A real network origin still defaults strictly to master, with no guess that it might be main.
    if (not os.environ.get("CORTEX_CANONICAL_REF")
            and (remote_url.strip().startswith("/") or remote_url.strip().startswith("file://"))
            and git("rev-parse --verify %s^{commit}" % shlex.quote(ref), timeout=60)[0] != 0
            and git("rev-parse --verify refs/remotes/origin/main^{commit}", timeout=60)[0] == 0):
        ref = "refs/remotes/origin/main"
        binding["canonical_ref"] = ref

    def inspect():
        code, tip = git("rev-parse --verify %s^{commit}" % shlex.quote(ref), timeout=60)
        tip = tip.strip().split("\n")[-1] if tip.strip() else ""
        if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", tip):
            return False, ""
        binding["landed_oid"] = tip
        return git("merge-base --is-ancestor %s %s" % (commit, tip), timeout=60)[0] == 0, tip

    landed, _tip = inspect()
    if landed:
        binding["detail"] = "candidate has entered canonical history"
        return True, binding

    # The local tracking ref may lag; refresh only the canonical branch, and do not mistake some other candidate's
    # "visible" for "merged". For a custom local ref, do not guess a network mapping; fail closed directly.
    prefix = "refs/remotes/origin/"
    if ref.startswith(prefix):
        branch = ref[len(prefix):]
        code, out = _git_net_retry(
            "fetch --quiet origin '+refs/heads/%s:%s'" % (
                shlex.quote(branch), shlex.quote(ref)),
            timeout=180, attempts=3, label="fetch_canonical",
        )
        if code != 0:
            binding["detail"] = "canonical UNKNOWN: %s" % (
                out.strip().split("\n")[-1][:120] or "fetch produced no output")
            return False, binding
        landed, _tip = inspect()
        if landed:
            binding["detail"] = "candidate has entered canonical history"
            return True, binding

    if binding["landed_oid"]:
        binding["detail"] = ("integration_pending: candidate %s has propagated, but is not an ancestor of %s@%s"
                             % (commit[:12], ref, binding["landed_oid"][:12]))
    else:
        binding["detail"] = "canonical UNKNOWN: cannot resolve %s" % ref
    return False, binding


def artifact_origin_reachable(artifact):
    """The output commit must already be in canonical history; it cannot stop on a candidate branch.

    A clean `git status` only proves the worktree matches this machine's HEAD; a worker once, under exactly this
    criterion, recorded "committed locally but not pushed" as a swarm-visible completion. When the remote is unreachable,
    refuse the pass rather than crush a network or permission failure into green.
    """
    quoted = shlex.quote(artifact)
    code, commit = git("log -1 --format=%%H -- %s" % quoted, timeout=60)
    commit = commit.strip().split("\n")[-1] if commit.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", commit):
        return False, "output has no local commit"

    # The first layer separates "this machine is an island" from "the candidate has propagated"; only the second layer is the canonical landing completion requires.
    isolated_fixture = (
        os.environ.get("CORTEX_ALLOW_NO_ORIGIN_FIXTURE") == "1"
        and git("remote get-url origin", timeout=60)[0] != 0
    )
    reachable, why = ((True, "isolated fixture") if isolated_fixture
                      else commit_origin_reachable(commit))
    if not reachable:
        artifact_origin_reachable.last_binding = {
            "candidate_oid": commit, "landed_oid": "",
            "canonical_ref": canonical_origin_ref(), "detail": why,
        }
        return False, why
    landed, binding = commit_canonical_landed(commit)
    artifact_origin_reachable.last_binding = binding
    if not landed:
        return False, binding.get("detail", "integration_pending")
    return True, commit


artifact_origin_reachable.last_binding = {}


def receipt_valid(kv, plan_id, task_id):
    """done can be proved only by a run-v1 receipt; an old ref may be read, but it cannot settle a new one."""
    if kv.get("status") != "done":
        return False, "status is not done"
    required = ("receipt", "plan", "candidate", "candidate_source", "claim_holder",
                "claim_since", "executor", "gate", "verification_command",
                "world_verified_at", "trigger_kind")
    missing = [key for key in required if not kv.get(key) or kv.get(key) == "-"]
    if missing:
        return False, "missing receipt fields: %s" % ",".join(missing)
    if kv.get("receipt") != "run-v1":
        return False, "receipt is not run-v1"
    if kv.get("plan") != plan_id or kv.get("candidate") != task_id:
        return False, "receipt lineage does not match plan/task"
    if kv.get("gate") not in ("passed", "scope-gap"):
        return False, "done did not pass the gate"
    if parse_ts(kv.get("world_verified_at")) is None:
        return False, "world_verified_at illegal"
    if kv.get("artifact") != "-" and not re.fullmatch(r"[0-9a-f]{40}", kv.get("origin_commit") or ""):
        return False, "file output lacks a legal origin_commit"
    if kv.get("artifact") != "-" and (kv.get("candidate_oid") or kv.get("landed_oid")):
        if not re.fullmatch(r"[0-9a-f]{40}", kv.get("candidate_oid") or ""):
            return False, "file output lacks a legal candidate_oid"
        if not re.fullmatch(r"[0-9a-f]{40}", kv.get("landed_oid") or ""):
            return False, "file output lacks a legal landed_oid"
    return True, ""


def run_receipt_payload(plan_id, task, claim, executor, status, gate, reason="", origin_commit="",
                        world_verified_at="-", trigger_kind="manual", candidate_oid="",
                        landed_oid=""):
    """Pin the lineage one run requires onto the result ref; executor text is never a receipt."""
    clean = lambda value: str(value or "-").replace("\n", " ").replace("\t", " ")[:240]
    fields = [
        ("receipt", "run-v1"),
        ("plan", plan_id),
        ("candidate", task.get("id")),
        ("candidate_source", task.get("source", "legacy-plan")),
        ("discovery_id", task.get("discovery_id", "-")),
        ("claim_holder", claim.get("holder")),
        ("claim_since", claim.get("since")),
        ("task", task.get("id")),
        ("node", node_id()),
        ("status", status),
        ("artifact", task.get("artifact", "-")),
        ("finished", fmt(now())),
        ("executor", executor),
        ("gate", gate),
        ("verification_command", task.get("short_test", "-")),
        ("world_verified_at", world_verified_at),
        ("trigger_kind", trigger_kind),
    ]
    if origin_commit:
        fields.append(("origin_commit", origin_commit))
        # origin_commit is kept for old readers; a new receipt explicitly separates the output-bound commit from
        # the canonical tip, so "some remote candidate is reachable" is not read as "already landed on the trunk".
        fields.append(("candidate_oid", candidate_oid or origin_commit))
        fields.append(("landed_oid", landed_oid or origin_commit))
    if reason:
        fields.append(("reason", reason))
    # [EX14 | T36] The failure timestamp is the cooldown criterion. done does not need one
    # (done is terminal, and nobody claims it again), but failed must keep failed_at,
    # or when cmd_claim sees status=failed it cannot tell whether the cooldown has already passed.
    if status == "failed":
        fields.append(("failed_at", fmt(now())))
    return "\n".join("%s=%s" % (key, clean(value)) for key, value in fields)


def porcelain_changes(output):
    """From combined stdout/stderr git status output, keep only the porcelain records."""
    return [line for line in output.splitlines()
            if re.match(r"^[ MADRCU?!]{2} ", line)]


def run_deterministic_backlink(plan_id, task):
    """Apply the purely mechanical map-backlink-gap fix, and let the orchestrator propagate it.

    The change and the acceptance for this kind of task are fully defined by the scanner; a model does not need to guess. A restricted Coding
    Agent should not own the `.git` lifecycle either: it may be able to fix the prose but unable to create index.lock.
    Here, accept only a single, clean, in-bounds artifact; commit it exactly onto a dedicated remote branch, and never touch
    any other staged or dirty file.
    """
    artifact = task.get("artifact") or ""
    if task.get("source") != "map-backlink-gap":
        return "[ADAPTER_FAILED]\nunsupported deterministic source"
    if not artifact or artifact == "-" or artifact != (task.get("bounds") or ""):
        return "[ADAPTER_FAILED]\nbacklink task must have one artifact equal to bounds"
    full = os.path.abspath(os.path.join(ROOT, artifact))
    if not full.startswith(os.path.abspath(ROOT) + os.sep) or not os.path.isfile(full):
        return "[ADAPTER_FAILED]\nartifact is outside repo or unreadable"
    short_test = (task.get("short_test") or "").strip()
    if not short_test.startswith("python3 bin/verify-backlinks.py --check-target "):
        return "[ADAPTER_FAILED]\nshort_test is not the backlink verifier"

    marker = "<!-- cortex:map-backlink %s -->" % (task.get("discovery_id") or task["id"])
    quoted = shlex.quote(artifact)
    status_code, status_out = git("status --porcelain -- %s" % quoted, timeout=60)
    if status_code != 0:
        return "[DETERMINISTIC_RETRY]\nartifact status unreadable"
    test_code, test_out = run("cd %s && %s" % (ROOT, short_test), timeout=180)

    if test_code == 1:
        if porcelain_changes(status_out):
            return "[DETERMINISTIC_RETRY]\nartifact was dirty before deterministic edit"
        with open(full, encoding="utf-8", errors="replace") as fh:
            original = fh.read()
        addition = ("\n\n---\n\n%s\nRelated map: "
                    "[[skills/cortex-loop/MAP|Cortex Loop panorama map]]\n" % marker)
        modified = original.rstrip() + addition
        with open(full, "w", encoding="utf-8") as fh:
            fh.write(modified)
        verify_code, verify_out = run("cd %s && %s" % (ROOT, short_test), timeout=180)
        if verify_code != 0:
            # Roll back only while the file is still byte-for-byte the version this function just generated, so a concurrent human edit is not overwritten.
            with open(full, encoding="utf-8", errors="replace") as fh:
                current = fh.read()
            if current == modified:
                with open(full, "w", encoding="utf-8") as fh:
                    fh.write(original)
            return "[ADAPTER_FAILED]\nbacklink verifier stayed red: %s" % verify_out[-160:]
    elif test_code == 0:
        # The previous beat may already have committed, but push failed on the network; take over only half-finished work that carries this discovery marker.
        # Half-finished work only. An existing fix with no marker belongs to someone else; it should go moot, and do not take the credit.
        with open(full, encoding="utf-8", errors="replace") as fh:
            current = fh.read()
        if marker not in current:
            return "[DETERMINISTIC_MOOT]\nbacklink already satisfied by another actor"
        if status_out.strip() and marker not in current:
            return "[DETERMINISTIC_RETRY]\nunrecognized dirty artifact"
    else:
        return "[DETERMINISTIC_RETRY]\nbacklink source UNKNOWN: %s" % test_out[-160:]

    dirty_code, dirty_out = git("status --porcelain -- %s" % quoted, timeout=60)
    if dirty_code != 0:
        return "[DETERMINISTIC_RETRY]\nartifact status unreadable after edit"
    if porcelain_changes(dirty_out):
        message = "docs(cortex-loop): close backlink %s" % task["id"]
        helper = os.path.join(ROOT, "bin", "git-auto-commit.sh")
        commit_code, commit_out = run(
            "cd %s && %s --producer cortex-loop-backlink -m %s -- %s" % (
                shlex.quote(ROOT), shlex.quote(helper), shlex.quote(message), quoted),
            timeout=180,
        )
        if commit_code != 0:
            return "[DETERMINISTIC_RETRY]\npathspec commit failed: %s" % commit_out[-160:]

    branch = "codex/cortex/%s" % re.sub(r"[^A-Za-z0-9._-]", "-", plan_id)
    head_code, candidate = git("rev-parse HEAD", timeout=30)
    candidate = (candidate or "").strip()
    if head_code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", candidate):
        return "[DETERMINISTIC_RETRY]\nfailed to resolve immutable candidate"
    push_code, push_out = 1, ""
    for attempt in range(1, 4):
        push_code, push_out = git(
            "push origin %s:refs/heads/%s" % (candidate, branch), timeout=180)
        if push_code == 0:
            break
        if attempt < 3:
            log("deterministic push retry %s attempt=%d" % (task["id"], attempt))
            time.sleep(attempt * 2)
    if push_code != 0:
        return ("[DETERMINISTIC_RETRY]\nbranch propagation failed after 3 attempts: %s"
                % push_out[-160:])
    return "deterministic backlink applied and origin-visible on %s" % branch


def is_deterministic_backlink_task(task):
    """Direction-ledger form has no legacy `source` column; recognize by its
    mechanically fixed verifier contract, never by a fuzzy title."""
    short_test = (task.get("short_test") or "").strip()
    artifacts = [p for p in (task.get("artifact_paths") or task.get("artifact") or "").split()
                 if p and p != "-"]
    return (len(artifacts) == 1
            and short_test.startswith("python3 bin/verify-backlinks.py --check-target ")
            and artifacts[0] in shlex.split(short_test)[3:4])


def apply_deterministic_backlink_in_workspace(worktree, task):
    """Apply one scanner-defined backlink inside an isolated attempt.

    Commit, publish, testing, and canonical landing remain owned by the common
    workspace runtime. This function only performs the deterministic file edit.
    """
    if not is_deterministic_backlink_task(task):
        return 2, "not a deterministic backlink contract"
    artifact = next(p for p in (
        task.get("artifact_paths") or task.get("artifact") or "").split() if p != "-")
    full = os.path.realpath(os.path.join(worktree, artifact))
    root = os.path.realpath(worktree)
    if not full.startswith(root + os.sep) or not os.path.isfile(full):
        return 2, "artifact outside attempt or unreadable"
    short_test = (task.get("short_test") or "").strip()
    code, out = run("cd %s && %s" % (shlex.quote(worktree), short_test), timeout=180)
    if code == 0:
        return 3, "backlink already satisfied in frozen base"
    if code != 1:
        return 75, "backlink verifier UNKNOWN: %s" % out.strip()[-160:]
    with open(full, encoding="utf-8", errors="replace") as fh:
        original = fh.read()
    marker = "<!-- cortex:map-backlink %s -->" % task["id"]
    modified = original.rstrip() + (
        "\n\n---\n\n%s\nRelated map: "
        "[[skills/cortex-loop/MAP|Cortex Loop overview map]]\n" % marker)
    with open(full, "w", encoding="utf-8") as fh:
        fh.write(modified)
    verify_code, verify_out = run(
        "cd %s && %s" % (shlex.quote(worktree), short_test), timeout=180)
    if verify_code != 0:
        with open(full, encoding="utf-8", errors="replace") as fh:
            current = fh.read()
        if current == modified:
            with open(full, "w", encoding="utf-8") as fh:
                fh.write(original)
        return 2, "backlink verifier stayed red: %s" % verify_out.strip()[-160:]
    return 0, "deterministic backlink applied in attempt workspace"


# ── autonomous task discovery ──────────────────────────────────────────
# Tasks do not have to be written by a person: CORTEX is full of ready work, but nobody is scanning it.
#
# Core design: **the scanner is both the finder and the verifier**.
# A candidate's short_test is the scan command that found it -- the criterion is not invented:
# the scanner reports WARN now, and after the task is done it must go green. There is no room to reinterpret.
#
# Trust climb (operator: start with small work and accumulate trust a little at a time):
# candidates are auto-graded to min_trust by risk. An L1 node only qualifies for read-only or single-file jobs;
# HAAS rises after they land, and only then can it take cross-file work. **Qualification is earned, not configured.**

SCANNERS = [
    # (id, scan command, hit-criterion regex, task title template, risk level, value layer, bounds)
    ("skill-reg", "bash bin/verify-skill-integration.sh --check registry 2>&1",
     "\u672a\u6ce8\u518c\uff1a(\\S+)", "register skill %s in SKILLS-TAXONOMY", "L1", "V2", "skills/"),
    ("recipe-entry", "python3 bin/verify-recipe-entry-contract.py check-all 2>&1",
     r"registry missing recipe: (\S+)", "add an Entry contract registration for recipe %s", "L1", "V2",
     "skills/loop-engineering-hub/"),
    ("asset-reg", "bash -c 'test -s work-studio/devops/infrastructure/data/cortex-asset-registry.json && echo OK || echo MISSING'",
     r"MISSING", "world-state snapshot cortex-asset-registry.json is missing or empty -- the asset-health timing signal is down", "L1", "V2",
     "work-studio/devops/infrastructure/"),
]


def scan_self_defects():
    """Introspection scan: turn **this node's own faults** into swarm tasks too.

    Architecture gap named by the operator on 2026-07-29: during a 4-hour unattended window, two nodes each failed
    50 tasks in a row, one because "launchd does not inherit HTTP(S)_PROXY, so a direct Anthropic connection is geo-blocked with 403" and one because
    "systemd does not inherit ANTHROPIC_* environment variables", but the system
    **never treated either failure as a task to fix** -- the scanners only look for contract debt in the repo
    and cannot see "I myself am sick".
    (Note: I first inferred the Mac side as "the lock screen cannot reach the keychain". Independent verification overturned that --
    pmset showed the machine never slept, and an env -i isolation test proved that adding the proxy alone was enough; the keychain was never involved.
    The wrong hypothesis sat in this comment for a while. Corrected here; the trace is ERRORS E012.)

    The essential difference from repo tasks: **the output is not a file** (what changes is the node environment /
    remote service config), so artifact can only be "-", and the completion criterion can only be "the symptom is gone".
    That is also why the artifact="-" placeholder must be handled correctly by C1 and the mechanical gate (already fixed).
    """
    out = []
    prof = node_profile()
    me = prof["node"]

    # (1) executor suppressed = this node has a real fault, and the suppression was applied automatically, not by a person
    for ex in ("claude", "codex", "openclaw", "ollama"):
        hushed, kind, left = exec_suppressed(ex)
        if not hushed:
            continue
        # auth needs a person to supply credentials; a machine cannot fix it. quota waits for the window to heal and needs no task
        if kind != "auth":
            continue
        out.append({
            "id": "selfheal-%s-auth" % ex, "source": "self-defect",
            "title": "fix this node's %s executor auth failure (currently suppressed, %d minutes left)" % (ex, left),
            "requires": "-",          # whoever can do it should; this node itself may, using another executor
            "bounds": "-",            # the change is environment or config, not a repo file
            "min_trust": "L1", "reversible": "yes", "value": "V3", "weight": "2",
            "artifact": "-",
            # completion criterion = the symptom is actually gone: one real call succeeds
            "short_test": "bash bin/cortex-loop-tests/exec-alive.sh %s" % ex,
            "approved_by": "-"})

    # (2) driver red = the clock/scheduler layer is faulty and directly hurts unattended operation
    code, _ = run("cd %s && bin/cortex-loop health >/dev/null 2>&1" % ROOT, timeout=200)
    if code != 0:
        out.append({
            "id": "selfheal-health-red", "source": "self-defect",
            "title": "this node health is red: the driver layer has a real execution failure, and the swarm has refused to advance automatically",
            "requires": "-", "bounds": "-",
            "min_trust": "L3",        # touching the scheduler is riskier than editing docs
            "reversible": "yes", "value": "V3", "weight": "3",
            "artifact": "-",
            "short_test": "bin/cortex-loop health",
            "approved_by": "-"})

    # (3) cross-environment consistency regression = the ERRORS E012 hardening gate (the same root cause bit three times that night)
    code, _ = run("cd %s && bash bin/cortex-loop-tests/env-parity.sh >/dev/null 2>&1" % ROOT,
                  timeout=60)
    if code != 0:
        out.append({
            "id": "selfheal-env-parity", "source": "self-defect",
            "title": "scheduler environment-variable declaration missing: unattended calls will fail (same pattern as ERRORS E012)",
            "requires": "-", "bounds": "work-studio/devops/dotfiles/",
            "min_trust": "L3", "reversible": "yes", "value": "V3", "weight": "2",
            "artifact": "-",
            "short_test": "bash bin/cortex-loop-tests/env-parity.sh",
            "approved_by": "-"})

    # (4) declaration detached from reality = the name and the fact have split, and that split is the defect to fix
    code, _ = run("cd %s && bin/cortex-loop reconcile >/dev/null 2>&1" % ROOT, timeout=120)
    if code != 0:
        out.append({
            "id": "selfheal-drift", "source": "self-defect",
            "title": "CLOCK's declared driver does not match reality (DRIFT); the heartbeat may not be running at all",
            "requires": "-", "bounds": "-",
            "min_trust": "L3", "reversible": "yes", "value": "V3", "weight": "2",
            "artifact": "-",
            "short_test": "bin/cortex-loop reconcile",
            "approved_by": "-"})

    # (5) CI red -- "every problem we touch should be a native task" (operator 2026-07-29)
    #
    # Why this must be picked up automatically instead of waiting for someone to read the log: CI runs once a day. If it only lands in a log,
    # it degrades into a more expensive alarm -- exactly the shape the swarm charter says to avoid
    # ("finding work you cannot finish is not a swarm"). A finding must become dispatchable work.
    #
    # Dispatch the three states separately, because **their severity and their fixes are completely different** (dimensional expansion):
    #   exit code 2 = drifted (the target was lowered / a gate was removed / a sentinel was painted green) -> most severe, L4 + irreversible
    #   exit code 1 = test failure (functional regression)              -> severe, L3
    #   exit code 0 = all green                              -> no task
    # Collapsing 2 and 1 into one "CI failed" makes "someone dismantled the defense" and "one case failed"
    # share one priority queue -- the former is institutional risk, the latter is an engineering defect.
    ci_state = os.path.expanduser("~/.openclaw/state/cortex-ci.jsonl")
    if os.path.isfile(ci_state):
        try:
            with open(ci_state, encoding="utf-8") as fh:
                last = [l for l in fh.read().split("\n") if l.strip()][-1]
            rec = json.loads(last)
        except Exception:
            rec = None
        if rec:
            if int(rec.get("drifted") or 0) == 1:
                out.append({
                    "id": "ci-drift", "source": "self-defect",
                    "title": "CI reports drift: a target threshold was lowered / a machine gate was removed / a counter-test sentinel was painted green",
                    # Only **a node that has the CI clock installed** can reproduce and verify this -- declare the capability,
                    # do not hard-code a node name (operator 2026-07-29: each node has its own capabilities;
                    # WeChat import exists only on Mac; orchestrate by capability, not by name).
                    # runtime.launchd carries the CI clock. When CI moves to the production side,
                    # switch it to runtime.systemd. The engine and the task definition do not need to change.
                    "requires": "runtime.launchd", "bounds": "-",
                    # L4 + reversible=no: restoring a target or a gate is an institutional act and needs a human signature (C3 will block)
                    "min_trust": "L4", "reversible": "no", "value": "V3", "weight": "3",
                    "artifact": "-",
                    "short_test": "bash bin/cortex-ci.sh --quiet",
                    "approved_by": "-"})
            elif int(rec.get("fail") or 0) > 0:
                out.append({
                    "id": "ci-regression", "source": "self-defect",
                    "title": "CI test regression: %s cases red (last all-green run had %s)"
                             % (rec.get("fail"), rec.get("pass")),
                    # The test suite itself is cross-platform (plain python3 + git), so any node can run it,
                    # and runtime is not restricted -- the difference from the line above is what capability dispatch means:
                    # both are CI problems; one only a specific node can fix, and one anyone can fix.
                    "requires": "-", "bounds": "-",
                    "min_trust": "L3", "reversible": "yes", "value": "V3", "weight": "2",
                    "artifact": "-",
                    "short_test": "bash bin/cortex-loop-tests/suite.sh",
                    "approved_by": "-"})
    return out


def own_skill(path):
    """Is this skill **ours**, and can we change it? An external vendor symlink never is.

    2026-07-29 on-machine proof (this engine dispatched the same impossible task on two consecutive beats):
      skills/YC-autoplan -> ${CORTEX_VENDOR_SKILLS}/gstack/autoplan
      find skills -maxdepth 1 -type l | wc -l  →  48
    48 skills are third-party symlinks pointing outside the vault (gstack and others): the content is not in this repo, is not under
    git, and the executor sandbox cannot reach it. The island, contract, and lowland scanners only look at the glob of `skills/*/SKILL.md`
    and **do not look at whether it is a symlink**, so they dispatched vendor skills as our own debt.

    The consequence is not one failure. It is **infinite repeated failure**: island-YC-autoplan was dispatched
    once at 07:49 and once at 08:28. Each time it burned a full quota round, output stayed at zero, and the queue still held YC-benchmark and 47
    more of the same kind. Dispatching impossible work from the find-work layer inflates the pass-rate denominator for free.

    The criterion uses realpath rather than only islink -- a symlink to a symlink, or a symlink somewhere inside the directory, is still caught.
    """
    real = os.path.realpath(path)
    return real == os.path.abspath(path) or real.startswith(ROOT + os.sep)


def scan_contract_debt():
    """Antigen recognition for the immune system: check each asset against the Evolve contract and find the ones that **originally** fail.

    The key: **read the raw verdict, not the audit's conclusion.**
    audit grants leniency to existing assets ("existing stock may only hold steady or reduce debt") -- that mercy belongs on the commit gate,
    but it is fatal for the immune system: leniency hides every antigen, the checkup reports 100% PASS,
    while in reality most of the 549 skills are missing fields. A merciful gate is not an honest checkup.

    Leverage weight: hubs (those with many spokes) that are missing more rank higher -- the same gap is inherited by more downstream assets.
    """
    import glob
    try:
        import importlib.machinery, importlib.util
        loader = importlib.machinery.SourceFileLoader(
            "kcg", os.path.join(ROOT, "bin/knowledge-contract-gate.py"))
        gate = importlib.util.module_from_spec(
            importlib.util.spec_from_loader("kcg", loader))
        loader.exec_module(gate)
    except Exception as exc:                       # noqa: BLE001
        print("contract checkup unavailable (%s) -- this immune path is blind; report it honestly and do not skip silently"
              % type(exc).__name__, file=sys.stderr)
        return []

    hubs = {}
    for path in glob.glob(os.path.join(ROOT, "skills/*/SKILL.md")):
        head = read_frontmatter(path)
        m = re.search(r"(?m)^host:\s*(\S+)", head)
        if m:
            hubs[m.group(1).strip()] = hubs.get(m.group(1).strip(), 0) + 1

    sick = []
    for path in sorted(glob.glob(os.path.join(ROOT, "skills/*/SKILL.md"))):
        if not own_skill(path):
            continue                               # external vendor symlink, not our debt
        name = os.path.basename(os.path.dirname(path))
        try:
            res = gate.analyze_skill(open(path, encoding="utf-8", errors="replace").read())
        except Exception:                          # noqa: BLE001
            continue
        miss = res.get("missing") or []
        if not miss:
            continue
        # severity = gap count x (1 + downstream spoke count): a hub's gap is inherited downstream
        sick.append((len(miss) * (1 + hubs.get(name, 0)), name, miss))
    sick.sort(reverse=True)

    out = []
    for sev, name, miss in sick[:4]:
        out.append({
            "id": "debt-%s" % name[:18], "source": "contract-debt",
            "title": "%s fill contract gaps %s (severity %d)" % (name, ",".join(miss[:3]), sev),
            "requires": "exec.claude", "bounds": "skills/%s/" % name,
            "min_trust": "L3" if hubs.get(name, 0) else "L1",
            "reversible": "yes", "value": "V3" if hubs.get(name, 0) else "V2",
            "weight": "2" if hubs.get(name, 0) else "1",
            "artifact": "skills/%s/SKILL.md" % name,
            "short_test": "python3 bin/knowledge-contract-gate.py check-path "
                          "skills/%s/SKILL.md --strict" % name,
            "approved_by": "-"})
    return out


def read_frontmatter(path, cap=20000):
    """Read the **full** frontmatter. Do not truncate by byte count.

    2026-07-29 sub-agent proof: three scanners used the magic number `read(1500)` to judge host/type,
    but skills/session-crash-recovery/SKILL.md has frontmatter 1686 characters long
    (description is a very long multi-line block), so `host: skill-ecosystem` fell past the cut ->
    **it had a host and was still dispatched as an island task over and over**, burning quota for zero output.

    Same root-cause class as the vendor-symlink incident: **the scanner's world is smaller than the real world**.
    The last fix widened the criterion (which files count as ours). This one deepens it (how much to read before it counts as read).
    The cap is only a safety stop (frontmatter should not be 20KB). The normal path always reads until the closing `---`.
    """
    try:
        body = open(path, encoding="utf-8", errors="replace").read(cap)
    except OSError:
        return ""
    if not body.startswith("---"):
        return body[:1500]          # no frontmatter: fall back to the old behavior and look only at the start
    end = body.find("\n---", 3)
    return body[:end] if end > 0 else body


def scan_network_evenness():
    """Find work by **filling lowlands** -- the objective is **to reduce variance**, not to maximize.

    Two strategies set by the operator on 2026-07-29:
      (1) Context density should be high **and evenly distributed** -- raise the low places first
      (2) Skills should form an **even network** -- attach the thin places first

    So this does not pick "strengthen the best again". It picks **the lowest point that sits on a hub**:
    measured, only 71 of 554 skills have ERRORS (87% lack negative space), and 58 have no host.
    Listing all of them would flood the queue, so add a leverage weight: **lowlands on hubs first** --
    a highly reused skill with no pit record means the same pit is stepped in again; a cold skill missing one does not matter.
    """
    import glob
    out = []
    # Network connectivity: an island with no host cannot hang on the hub tree, and cross-skill search will miss it
    islands = []
    vendor_islands = 0
    for path in sorted(glob.glob(os.path.join(ROOT, "skills/*/SKILL.md"))):
        if not own_skill(path):
            vendor_islands += 1
            continue          # external vendor symlink: adding a host to third-party code is both immovable and the wrong change
        head = read_frontmatter(path)
        if re.search(r"(?m)^host:\s*\S", head):
            continue
        if re.search(r"(?m)^type:\s*(master|host)", head):
            continue      # master is the tree root and does not need a host
        islands.append(os.path.basename(os.path.dirname(path)))
    if vendor_islands:
        # Excluding them is not the same as pretending we did not see them -- report the count, so the next person does not think the scanner missed them
        print("find work: skipping %d external vendor symlink skills (not in this repo; immovable, and they should not be changed)"
              % vendor_islands, file=sys.stderr)
    for name in islands[:3]:
        out.append({
            "id": "island-%s" % name[:20], "source": "skill-island",
            "title": "attach island skill %s into the host tree (network connectivity)" % name,
            "requires": "exec.claude", "bounds": "skills/%s/" % name,
            "min_trust": "L1", "reversible": "yes", "value": "V2", "weight": "1",
            "artifact": "skills/%s/SKILL.md" % name,
            "short_test": "bash bin/cortex-loop-tests/short-test-skill-host-frontmatter.sh skills/%s/SKILL.md" % name,
            "approved_by": "-"})

    # Density lowland: a hub skill (a tree root that others host) has no negative-space record
    hubs = {}
    for path in glob.glob(os.path.join(ROOT, "skills/*/SKILL.md")):
        head = read_frontmatter(path)
        m = re.search(r"(?m)^host:\s*(\S+)", head)
        if m:
            hubs[m.group(1).strip()] = hubs.get(m.group(1).strip(), 0) + 1
    for name, spokes in sorted(hubs.items(), key=lambda kv: -kv[1])[:6]:
        skill_dir = os.path.join(ROOT, "skills", name)
        if not os.path.isdir(skill_dir):
            continue
        if not own_skill(os.path.join(skill_dir, "SKILL.md")):
            continue                               # same as above: do not add ERRORS to a vendor symlink
        if os.path.isfile(os.path.join(skill_dir, "ERRORS.md")):
            continue
        out.append({
            "id": "lowland-%s" % name[:20], "source": "context-lowland",
            "title": "add an ERRORS negative space to hub skill %s (%d spokes)" % (name, spokes),
            "requires": "exec.claude", "bounds": "skills/%s/" % name,
            "min_trust": "L3", "reversible": "yes", "value": "V3", "weight": "2",
            "artifact": "skills/%s/ERRORS.md" % name,
            "short_test": "python3 bin/knowledge-contract-gate.py check-path "
                          "skills/%s/ERRORS.md" % name,
            "approved_by": "-"})
    return out


def scan_frontmatter_readable():
    """Scan files that **a person can read but a machine cannot** -- the invisible zero of Context density.

    A 2026-07-29 three-across, one-down jump found: of 5115 md files with frontmatter in the whole vault,
    **737 (14.4%) fail YAML parse**. A typical case is `name: OpenSpec: Archive`
    -- an unquoted colon. The body can be excellent and the file is still **invisible** at the metadata layer:
    Obsidian cannot index it, tag/dataview cannot query it, and any tool that searches by frontmatter misses it.

    Why this was not found before: every existing scanner asks "is the file there / are the fields complete",
    **and none asks "can a machine read it"**. So it stayed broken for months with zero alarms.

    This serves strategy (1), "even Context density", directly: a node that fails to parse has density 0,
    the lowest point in the vault -- reducing variance should fill here first, before strengthening what is already good.
    """
    out = []
    try:
        import yaml
    except ImportError:
        return out                       # without pyyaml, do not pretend the scan ran
    broken = []
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames
                       if d not in (".git", "node_modules", ".venv", "_process")]
        for fn in filenames:
            if not fn.endswith(".md"):
                continue
            path = os.path.join(dirpath, fn)
            try:
                head = open(path, encoding="utf-8", errors="replace").read(20000)
            except OSError:
                continue
            if not head.startswith("---"):
                continue                 # no frontmatter is legal; it is not broken
            parts = head.split("\n---", 1)
            if len(parts) < 2:
                continue
            try:
                yaml.safe_load(parts[0][3:])
            except Exception:
                broken.append(os.path.relpath(path, ROOT))
    if not broken:
        return out
    # Hubs first: bad frontmatter under skills/ and ace-knowledge/ has the largest blast radius
    # (referenced by the host tree and the insight network). Ordinary material going bad only affects itself.
    hub = [p for p in broken if p.startswith(("skills/", "ace-knowledge/"))]
    for rel in hub[:4]:
        out.append({
            "id": "fm-%s" % os.path.basename(rel)[:18], "source": "fm-readable",
            "title": "fix frontmatter so a machine can read %s (hub asset)"
                     % os.path.basename(rel),
            "requires": "exec.claude", "bounds": rel,
            "min_trust": "L1", "reversible": "yes", "value": "V2", "weight": "1",
            "artifact": rel,
            "short_test": "python3 bin/verify-frontmatter.py %s" % rel,
            "approved_by": "-"})
    # The total is its own single task: **do not truncate silently** -- reporting only 4 makes people think only 4 remain
    if len(broken) > len(hub[:4]):
        out.append({
            "id": "fm-bulk", "source": "fm-readable",
            "title": "unparseable frontmatter across the vault: %d total (%d hubs) awaiting batch cleanup"
                     % (len(broken), len(hub)),
            "requires": "exec.claude", "bounds": ".",
            "min_trust": "L3", "reversible": "yes", "value": "V3", "weight": "3",
            "artifact": "-",
            "short_test": "python3 bin/verify-frontmatter.py --all",
            "approved_by": "-"})
    return out


def scan_map_backlink_gaps():
    """Import MAP's mechanically fixable reverse-edge gaps into S1, instead of leaving them in a handoff doc until someone remembers.

    Accept only the three groups the operator explicitly authorized that are single-file, reversible, and mechanically verifiable: Cortex core,
    the six-laws guide, and that day's Cortex report. deterministic.backlink performs them. There is no need
    for a model to edit one deterministic wikilink.
    """
    verifier = os.path.join(ROOT, "bin", "verify-backlinks.py")
    source = "skills/cortex-loop/MAP.md"
    code, raw = run(
        "python3 %s --json %s" % (shlex.quote(verifier), shlex.quote(source)),
        timeout=180,
    )
    if code not in (0, 1):
        print("MAP reverse-edge scanner unavailable (exit code %d) -- mark this path blind" % code, file=sys.stderr)
        return []
    try:
        payload = json.loads(raw)
        rows = payload["files"][source]
    except (KeyError, TypeError, json.JSONDecodeError):
        print("MAP reverse-edge scanner output is unparseable -- mark this path blind", file=sys.stderr)
        return []
    prefixes = (
        "skills/cortex-loop/",
        "rules/on-demand/",
        "reports/2026-07-29/_standalone/",
    )
    out = []
    for row in rows:
        rel = row.get("path") or ""
        if row.get("state") != "MISSING" or not rel.startswith(prefixes):
            continue
        slug = hashlib.sha256(rel.encode("utf-8")).hexdigest()[:16]
        out.append({
            "id": "map-backlink-%s" % slug,
            "source": "map-backlink-gap",
            "title": "add the reverse edge back to cortex-loop/MAP for %s" % os.path.basename(rel),
            "requires": "-",
            "bounds": rel,
            "min_trust": "L1",
            "reversible": "yes",
            "value": "V2",
            "weight": "1",
            "artifact": rel,
            "short_test": "python3 bin/verify-backlinks.py --check-target %s %s"
                          % (shlex.quote(rel), shlex.quote(source)),
            "approved_by": "operator-2026-07-30",
        })
    return out


def _mech_fix_survives(rel, body):
    """**Try the fix in memory first**. It must still parse after the fix before it counts as mechanically fixable.

    2026-07-29 a sub-agent measured the opposite of the guess: `2026-04-16-data.json` is opens=20/closes=9,
    so by count it looked like an orphan -> I originally judged it L1 mechanically safe. **But after deleting the markers the JSON still crashed**
    (Expecting ',' delimiter: line 497) -- the markers were gone, and the structure was still rotten.
    CSV is the same: when both sides are byte-identical, deleting only the markers yields a bad CSV with the header twice.

    Conclusion: **the count is necessary but not sufficient**. Structured files must pass one more parse gate.
    Anything that fails is downgraded to L4 for a person -- a machine edit would only produce a file whose syntax is unknown.
    """
    ext = os.path.splitext(rel)[1].lower()
    if ext not in (".json", ".csv", ".yaml", ".yml"):
        return True                       # plain text: deleting markers will not break syntax
    stripped = "\n".join(l for l in body.split("\n")
                         if not re.match(r"^(<<<<<<< |=======$|>>>>>>> )", l))
    try:
        if ext == ".json":
            import json as _json
            _json.loads(stripped)
        elif ext == ".csv":
            import csv as _csv
            import io as _io
            rows = list(_csv.reader(_io.StringIO(stripped)))
            if not rows:
                return False
            if len({len(r) for r in rows if r}) != 1:
                return False              # column counts differ = still broken after the delete
            if rows.count(rows[0]) > 1:
                return False              # duplicated header = both sides are identical; deleting markers is not enough
        else:
            return False                  # YAML has no stdlib parser; do not gamble, hand it to a person
    except Exception:
        return False
    return True


def scan_data_integrity():
    """Scan **bad data sitting in the vault** -- conflict markers and leftover three-way divergence.

    Why this class must exist: on 2026-07-29 the machine found .git-sync.sh had committed a file that still contained `<<<<<<<`
    (Bug5, already fixed). The vault therefore kept a batch of files whose **content is corrupted while their status is clean**
    -- git status green, every scanner green, and no mechanism would find them.
    This defect is much worse than a missing field: a missing field is something absent; corruption means **what you read is wrong**.

    Triage does only the half a machine can do (three diseases already verified by earlier work):
      `<<<<<<<` and `>>>>>>>` counts **differ** -> orphan markers; delete the marker lines -> L1
      counts equal                          -> may be a real three-way divergence; deleting it turns the file into scrap -> L4, a person must judge
    Anything a machine cannot separate is L4 -- leave it waiting for a person rather than gambling and deleting content.
    """
    out = []
    # Must anchor at line start: scripts that **handle conflicts**, such as `.git-sync.sh`, contain this string in their body.
    # Without the anchor the tool itself is reported as bad data (a false positive measured on the machine).
    code, listing = run("cd %s && git grep -lIE --cached '^<<<<<<< ' 2>/dev/null" % ROOT,
                        timeout=180)
    # git grep exit code semantics: 0=matches, 1=**no match (normal)**, >=2 or 124=the command actually failed.
    # The old `if code != 0 and not listing.strip(): return out` merged "no match" and "the scan failed"
    # into the same silent return -- a whole-vault conflict-marker scan was fail-open: git trouble,
    # a locked repo, or a scan timeout all looked like "clean, no bad data". That silence is how bad data
    # walks through the governance layer. Separate the three states, and a failure must shout.
    if code == 124 or code >= 2:
        print("⚠️ bad-data scan did not run (git grep exit code %d) -- this path is blind, not an absence of bad data"
              % code, file=sys.stderr)
        return out
    if not listing.strip():
        return out                       # code 0/1 and no output = truly no match
    paths = [p for p in listing.strip().split("\n") if p.strip()]
    orphan, disputed = [], []
    for rel in paths:
        full = os.path.join(ROOT, rel)
        try:
            body = open(full, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        opens = len(re.findall(r"(?m)^<<<<<<< ", body))
        closes = len(re.findall(r"(?m)^>>>>>>> ", body))
        if opens == 0:
            continue                     # the marker is only mentioned; the file was not corrupted
        if opens != closes and _mech_fix_survives(rel, body):
            orphan.append(rel)
        else:
            disputed.append(rel)
    for idx, rel in enumerate(orphan[:5]):
        out.append({
            "id": "marker-%d" % (idx + 1), "source": "data-integrity",
            "title": "remove orphan conflict markers in %s (counts differ; deleting the markers is enough)" % os.path.basename(rel),
            "requires": "exec.claude", "bounds": rel,
            "min_trust": "L1", "reversible": "yes", "value": "V1", "weight": "1",
            "artifact": rel,
            "short_test": "bash -c '! grep -q \"^<<<<<<< \" %s'" % rel,
            "approved_by": "-"})
    # Divergence cases are **not split into N tasks**: splitting would be silently truncated by [:5], and the rest would vanish from the list
    # -- "it looks finished" is much more dangerous than "we know how many remain". A human judgment is one sitting
    # to read them all; splitting into N tasks only creates N context switches.
    if disputed:
        out.append({
            "id": "dispute-all", "source": "data-dispute",
            "title": "judge %d real divergence files (both sides are substantive versions; deleting the wrong one loses content)"
                     % len(disputed),
            "requires": "exec.claude", "bounds": " ".join(disputed[:3]) + " …",
            # L4: a machine cannot tell which side is right -- this gate exists to block a gamble
            "min_trust": "L4", "reversible": "no", "value": "V1", "weight": "2",
            "artifact": "-",
            "short_test": "bash -c '[ -z \"$(git grep -lIE --cached \\\"^<<<<<<< \\\")\" ]'",
            "approved_by": "-"})
    return out


# Asset health: read-only reconciliation. Global ROOT stays str; convert to Path inside the function.
# Count: absolute difference > 3, or relative to the registered value > 2%. Either one is a candidate. Exact equality is not reported.
# A directory source (ends with /, no wildcard) counts direct children; a directory with a wildcard counts matched directories;
# a filename wildcard with no slash (dt-*.md) is counted at any depth. None of them read file bodies.
# Stale: a segment's referenced file mtime, or the registry _meta.updated_at, is a candidate only when older than the threshold.
# Default 30 days. CORTEX_ASSET_HEALTH_STALE_DAYS or scan_asset_health(stale_days=) can change it.
ASSET_HEALTH_STALE_DAYS = 30
ASSET_HEALTH_COUNT_REL = 0.02
ASSET_HEALTH_COUNT_ABS = 3
ASSET_HEALTH_SKIP_DIRS = frozenset({
    ".git", "node_modules", ".venv", "venv", "__pycache__",
    ".obsidian", ".cache", "site-packages",
})
_ASSET_GLOB_CACHE = {}
_ASSET_CANDIDATE_KEYS = (
    "id", "source", "title", "requires", "bounds", "min_trust",
    "reversible", "value", "weight", "artifact", "short_test", "approved_by",
)


def _asset_health_stale_days(explicit):
    """Explicit argument first, then the environment variable, then the default of 30. An illegal value falls back to the default so discovery does not crash."""
    def parse(value, fallback):
        if isinstance(value, bool) or value is None:
            return fallback
        if isinstance(value, int):
            parsed = value
        elif isinstance(value, float):
            parsed = int(value)
        elif isinstance(value, str) and re.fullmatch(r"[0-9]+", value.strip() or ""):
            parsed = int(value.strip())
        else:
            return fallback
        if parsed < 0:
            return fallback
        return parsed

    if explicit is not None:
        return parse(explicit, ASSET_HEALTH_STALE_DAYS)
    raw = os.environ.get("CORTEX_ASSET_HEALTH_STALE_DAYS")
    if raw is None or not str(raw).strip():
        return ASSET_HEALTH_STALE_DAYS
    return parse(raw, ASSET_HEALTH_STALE_DAYS)


def _asset_health_now(now):
    if now is None:
        return datetime.now().astimezone()
    if isinstance(now, datetime):
        if now.tzinfo is None:
            return now.replace(tzinfo=datetime.now().astimezone().tzinfo)
        return now
    if isinstance(now, (int, float)) and not isinstance(now, bool):
        return datetime.fromtimestamp(now).astimezone()
    return datetime.now().astimezone()


def _asset_health_candidate(cid, title, bounds, short_test, value):
    cand = {
        "id": cid,
        "source": "asset-health",
        "title": title,
        "requires": "exec.claude",
        "bounds": bounds,
        "min_trust": "L1",
        "reversible": "yes",
        "value": value,
        "weight": "1",
        "artifact": "-",
        "short_test": short_test,
        "approved_by": "-",
    }
    assert tuple(cand) == _ASSET_CANDIDATE_KEYS
    return cand


def _asset_one_line(text, limit):
    cleaned = re.sub(r"\s+", " ", str(text or "")).strip()
    if len(cleaned) > limit:
        return cleaned[:limit]
    return cleaned


def _asset_seg_token(name):
    token = re.sub(r"[^A-Za-z0-9._-]+", "-", str(name)).strip("-")
    return token or "segment"


def _asset_count_value(value):
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, int):
        return value if value >= 0 else None
    if isinstance(value, float) and value.is_integer():
        return int(value) if value >= 0 else None
    if isinstance(value, str) and re.fullmatch(r"[0-9]+", value.strip() or ""):
        return int(value.strip())
    return None


def _asset_count_drifted(declared, actual):
    """Absolute difference greater than 3, or relative to the registered value greater than 2%. Equality with the threshold is not reported."""
    delta = abs(int(actual) - int(declared))
    if declared:
        rel = delta / float(declared)
    else:
        rel = 0.0 if delta == 0 else 1.0
    return delta > ASSET_HEALTH_COUNT_ABS or rel > ASSET_HEALTH_COUNT_REL


def _asset_clean_note(text):
    cleaned = re.sub("(\uff08[^\uff09]*\uff09)", " ", text or "")
    cleaned = re.sub(r"\([^)]*\)", " ", cleaned)
    return cleaned.strip()


def _asset_path_token(token):
    if not token or re.search(r"\s|[\u4e00-\u9fff]", token):
        return False
    if token.endswith("/") or "/" in token or any(ch in token for ch in "*?["):
        return True
    return bool(re.fullmatch(r"[A-Za-z0-9_@.+-]+\.[A-Za-z0-9]+", token))


def _asset_safe_pattern(pattern):
    if not isinstance(pattern, str):
        return False
    raw = pattern[:-1] if pattern.endswith("/") else pattern
    if not raw or len(raw) > 240:
        return False
    if raw.startswith("/") or raw.startswith("~"):
        return False
    parts = raw.replace("\\", "/").split("/")
    if any(part == ".." for part in parts):
        return False
    if re.search(r"\s|[\u4e00-\u9fff]", raw):
        return False
    return True


def _expand_asset_alt(part):
    """bin/*.sh|py -> bin/*.sh and bin/*.py. A vertical bar that cannot be read is not treated as a glob."""
    if "|" not in part:
        return [part]
    bits = [bit.strip() for bit in part.split("|") if bit.strip()]
    if len(bits) < 2:
        return [part]
    head = bits[0]
    if not _asset_path_token(head):
        return []
    out = [head]
    for bit in bits[1:]:
        if _asset_path_token(bit):
            out.append(bit)
            continue
        if re.fullmatch(r"[A-Za-z0-9]+", bit) and "." in head:
            stem, _, _ext = head.rpartition(".")
            out.append(stem + "." + bit)
            continue
        return []
    return out


def _asset_source_globs(source):
    """Extract scannable globs from a registered source. Pure explanatory text returns empty and is not used for the count."""
    if not isinstance(source, str):
        return []
    text = _asset_clean_note(source)
    if not text:
        return []
    globs = []
    seen = set()
    for part in re.split(r"\s*\+\s*", text):
        part = part.strip().strip("`\"'")
        if not part:
            continue
        tokens = part.split() if (re.search(r"[\u4e00-\u9fff]", part) or " " in part) else [part]
        for token in tokens:
            token = token.strip().strip("`\"'")
            for glob in _expand_asset_alt(token):
                if glob in seen or not _asset_safe_pattern(glob) or not _asset_path_token(glob):
                    continue
                glob = _asset_normalize_glob(glob)
                if glob in seen:
                    continue
                seen.add(glob)
                globs.append(glob)
    return globs


def _asset_normalize_glob(pattern):
    """A filename wildcard with no directory, such as dt-*.md, registers files with this name, not only the repo root."""
    body = pattern[:-1] if pattern.endswith("/") else pattern
    if "/" not in body and any(ch in body for ch in "*?["):
        return "**/" + pattern
    return pattern


def _asset_pattern_kind(pattern):
    """files=matched files; dirs=the matched directory itself; children=direct children of a concrete directory."""
    if pattern.endswith("/"):
        body = pattern[:-1]
        if not body:
            return None
        if any(ch in body for ch in "*?["):
            return ("dirs", body)
        return ("children", body)
    return ("files", pattern)


def _asset_hidden_rel(rel):
    return any(part.startswith(".") for part in rel.split("/"))


def _asset_glob_translate(pattern):
    i = 0
    n = len(pattern)
    buf = []
    while i < n:
        ch = pattern[i]
        if ch == "*":
            if i + 1 < n and pattern[i + 1] == "*":
                if i + 2 < n and pattern[i + 2] == "/":
                    buf.append("(?:.*/)?")
                    i += 3
                    continue
                buf.append(".*")
                i += 2
                continue
            buf.append("[^/]*")
            i += 1
            continue
        if ch == "?":
            buf.append("[^/]")
            i += 1
            continue
        buf.append(re.escape(ch))
        i += 1
    return "".join(buf)


def _asset_glob_regex(pattern):
    compiled = _ASSET_GLOB_CACHE.get(pattern)
    if compiled is None:
        compiled = re.compile(_asset_glob_translate(pattern))
        _ASSET_GLOB_CACHE[pattern] = compiled
    return compiled


def _asset_health_count_many(root, groups):
    """One directory walk counts every segment. Do not open file bodies, do not follow symlinks, and skip dependency and cache directories.

    Ends with / and has a wildcard: count matched directories (skills/*/references/ = those references directories).
    Ends with / and has no wildcard: count that directory's direct children. Hidden entries do not count. Do not recurse into subdirectories.
    Every other pattern counts matched files.
    """
    root = Path(root)
    compiled = {}
    for name, patterns in groups.items():
        kinds = []
        for pattern in patterns or []:
            if not isinstance(pattern, str) or not _asset_safe_pattern(pattern):
                continue
            kind = _asset_pattern_kind(pattern)
            if kind:
                kinds.append(kind)
        compiled[name] = kinds
    found = {name: set() for name in compiled}
    if not root.is_dir() or not any(compiled.values()):
        return {name: 0 for name in compiled}
    stack = [str(root)]
    root_str = str(root)

    def consider(rel, is_dir, entry_name):
        if not rel or rel == "." or rel == ".." or rel.startswith("../"):
            return
        parent = rel.rsplit("/", 1)[0] if "/" in rel else ""
        hidden = entry_name.startswith(".") or _asset_hidden_rel(rel)
        for seg, kinds in compiled.items():
            bucket = found[seg]
            if rel in bucket:
                continue
            for kind, body in kinds:
                matched = False
                if kind == "files" and not is_dir:
                    matched = _asset_glob_regex(body).fullmatch(rel) is not None
                elif kind == "dirs" and is_dir and not hidden:
                    matched = _asset_glob_regex(body).fullmatch(rel) is not None
                elif kind == "children" and not entry_name.startswith("."):
                    matched = _asset_glob_regex(body).fullmatch(parent) is not None
                if matched:
                    bucket.add(rel)
                    break

    while stack:
        current = stack.pop()
        try:
            iterator = os.scandir(current)
        except OSError:
            continue
        with iterator:
            for entry in iterator:
                try:
                    is_dir = entry.is_dir(follow_symlinks=False)
                    is_file = entry.is_file(follow_symlinks=False)
                except OSError:
                    continue
                if is_dir and entry.name in ASSET_HEALTH_SKIP_DIRS:
                    continue
                rel = os.path.relpath(entry.path, root_str)
                if os.sep != "/":
                    rel = rel.replace(os.sep, "/")
                if is_dir:
                    consider(rel, True, entry.name)
                    stack.append(entry.path)
                elif is_file:
                    consider(rel, False, entry.name)
    return {name: len(paths) for name, paths in found.items()}


def _asset_health_count_files(root, patterns):
    return _asset_health_count_many(root, {"_": list(patterns or [])}).get("_", 0)


def _asset_health_load(path):
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError, TypeError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def _asset_lexical_inside(root, full):
    try:
        Path(full).resolve().relative_to(Path(root).resolve())
    except (OSError, ValueError):
        return False
    return True


def _asset_ref_mtime(root, rel):
    """Take only mtime. If a symlink points outside the root, skip it and do not read the target."""
    if not isinstance(rel, str) or not _asset_safe_pattern(rel):
        return None
    root = Path(root)
    full = root / rel
    try:
        if not _asset_lexical_inside(root, full):
            return None
        if full.is_symlink():
            target = full.resolve()
            if not _asset_lexical_inside(root, target):
                return None
            if not target.is_file() and not target.is_dir():
                return None
            return target.stat().st_mtime
        if not full.exists():
            return None
        if not full.is_file() and not full.is_dir():
            return None
        return full.stat().st_mtime
    except OSError:
        return None


def _parse_asset_ts(value, default_tz):
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text or text == "-":
        return None
    if text.endswith("Z"):
        text = text[:-1] + "+0000"
    for pattern in (
        "%Y-%m-%dT%H:%M:%S%z",
        "%Y-%m-%dT%H:%M:%S",
        "%Y-%m-%dT%H:%M%z",
        "%Y-%m-%dT%H:%M",
        "%Y-%m-%d",
    ):
        try:
            parsed = datetime.strptime(text, pattern)
        except ValueError:
            continue
        if parsed.tzinfo is None:
            return parsed.replace(tzinfo=default_tz)
        return parsed
    return None


def _asset_path_is_stale(root, rel, days, now_dt):
    mtime = _asset_ref_mtime(root, rel)
    if mtime is None:
        return False
    return (now_dt.timestamp() - mtime) > days * 86400


def _looks_like_asset_ref(text):
    if not text or any(ch in text for ch in "*?[]|+"):
        return False
    return "/" in text


def _segment_ref_paths(seg):
    """Referenced files on a segment. source counts only when it is one concrete file; a glob does not."""
    if not isinstance(seg, dict):
        return []
    refs = []
    seen = set()

    def add(raw, force):
        if not isinstance(raw, str):
            return
        cleaned = _asset_clean_note(raw).strip()
        if not cleaned or cleaned in seen or not _asset_safe_pattern(cleaned):
            return
        if any(ch in cleaned for ch in "*?[]|+"):
            return
        if not force and not _looks_like_asset_ref(cleaned):
            return
        seen.add(cleaned)
        refs.append(cleaned)

    add(seg.get("file"), True)
    source_globs = _asset_source_globs(seg.get("source"))
    if (len(source_globs) == 1 and not source_globs[0].endswith("/")
            and not any(ch in source_globs[0] for ch in "*?[")):
        add(source_globs[0], True)
    for key, val in seg.items():
        if key in ("file", "count", "note", "source", "meta_quality"):
            continue
        if isinstance(val, str):
            add(val, False)
    return refs


def _asset_segment_count_drifted(root, registry_path, seg_name):
    reg = _asset_health_load(registry_path)
    if not reg:
        return False
    segments = reg.get("segments")
    if not isinstance(segments, dict):
        return False
    seg = segments.get(seg_name)
    if not isinstance(seg, dict):
        return False
    declared = _asset_count_value(seg.get("count"))
    patterns = _asset_source_globs(seg.get("source"))
    if declared is None or not patterns:
        return False
    actual = _asset_health_count_files(root, patterns)
    return _asset_count_drifted(declared, actual)


def _asset_segment_refs_stale(root, registry_path, seg_name, stale_days=None, now=None):
    reg = _asset_health_load(registry_path)
    if not reg:
        return False
    segments = reg.get("segments")
    if not isinstance(segments, dict):
        return False
    seg = segments.get(seg_name)
    if not isinstance(seg, dict):
        return False
    now_dt = _asset_health_now(now)
    days = _asset_health_stale_days(stale_days)
    for rel in _segment_ref_paths(seg):
        if _asset_path_is_stale(root, rel, days, now_dt):
            return True
    return False


def _meta_updated_at_is_stale(reg, days, now_dt):
    meta = reg.get("_meta") if isinstance(reg, dict) else None
    if not isinstance(meta, dict):
        return False
    parsed = _parse_asset_ts(meta.get("updated_at"), now_dt.tzinfo)
    if parsed is None:
        return False
    return (now_dt - parsed).total_seconds() > days * 86400


def _asset_registry_updated_at_is_stale(registry_path, stale_days=None, now=None):
    reg = _asset_health_load(registry_path)
    if not reg:
        return False
    now_dt = _asset_health_now(now)
    return _meta_updated_at_is_stale(reg, _asset_health_stale_days(stale_days), now_dt)


def _asset_health_check_test(expression):
    """The short test reuses the same read-only functions. A true expression means the problem is still there. Do not write bytecode."""
    engine = os.path.abspath(__file__)
    script = "\n".join([
        "import sys",
        "sys.dont_write_bytecode = True",
        "import importlib.machinery as _m",
        "import importlib.util as _u",
        "loader = _m.SourceFileLoader('cortex_loop_asset_health', %r)" % engine,
        "spec = _u.spec_from_loader(loader.name, loader)",
        "mod = _u.module_from_spec(spec)",
        "loader.exec_module(mod)",
        "sys.exit(1 if eval(%r) else 0)" % expression,
    ])
    return "PYTHONDONTWRITEBYTECODE=1 python3 -c " + shlex.quote(script)


def scan_asset_health(root=None, registry_path=None, stale_days=None, now=None):
    """World-state snapshot (cortex-asset-registry.json): references, counts, and freshness.

    RSI closed loop, the L4 -> (2) circuit: a registry reference file that does not exist means the timing signal is broken;
    verb-task-index older than 7 days means the index is stale. The fix is "rerun the push script" or "fix the reference",
    zero budget and zero LLM.

    Two more read-only signals. Candidates are reversible, trust L1:
      asset-health-count-<segment>
        When a segment has both a count and a source glob, scan it. Absolute difference greater than 3, or relative to the registered value greater than 2%,
        and either one is reported. Exact equality is not reported. A directory source counts direct children or matched directories, and does not count every file
        in the whole subtree.
      asset-health-stale-<segment>
        A segment's referenced file mtime is older than the threshold. If registry _meta.updated_at is stale, the segment name is registry.
        Default 30 days. Adjust with the environment variable CORTEX_ASSET_HEALTH_STALE_DAYS or with stale_days.

    Global ROOT stays str. This function only wraps Path(ROOT) locally. It does not read file bodies and does not go online.
    """
    root_path = Path(ROOT) if root is None else Path(root)
    if registry_path:
        reg_path = Path(registry_path)
        if not reg_path.is_absolute():
            reg_path = root_path / reg_path
    else:
        reg_path = root_path / "work-studio/devops/infrastructure/data/cortex-asset-registry.json"
    out = []
    if not reg_path.is_file():
        return out
    if not _asset_lexical_inside(root_path, reg_path):
        return out
    try:
        reg = json.loads(reg_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError, TypeError, ValueError):
        return out
    if not isinstance(reg, dict):
        return out
    now_dt = _asset_health_now(now)
    days = _asset_health_stale_days(stale_days)
    segments = reg.get("segments")
    if not isinstance(segments, dict):
        segments = {}
    count_groups = {}
    count_meta = {}
    for seg_name, seg in segments.items():
        if not isinstance(seg, dict):
            continue
        declared = _asset_count_value(seg.get("count"))
        patterns = _asset_source_globs(seg.get("source"))
        if declared is not None and patterns:
            count_groups[seg_name] = patterns
            count_meta[seg_name] = (declared, seg.get("source"))
    counted = _asset_health_count_many(root_path, count_groups) if count_groups else {}
    for seg_name, seg in segments.items():
        if not isinstance(seg, dict):
            continue
        token = _asset_seg_token(seg_name)
        file_field = seg.get("file")
        if isinstance(file_field, str) and file_field.strip():
            rel = _asset_clean_note(file_field).strip()
            if (_asset_safe_pattern(rel) and not any(ch in rel for ch in "*?[]|+")
                    and _asset_lexical_inside(root_path, root_path / rel)
                    and not (root_path / rel).exists()):
                full = root_path / rel
                out.append(_asset_health_candidate(
                    "asset-health-%s" % token,
                    "asset segment %s references a registry file that does not exist: %s" % (seg_name, rel),
                    rel,
                    "test -s %s" % shlex.quote(str(full)),
                    "V2",
                ))
        if seg_name in count_meta:
            declared, source = count_meta[seg_name]
            actual = counted.get(seg_name, 0)
            if _asset_count_drifted(declared, actual):
                delta = abs(actual - declared)
                rel = (delta / float(declared)) if declared else (0.0 if delta == 0 else 1.0)
                out.append(_asset_health_candidate(
                    "asset-health-count-%s" % token,
                    "asset segment %s count drift: declared %d, scanned %d (delta %d, %.2f%%)"
                    % (seg_name, declared, actual, delta, rel * 100),
                    _asset_one_line(source, 180),
                    _asset_health_check_test(
                        "mod._asset_segment_count_drifted(%r, %r, %r)"
                        % (str(root_path), str(reg_path), seg_name)),
                    "V2",
                ))
        stale_refs = []
        oldest = 0.0
        for rel in _segment_ref_paths(seg):
            mtime = _asset_ref_mtime(root_path, rel)
            if mtime is None:
                continue
            age_days = (now_dt.timestamp() - mtime) / 86400.0
            if age_days > days:
                stale_refs.append(rel)
                if age_days > oldest:
                    oldest = age_days
        if stale_refs:
            shown = ", ".join(stale_refs[:3])
            out.append(_asset_health_candidate(
                "asset-health-stale-%s" % token,
                "asset segment %s reference not updated for %.1f days (threshold %d days): %s"
                % (seg_name, oldest, days, shown),
                _asset_one_line(shown, 180),
                _asset_health_check_test(
                    "mod._asset_segment_refs_stale(%r, %r, %r)"
                    % (str(root_path), str(reg_path), seg_name)),
                "V1",
            ))
    if _meta_updated_at_is_stale(reg, days, now_dt):
        parsed = _parse_asset_ts((reg.get("_meta") or {}).get("updated_at"), now_dt.tzinfo)
        age_days = (now_dt - parsed).total_seconds() / 86400.0
        meta_id = "asset-health-stale-registry"
        if any(item["id"] == meta_id for item in out):
            meta_id = "asset-health-stale-registry-updated-at"
        try:
            bounds = str(reg_path.resolve().relative_to(root_path.resolve()))
        except (OSError, ValueError):
            bounds = "work-studio/devops/infrastructure/data/cortex-asset-registry.json"
        out.append(_asset_health_candidate(
            meta_id,
            "asset registry updated_at not updated for %.1f days (threshold %d days)" % (age_days, days),
            bounds,
            _asset_health_check_test(
                "mod._asset_registry_updated_at_is_stale(%r)" % (str(reg_path),)),
            "V1",
        ))
    # Index freshness. The clock matches this function's now; the production path is still the current time.
    vi = root_path / "work-studio/devops/infrastructure/data/verb-task-index.md"
    if vi.is_file():
        try:
            age_h = (now_dt.timestamp() - vi.stat().st_mtime) / 3600.0
        except OSError:
            age_h = None
        if age_h is not None and age_h > 168:  # 7 days
            out.append(_asset_health_candidate(
                "asset-health-index-stale",
                "verb-task-index.md not refreshed for %.0f days (threshold 7 days)" % (age_h / 24),
                str(vi),
                "find %s -name verb-task-index.md -mtime -7 | grep -q ."
                % shlex.quote(str(vi.parent)),
                "V1",
            ))
    return out


def discover_candidates():
    """Run the read-only scanners and turn WARN/FAIL into candidate tasks. Every one is a real scan. Do not invent work.

    Silent blindness found on 2026-07-29 (it matters more than health jitter): this used to do `code, out = run(...)`
    and then **never used the exit code**. Scanner timeout or crash -> out is empty -> 0 hits ->
    that scanner silently contributed 0 candidates, while cmd_discover still printed
    "scanned a full round and there is no work -- every mechanically checkable gap is currently green".
    "found no problem" and "the scan did not run" were merged into one output, and the direction was fail-open:
    **the whole autonomous find-work chain was built on the unchecked assumption that a scanner always succeeds.**
    SCANNERS includes whole-vault rescans (verify-skill-integration and others). timeout=180 may not be enough.
    That is not a theoretical risk. The fix: separate the three states and say which scanner failed. Never silently count 0.
    """
    found = []
    broken = []
    for sid, cmd, pattern, title_tpl, risk, value, bounds in SCANNERS:
        code, out = run("cd %s && timeout 180 %s" % (ROOT, cmd), timeout=200)
        # Judge DOWN from the exit code only, **not from whether there is output** -- this fix's own negative test caught the pit:
        # run() returns stdout and stderr merged. When a scanner crashes, stderr inevitably contains
        # something like "command not found", so "there is output" is always true,
        # and adding `and not out.strip()` welds shut the gate that was just built.
        # Exit code semantics: 0=normal, with or without hits; 1=the normal end for grep/verify "has WARN but finished",
        # 124=timeout, 127=command not found, any other >=2=the scanner itself failed. Only 0 and 1 count as ran.
        if code not in (0, 1):
            broken.append((sid, code))
            continue
        hits = []
        for m in re.finditer(pattern, out):
            item = m.group(1).strip()
            if item and item not in hits:
                hits.append(item)
        for idx, item in enumerate(hits[:5]):        # at most 5 hits per scanner, so the queue is not flooded
            # False completion caught on the machine: this kind of scanner has a non-zero exit code only on FAIL. WARN
            # does not affect the exit code -- using the scanner command itself as short_test makes the task "pass" forever,
            # whether or not it was actually fixed. Narrow it to a negative criterion: "is this specific problem still present?"
            import shlex
            base_cmd = cmd.split(" 2>&1")[0]
            item_check = ("bash -c '! (%s 2>&1 | grep -qF %s)'"
                          % (base_cmd, shlex.quote(item)))
            found.append({
                "id": "%s-%d" % (sid, idx + 1),
                "title": title_tpl % item,
                "requires": "exec.claude",
                "bounds": bounds or "skills/",
                "min_trust": risk,
                "reversible": "yes",
                "value": value,
                "weight": "1",
                "artifact": "-",              # the verifier decides; do not force a single output file
                "short_test": item_check,     # precise criterion: this specific problem no longer appears
                "approved_by": "-",
                "source": sid,
            })
    discover_candidates.last_broken = broken     # cmd_discover uses this to tell "green" from "blind"
    if broken:
        # Blindness must be visible: say which scanner did not run, instead of treating its silence as a green light
        print("⚠️ %d scanners did not run (exit code below) -- that path is **blind**, not **clear**:"
              % len(broken), file=sys.stderr)
        for sid, code in broken:
            print("      SCANNER-DOWN %s (exit code %d%s)"
                  % (sid, code, ", 124=timeout" if code == 124 else ""), file=sys.stderr)
    found.extend(scan_self_defects())        # introspection: this node's own faults are tasks to fix too
    found.extend(scan_contract_debt())       # immune: find antigens against the contract standard (read the raw verdict)
    found.extend(scan_network_evenness())    # fill lowlands: the reduce-variance objective
    found.extend(scan_data_integrity())      # bad data: status is green but the content is wrong
    found.extend(scan_frontmatter_readable())  # invisible nodes: a person can read them, a machine cannot
    found.extend(scan_map_backlink_gaps())     # authorized B/C: reverse-edge gaps enter the S1 automatic loop
    found.extend(scan_asset_health())          # reference integrity + count drift + staleness + index
    return found


def cmd_discover(args):
    """Find work on its own. By default only list candidates; --publish is what actually emits a plan."""
    cands = discover_candidates()
    selected_source = getattr(args, "source", None)
    if selected_source:
        cands = [candidate for candidate in cands
                 if candidate.get("source") == selected_source]
    if not cands:
        # "scanned nothing" is not "no problem": if a scanner failed, do not report green, or blindness disguises itself as health
        down = getattr(discover_candidates, "last_broken", [])
        if down:
            print("no work came out of the scan, but %d scanners did not run (%s) -- this is **blind**, not a green light"
                  % (len(down), " ".join(s for s, _ in down)))
            return 1
        print("scanned a full round and there is no work -- every mechanically checkable gap is currently green")
        return 0
    # DECIDE sort: **leverage and compounding first; within a tier, bite the small ones first**.
    # Sorting by ease alone would keep the swarm picking the easiest work that has no value;
    # sorting by value alone would send an L1 node straight into a bar it cannot clear.
    # Compound factor: a fix that makes the scanner stay green **permanently** (a structural fix) ranks above a one-time cleanup.
    cost = {"L1": 1, "L3": 2, "L4": 4}
    leverage = {"V1": 1, "V2": 3, "V3": 6}
    # Compound factor: a structural fix that makes the scanner stay green **permanently** ranks above a one-time cleanup.
    # The two lowland-filling classes get the highest weight -- the marginal gain of lifting the lowest point beats decorating what is already good (reduce variance).
    # data-integrity gets 4: bad data is not "something missing". **What you read is wrong** --
    # it contaminates every downstream judgment, and leaving it unfixed compounds negatively.
    # self-defect gets 12 = it outweighs everything (priority principle decided by the operator on 2026-07-29):
    # **when the engine itself is unreliable, 742 content fixes are polishing a broken machine.**
    # self-defect used to be absent from this table -> default factor 1 -> "I myself am broken" ranked below
    # "decorate the content", which is backwards. System health is the premise of every output,
    # not an item that sits beside output.
    compound = {"self-defect": 12,
                "skill-reg": 2, "recipe-entry": 2, "contract-debt": 3,
                "data-integrity": 4, "data-dispute": 1,
                "skill-island": 4, "context-lowland": 5}
    for c in cands:
        c["score"] = round(
            leverage.get(c["value"], 1) * compound.get(c.get("source"), 1)
            / cost.get(c["min_trust"], 4), 2)
    # ── quota awareness (operator 2026-07-29): sorting cannot look only at value. It also has to look at **what can be carried right now**.
    # A high tier that is not suppressed has strong reasoning compute, and it should be spent on high-leverage work;
    # once dropped to fast/local, a weak model chewing on high-leverage work only fails, and failure also deducts HAAS.
    # Then reverse it: clear the cheap work first and wait out the quota window.
    _tier, _model, _ = pick_model()
    rich = _tier in ("frontier", "balanced")
    if not rich:
        # Weak tier: double the cost weight -- expensive work sinks to the bottom. It is deferred, not forbidden
        for c in cands:
            c["score"] = round(c["score"] / cost.get(c["min_trust"], 4), 2)
    # **The sort strategy flips with trust** -- this is the core of the climb:
    #   low trust (L1/L2): bite the small ones first. The point is not to save effort. It is **to bank score with a streak of finishes**,
    #                  like leveling up -- fighting a boss before the level is high enough only fails, and failure also deducts HAAS.
    #   high trust (L3+): the reverse. Leverage and compounding first. Bite the hard important work first.
    #                  The node has already proved itself, and spending compute on small work is the waste.
    _h0, _ = haas_score(node_id())
    _t0 = trust_level(_h0)
    # When quota is weak, force the climb sort (small work first) -- a weak model plus a hard task is a losing pair
    climbing = _t0 in ("L1", "L2") or not rich
    if climbing:
        cands.sort(key=lambda c: (cost.get(c["min_trust"], 9), -c["score"]))
    else:
        cands.sort(key=lambda c: (-c["score"], cost.get(c["min_trust"], 9)))
    print("found %d candidates (risk ascending, bite the small ones first to accumulate trust)\n" % len(cands))
    print("| score | id | task | bar | value | check (= the scanner that found it) |")
    print("|----|----|------|------|------|--------------------------|")
    for c in cands:
        print("| %.2f | %s | %s | %s | %s | `%s` |"
              % (c["score"], c["id"], c["title"][:34], c["min_trust"],
                 c["value"], c["short_test"][:34]))
    print("\nscore = leverage(V1/2/3) x compound factor / cost(bar)")
    print("current tier: **%s** (%s) -> %s"
          % (_tier or "none", _model or "-",
             "quota is ample, high leverage first" if rich else "quota is limited, cost weight doubled, expensive work sinks"))
    print("sort strategy: %s" % ("**climbing** (trust %s) -> bite the small ones first and bank the score; each finish raises it a little, "
                            "and it switches automatically once the level is high enough" % _t0 if climbing else
                            "**past the climb** (trust %s) -> leverage and compounding first, bite the hard ones first" % _t0))
    # Eligible to take it: trust is earned, not configured
    _h, _ = haas_score(node_id())
    _t = trust_level(_h)
    ok_now = [c for c in cands
              if ["L1", "L2", "L3", "L4", "L5"].index(c["min_trust"])
              <= ["L1", "L2", "L3", "L4", "L5"].index(_t)]
    print("this node's trust %s (HAAS %.3f) -> eligible for %d/%d right now"
          % (_t, _h, len(ok_now), len(cands)))
    if len(ok_now) < len(cands):
        print("the rest wait for trust to rise -- turn the eligible ones green, HAAS rises on its own, and the bar unlocks")

    if not args.publish:
        print("\nlist only, do not publish. To actually emit a plan: cortex-loop discover --publish")
        return 0

    plan_id = args.plan_id or "auto-%s" % now().strftime("%m%d%H%M")
    fetch_refs()
    ref = "%s/%s" % (PLAN_NS, plan_id)
    if rev_ref(ref):
        print("plan %s already exists (immutable); pick another --plan-id" % plan_id)
        return 1
    if not freeze_discoveries(cands, plan_id):
        return 1
    lines = [plan_task_line(c) for c in cands]
    payload = "\n".join([
        "plan=%s" % plan_id, "intent=mechanically verifiable gaps found autonomously (the scanner is the verifier)",
        "by=%s" % node_id(), "created=%s" % fmt(now()),
        "tasks=%d" % len(lines), ""] + lines)
    ok, _ = write_ref(ref, payload)
    print("\npublished plan %s (%d tasks): %s" % (plan_id, len(lines), "ok" if ok else "FAIL"))
    log("discover published=%s n=%d" % (plan_id, len(lines)))
    return 0 if ok else 1


def cmd_plan(args):
    """Any node can publish a plan -- this is the entrance to decentralized orchestration. There is no leader."""
    lines = []
    with open(args.tasks, encoding="utf-8") as fh:
        for row in fh:
            row = row.strip()
            if not row or row.startswith("#"):
                continue
            parts = [p.strip() for p in row.split("|")]
            if len(parts) not in (7, 11):
                print("dropped (field count %d, expected 11 for all six-law fields or 7 for the compatible format): %s"
                      % (len(parts), row[:60]))
                continue
            # The new format also records a source for a hand-published plan; a 7-field compatible plan is still read under the old contract.
            if len(parts) == 11:
                parts.append("manual")
                parts.append("-")       # a hand plan has no frozen discovery, so it does not count toward G1.
            lines.append("task\t" + "\t".join(parts))
    if not lines:
        print("no eligible subtasks; refusing to publish an empty plan")
        return 1
    payload = "\n".join([
        "plan=%s" % args.id, "intent=%s" % args.intent,
        "by=%s" % node_id(), "created=%s" % fmt(now()),
        "tasks=%d" % len(lines), ""] + lines)
    fetch_refs()
    ref = "%s/%s" % (PLAN_NS, args.id)
    if rev_ref(ref):
        print("plan %s already exists and is immutable; to change it, publish a new id and write supersedes in the intent" % args.id)
        return 1
    ok, _ = write_ref(ref, payload)
    print("published plan %s (%d subtasks, publishing node %s): %s"
          % (args.id, len(lines), node_id(), "ok" if ok else "FAIL"))
    log("plan %s tasks=%d ok=%s" % (args.id, len(lines), ok))
    return 0 if ok else 1


def node_load(me):
    """How many are **actually still running** in hand (look them up from claim refs; do not trust local state -- it is lost on restart).

    Lockup caught on the machine on 2026-07-29: a claim expires only by TTL (default 60min), and **writing a result
    does not release it**. After a node finishes 3 tasks, those just-finished jobs still count as "3 still in hand"
    and pin it at max_load=3, so it accepts nothing for a full hour.
    Real log from the first beat after the worker's health was fixed and it came back:
      pass | island-image-to-code — overloaded (current 3 + this task 1 > limit 3)
      this node's worker executed 0: -
    And 2 of those 3 claims **already had a result** (1 done + 1 failed).
    Health was fixed, but the node still could not do any work -- stuck on this fake load.

    The fix is on the read side, not by deleting the ref: a claim that has a result does not count toward in-flight load.
    A read-side fix is safer than deleting the claim ref on completion -- it adds no new delete-ref path and no CAS race,
    and it takes effect immediately on zombie claims already piled up, without waiting for someone to clean them.
    """
    # Fetch the result set **once** (one for-each-ref subprocess). Do not query each claim separately.
    # The first version called read_ref(result) per claim, and the machine paid immediately: that worker beat
    # grew from 2min50s until it blew through TimeoutStartSec=300 and systemd killed it
    # (`start operation timed out. Terminating.`). read_ref is a local git cat-file,
    # but each call forks a subprocess. Many claims means dozens of forks -- each one looks cheap alone,
    # and on the heartbeat hot path it became the last straw that crushed the 5-minute budget.
    done_tasks = set(list_refs(RESULT_NS))
    load = 0
    for ref in list_refs(CLAIM_NS):
        kv = parse_kv(read_ref(ref))
        expires = parse_ts(kv.get("expires"))
        if kv.get("holder") != me or not expires or expires <= now():
            continue
        # already has a result = this task is finished (done or failed) and does not occupy an in-flight slot
        if ref.replace(CLAIM_NS, RESULT_NS, 1) in done_tasks:
            continue
        load += 1
    return load


def _cap_satisfied(need_pattern, have_caps):
    """Whether one requirement is satisfied -- glob match, not literal ==.

    Existing tasks all write exact strings (such as "exec.claude"). fnmatch on an exact string with no wildcard
    behaves the same as ==, so there is zero regression. A new task uses a wildcard only when it writes a pattern such as "model.anthropic.*".
    Every old task's verdict stays the same, one by one.
    """
    return any(fnmatch.fnmatch(cap, need_pattern) for cap in have_caps)


def fit_score(task, prof, load, max_load):
    """Capability-set match plus load. A task declares which capabilities it needs, and the node checks whether it has them -- glob match.

    The old hard-coded dimensions requires_executor / requires_kind are absorbed into capability IDs
    (exec.* / host.*). Backward compatible, but new tasks should write requires directly.
    """
    have = set((prof.get("caps") or " ".join(node_capabilities())).split())
    need = {r for r in (task.get("requires") or "").split() if r != "-"}
    # "-" is the "no requirement" placeholder (the same convention as bounds, approved_by, and other fields), not a literal capability name.
    # Leaving this line out treats "-" as a capability named "-", and no node can pass fit_score.
    # Backward compatible: old fields are translated into capability IDs
    if task.get("requires_executor", "-") not in ("-", ""):
        need.add("exec.%s" % task["requires_executor"])
    if task.get("requires_kind", "-") not in ("-", ""):
        need.add("host.%s" % task["requires_kind"])
    missing = {n for n in need if not _cap_satisfied(n, have)}
    if missing:
        return None, "missing capability %s" % " ".join(sorted(missing))
    try:
        weight = int(task.get("weight") or 1)
    except ValueError:
        weight = 1
    if load + weight > max_load:
        return None, "overloaded (current %d + this task %d > limit %d)" % (load, weight, max_load)
    return 1.0 - (load / float(max_load)), "claimable"


def cmd_claim(args):
    """Self-assess, then CAS to grab. Losing the grab is not an error. Someone else was faster -- take the next one."""
    fetch_refs()
    prof = node_profile()
    me = prof["node"]
    load = node_load(me)
    claimed = []
    for task in plan_tasks(args.plan):
        ref = "%s/%s/%s" % (CLAIM_NS, args.plan, task["id"])
        old = rev_ref(ref)
        if old:
            kv = parse_kv(read_ref(ref))
            expires = parse_ts(kv.get("expires"))
            if expires and expires > now():
                continue                      # a live claim is in someone else's hands (or my own)
        _r = parse_kv(read_ref("%s/%s/%s" % (RESULT_NS, args.plan, task["id"])))
        if _r.get("status") == "done":
            continue                       # skip only when it is truly done
        if _r.get("status") == "failed":
            # failed is not a terminal state. The old "skip if there is a result" did not separate done from failed and printed nothing,
            # so R1 was locked forever after the laptop gateway died. The worker could have done it and still could not take it --
            # one failure sentenced the task to death, and the swarm's fault tolerance was gone.
            #
            # [EX14 | T36] Tighten further: even if the last failure was this node, do not strike it out in one blow.
            # Use a cooldown window (FAIL_COOLDOWN_MIN, default 5 minutes):
            # - inside the window: this node and others both skip, so the same bad gateway is not hit again immediately
            # - after the window: this node may claim again -- the gateway or model may have recovered
            # The real backstop is fail_count: escalate to ESCALATE only after N consecutive failures, but
            # a single failure does not seal this node's right to retry. This is the root fix for the 2026-07-29 R1 reproduction.
            failed_at = parse_ts(_r.get("failed_at"))
            in_cooldown = (failed_at is not None
                           and (now() - failed_at).total_seconds() < FAIL_COOLDOWN_MIN * 60)
            if in_cooldown:
                who = "this node" if _r.get("node") == me else "previous %s" % _r.get("node")
                print("cooldown | %s %s failed and is still inside the cooldown window (%dmin) -> skip for now"
                      % (task["id"], who, FAIL_COOLDOWN_MIN))
                continue
            who = "this node" if _r.get("node") == me else "previous %s" % _r.get("node")
            print("retry | %s %s failed and the cooldown window has passed; this node retries (cooldown/retry)"
                  % (task["id"], who))
        score, why = fit_score(task, prof, load, args.max_load)
        if score is None:
            print("pass | %s — %s" % (task["id"], why))
            continue
        # Three gates of the six laws: intent is the boundary / trust is the measure / safety is the floor. Any miss blocks execution, and the message says which one blocked.
        haas, _facts = haas_score(me)
        trust = trust_level(haas)
        allowed, law, reason = covenant_check(task, prof, trust, haas)
        if not allowed:
            print("stop  | %s — [%s] %s" % (task["id"], law, reason))
            continue
        payload = "holder=%s\nexpires=%s\nsince=%s\ntask=%s" % (
            me, fmt(now() + timedelta(minutes=args.ttl_min)), fmt(now()), task["id"])
        ok, _ = write_ref(ref, payload, parent=old)
        if ok:
            load += int(task.get("weight") or 1)
            claimed.append(task["id"])
            print("claim | %s ← %s" % (task["id"], me))
        else:
            print("lost  | %s lost the race to another node (CAS held)" % task["id"])
        if args.limit and len(claimed) >= args.limit:
            break
    print("this node %s claimed %d: %s" % (me, len(claimed), " ".join(claimed) or "-"))
    return 0


# ── atomic implant of the Mobfish collaboration laws ────────────────────
# Source of truth: aboutme/methods/mobfish-six-laws.md
#   C1 intent is the boundary: human intent is the only boundary of AI action; unauthorized means out of bounds
#   C2 trust is the measure: autonomy is decided by **verifiable** trust, not a binary switch
#   C3 safety is the floor: let go of what is reversible, be careful with what is irreversible, and a breach must be answered (STOP->REPORT->WAIT->RECORD)
# Landing principle: each law = one field + one mechanical gate. No new infrastructure.

INCIDENT_NS = "refs/swarm/%s/incident" % SWARM_NAME
TRUST_LEVELS = [("L1", 0.0), ("L2", 0.5), ("L3", 0.7), ("L4", 0.85), ("L5", 0.95)]


# ── transparency cap: unverifiable information means trust cannot rise ──
# Mechanism decided by the operator on 2026-07-29: the more transparent, true, and verifiable a node's structured information is, the higher its trust;
# missing or unverifiable information caps trust. Disguise has no payoff -- looking pretty cannot buy autonomy.
#
# In the implementation **do not tamper with the four C2 weights of the six laws** (that is the source of truth). Apply this as a **ceiling** on top:
#   attest passed + fields complete  -> no cap (can reach L5)
#   fields missing, or attest not done -> cap 0.70 (L3 at most; reversible work only)
#   attest failed (self-report != measured) -> record a breach + cap 0.49 (back to L1, read only)

REQUIRED_TRANSPARENCY = ("node", "swarm", "kind", "can_sleep", "caps", "last_seen")


def transparency_cap(prof):
    """Return (ceiling score, reason)."""
    missing = [f for f in REQUIRED_TRANSPARENCY if not (prof.get(f) or "").strip()]
    caps = (prof.get("caps") or "").split()
    has_model = any(c.startswith("model.") for c in caps)
    has_billing = any(c.startswith("billing.") for c in caps)
    attested = (prof.get("attested") or "unverified").lower()

    if attested == "failed":
        return 0.49, "attest failed: self-reported model does not match the measurement -- cap at L1 (read only)"
    if missing:
        return 0.70, "missing field %s -- cap at L3" % " ".join(missing)
    if not (has_model and has_billing):
        return 0.70, "model.* / billing.* not published -- cap at L3"
    if attested != "yes":
        return 0.70, "attest not done (model has not signed) -- cap at L3"
    return 1.0, "transparency complete and attested -- no cap"


def cmd_attest(args):
    """Verify that the executor really **is** the model it declares.

    Three strengths. Use whichever layer is available, and record which layer was used:
      L-env   read ANTHROPIC_BASE_URL/MODEL -- weakest; environment variables can be edited
      L-say   ask the model "who are you" -- medium; the model may cooperate with a lie
      L-print **behavior fingerprint** ([[model-fingerprint]], Bruckner PAMELA) -- hardest; it cannot be forged
              a single-token output distribution is the model identity; compare it with Jensen-Shannon divergence
              that skill's 2026-07-21 proof: cosplay "claude pasted onto gemini" was caught on the spot at JSD=0.0

    Why it must reach L-print: self-report and environment variables are declarations, and a declaration can lie;
    a behavior distribution is performance, and it cannot be acted. This is what the operator means by "unverifiable information lowers trust".
    """
    prof = node_profile()
    me = prof["node"]
    executor = args.executor or "claude"
    # A node may own several executors and models at once. Do not take the first model after sorting caps
    # and use it to verify the current executor, or a cheap check would wrongly pick up claude's anthropic declaration.
    declared_id, _billing, _provider = probe_executor_model(executor)
    print("node %s | executor %s | declared model %s" % (me, executor, declared_id))

    raw_out = run_adapter(executor, "attest-%s" % me,
                          "Reply with one line only: what is your model identifier? No explanation, no punctuation, only the model name.",
                          timeout=300)
    lines = [line.strip() for line in raw_out.splitlines()
             if line.strip() and not line.startswith("[adapter]")]
    out = (lines[-1] if lines else "")[:80]
    print("model self-report: %s" % (out or "(no output)"))

    norm = lambda x: re.sub(r"[^a-z0-9]", "", x.lower())
    verdict = "yes" if out and (norm(out) in norm(declared_id)
                                or norm(declared_id) in norm(out)) else "failed"
    if not out:
        verdict = "unverified"
    if verdict == "failed":
        record_incident(me, "transparency-spoof", "declared %s but self-reported %s" % (declared_id, out))
    prof["attested"] = verdict
    prof["attested_executor"] = executor
    prof["attested_at"] = fmt(now())
    beat_publish(prof)
    cap, why = transparency_cap(prof)
    print("attest verdict: %s | trust ceiling %.2f -- %s" % (verdict, cap, why))
    return 0 if verdict == "yes" else 1


def haas_score(node):
    """C2: trust is **computed from history**, not from a declaration. Everything is counted from real ref-layer records. A node cannot self-report.

    Weights come from six-laws C2: intent alignment 30% / operation accuracy 25% / boundary compliance 25% / recovery 20%.
    Recovery still has too few samples, so it is counted as a neutral 0.5 and labeled in the output. Do not pretend the number is precise.
    """
    result_entries = [(r, parse_kv(read_ref(r))) for r in list_refs(RESULT_NS)]
    # refund does not rewrite historical refs; it appends a reversal event. When scoring, first
    # cancel the original credit by original_ref, then book the reversal itself as one rejected failure.
    # That keeps the audit chain. It is not a fake penalty that writes reversed and still counts the original credit.
    reversed_refs = {
        kv.get("original_ref") for _, kv in result_entries
        if kv.get("reversal") == "true" and kv.get("original_ref")
    }
    mine = [
        kv for ref, kv in result_entries
        if kv.get("node") == node and kv.get("task") and ref not in reversed_refs
    ]
    # [idle work is not booked] status=noop is the "the criterion was already satisfied" record left by the 2026-07-29 stock score cut.
    # It is neither credit nor fault -- the node did no work. Leaving it in the books counts wrong on both sides:
    #   put it in the done denominator -> intent_align is dragged down for nothing (a penalty for a node that did nothing wrong)
    #   count it as a gate pass -> gate != "rejected", so **zero work receives pass credit** (a real hole)
    # The two errors point opposite ways and differ in magnitude. Together they produce a meaningless number.
    # The only honest treatment is to count it on neither side, including the confidence sample size --
    # idle work cannot accumulate trust. That is what the idle-work gate is there to say.
    mine = [r for r in mine if r.get("status") != "noop"]
    if not mine:
        return 0.0, {"samples": 0, "note": "no history (after reversed filtering), start at L1"}
    done = sum(1 for r in mine if r.get("status") == "done")
    # L2-L5 weighted counts: differentiated weights replace uniform scoring (L5=5x, L4=3x, L3=2x, L2=1.5x, L1=1.0x)
    weighted_done = sum(KIND_WEIGHT.get(r.get("kind"), 1.0)
                        for r in mine if r.get("status") == "done")
    weighted_samples = sum(
        KIND_WEIGHT.get(r.get("kind"), 1.0) if r.get("status") == "done" else 1.0
        for r in mine
    )
    # Numerator and denominator use the same weights, so HAAS stays in [0,1]. High-level events, through equivalent samples,
    # build confidence faster, instead of pushing intent_align to 5.0 and punching straight through L5.
    intent_align = weighted_done / weighted_samples
    gate_pass = (
        sum(KIND_WEIGHT.get(r.get("kind"), 1.0)
            if r.get("status") == "done" else 0.0
            for r in mine if r.get("gate") != "rejected")
        / weighted_samples
    )
    # Mis-record exemption: on 2026-07-29 one decision-dodge from the main thread, before orchestrator_id() landed,
    # was recorded as laptop via node_id(). **Do not delete the old ref** (deleting it would erase the books, which violates this mechanism).
    # Exclude by a kind allowlist in the payload -- only breach types that belong to the main thread are exempt,
    # and an automatic node's own C1/C3 breaches are all counted.
    ORCH_ONLY = ("decision-dodge", "false-premise", "broken-gauge", "rule-ignored", "rework")
    incidents = 0
    for r in list_refs(INCIDENT_NS):
        if "/%s/" % node not in r + "/":
            continue
        kv = parse_kv(read_ref(r))
        # A main-thread breach recorded under an automatic node's name is a mis-record. Do not count it for that node (it was re-recorded under orchestrator).
        if not node.startswith("orchestrator-") and kv.get("kind") in ORCH_ONLY:
            continue
        incidents += 1
    bounds_ok = max(0.0, 1.0 - incidents * 0.25)
    recovery = 0.5
    score = intent_align * 0.30 + gate_pass * 0.25 + bounds_ok * 0.25 + recovery * 0.20
    # Small-sample penalty: jumping to L4 "mostly automatic" after one success is absurd -- that is luck, not trust.
    # Trust has to be proved by **repetition**. When samples are short, scale by proportion. Full weight starts only after 10.
    confidence = min(1.0, weighted_samples / 10.0)
    score = score * confidence
    score = min(1.0, max(0.0, score))
    return round(score, 3), {"samples": len(mine), "effective_samples": round(weighted_samples, 1),
                             "done": done,
                             "weighted_done": round(weighted_done, 1),
                             "incidents": incidents,
                             "confidence": round(confidence, 2),
                             "note": "raw samples %d, equivalent samples %.1f/10, weighted done=%.1f, confidence scaled %.0f%%"
                                     % (len(mine), weighted_samples, weighted_done,
                                        confidence * 100)}


# L2-L5 differentiated weight table (operator decided 2026-07-31)
# L1=baseline (decided/self-fixed=1.0) < L2 (reported=1.5) < L3 (fixed=2.0) < L4 (correct refusal=3.0) < L5 (mechanism adopted=5.0)
# The weight is that result's contribution multiplier in the intent_align numerator (a weighted contribution, not a plain count)
KIND_WEIGHT = {
    "decided":           1.0,   # L1 baseline
    "self-fixed":        1.0,   # L1 baseline
    "defect-reported":   1.5,   # L2 found a defect and reported it
    "defect-fixed":      2.0,   # L3 found it and fixed it
    "correct-refusal":   3.0,   # L4 correct refusal (blocked a wrong decision)
    "mechanism-adopted": 5.0,   # L5 found a mechanism gap and it was adopted as a new mechanism
}

# Machine-checkable bar for an L5 adoption: the output must be traceable to a concrete file plus a commit.
def is_l5_mechanism_adopted(result_kv):
    return bool(
        result_kv.get("kind") == "mechanism-adopted"
        and result_kv.get("artifact_path")
        and result_kv.get("commit")
    )

# Cutoff constant for when the mechanism went live (operator 2026-07-31)
# Unweighted mechanism credit applies only to events before MECHANISM_LIVE. Later events must have a matching kind to be booked.
MECHANISM_LIVE = "2026-07-31T23:59+0800"
BACKFILL_WINDOW_END = MECHANISM_LIVE

# Prefix for the one-shot cold-start backfill guard. The concrete key is a hash of the event content.
BACKFILL_KEY_PREFIX = "backfill:"


def trust_level(score):
    level = "L1"
    for name, floor in TRUST_LEVELS:
        if score >= floor:
            level = name
    return level


def record_incident(node, kind, detail):
    """C3 a breach must be answered: STOP -> REPORT -> WAIT -> RECORD. RECORD lands a ref and enters the HAAS denominator."""
    ref = "%s/%s/%s" % (INCIDENT_NS, node, now().strftime("%Y%m%dT%H%M%S"))
    write_ref(ref, "node=%s\nkind=%s\ndetail=%s\nat=%s" % (node, kind, detail[:200], fmt(now())))
    print("      ⛔ breach recorded: %s — %s" % (kind, detail[:120]))
    log("incident %s %s %s" % (node, kind, detail[:120]))


def covenant_check(task, prof, trust, score):
    """Three gates for the three laws. Any miss means do not execute, and say which law blocked."""
    # C1 intent is the boundary: output must land inside the task's declared allowlist. Unauthorized means out of bounds.
    bounds = (task.get("bounds") or "").split()
    artifact = task.get("artifact") or ""
    # "-" is the "no single fixed output" placeholder (a legal state for governance scan tasks: the completion criterion is
    # the scanner itself going green on rerun, not the existence of some file). It is not really out of bounds. There is no output to judge.
    # Caught on the machine: both tasks in an immune plan generated by discover were wrongly blocked by C1, because artifact="-"
    # never startswith any bounds prefix. The same convention was already fixed once for requires="-" in fit_score.
    if bounds and artifact != "-" and not any(artifact.startswith(b) for b in bounds):
        return False, "C1 intent is the boundary", "output %s is outside the authorized scope %s" % (artifact, " ".join(bounds))
    # C2 trust is the measure: autonomy is decided by verifiable trust
    need = task.get("min_trust") or "L1"
    order = [name for name, _ in TRUST_LEVELS]
    if order.index(trust) < order.index(need):
        return False, "C2 trust is the measure", "this node %s (HAAS %.3f) is below the task requirement %s" % (trust, score, need)
    # C3 safety is the floor: let go of what is reversible, and be careful with what is irreversible
    if (task.get("reversible") or "yes").lower() == "no":
        if order.index(trust) < order.index("L4"):
            return False, "C3 safety is the floor", "an irreversible task requires >=L4; this node is %s" % trust
        if not (task.get("approved_by") or "").strip("- "):
            return False, "C3 safety is the floor", "an irreversible task is missing a human approved_by signature"
    return True, "", ""


# ── atomic implant of the three value laws (six laws V1-V3) ─────────────
#   V1 linear: an isolated agent, one-shot output, an obvious ceiling
#   V2 leverage: output is reused (decision quality x frequency x scope)
#   V3 emergence: collaboration produces a new capability or a new connection, and it is unpredictable
# Core design, the same shape as trust: **value cannot be self-reported; it has to be checked mechanically** -- look at which layer the output landed in.

VALUE_LAYERS = [
    ("V3", ("skills/_shared/", "bin/cortex-loop-adapters/", "brain-network/directions/_swarm/")),
    # work-studio/ is a real reusable operations-asset layer (dotfiles/systemd/launchd/tools).
    # Missing it would silently floor output that landed there down to V1 -- the criterion's coverage is incomplete, rather than the output being unworthy.
    ("V2", ("skills/", "bin/", "aboutme/methods/", "execution-recipes/",
            "work-studio/", "rules/", "brain-network/directions/")),
    ("V1", ("reports/", "memory/", "/tmp/")),
]


def verify_value(task, artifact):
    """Check the declared value layer. Declared V2 but the output is in reports/ means send it back to V1."""
    claimed = (task.get("value") or "V1").upper()
    actual = "V1"
    for level, prefixes in VALUE_LAYERS:
        if any(p in artifact for p in prefixes):
            actual = level
            break
    order = ["V1", "V2", "V3"]
    if order.index(actual) < order.index(claimed):
        return actual, "declared %s but the output landed in layer %s -> count the actual" % (claimed, actual)
    return claimed, ""


def cmd_value(args):
    """Value sense: which layer of value the swarm is producing | who contributed what | whether the leverage rate is enough."""
    fetch_refs()
    results = [parse_kv(read_ref(r)) for r in list_refs(RESULT_NS)]
    done = [r for r in results if r.get("status") == "done" and r.get("task")]
    if not done:
        print("swarm %s has no finished output yet, so there is no value mix to discuss" % SWARM_NAME)
        return 0
    by_node, by_level = {}, {"V1": 0, "V2": 0, "V3": 0}
    for res in done:
        level = (res.get("value") or "V1").upper()
        if level not in by_level:
            level = "V1"
        by_level[level] += 1
        node = res.get("node", "?")
        by_node.setdefault(node, {"V1": 0, "V2": 0, "V3": 0})[level] += 1

    total = len(done)
    print("swarm %s | finished %d | value mix (six laws V1-V3 | mechanically checked, not self-reported)"
          % (SWARM_NAME, total))
    print()
    print("| layer | meaning | count | share |")
    print("|------|------|------|------|")
    meaning = {"V1": "linear | one-shot output", "V2": "leverage | output is reused",
               "V3": "emergence | a new capability or a new connection"}
    for level in ("V1", "V2", "V3"):
        pct = by_level[level] / total * 100
        print("| %s | %s | %d | %.0f%% |" % (level, meaning[level], by_level[level], pct))

    print("\n| node | V1 | V2 | V3 | leverage rate (V2+V3) |")
    print("|------|----|----|----|---------------|")
    for node in sorted(by_node):
        row = by_node[node]
        lev = (row["V2"] + row["V3"]) / max(1, sum(row.values())) * 100
        print("| %s | %d | %d | %d | %.0f%% |" % (node, row["V1"], row["V2"], row["V3"], lev))

    leverage = (by_level["V2"] + by_level["V3"]) / total * 100
    print("\nswarm leverage rate: %.0f%%" % leverage)
    if leverage < 30:
        print("⚠️ leverage rate is low -- the swarm is mostly doing **one-shot labor** and is not accumulating reusable assets.")
        print("   Value path: V1->V2 lands output in skills/ bin/ methods/ (it can be reused);")
        print("   V2->V3 makes the output **add a capability to the swarm** (a new adapter / a new node / a new swarm link).")
    return 0


# ── external API: the same gate ─────────────────────────────────────────
# Core design: **an external caller is a node**. It has an identity, HAAS trust, and the same six laws.
# There is one standard inside and outside -- an internal node goes through covenant_check, and an external caller goes through covenant_check too.
# A caller on its first call is L1, read only. Trust accumulates from history, exactly as for a node.

VERB_POLICY = {
    # verb: (minimum trust, irreversible?, one line)
    "swarm":     ("L1", False, "read: node liveness table"),
    "caps":      ("L1", False, "read: capability matrix"),
    "trust":     ("L1", False, "read: trust level"),
    "value":     ("L1", False, "read: value mix"),
    "dashboard": ("L1", False, "read: one-screen overview"),
    "gather":    ("L1", False, "read: plan summary"),
    "run-contract": ("L1", False, "read: canonical run-contract-v1 projection"),
    "plan":      ("L3", False, "write: publish a plan (revocable; a new plan supersedes)"),
    "claim":     ("L3", False, "write: claim a task (revocable; released automatically when the TTL expires)"),
    "run":       ("L4", False, "write: real execution (spends quota and produces files)"),
    "settle":    ("L4", True,  "irreversible: settle a plan"),
}


def caller_trust(caller):
    """An external caller's trust -- the same HAAS algorithm as a node, and the same ref-layer history."""
    score, facts = haas_score(caller)
    return trust_level(score), score, facts


def cmd_api(args):
    """The single external entry. Any external system (including MCP) calls only through here. There is no side door."""
    import json as _json
    verb = args.verb
    caller = args.caller
    if verb not in VERB_POLICY:
        print(_json.dumps({"ok": False, "error": "unknown verb", "verb": verb,
                           "allowed": sorted(VERB_POLICY)}, ensure_ascii=False))
        return 2
    need, irreversible, desc = VERB_POLICY[verb]
    if not getattr(args, "no_fetch", False):
        fetch_refs()
    # `run-contract` remains subject to the same caller HAAS gate as every
    # other API verb.  Its projection is read-only, though, so take one
    # immutable ref snapshot while deriving trust: this keeps the gate live
    # without turning each historical result into a rev-parse/cat-file process
    # pair.  If batch prefetch is unavailable, ref_snapshot deliberately falls
    # back to the original per-ref path rather than treating unread refs as
    # absent.
    if verb == "run-contract":
        with ref_snapshot(RESULT_NS, INCIDENT_NS):
            trust, score, facts = caller_trust(caller)
    else:
        trust, score, facts = caller_trust(caller)
    order = [n for n, _ in TRUST_LEVELS]

    # C2 trust is the measure
    if order.index(trust) < order.index(need):
        record_incident(caller, "C2-unauthorized-call", "%s requires %s, caller is %s" % (verb, need, trust))
        print(_json.dumps({
            "ok": False, "law": "C2 trust is the measure", "verb": verb, "caller": caller,
            "caller_trust": trust, "haas": score, "required": need,
            "hint": "trust accumulates from history: build a record with read-only verbs first, or have a human issue approved_by"},
            ensure_ascii=False))
        return 1
    # C3 safety is the floor
    if irreversible and not (args.approved_by or "").strip():
        print(_json.dumps({
            "ok": False, "law": "C3 safety is the floor", "verb": verb,
            "reason": "an irreversible operation must carry a human approved_by signature"}, ensure_ascii=False))
        return 1

    payload = {"ok": True, "verb": verb, "caller": caller, "caller_trust": trust,
               "haas": score, "swarm": SWARM_NAME, "policy": desc}
    if verb == "run-contract":
        if not args.line or not args.task:
            print(_json.dumps({
                "ok": False, "schema_version": RUN_CONTRACT_SCHEMA,
                "verb": verb, "error": "run-contract requires --line and --task",
            }, ensure_ascii=False))
            return 2
        try:
            payload["run_contract"] = _read_run_contract(
                args.line, args.task, args.run_id, source_surface="api"
            )
        except ValueError as exc:
            print(_json.dumps({
                "ok": False, "schema_version": RUN_CONTRACT_SCHEMA,
                "verb": verb, "error": str(exc),
            }, ensure_ascii=False))
            return 1
    elif verb == "swarm":
        payload["nodes"] = {n: {"alive": node_alive(p)[0], "kind": p.get("kind"),
                                "owns": p.get("owns"), "caps": (p.get("caps") or "").split()}
                            for n, p in read_swarm().items()}
    elif verb == "caps":
        nodes = read_swarm()
        allc = sorted({c for p in nodes.values() for c in (p.get("caps") or "").split()})
        payload["capabilities"] = allc
        payload["by_node"] = {n: (p.get("caps") or "").split() for n, p in nodes.items()}
        payload["single_point"] = [c for c in allc if sum(
            1 for p in nodes.values() if c in (p.get("caps") or "").split()) == 1]
    elif verb == "trust":
        payload["nodes"] = {}
        for name in read_swarm():
            sc, fa = haas_score(name)
            payload["nodes"][name] = {"haas": sc, "level": trust_level(sc), "facts": fa}
    elif verb == "value":
        done = [parse_kv(read_ref(r)) for r in list_refs(RESULT_NS)]
        done = [d for d in done if d.get("status") == "done" and d.get("task")]
        levels = {"V1": 0, "V2": 0, "V3": 0}
        for res in done:
            levels[(res.get("value") or "V1").upper() if
                   (res.get("value") or "V1").upper() in levels else "V1"] += 1
        payload["value"] = levels
        payload["leverage_pct"] = round(
            (levels["V2"] + levels["V3"]) / len(done) * 100, 1) if done else 0
    elif verb == "gather":
        payload["plans"] = {}
        for ref in list_refs(PLAN_NS):
            plan = ref.split("/")[-1]
            tasks = plan_tasks(plan)
            done = [t for t in tasks if parse_kv(read_ref(
                "%s/%s/%s" % (RESULT_NS, plan, t["id"]))).get("status") == "done"]
            payload["plans"][plan] = {"total": len(tasks), "done": len(done)}
    else:
        payload["note"] = "write verbs must be run via the matching subcommand; the api layer only authenticates and projects read-only"
    print(_json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


# The main thread is an **independent node**. It does not borrow the laptop identity (operator decided 2026-07-29):
#   "a person joins the swarm through the main thread, to see problems clearly, audit them, give orders, and interact" --
#   it does completely different work from an automatic node (decide, dispatch, and accept, versus execute),
#   and mixing them in one HAAS pollutes both: an automatic node landing 10 tasks would hide 3 decision errors by the main thread.
# Name it orchestrator-<host>: on the same machine, the process running tick and the process talking to a person must be scored separately.
def orchestrator_id():
    return "orchestrator-%s" % node_id()


def cmd_checkin(args):
    """The main thread joins or leaves the swarm -- a heartbeat **fully equal** to an automatic node's.

    operator 2026-07-29: "when the main thread stops there should be a heartbeat too. You, as the access node,
    should actually be fully equal to them. Everything equal. Only then are you a proper node."

    Before this the main thread had a trust score and no heartbeat. It was **half a node** -- the dashboard guessed whether it was up with pgrep,
    which is external observation rather than a self-declaration, and it is not the same thing as an automatic node's beat ref.
    Equality means: push a beat ref the same way, have a profile the same way, be judged offline the same way, and be able to take tasks the same way.

    The only difference from an automatic node is written in the profile: kind=orchestrator (a human interface, not an executor),
    can_sleep=yes (it stops when the session ends, the same nature as a laptop lid closing).
    """
    node = orchestrator_id()
    # Reflect how this session actually executes: read the executor set actually called in the last hour from EXEC_STATE.
    # On first join, fall back to the automatic probe in node_profile().
    _exec_state = _load_exec_state()
    _recent = [k for k, v in _exec_state.items()
               if v.get("last_used") and parse_ts(v.get("last_used"))
               and (now() - parse_ts(v["last_used"])).total_seconds() < 3600]
    _profile_exec = (node_profile().get("executors") or "human").split()
    _executors = " ".join(sorted(set(_recent))) if _recent else (
        "human" if "human" in _profile_exec else
        (_profile_exec[0] if _profile_exec else "human"))
    prof = {
        "node": node, "swarm": SWARM_NAME, "kind": "orchestrator",
        "can_sleep": "yes",                     # a closed session stops, the same nature as a laptop
        "executors": _executors,
        "caps": " ".join(sorted(set(node_capabilities()) | {
            "role.orchestrator", "iface.human", "act.decide", "act.dispatch", "act.verify"})),
        "telegram_reach": "n/a",
        "last_seen": now().strftime("%Y-%m-%dT%H:%M"),   # minute precision: session-level liveness has to be visible
        "owns": "-",
    }
    if args.out:
        # Leave: push one departed heartbeat so the swarm knows a node is gone immediately, instead of waiting out a silence timeout
        prof["last_seen"] = now().strftime("%Y-%m-%dT%H:%M")
        prof["kind"] = "orchestrator-offline"
    fetch_refs()
    ok = beat_publish(prof)
    write_profile(prof)
    print("%s %s | swarm %s" % (node, "departed" if args.out else "joined", SWARM_NAME))
    print("  heartbeat %s | profile written to _swarm/%s.md" % ("pushed" if ok else "⚠️ push failed (network)", node))
    if not args.out:
        h, m = haas_score(node)
        print("  trust %.3f (%s) | samples %s/10 -- the same HAAS as an automatic node, with no second ruler"
              % (h, trust_level(h), m.get("samples", 0)))
    return 0 if ok else 1


def cmd_fault(args):
    """The main thread records its own breach -- closing the hole where the orchestrator sat under no trust mechanism.

    On 2026-07-29 the operator pointed it out: HAAS only counts swarm tasks in RESULT_NS,
    and **the main thread (the one that decides, dispatches, and accepts) is not in the denominator at all**.
    So the main thread's mistakes -- pushing a decision it should have made onto a person, editing code on a false premise,
    reporting "verified" when the gauge was broken -- never entered the books. Wasting a person's attention had no cost.

    A person's attention is the scarcest resource in this system: machine time can run in parallel, and tokens can be topped up,
    but the operator's attention cannot. The cost of making them say it again has to be priced.

    It lands in the same INCIDENT_NS, with the same source and the same weight as a node breach (bounds_ok -0.25 each).
    It does not open a second ledger. A second ledger would be an exemption issued to ourselves.

    Usage: cortex-loop fault --kind <type> --detail <one sentence>
      decision-dodge  pushed a decision it should have made onto a person (against the DECIDE law)
      false-premise   started changing things on a premise that was not checked
      broken-gauge    the gauge was broken and it still reported "verified"
      rule-ignored    the rule was written there and the work was done without reading it
      rework          made a person say the same thing a second time
    """
    node = orchestrator_id()
    record_incident(node, args.kind, args.detail)
    fetch_refs()          # same pit as credit: without a pull after the write, haas reads local state and cannot see what was just written
    h, meta = haas_score(node)
    print("      %s HAAS is now %.3f (%s) | samples %s"
          % (node, h, trust_level(h), meta.get("samples", "?")))
    print("      Trust is earned and it is also paid back -- this one has entered the denominator, and only later successes can offset it.")
    return 0


# ── solo / swarm / unknown three-state criterion ────────────────────────
ADHOC_PATTERN = re.compile(r"^adhoc-(\d+)-([a-z0-9_-]+)$")


def solo_or_swarm():
    """Return one of three states: solo / swarm / unknown.

    solo    = this session dispatched no sub-agent or HIVE work; pure main-thread work
    swarm   = this session has a sub-agent or HIVE dispatch record (success, failure, or breach)
    unknown = there is no record to consult (the initial state)

    unknown is always treated as swarm (conservative). Do not tip it toward solo.
    This is a hard constraint of the DIMENSIONAL law: "cannot look it up" is a third state, not the default of the first two.
    """
    state = _load_exec_state()
    dispatchers = [k for k in state.keys()
                   if k.startswith("hive") or k.startswith("subagent")
                   or k.startswith("dispatch.")]
    if dispatchers:
        return "swarm"
    spotlight = "/tmp/spotlight"
    if os.path.isdir(spotlight):
        hive_logs = [f for f in os.listdir(spotlight)
                     if f.startswith("hive-") or "subagent" in f]
        if hive_logs:
            return "swarm"
    return "unknown"


def is_adhoc_task(task_id):
    """Whether task_id is an ad-hoc task (absent from every predefined TASKS.md)."""
    return bool(ADHOC_PATTERN.match(task_id))


def adhoc_register(plan_id, task_id, title, executor="hive"):
    """An ad-hoc task is written to CLAIM_NS at the moment of dispatch. Do not wait to create a card first.

    This is the core of the fourth piece of the T11 set: dispatch is booking.
    A claim trace can be left even when the task card does not exist, and cortex-trace.sh can follow it.
    """
    if not is_adhoc_task(task_id):
        return False
    node = node_id()
    ref = "%s/%s/%s" % (CLAIM_NS, plan_id, task_id)
    safe_title = title[:120].replace("\n", " ")
    payload = "\n".join([
        "holder=%s" % node,
        "task=%s" % task_id,
        "title=%s" % safe_title,
        "executor=%s" % executor,
        "since=%s" % fmt(now()),
        "expires=%s" % fmt(now() + timedelta(minutes=60)),
        "kind=adhoc",
    ])
    old = rev_ref(ref)
    ok, _ = write_ref(ref, payload, parent=old)
    if ok:
        print("adhoc | claim %s <- %s (dispatch is booking)" % (task_id, node))
    else:
        print("adhoc | WARN: %s was taken first by another node" % task_id)
    return ok


def cmd_swarm_mode(args):
    """Report this node's solo/swarm/unknown state. unknown is treated as swarm (conservative)."""
    mode = solo_or_swarm()
    print("this node %s run state: %s" % (node_id(), mode))
    if mode == "unknown":
        print("  -> unknown is treated as swarm (conservative); any dispatch record on the next beat upgrades it to swarm")
    return 0


def cmd_adhoc_list(args):
    """List ad-hoc tasks already registered for this node (filter CLAIM_NS for kind=adhoc)."""
    fetch_refs()
    node = node_id()
    adhocs = []
    for ref in list_refs(CLAIM_NS):
        kv = parse_kv(read_ref(ref))
        if kv.get("holder") == node and kv.get("kind") == "adhoc":
            adhocs.append(kv)
    if not adhocs:
        print("this node has no ad-hoc tasks")
    else:
        print("this node has %d ad-hoc tasks:" % len(adhocs))
        for a in adhocs:
            print("  %s | %s | since=%s" % (a.get("task"), a.get("title", ""), a.get("since")))
    return 0


_CREDIT_PATH_RE = re.compile(
    r"(?<![A-Za-z0-9_.-])([A-Za-z0-9_./-]+\.(?:md|sh|py|json|yml|yaml|txt|tsv|html))(?![A-Za-z0-9_.-])"
)
_CREDIT_COMMIT_RE = re.compile(r"(?<![0-9a-f])([0-9a-f]{7,40})(?![0-9a-f])")


def _validate_credit_evidence(evidence, require_path_and_commit=False):
    """Evidence does not count merely because it looks like a path or a hash. It must be a tracked file in the repo or a real commit.

    L5 also requires at least one evidence file to exist in the tree of the given commit, forming a traceable file-plus-commit
    link. Two unrelated strings cannot be assembled into L5.
    """
    paths, commits = [], []
    for raw_path in _CREDIT_PATH_RE.findall(evidence or ""):
        full = os.path.realpath(os.path.join(ROOT, raw_path))
        if not (full == ROOT or full.startswith(ROOT + os.sep)) or not os.path.isfile(full):
            continue
        rel = os.path.relpath(full, ROOT)
        code, _ = git("ls-files --error-unmatch -- %s" % shlex.quote(rel), timeout=15)
        if code == 0:
            paths.append(rel)
    for commit in _CREDIT_COMMIT_RE.findall(evidence or ""):
        code, _ = git("cat-file -e %s^{commit}" % commit, timeout=15)
        if code == 0:
            commits.append(commit)
    if not paths and not commits:
        return False, [], [], "evidence must point at a tracked file in the repo or a real git commit"
    if require_path_and_commit:
        if not paths or not commits:
            return False, paths, commits, "L5 must provide both a tracked output file and a real commit"
        linked = False
        for commit in commits:
            for path in paths:
                code, out = git(
                    "ls-tree -r --name-only %s -- %s" % (commit, shlex.quote(path)),
                    timeout=15,
                )
                if code == 0 and path in out.splitlines():
                    linked = True
                    break
            if linked:
                break
        if not linked:
            return False, paths, commits, "the L5 file is not in the given commit, so the lineage cannot be traced"
    return True, sorted(set(paths)), sorted(set(commits)), ""


def _validate_credit_verifier(verified_by, evidence_paths, subject):
    """Reject self-issued approval: an independent verifier must be mechanically traceable in the evidence assets.

    The trusted entry today is a tracked report that has an owner. The command will not treat an arbitrary string
    `verified_by=mechanism-live` as mechanical approval.
    """
    verifier = (verified_by or "").strip()
    if not verifier:
        return False, "L2-L5 must provide an independent verifier via --verified-by"
    if verifier.lower() == subject.lower() or verifier.lower() in ("self", "mechanism-live"):
        return False, "the verifier cannot be the scored party, and cannot be a fixed string with no source"
    owner_re = re.compile("(?im)^(?:owner:\\s*|\\*\\*\u7ebf\\*\\*:\\s*)(.+?)\\s*$")
    wanted = re.sub(r"[^a-z0-9]", "", verifier.lower())
    for rel in evidence_paths:
        try:
            with open(os.path.join(ROOT, rel), encoding="utf-8", errors="replace") as fh:
                owners = owner_re.findall(fh.read())
        except OSError:
            continue
        if any(wanted and wanted in re.sub(r"[^a-z0-9]", "", owner.lower())
               for owner in owners):
            return True, ""
    return False, "--verified-by must match the owner or line field of an evidence report"


def cmd_refund(args):
    """When a refusal is overturned, claw the credit back (anti-degradation 2: a wrong refusal is zero-cost noise).

    Flow: find the original ref, append reversed=true plus evidence, and do not delete the original ref (keep the audit chain).
    After the clawback, HAAS is recomputed (haas_score drops the weighted contribution of reversed entries when it reads).
    """
    original_ref = args.ref
    fetch_refs()
    reversal_entries = [parse_kv(read_ref(ref)) for ref in list_refs(RESULT_NS)]
    reversals = [entry for entry in reversal_entries
                 if entry.get("original_ref") == original_ref]
    if reversals:
        print("      ⚠️ that ref was already clawed back; do not write it again: %s" % original_ref)
        return 1
    # read the original ref
    try:
        orig_kv = parse_kv(read_ref(original_ref))
    except Exception as e:
        print("      ⚠️ failed to read the original ref: %s" % e)
        return 1
    if orig_kv.get("kind") not in ("correct-refusal", "defect-reported", "defect-fixed"):
        print("      ⚠️ refund applies only to L2-L4 refusal kinds; current kind=%s" % orig_kv.get("kind"))
        return 1

    evidence_ok, evidence_paths, _commits, why = _validate_credit_evidence(args.evidence)
    if not evidence_ok:
        print("      ⚠️ clawback evidence is invalid: %s" % why)
        return 1
    verifier_ok, why = _validate_credit_verifier(
        args.verified_by, evidence_paths, orig_kv.get("node", "")
    )
    if not verifier_ok:
        print("      ⚠️ clawback was not independently verified: %s" % why)
        return 1

    # Append a clawback event (do not delete the original ref; keep the audit chain). haas_score, by original_ref,
    # drops the original positive credit and counts this rejected/failed entry as a negative sample.
    new_payload = "\n".join([
        "task=refund:%s" % orig_kv.get("task"),
        "node=%s" % orig_kv.get("node"),
        "status=failed",
        "gate=rejected",
        "kind=refusal-reversed",
        "detail=overturned %s: %s" % (orig_kv.get("kind"), args.reason[:160]),
        "finished=%s" % fmt(now()),
        "value=V1",
        "reversal=true",
        "reversed_reason=%s" % args.reason[:200],
        "reversed_at=%s" % fmt(now()),
        "original_ref=%s" % original_ref,
        "evidence=%s" % args.evidence[:200],
        "verified_by=%s" % args.verified_by,
        "corrected_target=%s" % orig_kv.get("node", ""),
    ])
    new_ref = "%s/%s/%s-refund" % (
        RESULT_NS, orig_kv.get("node") or "unknown", now().strftime("%Y%m%dT%H%M%S")
    )
    ok, _ = write_ref(new_ref, new_payload)
    if not ok:
        print("      ⚠️ clawback ref could not be written (network or permission)")
        return 1
    print("      ✅ refusal clawed back: %s (kind=%s)" % (original_ref, orig_kv.get("kind")))
    print("      reason for the overturn: %s" % args.reason[:100])
    print("      original ref kept; scoring revokes the original credit and adds one rejected negative sample")
    fetch_refs()
    h, meta = haas_score(orchestrator_id())
    print("      HAAS is now %.3f (%s) | weighted done=%.1f"
          % (h, trust_level(h), meta.get("weighted_done", "N/A")))
    return 0


def auto_credit_decided(line, task_id, title):
    """After the mechanical gate (try-complete) PASSes, automatically record one L1 decided. Nobody has to type the credit command again.

    operator 2026-07-31: "the mechanical gate has to go through scoring too; wire the whole thing through" --
    before this, the done verdict and the credit ledger were two systems that did not touch. 13 tasks that were really finished
    recorded no score. L1 does not need evidence or a verifier (anti-degradation only gates L2-L5), so this can
    write the ref directly inside the mechanical gate, without going through cmd_credit()'s CLI argument parsing.
    A silent failure (network or permission) does not change the PASS meaning of try-complete itself. Scoring is a bonus,
    not a precondition of completion, so a scoring failure cannot drag the mechanical gate down with it.

    Hardened on 2026-07-31: if RESULT_NS already has a credit for this line/id (the exact id or the old short id),
    do not write again. This fixes duplicate L1 scoring from reopen or a second try-complete (shown by IMM-T6/T8/T31).
    """
    existing = _find_credit_for_task(line, task_id)
    if existing is not None:
        print(
            "      credit | already scored (%s | %s); skip to prevent score farming"
            % (existing[2], existing[4].rsplit("/", 1)[-1])
        )
        return True
    node = orchestrator_id()
    detail = "%s/%s %s" % (line, task_id, title)[:200]
    payload_lines = [
        "task=decided", "node=%s" % node, "status=done", "gate=passed",
        "kind=decided", "detail=%s" % detail, "finished=%s" % fmt(now()),
        "event_at=%s" % fmt(now()), "value=V2",
        "evidence=try-complete:%s/%s" % (line, task_id),
    ]
    payload = "\n".join(payload_lines)
    ref_token = "%s-decided-%s" % (
        now().strftime("%Y%m%dT%H%M%S"),
        hashlib.sha256(payload.encode("utf-8")).hexdigest()[:8],
    )
    ref = "%s/%s/%s" % (RESULT_NS, "orchestrator", ref_token)
    ok, _ = write_ref(ref, payload)
    if ok:
        print("      credit | automatically recorded one decided (L1): %s" % detail)
    else:
        print("      credit | ⚠️ automatic score was not written to the ref (this done verdict is unaffected)")
    return ok


def cmd_credit(args):
    """The main thread records one autonomous success -- penalties without credits only sink the score.

    operator 2026-07-29: "You level up the same way: accumulate score to earn trust,
    then take on larger duties. A weak start still has a novice period; you have to accumulate."

    Five levels (L1 is the baseline, L5 is the highest; operator decided 2026-07-31):
      L1 decided/self-fixed      task completed (baseline, no new kind)
      L2 defect-reported         found a defect and reported it
      L3 defect-fixed            found and fixed (above L2)
      L4 correct-refusal         correct refusal (blocked a wrong decision, later confirmed) (above L3)
      L5 mechanism-adopted       found a mechanism gap and had it adopted as a new mechanism (highest, above the scale)

    Four anti-regression rules:
      1) a refusal/report (L2-L5) scores only with verifiable evidence
      2) a refusal later overturned is clawed back
      3) no self-scoring and no self-award (same rule: AI has no approval authority)
      4) backfill credit is a one-time cold start; unweighted credit applies only to events before the mechanism went live
    """
    node = orchestrator_id()
    kind = args.kind
    high_kinds = {"defect-reported", "defect-fixed", "correct-refusal", "mechanism-adopted"}

    # -- anti-regression 1: evidence required (L2-L5 must have evidence) ----------------
    evidence_paths, evidence_commits = [], []
    if kind in high_kinds:
        if not args.evidence:
            print("      ⚠️ recording %s requires --evidence" % kind)
            return 1
        evidence_ok, evidence_paths, evidence_commits, why = _validate_credit_evidence(
            args.evidence, require_path_and_commit=(kind == "mechanism-adopted")
        )
        if not evidence_ok:
            print("      ⚠️ evidence failed the mechanical gate: %s" % why)
            return 1
        verifier_ok, why = _validate_credit_verifier(args.verified_by, evidence_paths, node)
        if not verifier_ok:
            print("      ⚠️ cannot self-score or self-award: %s" % why)
            return 1

    # -- anti-regression 3: corrected target (required for a commendation) ------------
    COMMEND_KINDS = {"correct-refusal", "mechanism-adopted", "defect-fixed"}
    if kind in COMMEND_KINDS:
        if not args.corrected_target:
            print("      ⚠️ recording %s requires --corrected-target (node name of the corrected target)" % kind)
            print("      example: --corrected-target orchestrator-laptop")
            return 1

    # -- L5 extra criterion: must be a traceable artifact, not merely a "nice idea" --
    if kind == "mechanism-adopted":
        l5_probe = {
            "kind": kind,
            "artifact_path": evidence_paths[0] if evidence_paths else "",
            "commit": evidence_commits[0] if evidence_commits else "",
        }
        if not is_l5_mechanism_adopted(l5_probe):
            print("      ⚠️ mechanism-adopted (L5) requires a verified artifact_path + commit")
            return 1

    # -- anti-regression 4: backfill only inside the cold-start window, and a per-event fingerprint prevents repeats --
    backfill_key = ""
    event_at = fmt(now())
    if args.backfill:
        event_ts = parse_ts(args.occurred_at or "")
        live_ts = parse_ts(MECHANISM_LIVE)
        window_end = parse_ts(BACKFILL_WINDOW_END)
        if event_ts is None or live_ts is None or event_ts >= live_ts:
            print("      ⚠️ backfill requires --occurred-at, and the event must predate MECHANISM_LIVE")
            return 1
        if window_end is None or now() > window_end:
            print("      ⚠️ the one-time cold-start backfill window is closed")
            return 1
        event_at = fmt(event_ts)
        digest_src = "\0".join([kind, event_at, args.evidence, args.corrected_target])
        backfill_key = "%s%s" % (BACKFILL_KEY_PREFIX, hashlib.sha256(
            digest_src.encode("utf-8")
        ).hexdigest()[:16])
        fetch_refs()
        existing = [
            parse_kv(read_ref(ref)).get("backfill_key")
            for ref in list_refs(RESULT_NS)
        ]
        if backfill_key in existing:
            print("      ⚠️ backfill already done: %s (the same event cannot be credited twice)" % backfill_key)
            return 1

    # -- build payload ----------------------------------------------------------
    payload_lines = [
        "task=%s" % kind,
        "node=%s" % node,
        "status=done",
        "gate=passed",
        "kind=%s" % kind,
        "detail=%s" % args.detail[:200],
        "finished=%s" % fmt(now()),
        "event_at=%s" % event_at,
        "value=V2",
    ]
    if args.evidence:
        payload_lines.append("evidence=%s" % args.evidence[:200])
    if args.corrected_target:
        payload_lines.append("corrected_target=%s" % args.corrected_target)
    if evidence_paths:
        payload_lines.append("artifact_path=%s" % evidence_paths[0])
    if evidence_commits:
        payload_lines.append("commit=%s" % evidence_commits[0])
    if args.verified_by:
        payload_lines.append("verified_by=%s" % args.verified_by)
    if backfill_key:
        payload_lines.extend([
            "backfill_key=%s" % backfill_key,
            "mechanism_live_before=%s" % MECHANISM_LIVE,
        ])

    payload = "\n".join(payload_lines)
    ref_token = "%s-%s-%s" % (
        now().strftime("%Y%m%dT%H%M%S"),
        kind,
        hashlib.sha256(payload.encode("utf-8")).hexdigest()[:8],
    )
    ref = "%s/%s/%s" % (RESULT_NS, "orchestrator", ref_token)
    ok, _ = write_ref(ref, payload)
    if not ok:
        print("      ⚠️ the credit could not be written to the ref (network/permission) -- it does not count; do not pretend it was recorded")
        return 1
    fetch_refs()
    h, meta = haas_score(node)

    # show the weighted weighted_done
    wd = meta.get("weighted_done", "N/A")
    level_by_kind = {
        "decided": 1, "self-fixed": 1, "defect-reported": 2,
        "defect-fixed": 3, "correct-refusal": 4, "mechanism-adopted": 5,
    }
    print("      ✅ recorded one %s (L%d): %s" % (
        kind, level_by_kind.get(kind, 1), args.detail[:80]))
    if args.evidence:
        print("      evidence: %s" % args.evidence[:100])
    if args.corrected_target:
        print("      corrected: %s" % args.corrected_target)
    print("      %s HAAS %.3f (%s) | samples %s | weighted done=%.1f"
          % (node, h, trust_level(h), meta.get("samples", "?"), wd))
    return 0


# -- credit ledger atomic tools (list/show/query/delete) -------------------------
# operator 2026-07-31: "Finish every atomic tool for cleanup, delete, and query, and flush to disk immediately."
# In the early hours of 2026-07-31 a hand-run `git update-ref -d` cleaned mistaken test data but forgot to delete origin.
# The score did not fall back; the real cause took half an hour to find (fetch_refs always pulls origin back). From now on
# use these four commands only. Do not hand-run git ref operations.

def _credit_refs():
    fetch_refs()
    return sorted(list_refs("%s/orchestrator" % RESULT_NS))


def cmd_credit_list(args):
    """List every credit event (oldest first)."""
    refs = _credit_refs()
    if not refs:
        print("      (no credit events)")
        return 0
    for ref in refs:
        kv = parse_kv(read_ref(ref))
        token = ref.rsplit("/", 1)[-1]
        print("%s\tkind=%-16s\tnode=%-22s\t%s" % (
            token, kv.get("kind", "?"), kv.get("node", "?"), kv.get("detail", "")[:60]))
    print("      %d entries total" % len(refs))
    return 0


def cmd_credit_show(args):
    """Show the full payload of one credit event (full ref or token suffix)."""
    ref = args.ref if args.ref.startswith("refs/") else "%s/orchestrator/%s" % (RESULT_NS, args.ref)
    fetch_refs()
    payload = read_ref(ref)
    if not payload:
        print("      not found %s" % ref, file=sys.stderr)
        return 1
    print(payload)
    return 0


def cmd_credit_query(args):
    """Filter credit events by kind / node / keyword."""
    refs = _credit_refs()
    hits = 0
    for ref in refs:
        kv = parse_kv(read_ref(ref))
        if args.kind and kv.get("kind") != args.kind:
            continue
        if args.node and kv.get("node") != args.node:
            continue
        haystack = kv.get("detail", "") + kv.get("evidence", "")
        if args.grep and args.grep not in haystack:
            continue
        token = ref.rsplit("/", 1)[-1]
        hits += 1
        print("%s\tkind=%-16s\tnode=%-22s\t%s" % (
            token, kv.get("kind", "?"), kv.get("node", "?"), kv.get("detail", "")[:80]))
    print("      %d hits" % hits)
    return 0


def cmd_credit_delete(args):
    """Revoke one credit event -- only to clean a write that should never have existed (for example dry-run test pollution).

    A normal refusal later falsified goes through `refund` (keep the original ref, add a reversal record, leave a trace; that is not this command).
    This command first writes an audit-marker ref (local + origin), then deletes local + origin. Never delete silently
    (GLASSBOX law: deleted with no trace means it never happened, which is unacceptable).
    """
    ref = args.ref if args.ref.startswith("refs/") else "%s/orchestrator/%s" % (RESULT_NS, args.ref)
    fetch_refs()
    payload = read_ref(ref)
    if not payload:
        print("      not found %s (already deleted?)" % ref, file=sys.stderr)
        return 1
    if not args.confirm:
        print("      dry-run (not executed): would delete %s\n%s\n      add --confirm to actually delete" % (ref, payload))
        return 0
    audit_payload = "\n".join([
        "action=credit-delete", "deleted_ref=%s" % ref, "reason=%s" % args.reason[:200],
        "original_payload_sha256=%s" % hashlib.sha256(payload.encode("utf-8")).hexdigest(),
        "deleted_at=%s" % fmt(now()), "deleted_by=%s" % orchestrator_id(),
    ])
    audit_token = "%s-audit-delete-%s" % (
        now().strftime("%Y%m%dT%H%M%S"), hashlib.sha256(audit_payload.encode("utf-8")).hexdigest()[:8])
    audit_ref = "refs/swarm/%s/audit/%s" % (SWARM_NAME, audit_token)
    ok, why = write_ref(audit_ref, audit_payload)
    if not ok:
        print("      ⚠️ audit-marker write failed (%s); refusing to continue the delete for safety" % why, file=sys.stderr)
        return 1
    code_local, out_local = git("update-ref -d %s" % ref, timeout=30)
    code_remote, out_remote = git("push origin --delete %s" % ref, timeout=60)
    print("      local delete %s: %s" % (ref, "OK" if code_local == 0 else out_local.strip()[:200]))
    print("      origin delete: %s" % ("OK" if code_remote == 0 else out_remote.strip()[:200]))
    print("      audit marker: %s" % audit_ref)
    return 0 if code_local == 0 else 1


def cmd_trust(args):
    """Swarm-wide trust and autonomy -- trust is computed, not configured.

    Fix on 2026-07-31: the dashboard polls this command at high frequency, and each call forces fetch_refs() over the network.
    Occasionally that exceeds the timeout, and when `timeout` kills the process the output buffer has flushed only halfway -- nodes
    listed later vanish entirely, which looks like "no score recorded" when this run simply did not finish printing. `--no-fetch` lets
    the dashboard read locally cached refs (the heartbeat already fetches every 2-3 minutes, so the local cache
    is usually fresh enough) and this path no longer depends on a network round trip.
    """
    if not getattr(args, "no_fetch", False):
        fetch_refs()
    # fetch happens BEFORE the snapshot: the snapshot must reflect the ledger after the pull, or the reported numbers lag origin by one beat.
    # This command is read-only the whole way (only print, no write_ref), the only place a snapshot is safe.
    with ref_snapshot(RESULT_NS, INCIDENT_NS):
        return _cmd_trust_report()


def _cmd_trust_report():
    """Read-only report body of cmd_trust. Split out only so the with-scope wraps the outside; the logic is unchanged."""
    nodes = read_swarm()
    print("swarm %s | trust level (HAAS computed - six laws C2)" % SWARM_NAME)
    print("| node | HAAS | level | auto-exec | basis |")
    print("|------|------|------|----------|------|")
    # The main thread is also a node (humans join the swarm through it). It has no _swarm/ profile file, but it has result/incident records,
    # so it must be included explicitly -- listing only profiled nodes would leave the orchestrator unrated forever.
    _orch = orchestrator_id()
    _oh, _om = haas_score(_orch)
    if _om.get("samples", 0) > 0:
        print("| %s | %.3f | %s | %s | samples %d | %s |"
              % (_orch, _oh, trust_level(_oh),
                 {"L1": "❌ confirm every step", "L2": "❌ advice only", "L3": "✅ reversible auto",
                  "L4": "✅ mostly automatic", "L5": "✅ fully autonomous"}.get(trust_level(_oh), "?"),
                 _om.get("samples", 0), _om.get("note", "")))
    ladder = {"L1": "❌ confirm every step", "L2": "❌ advice only", "L3": "✅ reversible auto",
              "L4": "✅ mostly automatic", "L5": "✅ fully autonomous"}
    for name in sorted(nodes):
        score, facts = haas_score(name)
        level = trust_level(score)
        print("| %s | %.3f | %s | %s | samples %s | violations %s |"
              % (name, score, level, ladder[level],
                 facts.get("samples"), facts.get("incidents", 0)))
    print("\nweights (six laws C2): intent alignment 30% | operation accuracy 25% | boundary compliance 25% | recovery 20%")
    print("Note: recovery still has too few samples, so it is counted as a neutral 0.5 -- do not pretend the number is precise.")

    # -- L2-L5 event display (trust display row; shares the display surface with T15) --
    # Broken out: defect-reported / defect-fixed / correct-refusal / mechanism-adopted
    # and includes the corrected-target field
    HIGH_KINDS_MAP = {
        "defect-reported":   "L2 reported",
        "defect-fixed":      "L3 fixed",
        "correct-refusal":   "L4 refused",
        "mechanism-adopted": "L5 adopted",
    }
    all_results = [parse_kv(read_ref(r)) for r in list_refs(RESULT_NS)]
    orch_results = [r for r in all_results
                    if r.get("node", "").startswith("orchestrator")
                    and r.get("status") == "done"
                    and r.get("kind") in HIGH_KINDS_MAP]
    if orch_results:
        print("\ntrust events (L2-L5, broken out):")
        print("| time | level | kind | evidence | corrected target |")
        print("|------|------|------|------|------------|")
        for r in sorted(orch_results, key=lambda x: x.get("finished", ""), reverse=True):
            t = r.get("finished", "")[:16]
            kind_label = HIGH_KINDS_MAP.get(r.get("kind"), r.get("kind", ""))
            ev = r.get("evidence", "")[:30]
            ct = r.get("corrected_target", "—")
            print("| %s | %s | %s | %s | %s |" % (t, kind_label, r.get("kind", ""), ev, ct))
    else:
        print("\ntrust events (L2-L5): no records yet (mechanism went live 2026-07-31)")

    # -- swarm-wide trust (operator 2026-07-29: a node score is the swarm weighted score) --
    # **Do not use a simple average**: an average makes "one node is bad but the other two are good" look fine,
    # while the swarm real trustworthiness is limited by **the weakest one** -- you do not choose who a task is assigned to.
    # So take "weighted mean x bottleneck factor", where bottleneck factor = lowest score / mean (capped at 1.0).
    # This shares its source with six-laws C2 bottleneck-alert rule: any sub-score that is too low must pull the whole down, and must not be hidden by the mean.
    scores = []
    for name in sorted(nodes):
        s0, _ = haas_score(name)
        scores.append((name, s0))
    _o = orchestrator_id()
    _os, _om = haas_score(_o)
    if _om.get("samples", 0) > 0:
        scores.append((_o, _os))
    if scores:
        vals = [v for _, v in scores]
        mean = sum(vals) / len(vals)
        weakest_name, weakest = min(scores, key=lambda kv: kv[1])
        shortfall = (weakest / mean) if mean > 0 else 0.0
        swarm_trust = mean * min(1.0, shortfall)
        print("\nswarm-wide trust %.3f (%s) | mean %.3f x bottleneck factor %.2f"
              % (swarm_trust, trust_level(swarm_trust), mean, min(1.0, shortfall)))
        print("weakest node: %s %.3f -- swarm trustworthiness is limited by the weakest one, not the average one"
              % (weakest_name, weakest))
        print("way to raise the score: a low-score node completing tasks (credit / passing the gate) beats a high-score node doing ten more")
    return 0


def legacy_plan_requires_workspace(task):
    """File-producing legacy plan tasks must migrate to the attempt runtime."""
    return (task.get("artifact") or "-").strip() not in ("", "-")


def cmd_run(args):
    """Claim, then execute, then write back: one pipeline.

    This closes a break in the dispatch layer: claim used to only grab a slot, and nobody actually did the work.
    """
    fetch_refs()
    prof = node_profile()
    me = prof["node"]
    executor = (
        args.executor
        or os.environ.get("CORTEX_DEFAULT_EXECUTOR")
        or (prof["executors"].split() or ["human"])[0]
    )
    trigger_kind = getattr(args, "trigger_kind", "manual")
    # run is not a bypass of claim: an automatic tick calls run directly. If the claim is not recorded here, the result has no
    # auditable lineage of who executed under which lease. A manual claim first stays fully compatible (it reads the existing claim).
    cmd_claim(argparse.Namespace(plan=args.plan, max_load=args.max_load,
                                 ttl_min=args.ttl_min, limit=args.limit))
    load = node_load(me)
    ran = []
    moot = []                    # tasks this pass judged "criterion already satisfied" (terminal, but not scored)
    cmd_run.last_progress = 0    # the caller reads this to see whether this pass made progress (see the end of the function)
    cmd_run.last_moot = 0
    for task in plan_tasks(args.plan):
        ref = "%s/%s/%s" % (CLAIM_NS, args.plan, task["id"])
        # Second copy of the same bug in cmd_run: skipping without distinguishing done/failed locks failed forever.
        # The previous fix was applied only to the cmd_claim copy; this path (the one that actually burns quota to execute) was missed.
        _r = parse_kv(read_ref("%s/%s/%s" % (RESULT_NS, args.plan, task["id"])))
        if _r.get("status") == "done":
            continue
        if _r.get("status") == "failed" and _r.get("node") == me:
            print("skip  | %s this node already failed it last time; leave it to another node" % task["id"])
            continue
        # [fourth state, read side] A task already judged moot does not rerun short_test.
        # The measured cost of omitting this line: the noop gate reruns the criterion every time (timeout 180s),
        # and tick hits the same batch of moot tasks every 15 minutes -- what it burns is wall clock, not quota,
        # but that is enough to drag one beat into the launchd timeout budget.
        # `status=noop` is the historical spelling left by the 2026-07-29 score reduction; it means the same thing, so accept both.
        if rev_ref("%s/%s/%s" % (MOOT_NS, args.plan, task["id"])) \
                or _r.get("status") == "noop":
            continue
        old = rev_ref(ref)
        claim = parse_kv(read_ref(ref)) if old else {}
        holder = claim.get("holder")
        expires = parse_ts(claim.get("expires")) if old else None
        if holder and holder != me and expires and expires > now():
            continue
        if holder != me or not expires or expires <= now():
            print("skip  | %s no valid claim by this node; refusing a receipt with no lineage" % task["id"])
            continue
        # [self-held exemption] I already hold this claim = the slot is already taken, so executing it must not consume quota again.
        #
        # Live deadlock on 2026-07-29: `claim --plan X` took 3 slots (node_load became 3),
        # then `run --plan X` reported, for **those same 3 tasks**,
        #   "pass | fm-ins-xxx -- overload (current 3 + this task 1 > limit 3)"
        # -> executed 0. **Claim and execute each counted the other as load**, so the node sat fully loaded with zero output.
        # This is the direct cause of the 59% idle rate: not a lack of work, but a held slot that could not enter the gate.
        #
        # The criterion is holder == me: the slot is mine, so executing it is fulfillment, not a new hold.
        # A claim held by another node still counts in my load check (that one really cannot be taken).
        _mine_already = (holder == me)
        score, why = fit_score(task, prof, 0 if _mine_already else load, args.max_load)
        if score is None:
            print("pass | %s — %s" % (task["id"], why))
            continue
        # The old plan runner has no attempt workspace / immutable candidate / integrator
        # chain. Letting it keep running file tasks in ROOT reopens three holes already sealed: shared-index pollution,
        # concurrent overwrite, and "a local commit counts as done". Until migration finishes, an explicit red light is better
        # than falling back to the root workspace. Read-only / external actions with artifact="-" may still use the old runner.
        if legacy_plan_requires_workspace(task):
            reason = "legacy_plan_requires_workspace_migration"
            print("stop  | %s — %s" % (task["id"], reason))
            payload = run_receipt_payload(
                args.plan, task, claim, executor, "failed", "workspace-required",
                reason, trigger_kind=trigger_kind)
            ok, why = write_ref(
                "%s/%s/%s" % (RESULT_NS, args.plan, task["id"]), payload)
            if ok:
                log("run %s/%s failed(%s)" % (args.plan, task["id"], reason))
            else:
                print("      ⚠️ migration receipt was not written (%s) -> UNKNOWN" % why)
                log("run %s/%s migration-receipt-write-failed=%s" %
                    (args.plan, task["id"], why))
            continue
        # [noop gate] A task whose criterion is already satisfied is not work, it is a noop -- stop it before burning quota.
        #
        # Measured 2026-07-29 (operator pointed it out): laptop did 8 island-* tasks in a row from 16:39-17:59,
        # all gate=passed, trust L1->L3, while those skills already had a host field by 12:18-13:10.
        # The node was doing **tasks whose criterion was already satisfied**: short_test passed immediately, the model call still burned,
        # output was zero, and trust still rose. The `why` command confirmed it: really done 0 / noop 8.
        #
        # Why this is more dangerous than "failing the work": a failure is stopped by the gate, costs score, and is visible;
        # **a noop stays green the whole way**. On the books it is the prettiest node, and it did nothing.
        # It pollutes three metrics at once: inflated gate-pass rate, inflated trust, inflated load.
        #
        # The criterion is short_test itself -- it is the only source of truth for "is this thing done".
        # Run it once before doing the work: already passed means there is nothing to do.
        #
        # [second fix, 2026-07-29] The first version only `continue` here and **persisted nothing**.
        # The comment even said "do not write a result and do not score". Not scoring was right; not persisting was wrong --
        # "nothing to do" is a **terminal state**, not "not started yet". With nowhere to land, the direct consequence
        # (log evidence, five beats in a row with identical text at 18:15/18:31/18:48/19:04/19:21):
        #   both tasks in the plan are noop -> nobody gets a terminal state -> the plan stays open forever
        #   -> tick `_oldest_open_plan` always returns the same plan
        #   -> "take old work first; this tick issues no new plan" always hits -> discover is never reached
        #   -> 15 real backlog items (4 currently eligible for this node) are never dispatched = idle.
        # The fix gives the fourth state its own namespace (MOOT_NS): **remember it, skip it, but do not enter it in the credit ledger**.
        # Writing a result would pollute HAAS and the gate-pass rate -- a noop deserves neither credit nor a penalty.
        # [invalid-premise gate] The scanner is fixed, but **tasks queued before the fix do not disappear on their own**.
        # Measured 2026-07-29: after `own_skill()` landed, new tasks no longer treat a vendor symlink as debt,
        # but island-YC-autoplan in plan imm-0729073608 was already queued -- so the worker
        # every beat ran a job that was physically impossible to finish (skills/YC-autoplan ->
        # ${CORTEX_VENDOR_SKILLS}/gstack/autoplan, dangling on a Linux node),
        # burned a full round of quota every beat, produced a constant zero, and added a number to the gate-pass denominator.
        #
        # This is dimensional collapse: the single state "failure" mixed two opposite things --
        #   "I cannot do it" (fix the capability / switch nodes)
        #   "this work should not have existed" (retire the criterion, do not retry)
        # Collapsed into one FAIL, the system retries the latter forever. So it must go through moot, not result:
        # an invalid premise deserves neither credit (no work was done) nor a penalty (it is not that node's fault).
        #
        # Trust only own_skill -- the same ruler as the discovery layer, so the two layers do not judge differently.
        _bad_premise = ""
        for _fld in ("short_test", "artifact", "detail"):
            _v = task.get(_fld) or ""
            for _m in re.finditer(r"skills/([A-Za-z0-9._-]+)", str(_v)):
                _p = os.path.join(ROOT, "skills", _m.group(1))
                if os.path.lexists(_p) and not own_skill(_p):
                    _bad_premise = "skills/%s is an external vault symlink (vendor), not governed by this repo" % _m.group(1)
                    break
            if _bad_premise:
                break
        if _bad_premise:
            print("moot  | %s -- premise invalid: %s (retire the criterion, do not retry)" % (task["id"], _bad_premise))
            write_ref("%s/%s/%s" % (MOOT_NS, args.plan, task["id"]),
                      "task=%s\nnode=%s\nstatus=moot\nreason=premise-invalid\nat=%s\ndetail=%s"
                      % (task["id"], me, fmt(now()), _bad_premise[:200]))
            moot.append(task["id"])
            continue

        _st = (task.get("short_test") or "").strip()
        if _st and _st != "-":
            _c0, _ = run("cd %s && %s" % (ROOT, _st), timeout=180)
            if _c0 == 0:
                # A marker written by this executor may mean a recoverable partial: already changed or already committed, and the last tick only lacked the push;
                # hand it to the deterministic adapter to finish propagation.
                _marker = "<!-- cortex:map-backlink %s -->" % (
                    task.get("discovery_id") or task["id"])
                _artifact = task.get("artifact") or ""
                _resume_deterministic = False
                if task.get("source") == "map-backlink-gap" and _artifact not in ("", "-"):
                    _full = os.path.join(ROOT, _artifact)
                    if os.path.isfile(_full):
                        with open(_full, encoding="utf-8", errors="replace") as _fh:
                            _resume_deterministic = _marker in _fh.read()
                if _resume_deterministic:
                    print("resume| %s -- criterion already satisfied but this discovery marker is present; continue propagation/receipt"
                          % task["id"])
                else:
                    print("noop  | %s -- criterion already satisfied, nothing to do (record terminal state, do not burn quota, do not score)"
                          % task["id"])
                    write_ref("%s/%s/%s" % (MOOT_NS, args.plan, task["id"]),
                              "task=%s\nnode=%s\nstatus=moot\nat=%s\nshort_test=%s"
                              % (task["id"], me, fmt(now()), _st[:160]))
                    moot.append(task["id"])
                    continue

        # The three gates of the six laws must run **before burning quota**: C1 intent is the boundary / C2 trust is the measure / C3 safety is the floor.
        # Blocking after execution burns a call for nothing -- the gate must open before spending.
        _haas0, _ = haas_score(me)
        _trust0 = trust_level(_haas0)
        allowed, law, reason = covenant_check(task, prof, _trust0, _haas0)
        if not allowed:
            print("stop  | %s -- [%s] %s" % (task["id"], law, reason))
            continue
        payload = "holder=%s\nexpires=%s\nsince=%s\ntask=%s" % (
            me, fmt(now() + timedelta(minutes=args.ttl_min)), fmt(now()), task["id"])
        ok, _ = write_ref(ref, payload, parent=old)
        if not ok:
            print("lost  | %s taken first by another node" % task["id"])
            continue
        if task.get("source") == "map-backlink-gap":
            executor = "deterministic.backlink"
        print("run   | %s <- %s (executor=%s)" % (task["id"], me, executor))
        prompt = "\n".join([
            "You are the executor on swarm node %s, running one subtask of distributed plan %s." % (me, args.plan),
            "Nobody is beside you. There is no one to ask.",
            "", "## Task", task["title"],
            "## File you must produce", task["artifact"],
            "## Acceptance command (run independently; you saying it is done does not count)", task["short_test"],
            "", "## Hard rules",
            "1. Do only this one item; do not do anything else along the way. 2. The result must be written into the output file above.",
            "3. Do not declare yourself done. 4. If you cannot finish, write the reason into the output file and say what is missing.",
            "5. Do not change the acceptance command, do not loosen the standard, and do not use `|| true`.",
            "6. The output file must be `git add <that file> && git commit` -- sitting only on disk does not count.",
            "   The swarm sees your work through git. Not in history means not done (the propagation gate will block it).",
        ])
        if executor == "deterministic.backlink":
            out = run_deterministic_backlink(args.plan, task)
        else:
            out = run_adapter(executor, "run-%s-%s" % (args.plan, task["id"]), prompt)
        if out.startswith("[DETERMINISTIC_RETRY]"):
            print("      ↻ deterministic execution cannot propagate yet; this tick stays UNKNOWN for retry next tick: %s"
                  % out.split("\n", 1)[-1][:160])
            log("run %s/%s deterministic-retry" % (args.plan, task["id"]))
            continue
        if out.startswith("[DETERMINISTIC_MOOT]"):
            print("      noop: %s" % out.split("\n", 1)[-1][:160])
            write_ref("%s/%s/%s" % (MOOT_NS, args.plan, task["id"]),
                      "task=%s\nnode=%s\nstatus=moot\nat=%s\nreason=already-satisfied"
                      % (task["id"], me, fmt(now())))
            moot.append(task["id"])
            continue
        # [pre-gate] When the executor fails as a whole, the mechanical gate must not get a chance to judge pass.
        # Real incident: three results at 02:37/02:42/02:44 were entirely `API Error: 502`,
        # but were recorded as done because short_test then always returned 0 -- the executor never did the work,
        # and the system still declared the task done. E011 fixed the criterion itself, but did not block "the executor is down and still passes the gate".
        # Now: a non-zero adapter exit (run_adapter already prefixes [ADAPTER_FAILED]) is judged failed directly,
        # and no later judgment branch runs.
        if out.startswith("[ADAPTER_FAILED"):
            first = out.split("\n", 2)[1][:120] if "\n" in out else ""
            print("      ✗ executor failed to complete the call -> judged failed directly (does not enter the mechanical gate): %s" % first)
            payload = run_receipt_payload(args.plan, task, claim, executor, "failed",
                                          "executor-down", first,
                                          trigger_kind=trigger_kind)
            ok, why = write_ref("%s/%s/%s" % (RESULT_NS, args.plan, task["id"]), payload)
            if ok:
                log("run %s/%s failed(executor-down) by %s" % (args.plan, task["id"], me))
            else:
                print("      ⚠️ failed receipt was not written (%s) -> UNKNOWN; do not disguise a failure as recorded" % why)
                log("run %s/%s receipt-write-failed executor-down=%s" %
                    (args.plan, task["id"], why))
            continue
        # Completion still goes through the mechanical gate: artifact exists and is non-empty + short_test exit code 0.
        # Exception: "-" is the placeholder for "no single fixed output" (governance tasks: the completion criterion is the scanner itself
        # turning green on rerun, not the existence of some file) -- measured os.path.exists("-") is always false,
        # so these tasks were a death sentence at the mechanical gate and can be judged only by short_test (the scanner that found them).
        artifact = task["artifact"]
        scope_gap = ""          # the "task definition is too narrow" gap named by the verifier; default none
        origin_commit = ""
        candidate_oid = ""
        landed_oid = ""
        if artifact == "-":
            passed = task["short_test"] not in ("-", "") and \
                run("cd %s && %s" % (ROOT, task["short_test"]), timeout=300)[0] == 0
        else:
            full = artifact if os.path.isabs(artifact) else os.path.join(ROOT, artifact)
            passed = os.path.exists(full) and (not os.path.isfile(full) or os.path.getsize(full) > 0)
            if passed and task["short_test"] not in ("-", ""):
                passed = run("cd %s && %s" % (ROOT, task["short_test"]), timeout=300)[0] == 0
            # [propagation gate] Phantom completion caught 2026-07-29: real1/R2 was judged by the worker as
            # `status=done gate=passed`. The output work-studio/devops/dotfiles/systemd/README.md
            # was really 6579 bytes on the worker disk -- but it sat in the index as `A `, never committed,
            # never pushed, and in origin this file **did not exist at all, with zero git history**.
            # The mechanical gate only stats the local disk. It cannot check "can the swarm see this work". So a node
            # deadlocked on git-sync can keep judging itself done, while shared state gains nothing.
            # This is not a loosened gate. The gate is **blind to propagation** -- more hidden than loosening, because the ledger is all green.
            # Tighten: a file output counts only if it can enter git history. Work that cannot be persisted is not done.
            if passed:
                # [propagation gate v2] v1 only checked that `git log -1 -- <artifact>` was non-empty.
                # A live run immediately contradicted it: the worker judged island-full-output-enforcement done,
                # while that file on origin **had no host field** -- because the file already had history
                # (an earlier commit had touched it). `git log` was of course non-empty, so "this file was committed once"
                # was treated as "this change was committed". The same kind of false gate, a second time:
                # it checked "the file once existed in history", not "the current content entered history".
                # v2 checks whether the worktree matches HEAD: `git status --porcelain` must be empty.
                # Empty means no uncommitted changes, nothing added but not committed, and nothing untracked,
                # which means the content on disk really is the content in HEAD. That is the real criterion.
                # (The real1/R2 `A ` was staged but not committed, and v2 correctly blocks it.)
                _, dirty = run("cd %s && git status --porcelain -- %s"
                               % (ROOT, artifact), timeout=60)
                _, seen = run("cd %s && git log -1 --oneline -- %s"
                              % (ROOT, artifact), timeout=60)
                dirty_changes = porcelain_changes(dirty)
                if dirty_changes or not seen.strip():
                    passed = False
                    print("      -> output did not land in git (%s) -> the swarm cannot see it = not complete"
                          % ("uncommitted changes" if dirty_changes else "no commit history"))
                else:
                    reachable, origin_or_why = artifact_origin_reachable(artifact)
                    if reachable:
                        origin_commit = origin_or_why
                        delivery = getattr(artifact_origin_reachable, "last_binding", {})
                        if delivery.get("candidate_oid") != origin_commit:
                            delivery = {}
                        candidate_oid = delivery.get("candidate_oid", origin_commit)
                        landed_oid = delivery.get("landed_oid", origin_commit)
                    else:
                        passed = False
                        print("      -> output did not enter canonical history (%s) -> not complete" % origin_or_why)
        # The mechanical gate can only check "is there output, and is the command green". It cannot check "is the output generic boilerplate" --
        # that is the blind spot exposed when the real1 worker wrote a textbook version instead of a handbook of this machine.
        # pick_verifier had long been written, but only cmd_done called it; the run path had zero AI verification.
        # [inspection intensity tiered by trust] Garment-factory inspection: full inspection for a new supplier, sampling for an old one.
        # Spend the limited verification budget (each ai_judge is one full model call) where problems are most likely.
        _mode, _need_ai, _need_ts = inspection_mode(me)
        if task.get("source") == "map-backlink-gap":
            # The scanner defines the gap, short_test replays the criterion, and Git clean + origin reachable proves
            # the current world has already changed; calling the model again only repeats mechanical evidence and risks widening scope.
            _mode, _need_ai, _need_ts = "deterministic-full", False, True
        if passed and _need_ts:
            # Full-inspection tier only: check not just "the criterion passes now", but "did the world change because this work was done".
            # This is the hole through which readjudicate let 7 noops through on 2026-07-29 --
            # sample-inspection strictness was used on a historical record of an L1 node.
            _arts = [a for a in (task.get("artifact") or "").split() if a and a != "-"]
            for _a in _arts:
                _c, _o = run("cd %s && git log -1 --format=%%cI -- %s" % (ROOT, _a), timeout=60)
                if _c == 0 and _o.strip() and _o.strip()[:16] < fmt(now())[:16]:
                    _c2, _ = run("cd %s && git status --porcelain -- %s" % (ROOT, _a), timeout=60)
                    if _c2 == 0:
                        pass          # changes waiting to commit mean this round really touched something
        if passed and not _need_ai:
            print("      inspection tier: %s (trust %s) -> a mechanical-gate pass is accepted, saving one verification call"
                  % (_mode, trust_level(haas_score(me)[0])))
        elif passed:
            v_exec, v_node, tier = pick_verifier(executor, prof)
            print("      inspection tier: %s (trust %s)" % (_mode, trust_level(haas_score(me)[0])))
            if v_exec is None:
                print("      ⚠️ no independent verifier -> mechanical gate only; do not pretend AI verification happened")
            else:
                print("      independent verification: %s@%s (%s)" % (v_exec, v_node, tier))
                # `title` is a sentence for humans, **not** the criterion. Passing it straight through as
                # success_criteria made the verifier guess the standard -- in practice it always
                # guessed a scope much larger than short_test (requiring files outside bounds),
                # and that is exactly what C1 forbids the executor to touch. The criterion has one source of truth: short_test.
                vd, vr = ai_judge(args.plan, v_exec, {
                    "id": task["id"], "title": task["title"],
                    "success_criteria": "mechanical criterion is authoritative: %s (the title above is only a human-readable note;"
                                        " do not widen scope from it)" % (task["short_test"] or "none"),
                    "short_test": task["short_test"],
                    "bounds": task.get("bounds") or "",
                    "failure_modes": "generic boilerplate / textbook template / content invented without this machine actual state",
                    "artifact_paths": artifact})
                if vd == "REJECT":
                    passed = False
                    print("      -> mechanical gate passed but the independent verifier refused: %s" % vr)
                elif vd == "SCOPE":
                    # Finished everything inside the boundary, but the task definition itself is too narrow. The executor is not at fault -> do not judge failed
                    # (judging failed drops HAAS trust and punishes a node that followed the rules).
                    # The gap must not disappear: record it honestly in the result gate field and the log,
                    # so "the task definition should be widened" stays auditable instead of being swallowed by done.
                    scope_gap = vr
                    print("      -> met the bar inside the boundary, but the verifier says the task definition is too narrow: %s" % vr)
        status = "done" if passed else "failed"
        # C1 out-of-bounds must be recorded: output outside the authorized scope is a violation even if the mechanical gate passed (it enters the HAAS denominator).
        # artifact="-" has no single output to judge as out of bounds; keep the same exception as covenant_check.
        bounds = (task.get("bounds") or "").split()
        if bounds and artifact != "-" and not any(artifact.startswith(b) for b in bounds):
            record_incident(me, "C1-out-of-bounds", "output %s is outside %s" % (artifact, " ".join(bounds)))
        value, note = verify_value(task, artifact)
        if note:
            print("      value check: %s" % note)
        # On write-back, record the trust level **at the moment of execution** -- the same live HAAS computation as cmd_claim,
        # so the result ref carries audit context for "how far this node was trusted then".
        _haas, _facts = haas_score(me)
        trust = trust_level(_haas)
        # The gate has three states, not two (dimensional-expansion law): passed / rejected / scope-gap.
        # scope-gap = everything inside the boundary met the bar, but the verifier named the task definition as too narrow. It **counts in the gate-pass numerator**
        # (the executor really finished all authorized work), and the gap is written into reason as evidence,
        # otherwise "the task should be widened" is silently swallowed by passed.
        gate = "scope-gap" if (passed and scope_gap) else ("passed" if passed else "rejected")
        # Record the time mechanical world verification finished, not the time the receipt was written back; later gather can
        # recheck replayable verification_command/world evidence.
        world_verified_at = fmt(now()) if status == "done" else "-"
        payload = run_receipt_payload(args.plan, task, claim, executor, status, gate,
                                      origin_commit=origin_commit,
                                      world_verified_at=world_verified_at,
                                      trigger_kind=trigger_kind,
                                      candidate_oid=candidate_oid,
                                      landed_oid=landed_oid)
        payload += "\nvalue=%s\ntrust=%s" % (value, trust)
        if scope_gap:
            payload += "\nscope_gap=%s" % scope_gap.replace("\n", " ")[:200]
        ok, why = write_ref("%s/%s/%s" % (RESULT_NS, args.plan, task["id"]), payload)
        if not ok:
            print("      ⚠️ result receipt was not written (%s) -> UNKNOWN; do not record done / do not count progress" % why)
            log("run %s/%s receipt-write-failed=%s" % (args.plan, task["id"], why))
            continue
        print("      -> %s (gate=%s)" % (status, gate))
        log("run %s/%s %s gate=%s by %s" % (args.plan, task["id"], status, gate, me))
        ran.append(task["id"])
        load += int(task.get("weight") or 1)
        if args.limit and len(ran) >= args.limit:
            break
    print("this node %s executed %d: %s" % (me, len(ran), " ".join(ran) or "-"))
    if moot:
        print("this node %s judged nothing to do for %d (terminal state recorded, the plan can close): %s"
              % (me, len(moot), " ".join(moot)))
    # The return value tells the caller whether this pass really advanced -- it is not an exit code.
    # tick must distinguish "took old work and advanced it" from "took old work but did not move":
    # if the latter still returns 0 and blocks discover, that is the shape of this livelock.
    cmd_run.last_progress = len(ran) + len(moot)
    cmd_run.last_moot = len(moot)
    return 0


def cmd_result(args):
    """Keep the command name so old scripts get an explicit error; a result receipt can only be formed by cmd_run."""
    print("refusing a direct result: status/gate/receipt must be produced together by the run mechanical gate and a valid claim")
    return 2


def inspection_mode(node):
    """Decide inspection intensity from the trust level -- full inspection / sample inspection / exempt (set by operator 2026-07-29).

    Original words (garment-factory inspection analogy):
      "When the partnership is new and maturity and trust are low: inspect every incoming item, one by one,
        and return what fails. After a long partnership, good quality, and high trust: you do not have to inspect everything; sample.
        That balances cost, benefit, and quality control."

    This is not "harsher on low-trust nodes". It **spends the limited verification budget where problems are most likely**.
    Verification itself burns a model call (ai_judge is one full call). Fully inspecting a high-trust node is waste.

    Counterexample I hit on 2026-07-29: readjudicate checked only "short_test passes now"
    and let 17 through; later 7 were noops -- **at trust L1, sample-inspection strictness was used**.
    The low-trust period should fully inspect: check not only that the criterion passes now, but whether the world changed because this work was done.

    Returns (mode, whether AI verification is required, whether the output timestamp must be checked).
    """
    h, _ = haas_score(node)
    lv = trust_level(h)
    if lv in ("L1", "L2"):
        return "full inspection", True, True      # check every item, and check whether anything really changed
    if lv == "L3":
        return "sample inspection", True, False     # still goes through AI verification, but does not check timestamps item by item
    return "exempt", False, False        # L4/L5: a mechanical-gate pass is accepted, saving the verification call


def cmd_why(args):
    """Why trust rose or fell -- traceable to each record, and able to recognize score farming.

    operator 2026-07-29: "It really rose, and the reason for the rise must be labeled too. The main thread is this low;
    what existing practice can be copied? Do it that way and learn that way."

    But **before copying, separate real credit from score farming**:
    Measured 2026-07-29 -- laptop did 6 island-* tasks in a row from 17:00-17:59, all passed,
    trust L1->L3; those skills already had a host field by 12:18-13:10.
    The node was doing **tasks whose criterion was already satisfied**: short_test passed immediately, the model call still burned,
    output was zero, and trust still rose. That is score farming, not work.

    Criterion: task-completion time versus criterion-satisfied time -- if the output file already met the bar before the task started,
    record it as `noop` (no real work), and do not count it as real credit.
    """
    fetch_refs()
    node = args.node or orchestrator_id()
    rows = []
    for ref in list_refs(RESULT_NS):
        kv = parse_kv(read_ref(ref))
        if kv.get("node") != node:
            continue
        rows.append((kv.get("finished", "?"), kv.get("gate", "?"),
                     kv.get("task", "?"), kv.get("readjudicated", ""), ref))
    if not rows:
        print("node %s has no records" % node)
        return 0
    rows.sort()
    h, meta = haas_score(node)
    print("node %s | HAAS %.3f (%s) | samples %s" % (node, h, trust_level(h), meta.get("samples")))
    print("| time | verdict | task | nature |")
    print("|------|------|------|------|")
    real = noop = 0
    for ts, gate, task, readj, ref in rows[-args.limit:]:
        nature = ""
        if readj:
            nature = "rejudged (original criterion mismatched)"
        elif gate == "passed":
            # Criterion already satisfied before the task completed = noop
            plan_id = ref.split("/result/")[-1].rsplit("/", 1)[0]
            t = next((x for x in plan_tasks(plan_id) if x.get("id") == task), None)
            st = (t or {}).get("short_test", "")
            arts = [a for a in ((t or {}).get("artifact") or "").split() if a and a != "-"]
            already = False
            for a in arts:
                code, out = run("cd %s && git log -1 --format=%%cI -- %s" % (ROOT, a), timeout=60)
                if code == 0 and out.strip() and out.strip()[:16] < ts[:16]:
                    already = True
            nature = "⚠️ noop (criterion already satisfied)" if already else "✅ really done"
            real += 0 if already else 1
            noop += 1 if already else 0
        else:
            nature = "rejected"
        print("| %s | %s | %s | %s |" % (ts[:16], gate, task[:26], nature))
    print("\nreally done %d | noop %d -- a noop also raising trust is a **scoring hole**, not skill" % (real, noop))
    if noop > real:
        print("⚠️ this node's trust comes mainly from noops; it is not a benchmark")
    return 0


def cmd_readjudicate(args):
    """Rejudge historical rejected results with the **current** criterion -- a wrongful rejection should not be carried forever.

    Measured 2026-07-29: of 24 rejected results, most fell to the same design defect --
    the AI verifier received a "completion standard" that was the task title (a vision sentence) rather than short_test (a verifiable criterion),
    so it invented requirements far beyond bounds, and outside bounds is what C1 forbids touching.
    If the executor complies it is recorded as a violation; if it does not, it is rejected. **Both paths die**.
    Hard evidence: the same output and the same verifier, island-brandkit REJECT at 11:09 -> ACCEPT at 13:41,
    and the only change in between was "which criterion the verifier received". The output did not change by one character.

    Why rerun rather than change the metric or delete the record:
      changing the rolling window = treating the symptom, and **changing the metric you are graded on** is exactly what CI should report as drift
      deleting the ref = erasing the ledger, which violates the reason this mechanism exists
      **rerunning the criterion** = do not change the metric and do not delete the record; give the old task a fair chance with the new code --
                    if it passes, it really passed; if it does not, it should have been rejected
    """
    fetch_refs()
    fixed = kept = skipped = 0
    for ref in list_refs(RESULT_NS):
        kv = parse_kv(read_ref(ref))
        if kv.get("gate") != "rejected":
            continue
        plan_id = ref.split("/result/")[-1].rsplit("/", 1)[0]
        task_id = ref.rsplit("/", 1)[-1]
        task = next((t for t in plan_tasks(plan_id) if t.get("id") == task_id), None)
        if not task or not (task.get("short_test") or "").strip("- "):
            skipped += 1
            continue
        code, out = run("cd %s && %s" % (ROOT, task["short_test"]), timeout=180)
        if code == 0:
            # The criterion is really satisfied now -- the original REJECT does not hold
            payload = "\n".join("%s=%s" % (k, v) for k, v in kv.items()
                                if k not in ("gate", "status"))
            payload += ("\nstatus=done\ngate=passed\nreadjudicated=%s"
                        "\nreadjudicate_note=original rejected was a criterion mismatch (title used as success_criteria)"
                        "; rejudged pass with the current short_test\n" % fmt(now()))
            ok, _ = write_ref(ref, payload, parent=rev_ref(ref))
            if ok:
                fixed += 1
                print("  ✅ reversed %s/%s -- short_test passes now" % (plan_id, task_id))
            else:
                print("  ⚠️ %s/%s criterion passed but the ref write failed (network)" % (plan_id, task_id))
        else:
            kept += 1
            print("  ⏸  kept %s/%s -- criterion still fails (exit code %d); not a wrongful rejection" % (plan_id, task_id, code))
    print("\nreversed %d | kept %d | skipped %d (no short_test, cannot rejudge)" % (fixed, kept, skipped))
    print("Note: only reverse those whose criterion **really passes now**; leave every one that still fails untouched -- this is a review, not an amnesty.")
    return 0


def cmd_gather(args):
    """Any node can aggregate. If the set is incomplete, refuse to declare completion -- the completion gate extended to a distributed setting."""
    fetch_refs()
    tasks = plan_tasks(args.plan)
    if not tasks:
        print("plan not found %s" % args.plan)
        return 1
    done, missing, learning_pending = [], [], []
    print("| subtask | executing node | status | output |")
    print("|--------|----------|------|------|")
    for task in tasks:
        result_ref = "%s/%s/%s" % (RESULT_NS, args.plan, task["id"])
        moot_ref = "%s/%s/%s" % (MOOT_NS, args.plan, task["id"])
        if rev_ref(moot_ref):
            moot_kv = parse_kv(read_ref(moot_ref))
            if moot_kv.get("status") == "moot" and moot_kv.get("task") == task["id"]:
                done.append(task["id"])
                print("| %s | %s | ◌ moot | criterion already satisfied, no need to produce it again |"
                      % (task["id"], moot_kv.get("node") or "mechanical gate"))
                continue
        kv = parse_kv(read_ref(result_ref)) if rev_ref(result_ref) else {}
        valid, why = receipt_valid(kv, args.plan, task["id"])
        # A file receipt cannot rely only on the remote judgment at write time; recheck the current origin before settlement.
        # A fetch/permission failure is UNKNOWN and must refuse to mark the plan complete.
        if valid and kv.get("artifact") != "-":
            if kv.get("candidate_oid") or kv.get("landed_oid"):
                valid, landing = commit_canonical_landed(kv.get("candidate_oid"))
                why = landing.get("detail", "canonical landing invalid")
            else:
                # run-v1 historical receipts are read for compatibility; new writes carry both OIDs and go through the canonical gate.
                valid, why = commit_origin_reachable(kv.get("origin_commit"))
        if valid:
            done.append(task["id"])
            # scope-gap means the task definition still has a gap; it can close this task, but it cannot pretend to be a learnable
            # positive sample. A manual plan missing frozen discovery is the same: deliverable, not counted for G1, not entered into learning.
            if kv.get("gate") == "passed" and receipt_has_frozen_discovery(kv):
                if not publish_learning_candidate(kv, result_ref):
                    learning_pending.append(task["id"])
            print("| %s | %s | ✅ done | %s |" % (task["id"], kv.get("node"), kv.get("artifact")))
        else:
            missing.append(task["id"])
            claim_ref = "%s/%s/%s" % (CLAIM_NS, args.plan, task["id"])
            holder = (parse_kv(read_ref(claim_ref)).get("holder")
                      if rev_ref(claim_ref) else None)
            state = kv.get("status") or "not done"
            if state == "done":
                state = "receipt invalid: %s" % why
            print("| %s | %s | ⏳ %s | - |" % (task["id"], holder or "unclaimed", state))
    print("\ncollected %d/%d" % (len(done), len(tasks)))
    if missing:
        print("refusing to declare complete -- missing: %s" % " ".join(missing))
        return 1
    if learning_pending:
        print("refusing to settle -- learning candidate was not written: %s" % " ".join(learning_pending))
        return 1
    print("all done, plan %s can be settled" % args.plan)
    if not args.settle:
        return 0
    # Settlement has side effects, so duplicates must be prevented: if two nodes gather at once, only one can write the settlement ref.
    # A read-only gather needs no lock -- lock only at the step that writes.
    ref = "%s/%s/_settled" % (RESULT_NS, args.plan)
    old = rev_ref(ref)
    if old:
        kv = parse_kv(read_ref(ref))
        print("already settled by %s at %s; not repeating" % (kv.get("node"), kv.get("at")))
        return 0
    ok, _ = write_ref(ref, "node=%s\nat=%s\ntasks=%d" % (node_id(), fmt(now()), len(done)),
                      parent=old)
    print("settled %s <- %s" % ("success" if ok else "another node got there first (CAS held)", node_id()))
    return 0


def cmd_dashboard(args):
    """See the whole swarm on one screen -- who is up, who owns what, where the ledger is, how far plans have run, whether the clock is alive.

    Why it exists: this information used to be scattered across the five commands swarm/status/reconcile/health/gather,
    and a person had to assemble five views to see the whole -- that is not observability, that is a memory test.
    """
    fetch_refs()
    me = node_id()
    prof = node_profile()
    nodes = read_swarm()

    data = {"node": me, "profile": prof, "nodes": {}, "lines": [], "plans": [], "drift": 0}

    print("╔══ cortex-loop dashboard ══ this node %s (%s - can_sleep=%s)" % (
        me, prof["kind"], prof["can_sleep"]))
    print("║  executor %s | Telegram reachable %s | %s"
          % (prof["executors"], prof["telegram_reach"], fmt(now())))

    print("╠══ swarm nodes ─────────────────────────────────────────")
    print("║ %-10s %-11s %-6s %-14s %s" % ("node", "type", "alive", "owned lines", "criterion"))
    for name, node in sorted(nodes.items()):
        alive, why = node_alive(node)
        data["nodes"][name] = {"alive": alive, "why": why, "kind": node.get("kind"),
                               "owns": node.get("owns")}
        print("║ %-10s %-11s %-6s %-14s %s"
              % (name + ("*" if name == me else ""), node.get("kind"),
                 "✅" if alive else "❌", node.get("owns") or "-", why))

    print("╠══ direction-line ledger ───────────────────────────────────────")
    per_line_overall = {}      # [T12] split by line (line_breakdown), then used by JSON and printing
    overall_counts = {}
    for entry in clock_lines():
        line = entry["line"]
        tasks = load_tasks(line)
        counts = {}
        for task in tasks:
            status = task.get("status", "?")
            counts[status] = counts.get(status, 0) + 1
            overall_counts[status] = overall_counts.get(status, 0) + 1
        due = len(due_tasks(line))
        stuck = [(t["id"], d) for t, d in stuck_tasks(line)]
        state, why = ("SKIP", "disabled") if entry.get("enabled", "").lower() not in \
            ("yes", "y", "true") else (
            ("SKIP", "owned by %s" % entry.get("owner")) if entry.get("owner") not in ("", "-", me)
            else probe_driver(entry.get("driver", "-")))
        if state == "DRIFT":
            data["drift"] += 1
        per_line_overall[line] = counts
        data["lines"].append({"line": line, "counts": counts, "due": due,
                              "driver_state": state, "stuck": stuck})
        print("║ %-12s owner=%-9s %s" % (line, entry.get("owner") or "-",
              " ".join("%s=%d" % kv for kv in sorted(counts.items())) or "(empty)"))
        print("║   due %d | driver %s (%s)" % (due, state, why))
        for task_id, days in stuck:
            print("║   ⚠️ %s stuck for %d days" % (task_id, days))
    # [T12] final line_breakdown total (summing by line is not the truth anchor; this is "how to read each line
    # own distribution", not only the total, so you can see at a glance which line is larger in which bucket)
    print("║ ── total all (by_line=%d) ── %s" % (
        len(per_line_overall),
        " ".join("%s=%d" % kv for kv in sorted(overall_counts.items())) or "(empty)"))
    data["line_breakdown"] = {"per_line": per_line_overall, "overall": overall_counts}

    print("╠══ distributed plans ───────────────────────────────────────")
    plans = sorted({ref.split("/")[-1] for ref in list_refs(PLAN_NS)})
    if not plans:
        print("║ (none)")
    for plan in plans:
        tasks = plan_tasks(plan)
        done = [t for t in tasks
                if parse_kv(read_ref("%s/%s/%s" % (RESULT_NS, plan, t["id"]))).get("status") == "done"]
        holders = {}
        for task in tasks:
            holder = parse_kv(read_ref("%s/%s/%s" % (CLAIM_NS, plan, task["id"]))).get("holder")
            if holder:
                holders[holder] = holders.get(holder, 0) + 1
        settled = bool(rev_ref("%s/%s/_settled" % (RESULT_NS, plan)))
        data["plans"].append({"plan": plan, "done": len(done), "total": len(tasks),
                              "holders": holders, "settled": settled})
        print("║ %-10s %d/%d done%s | claim distribution %s"
              % (plan, len(done), len(tasks), " ✅ settled" if settled else "",
                 " ".join("%s×%d" % kv for kv in sorted(holders.items())) or "none"))

    print("╠══ clock ─────────────────────────────────────────────")
    last = last_tick_at()
    print("║ last tick: %s%s" % (fmt(last) if last else "no record",
          " (%d minutes ago)" % int((now() - last).total_seconds() // 60) if last else ""))
    print("║ DRIFT: %d" % data["drift"])
    print("╚═════════════════════════════════════════════════════")

    if args.json:
        import json as _json
        print(_json.dumps(data, ensure_ascii=False, indent=2))
    return 0


def cmd_swarm(args):
    me = write_profile()
    nodes = read_swarm()
    print("this node: %s (%s - can_sleep=%s - executors=%s)"
          % (me["node"], me["kind"], me["can_sleep"], me["executors"]))
    print()
    print("| node | type | sleeps | owned lines | alive | criterion |")
    print("|------|------|------|----------|------|------|")
    dead = []
    for name, prof in nodes.items():
        alive, why = node_alive(prof)
        if not alive:
            dead.append(name)
        print("| %s | %s | %s | %s | %s | %s |"
              % (name, prof.get("kind"), prof.get("can_sleep"),
                 prof.get("owns"), "✅" if alive else "❌", why))

    orphan = [e["line"] for e in clock_lines()
              if e.get("owner") in dead and e.get("enabled", "").lower() == "yes"]
    if orphan:
        print("\n⚠️ owner is offline (affinity hint only): %s" % ", ".join(orphan))
        print("takeover rule: a live node may compete for a %d-minute scheduler lease; task-level CAS prevents duplicates" %
              SCHEDULER_LEASE_MIN)
    return 0


def owns_line(entry, nodes):
    """Whether this node can be a scheduler candidate for this line.

    CLOCK.owner is an affinity hint, not an admission lock. The old implementation required the owner to stay silent for
    2x the takeover threshold before other nodes could enter; the result was that as long as the owner was "alive but health red"
    or "alive but busy", other capable nodes never had a path to take over. Now every node with a fresh
    heartbeat may compete for a short line lease. Git CAS prevents the same tick from being scheduled twice;
    task-level claim/ledger CAS prevents a worker from executing twice.

    The function name is kept for existing callers; the meaning changed from "owns the line" to "eligible as a line
    candidate". Stay conservative when this node has no profile, so an unregistered process does not quietly run an automatic line.
    """
    me = node_id()
    if not nodes:
        # Early startup has not read the swarm ref yet; this tick will publish a heartbeat next.
        return True
    prof = nodes.get(me)
    if prof is None:
        return False
    return node_alive(prof)[0]


# -- ledger ------------------------------------------------------------------

def clock_lines():
    # CLOCK primary-key column is line (not id); the wrong key silently reads 0 rows
    _, _, rows = read_table(CLOCK, key="line")
    return [r for _, r in rows if r.get("line")]


def tasks_path(line):
    return os.path.join(DIRECTIONS, line, "TASKS.md")


def load_tasks(line):
    _, _, rows = read_table(tasks_path(line))
    return [r for _, r in rows if r.get("id")]


def is_negative_test_sentinel(line, task):
    """A counter-test sentinel is not action debt: the explicit role is the truth, and old T3 is only migration compatibility."""
    role = (task.get("role") or "").strip()
    if role:
        return role == "negative_test_sentinel"
    return line == "loop-ops" and task.get("id") == "T3" \
        and task.get("status") == "blocked"


def runnable(tasks, task):
    if task.get("status") != "pending":
        return False
    # `-` means "no dependency" only, not a general separator. After task IDs were uniquified they use
    # `IMM-T1` / `OPS-T2`; the old replace("-", " ") split a real ID
    # into `IMM` + `T1`, so the prerequisite was done and the task stayed unreachable forever.
    raw_deps = (task.get("depends_on") or "").strip()
    deps = [] if raw_deps in ("", "-") else [
        d for d in re.split(r"[\s,]+", raw_deps) if d and d != "-"
    ]
    done = {t["id"] for t in tasks if t.get("status") == "done"}
    return all(d in done for d in deps)


def due_tasks(line):
    tasks = load_tasks(line)
    out = []
    for task in tasks:
        if not runnable(tasks, task):
            continue
        window = parse_ts(task.get("next_advance_after"))
        if window is None or window <= now():
            out.append(task)
    return out


def stuck_tasks(line):
    """How long blocked / waiting_external has been overdue; used by the escalation ladder."""
    out = []
    for task in load_tasks(line):
        if is_negative_test_sentinel(line, task):
            continue
        if task.get("status") not in ("blocked", "waiting_external"):
            continue
        updated = parse_ts(task.get("updated_at"))
        days = (now() - updated).days if updated else 0
        out.append((task, days))
    return out


def resume_recoverable_blocked(line):
    """Put executable tasks that AI wrongly archived back on the bounded retry queue.

    blocked cannot become a graveyard that is never looked at again after diagnosis. Only tasks the contract explicitly marks
    human-gate, waiting_external, or unknown resource class need a human or external action;
    local/LLM blocked tasks return to pending after the retry window. Failure history is kept,
    and later work is still constrained by the selector, backoff, and quality gate.
    """
    resumed = []
    path = tasks_path(line)
    for task in load_tasks(line):
        if is_negative_test_sentinel(line, task):
            continue
        if task.get("status") != "blocked":
            continue
        if (task.get("next_advance_after") or "").strip() == "HOLD":
            continue
        if _resource_class_of(task) not in ("local-only", "llm-light", "llm-heavy"):
            continue
        window = parse_ts(task.get("next_advance_after"))
        if window is not None and window > now():
            continue
        if set_cells(path, task["id"], {
                "status": "pending", "next_advance_after": "-",
                "updated_at": fmt(now()),
        }, expected_status="blocked"):
            resumed.append(task["id"])
    if resumed:
        msg = "auto-resume %s: %s (executable block returns to bounded retry; failure history kept)" % (
            line, " ".join(resumed))
        print(msg)
        log(msg)
    return resumed


# -- select: heartbeat selection -- leverage descending + resource_class three-state filter --
# T2 (cortex-immune): the mechanical prevention point for the quota-ceiling crash that night. Before this layer, the heartbeat only
# took due_tasks()[0] when due, so row order was priority, and when quota was exhausted it still picked llm-heavy
# and hit the quota. Split out here as a pure-function subcommand (do not change the existing behavior of pick()). Any caller
# (wiring it into tick/next later is another task) can first ask "which one should run now".

LEVERAGE_RANK = {"high": 3, "medium": 2, "low": 1, "unknown": 0}
RESOURCE_CLASSES = ("local-only", "llm-light", "llm-heavy", "human-gate")


def _leverage_of(task):
    v = (task.get("leverage") or "").strip()
    return v if v in LEVERAGE_RANK else "unknown"


def _resource_class_of(task):
    """Empty-value semantics (TASKS.md, the three selection fields): a missing or illegal value is always unknown,
    and must never fall through to local-only -- falling through to local-only treats "unknown" as "safe",
    the dimensional collapse that the DIMENSIONAL law forbids."""
    v = (task.get("resource_class") or "").strip()
    return v if v in RESOURCE_CLASSES else "unknown"


def select_candidates(path):
    """Read any loop_tasks table (not limited to <line>/TASKS.md; for independent fixture tests).
    Candidates = pending + depends_on all done + in window (reuse the existing semantics of runnable(),
    consistent with due_tasks(), but does not depend on the line directory layout)."""
    _, _, rows = read_table(path)
    tasks = [r for _, r in rows if r.get("id")]
    out = []
    for task in tasks:
        if not runnable(tasks, task):
            continue
        window = parse_ts(task.get("next_advance_after"))
        if window is not None and window > now():
            continue
        out.append(task)
    return out


def select_task_rows(candidates, resource_state):
    """Return executable candidates sorted by value; the select CLI and tick share one criterion."""
    allowed = ({"local-only", "llm-light", "llm-heavy"}
               if resource_state == "ok" else {"local-only"})
    picks = [t for t in candidates if _resource_class_of(t) in allowed]
    picks.sort(key=lambda t: (-LEVERAGE_RANK[_leverage_of(t)], t["id"]))
    return picks


def cmd_select(args):
    """Heartbeat selection: print the chosen task id; print NONE when nothing is selectable. Always exit 0
    (NONE itself is a legal result, not a failure -- the caller decides whether to alert).

    Resource three-state: only `--resource-state ok` releases llm-light / llm-heavy;
    any other value (llm-exhausted / unknown / a value added later) fails closed,
    and only local-only is allowed. human-gate never enters the candidate set in any state (never started automatically).
    A missing or illegal resource_class becomes unknown. unknown belongs to no allow set,
    so it is never auto-selected (even when resources are plentiful) -- if it cannot be looked up, do not jump the start.
    """
    candidates = select_candidates(args.tasks)
    picks = select_task_rows(candidates, args.resource_state)
    if not picks:
        print("NONE")
        return 0
    # Within a resource tier, leverage descending; when leverage ties, stable sort by id ascending -- row order
    # does not decide priority. Starvation prevention is not this sort itself: real starvation prevention is that after selection the caller
    # must move status off pending (claim/running). That task then leaves the candidate pool,
    # and later tasks naturally come up. select is a stateless pure function; it does not remember who it picked last time across calls.
    print(picks[0]["id"])
    return 0


# -- health: the loop must be able to observe itself --------------------------------

def run(cmd, timeout=60):
    global _ACTIVE_CHILD_PROC
    proc = None
    try:
        # A shell command may spawn grandchild processes such as an executor, npm, or MCP. If subprocess.run on timeout
        # kills only the outer shell, orphans that still hold the stdout/stderr pipes are left behind, and communicate
        # never sees EOF; launchd looks running while the whole beat is stuck forever.
        # The same-task lock of task-run must be inherited by the adapter shell. If the outer Python is killed by launchd /
        # the terminal while a model grandchild is still alive, the kernel still holds the lock, and the next beat will not burn the same task twice.
        task_lock_fds = tuple(
            fh.fileno() for fh in _TASK_LOCK_HANDLES.values() if not fh.closed
        )
        proc = subprocess.Popen(
            cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, errors="replace", start_new_session=True,
            pass_fds=task_lock_fds,
        )
        _ACTIVE_CHILD_PROC = proc
        stdout, stderr = proc.communicate(timeout=timeout)
        return proc.returncode, (stdout or "") + (stderr or "")
    except subprocess.TimeoutExpired as exc:
        # A timeout must be restored to 124 (the GNU timeout convention code) and must not be mixed into 1.
        # This used to return 1 just like an ordinary failure -- and 1 is the usual code for grep/verify "WARN but
        # finished normally", so "timed out" and "finished and found nothing" were
        # completely indistinguishable on the caller side. Another fail-open: a stuck scanner disguised as a clean scan result.
        if proc is not None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                proc.kill()
            try:
                stdout, stderr = proc.communicate(timeout=5)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    proc.kill()
                stdout, stderr = proc.communicate()
            detail = (stdout or "") + (stderr or "")
        else:
            detail = ""
        return 124, detail + "\nTimeoutExpired: %s" % exc
    except KeyboardInterrupt:
        # A human interrupt of a maintenance command must also clear the whole process group; otherwise the outer Python exits and
        # gtimeout/claude children keep burning quota in the background and holding the result file.
        if proc is not None and proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                proc.kill()
        raise
    except Exception as exc:  # noqa: BLE001 -- a self-check must not turn silently green because of an exception
        if proc is not None and proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                proc.kill()
        return 1, str(exc)
    finally:
        if _ACTIVE_CHILD_PROC is proc:
            _ACTIVE_CHILD_PROC = None


def _forward_termination(signum, _frame):
    """When launchd/ops stops the parent, forward the signal to the current full child process group."""
    proc = _ACTIVE_CHILD_PROC
    if proc is not None and proc.poll() is None:
        try:
            os.killpg(proc.pid, signum)
        except (ProcessLookupError, PermissionError):
            proc.kill()
    raise SystemExit(128 + signum)


def cmd_health(args):
    """Driver self-check. **Red has a strict scope** -- only this node's own delivery/ledger capability may block progress.

    Positive definition (when a node should refuse to advance):
      **When continuing would necessarily produce a result the swarm cannot see or cannot trust.** Only three kinds:
        R1 delivery channel down  -- cannot land in git history -> necessarily creates a phantom completion (real1/R2 already measured)
        R2 ledger channel down  -- cannot read or write the swarm ref -> claim/write-back fails, duplicate work or lost results
        R3 this node's contract is inconsistent -- a line declared enabled has no TASKS.md
      What the three share: **this node can verify them deterministically** (git up or down is binary and does not jitter),
      and **the cause is direct** (if it is down, a bad result is certain).

    Negative (what must never block progress):
      The job error rate of an external orchestration layer (openclaw cron). It has no causal link to "can this node execute swarm tasks" --
      that is a monitoring signal of another subsystem. It should alert and become a task
      (scan_self_defects already does that). **It must not be a stop signal**.

    Why the split is required (two absurd consequences measured 2026-07-29):
      (1) The blinder it is, the more it can work: the old logic `if code == 0 and out.strip()` -- if openclaw cannot be reached
         it falls through to WARN and is judged GREEN; if it can be reached and honestly reports a fault, the result is RED. A node that cannot see a problem is allowed
         to work, and a node that can see it is forbidden to work. That is fail-open, exactly backwards.
      (2) Health jitters at random: `openclaw cron list` measured 39s on a worker, exit code 1,
         0 rows of data. The same machine and the same code: whether this external command succeeded this time decided whether the node
         was GREEN or RED this beat. The swarm right to start work was handed to a jittery external command.
      This is E005 in a new coat: the original fix was the distinction "delivery failure versus execution failure",
      and it did not fix the larger scope question "why can an unrelated subsystem halt the whole node".

    Three states, not two: an unreachable external dependency is UNVERIFIABLE. Report unknown honestly. Do not pretend it is OK
    and do not use it to go RED (copy the correct pattern probe_driver already has in this file).
    """
    red, notes = 0, []

    # -- blocking domain R1/R2: this node's delivery and ledger capability (deterministically self-checkable, no jitter) --
    code_g, _ = run("cd %s && git rev-parse --git-dir" % ROOT, timeout=60)
    if code_g != 0:
        notes.append("RED  | git on this node is unusable -> output cannot land in history, so advancing necessarily creates a phantom completion")
        red = 1
    else:
        # origin probe: the proxy chain is normally 2-4s; history has 75s timeouts and occasional failures from concurrent git locks.
        # Going RED on a single ls-remote failure hands the whole swarm advance gate to jitter (measured 2026-08-01:
        # launchd logs stayed green, then one beat went RED "cannot reach origin", and the next beat was green again).
        # 3 short retries: a real outage stays red; a lock/jitter does not kill the beat.
        code_r, last_err = 1, ""
        for attempt in range(3):
            code_r, last_err = run(
                "cd %s && git ls-remote --exit-code origin HEAD" % ROOT,
                timeout=90,
            )
            if code_r == 0:
                break
            if attempt < 2:
                time.sleep(2 * (attempt + 1))
        if code_r != 0:
            # Cannot reach the remote = claim and write-back both cannot be done; advancing means repeating work with eyes closed
            detail = (last_err or "").strip().split("\n")[-1][:120]
            notes.append(
                "RED  | cannot reach origin -> swarm ref cannot be read or written, so claim and write-back both fail"
                + ((" (%s)" % detail) if detail else "")
            )
            red = 1

    # -- alert domain: external orchestration layer (openclaw cron). Never red; only report three states --
    code, out = run("openclaw cron list 2>/dev/null")
    if code == 0 and out.strip():
        body = [l for l in out.split("\n") if re.search(r"^[0-9a-f]{8}-", l)]
        error_lines = [l for l in body if " error " in l]
        # Key distinction (triage evidence 2026-07-28): must separate "the work failed" from "the report failed".
        # 10 of 32 were error, and 7 of those were Telegram delivery failures -- the task had actually finished.
        # Treating a report failure as a work failure means one notification channel jitter can halt the whole self-healing system.
        #
        # Live evidence 2026-07-29 (the real cause of 4 hours of zero output on the worker): the distinction above **never took effect**.
        #   $ openclaw cron get <uuid>        # worker / OpenClaw 2026.4.26
        #   error: unknown command 'get'      # laptop / this subcommand exists only from 2026.6.11
        # So on the worker lastError could never be read -> `last` was always the empty string -> the empty string did not match the delivery regex
        # -> all 11/11 Telegram delivery failures were judged "real execution failures" -> 21% > 15% -> health stayed RED
        # -> `tick --auto` refused to advance every 15 minutes -> an always-on node took no task all morning.
        # The delivery-exemption branch was **dead code on that node and could never hit**. This is E012 cross-environment consistency.
        #
        # Two fixes:
        #   (1) The classification text is already on each `cron list` line (`... error isolated none -> telegram
        #      (Delivering to Telegram requires target ...`) -- every version has it, so judge from the line directly,
        #      and stop staking the correctness of the health judgment on "whether some subcommand exists on this machine";
        #   (2) When the reason cannot be read, record unknown and **do not count it as a real failure by default** -- a parse failure is our observation gap,
        #      not evidence of a driver fault; using a false positive to go RED gives an observation bug the power to halt the whole swarm.
        delivery_re = re.compile(
            r"OutboundDeliveryError|Refusing implicit.*delivery"
            r"|Delivering to \w+ requires|no route.*fail-closed", re.I)
        has_get = run("openclaw cron get --help >/dev/null 2>&1", timeout=15)[0] == 0
        if not has_get:
            notes.append("WARN | openclaw on this node has no `cron get` subcommand -> judge the cause from the cron list line instead")
        real, deliver, unknown = [], [], []
        for line_txt in error_lines:
            job_id = line_txt.split()[0]
            nm = re.match(r"^\S+\s+(.*?)\s+(?:cron|every)\s", line_txt)
            name = nm.group(1).strip() if nm else job_id[:8]
            # The text after the in-line ` error ` is the route/failure original, and it exists in every version
            tail = line_txt.split(" error ", 1)[1] if " error " in line_txt else ""
            last = ""
            if has_get:
                _, raw = run("openclaw cron get %s 2>/dev/null" % job_id, timeout=20)
                match = re.search(r'"lastError"\s*:\s*"(.*?)"', raw, re.S)
                if match:
                    last = match.group(1)
                name_match = re.search(r'"name"\s*:\s*"(.*?)"', raw)
                if name_match:
                    name = name_match.group(1)
            reason = last or tail          # prefer the precise reason; fall back to the in-line original if it cannot be read
            if delivery_re.search(reason):
                deliver.append((name, reason[:90]))
            elif reason.strip():
                real.append((name, reason[:90]))
            else:
                unknown.append((name, ""))
        ratio = (len(real) / len(body)) if body else 0
        # Note that this **no longer sets red** -- the error rate of an external orchestration layer is an alert, not a stop signal for this node.
        # A high error rate becomes a task to fix via scan_self_defects (make it work, not a wall).
        notes.append("%s | external orchestration layer openclaw: real execution failures %d/%d (%.0f%%) (alert domain, does not block progress)"
                     % ("WARN" if ratio > 0.15 else "OK", len(real), len(body), ratio * 100))
        for name, why in real:
            notes.append("      FAIL %s — %s" % (name, why))
        if deliver:
            notes.append("WARN | delivery degraded for %d items (the task ran, the notice was not delivered; does not block progress)" % len(deliver))
            for name, _ in deliver:
                notes.append("      DELIVERY %s" % name)
        if unknown:
            notes.append("WARN | reason unreadable for %d items (observation gap, not counted in the failure rate; do not use it to go RED)"
                         % len(unknown))
            for name, _ in unknown:
                notes.append("      UNKNOWN %s" % name)
    else:
        # Three states: if it cannot be reached, report UNVERIFIABLE honestly and do not pretend OK.
        # Measured on the worker: 39s / exit code 1 / 0 rows -- this command is both slow and unstable,
        # which is exactly why it must not have the power to decide whether the node starts work. Report unknown, then keep working.
        notes.append("UNVERIFIABLE | openclaw cron unreachable or no data (exit code %d)"
                     " -- external orchestration layer status unknown; label unknown honestly, do not pretend healthy, and do not use it to block progress" % code)

    me = node_id()
    for entry in clock_lines():
        line = entry["line"]
        if entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
            continue
        owner = entry.get("owner") or ""
        if owner not in ("", "-", me):
            continue                      # same rule as reconcile/tick: health-check only lines this node owns
        path = tasks_path(line)
        if not os.path.isfile(path):
            notes.append("RED  | %s is declared enabled but has no TASKS.md" % line)
            red = 1
            continue
        stalled = [t for t in load_tasks(line)
                   if t.get("status") == "running"
                   and (parse_ts(t.get("updated_at")) or now()) < now() - timedelta(hours=6)]
        if stalled:
            notes.append("WARN | %s has %d running items not updated for over 6h (execution may be asleep)"
                         % (line, len(stalled)))

    print("\n".join(notes) if notes else "OK   | no anomalies")
    print("\nHEALTH: %s" % ("RED (delivery/ledger capability on this node is damaged -> tick --auto refuses to advance)"
                           if red else "GREEN (blocking domain all green; alert domain is above and does not block progress)"))
    return 1 if red else 0


# -- reconcile: declared versus actual; a split between name and reality cannot hide --

def probe_driver(driver):
    """Return (state, explanation). state is one of OK / DRIFT / UNVERIFIABLE / SKIP.

    Key distinction: **"I cannot detect" is not "I detected drift"**.
    The original implementation only recognized launchd, and launchctl is a macOS-only binary -- always empty on a Linux node,
    so every launchd driver was rendered as DRIFT. Reporting "unknown" as "broken" is worse than not reporting.
    """
    kind, _, name = driver.partition(":")
    if not name:
        return "DRIFT", "driver declared no concrete identifier"
    if kind == "launchd":
        if run("command -v launchctl", timeout=10)[0] != 0:
            return "UNVERIFIABLE", "this node has no launchctl (not macOS); cannot verify"
        uid = run("id -u", timeout=10)[1].strip()
        code, _ = run(
            "launchctl print %s 2>/dev/null" % shlex.quote("gui/%s/%s" % (uid, name)),
            timeout=10,
        )
        return ("OK", "loaded") if code == 0 else \
               ("DRIFT", "launchctl print found no such label")
    if kind == "systemd":
        if run("command -v systemctl", timeout=10)[0] != 0:
            return "UNVERIFIABLE", "this node has no systemctl; cannot verify"
        _, out = run("systemctl --user list-timers --all 2>/dev/null; "
                     "systemctl --user list-units --all 2>/dev/null", timeout=30)
        return ("OK", "running") if name in out else ("DRIFT", "systemd found no such unit")
    if kind == "openclaw":
        code, out = run("openclaw cron list 2>/dev/null", timeout=60)
        if code != 0:
            return "UNVERIFIABLE", "openclaw unreachable; cannot verify"
        return ("OK", "running") if name in out else ("DRIFT", "openclaw found no such job")
    return "UNVERIFIABLE", "unknown driver type %s" % kind


def cmd_reconcile(args):
    drift = 0
    me = node_id()
    print("| line | declared driver | verdict | note |")
    print("|----|----------|------|------|")
    for entry in clock_lines():
        driver = entry.get("driver", "-")
        line = entry["line"]
        if entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
            print("| %s | %s | SKIP | disabled (not drift) |" % (line, driver))
            continue
        owner = entry.get("owner") or ""
        # Judge only lines this node owns. tick is owner-aware and reconcile was not -- one CLOCK,
        # two readings = the engine is internally inconsistent, and a node would report red for a line it does not own.
        if owner not in ("", "-", me):
            print("| %s | %s | SKIP | owned by %s; this node does not judge |" % (line, driver, owner))
            continue
        state, why = probe_driver(driver)
        if state == "DRIFT":
            drift += 1
        mark = {"OK": "OK", "DRIFT": "**decoupled DRIFT**", "UNVERIFIABLE": "⚠️ cannot verify"}[state]
        print("| %s | %s | %s | %s |" % (line, driver, mark, why))
    print("\nDRIFT: %d" % drift)
    return 1 if drift else 0


# ── next / submit / try-complete ───────────────────────────────────────

def render_prompt(line, task, executor=None):
    intent_path = os.path.join(DIRECTIONS, line, "INTENT.md")
    intent = ""
    if os.path.isfile(intent_path):
        with open(intent_path, encoding="utf-8") as fh:
            intent = fh.read()
    retry_context = ""
    try:
        fails = int(task.get("fails") or 0)
    except ValueError:
        fails = 0
    if fails > 0:
        result_path = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task["id"])
        previous = ""
        if os.path.isfile(result_path):
            with open(result_path, encoding="utf-8", errors="replace") as fh:
                previous = fh.read()[-1600:]
        retry_context = "\n".join([
            "",
            "## Repair mode (continuation after failure %d)" % fails,
            "Known failure modes: %s" % (task.get("failure_modes") or "not declared"),
            "End of the previous receipt:",
            previous.strip() or "(no previous receipt on this machine; run the acceptance command first to get the real red items)",
            "Reproduce the current red items and locate the root cause first; do not repeat the same path and only edit the explanation.",
        ])
    body = "\n".join([
        "You are the cortex-loop executor. This is one automatic advance. Nobody is beside you. There is no one to ask.",
        "",
        "## Direction intent",
        intent.strip(),
        "",
        "## The only task this round",
        "id: %s" % task.get("id"),
        "title: %s" % task.get("title"),
        "Completion standard: %s" % task.get("success_criteria"),
        "Files you must produce: %s" % task.get("artifact_paths"),
        "Acceptance command: %s" % task.get("short_test"),
        "Known failure modes: %s" % (task.get("failure_modes") or "not declared"),
        retry_context,
        "",
        "## Hard rules",
        "1. Do only this one task. Do not do anything else along the way.",
        "2. The result must be written into the output file above; no file = this round does not count.",
        "3. Do not declare yourself done -- completion is judged independently by cortex-loop try-complete. You saying it does not count.",
        "4. If you cannot finish, write the reason into the output file and say what is missing. Do not pretend to advance.",
        "5. Do not change the acceptance command, do not loosen the completion standard, and do not use `|| true`.",
        "",
        "## What to hand back",
        "One plain-text block: what this round did / which files were written / what is still missing.",
    ])
    # The acp-lane adapter reads header fields topic/backend/cwd (body is after ---)
    if executor == "acp-lane":
        topic = (task.get("id") or "acp-loop").replace(" ", "-")
        backend = (os.environ.get("CORTEX_ACP_BACKEND") or "grok").strip() or "grok"
        cwd = (os.environ.get("CORTEX_ACP_CWD") or "/tmp/grok-scratch").strip()
        # Do not use the vault root as cwd (the client blocks it again too)
        if os.path.abspath(cwd) == os.path.abspath(ROOT):
            cwd = "/tmp/grok-scratch"
        sim = (os.environ.get("CORTEX_ACP_SIMULATE") or "").strip()
        headers = [
            "topic=%s" % topic,
            "backend=%s" % backend,
            "cwd=%s" % cwd,
        ]
        if sim in ("1", "true", "yes"):
            headers.append("simulate=1")
        return "\n".join(headers + ["---", body])
    return body


def pick(line, task_id=None):
    tasks = load_tasks(line)
    if task_id:
        for task in tasks:
            if task["id"] == task_id:
                return task
        return None
    candidates = due_tasks(line)
    return candidates[0] if candidates else None


def run_adapter(executor, tag, prompt_text, timeout=300):
    """The only channel that calls an LLM. Returns the executor text output (empty string on failure).

    Where the SHIFT law lands: code does structure (window / reconcile / judgment), AI does analysis (decompose / diagnose / judge quality).
    Iron rule: no return value of this function may **directly** become status -- AI has veto power and no approval authority.
    """
    adapter = executor_adapter_path(executor)
    if not os.path.isfile(adapter):
        return ""
    os.makedirs("/tmp/spotlight", exist_ok=True)
    prompt_file = "/tmp/spotlight/cortex-loop-%s.prompt" % tag
    result_file = "/tmp/spotlight/cortex-loop-%s.result" % tag
    with open(prompt_file, "w", encoding="utf-8") as fh:
        fh.write(prompt_text)
    tier, model, why = pick_model()
    env = "CORTEX_MODEL=%s " % model if model else ""
    # Pass the node identity the engine already computed through to the adapter (for example minimax.sh picks key order by node),
    # so the adapter does not guess the hostname again and split from the engine node_id() into two sources of truth.
    env += "CORTEX_NODE=%s " % node_id()
    if tier and tier != "balanced":
        print("      model tier: %s (%s) -- %s" % (tier, model or "local", why))
    code, _ = run("%sbash %s %s %s" % (env, adapter, prompt_file, result_file), timeout=timeout)
    if not os.path.isfile(result_file):
        return ""
    with open(result_file, encoding="utf-8", errors="replace") as fh:
        text = fh.read()
    # Caught on a live run: when the adapter hits API 502 / a broken gateway, the non-zero exit code was swallowed here,
    # and ai_judge only looked for the text "REJECT". An error message (with no REJECT) was treated as
    # ACCEPT -- the independent verifier fail-opened and approved a false completion when the verifier itself was down.
    # Add a detectable prefix so callers (especially ai_judge) can tell "the review really passed" from
    # "the verifier itself never started".
    if code != 0:
        text = "[ADAPTER_FAILED rc=%d]\n%s" % (code, text)
        # Caught on a live run (a 4-hour unattended window): the same executor hit 403 auth failure and retried
        # 7 times in a row, never switched automatically and never went quiet -- because exec_suppressed takes effect only on a manual
        # revive, and run_adapter detected the failure but never called it. That is not self-healing.
        # It is blindly retrying the same broken thing. Fill the gap here: on adapter failure, classify the root cause and suppress immediately,
        # so the next discover beat will not advertise this capability and will route to another executor or wait quietly for the window to expire.
        low = text.lower()
        if re.search(r"401|403|unauthorized|authenticat|token.*expired|invalid.*api.?key",
                    low):
            suppress_exec(executor, "auth")
            print("      ⛔ %s auth failure -> auto-suppress for 12 hours (no more blind retries)" % executor,
                  file=sys.stderr)
        elif re.search("quota|rate.?limit|usage limit|credit|exceeded|\u989d\u5ea6|\u8d85\u9650", low):
            suppress_exec(executor, "quota")
            record_model_quota_if_breach(
                "adapter", tag, executor, text, "adapter-quota")
            print("      ⛔ %s quota exhausted -> auto-suppress for %d hours (rejoins automatically after the window resets)"
                  % (executor, QUOTA_WINDOW_H), file=sys.stderr)
        # T20 item 3: "all keys failed" for cheap/minimax/glm must trigger self-healing, not only a warning.
        # cheap.sh failure codes: rc=89 (no ccswitch account) / rc=97 (all keys failed) / rc=98 (orchestration layer down)
        # minimax/glm failure codes: rc=89 (no key) / rc=97 (all keys failed)
        elif executor in CHEAP_ADAPTER_PROVIDERS and \
                re.search("rc=97|rc=98|rc=89|\u5168\u90e8.*\u4e2a.*key.*\u5931\u8d25|\u5168\u90e8.*\u4e2a.*\u8d26\u53f7.*\u5931\u8d25|"
                          "no-ccswitch-account|no.*key.*\u914d\u7f6e|\u65e0\u53ef\u7528.*key", low):
            # Orchestration-layer failure (cheap itself is down) -> auth; the layer below fully exhausted -> quota.
            # Simplified: classify as quota (the most common root cause, and quota expiry will not mis-suppress).
            suppress_exec(executor, "quota")
            record_model_quota_if_breach(
                "adapter", tag, executor, text, "adapter-key-pool")
            print("      ⛔ %s all keys failed (orchestration layer or the layer below exhausted) -> suppress for %d hours (triggers self-healing, no longer warn-only)"
                  % (executor, QUOTA_WINDOW_H), file=sys.stderr)
    # T11 item 3: record the real executor used this session (solo_or_swarm() and cmd_checkin() update executors dynamically)
    _state = _load_exec_state()
    _ex_state = _state.get(executor, {})
    _ex_state["last_used"] = fmt(now())
    _state[executor] = _ex_state
    _save_exec_state(_state)
    return text


# -- AI mount point 1: decompose (intent -> task rows) ---------------------------
# This is the key to "given an intent and a direction, advance on its own": without it, TASKS still has to be written by hand.

DECOMPOSE_COLS = ["id", "title", "status", "depends_on", "success_criteria",
                  "failure_modes", "artifact_paths", "short_test",
                  "next_advance_after", "fails", "updated_at", "evidence"]


def cmd_decompose(args):
    line = args.line
    intent_path = os.path.join(DIRECTIONS, line, "INTENT.md")
    if not os.path.isfile(intent_path):
        print("no INTENT.md; write the intent first", file=sys.stderr)
        return 1
    with open(intent_path, encoding="utf-8") as fh:
        intent = fh.read()
    existing = load_tasks(line)
    executor = next((e.get("executor", "human") for e in clock_lines()
                     if e["line"] == line), "human")

    prompt = "\n".join([
        "Split the direction intent below into executable, verifiable subtasks.",
        "",
        intent.strip(),
        "",
        "Existing tasks (do not repeat them; only fill gaps):",
        "\n".join("- %s %s [%s]" % (t["id"], t.get("title"), t.get("status"))
                  for t in existing) or "(empty)",
        "",
        "## Output format (strict)",
        "Output only markdown table rows, 11 columns each, separated by |, no header and no explanation:",
        "| " + " | ".join(DECOMPOSE_COLS) + " |",
        "",
        "## Hard constraints (a violating row is discarded mechanically)",
        "1. status is always pending",
        "2. success_criteria (what counts as done) and failure_modes (what counts as cheating/failure) must both be filled; do not leave -",
        "3. artifact_paths must be vault-relative paths, and one task has at least one output file",
        "4. short_test must be a script path of the form `bash bin/cortex-loop-tests/<line>-<id>.sh`,",
        "   do not write a pipeline command; and you must actually write that script",
        "5. a cell must not contain the | character",
        "6. next_advance_after and evidence are -, fails is 0, updated_at is today date",
        "7. split into 3-6 items; fewer is better than too many; if you cannot split, split less",
    ])

    out = run_adapter(executor, "decompose-%s" % line, prompt)
    if not out.strip():
        print("executor produced no output (executor=%s)" % executor)
        return 1

    # Structural check of AI output: a row with missing fields or an illegal value is discarded mechanically
    accepted, rejected = [], []
    for raw in out.split("\n"):
        raw = raw.strip()
        if not raw.startswith("|") or raw.count("|") < 11:
            continue
        cells = [c.strip() for c in raw.strip("|").split("|")]
        if len(cells) != len(DECOMPOSE_COLS) or cells[0].lower() == "id":
            continue
        row = dict(zip(DECOMPOSE_COLS, cells))
        bad = [f for f in ("id", "title", "success_criteria", "failure_modes",
                           "artifact_paths", "short_test")
               if not row[f] or row[f] == "-"]
        if row["status"] != "pending":
            bad.append("status")
        if row["id"] in {t["id"] for t in existing}:
            bad.append("duplicate id")
        if bad:
            rejected.append((row.get("id", "?"), ",".join(bad)))
            continue
        accepted.append(raw)

    proposal = os.path.join(DIRECTIONS, line, "TASKS.proposed.md")
    with open(proposal, "w", encoding="utf-8") as fh:
        fh.write("<!-- AI decompose proposal %s | passed structural check %d rows / discarded %d rows -->\n%s\n"
                 % (fmt(now()), len(accepted), len(rejected), "\n".join(accepted)))
    for task_id, why in rejected:
        print("discarded %s: %s" % (task_id, why))

    if not accepted:
        print("no acceptable task rows -> not written to the ledger (proposal left at %s)" % proposal)
        return 1
    if not args.apply:
        print("proposal of %d rows written to %s; after confirmation add --apply to merge into the ledger" % (len(accepted), proposal))
        return 0

    path = tasks_path(line)
    with open(path, encoding="utf-8") as fh:
        content = fh.read()
    marker = "\n## \u5b57\u6bb5\u89c4\u77e9"
    body = "\n".join(accepted) + "\n"
    content = content.replace(marker, body + marker, 1) if marker in content else content + body
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(content)
    log("decompose %s applied=%d rejected=%d" % (line, len(accepted), len(rejected)))
    print("merged %d rows into the ledger (discarded %d)" % (len(accepted), len(rejected)))
    return 0


# -- AI mount point 2: quality veto (can refuse, cannot approve) ----------------

def pick_verifier(worked_executor, prof, nodes=None):
    """Pick a verifier whose **identity differs from the executor**.

    Epiplexity axiom 1: information value is a function of the observer constraints.
    The same observer judging its own output has **constraints and blind spots that coincide completely** -- what it cannot see
    it still cannot see from another angle of the same view. So "whoever did it verifies it" fails structurally,
    not as an attitude problem, but as an information-theory problem.

    Priority: a different model on another node (largest blind-spot difference) > a different executor on the same node > **if there is none, say there is none**.
    When no independent verifier can be found, **never pad with the same one** -- fake independence is more dangerous than none,
    because it makes people think the work was already verified.

    Returns (executor, node, independence tier).
    """
    nodes = nodes if nodes is not None else read_swarm()
    me = prof.get("node")
    worked_model = next((c for c in (prof.get("caps") or "").split()
                         if c.startswith("model.")), "")
    # Tier 1: another node, and a different model -- the largest blind-spot difference
    for name, other in sorted(nodes.items()):
        if name == me or not node_alive(other)[0]:
            continue
        other_caps = (other.get("caps") or "").split()
        other_model = next((c for c in other_caps if c.startswith("model.")), "")
        if other_model and other_model != worked_model:
            for ex in ("claude", "codex", "openclaw"):
                if "exec.%s" % ex in other_caps:
                    return ex, name, "cross-node different model"
    # Tier 2: a different executor on this node -- at least not the same process and the same context
    for ex in ("codex", "claude", "openclaw", "ollama"):
        if ex != worked_executor and "exec.%s" % ex in (prof.get("caps") or ""):
            return ex, me, "same-node different executor"
    return None, None, "no independent verifier"


def _paths_outside_bounds(paths, bounds):
    """Return the paths in `paths` that **really fall outside bounds**. Empty bounds = no boundary = all count as inside."""
    bs = [b for b in (bounds or "").split() if b]
    if not bs:
        return []
    return [p for p in paths if not any(p.startswith(b) for b in bs)]


def ai_judge(line, executor, task):
    """The second gate after the mechanical gate has passed: an independent AI quality judgment.

    Returns (verdict, reason), verdict in {ACCEPT, REJECT, SCOPE}.

    Live root cause on 2026-07-29 (21/25 results all fell here): the caller filled `success_criteria`
    directly with `task["title"]`, and title is a vision headline ("hang island skill X into the
    host tree (network connectivity)"). The verifier **had no objective criterion in hand**, so it invented
    a maximal reading, then stacked the "prefer REJECT" rule below, and rejected 6 tasks in a row that had **already passed the mechanical gate**,
    all with the same reason "still need to edit SKILLS-TAXONOMY.md / the host SKILL.md" --
    those paths were **all outside the task bounds**, and if the executor complied it would be recorded as a C1 out-of-bounds violation.
    The two gates contradicted each other: what C1 forbids is exactly what the verifier required.

    This is not "the gate is too strict". The **gate has no criterion** (under-defined). The fix is to hand it the criterion, not to loosen it:
      (1) hand the verifier both `short_test` (the real mechanical criterion) and `bounds` (the authorized boundary);
      (2) unfold a third state SCOPE -- the real world has three states of different kinds here:
           ACCEPT the work inside the boundary is good / REJECT the work inside the boundary was not done well / SCOPE the work inside the boundary is done but the task definition itself is too narrow.
         SCOPE is not a synonym of "let it through". It requires the verifier to **name the specific missing paths**,
         and code then mechanically checks that those paths really are outside bounds; if any one falls inside,
         downgrade to REJECT immediately (so the verifier cannot use SCOPE as a free pass).
    """
    artifacts = [a for a in (task.get("artifact_paths") or "").split() if a]
    excerpt = ""
    for rel in artifacts[:2]:
        full = rel if os.path.isabs(rel) else os.path.join(ROOT, rel)
        if os.path.isfile(full):
            with open(full, encoding="utf-8", errors="replace") as fh:
                excerpt += "\n### %s\n%s\n" % (rel, fh.read()[:3000])
    bounds = (task.get("bounds") or "").strip()
    short_test = (task.get("short_test") or "").strip()
    prompt = "\n".join([
        "You are an independent verifier, not the executor. You did not do this work. You only look at the output.",
        "",
        "Task: %s" % task.get("title"),
        "Completion standard: %s" % task.get("success_criteria"),
        "Mechanical criterion (already run independently and passed): %s" % (short_test or "(none)"),
        "Authorized bounds (the executor may change files only under these paths; going outside is recorded as a violation): %s"
        % (bounds or "(unbounded)"),
        "Cheating patterns (named): %s" % task.get("failure_modes"),
        "",
        "Output content:", excerpt or "(could not read the content)",
        "",
        "## Separate three cases before judging",
        "1. What should be done inside the boundary was done, and the substance is not boilerplate -> ACCEPT",
        "2. What should be done inside the boundary was not done well / vague / boilerplate / a 'suspected' used as a conclusion -> REJECT",
        "3. What should be done inside the boundary really was all done, but you believe that to actually reach the goal of the task title,"
        " files **outside** bounds must also be changed -> this is **a task definition that is too narrow**, not the executor fault."
        " Reply SCOPE and list each missing file path.",
        "Note: the executor is hard-forbidden from changing files outside bounds,",
        "so 'it did not change X outside bounds' is never a REJECT reason.",
        "",
        "## Reply with one line only",
        "ACCEPT   or   REJECT: <one sentence on why the work inside the boundary was not done well>   or   "
        "SCOPE: <missing paths outside bounds, space-separated> | <one sentence>",
        "Inside the boundary, prefer REJECT.",
    ])
    out = run_adapter(executor, "judge-%s-%s" % (line, task["id"]), prompt, timeout=600).strip()
    # Fail closed, not fail open: the verifier itself never started (gateway 502 / timeout / adapter non-zero exit)
    # is not "the content is fine". Caught once on a live run: claude-sonnet-5 hit 502 and the output was an
    # error message (no REJECT text). The old logic treated it as ACCEPT and let a false completion through.
    if out.startswith("[ADAPTER_FAILED") or not out:
        return "REJECT", "verifier did not run normally (%s) -- if it cannot be seen, it does not pass; this is not a default let-through"\
            % (out.split("\n")[0][:120] if out else "no output")
    return _judge_verdict_from_text(out, bounds)


def _judge_verdict_from_text(out, bounds):
    """Judge the verifier free text into three states, **and mechanically check that the label it chose is right**.

    Pulled out as a pure function so negative tests can call it directly -- the judgment logic is the link on the whole chain most likely
    to degrade quietly (already measured twice today). It must be regressible at zero cost,
    and must not require a real model call every time it is checked.
    """
    first = out.split("\n")[0]
    up = out.upper()
    if up.startswith("SCOPE") or "\nSCOPE:" in up:
        line_scope = first if first.upper().startswith("SCOPE") else \
            next((l for l in out.split("\n") if l.upper().startswith("SCOPE")), first)
        body = line_scope.split(":", 1)[1] if ":" in line_scope else ""
        listed = [tok.strip().strip("`,;") for tok in
                  body.split("|")[0].replace(",", " ").split() if "/" in tok]
        if not listed:
            return "REJECT", "verifier replied SCOPE but named no path outside bounds -> counted as not acceptable: %s" % first[:160]
        inside = [p for p in listed if p not in _paths_outside_bounds(listed, bounds)]
        if inside:
            # The named path is actually inside the boundary -> the executor should have done it and did not -> this is REJECT, not SCOPE
            return "REJECT", "verifier calls it out of scope, but %s is inside bounds -> not finished inside the boundary" % " ".join(inside[:3])
        return "SCOPE", line_scope[:200]
    if up.startswith("REJECT") or "\nREJECT" in up:
        # [Why this does **not** relabel for the verifier -- a fix that was overturned, left here so it does not recur]
        # On 2026-07-29 I added here "if every REJECT reason points outside bounds -> mechanically rejudge as SCOPE".
        # The basis was that the 13:34 beat was still REJECT in measurement. **But that beat ran the pre-fix code** --
        # the log string `-> failed (mechanical gate refused)` does not exist in the current code at all (checked with
        # `cortex-probe.sh text-in-file`, 0 hits). It is a string from an old version.
        # The premise did not hold, so the rejudge logic was void and has been withdrawn.
        #
        # The real evidence points the other way: the same output and the same worker verifier,
        # REJECT at 11:09 -> ACCEPT at 13:41 (only because the criterion changed from title to short_test);
        # the first live beat of the new code at 14:26 was 2/2 gate=passed.
        # That is: **handing the verifier an objective criterion is enough. Do not relabel for it afterward.**
        #
        # Lesson (worth more than this bug): before using a log to judge "did the fix take effect",
        # first confirm which version of the code wrote that log -- close timestamps are not the same version.
        # Relabeling for the AI is a hidden form of **loosening the gate**: it turns "the verifier said no" into
        # "the system says it is actually yes", and the red line today is that the gate must not be loosened in any case.
        return "REJECT", first[:200]
    return "ACCEPT", first[:200]


# -- AI mount point 3: stuck diagnosis (wake only on a losing streak, do not ask every round) --

def ai_diagnose(line, executor, task, fails, failure=None):
    # [E-2026-10-05 write amplification] Losing-streak diagnosis used to run every beat, and every run appended the whole adapter output
    # into JOURNAL.md -- during an island-task losing streak it dumped 574 entries a day, and in two months grew
    # cortex-immune JOURNAL.md to 10.2MB / 91k lines, dragging the Obsidian vault index to death
    # (the UI "Indexing taking a long time" named that file; rotated 2026-10-05).
    # Changed to milestone throttling: diagnose every beat for the first 3, then once every 25;
    # the losing-streak count itself keeps accumulating in the TASKS.md fails field. Throttling only cuts repeated dumps and does not drop the signal.
    if fails > 3 and fails % 25 != 0:
        print("diagnosis skipped | %s/%s fails=%d (milestone throttle: after 3, once every 25)"
              % (line, task["id"], fails))
        return ""
    failure = failure or load_failure_context(line, task["id"])
    prompt = "\n".join([
        "An auto-advancing task has failed %d times in a row. Diagnose it." % fails,
        "",
        "Task: %s" % task.get("title"),
        "Completion standard: %s" % task.get("success_criteria"),
        "Acceptance command: %s" % task.get("short_test"),
        "Output should be at: %s" % task.get("artifact_paths"),
        "Real failure stage: %s" % (failure.get("stage") or "unknown"),
        "Real failure exit code: %s" % (failure.get("rc") if failure.get("rc") is not None else "unknown"),
        "Real failure output: %s" % (failure.get("detail") or "not captured"),
        "",
        "## Reply with three lines only",
        "Root cause: <one sentence>",
        "What to change: <change the task split / change the acceptance method / missing external resource; pick one and say it clearly>",
        "Suggested status: <pending keep retrying | blocked needs a human | waiting_external wait for the outside>",
        "Do not say 'try once more and see'.",
    ])
    out = run_adapter(executor, "diagnose-%s-%s" % (line, task["id"]), prompt, timeout=600)
    journal = os.path.join(DIRECTIONS, line, "JOURNAL.md")
    with open(journal, "a", encoding="utf-8") as fh:
        fh.write("\n## %s | %s losing streak %d | AI diagnosis\n\n%s\n"
                 % (fmt(now()), task["id"], fails, out.strip()[:6000] or "(no output)"))
    # Diagnosis text is not a state-machine event. The old implementation permanently removed a task from the candidate pool whenever the free text contained blocked /
    # waiting_external; and the prompt itself contains those two words,
    # so the same failing executor could "diagnose the task into the graveyard". AI only supplies a root-cause hypothesis.
    # The mechanical retry queue keeps owning progress; a real need for a human or external action must be decided by an explicit task-hold
    # or the contract human-gate.
    print("diagnosis written to JOURNAL; %s stays on the mechanical backoff queue and is not moved by model text" % task["id"])
    return out


def cmd_judge(args):
    executor = next((e.get("executor", "human") for e in clock_lines()
                     if e["line"] == args.line), "human")
    task = pick(args.line, args.task)
    if not task:
        return 1
    verdict, reason = ai_judge(args.line, executor, task)
    print("%s: %s" % (verdict, reason))
    return 1 if verdict == "REJECT" else 0


def cmd_next(args):
    task = pick(args.line, args.task)
    if not task:
        print("idle — %s has no runnable task in window" % args.line, file=sys.stderr)
        return 1
    if args.claim:
        if not set_cells(tasks_path(args.line), task["id"], {
                "status": "running", "updated_at": fmt(now()),
        }, expected_status="pending"):
            print("idle — %s/%s has already been claimed by another Worker" % (args.line, task["id"]),
                  file=sys.stderr)
            return 1
        log("claim %s/%s" % (args.line, task["id"]))
    print(render_prompt(args.line, task))
    return 0


def _task_or_error(line, task_id):
    task = next((t for t in load_tasks(line) if t["id"] == task_id), None)
    if task is None:
        print("task not found %s/%s" % (line, task_id), file=sys.stderr)
    return task


def cmd_task_list(args):
    tasks = load_tasks(args.line)
    if args.status:
        tasks = [t for t in tasks if t.get("status") == args.status]
    if args.json:
        print(json.dumps(tasks, ensure_ascii=False, indent=2))
        return 0
    print("%-8s %-18s %-6s %-5s %s" % ("id", "status", "fails", "class", "title"))
    for task in tasks:
        print("%-8s %-18s %-6s %-5s %s"
              % (task["id"], task.get("status", "-"), task.get("fails", "0"),
                 task.get("resource_class", "-"), task.get("title", "-")))
    return 0


def cmd_task_ledger(args):
    """Delegate to bin/cortex-loop-task-ledger (an atomic tool, so this file does not copy the ledger logic again)."""
    script = os.path.join(ROOT, "bin", "cortex-loop-task-ledger")
    cmd = [sys.executable, script]
    if getattr(args, "json", False):
        cmd.append("--json")
    section = getattr(args, "section", None) or "all"
    cmd.extend(["--section", section])
    if getattr(args, "line", None):
        cmd.extend(["--line", args.line])
    code, out = run(" ".join(shlex.quote(c) for c in cmd), timeout=180)
    if out:
        print(out.rstrip())
    return code


def _local_settlement_artifact(rel):
    """Read-only check of one artifact local commit and cached propagation binding.

    A diagnostic command never implicitly fetches, pushes, or reruns short_test. When the origin tracking ref misses,
    it may only report UNKNOWN; "this machine cannot see it right now" must not be collapsed into "the remote certainly does not have it".
    """
    return _inspect_artifact_canonical_binding(rel, refresh=False)


def task_settlement_contract(line, task):
    """Stable single-task settlement diagnostic contract; read-only, runs no commands, changes no refs."""
    artifacts = [p for p in (task.get("artifact_paths") or "").split() if p != "-"]
    inspected = [_local_settlement_artifact(path) for path in artifacts]
    if not artifacts:
        blocker = "task contract has no artifact_paths"
        propagation_state = "BLOCKED"
    elif any(a["local"]["state"] == "NO" or a["commit"]["state"] == "NO"
             for a in inspected):
        blocker = next(
            a["local"]["detail"] if a["local"]["state"] == "NO"
            else a["commit"]["detail"] for a in inspected
            if a["local"]["state"] == "NO" or a["commit"]["state"] == "NO"
        )
        propagation_state = "BLOCKED"
    elif inspected and all(a["canonical"]["state"] == "YES" for a in inspected):
        blocker = ""
        propagation_state = "LANDED"
    elif inspected and any(a["canonical"]["state"] == "NO" for a in inspected):
        blocker = "candidate has propagated; waiting for the integrator to merge into canonical"
        propagation_state = "SETTLING"
    else:
        blocker = "the local cache is not enough to prove origin/canonical propagation; run the sync/fetch atomic tool first"
        propagation_state = "UNKNOWN"

    short_test = (task.get("short_test") or "").strip()
    if short_test in ("", "-"):
        short_test_state = "BLOCKED"
        short_test_detail = "task contract has no short_test"
    elif task.get("status") in ("settling", "done"):
        short_test_state = "RECORDED_PASS"
        short_test_detail = "recorded by task-status semantics; this read-only diagnosis did not rerun the command"
    else:
        short_test_state = "UNKNOWN"
        short_test_detail = "this read-only diagnosis did not execute the command"
    return {
        "schema_version": "cortex-loop/task-settlement-v1",
        "line": line,
        "task_id": task.get("id"),
        "status": task.get("status", "UNKNOWN"),
        "artifact_paths": inspected,
        "short_test": {
            "command": short_test or "-",
            "state": short_test_state,
            "detail": short_test_detail,
        },
        "propagation": {
            "state": propagation_state,
            "canonical_ref": canonical_origin_ref(),
            "blocker": blocker,
        },
    }


def _print_task_human(line, task):
    print("%s/%s  [%s]" % (line, task.get("id", "-"), task.get("status", "UNKNOWN")))
    print("title: %s" % task.get("title", "-"))
    print("output: %s" % task.get("artifact_paths", "-"))
    print("acceptance: %s" % task.get("short_test", "-"))
    print("updated: %s | fails %s" % (task.get("updated_at", "-"), task.get("fails", "0")))


def _print_settlement_human(contract):
    print("settlement diagnosis: %s" % contract["propagation"]["state"])
    for item in contract["artifact_paths"]:
        print("· %s" % item["path"])
        print("  local %s | commit %s | origin %s | canonical %s" % (
            item["local"]["state"], item["commit"]["state"],
            item["origin"]["state"], item["canonical"]["state"],
        ))
        if item["commit"].get("candidate_oid"):
            print("  candidate %s · landed %s" % (
                item["commit"]["candidate_oid"][:12],
                (item["canonical"].get("landed_oid") or "-")[:12],
            ))
    print("short test: %s | %s" % (
        contract["short_test"]["state"], contract["short_test"]["command"]))
    if contract["propagation"]["blocker"]:
        print("blocker: %s" % contract["propagation"]["blocker"])


def cmd_task_show(args):
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    settlement = task_settlement_contract(args.line, task) if args.settlement else None
    if args.json:
        payload = {
            "schema_version": "cortex-loop/task-show-v1",
            "line": args.line,
            "task": task,
        }
        if settlement is not None:
            payload["settlement"] = settlement
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    _print_task_human(args.line, task)
    if settlement is not None:
        _print_settlement_human(settlement)
    return 0


def cmd_run_contract(args):
    """Read one frozen attempt as the canonical cross-surface run contract."""
    try:
        contract = _read_run_contract(
            args.line, args.task, args.run_id, source_surface=args.source_surface
        )
    except ValueError as exc:
        print(json.dumps({
            "ok": False,
            "schema_version": RUN_CONTRACT_SCHEMA,
            "error": str(exc),
        }, ensure_ascii=False, indent=2))
        return 1
    print(json.dumps(contract, ensure_ascii=False, indent=2))
    return 0


def _clean_task_cell(name, value):
    value = (value or "").strip()
    if "|" in value or "\n" in value or "\r" in value:
        raise ValueError("%s must not contain a vertical bar or a newline" % name)
    return value


def cmd_task_add(args):
    """Generate a task row atomically from the header; if the contract gate fails, roll back immediately. Do not hand-assemble Markdown columns."""
    path = tasks_path(args.line)
    lines, header, rows = read_table(path)
    if not header or not rows:
        print("task ledger does not exist or has no recognizable data table: %s" % path, file=sys.stderr)
        return 1
    existing = [row for _, row in rows]
    task_id = args.id
    if not task_id:
        nums = [int(m.group(1)) for t in existing
                for m in [re.fullmatch(r"T(\d+)", t.get("id", ""))] if m]
        task_id = "T%d" % ((max(nums) + 1) if nums else 1)
    if any(t["id"] == task_id for t in existing):
        print("task already exists: %s/%s" % (args.line, task_id), file=sys.stderr)
        return 1
    values = {
        "id": task_id,
        "title": args.title,
        "status": "pending",
        "depends_on": args.depends_on or "-",
        "success_criteria": args.success_criteria,
        "failure_modes": args.failure_modes,
        "artifact_paths": args.artifact_paths,
        "short_test": args.short_test,
        "next_advance_after": "-",
        "fails": "0",
        "updated_at": fmt(now()),
        "evidence": "-",
        "leverage": args.leverage,
        "cost_estimate": args.cost_estimate,
        "resource_class": args.resource_class,
        "role": args.role,
    }
    try:
        values = {key: _clean_task_cell(key, value) for key, value in values.items()}
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    required = ("title", "success_criteria", "failure_modes", "artifact_paths", "short_test")
    missing = [name for name in required if not values[name]]
    if missing:
        print("half contract, refusing to add; missing fields: %s" % ", ".join(missing), file=sys.stderr)
        return 2
    # Pass the contract gate on a candidate copy first; never briefly expose an unverified task to the scheduler.
    row = "| " + " | ".join(values.get(col, "-") or "-" for col in header) + " |"
    candidate = list(lines)
    candidate.insert(rows[-1][0] + 1, row)
    # The gate rejects paths outside the CORTEX root (the correct safety boundary), so the candidate lives in a
    # hidden temp file beside TASKS; the scheduler reads only the exact TASKS.md and will not see it.
    candidate_path = os.path.join(
        os.path.dirname(path), ".cortex-task-add-%s-%s.md" % (os.getpid(), time.time_ns()))
    _atomic_write_lines(candidate_path, candidate)
    gate = os.path.join(ROOT, "bin", "knowledge-contract-gate.py")
    try:
        code, out = run("python3 %s check-path %s --strict"
                        % (shlex.quote(gate), shlex.quote(candidate_path)), timeout=60)
    finally:
        if os.path.exists(candidate_path):
            os.unlink(candidate_path)
    if code != 0 or "FAIL" in out:
        print("contract gate failed, not published:\n%s" % out.strip()[:1200], file=sys.stderr)
        return 1

    # Lock the local table insert only once; do not share the lock with tick/Worker/Git. Reread inside the lock so concurrent adds
    # do not overwrite each other from the same old snapshot. Write with tmp+replace so a reader never sees half a Markdown table.
    lock_path = _ledger_lock_path(path)
    with open(lock_path, "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        lines, header, rows = read_table(path)
        if any(row.get("id") == task_id for _, row in rows):
            print("task already exists: %s/%s" % (args.line, task_id), file=sys.stderr)
            return 1
        row = "| " + " | ".join(values.get(col, "-") or "-" for col in header) + " |"
        insert_at = rows[-1][0] + 1
        lines.insert(insert_at, row)
        _atomic_write_lines(path, lines)
    log("task-add %s/%s" % (args.line, task_id))
    print("ADDED %s/%s" % (args.line, task_id))
    return 0


def route_discovered_file_tasks(candidates, line="cortex-immune"):
    """Publish discovered file work into the controller ledger.

    Legacy plan refs remain readable for history and non-file actions, but every
    new file producer must enter the workspace/candidate/integrator controller.
    """
    added = []
    for candidate in candidates:
        artifact = (candidate.get("artifact") or "").strip()
        short_test = (candidate.get("short_test") or "").strip()
        if artifact in ("", "-") or short_test in ("", "-"):
            continue
        task_id = _clean_task_cell("id", candidate.get("id") or "")
        if not task_id or pick(line, task_id):
            continue
        local_only = candidate.get("source") == "map-backlink-gap"
        args = argparse.Namespace(
            line=line, id=task_id,
            title=candidate.get("title") or task_id,
            depends_on="-",
            success_criteria="mechanical criterion passed: %s" % short_test,
            failure_modes="output missing, out-of-bounds edit, criterion not passed, or not landed on canonical master",
            artifact_paths=artifact,
            short_test=short_test,
            leverage="medium",
            cost_estimate="S" if local_only else "M",
            resource_class="local-only" if local_only else "llm-light",
            role="-",
        )
        if cmd_task_add(args) == 0:
            added.append(task_id)
    return added


def cmd_task_retry(args):
    """Atomically reschedule one failure to now; done / externally blocked states must not be quietly reopened."""
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if task.get("status") in ("done", "waiting_external", "blocked"):
        print("refusing to requeue a task in status %s; resolve that status reason first" % task.get("status"),
              file=sys.stderr)
        return 1
    path = tasks_path(args.line)
    updates = {"status": "pending", "next_advance_after": "-", "updated_at": fmt(now())}
    if args.reset_fails:
        updates["fails"] = "0"
    if not set_cells(path, task["id"], updates, expected_status=task.get("status")):
        print("task status changed concurrently; not overwriting the new status", file=sys.stderr)
        return 75
    log("task-retry %s/%s reason=%s" % (args.line, task["id"], args.reason))
    print("REQUEUED %s/%s now (reason=%s)" % (args.line, task["id"], args.reason))
    return 0


def cmd_task_reopen(args):
    """Explicitly undo one false completion; keep the failure count and the reason. Do not hand-edit TASKS."""
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if task.get("status") != "done":
        print("only a done task can be reopened; current status=%s" % task.get("status"),
              file=sys.stderr)
        return 1
    try:
        fails = int(task.get("fails") or 0) + 1
    except ValueError:
        fails = 1
    path = tasks_path(args.line)
    if not set_cells(path, task["id"], {
            "status": "pending", "evidence": "-", "next_advance_after": "-",
            "fails": str(fails), "updated_at": fmt(now()),
    }, expected_status="done"):
        print("task status changed concurrently; not overwriting the new status", file=sys.stderr)
        return 75
    log("task-reopen %s/%s reason=%s" % (args.line, task["id"], args.reason))
    print("REOPENED %s/%s -> pending (reason=%s)" % (
        args.line, task["id"], args.reason))
    return 0


def cmd_task_hold(args):
    """Atomically move the task to blocked/waiting_external so the executor does not keep burning quota."""
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if task.get("status") == "done":
        print("a done task cannot be held directly; for a false completion, task-reopen first", file=sys.stderr)
        return 1
    path = tasks_path(args.line)
    # HOLD is the provenance of an explicit human/controller archive; the repair controller auto-restores only
    # an old AI mis-archive or a blocked task with an expiry window. It must never overturn task-hold on the next beat.
    if not set_cells(path, task["id"], {
            "status": args.status, "next_advance_after": "HOLD",
            "updated_at": fmt(now()),
    }, expected_status=task.get("status")):
        print("task status changed concurrently; not overwriting the new status", file=sys.stderr)
        return 75
    log("task-hold %s/%s status=%s reason=%s"
        % (args.line, task["id"], args.status, args.reason))
    print("HELD %s/%s -> %s (reason=%s)"
          % (args.line, task["id"], args.status, args.reason))
    return 0


def cmd_task_resume(args):
    """Explicitly lift blocked/waiting_external/settling; do not clear failure history. After restore, an automatic tick may claim it."""
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if is_negative_test_sentinel(args.line, task):
        print("a counter-test sentinel cannot be restored to an executable task: %s/%s" % (args.line, args.task),
              file=sys.stderr)
        return 1
    if task.get("status") not in ("blocked", "waiting_external", "settling"):
        print("only blocked/waiting_external/settling can be resumed; current status=%s"
              % task.get("status"), file=sys.stderr)
        return 1
    path = tasks_path(args.line)
    if not set_cells(path, task["id"], {
            "status": "pending", "next_advance_after": "-",
            "updated_at": fmt(now()),
    }, expected_status=task.get("status")):
        print("task status changed concurrently; not overwriting the new status", file=sys.stderr)
        return 75
    log("task-resume %s/%s reason=%s" % (args.line, task["id"], args.reason))
    print("RESUMED %s/%s -> pending (reason=%s)"
          % (args.line, task["id"], args.reason))
    return 0


def cmd_task_route(args):
    """Atomically correct resource routing; a wrongly archived task can be restored to pending explicitly."""
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if task.get("status") == "done":
        print("a done task cannot change route; for a false completion, task-reopen first", file=sys.stderr)
        return 1
    if args.resume and task.get("status") not in (
            "blocked", "waiting_external", "pending", "settling"):
        print("only blocked/waiting_external/pending/settling can be restored with a route change; current status=%s"
              % task.get("status"), file=sys.stderr)
        return 1
    path = tasks_path(args.line)
    updates = {"resource_class": args.resource_class, "updated_at": fmt(now())}
    if args.resume:
        updates.update({"status": "pending", "next_advance_after": "-"})
    if not set_cells(path, task["id"], updates, expected_status=task.get("status")):
        print("task status changed concurrently; not overwriting the new status", file=sys.stderr)
        return 75
    log("task-route %s/%s class=%s resume=%s reason=%s"
        % (args.line, task["id"], args.resource_class, args.resume, args.reason))
    print("ROUTED %s/%s -> %s%s (reason=%s)"
          % (args.line, task["id"], args.resource_class,
             " + pending" if args.resume else "", args.reason))
    return 0


def cmd_task_run(args):
    """Execute one task exactly, still through the same claim/adapter/completion gate as an automatic tick."""
    if not acquire_task_lock(args.line, args.task):
        print("skip | %s/%s already has a Worker; refusing to execute twice" % (args.line, args.task))
        return 0
    entry = next((e for e in clock_lines() if e["line"] == args.line), None)
    if entry is None or entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
        print("direction line is disabled or does not exist: %s" % args.line, file=sys.stderr)
        return 1
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if task.get("resource_class") == "human-gate":
        print("refusing to auto-execute human-gate task %s/%s" % (args.line, args.task),
              file=sys.stderr)
        return 1
    if not runnable(load_tasks(args.line), task):
        print("task is not runnable now: status=%s depends_on=%s"
              % (task.get("status"), task.get("depends_on")), file=sys.stderr)
        return 1
    window = parse_ts(task.get("next_advance_after"))
    if window and window > now():
        print("task has not reached its retry window: %s" % fmt(window), file=sys.stderr)
        return 1
    executor = entry.get("executor") or "human"
    return advance_once(args.line, task, executor,
                        int(entry.get("advance_window_min") or 240))


def cmd_submit(args):
    path = tasks_path(args.line)
    task = pick(args.line, args.task)
    if not task:
        print("task not found %s" % args.task, file=sys.stderr)
        return 1
    body = ""
    if args.result and os.path.isfile(args.result):
        with open(args.result, encoding="utf-8", errors="replace") as fh:
            body = fh.read().strip()
    journal = os.path.join(DIRECTIONS, args.line, "JOURNAL.md")
    with open(journal, "a", encoding="utf-8") as fh:
        fh.write("\n## %s · %s (cortex-loop auto-advance)\n\n%s\n"
                 % (fmt(now()), task["id"], body[:4000] or "(executor produced no output)"))
    # Advance the window and record the time only; never change status to done here
    minutes = int(args.window_min)
    updates = {"next_advance_after": "-", "updated_at": fmt(now())}
    if task.get("status") == "running":
        updates["status"] = "pending"
    if not set_cells(path, task["id"], updates,
                     expected_status=("pending", "running", "settling")):
        log("settling %s skipped — controller changed status" % task["id"])
        return 0
    log("submit %s/%s window=+%dmin" % (args.line, task["id"], minutes))
    print("submitted %s (next window %s; status unchanged, done can only be written by try-complete)"
          % (task["id"], fmt(now() + timedelta(minutes=minutes))))
    return 0


def _artifact_repo_rel(rel):
    """Map a vault-relative path to a repo-relative path; return None when it is out of bounds."""
    full = rel if os.path.isabs(rel) else os.path.join(ROOT, rel)
    root_real = os.path.realpath(ROOT)
    full_real = os.path.realpath(full)
    if full_real != root_real and not full_real.startswith(root_real + os.sep):
        return None
    return os.path.relpath(full_real, root_real)


def _attempt_state_root():
    workspace_root = os.path.expanduser(os.environ.get(
        "CORTEX_WORKSPACE_ROOT", "${CORTEX_WORKSPACE_ROOT}"))
    return os.path.join(workspace_root, ".attempt")


def _candidate_receipt_root():
    workspace_root = os.path.expanduser(os.environ.get(
        "CORTEX_WORKSPACE_ROOT", "${CORTEX_WORKSPACE_ROOT}"))
    return os.path.expanduser(os.environ.get(
        "CORTEX_CANDIDATE_RECEIPT_ROOT", os.path.join(workspace_root, ".candidate")))


def _integration_receipt_root():
    workspace_root = os.path.expanduser(os.environ.get(
        "CORTEX_WORKSPACE_ROOT", "${CORTEX_WORKSPACE_ROOT}"))
    return os.path.expanduser(os.environ.get(
        "CORTEX_INTEGRATION_RECEIPT_ROOT", os.path.join(workspace_root, ".integration")))


def _safe_attempt_component(value):
    return re.sub(r"[^A-Za-z0-9._-]+", "-", value or "task").strip("-.")[:24] or "task"


def _path_is_within(path, pattern):
    pattern = (pattern or "").rstrip("/")
    return path == pattern or (bool(pattern) and path.startswith(pattern + "/"))


def _contract_repo_path(raw, label):
    value = (raw or "").strip()
    if (not value or value in ("-", ".") or value.startswith("/")
            or value.startswith(".git/") or value == ".git"
            or ".." in value.split("/") or any(ch in value for ch in "*?[\n\r")):
        raise ValueError("%s path is unsafe or too broad: %s" % (label, raw))
    return value[2:] if value.startswith("./") else value


def _candidate_companion_path():
    raw = os.environ.get("CORTEX_CANDIDATE_COMPANION", "").strip()
    return _contract_repo_path(raw, "candidate_companion") if raw else ""


def workspace_contract_paths(task):
    """Mechanically expand writable/read-only sparse paths from the contract; fail closed if they cannot be derived."""
    writable = []
    for field in ("bounds", "artifact_paths"):
        for raw in (task.get(field) or "").split():
            if raw == "-":
                continue
            path = _contract_repo_path(raw, field)
            if path not in writable:
                writable.append(path)
    artifacts = [_contract_repo_path(p, "artifact_paths")
                 for p in (task.get("artifact_paths") or "").split() if p != "-"]
    companion = _candidate_companion_path()
    if companion and companion not in writable:
        writable.append(companion)
    if not artifacts:
        raise ValueError("artifact_paths is empty; refusing to create a whole-repo workspace")
    if not writable:
        raise ValueError("bounds/artifact_paths has no usable path")

    test = (task.get("short_test") or "").strip()
    if not test or test == "-":
        raise ValueError("short_test is empty")
    try:
        tokens = shlex.split(test)
    except ValueError as exc:
        raise ValueError("short_test could not be parsed safely: %s" % exc)
    readonly = []
    repo_ext = (".py", ".sh", ".md", ".json", ".yaml", ".yml", ".toml",
                ".txt", ".csv", ".js", ".ts")
    for token in tokens:
        candidate = token.split("=", 1)[1] if token.startswith("--") and "=" in token else token
        candidate = candidate.rstrip(":,;")
        if candidate.startswith(("/bin/", "/usr/", "/opt/")):
            continue
        looks_like_path = ("/" in candidate or candidate.endswith(repo_ext)
                           or os.path.exists(os.path.join(ROOT, candidate)))
        if not looks_like_path or candidate in (".", ".."):
            continue
        path = _contract_repo_path(candidate, "short_test")
        if any(_path_is_within(path, allowed) for allowed in writable):
            continue
        if path not in readonly:
            readonly.append(path)
    # A candidate commit must actually pass through versioned hooks. Materialize the hooks and the minimum
    # validator dependencies they explicitly call as read-only; production fail-closes when hooksPath is missing. An isolated fixture
    # may only supply its own rejecting hook explicitly, or turn on the test switch.
    hook_code, hooks_path = git("config --get core.hooksPath", timeout=30)
    hooks_path = hooks_path.strip()
    if hook_code != 0 or not hooks_path:
        if os.environ.get("CORTEX_ALLOW_NO_HOOK_FIXTURE") != "1":
            raise ValueError("core.hooksPath is not configured; a candidate commit might bypass the gate")
    else:
        hooks_full = hooks_path if os.path.isabs(hooks_path) else os.path.join(ROOT, hooks_path)
        hooks_real = os.path.realpath(hooks_full)
        root_real = os.path.realpath(ROOT)
        if not (hooks_real == root_real or hooks_real.startswith(root_real + os.sep)) \
                or not os.path.isdir(hooks_real):
            raise ValueError("core.hooksPath is outside the versioned repo or does not exist: %s" % hooks_path)
        hook_rel = os.path.relpath(hooks_real, root_real)
        if hook_rel not in readonly:
            readonly.append(hook_rel)
        for dep in (
            "bin/git-mac-commit-gate.sh",
            "bin/verify-three-horizontal-one-vertical.py",
            "bin/verify-current-state-consistency.py",
            "bin/git-commit-contract-scan.py",
            "bin/report-governance.py",
            # pre-commit invokes this for every report-bearing candidate; it
            # must be present in the sparse attempt rather than treated as a
            # root-worktree-only hook helper.
            "bin/claim-count-gate.sh",
            # Markdown frontmatter is checked for every changed report and
            # Skill. A sparse candidate must execute the same parser rather
            # than fail because the hook cannot locate it.
            "bin/verify-frontmatter.py",
            # A changed SKILL.md also invokes this direct hook helper. Its
            # wider governance inputs remain governed by the existing gate;
            # this list only prevents a missing executable from masking them.
            "bin/verify-skill-integration.sh",
            "bin/knowledge-contract-gate.py",
            "bin/verify-recipe-entry-contract.py",
        ):
            if os.path.exists(os.path.join(ROOT, dep)) and dep not in readonly:
                readonly.append(dep)
    return {
        "writable_paths": writable,
        "artifact_paths": artifacts,
        "read_paths": readonly,
        "materialized_paths": writable + [p for p in readonly if p not in writable],
        "short_test": test,
        "candidate_companion": companion,
    }


def _write_json_exclusive(path, payload):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with open(path, "x", encoding="utf-8") as fh:
            json.dump(payload, fh, ensure_ascii=False, sort_keys=True, indent=2)
            fh.write("\n")
    except FileExistsError:
        return False
    return True


def _workspace_kb(worktree):
    try:
        proc = subprocess.run(["du", "-sk", worktree], text=True,
                              capture_output=True, timeout=30)
        value = proc.stdout.split()[0] if proc.returncode == 0 and proc.stdout.split() else ""
        return int(value) if value.isdigit() else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def _attempt_events_path(candidate):
    return os.path.join(_attempt_state_root(), "%s.events.jsonl" % candidate["attempt"])


RUN_CONTRACT_SCHEMA = "cortex-loop/run-contract-v1"


def _canonical_digest(value):
    """Hash a JSON value using the one canonical encoding shared by projections."""
    encoded = json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def _run_contract_id(run_id):
    """Derive the stable contract id once from the immutable attempt run id."""
    return hashlib.sha256((RUN_CONTRACT_SCHEMA + "\0" + str(run_id)).encode(
        "utf-8")).hexdigest()[:24]


def _task_goal_digest(task):
    return _canonical_digest({
        "title": task.get("title", ""),
        "success_criteria": task.get("success_criteria", ""),
        "failure_modes": task.get("failure_modes", ""),
        "depends_on": task.get("depends_on", "-"),
    })


def _task_contract_digest(contract):
    return _canonical_digest({
        "writable_paths": sorted(contract.get("writable_paths") or []),
        "read_paths": sorted(contract.get("read_paths") or []),
        "artifact_paths": sorted(contract.get("artifact_paths") or []),
        "short_test": contract.get("short_test", ""),
    })


def _run_contract_stage(state):
    return {
        "running": "execute",
        "done": "complete",
        "blocked": "submit",
        "waiting_external": "submit",
        "settling": "submit",
        "pending": "claim",
    }.get(state, "unknown")


def _load_json_file(path):
    if not path:
        return {}
    try:
        with open(path, encoding="utf-8") as fh:
            value = json.load(fh)
        return value if isinstance(value, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _attempt_delivery_state(claim, task):
    """Expose artifact, candidate, and terminal gates independently.

    A provider can write an artifact while the controlled candidate commit is
    blocked by the companion-receipt gate. Keep that fact visible in the
    read-only run-contract instead of collapsing it into ``state=pending``.
    """
    worktree = str(claim.get("worktree") or "")
    artifacts = list(claim.get("artifact_paths") or [])
    worktree_present = bool(worktree and os.path.isdir(worktree))
    artifact_ok = bool(worktree and artifacts) and all(
        os.path.isfile(os.path.join(worktree, rel))
        and os.path.getsize(os.path.join(worktree, rel)) > 0
        for rel in artifacts
    )
    candidate = _load_json_file(claim.get("candidate_path"))
    integration = _load_json_file(claim.get("integration_receipt"))
    candidate_oid = str(candidate.get("candidate_oid") or "")
    candidate_landed = (
        candidate.get("status") == "published"
        and bool(candidate_oid)
        and str(candidate.get("candidate_ref") or "").startswith(
            "refs/cortex/candidate/"
        )
    )
    integration_landed = integration.get("status") == "landed"
    blocker = ""
    event_path = _attempt_events_path(claim)
    try:
        with open(event_path, encoding="utf-8") as fh:
            events = [json.loads(line) for line in fh if line.strip()]
    except (OSError, json.JSONDecodeError):
        events = []
    for event in reversed(events):
        if event.get("machine_blocker"):
            blocker = str(event["machine_blocker"])
            break
    # A TASKS.md ``done`` cell alone is not a terminal delivery assertion.  A
    # terminal contract is published only after the candidate/integrator gate
    # has been independently checked, and is the durable reader-facing proof.
    terminal_complete = False
    # Once both durable delivery receipts exist, an absent attempt worktree is
    # normal: successful completion releases it.  It is not evidence that the
    # provider artifact vanished.  Until the immutable terminal ref appears,
    # retain that uncertainty explicitly instead of emitting a false terminal
    # negative derived from disposable bytes.
    terminal_ref_pending = candidate_landed and integration_landed
    if terminal_ref_pending and not worktree_present:
        artifact_ok = None
    if terminal_ref_pending:
        stage = "terminal-ref-pending"
    elif candidate_landed:
        stage = "candidate-landed"
    elif artifact_ok:
        stage = "artifact-ok"
    else:
        stage = "provider-incomplete"
    return {
        "artifact_ok": artifact_ok,
        "candidate_landed": candidate_landed,
        "terminal_complete": terminal_complete,
        "stage": stage,
        "terminal_ref_pending": terminal_ref_pending,
        "machine_blocker": blocker,
        "candidate_oid": candidate_oid,
        "integration_status": integration.get("status", ""),
    }


def _build_run_contract(claim, task, source_surface="cli", terminal_evidence=None):
    """Build the read-only cross-surface contract from a frozen attempt claim."""
    required = (
        "contract_id", "run_id", "line", "task", "attempt", "executor",
        "goal_digest", "contract_digest", "artifact_paths", "short_test",
    )
    missing = [key for key in required if key not in claim]
    if missing:
        raise ValueError("attempt claim is missing run-contract fields: %s" % ",".join(missing))
    if claim.get("line") != task.get("_line", claim.get("line")):
        raise ValueError("attempt claim line does not match the task projection")
    run_id = str(claim.get("run_id") or "")
    if not run_id:
        raise ValueError("attempt claim is missing a non-empty run_id")
    expected_id = _run_contract_id(run_id)
    if claim.get("contract_id") != expected_id:
        raise ValueError("contract_id does not match run_id")
    if _task_goal_digest(task) != claim["goal_digest"]:
        raise ValueError("FAIL_SEMANTIC_DRIFT: goal_digest does not match the frozen task")
    frozen_contract = {
        "writable_paths": claim.get("writable_paths") or [],
        "read_paths": claim.get("read_paths") or [],
        "artifact_paths": claim.get("artifact_paths") or [],
        "short_test": claim.get("short_test", ""),
    }
    if _task_contract_digest(frozen_contract) != claim["contract_digest"]:
        raise ValueError("FAIL_SEMANTIC_DRIFT: contract_digest does not match the frozen contract")
    state = str(task.get("status") or "UNKNOWN")
    semantic = {
        "goal_digest": claim["goal_digest"],
        "contract_digest": claim["contract_digest"],
        "artifact_paths": list(claim.get("artifact_paths") or []),
        "short_test": claim.get("short_test", ""),
        "terminal_state": state if state in {
            "done", "blocked", "waiting_external"
        } else None,
    }
    delivery = _attempt_delivery_state(claim, task)
    if terminal_evidence is not None:
        if not delivery["candidate_landed"] or delivery["integration_status"] != "landed":
            raise ValueError("terminal run-contract is missing verified candidate/integration landing evidence")
        delivery.update({
            "terminal_complete": True,
            "stage": "terminal-complete",
            "terminal_evidence": terminal_evidence,
        })
    return {
        "schema_version": RUN_CONTRACT_SCHEMA,
        "contract_id": claim["contract_id"],
        "run_id": run_id,
        "line": claim["line"],
        "task_id": claim["task"],
        "attempt": claim["attempt"],
        "state": state,
        "stage": _run_contract_stage(state),
        "executor": claim["executor"],
        "semantic": semantic,
        "semantic_digest": _canonical_digest(semantic),
        "delivery": delivery,
        "provenance": {
            "canonical_entry": "bin/cortex-loop",
            "source_surface": source_surface,
            "identity_status": claim.get("identity_status", "IDENTITY_MISMATCH"),
        },
    }


def _run_contract_ref(line, task_id, run_id):
    return "%s/%s/%s/%s" % (
        RUN_CONTRACT_NS, _safe_ref_component(line),
        _safe_ref_component(task_id), _safe_ref_component(run_id))


def _validate_terminal_run_contract(value, line, task_id, run_id=None):
    """Return a stored terminal contract only when its immutable proof holds."""
    if not isinstance(value, dict):
        return None
    if (value.get("schema_version") != RUN_CONTRACT_SCHEMA
            or value.get("line") != line
            or value.get("task_id") != task_id
            or (run_id and value.get("run_id") != run_id)):
        return None
    if value.get("contract_id") != _run_contract_id(value.get("run_id") or ""):
        return None
    semantic = value.get("semantic")
    delivery = value.get("delivery")
    evidence = delivery.get("terminal_evidence") if isinstance(delivery, dict) else None
    if (not isinstance(semantic, dict)
            or value.get("semantic_digest") != _canonical_digest(semantic)
            or not isinstance(evidence, dict)
            or delivery.get("terminal_complete") is not True
            or delivery.get("stage") != "terminal-complete"
            or not re.fullmatch(r"[0-9a-f]{40}", str(evidence.get("candidate_oid") or ""))
            or not re.fullmatch(r"[0-9a-f]{40}", str(evidence.get("landed_oid") or ""))
            or evidence.get("integration_status") != "landed"):
        return None
    return value


def _load_terminal_run_contract(line, task_id, run_id=None):
    """Load the latest durable terminal projection without consulting an attempt."""
    namespace = "%s/%s/%s" % (
        RUN_CONTRACT_NS, _safe_ref_component(line), _safe_ref_component(task_id))
    refs = list_refs(namespace)
    if getattr(refs, "status", "ok") == "error":
        return None, "canonical run-contract refs are unreadable"
    matches = []
    for ref in refs:
        payload = read_ref(ref)
        if getattr(payload, "status", "ok") == "error":
            continue
        try:
            value = json.loads(str(payload))
        except json.JSONDecodeError:
            continue
        value = _validate_terminal_run_contract(value, line, task_id, run_id)
        if value is None:
            continue
        published_at = str((value.get("delivery", {}).get("terminal_evidence", {})
                            .get("published_at") or ""))
        matches.append((published_at, ref, value))
    if not matches:
        return None, ""
    _published_at, ref, contract = max(matches, key=lambda item: (item[0], item[1]))
    return (ref, contract), ""


def _project_terminal_run_contract(ref, contract, source_surface):
    """Keep caller surface provenance outside the immutable semantic payload."""
    projection = json.loads(json.dumps(contract, ensure_ascii=False))
    provenance = projection.setdefault("provenance", {})
    provenance["source_surface"] = source_surface
    provenance["canonical_ref"] = ref
    return projection


def _publish_terminal_run_contract(candidate, task, receipt):
    """Persist a terminal projection only after the integrator proof is verified."""
    if task.get("status") != "done":
        return False, "terminal run-contract refuses to publish when task status is not done"
    candidate_oid = str(candidate.get("candidate_oid") or "")
    landed_oid = str((receipt or {}).get("landed_commit") or "")
    if (not re.fullmatch(r"[0-9a-f]{40}", candidate_oid)
            or not re.fullmatch(r"[0-9a-f]{40}", landed_oid)
            or receipt.get("status") != "landed"):
        return False, "terminal run-contract is missing a verified candidate/integration OID"
    run_id = str(candidate.get("run_id") or "")
    ref = _run_contract_ref(candidate.get("line", ""), candidate.get("task", ""), run_id)
    existing, load_error = _load_terminal_run_contract(
        candidate.get("line", ""), candidate.get("task", ""), run_id)
    if load_error:
        return False, load_error
    if existing is not None:
        _existing_ref, stored = existing
        evidence = stored["delivery"]["terminal_evidence"]
        if (evidence.get("candidate_oid") == candidate_oid
                and evidence.get("landed_oid") == landed_oid):
            return True, _existing_ref
        return False, "this run_id already has a mismatched terminal run-contract"
    terminal_evidence = {
        "candidate_oid": candidate_oid,
        "landed_oid": landed_oid,
        "integration_status": "landed",
        "canonical_ref": receipt.get("canonical_ref") or "refs/heads/master",
        "published_at": fmt(now()),
    }
    try:
        contract = _build_run_contract(
            candidate, task, source_surface="terminal-publisher",
            terminal_evidence=terminal_evidence)
    except ValueError as exc:
        return False, str(exc)
    ok, detail = write_ref(ref, json.dumps(contract, ensure_ascii=False, sort_keys=True))
    if not ok:
        return False, "terminal run-contract write failed: %s" % detail
    stored, load_error = _load_terminal_run_contract(
        candidate.get("line", ""), candidate.get("task", ""), run_id)
    if load_error or stored is None or stored[0] != ref:
        return False, load_error or "terminal run-contract is unreadable after write"
    return True, ref


def _load_attempt_claim_for_run(line, task_id, run_id=None):
    root = _attempt_state_root()
    if not os.path.isdir(root):
        return None
    matches = []
    for name in os.listdir(root):
        if not name.endswith(".claim.json"):
            continue
        path = os.path.join(root, name)
        try:
            with open(path, encoding="utf-8") as fh:
                claim = json.load(fh)
        except (OSError, json.JSONDecodeError):
            continue
        if claim.get("line") != line or claim.get("task") != task_id:
            continue
        if run_id and claim.get("run_id") != run_id:
            continue
        matches.append((os.path.getmtime(path), claim))
    return max(matches, default=(0, None), key=lambda pair: pair[0])[1]


def _read_run_contract(line, task_id, run_id=None, source_surface="cli"):
    stored, load_error = _load_terminal_run_contract(line, task_id, run_id)
    if stored is not None:
        return _project_terminal_run_contract(stored[0], stored[1], source_surface)
    claim = _load_attempt_claim_for_run(line, task_id, run_id)
    if claim is None:
        if load_error:
            raise ValueError(load_error)
        raise ValueError("run contract not found: %s/%s%s" % (
            line, task_id, ("/" + run_id) if run_id else ""))
    task = _task_or_error(line, task_id)
    if task is None:
        raise ValueError("task not found: %s/%s" % (line, task_id))
    task = dict(task)
    task["_line"] = line
    fallback = _build_run_contract(claim, task, source_surface=source_surface)
    if not fallback["delivery"].get("terminal_ref_pending"):
        return fallback
    # Do not turn a just-landed candidate into a final negative merely because
    # the terminal ref lands a few scheduler ticks after the integration
    # receipt.  A bounded local reread preserves API no-fetch semantics and
    # still returns an explicit pending state when publication is genuinely not
    # visible yet.
    for _retry in range(TERMINAL_REF_READ_RETRIES):
        time.sleep(TERMINAL_REF_READ_DELAY_SEC)
        stored, load_error = _load_terminal_run_contract(line, task_id, run_id)
        if stored is not None:
            return _project_terminal_run_contract(stored[0], stored[1], source_surface)
    fallback["delivery"]["terminal_ref_pending"] = True
    fallback["delivery"]["machine_blocker"] = "terminal_ref_pending"
    return fallback


def _attempt_cas_retry_count(candidate):
    path = _attempt_events_path(candidate)
    count = 0
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                try:
                    if json.loads(line).get("integration_status") == "retryable_cas_conflict":
                        count += 1
                except json.JSONDecodeError:
                    continue
    except OSError:
        pass
    return count


def _attempt_content_conflict_count(candidate):
    """Count content-conflict integration attempts for one immutable candidate."""
    path = _attempt_events_path(candidate)
    count = 0
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                try:
                    if json.loads(line).get("integration_status") == "retryable_content_conflict":
                        count += 1
                except json.JSONDecodeError:
                    continue
    except OSError:
        pass
    return count


def _attempt_base_oid():
    """Freeze an attempt from the integration ref, not an unrelated local HEAD.

    LIVE workspaces may publish to a lab ref while the checkout remains on the
    repository's master branch. Fetching the configured push ref before creating
    the worktree keeps its base, candidate delta, and integrator canonical tip
    on one history. With no override the historical local HEAD behavior remains
    available for ordinary master runs and isolated fixtures.
    """
    configured = os.environ.get("CORTEX_CANONICAL_PUSH_REF", "").strip()
    if not configured:
        code, out = git("rev-parse --verify HEAD^{commit}", timeout=60)
        tip = out.strip()
        if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", tip):
            raise RuntimeError("unable to freeze base_oid")
        return tip, "HEAD"
    if (not re.fullmatch(r"refs/heads/[A-Za-z0-9._/-]+", configured)
            or ".." in configured.split("/")):
        raise RuntimeError("CORTEX_CANONICAL_PUSH_REF is invalid: %s" % configured)
    remote = os.environ.get("CORTEX_CANONICAL_REMOTE", "origin").strip() or "origin"
    if not re.fullmatch(r"[A-Za-z0-9._-]+", remote):
        raise RuntimeError("CORTEX_CANONICAL_REMOTE is invalid: %s" % remote)
    branch = configured[len("refs/heads/"):]
    tracking = "refs/remotes/%s/%s" % (remote, branch)
    fetch_args = "fetch --quiet %s '+%s:%s'" % (
        shlex.quote(remote), shlex.quote(configured), shlex.quote(tracking))
    code, out = _git_net_retry(fetch_args, timeout=180, attempts=3,
                               label="fetch_attempt_canonical")
    if code != 0:
        raise RuntimeError("canonical ref fetch failed %s: %s" % (
            configured, out.strip().split("\n")[-1][:240] or "no output"))
    code, out = git("rev-parse --verify %s^{commit}" % shlex.quote(tracking), timeout=60)
    tip = out.strip()
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", tip):
        raise RuntimeError("canonical ref cannot be resolved: %s" % configured)
    return tip, configured


def append_attempt_event(candidate, event):
    payload = {
        "schema_version": "cortex-attempt/event-v1",
        "attempt": candidate["attempt"], "run_id": candidate["run_id"],
        "contract_id": candidate.get("contract_id"),
        "line": candidate["line"], "task": candidate["task"],
        "candidate_oid": candidate.get("candidate_oid"),
        "recorded_at": fmt(now()),
    }
    payload.update(event)
    path = _attempt_events_path(candidate)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n")


def create_workspace_attempt(line, task, executor):
    """Build immutable claim metadata and create the attempt worktree."""
    contract = workspace_contract_paths(task)
    base_oid, base_ref = _attempt_base_oid()
    run_id = hashlib.sha256(("%s\0%s\0%s\0%s\0%s" % (
        line, task["id"], base_oid, time.time_ns(), os.getpid())).encode()).hexdigest()[:20]
    attempt = "%s-%s-%s" % (
        _safe_attempt_component(line), _safe_attempt_component(task["id"]), run_id)
    state_root = _attempt_state_root()
    claim_path = os.path.join(state_root, "%s.claim.json" % attempt)
    receipt_path = os.path.join(_integration_receipt_root(), "%s.json" % attempt)
    candidate_path = os.path.join(_candidate_receipt_root(), "%s.json" % attempt)
    workspace_root = os.path.expanduser(os.environ.get(
        "CORTEX_WORKSPACE_ROOT", "${CORTEX_WORKSPACE_ROOT}"))
    worktree = os.path.join(workspace_root, attempt)
    workspace_manifest = os.path.join(workspace_root, ".state", "%s.json" % attempt)
    claim = {
        "schema_version": "cortex-attempt/claim-v1",
        "attempt": attempt, "run_id": run_id, "line": line, "task": task["id"],
        "contract_id": _run_contract_id(run_id),
        "goal_digest": _task_goal_digest(task),
        "contract_digest": _task_contract_digest(contract),
        "executor": executor, "base_oid": base_oid, "base_ref": base_ref,
        "writable_paths": contract["writable_paths"],
        "artifact_paths": contract["artifact_paths"],
        "read_paths": contract["read_paths"],
        "short_test": contract["short_test"],
        "integration_receipt": receipt_path, "claim_path": claim_path,
        "candidate_path": candidate_path, "worktree": worktree,
        "workspace_manifest": workspace_manifest,
        "created_at": fmt(now()),
    }
    if not _write_json_exclusive(claim_path, claim):
        raise RuntimeError("attempt claim already exists; refusing to overwrite")
    broker = os.path.join(ROOT, "bin", "cortex-workspace.sh")
    args = ["bash", broker, "create", "--attempt", attempt, "--base", base_oid]
    for path in contract["materialized_paths"]:
        args.extend(["--allow", path])
    env = "CORTEX_WORKSPACE_REPO_ROOT=%s " % shlex.quote(ROOT)
    # The first time `git sparse-checkout init` enables extensions.worktreeConfig it briefly writes the shared
    # .git/config; attempts may execute in parallel, but this broker-create stretch must be serial,
    # or two independent worktrees still contend for config.lock.
    create_lock_path = os.path.join(state_root, "workspace-create.lock")
    os.makedirs(state_root, exist_ok=True)
    with open(create_lock_path, "a+", encoding="utf-8") as create_lock:
        fcntl.flock(create_lock.fileno(), fcntl.LOCK_EX)
        code, out = run(env + " ".join(shlex.quote(v) for v in args), timeout=180)
        fcntl.flock(create_lock.fileno(), fcntl.LOCK_UN)
    if code != 0:
        raise RuntimeError("workspace create rc=%d: %s" % (code, out.strip()[-600:]))
    broker_worktree = next((line.strip() for line in reversed(out.splitlines())
                     if line.strip() and os.path.isdir(line.strip())), "")
    if (not os.path.isdir(broker_worktree)
            or os.path.realpath(broker_worktree) != os.path.realpath(worktree)
            or os.path.realpath(worktree) == os.path.realpath(ROOT)):
        raise RuntimeError("workspace broker returned an invalid worktree: %s" % broker_worktree)
    companion = contract.get("candidate_companion")
    if companion:
        source = os.path.join(ROOT, companion)
        target = os.path.join(worktree, companion)
        if not os.path.isfile(source) or os.path.getsize(source) == 0:
            raise RuntimeError("candidate companion is missing or empty: %s" % companion)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        shutil.copy2(source, target)
    return claim


def _workspace_changed_paths(worktree):
    proc = subprocess.run(
        ["git", "-C", worktree, "status", "--porcelain=v1", "-z",
         "--untracked-files=all"], capture_output=True)
    if proc.returncode != 0:
        raise RuntimeError("unable to read attempt worktree status")
    changed = []
    for record in proc.stdout.split(b"\0"):
        if not record:
            continue
        text = record.decode("utf-8", "surrogateescape")
        if text[:2].strip() in ("R", "C"):
            raise RuntimeError("attempt rename/copy must be split into explicit old/new paths; refusing")
        path = text[3:]
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        changed.append(path)
    return changed


def _candidate_companion_blocker(output):
    markers = (
        "high-impact delivery is missing its evidence report",
        "high-impact delivery omitted an evidence report pathspec",
        "high-impact delivery omitted a matching evidence report",
    )
    return any(marker in (output or "") for marker in markers)


def refresh_candidate_companion(ctx, task):
    """Materialize post-adapter evidence before high-impact candidate preflight."""
    contract = workspace_contract_paths(task)
    companion = contract.get("candidate_companion")
    if not companion:
        return ""
    result_path = str(ctx.get("adapter_result") or "")
    if not result_path or not os.path.isfile(result_path):
        raise RuntimeError("candidate companion is missing this round's adapter result")
    fields = {}
    allowed = {
        "executor", "native_session_id", "native_tool_events",
        "session_timeout_seconds", "model_timeout_seconds", "max_tool_rounds",
        "timeout_reason", "error_category", "budget_result", "exit",
    }
    with open(result_path, encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            key, sep, value = raw.rstrip("\n").partition("=")
            if sep and key in allowed:
                fields[key] = value.strip()
    adapter_exit = fields.get("exit", "unknown")
    transport_error = fields.get("error_category") or fields.get("timeout_reason", "")
    salvage = bool(ctx.get("transport_salvage"))
    if adapter_exit != "0" and not (
            salvage and transport_error in {"network_timeout", "network_error"}):
        raise RuntimeError("candidate companion refuses to forge evidence for an unsuccessful adapter")
    target = os.path.join(ctx["worktree"], companion)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    report_attempt = re.sub(r"[^a-z0-9]+", "-", str(ctx["attempt"]).lower()).strip("-")
    evidence = [
        "---",
        "id: CANDIDATE-COMPANION-%s" % ctx["run_id"],
        "report_id: cortex-candidate-%s" % report_attempt,
        "date: %s" % now().date().isoformat(),
        "status: living",
        "verdict: CANDIDATE_EVIDENCE",
        "topic: cortex-harness",
        "campaign: cortex-harness",
        "owner: cortex-workspace",
        "---",
        "",
        "# Candidate companion evidence",
        "",
        "This file is refreshed after a successful adapter result and before candidate preflight.",
        "It is evidence for candidate gating only; it does not claim terminal delivery.",
        "",
        "## Timeline",
        "",
        "1. Adapter completed with `exit=0` for attempt `%s`." % ctx["attempt"],
        "2. This companion was refreshed from that result before candidate preflight.",
        "",
        "## Three horizontals, one vertical",
        "",
        "### Bucket A — Adapter result: `bin/cortex-loop`",
        "",
        "- object: `bin/cortex-loop` attempt `%s` via `%s`." % (
            ctx["attempt"], fields.get("executor") or ctx.get("executor", "unknown")),
        "- evidence: adapter result recorded `exit=%s` before this companion refresh." % adapter_exit,
        "",
        "### Bucket B — Bounded provider evidence: `bin/cortex-loop-adapters`",
        "",
        "- object: bounded native session `%s`." % fields.get("native_session_id", "unknown"),
        "- evidence: events=%s timeout_reason=%s error_category=%s." % (
            fields.get("native_tool_events", "unknown"),
            fields.get("timeout_reason", "unknown"),
            fields.get("error_category", "unknown")),
        "",
        "### Bucket C — Candidate boundary: `reports/` companion",
        "",
        "- object: `%s` in the attempt worktree." % companion,
        "- evidence: refreshed after adapter exit, before high-impact candidate preflight; terminal delivery remains pending.",
        "",
        "### One vertical — Machine evidence",
        "",
        "```text",
        "candidate_companion_refresh=after_adapter",
        "adapter_exit=%s" % adapter_exit,
        "transport_error=%s" % (transport_error or "none"),
        "native_session_id=%s" % fields.get("native_session_id", "unknown"),
        "native_tool_events=%s" % fields.get("native_tool_events", "unknown"),
        "timeout_reason=%s" % fields.get("timeout_reason", "unknown"),
        "error_category=%s" % fields.get("error_category", "unknown"),
        "```",
        "",
        "## Verdict",
        "",
        "`CANDIDATE_EVIDENCE`: candidate preflight may now evaluate real post-adapter evidence; candidate and terminal state are not asserted.",
        "",
    ]
    with open(target, "w", encoding="utf-8") as fh:
        fh.write("\n".join(evidence))
    append_attempt_event(ctx, {
        "delivery_stage": "candidate-companion-refreshed",
        "candidate_companion": companion,
        "adapter_result": result_path,
        "adapter_exit": int(adapter_exit) if str(adapter_exit).isdigit() else adapter_exit,
        "transport_error": transport_error or "none",
        "transport_salvage": salvage,
    })
    return companion


def commit_workspace_candidate(ctx, task):
    """Exactly commit in-contract changes in the attempt's independent index, and publish an immutable candidate."""
    worktree = ctx["worktree"]
    contract = workspace_contract_paths(task)
    refresh_candidate_companion(ctx, task)
    changed = _workspace_changed_paths(worktree)
    if not changed:
        raise RuntimeError("adapter produced no file changes")
    outside = [p for p in changed if not any(
        _path_is_within(p, allowed) for allowed in contract["writable_paths"])]
    if outside:
        record_authorization_incident(
            ctx["line"], ctx["task"], "out_of_scope_write",
            "candidate bounds outside_paths=%s" % ",".join(outside[:8]))
        raise RuntimeError("attempt out-of-bounds changes: %s" % ", ".join(outside[:8]))
    for rel in contract["artifact_paths"]:
        full = os.path.join(worktree, rel)
        if not os.path.isfile(full) or os.path.getsize(full) == 0:
            raise RuntimeError("artifact missing or empty: %s" % rel)
    code, out = run("cd %s && %s" % (
        shlex.quote(worktree), contract["short_test"]), timeout=600)
    if code != 0:
        raise RuntimeError("attempt short_test rc=%d: %s" % (code, out.strip()[-800:]))
    helper = os.path.join(ROOT, "bin", "git-auto-commit.sh")
    message = "chore(cortex): candidate %s/%s" % (ctx["line"], ctx["task"])
    cmd = ["bash", helper, "--producer", "cortex-workspace-candidate",
           "-m", message, "--", *changed]
    code, out = run("cd %s && CORTEX_WORKSPACE_MANIFEST=%s %s" % (
        shlex.quote(worktree), shlex.quote(ctx["workspace_manifest"]),
        " ".join(shlex.quote(v) for v in cmd)), timeout=180)
    if code != 0:
        if _candidate_companion_blocker(out):
            blocker = (
                "MACHINE_BLOCKER: candidate requires an exact reports/.../*.md "
                "companion pathspec; preflight rejected delivery"
            )
            append_attempt_event(ctx, {
                "delivery_stage": "candidate-companion",
                "artifact_ok": True,
                "candidate_landed": False,
                "terminal_complete": False,
                "machine_blocker": blocker,
                "preflight_rc": code,
            })
            raise RuntimeError("%s; %s" % (blocker, out.strip()[-800:]))
        raise RuntimeError("attempt controlled commit failed rc=%d: %s" % (code, out.strip()[-800:]))
    candidate_oid = subprocess.run(
        ["git", "-C", worktree, "rev-parse", "HEAD"], text=True,
        capture_output=True, check=True).stdout.strip()
    publisher = os.path.join(ROOT, "bin", "cortex-candidate.sh")
    publish_cmd = ["bash", publisher, "publish", "--attempt", ctx["attempt"],
                   "--candidate", candidate_oid, "--base", ctx["base_oid"],
                   "--remote", "origin", "--receipt", ctx["candidate_path"]]
    for path in contract["writable_paths"]:
        publish_cmd.extend(["--allow", path])
    code, out = run("cd %s && %s" % (
        shlex.quote(worktree), " ".join(shlex.quote(v) for v in publish_cmd)), timeout=240)
    try:
        with open(ctx["candidate_path"], encoding="utf-8") as fh:
            published = json.load(fh)
    except (OSError, json.JSONDecodeError):
        published = {}
    if (code != 0 or published.get("status") != "published"
            or published.get("candidate_oid") != candidate_oid
            or not str(published.get("candidate_ref", "")).startswith(
                "refs/cortex/candidate/")):
        raise RuntimeError("candidate immutable publish failed rc=%d: %s" % (
            code, out.strip()[-500:]))
    candidate_ref = published["candidate_ref"]
    candidate = dict(ctx)
    candidate.update({
        "schema_version": "cortex-attempt/candidate-v1",
        "candidate_oid": candidate_oid, "candidate_ref": candidate_ref,
        "changed_paths": changed, "published_at": fmt(now()),
    })
    return candidate


def run_workspace_integrator(candidate):
    integrator = os.path.join(ROOT, "bin", "cortex-integrator.sh")
    canonical_ref = os.environ.get("CORTEX_CANONICAL_PUSH_REF", "refs/heads/master")
    remote = os.environ.get("CORTEX_CANONICAL_REMOTE", "origin")
    cmd = ["bash", integrator, "--candidate", candidate["candidate_oid"],
           "--candidate-ref", candidate["candidate_ref"],
           "--base", candidate["base_oid"], "--remote", remote,
           "--ref", canonical_ref, "--short-test", candidate["short_test"],
           "--receipt", candidate["integration_receipt"]]
    for path in candidate["writable_paths"]:
        cmd.extend(["--allow", path])
    for path in candidate["read_paths"]:
        cmd.extend(["--read", path])
    companion = candidate.get("candidate_companion")
    if companion:
        cmd.extend(["--companion", companion])
    code, out = run("cd %s && %s" % (
        shlex.quote(candidate["worktree"]), " ".join(shlex.quote(v) for v in cmd)),
        timeout=900)
    receipt = {}
    try:
        with open(candidate["integration_receipt"], encoding="utf-8") as fh:
            receipt = json.load(fh)
    except (OSError, json.JSONDecodeError):
        receipt = {"status": "retryable_missing_receipt", "exit_code": code,
                   "detail": out.strip()[-800:] or "integrator produced no receipt"}
    return code, receipt


def record_authorization_from_integration(line, task_id, receipt):
    status = str((receipt or {}).get("status") or "")
    incident_type = {
        "rejected_scope": "out_of_scope_write",
        "rejected_readonly_change": "out_of_scope_write",
        "rejected_v4_secret_gate": "out_of_scope_write",
        "rejected_candidate_ref_mismatch": "forged_producer",
    }.get(status)
    if not incident_type:
        return False
    evidence = "integrator status=%s detail=%s" % (
        status, str(receipt.get("detail") or "")[:800])
    return record_authorization_incident(
        line, task_id, incident_type, evidence)


def _complete_integrated_attempt(args, candidate, receipt):
    """Mechanical completion gate for an integrator receipt; cmd_try_complete still solely writes done."""
    task = pick(args.line, args.task)
    if not task:
        return 1
    expected = workspace_contract_paths(task)
    candidate_oid = receipt.get("candidate_oid")
    landed_oid = receipt.get("landed_commit")
    if (receipt.get("schema_version") != "cortex-integrator/receipt-v2"
            or receipt.get("status") != "landed"
            or candidate_oid != candidate.get("candidate_oid")
            or receipt.get("candidate_ref") != candidate.get("candidate_ref")
            or receipt.get("base_oid") != candidate.get("base_oid")
            or not re.fullmatch(r"[0-9a-f]{40}", landed_oid or "")
            or sorted(receipt.get("allowed_paths") or []) != sorted(expected["writable_paths"])
            or receipt.get("short_test") != expected["short_test"]
            or (receipt.get("safety_gates") or {}).get("v4_secret_gate") != "passed"):
        if receipt.get("status") == "landed":
            record_authorization_incident(
                args.line, task["id"], "forged_producer",
                "integrator landed receipt lineage/contract mismatch candidate=%s" % (
                    str(receipt.get("candidate_oid") or "")[:40]))
        cmd_try_complete.last_failure = {
            "stage": "integration-receipt", "rc": 1,
            "detail": "integrator receipt lineage/contract mismatch",
        }
        return 1
    remote = receipt.get("canonical_remote") or "origin"
    remote_ref = receipt.get("canonical_ref") or "refs/heads/master"
    tracking_ref = "refs/remotes/cortex-complete/%s" % hashlib.sha256(
        (str(remote) + "\0" + str(remote_ref)).encode()).hexdigest()[:16]
    code, out = _git_net_retry(
        "fetch --quiet %s '+%s:%s'" % (
            shlex.quote(remote), shlex.quote(remote_ref), shlex.quote(tracking_ref)),
        timeout=180, attempts=3, label="verify_landed")
    remote_oid = rev_ref(tracking_ref) if code == 0 else ""
    landed_is_ancestor = (bool(remote_oid)
                          and git("merge-base --is-ancestor %s %s" % (
                              landed_oid, remote_oid), timeout=60)[0] == 0)
    if not landed_is_ancestor:
        cmd_try_complete.last_failure = {
            "stage": "integration-pending", "rc": 75,
            "candidate_oid": candidate_oid, "landed_oid": landed_oid,
            "detail": "landed_oid is not yet confirmed as an ancestor of the current canonical tip: %s" % (
                out.strip()[-240:] if code != 0 else remote_oid),
        }
        return 75
    if not set_cells(tasks_path(args.line), task["id"], {
            "status": "done", "fails": "0", "next_advance_after": "-",
            "updated_at": fmt(now()), "evidence": expected["artifact_paths"][0],
    }, expected_status=("running", "pending", "settling", "done")):
        return 75
    final_task = pick(args.line, task["id"])
    if not final_task:
        cmd_try_complete.last_failure = {
            "stage": "terminal-contract", "rc": 75,
            "detail": "task status is unreadable after write; refusing to claim terminal",
        }
        return 75
    final_task = dict(final_task)
    final_task["_line"] = args.line
    terminal_ok, terminal_detail = _publish_terminal_run_contract(
        candidate, final_task, receipt)
    if not terminal_ok:
        # The candidate is already safely integrated, but terminal projection is
        # not.  Reopen the controller state as settling rather than letting a
        # bare done cell masquerade as a cross-surface terminal contract.
        set_cells(tasks_path(args.line), task["id"], {
            "status": "settling", "updated_at": fmt(now()),
        }, expected_status="done")
        cmd_try_complete.last_failure = {
            "stage": "terminal-contract", "rc": 75,
            "candidate_oid": candidate_oid, "landed_oid": landed_oid,
            "detail": terminal_detail,
        }
        print("DEFER %s: candidate has landed, but the terminal run-contract was not published: %s" % (
            task["id"], terminal_detail))
        return 75
    delivery = {
        "stage": "canonical-landed", "candidate_oid": candidate_oid,
        "landed_oid": landed_oid, "canonical_ref": remote_ref,
        "terminal_contract_ref": terminal_detail,
        "attempt": candidate["attempt"], "run_id": candidate["run_id"],
    }
    cmd_try_complete.last_failure = {}
    cmd_try_complete.last_delivery = [delivery]
    log("done %s/%s attempt=%s candidate_oid=%s landed_oid=%s" % (
        args.line, task["id"], candidate["attempt"], candidate_oid[:12], landed_oid[:12]))
    print("PASS %s → done (attempt %s · candidate_oid=%s · landed_oid=%s)" % (
        task["id"], candidate["attempt"], candidate_oid[:12], landed_oid[:12]))
    return 0


def _release_workspace_attempt(candidate):
    broker = os.path.join(ROOT, "bin", "cortex-workspace.sh")
    cmd = "CORTEX_WORKSPACE_REPO_ROOT=%s bash %s release --attempt %s" % (
        shlex.quote(ROOT), shlex.quote(broker), shlex.quote(candidate["attempt"]))
    return run(cmd, timeout=180)


def _load_latest_attempt_record(line, task_id, suffix, root=None):
    root = root or _attempt_state_root()
    if not os.path.isdir(root):
        return None
    matches = []
    for name in os.listdir(root):
        if not name.endswith(suffix):
            continue
        path = os.path.join(root, name)
        try:
            with open(path, encoding="utf-8") as fh:
                item = json.load(fh)
        except (OSError, json.JSONDecodeError):
            continue
        if item.get("line") == line and item.get("task") == task_id:
            matches.append((os.path.getmtime(path), item))
    return max(matches, default=(0, None), key=lambda pair: pair[0])[1]


def _load_latest_candidate(line, task_id):
    root = _candidate_receipt_root()
    if not os.path.isdir(root):
        return None
    matches = []
    for name in os.listdir(root):
        if not name.endswith(".json"):
            continue
        path = os.path.join(root, name)
        try:
            with open(path, encoding="utf-8") as fh:
                receipt = json.load(fh)
            attempt = receipt.get("attempt")
            with open(os.path.join(_attempt_state_root(), "%s.claim.json" % attempt),
                      encoding="utf-8") as fh:
                claim = json.load(fh)
        except (OSError, TypeError, json.JSONDecodeError):
            continue
        if claim.get("line") == line and claim.get("task") == task_id:
            merged = dict(claim)
            merged.update(receipt)
            merged["writable_paths"] = claim["writable_paths"]
            merged["artifact_paths"] = claim["artifact_paths"]
            merged["read_paths"] = claim["read_paths"]
            merged["short_test"] = claim["short_test"]
            matches.append((os.path.getmtime(path), merged))
    return max(matches, default=(0, None), key=lambda pair: pair[0])[1]


def _load_latest_attempt_claim(line, task_id):
    return _load_latest_attempt_record(line, task_id, ".claim.json")


def _workspace_has_changes(worktree):
    if not worktree or not os.path.isdir(worktree):
        return False
    try:
        return bool(_workspace_changed_paths(worktree))
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return False


def _adapter_transport_category(result_path):
    """Read the adapter's stable network failure category, if present."""
    values = {}
    try:
        with open(result_path, encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                key, sep, value = raw.rstrip("\n").partition("=")
                if sep and key in {"timeout_reason", "error_category"}:
                    values[key] = value.strip()
    except OSError:
        return ""
    for key in ("error_category", "timeout_reason"):
        category = values.get(key, "")
        if category in {"network_timeout", "network_error"}:
            return category
    return ""


def _salvage_post_edit_transport(attempt, task, result_path, category):
    """Run short_test after network failure only for a changed artifact.

    A transport error is not success evidence. This narrow path preserves a
    genuine native edit and lets ordinary candidate/integration gates decide
    delivery; unchanged base artifacts or failed tests remain failed.
    """
    if category not in {"network_timeout", "network_error"}:
        return False, "unsupported transport category"
    worktree = attempt.get("worktree") or ""
    if not worktree or not os.path.isdir(worktree):
        return False, "attempt worktree missing"
    artifacts = [p for p in (task.get("artifact_paths") or "").split()
                 if p and p != "-"]
    if not artifacts:
        return False, "artifact_paths empty"
    try:
        changed = set(os.path.normpath(p) for p in _workspace_changed_paths(worktree))
    except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
        return False, "changed paths unreadable: %s" % exc
    changed_artifacts = [p for p in artifacts if os.path.normpath(p) in changed]
    if not changed_artifacts:
        return False, "artifact exists only in base; no post-edit change"
    for rel in artifacts:
        full = os.path.join(worktree, rel)
        if not os.path.isfile(full) or os.path.getsize(full) == 0:
            return False, "artifact missing or empty: %s" % rel

    native_events = 0
    try:
        with open(result_path, encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                if raw.startswith("native_tool_events="):
                    native_events = int(raw.partition("=")[2].strip())
                    break
    except (OSError, ValueError):
        native_events = 0
    if native_events < 1:
        return False, "native_tool_events missing or zero"

    short_test = (task.get("short_test") or "").strip()
    if not short_test or short_test == "-":
        return False, "short_test missing"
    code, output = run(
        "cd %s && %s" % (shlex.quote(worktree), short_test), timeout=600)
    detail = output.strip()[-800:] or "short_test produced no output"
    append_attempt_event(attempt, {
        "delivery_stage": "post-edit-transport-salvage",
        "transport_error": category,
        "native_tool_edit": True,
        "native_tool_events": native_events,
        "short_test_pass": code == 0,
        "artifact_paths": changed_artifacts,
        "artifact_ok": code == 0,
        "candidate_landed": False,
        "terminal_complete": False,
        "detail": detail,
    })
    if code != 0:
        return False, "short_test rc=%d: %s" % (code, detail)
    return True, "post-edit short_test PASS; transport_error=%s" % category


def retry_workspace_integration(line, task):
    candidate = _load_latest_candidate(line, task["id"])
    if not candidate or not os.path.isdir(candidate.get("worktree", "")):
        return False, 1
    started = time.monotonic()
    code, receipt = run_workspace_integrator(candidate)
    record_authorization_from_integration(line, task["id"], receipt)
    integration_ms = int((time.monotonic() - started) * 1000)
    append_attempt_event(candidate, {
        "queue_wait_ms": None, "run_ms": None,
        "integration_ms": integration_ms,
        "workspace_kb": _workspace_kb(candidate["worktree"]),
        "cas_retry_count": _attempt_cas_retry_count(candidate) + (
            1 if receipt.get("status") == "retryable_cas_conflict" else 0),
        "integration_status": receipt.get("status"),
        "landed_oid": receipt.get("landed_commit"),
    })
    if (receipt.get("status") == "retryable_content_conflict"
            and _attempt_content_conflict_count(candidate)
            >= INTEGRATION_CONTENT_CONFLICT_MAX_RETRIES):
        blocker = {
            "stage": "integration-pending",
            "candidate_oid": candidate["candidate_oid"],
            "landed_oid": receipt.get("landed_commit") or "",
            "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
            "attempt": candidate["attempt"],
        }
        append_attempt_event(candidate, {
            "integration_status": "machine_blocker_content_conflict",
            "machine_blocker": "content_conflict_unresolved",
            "candidate_landed": False,
            "terminal_complete": False,
            "detail": receipt.get("detail", "candidate content conflicts with latest canonical"),
        })
        rc = _mark_content_conflict_blocked(
            tasks_path(line), task, candidate["artifact_paths"],
            receipt.get("detail", "candidate content conflicts with latest canonical"),
            blocker)
        return True, rc
    if code == 0 and receipt.get("status") == "landed":
        args = argparse.Namespace(line=line, task=task["id"], judge=False,
                                  integration=(candidate, receipt))
        rc = cmd_try_complete(args)
        if rc == 0:
            _release_workspace_attempt(candidate)
        return True, rc
    if code == 75 or str(receipt.get("status", "")).startswith("retryable_"):
        _mark_settling(tasks_path(line), task, candidate["artifact_paths"],
                       receipt.get("detail", "integration retry pending"), {
                           "stage": "integration-pending",
                           "candidate_oid": candidate["candidate_oid"],
                           "landed_oid": receipt.get("landed_commit") or "",
                           "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
                           "attempt": candidate["attempt"],
                       })
        return True, 0
    return True, code or 1


def _git_tx_lock_busy():
    """Whether the shared commit transaction lock is held (non-blocking read; used only to decide skip/settling)."""
    code, gp = git("rev-parse --git-path ob1-transaction.lock.d", timeout=10)
    path = (gp or "").strip() if code == 0 else ""
    if not path:
        path = os.path.join(ROOT, ".git", "ob1-transaction.lock.d")
    elif not os.path.isabs(path):
        path = os.path.join(ROOT, path)
    return os.path.isdir(path)


def land_is_retriable(detail):
    """Whether a land/push failure should enter settling (the work is already verified green; only propagation remains).

    A permanent failure (path out of bounds, helper missing) returns False and should hard-FAIL.
    Lock busy / push rejected / network returns True; do not demote "short_test already passed" back to "no work done".
    """
    d = (detail or "")
    dl = d.lower()
    retriable_markers = (
        "\u53e6\u4e00\u63d0\u4ea4\u4e8b\u52a1",
        "rc=75",
        "exit 75",
        "index.lock",
        "unable to create",
        "could not write index",
        "git-sync",
        "push \u5931\u8d25",
        "rejected",
        "non-fast-forward",
        "fetch first",
        "timed out",
        "timeout",
        "network",
        "connection",
        "temporarily unavailable",
        "remote hung up",
        "lock",
    )
    return any(m.lower() in dl or m in d for m in retriable_markers)


def land_task_artifacts(line, task_id, artifacts):
    """Cheap workers must not use git; the completion gate requires tracked+origin. The loop commits by pathspec and pushes.

    Honor the cheap.sh wording "Cortex validates and commits after you return".
    Touch only the task's declared artifact_paths (plus that task's short_test when it is a dirty script under checks/).
    Return (ok, detail); no committable change still counts as ok.

    Execution and settlement are decoupled: after short_test has passed, if the caller gets ok=False and land_is_retriable,
    it should mark settling rather than pretend the work was not done.
    """
    to_land = []
    for rel in artifacts:
        if not rel or rel == "-":
            continue
        repo_rel = _artifact_repo_rel(rel)
        if repo_rel is None:
            return False, "artifact is outside the repo boundary %s" % rel
        full = os.path.join(ROOT, repo_rel)
        if not os.path.exists(full):
            continue  # a missing file is reported by the caller artifact section
        quoted = shlex.quote(repo_rel)
        code, status = git(
            "-c core.fsmonitor=false status --porcelain=v1 --untracked-files=all -- %s"
            % quoted, timeout=60)
        if code != 0:
            return False, "unable to check artifact status %s: %s" % (
                repo_rel, status.strip()[:200])
        if status.strip():
            to_land.append(repo_rel)
            continue
        # Clean but untracked (very rare) still needs to land
        code, tracked = git("ls-files -- %s" % quoted, timeout=30)
        if code != 0 or not tracked.strip():
            to_land.append(repo_rel)

    if not to_land:
        return True, "artifacts already clean"

    # The root worktree is the scheduler/ledger control plane and is no longer a worker commit area. Any real write can only
    # come from the cortex-workspace attempt's independent index, then be handed to the integrator to land on canonical.
    # A read-only recheck of an already-clean tree is allowed here, but fail closed as soon as add/commit is required.
    return False, "root-worktree-write-forbidden: artifact must land in the attempt workspace"


def _canonical_tip_for_path(ref, refresh=False, cache=None):
    """Resolve the canonical tip; the completion gate may refresh, but task-show read-only mode never refreshes."""
    cache = cache if cache is not None else {}
    key = (ref, bool(refresh))
    if key in cache:
        return cache[key]

    effective_ref = ref
    remote_code, remote_url = git("remote get-url origin", timeout=30)
    if (not os.environ.get("CORTEX_CANONICAL_REF")
            and remote_code == 0
            and (remote_url.strip().startswith("/") or remote_url.strip().startswith("file://"))
            and git("rev-parse --verify %s^{commit}" % shlex.quote(ref), timeout=30)[0] != 0
            and git("rev-parse --verify refs/remotes/origin/main^{commit}", timeout=30)[0] == 0):
        effective_ref = "refs/remotes/origin/main"

    if refresh and effective_ref.startswith("refs/remotes/origin/"):
        branch = effective_ref[len("refs/remotes/origin/"):]
        code, out = _git_net_retry(
            "fetch --quiet origin '+refs/heads/%s:%s'" % (
                shlex.quote(branch), shlex.quote(effective_ref)),
            timeout=180, attempts=3, label="fetch_canonical_content",
        )
        if code != 0:
            result = (False, effective_ref, "", "canonical UNKNOWN: %s" % (
                out.strip().split("\n")[-1][:180] or "fetch produced no output"))
            cache[key] = result
            return result

    code, tip = git("rev-parse --verify %s^{commit}" % shlex.quote(effective_ref), timeout=30)
    tip = tip.strip().split("\n")[-1] if tip.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", tip):
        result = (False, effective_ref, "", "canonical ref cannot be resolved: %s" % effective_ref)
    else:
        result = (True, effective_ref, tip, "")
    cache[key] = result
    return result


def _inspect_artifact_canonical_binding(rel, refresh=False, cache=None):
    """Prove by one criterion that path content has already landed on canonical, so integrator squash/replay is allowed.

    Requirements: the local path exists, is non-empty, tracked, clean, and bound to the source commit;
    the canonical ref resolves, and the blob OID of source commit:path matches the blob OID of canonical tip:path
    exactly. Commit ancestry is diagnostic only and no longer incorrectly rejects a content-equivalent landing.
    """
    cache = cache if cache is not None else {}
    item = {
        "path": rel,
        "local": {"state": "UNKNOWN", "detail": "not checked yet"},
        "commit": {"state": "UNKNOWN", "candidate_oid": "", "blob_oid": "",
                   "detail": "not checked yet"},
        "origin": {"state": "UNKNOWN", "detail": "not checked yet"},
        "canonical": {
            "state": "UNKNOWN", "ref": canonical_origin_ref(), "landed_oid": "",
            "blob_oid": "", "proof": "", "detail": "not checked yet",
        },
        "stage": "artifact-path", "rc": 1,
    }
    repo_rel = _artifact_repo_rel(rel)
    if repo_rel is None:
        item["local"] = {"state": "NO", "detail": "artifact is outside the repo boundary"}
        item["detail"] = "%s: artifact is outside the repo boundary" % rel
        return item
    full = os.path.join(ROOT, repo_rel)
    if not os.path.exists(full):
        item["local"] = {"state": "NO", "detail": "artifact does not exist"}
        item["detail"] = "%s: artifact does not exist" % repo_rel
        return item
    if os.path.isfile(full) and os.path.getsize(full) == 0:
        item["local"] = {"state": "NO", "detail": "artifact is an empty file"}
        item["detail"] = "%s: artifact is an empty file" % repo_rel
        return item
    item["local"] = {"state": "YES", "detail": "artifact exists and is non-empty"}
    quoted = shlex.quote(repo_rel)

    code, tracked = git("ls-files -- %s" % quoted, timeout=30)
    if code != 0:
        item["commit"].update({"detail": "git ls-files could not be read"})
        item.update({"stage": "commit-binding", "rc": code or 1,
                     "detail": "%s: git ls-files could not be read" % repo_rel})
        return item
    if not tracked.strip():
        item["commit"].update({"state": "NO", "detail": "artifact is not yet in git"})
        item.update({"stage": "commit-binding", "rc": 1,
                     "detail": "%s: artifact is not yet in git" % repo_rel})
        return item

    code, status = git(
        "-c core.fsmonitor=false status --porcelain=v1 --untracked-files=all -- %s"
        % quoted, timeout=30)
    if code != 0:
        item["commit"].update({"detail": "git status could not be read"})
        item.update({"stage": "artifact-clean", "rc": code,
                     "detail": "%s: git status could not be read" % repo_rel})
        return item
    if status.strip():
        item["commit"].update({"state": "NO", "detail": "artifact has uncommitted changes"})
        item.update({"stage": "artifact-clean", "rc": 1,
                     "detail": "%s: artifact has uncommitted changes" % repo_rel})
        return item

    code, commit = git("log -1 --format=%%H -- %s" % quoted, timeout=30)
    commit = commit.strip().split("\n")[-1] if commit.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", commit):
        item["commit"].update({"detail": "artifact binding commit not found"})
        item.update({"stage": "commit-binding", "rc": code or 1,
                     "detail": "%s: artifact binding commit not found" % repo_rel})
        return item
    code, _ = git("diff --quiet %s -- %s" % (commit, quoted), timeout=30)
    if code != 0:
        item["commit"].update({"state": "NO", "candidate_oid": commit,
                               "detail": "current content does not match the bound commit"})
        item.update({"stage": "commit-binding", "rc": code,
                     "detail": "%s@%s: current content does not match the bound commit" % (repo_rel, commit[:12])})
        return item
    code, local_blob = git("rev-parse --verify %s:%s" % (commit, quoted), timeout=30)
    local_blob = local_blob.strip().split("\n")[-1] if local_blob.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", local_blob):
        item["commit"].update({"state": "UNKNOWN", "candidate_oid": commit,
                               "detail": "unable to resolve source commit:path blob"})
        item.update({"stage": "commit-binding", "rc": code or 1,
                     "detail": "%s@%s: unable to resolve source blob" % (repo_rel, commit[:12])})
        return item
    item["commit"].update({"state": "YES", "candidate_oid": commit,
                           "blob_oid": local_blob, "detail": "current content is bound to the commit blob"})
    item["candidate_oid"] = commit

    origin_ok, origin_detail = _commit_on_local_origin_refs(commit)
    item["origin"] = ({"state": "YES", "detail": "cached origin ref can reach the source candidate"}
                      if origin_ok else {
                          "state": "UNKNOWN",
                          "detail": "%s; source commit may be unreachable because of squash/replay" % origin_detail,
                      })

    ok_tip, effective_ref, tip, tip_detail = _canonical_tip_for_path(
        canonical_origin_ref(), refresh=refresh, cache=cache)
    item["canonical"].update({"ref": effective_ref, "landed_oid": tip})
    item["canonical_ref"] = effective_ref
    item["landed_oid"] = tip
    if not ok_tip:
        item["canonical"]["detail"] = tip_detail
        item.update({"stage": "integration-pending", "rc": 75, "detail": tip_detail})
        return item
    code, canonical_blob = git("rev-parse --verify %s:%s" % (tip, quoted), timeout=30)
    canonical_blob = canonical_blob.strip().split("\n")[-1] if canonical_blob.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", canonical_blob):
        detail = "%s@%s: canonical tip does not contain this path" % (repo_rel, tip[:12])
        item["canonical"].update({"state": "NO", "detail": detail})
        item.update({"stage": "integration-pending", "rc": 1, "detail": detail})
        return item
    item["canonical"]["blob_oid"] = canonical_blob
    if local_blob != canonical_blob:
        detail = ("%s: canonical content differs (source_blob=%s canonical_blob=%s)" % (
            repo_rel, local_blob[:12], canonical_blob[:12]))
        item["canonical"].update({"state": "NO", "detail": detail})
        item.update({"stage": "integration-pending", "rc": 1, "detail": detail})
        return item

    ancestor = git("merge-base --is-ancestor %s %s" % (commit, tip), timeout=30)[0] == 0
    proof = "ancestor+exact-blob" if ancestor else "content-equivalent"
    detail = ("%s@%s: %s canonical landing; source blob exact match with %s@%s" % (
        repo_rel, commit[:12], proof, effective_ref, tip[:12]))
    item["canonical"].update({
        "state": "YES", "proof": proof, "detail": detail,
    })
    item.update({
        "stage": "canonical-landed", "rc": 0,
        "candidate_oid": commit, "landed_oid": tip, "canonical_ref": effective_ref,
        "proof": proof, "detail": detail,
    })
    return item


def _validate_artifact_delivery(rel, origin_cache=None):
    """The completion gate and task-show share the exact-blob canonical landing criterion."""
    binding = _inspect_artifact_canonical_binding(
        rel, refresh=True, cache=origin_cache if origin_cache is not None else {})
    return binding.get("stage") == "canonical-landed", binding


def _inspect_worktree_canonical_content_binding(rel, refresh=False, cache=None):
    """Root control-plane fast path: worktree content already matches canonical tip:path.

    After the attempt/integrator has landed the artifact/check on canonical, the root worktree may
    still look dirty against local HEAD (local branch behind or diverged), but the control plane must not add/commit
    the artifact again because of that. This only proves two things: the file content local short_test actually read, and the blob
    for the same path on the canonical tip, are identical. If they differ, the original land gate still fail-closes.
    """
    cache = cache if cache is not None else {}
    repo_rel = _artifact_repo_rel(rel)
    item = {
        "path": rel,
        "stage": "worktree-canonical-content",
        "rc": 1,
        "canonical_ref": canonical_origin_ref(),
        "landed_oid": "",
        "proof": "",
        "detail": "not checked yet",
    }
    if repo_rel is None:
        item["detail"] = "%s: artifact is outside the repo boundary" % rel
        return False, item
    full = os.path.join(ROOT, repo_rel)
    if not os.path.exists(full):
        item["detail"] = "%s: artifact does not exist" % repo_rel
        return False, item
    if os.path.isfile(full) and os.path.getsize(full) == 0:
        item["detail"] = "%s: artifact is an empty file" % repo_rel
        return False, item
    ok_tip, effective_ref, tip, tip_detail = _canonical_tip_for_path(
        canonical_origin_ref(), refresh=refresh, cache=cache)
    item["canonical_ref"] = effective_ref
    item["landed_oid"] = tip
    if not ok_tip:
        item["stage"] = "integration-pending"
        item["rc"] = 75
        item["detail"] = tip_detail
        return False, item
    quoted = shlex.quote(repo_rel)
    code, canonical_blob = git("rev-parse --verify %s:%s" % (tip, quoted), timeout=30)
    canonical_blob = canonical_blob.strip().split("\n")[-1] if canonical_blob.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", canonical_blob):
        item["stage"] = "integration-pending"
        item["detail"] = "%s@%s: canonical tip does not contain this path" % (repo_rel, tip[:12])
        return False, item
    code, worktree_blob = git("hash-object -- %s" % quoted, timeout=30)
    worktree_blob = worktree_blob.strip().split("\n")[-1] if worktree_blob.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", worktree_blob):
        item["detail"] = "%s: unable to hash the worktree blob" % repo_rel
        return False, item
    if worktree_blob != canonical_blob:
        item["detail"] = ("%s: worktree content has not landed on canonical (worktree_blob=%s canonical_blob=%s)"
                          % (repo_rel, worktree_blob[:12], canonical_blob[:12]))
        return False, item
    detail = ("%s: worktree content exact match with %s@%s; root control plane does not need to land the artifact again"
              % (repo_rel, effective_ref, tip[:12]))
    item.update({
        "stage": "canonical-landed", "rc": 0,
        "candidate_oid": "", "landed_oid": tip,
        "canonical_ref": effective_ref,
        "blob_oid": worktree_blob,
        "proof": "worktree-content-equivalent",
        "detail": detail,
    })
    return True, item


def _try_complete_land_paths(task, artifacts, test):
    land_paths = list(artifacts)
    if test.startswith("bash brain-network/directions/") and "/checks/" in test:
        maybe = test.split()[-1] if test.split() else ""
        if maybe.endswith(".sh") and os.path.isfile(os.path.join(ROOT, maybe)):
            land_paths.append(maybe)
    return land_paths


def _mark_settling(path, task, artifacts, land_detail, delivery=None):
    """short_test has passed and git propagation is temporarily unavailable, so this enters settling (a third state, not a failure)."""
    updates = {
        "status": "settling", "updated_at": fmt(now()),
        "next_advance_after": "-",
    }
    if artifacts:
        updates["evidence"] = artifacts[0]
    set_cells(path, task["id"], updates)
    log("settling %s land=%s" % (task["id"], (land_detail or "")[:200]))
    print("SETTLING %s → short_test passed, git propagation deferred (%s)"
          % (task["id"], (land_detail or "")[:240]))
    print("      execution side is already green; the next tick only lands and does not claim an LLM again")
    failure = {
        "stage": "artifact-land-deferred", "rc": 0,
        "detail": (land_detail or "")[:1200],
    }
    if isinstance(delivery, dict):
        failure["delivery_stage"] = delivery.get("stage", "")
        for key in ("candidate_oid", "landed_oid", "canonical_ref", "path"):
            if key in delivery:
                failure[key] = delivery[key]
    cmd_try_complete.last_failure = failure
    cmd_try_complete.last_delivery = delivery or {}
    return 0


def _mark_content_conflict_blocked(path, task, artifacts, detail, delivery=None):
    """Stop an exhausted content-conflict loop without manufacturing terminal success."""
    updates = {
        "status": "blocked", "updated_at": fmt(now()),
        "next_advance_after": "-",
    }
    if artifacts:
        updates["evidence"] = artifacts[0]
    set_cells(path, task["id"], updates, expected_status=("settling", "running"))
    reason = "MACHINE_BLOCKER: content_conflict_unresolved after bounded retries"
    log("MACHINE_BLOCKER %s integration=%s" % (task["id"], (detail or "")[:200]))
    print("MACHINE_BLOCKER %s → %s" % (task["id"], reason))
    failure = {
        "stage": "integration-content-conflict",
        "rc": 75,
        "integration_status": "machine_blocker_content_conflict",
        "machine_blocker": "content_conflict_unresolved",
        "detail": (detail or "")[:1200],
    }
    if isinstance(delivery, dict):
        failure.update({key: delivery[key] for key in (
            "candidate_oid", "landed_oid", "canonical_ref", "attempt"
        ) if key in delivery})
    cmd_try_complete.last_failure = failure
    cmd_try_complete.last_delivery = delivery or {}
    return 1


def _finalize_done_after_land(args, path, task, artifacts, land_paths, test):
    """Origin gate, optional checks re-verification, judge, and writing done. Land must already be ok before this is called."""
    origin_cache = {}
    deliveries = []
    # Artifacts and the same task's checks are both delivery contracts. Checking only the artifact would allow "the report has landed,
    # but the acceptance script is still only on this machine" as a false completion; every land_paths entry must exact-blob land on canonical.
    for rel in land_paths:
        # The completion gate's first criterion is that the worktree content short_test actually read already
        # matches the canonical tip:path exact blob. That stays compatible with integrator squash/replay
        # and with a root control plane that is dirty relative to local HEAD; when they are not equivalent, fall back to the original
        # source-commit/canonical binding gate and stay fail-closed.
        valid, binding = _inspect_worktree_canonical_content_binding(
            rel, refresh=False, cache=origin_cache)
        if not valid:
            valid, binding = _validate_artifact_delivery(rel, origin_cache)
        if not valid:
            detail = binding.get("detail", "") if isinstance(binding, dict) else str(binding)
            if land_is_retriable(detail) or (
                isinstance(binding, dict)
                and binding.get("stage") in ("origin-reachable", "integration-pending")
            ):
                return _mark_settling(path, task, artifacts, detail, binding)
            cmd_try_complete.last_failure = binding
            print("FAIL %s: %s" % (task["id"], detail))
            return 1
        deliveries.append(binding)

    if any("/checks/" in (p or "") for p in land_paths):
        code, out = run("cd %s && %s" % (ROOT, test), timeout=600)
        if code != 0:
            cmd_try_complete.last_failure = {
                "stage": "short_test", "rc": code,
                "detail": "re-verification failed after landing checks: " + (out.strip()[:1000] or "no output"),
            }
            print("FAIL %s: short_test re-verification failed after landing\n%s" % (
                task["id"], out.strip()[:600]))
            return 1

    if getattr(args, "judge", False):
        executor = next((e.get("executor", "human") for e in clock_lines()
                         if e["line"] == args.line), "human")
        if executor != "human":
            v_exec, v_node, tier = pick_verifier(executor, node_profile())
            if v_exec is None:
                print("      ⚠️ no independent verifier -- this run is **mechanical gate only**, and does not pretend an AI review happened")
                v_exec = None
            else:
                print("      independent verification: %s@%s (%s)" % (v_exec, v_node, tier))
            verdict, reason = (("ACCEPT", "no independent verifier, skipped") if v_exec is None
                               else ai_judge(args.line, v_exec, task))
            if verdict == "REJECT":
                cmd_try_complete.last_failure = {
                    "stage": "judge", "rc": 1, "detail": reason[:1200],
                }
                set_cell(path, task["id"], "updated_at", fmt(now()))
                log("judge REJECT %s/%s %s" % (args.line, task["id"], reason))
                print("FAIL %s: mechanical gate passed, but the AI reviewer rejected -- %s" % (task["id"], reason))
                return 1

    latest = pick(args.line, task["id"]) or task
    already_done = latest.get("status") == "done"
    if not set_cells(path, task["id"], {
        "status": "done", "fails": "0", "next_advance_after": "-",
        "updated_at": fmt(now()), "evidence": artifacts[0],
    }, expected_status=("pending", "running", "settling", "done")):
        cmd_try_complete.last_failure = {
            "stage": "state-cas", "rc": 75,
            "detail": "the controller already changed task status; the completion gate did not overwrite the new state",
        }
        print("DEFER %s: status was changed by the controller and was not overwritten to done" % task["id"])
        return 75
    delivery_note = ",".join(
        "%s:candidate_oid=%s landed_oid=%s" % (
            d.get("path", "-"), d.get("candidate_oid", "")[:12],
            d.get("landed_oid", "")[:12]) for d in deliveries)
    log("done %s/%s %s" % (args.line, task["id"], delivery_note))
    print("PASS %s → done (evidence %s)" % (task["id"], artifacts[0]))
    if deliveries:
        print("      landing | candidate_oid=%s · landed_oid=%s · %s" % (
            deliveries[0].get("candidate_oid", "")[:12],
            deliveries[0].get("landed_oid", "")[:12],
            deliveries[0].get("canonical_ref", canonical_origin_ref())))
    if already_done:
        print("      credit | already done; repeat verification does not score again (anti-farming)")
    else:
        auto_credit_decided(args.line, task["id"], task.get("title", ""))
    cmd_try_complete.last_failure = {}
    cmd_try_complete.last_delivery = deliveries
    return 0


def settle_line_tasks(line):
    """Settle only status=settling tasks: no claim, no LLM, only land to origin to done.

    Return how many were successfully written as done. If git is still busy, stay settling and do not send the task back to pending.

    Iron rule (2026-08-01): **when the git transaction lock is busy, return 0 for the whole batch immediately**, do not run short_test,
    and do not spin through items one by one. Otherwise settle consumes the whole beat and pending never reaches claim (running=0).
    """
    path = tasks_path(line)
    settled = 0
    n_settling = sum(1 for t in load_tasks(line) if t.get("status") == "settling")
    if n_settling == 0:
        return 0
    # Lock busy: skip the whole batch and leave this beat's time for claiming pending
    if _git_tx_lock_busy():
        msg = ("settle| %s git transaction busy → skip %d settling tasks, claim pending first"
               % (line, n_settling))
        print(msg)
        log(msg)
        return 0
    for task in load_tasks(line):
        if task.get("status") != "settling":
            continue
        # Lock taken again inside the loop: stop immediately; do not continue short_test/land
        if _git_tx_lock_busy():
            msg = ("settle| %s git transaction became busy mid-way → abort the remaining settle tasks and go claim"
                   % line)
            print(msg)
            log(msg)
            break
        tid = task["id"]
        handled, integration_rc = retry_workspace_integration(line, task)
        if handled:
            if integration_rc == 0 and (pick(line, tid) or {}).get("status") == "done":
                settled += 1
                print("settle| %s attempt candidate → canonical → done" % tid)
            elif integration_rc != 0:
                print("settle| %s integration still incomplete rc=%s, keeping the workspace" % (
                    tid, integration_rc))
            continue
        artifacts = [a for a in (task.get("artifact_paths") or "").split()
                     if a and a != "-"]
        if not artifacts:
            continue
        missing = False
        for rel in artifacts:
            full = rel if os.path.isabs(rel) else os.path.join(ROOT, rel)
            if not os.path.exists(full) or (
                    os.path.isfile(full) and os.path.getsize(full) == 0):
                print("settle| %s artifact lost, returning to pending to redo" % tid)
                set_cell(path, tid, "status", "pending")
                set_cell(path, tid, "updated_at", fmt(now()))
                missing = True
                break
        if missing:
            continue
        test = (task.get("short_test") or "").strip()
        if not test or test == "-":
            continue
        # Light re-check: propagate only while the on-disk truth is still there (tighter timeout: a settling re-check must not stall the whole beat)
        code, out = run("cd %s && %s" % (ROOT, test), timeout=90)
        if code != 0:
            print("settle| %s short_test no longer green → pending (%s)"
                  % (tid, out.strip()[:120]))
            set_cell(path, tid, "status", "pending")
            set_cell(path, tid, "updated_at", fmt(now()))
            continue
        if _git_tx_lock_busy():
            print("settle| %s git transaction still busy, staying settling (abort the remaining settle)" % tid)
            break
        land_paths = _try_complete_land_paths(task, artifacts, test)
        ok_land, land_detail = land_task_artifacts(line, tid, land_paths)
        if not ok_land:
            if land_is_retriable(land_detail):
                print("settle| %s land still deferred: %s" % (tid, land_detail[:160]))
                set_cell(path, tid, "updated_at", fmt(now()))
                # Retriable cases are usually git/origin: do not keep blocking the settling tasks that follow
                if _git_tx_lock_busy() or "transaction" in (land_detail or "").lower() \
                        or "busy" in (land_detail or "").lower() \
                        or "SSL" in (land_detail or ""):
                    print("settle| %s propagation deferred → abort the remaining settle and go claim" % tid)
                    break
            else:
                print("settle| %s land permanently failed → pending: %s"
                      % (tid, land_detail[:160]))
                set_cell(path, tid, "status", "pending")
                set_cell(path, tid, "updated_at", fmt(now()))
            continue
        # Reuse finalize: build a minimal args
        args = argparse.Namespace(line=line, task=tid, judge=False)
        rc = _finalize_done_after_land(args, path, task, artifacts, land_paths, test)
        if rc == 0 and pick(line, tid) and pick(line, tid).get("status") == "done":
            settled += 1
            print("settle| %s → done" % tid)
        elif rc == 0:
            # stay settling
            pass
    return settled


def cmd_try_complete(args):
    cmd_try_complete.last_failure = {}
    cmd_try_complete.last_delivery = {}
    integration = getattr(args, "integration", None)
    if integration:
        candidate, receipt = integration
        return _complete_integrated_attempt(args, candidate, receipt)
    path = tasks_path(args.line)
    task = pick(args.line, args.task)
    if not task:
        cmd_try_complete.last_failure = {
            "stage": "contract", "rc": 1, "detail": "task does not exist",
        }
        print("task not found %s" % args.task, file=sys.stderr)
        return 1
    if is_negative_test_sentinel(args.line, task):
        cmd_try_complete.last_failure = {
            "stage": "sentinel", "rc": 1,
            "detail": "the negative-test sentinel must stay blocked/red by contract",
        }
        print("FAIL %s: negative-test sentinel must not complete; its red status is the completion-gate evidence" % task["id"])
        return 1

    artifacts = [a for a in (task.get("artifact_paths") or "").split() if a and a != "-"]
    if not artifacts:
        cmd_try_complete.last_failure = {
            "stage": "artifact", "rc": 1, "detail": "no artifact_paths",
        }
        print("FAIL %s: no artifact_paths, refusing done" % task["id"])
        return 1
    for rel in artifacts:
        full = rel if os.path.isabs(rel) else os.path.join(ROOT, rel)
        if not os.path.exists(full):
            cmd_try_complete.last_failure = {
                "stage": "artifact", "rc": 1, "detail": "artifact missing %s" % rel,
            }
            print("FAIL %s: artifact missing %s" % (task["id"], rel))
            return 1
        if os.path.isfile(full) and os.path.getsize(full) == 0:
            cmd_try_complete.last_failure = {
                "stage": "artifact", "rc": 1, "detail": "artifact empty file %s" % rel,
            }
            print("FAIL %s: artifact empty file %s" % (task["id"], rel))
            return 1

    test = (task.get("short_test") or "").strip()
    if not test or test == "-":
        cmd_try_complete.last_failure = {
            "stage": "contract", "rc": 1, "detail": "no short_test",
        }
        print("FAIL %s: no short_test, refusing done" % task["id"])
        return 1

    # Run short_test first (trust the on-disk truth), then the land+origin gate.
    # Order: correctness before propagation; do not commit garbage that was never written correctly.
    # Settling tasks re-run short_test too, so a stale product is not propagated.
    code, out = run("cd %s && %s" % (ROOT, test), timeout=600)
    if code != 0:
        # If it was settling but the workspace is now broken, return to pending so the execution side redoes the work
        if task.get("status") == "settling":
            set_cells(path, task["id"], {
                "status": "pending", "updated_at": fmt(now()),
            }, expected_status="settling")
            print("FAIL %s: short_test turned red during settling → returning to pending" % task["id"])
        cmd_try_complete.last_failure = {
            "stage": "short_test", "rc": code,
            "detail": out.strip()[:1200] or "short_test produced no output",
        }
        print("FAIL %s: short_test exit code %d\n%s" % (task["id"], code, out.strip()[:600]))
        return 1

    # Cheap workers must not use git, so the loop commits an exact pathspec; propagation is left to git-sync V4
    land_paths = _try_complete_land_paths(task, artifacts, test)
    origin_cache = {}
    canonical_ready = True
    for rel in land_paths:
        # The root control plane only rechecks canonical content equivalence; it does not re-land the artifact.
        # Fetch is intentionally skipped here: the integrator/sync layer already refreshes refs/remotes/origin/*;
        # if try-complete fell back to land_task_artifacts because a network refresh failed, it would treat "already landed on canonical,
        # while the root worktree is still dirty against local HEAD" as a failure and misread that normal state as
        # root-worktree-write-forbidden.
        valid, _binding = _inspect_worktree_canonical_content_binding(
            rel, refresh=False, cache=origin_cache)
        if not valid:
            canonical_ready = False
            break
    if canonical_ready:
        return _finalize_done_after_land(
            args, path, task, artifacts, land_paths, test)

    # When the transaction lock is busy: do not spin waiting on git; go straight to settling (the execution side is already green)
    if _git_tx_lock_busy():
        return _mark_settling(
            path, task, artifacts,
            "git commit transaction lock busy — short_test passed, propagation deferred")

    ok_land, land_detail = land_task_artifacts(args.line, task["id"], land_paths)
    if not ok_land:
        if land_is_retriable(land_detail):
            return _mark_settling(path, task, artifacts, land_detail)
        cmd_try_complete.last_failure = {
            "stage": "artifact-land", "rc": 1, "detail": land_detail[:1200],
        }
        print("FAIL %s: artifact landing failed — %s" % (task["id"], land_detail[:400]))
        return 1

    return _finalize_done_after_land(
        args, path, task, artifacts, land_paths, test)


# ── tick: heartbeat body ─────────────────────────────────────────────────────

def escalate(line, task, days):
    tier = "D+7 into daily report" if days >= 7 else ("D+3 post to Discord" if days >= 3 else "D+0 report")
    msg = "ESCALATE %s/%s stuck for %d days (%s): %s" % (line, task["id"], days, tier, task.get("title"))
    print(msg)
    log(msg)
    if days >= 3 and os.environ.get("CORTEX_LOOP_ESCALATE") == "1":
        run("python3 %s/work-studio/devops/tools/openclaw/discord.py send "
            "'#AI\u4f53\u7cfb\u5efa\u8bbe' %s" % (ROOT, repr(msg)))


SYSTEMIC_FAIL_STATE = "/tmp/spotlight/cortex-loop-systemic-fail-escalate.json"
SYSTEMIC_FAIL_MIN_TASKS = 3      # >=3 distinct tasks sharing one failure signature means "the pipeline is broken", not "this task is hard"
SYSTEMIC_FAIL_MIN_FAILS = 2      # a single task counts only after at least 2 failures (do not count a first one-off)
SYSTEMIC_FAIL_COOLDOWN_SEC = 3 * 3600   # the same signature is reported once per 3 hours, not spammed


def _result_signature(line, task_id):
    """Extract a failure signature from the tail of an adapter result file. Anchor only the rc= that belongs to the `[adapter] ...` line itself,
    and do not treat an arbitrary "rc=" in the body as the signature. AI reports often contain
    narrative lines like "ran `xxx.sh` → rc=0 PASS". An early implementation misread that kind of text as a "systemic
    infra failure" (3 tasks were wrongly grouped under one signature because each report mentioned rc=0, when they were actually
    three unrelated real task-quality gaps, not the same bug).

    If the adapter's own rc=0 (execution really succeeded) but the task still attempt-fails, the block is the task's own
    acceptance criteria not being met: a content problem, not a pipeline problem. Classify it on its own and keep it out of systemic stats.
    Many tasks each missing their own content bar is a normal "the work is not finished yet", and must not alarm as "the infrastructure is broken".
    """
    path = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task_id)
    if not os.path.isfile(path):
        failure = load_failure_context(line, task_id)
        if not failure:
            return None
        if failure.get("stage") == "adapter" and int(failure.get("rc") or 0) != 0:
            return "adapter-rc=%s" % failure.get("rc")
        return "content-fail"
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            tail = fh.readlines()[-8:]
    except OSError:
        return None
    for ln in reversed(tail):
        if not ln.startswith("[adapter]"):
            continue
        m = re.search(r"\brc=(\d+)\b", ln)
        if not m:
            continue
        rc = m.group(1)
        if rc == "0":
            return "content-fail"   # adapter succeeded; the task's own acceptance failed, so this is not systemic
        return "adapter-rc=%s" % rc
    return None


def _systemic_fail_signature_groups(line):
    """Pure computation with no side effects: group current tasks by failure signature (keep only those past the MIN_FAILS bar).

    detect_systemic_failure() and the read-only systemic-status subcommand share this logic.
    The 2026-07-31 dashboard priority reorder needs a live judgment of "is a systemic failure suspected right now",
    but detect_systemic_failure() itself writes the state file, sends Discord, and is rate-limited by a 3h cooldown,
    so the dashboard cannot call it on every render (that would repeat alerts and pollute cooldown state). This
    pure function was split out so each caller decides whether to have side effects, and the criterion does not fork.
    """
    sig_tasks = {}
    for task in load_tasks(line):
        if is_negative_test_sentinel(line, task):
            continue
        try:
            fails = int(task.get("fails") or 0)
        except ValueError:
            fails = 0
        if fails < SYSTEMIC_FAIL_MIN_FAILS:
            continue
        sig = _result_signature(line, task["id"])
        if not sig or sig == "content-fail":
            continue   # the task's own acceptance failed; the tasks are unrelated and are not counted in systemic stats
        sig_tasks.setdefault(sig, []).append(task["id"])
    return sig_tasks


def detect_systemic_failure(line):
    """Tell "this task is hard" from "the whole pipeline is broken". GROUND rule, N steps: what the system itself judges must not
    wait for a 3-day Discord threshold before a person learns it. The same failure signature hitting >=3 distinct tasks is judged directly as
    an infra-level systemic failure and reported immediately (not subject to escalate()'s D+3 day throttle), rather than letting each
    task escalate slowly on its own. In the early hours of 2026-07-31 a cheap.sh routing bug left 7+ tasks
    quietly retrying until dawn, and nobody realized within a few hours that it was the same root cause.
    """
    sig_tasks = _systemic_fail_signature_groups(line)

    try:
        with open(SYSTEMIC_FAIL_STATE, "r", encoding="utf-8") as fh:
            state = json.load(fh)
    except (OSError, ValueError):
        state = {}

    fired = []
    for sig, ids in sig_tasks.items():
        if len(ids) < SYSTEMIC_FAIL_MIN_TASKS:
            continue
        key = "%s:%s" % (line, sig)
        last = state.get(key, 0)
        if time.time() - last < SYSTEMIC_FAIL_COOLDOWN_SEC:
            continue
        msg = ("SYSTEMIC-FAIL %s signature %s hit %d distinct tasks (%s) — "
               "suspected infra-level failure, not one hard task; report now, do not wait for D+3") % (
            line, sig, len(ids), ",".join(sorted(ids)[:6]))
        print(msg)
        log(msg)
        if os.environ.get("CORTEX_LOOP_ESCALATE") == "1":
            run("python3 %s/work-studio/devops/tools/openclaw/discord.py send "
                "'#AI\u4f53\u7cfb\u5efa\u8bbe' %s" % (ROOT, repr(msg)))
        state[key] = time.time()
        fired.append(sig)

    if fired:
        os.makedirs(os.path.dirname(SYSTEMIC_FAIL_STATE), exist_ok=True)
        with open(SYSTEMIC_FAIL_STATE, "w", encoding="utf-8") as fh:
            json.dump(state, fh)
    return fired


def cmd_systemic_status(args):
    """Read-only subcommand: whether any signal currently hits the systemic-failure threshold (>=3 distinct tasks, same failure signature).

    Added for the 2026-07-31 dashboard priority reorder. The white box needs to know, at render time, that "the
    whole pipeline may be broken", and cannot wait until the next tick for detect_systemic_failure() to actually fire
    and write the state file. This command has zero side effects: it does not write SYSTEMIC_FAIL_STATE, does not send Discord,
    and is not limited by the 3h cooldown. It only reads the same signature-grouping logic (_systemic_fail_signature_groups)
    and reports the judgment for right now; historical fire records in the state file are only a last_escalated_at reference.
    """
    lines = [args.line] if args.line else [entry["line"] for entry in clock_lines()]
    try:
        with open(SYSTEMIC_FAIL_STATE, "r", encoding="utf-8") as fh:
            state = json.load(fh)
    except (OSError, ValueError):
        state = {}

    out = {"lines": [], "any_active": False}
    for line in lines:
        groups = _systemic_fail_signature_groups(line)
        sigs = []
        for sig, ids in groups.items():
            if len(ids) < SYSTEMIC_FAIL_MIN_TASKS:
                continue
            key = "%s:%s" % (line, sig)
            last = state.get(key)
            sigs.append({
                "signature": sig,
                "task_ids": sorted(ids),
                "count": len(ids),
                "last_escalated_at": (
                    datetime.utcfromtimestamp(last).isoformat() + "Z" if last else None
                ),
            })
        if sigs:
            out["any_active"] = True
        out["lines"].append({"line": line, "signatures": sigs})

    if getattr(args, "json", False):
        print(json.dumps(out, ensure_ascii=False))
    else:
        if not out["any_active"]:
            print("SYSTEMIC-STATUS: no systemic-failure signal")
        for entry in out["lines"]:
            for sig in entry["signatures"]:
                print("SYSTEMIC-STATUS %s signature %s hit %d tasks: %s"
                      % (entry["line"], sig["signature"], sig["count"],
                         ",".join(sig["task_ids"])))
    return 0


# ── explain: unified ground-truth explanation entry (node/task/mechanism, one format, IMM-T31)────
# Motivation: checking the real state of a node, task, or mechanism used to mean grepping logs by hand, reading TASKS.md,
# and assembling several commands. Three-part output (status / why / evidence) uses one format for all three target types,
# machine-parseable, and a person can follow the evidence and check it. This is not "trust what the AI said"; the AI points at
# where to look. ATOMIZE rule: reuse the existing haas_score/read_swarm/load_tasks/
# node_id/_systemic_fail_signature_groups, and do not invent a new criterion.

EXPLAIN_TOPICS = {}  # topic name → handler; adding a topic only needs one registration line, no if-elif


def _explain_register(name):
    def deco(fn):
        EXPLAIN_TOPICS[name] = fn
        return fn
    return deco


def _explain_fmt(target, status_line, why_lines, evidence_lines):
    """Unified three-part renderer: status / why / evidence. The node, task, and topic target types
    share one format, so downstream scripts only have to recognize this output, not parse three formats."""
    out = ["EXPLAIN %s" % target]
    out.append("status: %s" % (status_line or "-"))
    why_lines = [w for w in (why_lines or []) if w] or ["(none)"]
    evidence_lines = [e for e in (evidence_lines or []) if e] or ["(none)"]
    out.append("why: %s" % why_lines[0])
    for extra in why_lines[1:]:
        out.append("      %s" % extra)
    out.append("evidence: %s" % evidence_lines[0])
    for extra in evidence_lines[1:]:
        out.append("      %s" % extra)
    return "\n".join(out)


def _node_file_snapshot(node):
    """Fields in the local git snapshot file (_swarm/<node>.md). This file can be out of sync with the ref layer
    (a node may never commit+push its own profile file back to origin). The only reason this function exists
    is to expose the gap between "what the file appears to say" and "what the ref layer really is"."""
    path = os.path.join(SWARM, "%s.md" % node)
    if not os.path.isfile(path):
        return None
    _, _, rows = read_table(path, key="field")
    return {r["field"]: r["value"] for _, r in rows if r.get("field")}


def explain_node(node_arg):
    """Explain a node: alive or not (precise ref-layer heartbeat versus the local snapshot gap), plus the trust score (HAAS),
    plus what it has been running lately. Read only refs already present locally (same behavior as cmd_swarm/cmd_status),
    do not call fetch_refs(), and add no implicit network call."""
    nodes = read_swarm()
    prof = nodes.get(node_arg)
    if prof is None:
        return None
    alive, alive_why = node_alive(prof)
    score, meta = haas_score(node_arg)
    level = trust_level(score)
    precise = beat_ref_precise_seen(prof)
    beat_ref = "%s/%s" % (BEAT_NS, node_arg)

    status_line = "%s | HAAS=%.3f(%s) | owns=%s" % (
        "alive" if alive else "possibly offline", score, level, prof.get("owns", "-"))

    why = [
        "liveness: %s (quiet_limit=%dh, can_sleep=%s)"
        % (alive_why, quiet_limit(prof), prof.get("can_sleep", "?")),
        "HAAS composition: %s" % meta.get("note", "-"),
    ]

    # Looks-like versus really-is: the gap between local snapshot fields and the ref layer's precise heartbeat time.
    # This is the real root cause of the 2026-07-31 worker case (IMM-T30): the worker heartbeat was actually
    # running the whole time (the ref layer pushes every beat), but _swarm/worker.md was never commit+pushed back to
    # origin, so a laptop that only reads the file misjudges the node as offline.
    snap = _node_file_snapshot(node_arg)
    if snap is not None and precise is not None:
        snap_seen = parse_ts(snap.get("last_seen"))
        if snap_seen is not None:
            gap_h = (precise - snap_seen).total_seconds() / 3600
            if gap_h > 1:
                why.append(
                    "⚠️ looks-like vs really-is: local snapshot last_seen=%s lags the ref-layer measured heartbeat by %.1fh"
                    " — the node heartbeat has actually been running the whole time; this .md file was just not"
                    " commit+pushed back to origin. Reading only the file misjudges it as offline; the ref layer is the source of truth"
                    % (snap.get("last_seen"), gap_h))
    elif precise is None:
        why.append("the local ref layer has no precise heartbeat time (the local repo may not have fetched, or this node never pushed a heartbeat)")

    evidence = [
        "beat ref: %s (commit time=%s)"
        % (beat_ref, fmt(precise) if precise else "unreadable"),
        "haas sample: RESULT_NS=%s samples=%s effective=%s incidents=%s"
        % (RESULT_NS, meta.get("samples"), meta.get("effective_samples"), meta.get("incidents")),
        "local snapshot file: brain-network/directions/_swarm/%s.md (last_seen=%s)"
        % (node_arg, (snap or {}).get("last_seen", "file does not exist")),
        "recheck command: git log -1 --format=%%ci %s" % beat_ref,
    ]
    return _explain_fmt("node=%s" % node_arg, status_line, why, evidence)


def _find_credit_for_task(line, task_id):
    """Find this task's scoring event under RESULT_NS. The task_id naming convention changed (IMM-T12 added
    a line prefix; before that the id was a bare id such as "T20"), so an old credit ref detail may still use the old form.
    If an exact match misses, fall back to the short id with the prefix removed, and record in the evidence which match was used.
    Return (node, when, kind, gate, ref, matched_by), or None."""
    short_id = task_id.rsplit("-", 1)[-1] if "-" in task_id else task_id
    exact = "%s/%s " % (line, task_id)
    fallback = "%s/%s " % (line, short_id)
    best = None
    for ref in list_refs(RESULT_NS):
        kv = parse_kv(read_ref(ref))
        detail = kv.get("detail", "")
        matched_by = None
        if detail.startswith(exact):
            matched_by = "exact id"
        elif short_id != task_id and detail.startswith(fallback):
            matched_by = "legacy short id (before rename)"
        if matched_by is None:
            continue
        when = kv.get("finished") or kv.get("event_at") or "-"
        if best is None or when > best[1]:
            best = (kv.get("node", "-"), when, kv.get("kind", "-"), kv.get("gate", "-"),
                    ref, matched_by)
    return best


def _extract_result_summary(path, max_chars=500):
    """Pull a human-readable summary from an adapter/cortex receipt instead of pasting the whole file. Prefer the
    body under the one-line-status heading; if that heading is absent, fall back to the last body lines after dropping [adapter]/[cortex] marker lines.
    Both receipt styles should yield a meaningful why, not just the word blocked."""
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            lines = fh.read().split("\n")
    except OSError:
        return None
    for idx, ln in enumerate(lines):
        if "\u4e00\u53e5\u8bdd\u72b6\u6001" in ln:
            tail = [t.strip() for t in lines[idx + 1:]
                    if t.strip() and not t.startswith("[adapter]") and not t.startswith("[cortex]")]
            if tail:
                return " ".join(tail)[:max_chars]
    body = [ln.strip() for ln in lines
            if ln.strip() and not ln.startswith("[adapter]") and not ln.startswith("[cortex]")]
    if not body:
        return None
    return " ".join(body[-3:])[:max_chars]


def explain_task(arg):
    """Explain one task: current status and fails; when blocked or pending with a failure record, pull the real blocker
    from the execution receipt (not just the word blocked); when done, say who did it,
    when, and whether it was scored."""
    if "/" not in arg:
        return None
    line, task_id = arg.split("/", 1)
    path = tasks_path(line)
    if not os.path.isfile(path):
        return None
    task = next((t for t in load_tasks(line) if t.get("id") == task_id), None)
    if task is None:
        return None

    status = task.get("status", "?")
    try:
        fails = int(task.get("fails") or 0)
    except ValueError:
        fails = 0
    status_line = "status=%s fails=%d | %s" % (status, fails, task.get("title", "-"))

    why, evidence = [], []
    result_path = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task_id)

    if status == "done":
        credit = _find_credit_for_task(line, task_id)
        if credit:
            node, when, kind, gate, ref, matched_by = credit
            why.append("completed and scored by %s at %s (kind=%s gate=%s, match=%s)"
                       % (node, when, kind, gate, matched_by))
            evidence.append("credit ref: %s" % ref)
        else:
            why.append("status=done, but no matching credit event was found under %s"
                       " (scoring may predate the mechanism, or it never went through try-complete auto-scoring)" % RESULT_NS)
            evidence.append("searched %s by both exact id and legacy short id; neither hit" % RESULT_NS)
        why.append("output evidence column evidence=%s" % (task.get("evidence") or "-"))
        evidence.append("task row source: %s (id=%s)" % (path, task_id))
    elif status in ("blocked", "pending", "waiting_external") and fails > 0:
        summary = _extract_result_summary(result_path)
        if summary:
            why.append("latest execution receipt summary: %s" % summary)
            evidence.append("execution receipt file: %s" % result_path)
        else:
            why.append("fails=%d but this machine has no matching receipt file (it may have run on another node, or the receipt was cleaned up)"
                       % fails)
            evidence.append("lookup path (does not exist): %s" % result_path)
        why.append("known failure modes (failure_modes column): %s" % (task.get("failure_modes") or "-"))
        evidence.append("task row source: %s (id=%s)" % (path, task_id))
    else:
        why.append("success_criteria: %s" % (task.get("success_criteria") or "-"))
        evidence.append("task row source: %s (id=%s)" % (path, task_id))

    return _explain_fmt("task=%s/%s" % (line, task_id), status_line, why, evidence)


@_explain_register("systemic-failure")
def _explain_topic_systemic_failure():
    """Reuse _systemic_fail_signature_groups (the same criterion, not a second copy):
    whether any failure signature hits at least SYSTEMIC_FAIL_MIN_TASKS distinct tasks. That is "the pipeline is broken",
    not "this task is hard". Zero side effects: do not write SYSTEMIC_FAIL_STATE and do not send Discord."""
    active = []
    lines_checked = []
    for entry in clock_lines():
        line = entry["line"]
        lines_checked.append(line)
        groups = _systemic_fail_signature_groups(line)
        for sig, ids in groups.items():
            if len(ids) >= SYSTEMIC_FAIL_MIN_TASKS:
                active.append((line, sig, sorted(ids)))

    if active:
        status_line = "%d lines hit a systemic-failure signature (threshold >=%d distinct tasks with the same signature)" % (
            len(active), SYSTEMIC_FAIL_MIN_TASKS)
        why = ["hits: " + "; ".join("%s signature=%s tasks=%s" % (ln, sig, ",".join(ids[:6]))
                                    for ln, sig, ids in active)]
    else:
        status_line = "no systemic-failure signature is currently hit (scanned %d lines)" % len(lines_checked)
        why = ["grouped tasks with fails>=%d by adapter failure signature on each line, and found no single signature covering >=%d distinct tasks"
               % (SYSTEMIC_FAIL_MIN_FAILS, SYSTEMIC_FAIL_MIN_TASKS)]
    why.append("criterion: adapter rc=0 while the task is not met is marked content-fail and is excluded from systemic stats"
               " (unrelated content problems are not a broken pipeline)")
    evidence = [
        "criterion functions: bin/cortex-loop _systemic_fail_signature_groups() / detect_systemic_failure()",
        "cooldown/last-report state file: %s" % SYSTEMIC_FAIL_STATE,
        "receipt source: /tmp/spotlight/cortex-loop-<line>-<task_id>.result",
        "equivalent read-only command: cortex-loop systemic-status --json",
    ]
    return status_line, why, evidence


@_explain_register("credit-mechanism")
def _explain_topic_credit_mechanism():
    """Current scoring-mechanism state: how many credit events are under RESULT_NS, the distribution by kind,
    and whether the mechanism is past the cold-start backfill window. Reuse the existing KIND_WEIGHT and MECHANISM_LIVE constants."""
    refs = list_refs(RESULT_NS)
    by_kind = {}
    latest = None
    for ref in refs:
        kv = parse_kv(read_ref(ref))
        kind = kv.get("kind", "?")
        by_kind[kind] = by_kind.get(kind, 0) + 1
        when = kv.get("finished") or kv.get("event_at") or ""
        if when and (latest is None or when > latest[0]):
            latest = (when, kv.get("node", "-"), kind, ref)

    live_dt = parse_ts(MECHANISM_LIVE)
    live_note = ("past MECHANISM_LIVE=%s (new events count only when they carry a legal kind)" % MECHANISM_LIVE
                 if live_dt and now() >= live_dt else
                 "not yet at MECHANISM_LIVE=%s (still inside the cold-start backfill grace period)" % MECHANISM_LIVE)

    status_line = "%d credit events in total, by kind: %s" % (
        len(refs), (" ".join("%s=%d" % kv for kv in sorted(by_kind.items())) or "(none)"))
    why = [
        "weight table KIND_WEIGHT: L1 decided/self-fixed=1.0 · L2 defect-reported=1.5 · "
        "L3 defect-fixed=2.0 · L4 correct-refusal=3.0 · L5 mechanism-adopted=5.0",
        "mechanism live status: %s" % live_note,
    ]
    if latest:
        why.append("latest: %s @ %s (kind=%s)" % (latest[1], latest[0], latest[2]))
    evidence = [
        "ref namespace: RESULT_NS=%s" % RESULT_NS,
        "scoring functions: bin/cortex-loop auto_credit_decided() / cmd_credit()",
        "weight definitions: bin/cortex-loop KIND_WEIGHT / MECHANISM_LIVE",
    ]
    if latest:
        evidence.append("latest event ref: %s" % latest[3])
    return status_line, why, evidence


@_explain_register("resource-gate")
def _explain_topic_resource_gate():
    """Current executor quota-gate state: among executors this node has declared, which are in suppression
    (quota exhausted or auth failure). Reuse the existing suppression check and state file; do not recompute the criterion."""
    prof = node_profile()
    executors = [e for e in (prof.get("executors") or "").split() if e]
    rows = [(name,) + exec_suppressed(name) for name in executors]
    suppressed_n = sum(1 for _, hushed, _, _ in rows if hushed)

    status_line = "this node has %d declared executors, %d of them in suppression" % (len(executors), suppressed_n)
    why = [
        "per executor: " + ("; ".join(
            "%s=%s" % (n, ("suppressed (%s, %dmin left)" % (k, l) if h else "available"))
            for n, h, k, l in rows) or "(this node declared no executors)"),
        "llm-heavy tasks are admitted only when the executor is not suppressed and its adapter file exists, by "
        "select_task_rows; quota suppression auto-expires after a %dh window, while auth/config suppression needs a person" % QUOTA_WINDOW_H,
    ]
    evidence = [
        "suppression state file: %s" % EXEC_STATE,
        "criterion source: the two suppression functions in bin/cortex-loop (the check uses the suppressed suffix / "
        "the writer uses the suppress prefix)",
        "node profile source: node_profile().executors (computed live on this machine, not cached)",
    ]
    return status_line, why, evidence


def cmd_explain(args):
    target = "?"
    try:
        if args.node:
            target = "node=%s" % args.node
            out = explain_node(args.node)
        elif args.task:
            target = "task=%s" % args.task
            out = explain_task(args.task)
        elif args.topic:
            target = "topic=%s" % args.topic
            handler = EXPLAIN_TOPICS.get(args.topic)
            if handler is None:
                out = None
            else:
                status_line, why, evidence = handler()
                out = _explain_fmt(target, status_line, why, evidence)
        else:
            print("UNKNOWN: one of --node / --task / --topic is required", file=sys.stderr)
            return 2
    except Exception as diag_exc:  # noqa: BLE001 — explain is a diagnostic entry; internal exceptions must degrade
        # to a readable message instead of dumping a Python traceback; a diagnostic tool crashing is worse than "not found".
        print("UNKNOWN: %s hit an internal error during the query (%s: %s)"
              % (target, type(diag_exc).__name__, diag_exc))
        return 1
    if out is None:
        print("UNKNOWN: %s does not exist or could not be found" % target)
        return 1
    print(out)
    return 0


def _task_lock_path(line, task_id):
    token = hashlib.sha256((line + "\0" + task_id).encode("utf-8")).hexdigest()[:20]
    return "/tmp/spotlight/cortex-task-%s.lock" % token


def acquire_task_lock(line, task_id):
    """Exclude only a duplicate worker on the same task; different tasks do not block each other."""
    key = (line, task_id)
    if key in _TASK_LOCK_HANDLES:
        return True
    os.makedirs("/tmp/spotlight", exist_ok=True)
    handle = open(_task_lock_path(line, task_id), "a+", encoding="utf-8")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        return False
    handle.seek(0)
    handle.truncate()
    handle.write(str(os.getpid()))
    handle.flush()
    _TASK_LOCK_HANDLES[key] = handle
    return True


def task_lock_busy(line, task_id):
    """Read-only probe of whether the task Worker is still alive; do not guess from a stale PID file."""
    handle = open(_task_lock_path(line, task_id), "a+", encoding="utf-8")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        return True
    fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    handle.close()
    return False


def _retry_delay_min(fails):
    """Failure retries cap at 15/30/60/120 minutes; a success window must not be used to punish a failure."""
    return min(15 * (2 ** max(0, fails - 1)), 120)


TASK_CONTRACT_FIELDS = (
    "title", "depends_on", "success_criteria", "failure_modes",
    "artifact_paths", "short_test", "leverage", "cost_estimate", "resource_class", "role",
)


def _short_test_snapshot(task):
    parts = shlex.split((task.get("short_test") or "").strip())
    if not parts:
        return None, None
    candidate = parts[-1]
    full = candidate if os.path.isabs(candidate) else os.path.join(ROOT, candidate)
    if not os.path.isfile(full):
        return full, None
    with open(full, "rb") as fh:
        return full, fh.read()


def enforce_execution_bounds(line, original, test_path, test_bytes):
    """An executor may change produced code, but not the task contract, status, or its own acceptance measure."""
    path = tasks_path(line)
    fresh = pick(line, original["id"]) or {}
    violations = []
    for field in TASK_CONTRACT_FIELDS:
        if fresh.get(field, "") != original.get(field, ""):
            set_cell(path, original["id"], field, original.get(field, "") or "-")
            violations.append("task.%s" % field)
    if fresh.get("status") != "running":
        set_cell(path, original["id"], "status", "running")
        violations.append("task.status")
    if fresh.get("evidence") not in ("", "-"):
        set_cell(path, original["id"], "evidence", "-")
        violations.append("task.evidence")
    if test_path and test_bytes is not None and os.path.isfile(test_path):
        with open(test_path, "rb") as fh:
            current = fh.read()
        if current != test_bytes:
            with open(test_path, "wb") as fh:
                fh.write(test_bytes)
            violations.append("short_test")
    if violations:
        detail = "%s/%s unauthorized change to %s, mechanically restored" % (
            line, original["id"], ",".join(violations))
        record_incident(node_id(), "C1-out-of-bounds", detail)
        record_authorization_incident(
            line, original["id"], "out_of_scope_write", detail)
        log("execution-boundary VIOLATION %s" % detail)
        print("guard | %s" % detail)
    return not violations


def _guard_paths(line, task_id):
    stem = "/tmp/spotlight/cortex-loop-%s-%s" % (line, task_id)
    return stem + ".guard.json", stem + ".short-test.snapshot"


def write_execution_guard(line, task, test_path, test_bytes):
    meta_path, snapshot_path = _guard_paths(line, task["id"])
    with open(meta_path, "w", encoding="utf-8") as fh:
        json.dump({"task": task, "test_path": test_path}, fh, ensure_ascii=False)
    if test_bytes is not None:
        with open(snapshot_path, "wb") as fh:
            fh.write(test_bytes)


def load_execution_guard(line, task_id):
    meta_path, snapshot_path = _guard_paths(line, task_id)
    if not os.path.isfile(meta_path):
        return None
    with open(meta_path, encoding="utf-8") as fh:
        meta = json.load(fh)
    test_bytes = None
    if os.path.isfile(snapshot_path):
        with open(snapshot_path, "rb") as fh:
            test_bytes = fh.read()
    return meta.get("task") or {}, meta.get("test_path"), test_bytes


def _mark_attempt_failed(line, task, executor, rc, adapter_succeeded, failure=None):
    failure = failure or {
        "stage": "adapter" if not adapter_succeeded else "unknown",
        "rc": rc, "detail": "uncaught failure output",
    }
    fresh = pick(line, task["id"]) or {}
    try:
        fails = int(fresh.get("fails") or 0) + 1
    except ValueError:
        fails = 1
    retry_min = _retry_delay_min(fails)
    path = tasks_path(line)
    if not set_cells(path, task["id"], {
            "fails": str(fails), "status": "pending",
            "next_advance_after": fmt(now() + timedelta(minutes=retry_min)),
            "updated_at": fmt(now()),
    }, expected_status=("running", "pending")):
        log("attempt FAIL %s/%s status was rewritten by the controller; keeping the new status" % (line, task["id"]))
        return rc
    print("fail  | %s/%s rc=%d retry=+%dmin fails=%d"
          % (line, task["id"], rc, retry_min, fails))
    log("attempt FAIL %s/%s rc=%d retry=+%dmin fails=%d"
        % (line, task["id"], rc, retry_min, fails))
    failure = persist_failure_context(line, task["id"], failure)
    result_file = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task["id"])
    try:
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex-failure] %s\n" % json.dumps(
                failure, ensure_ascii=False, sort_keys=True))
    except OSError:
        pass
    if adapter_succeeded and fails >= 2 and executor != "human":
        ai_diagnose(line, executor, fresh or task, fails, failure=failure)
    return rc


def recover_completed_attempt(line, task, executor):
    """After the parent dies, the next tick resumes acceptance from the attempt state and does not drop finished work.

    Recovery priority:
      1. A published candidate receipt: retry integration directly.
      2. A dirty attempt worktree: go through candidate -> integration again.
      3. A legacy result file: submit/try-complete along the old path.

    Item 2 is the key to restart recovery. A reboot kills the parent worker and the /tmp result file,
    but the independent sparse worktree remains on disk. Relying only on the result file treats real intermediate artifacts
    as if they "never happened", which causes a repeat claim and another model burn.
    """
    candidate = _load_latest_candidate(line, task["id"])
    if candidate and os.path.isdir(candidate.get("worktree", "")):
        print("recover | %s/%s found candidate attempt=%s → retry integration" % (
            line, task["id"], candidate["attempt"]))
        handled, _rc = retry_workspace_integration(line, task)
        return handled
    attempt = _load_latest_attempt_claim(line, task["id"])
    if attempt and _workspace_has_changes(attempt.get("worktree")):
        print("recover | %s/%s found dirty attempt worktree=%s → continue candidate/integration" % (
            line, task["id"], attempt["attempt"]))
        try:
            candidate = commit_workspace_candidate(attempt, task)
        except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
            _mark_attempt_failed(line, task, executor, 2, True, failure={
                "stage": "candidate-recovery", "rc": 2, "detail": str(exc),
                "attempt": attempt.get("attempt"), "worktree": attempt.get("worktree"),
            })
            return True
        code, receipt = run_workspace_integrator(candidate)
        record_authorization_from_integration(line, task["id"], receipt)
        append_attempt_event(candidate, {
            "queue_wait_ms": None, "run_ms": None, "integration_ms": None,
            "workspace_kb": _workspace_kb(candidate["worktree"]),
            "cas_retry_count": _attempt_cas_retry_count(candidate) + (
                1 if receipt.get("status") == "retryable_cas_conflict" else 0),
            "integration_status": receipt.get("status"),
            "landed_oid": receipt.get("landed_commit"),
            "recovery": "dirty-worktree",
        })
        if (receipt.get("status") == "retryable_content_conflict"
                and _attempt_content_conflict_count(candidate)
                >= INTEGRATION_CONTENT_CONFLICT_MAX_RETRIES):
            blocker = {
                "stage": "integration-pending",
                "candidate_oid": candidate["candidate_oid"],
                "landed_oid": receipt.get("landed_commit") or "",
                "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
                "attempt": candidate["attempt"],
            }
            append_attempt_event(candidate, {
                "integration_status": "machine_blocker_content_conflict",
                "machine_blocker": "content_conflict_unresolved",
                "candidate_landed": False,
                "terminal_complete": False,
                "detail": receipt.get("detail", "candidate content conflicts with latest canonical"),
                "recovery": "dirty-worktree",
            })
            _mark_content_conflict_blocked(
                tasks_path(line), task, candidate["artifact_paths"],
                receipt.get("detail", "candidate content conflicts with latest canonical"),
                blocker)
            return True
        if code == 0 and receipt.get("status") == "landed":
            rc = cmd_try_complete(argparse.Namespace(
                line=line, task=task["id"], judge=True,
                integration=(candidate, receipt)))
            if rc == 0:
                _release_workspace_attempt(candidate)
            return True
        if code == 75 or str(receipt.get("status", "")).startswith("retryable_"):
            _mark_settling(tasks_path(line), task, candidate["artifact_paths"],
                           receipt.get("detail", "integration pending"), {
                               "stage": "integration-pending",
                               "candidate_oid": candidate["candidate_oid"],
                               "landed_oid": receipt.get("landed_commit") or "",
                               "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
                               "attempt": candidate["attempt"],
                           })
            return True
        _mark_attempt_failed(line, task, executor, code or 2, True, failure={
            "stage": "integration-recovery", "rc": code or 2,
            "detail": receipt.get("detail", "integration failed"),
            "attempt": candidate["attempt"], "worktree": candidate["worktree"],
        })
        return True
    result_file = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task["id"])
    if not os.path.isfile(result_file):
        return False
    with open(result_file, encoding="utf-8", errors="replace") as fh:
        body = fh.read()
    if "[cortex] consumed_at=" in body:
        return False
    marker = re.search(r"\[adapter\][^\n]*\brc=(\d+)\s*$", body, re.MULTILINE)
    if marker is None:
        return False
    adapter_rc = int(marker.group(1))
    tool_executed = (
        "tool_layer=claude-code" in body
        or "tool_layer=acp-lane" in body
        or "tool_layer=acp-native" in body
    )
    guard = load_execution_guard(line, task["id"])
    if guard:
        original, test_path, test_bytes = guard
        enforce_execution_bounds(line, original, test_path, test_bytes)
        task = original
    print("recover | %s/%s found orphan execution terminal state rc=%d → continue acceptance"
          % (line, task["id"], adapter_rc))
    cmd_submit(argparse.Namespace(line=line, task=task["id"], result=result_file,
                                  window_min=0))
    if adapter_rc == 0 and not tool_executed:
        print("recover | %s/%s is a legacy text receipt, with no tool-execution evidence" % (line, task["id"]))
        _mark_attempt_failed(line, task, executor, 96, False)
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=legacy-text\n" % fmt(now()))
        return True
    if adapter_rc != 0:
        _mark_attempt_failed(line, task, executor, adapter_rc, False)
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=adapter-fail\n" % fmt(now()))
        return True
    rc = cmd_try_complete(argparse.Namespace(line=line, task=task["id"], judge=True))
    if rc != 0:
        record_false_completion_if_claimed(
            line, task["id"], result_file,
            getattr(cmd_try_complete, "last_failure", None))
        _mark_attempt_failed(
            line, task, executor, rc, True,
            failure=getattr(cmd_try_complete, "last_failure", None),
        )
    else:
        set_cell(tasks_path(line), task["id"], "fails", "0")
        set_cell(tasks_path(line), task["id"], "next_advance_after", "-")
        print("done  | %s/%s (orphan receipt reclaimed)" % (line, task["id"]))
    with open(result_file, "a", encoding="utf-8") as fh:
        fh.write("\n[cortex] consumed_at=%s outcome=%s\n"
                 % (fmt(now()), "done" if rc == 0 else "gate-fail"))
    return True


def advance_once(line, task, executor, window_min):
    """One full advance: claim → a tool-style adapter really executes → submit → try-complete."""
    # A task may override the line default (requires_executor=acp-lane, and so on).
    executor = resolve_task_executor(task, executor)
    adapter = executor_adapter_path(executor)
    if not os.path.isfile(adapter):
        print("SKIP %s: no executor adapter %s" % (task["id"], adapter))
        return 1
    # settle-first applies only to tasks that have never failed: if the mechanical criterion is already met, there is nothing to redo.
    # A task with a failure history may have been rejected by the quality gate; do not bypass the judge and paint it green.
    try:
        prior_fails = int(task.get("fails") or 0)
    except ValueError:
        prior_fails = 0
    if prior_fails == 0:
        preflight = cmd_try_complete(
            argparse.Namespace(line=line, task=task["id"], judge=False)
        )
        if preflight == 0:
            st = (pick(line, task["id"]) or {}).get("status")
            if st == "done":
                print("settle-first | %s/%s criterion already met → done (zero model)" % (
                    line, task["id"]))
                return 0
            if st == "settling":
                # short_test already passed; git propagation is deferred. Do not enter the LLM, and do not record attempt-fail.
                print("settle-first | %s/%s short_test passed → settling (wait for git, do not burn the model)" % (
                    line, task["id"]))
                return 0
    queued_at = parse_ts(task.get("updated_at"))
    queue_wait_ms = (max(0, int((now() - queued_at).total_seconds() * 1000))
                     if queued_at is not None else None)
    if not set_cells(
        tasks_path(line), task["id"],
        {"status": "running", "updated_at": fmt(now())},
        expected_status="pending",
    ):
        print("skip | %s/%s claim CAS already taken by another Worker" % (line, task["id"]))
        return 0
    try:
        attempt = create_workspace_attempt(line, task, executor)
    except (ValueError, RuntimeError, OSError) as exc:
        return _mark_attempt_failed(line, task, executor, 2, False, failure={
            "stage": "workspace-admission", "rc": 2, "detail": str(exc),
        })
    prompt_file = "/tmp/spotlight/cortex-loop-%s-%s.prompt" % (line, task["id"])
    result_file = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task["id"])
    os.makedirs("/tmp/spotlight", exist_ok=True)
    with open(prompt_file, "w", encoding="utf-8") as fh:
        fh.write(render_prompt(line, task, executor=executor))
        fh.write("\n\n## Attempt workspace\n")
        fh.write("Your current cwd is an independent attempt worktree: %s\n" % attempt["worktree"])
        fh.write("You may only modify: %s\n" % " ".join(attempt["writable_paths"]))
        fh.write("Read-only acceptance dependencies: %s\n" % (" ".join(attempt["read_paths"]) or "-"))
    test_path, test_bytes = _short_test_snapshot(task)
    write_execution_guard(line, task, test_path, test_bytes)
    print("claim | %s/%s → running attempt=%s base=%s" % (
        line, task["id"], attempt["attempt"], attempt["base_oid"][:12]))
    print("run   | %s/%s executor=%s cwd=%s" % (
        line, task["id"], executor, attempt["worktree"]))
    log("claim %s/%s executor=%s attempt=%s run_id=%s base_oid=%s" % (
        line, task["id"], executor, attempt["attempt"], attempt["run_id"],
        attempt["base_oid"]))
    # [EX15 | T37] Start a background long-task heartbeat ticker -- so pulse/dashboard see busy
    # instead of mistaking a 30min adapter run for "the heartbeat stopped".
    # The ticker must be stopped on every adapter exit path (success/failure/timeout),
    # or the next tick leaves a zombie ticker touching a task that is no longer running.
    heartbeat_pidfile = start_long_task_heartbeat(line, task["id"])
    run_started = time.monotonic()
    try:
        if is_deterministic_backlink_task(task):
            code, out = apply_deterministic_backlink_in_workspace(
                attempt["worktree"], task)
            with open(result_file, "w", encoding="utf-8") as fh:
                fh.write(out + "\n")
            executor = "deterministic.backlink"
        else:
            env = "CORTEX_REQUIRE_WORKTREE=1 CORTEX_WORKTREE=%s CORTEX_ATTEMPT=%s " \
                  "CORTEX_RUN_ID=%s CORTEX_BASE_OID=%s " % (
                      shlex.quote(attempt["worktree"]), shlex.quote(attempt["attempt"]),
                      shlex.quote(attempt["run_id"]), shlex.quote(attempt["base_oid"]))
            code, out = run("%sbash %s %s %s" % (
                env, shlex.quote(adapter), shlex.quote(prompt_file), shlex.quote(result_file)),
                timeout=1800)
    finally:
        # However the adapter exits, the ticker must be stopped -- this is the key invariant of the busy state machine
        stop_long_task_heartbeat(heartbeat_pidfile)
    run_ms = int((time.monotonic() - run_started) * 1000)
    transport_salvage = ""
    if code != 0:
        log("adapter FAIL %s/%s rc=%d %s" % (line, task["id"], code, out.strip()[:200]))
        quota_text = out
        if os.path.isfile(result_file):
            try:
                with open(result_file, encoding="utf-8", errors="replace") as fh:
                    quota_text += "\n" + fh.read(8000)
            except OSError:
                pass
        if is_model_quota_breach(quota_text):
            record_model_quota_if_breach(
                line, task["id"], executor, quota_text,
                "workspace-adapter-quota", rc=code)
        if not os.path.isfile(result_file):
            with open(result_file, "w", encoding="utf-8") as fh:
                fh.write("[adapter failed before result] rc=%d\n%s" % (code, out[:4000]))
        transport_category = _adapter_transport_category(result_file)
        if transport_category:
            salvage, salvage_detail = _salvage_post_edit_transport(
                attempt, task, result_file, transport_category)
            if salvage:
                transport_salvage = transport_category
                print("salvage | %s/%s %s" % (
                    line, task["id"], salvage_detail))
                log("post-edit transport salvage %s/%s category=%s" % (
                    line, task["id"], transport_category))
            else:
                print("salvage-skip | %s/%s %s" % (
                    line, task["id"], salvage_detail))
    # submit only accepts the execution receipt; do not advance the success window yet. Final status is decided by the completion gate / failure retry.
    submit = argparse.Namespace(line=line, task=task["id"], result=result_file,
                                window_min=0)
    cmd_submit(submit)
    if code != 0 and not transport_salvage:
        result = _mark_attempt_failed(line, task, executor, code, False, failure={
            "stage": "adapter", "rc": code, "detail": out.strip()[:1200],
            "attempt": attempt["attempt"], "worktree": attempt["worktree"],
        })
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=adapter-fail dirty-workspace-preserved\n"
                     % fmt(now()))
        return result

    attempt["adapter_result"] = result_file
    if transport_salvage:
        attempt["transport_salvage"] = transport_salvage
    try:
        candidate = commit_workspace_candidate(attempt, task)
    except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
        result = _mark_attempt_failed(line, task, executor, 2, True, failure={
            "stage": "candidate", "rc": 2, "detail": str(exc),
            "attempt": attempt["attempt"], "worktree": attempt["worktree"],
        })
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=candidate-fail workspace-preserved\n"
                     % fmt(now()))
        return result

    integration_started = time.monotonic()
    integration_code, receipt = run_workspace_integrator(candidate)
    record_authorization_from_integration(line, task["id"], receipt)
    integration_ms = int((time.monotonic() - integration_started) * 1000)
    metrics = {
        "queue_wait_ms": queue_wait_ms,
        "run_ms": run_ms, "integration_ms": integration_ms,
        "workspace_kb": _workspace_kb(candidate["worktree"]),
        "cas_retry_count": _attempt_cas_retry_count(candidate) + (
            1 if receipt.get("status") == "retryable_cas_conflict" else 0),
    }
    append_attempt_event(candidate, dict(
        metrics, integration_status=receipt.get("status"),
        landed_oid=receipt.get("landed_commit")))
    with open(result_file, "a", encoding="utf-8") as fh:
        fh.write("\n[cortex-metrics] %s\n" % json.dumps(
            metrics, ensure_ascii=False, sort_keys=True))

    if (receipt.get("status") == "retryable_content_conflict"
            and _attempt_content_conflict_count(candidate)
            >= INTEGRATION_CONTENT_CONFLICT_MAX_RETRIES):
        blocker = {
            "stage": "integration-pending",
            "candidate_oid": candidate["candidate_oid"],
            "landed_oid": receipt.get("landed_commit") or "",
            "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
            "attempt": candidate["attempt"],
        }
        append_attempt_event(candidate, {
            "integration_status": "machine_blocker_content_conflict",
            "machine_blocker": "content_conflict_unresolved",
            "candidate_landed": False,
            "terminal_complete": False,
            "detail": receipt.get("detail", "candidate content conflicts with latest canonical"),
        })
        _mark_content_conflict_blocked(
            tasks_path(line), task, candidate["artifact_paths"],
            receipt.get("detail", "candidate content conflicts with latest canonical"),
            blocker)
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=integration-machine-blocker\n"
                     % fmt(now()))
        return 0
    if integration_code == 75 or str(receipt.get("status", "")).startswith("retryable_"):
        _mark_settling(tasks_path(line), task, candidate["artifact_paths"],
                       receipt.get("detail", "integration pending"), {
                           "stage": "integration-pending",
                           "candidate_oid": candidate["candidate_oid"],
                           "landed_oid": receipt.get("landed_commit") or "",
                           "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
                           "attempt": candidate["attempt"],
                       })
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=integration-pending\n" % fmt(now()))
        return 0
    if integration_code != 0 or receipt.get("status") != "landed":
        record_false_completion_if_claimed(
            line, task["id"], result_file, {
                "stage": "integration",
                "detail": receipt.get("detail", out.strip()[-800:]),
            })
        return _mark_attempt_failed(line, task, executor, integration_code or 2, True,
                                    failure={
            "stage": "integration", "rc": integration_code,
            "detail": receipt.get("detail", out.strip()[-800:]),
            "attempt": candidate["attempt"], "worktree": candidate["worktree"],
        })
    rc = cmd_try_complete(argparse.Namespace(
        line=line, task=task["id"], judge=True, integration=(candidate, receipt)))
    if rc == 0:
        release_code, release_out = _release_workspace_attempt(candidate)
        if release_code != 0:
            log("workspace release deferred attempt=%s %s" % (
                candidate["attempt"], release_out.strip()[-200:]))
        set_cell(tasks_path(line), task["id"], "fails", "0")
        set_cell(tasks_path(line), task["id"], "next_advance_after", "-")
        print("done  | %s/%s" % (line, task["id"]))
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=done\n" % fmt(now()))
        return 0
    record_false_completion_if_claimed(
        line, task["id"], result_file,
        getattr(cmd_try_complete, "last_failure", None))
    return _mark_attempt_failed(
        line, task, executor, rc, True,
        failure=getattr(cmd_try_complete, "last_failure", None))


def _oldest_open_plan(prefix="imm-"):
    """Return the **earliest immune-plan id this node can still actually work**; return None if there is none.

    The question is not "is this plan finished?", but **"is there still work in this plan that I can do?"** --
    those are not the same question, and treating them as the same is what caused the 2026-07-29 livelock.

    Ways one task is closed for this node (five states, not two):
      - done               finished, nothing to do
      - moot / noop        the criterion was already met, no work to do (fourth state, see MOOT_NS)
      - failed by me       this node already failed it; leave it to another node (same rule as cmd_run)
      - out of reach       C2 trust too low / missing capability -- taking it would only be blocked by the gate
      - valid lease held by someone else  this is not my work right now
    If every case above hits, this plan has nothing left **for me** and must be released so I can look for new work;
    otherwise I cling to a plan I can never finish and keep discover locked out forever.

    Pick only the earliest one: one item per tick, so clearing a backlog does not claim everything at once and avalanche.
    """
    me = node_id()
    prof = node_profile()
    _h, _ = haas_score(me)
    _trust = trust_level(_h)
    plan_sets = []
    for pid in sorted(p.rsplit("/", 1)[-1] for p in list_refs(PLAN_NS)):
        if pid.startswith(prefix):
            tasks = plan_tasks(pid)
            if tasks:
                plan_sets.append((pid, tasks))
    # Do deterministic governance fixes first: they cost no model, short_test is explicit, and propagation is
    # the orchestrator's job. Otherwise a batch of old model-style discoveries still sorts ahead of the
    # S1 cohort by string order and starves the cheap, closable tasks. Next come the other frozen
    # discoveries, and last the legacy plans that have no discovery.
    plan_sets.sort(key=lambda item: (
        not any(task.get("source") == "map-backlink-gap" for task in item[1]),
        not any(task.get("discovery_id") not in (None, "", "-") for task in item[1]),
        item[0],
    ))
    for pid, tasks in plan_sets:
        for task in tasks:
            res = parse_kv(read_ref("%s/%s/%s" % (RESULT_NS, pid, task["id"])))
            st = res.get("status")
            if st == "done":
                continue
            if st == "noop" or rev_ref("%s/%s/%s" % (MOOT_NS, pid, task["id"])):
                continue
            if st == "failed" and res.get("node") == me:
                # [EX14 | T36] Same as cmd_claim: failure != a permanent ban; retry is allowed after cooldown.
                # The old hard continue meant "I failed once → I never take this work again",
                # so this node still could not come back after the gateway/model recovered.
                _failed_at = parse_ts(res.get("failed_at"))
                if _failed_at is None or (now() - _failed_at).total_seconds() < FAIL_COOLDOWN_MIN * 60:
                    continue
                # Cooldown elapsed → allow this node to retry this old work (does not bypass fit_score/covenant)
            # Work out of reach does not count as "my old work". **This does not relax C2**; it is the opposite:
            # admitting I cannot reach it is what keeps me from clinging to it and blocking new work I can reach.
            # The criterion is the same one covenant_check / fit_score use on the execution side, so there are not two standards.
            allowed, _law, _why = covenant_check(task, prof, _trust, _h)
            if not allowed:
                continue
            if fit_score(task, prof, 0, 10 ** 6)[0] is None:
                continue
            claim = parse_kv(read_ref("%s/%s/%s" % (CLAIM_NS, pid, task["id"])))
            exp = parse_ts(claim.get("expires"))
            if claim.get("holder") and claim.get("holder") != me and exp and exp > now():
                continue
            return pid
    return None


def tick_census(day=None, period_min=15):
    """Where the day's ticks actually went -- a tick has **four states**, not two ("had output / had no output").

    Cause, 2026-07-29: the dashboard reported "load 41%, idle 59% (30/72 ticks had output)",
    and neither number held:
      - denominator = wall-clock expected tick count (now-00:00)/900 -- **ticks while the machine was asleep were included**.
        Measured today: 77 ticks expected, 50 actually logged: 08:55→10:45 empty for 110 minutes,
        11:10→12:22 empty for 72 minutes, the laptop lid was closed and it was asleep. The denominator was inflated by 54%.
        The engine's own sleep_gap_note() already knew it would sleep; nobody used that number.
      - numerator = **distinct plan ids** that have a result (and non-tick products were mixed in:
        orchestrator / real1). One tick can produce several plans, and one plan can span several ticks --
        numerator and denominator are not even the same dimension, so the percentage is meaningless.

    Four states (merging any two makes the next action wrong, so they must stay expanded):
      slept        launchd did not fire (machine slept / not loaded) → **not in the idle denominator**; that is not idle, it is absent
      productive   it ran, and really dispatched or advanced work
      settled      it ran, no new output, but judged "no work to do" as a terminal state (the ledger advanced)
      idle         it ran and did not move one step -- **only this state is truly idle**
    Fifth state unknown: log missing or format unrecognized -- its own state, never collapsed to either side (fail-open is the most dangerous).
    """
    day = day or now().strftime("%Y-%m-%d")
    out = {"date": day, "period_min": period_min, "ran": 0, "slept": 0,
           "productive": 0, "settled": 0, "idle": 0, "unknown": 0, "wall": 0}
    if not os.path.isfile(LOG):
        out["unknown"] = -1
        out["note"] = "log missing -- not inspectable, not 0"
        return out
    with open(LOG, encoding="utf-8") as fh:
        lines = [l.rstrip("\n") for l in fh if l.startswith(day)]
    seg, prev_ts = [], None
    for line in lines:
        seg.append(line)
        if "| tick " not in line:
            continue
        out["ran"] += 1
        ts = parse_ts(line.split("|")[0].strip())
        # Missing ticks are estimated only from the **real gap between two adjacent ticks**, not by subtracting from the wall-clock span --
        # the latter would also count "time that has not arrived yet today" as missing ticks.
        if prev_ts and ts:
            gap = int((ts - prev_ts).total_seconds() // 60)
            if gap > period_min * 2:
                out["slept"] += max(0, gap // period_min - 1)
        prev_ts = ts or prev_ts
        body = "\n".join(seg)
        if re.search(r"\| (run |advance |auto-dispatch |reclaim )", body):
            out["productive"] += 1
        elif "progress=0 fallthrough" in line or re.search(r"\| tick due=0", line):
            # Whether this tick judged some task terminal (moot): the ledger advanced, but there is no new output
            out["settled" if "moot=" in body else "idle"] += 1
        else:
            out["unknown"] += 1
        seg = []
    # Wall-clock expected ticks are printed as a **reference** only and enter no ratio -- that is the number the dashboard got wrong
    start = parse_ts("%sT00:00" % day)
    if start:
        end = min(now(), start + timedelta(days=1))
        out["wall"] = max(0, int((end - start).total_seconds() // (period_min * 60)))
    base = out["ran"] or 1
    out["load_pct"] = round((out["productive"] + out["settled"]) * 100.0 / base, 1)
    out["idle_pct"] = round(out["idle"] * 100.0 / base, 1)
    return out


def cmd_idle(args):
    """Honest idle-rate definition -- the denominator includes only ticks that **actually ran**."""
    c = tick_census(args.date)
    if args.json:
        print(json.dumps(c, ensure_ascii=False))
        return 0
    print("tick accounting | %s (period %d min)" % (c["date"], c["period_min"]))
    print("  wall-clock expected %d ticks  ← the denominator the dashboard uses now, **includes sleep ticks, unusable**" % c["wall"])
    print("  log actually ran %d ticks  ← the only inspectable true denominator" % c["ran"])
    print("  sleep gaps %d ticks (estimated when adjacent ticks are > %d min apart)"
          % (c["slept"], c["period_min"] * 2))
    print("  ├ productive   %d" % c["productive"])
    print("  ├ settled      %d (judged 'no work to do'; ledger advanced)" % c["settled"])
    print("  ├ truly idle   %d (ran and did not move a step)" % c["idle"])
    print("  └ unrecognized %d (its own third state, not collapsed to either side)" % c["unknown"])
    print("load %.1f%%  idle %.1f%% (denominator = ticks that ran, excluding sleep)"
          % (c["load_pct"], c["idle_pct"]))
    return 0


def last_tick_at():
    """Read the previous tick time from the heartbeat log (do not open a separate state file)."""
    if not os.path.isfile(LOG):
        return None
    try:
        with open(LOG, encoding="utf-8") as fh:
            lines = [l for l in fh if "| tick " in l]
    except OSError:
        return None
    return parse_ts(lines[-1].split("|")[0].strip()) if lines else None


def sleep_gap_note(expected_min=15):
    """A closed laptop lid sleeps, and launchd does not fire while it sleeps. On wake, run one catch-up, but the gap is a vacuum.

    The loop must know it slept -- otherwise "the heartbeat log is continuous" is misread as "it was running the whole time".
    """
    prev = last_tick_at()
    if prev is None:
        return None
    gap = int((now() - prev).total_seconds() // 60)
    if gap > expected_min * 2:
        return "wake catch-up: %d minutes since last heartbeat (expected %d) → the machine likely slept; the heartbeat was a vacuum for that gap" % (
            gap, expected_min)
    return None


def _probe_cheap_adapter(name, adapter):
    """Run one minimal prompt against the cheap/minimax/glm adapter to see whether a real call succeeds.

    Different from probing a PATH command: these are bash scripts, calling convention `$1=prompt file $2=result file`.
    Write a 1-byte prompt, run the adapter, and classify the root cause from the result file.
    A real call spends minimax/glm key quota (about 1 token each), so by default it is **not called**.
    Only an explicit `OC_CHEAP_PROBE=1` makes a real call (for short tests / manual verification).
    """
    import tempfile
    fd, prompt = tempfile.mkstemp(prefix="oc-probe-", suffix=".txt")
    os.close(fd)
    with open(prompt, "w", encoding="utf-8") as fh:
        fh.write("ok")
    result = "/tmp/spotlight/oc-probe-%s.result" % name
    os.makedirs("/tmp/spotlight", exist_ok=True)
    timeout_s = {"cheap": 90, "minimax": 60, "glm": 60}.get(name, 60)
    code, _ = run("CORTEX_NODE=%s timeout %d bash %s %s %s 2>&1"
                  % (node_id(), timeout_s, adapter, prompt, result), timeout=timeout_s + 30)
    try:
        os.unlink(prompt)
    except OSError:
        pass
    if not os.path.isfile(result):
        return False, "unknown", "adapter did not produce a result file"
    try:
        with open(result, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        text = ""
    low = text.lower()
    if code == 0:
        return True, "ok", "real call passed (rc=0)"
    if re.search("401|403|unauthorized|authenticat|token.*expired|invalid.*api.?key|\u8ba4\u8bc1|\u51ed\u636e", low):
        return False, "auth", text.strip().split("\n")[-1][:160]
    if re.search("quota|rate.?limit|usage limit|credit|exceeded|\u989d\u5ea6|\u8d85\u9650", low):
        return False, "quota", text.strip().split("\n")[-1][:160]
    if re.search("proxy|econnrefused|ssl|timeout|network|getaddrinfo|\u8fde\u63a5|getaddr", low):
        return False, "network", text.strip().split("\n")[-1][:160]
    if re.search("no-ccswitch-account|no.*key|apiKey.*missing|\u914d\u7f6e|\u672a\u914d\u7f6e", low):
        return False, "config", text.strip().split("\n")[-1][:160]
    return False, "unknown", (text.strip().split("\n")[-1] or "no output")[:160]


def diagnose_executor(name):
    """Why this executor is unavailable -- classify the root cause in plain code first; do not call a model up front.

    Returns (ok, root-cause class, detail). The class decides whether it can be fixed automatically:
      missing / path      command absent → PATH can be fixed automatically
      auth                authentication failed → cannot be fixed automatically (a person must supply credentials)
      quota               quota exhausted → **do not fix it, route around it** (switch executor/node)
      network / proxy     network or proxy → may be probed; do not restart someone else's service on your own
      config              config damaged → can be restored from git (git is the source of truth)
      ok                  nothing wrong

    Cheap-path adapters (cheap/minimax/glm) take their own branch:
      - they are not PATH commands; they are bash scripts (convention `$1=prompt file $2=result file`)
      - adapter file exists + openclaw.json has an apiKey = orchestration layer ok
      - only OC_CHEAP_PROBE=1 makes a real call (skipped by default, to avoid spending real quota; T20 short tests turn it on explicitly)
    """
    # Cheap-path branch (orchestration-layer probe + optional real call)
    if name in CHEAP_ADAPTER_PROVIDERS:
        adapter = os.path.join(ADAPTERS, "%s.sh" % name)
        if not os.path.isfile(adapter):
            return False, "missing", "adapter file missing: %s" % adapter
        if name in TEXT_ONLY_ADAPTERS:
            return False, "text-only", (
                "%s adapter can only generate text and must not be a workspace executor" % name)
        ready, detail = _cheap_worker_ready(adapter)
        if not ready:
            return False, "config", detail or "cheap workspace surface is not ready"
        providers = CHEAP_ADAPTER_PROVIDERS[name]
        if not _oc_provider_key_present(providers):
            # cheap's real credentials come from CC Switch; here we only keep the provider projection observable,
            # and no longer use the openclaw apiKey as an execution-eligibility gate.
            pass
        if os.environ.get("OC_CHEAP_PROBE") != "1":
            return True, "ok", "adapter + key ready (OC_CHEAP_PROBE!=1, skip the real call)"
        return _probe_cheap_adapter(name, adapter)

    if run("command -v %s" % name, timeout=10)[0] != 0:
        return False, "missing", "command is not on PATH"
    probe = {"claude": 'claude --print "ok"',
             "codex": "codex --version",
             "ollama": "ollama list",
             "openclaw": "openclaw cron status"}.get(name, "%s --version" % name)
    code, out = run("cd /tmp && timeout 90 %s 2>&1" % probe, timeout=120)
    if code == 0:
        return True, "ok", "probe passed"
    low = out.lower()
    if re.search("quota|rate.?limit|usage limit|credit|exceeded|\u989d\u5ea6|\u8d85\u9650", low):
        return False, "quota", out.strip().split("\n")[-1][:160]
    if re.search("auth|unauthorized|401|403|token|login|\u51ed\u636e|\u8ba4\u8bc1", low):
        return False, "auth", out.strip().split("\n")[-1][:160]
    if re.search("proxy|econnrefused|ssl|timeout|network|getaddrinfo|\u8fde\u63a5", low):
        return False, "network", out.strip().split("\n")[-1][:160]
    if re.search("config|json|parse|invalid|\u914d\u7f6e", low):
        return False, "config", out.strip().split("\n")[-1][:160]
    return False, "unknown", (out.strip().split("\n")[-1] or "no output")[:160]


def _print_diag(name):
    """CLI entry: diagnose one executor's root cause. stdout prints kind, exit_code=0 means healthy / 1 means red."""
    ok, kind, detail = diagnose_executor(name)
    print("%s|%s|%s" % ("OK" if ok else "FAIL", kind, detail))
    return 0 if ok else 1


def _harness_dir():
    """cortex-harness repository root. Cross-repo paths are not hard-coded; an env override is allowed."""
    return os.environ.get("CORTEX_HARNESS_DIR") or os.path.expanduser(
        "~/cortex-harness"
    )


def _harness_node_bin():
    """Find a usable node from cortex-harness/package.json engines (">=24.0.0 <25").

    Returns (path, source) or (None, None). If none is found, return None and let the caller speak up;
    do not silently fall back to a version that fails the engines declaration (T5: silent fallback is more dangerous than an error).
    """
    override = os.environ.get("CORTEX_HARNESS_NODE_BIN")
    if override and os.path.isfile(override):
        return override, "env CORTEX_HARNESS_NODE_BIN"
    nvm_root = os.path.expanduser("~/.nvm/versions/node")
    candidates = []
    if os.path.isdir(nvm_root):
        for name in os.listdir(nvm_root):
            m = re.match(r"^v24\.(\d+)\.(\d+)$", name)
            if not m:
                continue
            node_path = os.path.join(nvm_root, name, "bin", "node")
            if os.path.isfile(node_path):
                candidates.append((int(m.group(1)), int(m.group(2)), node_path))
    if candidates:
        candidates.sort()
        return candidates[-1][2], "nvm v24.x(auto-pick the highest patch)"
    which_node = shutil.which("node")
    if which_node:
        return which_node, "PATH node(not verified to satisfy engines>=24.0.0<25, may fail)"
    return None, None


def cmd_harness_run(args):
    """Really drive the local-MVP entry of cortex-harness/packages/agent-runtime once.

    Background (2026-08-21 HANDOFF Q2): CHARTER §4 requires the daily entry to reuse this Skill,
    but agent-runtime is pure TS source in the sister repo cortex-harness -- no bin field,
    unpublished, no build output, and previously reachable only by typing `pnpm --filter @cortex/agent-runtime`
    by hand. This command closes that path into one cortex-loop entry.

    Real call surface: cortex-harness's own scripts/cortex-local-mvp.mjs (not something new in this repo),
    which imports agent-runtime's executeCliEntry() and runs it once.

    Honest boundary: agent-runtime currently has only one, used to verify the runtime scaffold,
    (session/goal/lease/durable-autonomy loop) synthetic 2-step executor.
    It does not do real business tasks and calls no LLM -- a pass means the scaffold is reachable, not that
    agent-runtime already has real execution capability. Do not treat this as a substitute for tick.
    """
    harness_dir = _harness_dir()
    entry_script = os.path.join(harness_dir, "scripts", "cortex-local-mvp.mjs")

    def _fail(reason, hint, extra=None):
        payload = {"ok": False, "reason": reason, "hint": hint}
        if extra:
            payload.update(extra)
        print(json.dumps(payload, ensure_ascii=False))
        return 1

    if not os.path.isdir(harness_dir):
        return _fail("harness_dir_missing",
                      "Set CORTEX_HARNESS_DIR to the cortex-harness repository root",
                      {"path": harness_dir})
    if not os.path.isfile(entry_script):
        return _fail("entry_script_missing",
                      "cortex-harness is missing scripts/cortex-local-mvp.mjs; the wiring target has changed and needs a new investigation",
                      {"path": entry_script})
    node_bin, node_source = _harness_node_bin()
    if not node_bin:
        return _fail("node_v24_missing",
                      "cortex-harness engines require node>=24.0.0 <25, and none was found on this machine; nvm install 24 or set CORTEX_HARNESS_NODE_BIN")

    title = " ".join(args.title) if args.title else "run a bounded local Cortex goal"
    cmd = "cd %s && %s --experimental-transform-types %s %s" % (
        shlex.quote(harness_dir), shlex.quote(node_bin),
        shlex.quote(entry_script), shlex.quote(title),
    )
    code, out = run(cmd, timeout=args.timeout)

    # run() returns stdout and stderr merged; ExperimentalWarning is written to stderr,
    # and the real result is the last line that starts with {.
    json_line = None
    for line in reversed([l for l in out.strip().splitlines() if l.strip()]):
        if line.strip().startswith("{"):
            json_line = line.strip()
            break

    result = None
    if json_line:
        try:
            result = json.loads(json_line)
        except json.JSONDecodeError:
            result = None

    envelope = {
        "ok": code == 0 and result is not None,
        "exit_code": code,
        "harness_dir": harness_dir,
        "node_bin": node_bin,
        "node_source": node_source,
        "note": "agent-runtime local-MVP synthetic executor (not real business execution), used to verify the wiring",
    }
    if result is not None:
        envelope["result"] = result
    else:
        envelope["raw_output"] = out[-2000:]

    if args.json:
        print(json.dumps(envelope, ensure_ascii=False))
    else:
        print("harness-run | node=%s(%s) | exit=%s" % (node_bin, node_source, code))
        if result is not None:
            print("status=%s steps=%s evidence=%s" % (
                result.get("status"), result.get("steps"), result.get("evidence")))
        else:
            print(out if out.strip() else "(no output)")
    return 0 if envelope["ok"] else 1


def cmd_revive(args):
    """Self-heal: diagnose → fix what can be fixed → if it cannot, **declare the capability offline so the swarm routes around it** → come back online automatically once it recovers.

    Core judgment: **the most effective revival is not repairing the model that died; it is switching to the one that is still alive.**
    Quota exhaustion is a single-point problem, and the swarm has many nodes and models -- the right move is to route around it, not to wait for it to recover.
    "Declare the capability offline" is the critical step: the loop can keep running without a repair.
    """
    prof = node_profile()
    me = prof["node"]
    caps = set((prof.get("caps") or "").split())
    targets = [n for n in ("claude", "codex", "openclaw", "ollama", "cheap")
               if "exec.%s" % n in caps]
    if args.executor:
        targets = [args.executor]
    print("node %s | self-heal check: %s" % (me, " ".join(targets) or "(no executor)"))

    healthy, downed, actions = [], [], []
    for name in targets:
        ok, kind, detail = diagnose_executor(name)
        if ok:
            healthy.append(name)
            hushed, why, _ = exec_suppressed(name)
            if hushed:
                clear_exec(name)      # window elapsed and it can run → automatically rejoin, no human needed
                print("  ✅ %-9s recovered (previous suppression reason %s) → capability added back automatically" % (name, why))
            else:
                print("  ✅ %-9s available" % name)
            continue
        print("  ❌ %-9s %s — %s" % (name, kind, detail))
        # Only these two classes can be fixed safely and automatically; do not touch the rest (changing someone else's credentials or restarting someone else's service is out of bounds)
        if kind == "missing":
            fixed = run("command -v %s" % name, timeout=10)[0] == 0
            actions.append("%s: PATH recheck %s" % (name, "restored" if fixed else "still missing"))
        elif kind == "config":
            code, _ = git("checkout HEAD -- $(git ls-files | grep -i %s | head -5)" % name)
            actions.append("%s: tried to restore config from git %s" % (name, "ok" if code == 0 else "failed"))
        downed.append((name, kind, detail))

    # Critical step: drop the dead capability from the heartbeat -- the swarm immediately routes around this node by capability
    if downed:
        drop = {"exec.%s" % n for n, _, _ in downed}
        prof["caps"] = " ".join(c for c in (prof.get("caps") or "").split()
                                if c not in drop)
        prof["degraded"] = ",".join("%s:%s" % (n, k) for n, k, _ in downed)
        beat_publish(prof)
        print("\nremoved %s from the heartbeat -- the swarm will route around this node by capability, **no need to wait for a fix**"
              % " ".join(sorted(drop)))
        for name, kind, detail in downed:
            if kind == "quota":
                suppress_exec(name, "quota")
                print("  - %s quota exhausted → suppress for %d hours (rejoins automatically when the window resets; no human needed)"
                      % (name, QUOTA_WINDOW_H))
            elif kind == "auth":
                suppress_exec(name, "auth")
                print("  - %s authentication failed → suppress for 12 hours; a person must supply credentials (auto-editing credentials = out of bounds)" % name)
            record_incident(me, "executor-down-%s" % kind, "%s: %s" % (name, detail))

    if healthy and downed:
        print("\nstill available: %s -- this node is degraded but not disabled" % " ".join(healthy))
    elif not healthy:
        print("\n⚠️ this node has no usable executor → fall back to L2 code-only mode:"
              "heartbeat/window/completion gate/escalation alerts keep running, it just no longer thinks")

    for act in actions:
        print("  repair actions: %s" % act)
    # "promote": persist each self-heal as symptom → root cause → action, so the next identical symptom matches a known fix directly
    if downed:
        os.makedirs("/tmp/spotlight", exist_ok=True)
        with open("/tmp/spotlight/cortex-loop-revive.log", "a", encoding="utf-8") as fh:
            for name, kind, detail in downed:
                fh.write("%s|%s|%s|%s|%s\n" % (fmt(now()), me, name, kind, detail))
        print("\nself-heal record persisted (symptom → root cause → action); the same symptom can match directly next time")
    return 0 if healthy else 1


def executor_ladder(prof):
    """Three-level degradation ladder. Returns (usable executor, degradation tier, explanation).

    What keeps the loop alive is not a small model, it is **code-only degradation** -- the same idea as "the heartbeat must not be a parasite":
    the loop's survival must not depend on any model. A model only decides "whether it can think", not "whether it is alive".

      L0 normal    an external executor is available (claude/codex/openclaw/cheap) → real work
      L1 local     external executors are down, ollama is present → low-judgment work only (decompose / alert copy / fingerprint probe)
      L2 code-only not even a local model → heartbeat/window/completion gate/escalation alerts keep running, skip steps that need thinking

    cheap counts as L0: it uses CC Switch MiniMax through the Claude Code tool layer and has real
    Read/Edit/Bash capability. raw minimax/glm only declare text.*, and must not enter the Worker ladder.
    Order: claude/codex/openclaw (subscription executors) first → cheap (cheap workspace executor).
    """
    caps = set((prof.get("caps") or "").split())
    for name in ("claude", "codex", "openclaw"):
        if "exec.%s" % name in caps:
            return name, "L0", "external executor %s is available" % name
    for name in WORKSPACE_CHEAP_EXECUTORS:
        if "exec.%s" % name in caps:
            return name, "L0", "cheap path %s is available (Claude Code + CC Switch MiniMax)" % name
    # acp-lane does not take the default: use resolve_task_executor only when the task/line names it explicitly;
    # in the ladder it sits after cheap as a fallback that "still has L2 headless capability".
    for name in L2_HEADLESS_EXECUTORS:
        if "exec.%s" % name in caps:
            return name, "L0", "L2 headless lane %s is available (acp-policy-client + DECIDE)" % name
    if "exec.ollama" in caps:
        return "ollama", "L1", "external executors unavailable → local small model as fallback (low-judgment tasks only)"
    return None, "L2", "no model at all → code-only degradation: heartbeat/completion gate/alerts keep running, skip steps that need thinking"


def _run_and_gather(plan_id, run_ns):
    """Summarize immediately after automatic execution: a passed receipt must enter learning, and settlement runs once they are all in.

    run only forms world evidence; gather is what rechecks the receipt, publishes the learning candidate,
    and writes the settled ref. If the automatic clock only calls run, S1 stops at "did the work but did not learn / did not settle",
    a half-closed loop that still needs a person to run the last command.
    """
    run_ns.trigger_kind = "clock-auto"
    rc = cmd_run(run_ns)
    gather_rc = cmd_gather(argparse.Namespace(plan=plan_id, settle=True))
    if gather_rc != 0:
        log("auto-gather %s incomplete" % plan_id)
    return rc


def tick_advance_cap(day_cap):
    """Per-tick LLM advance budget; the daily cap is only a ceiling and must not be used directly as per-tick throughput."""
    try:
        configured = max(1, int(os.environ.get("CORTEX_MAX_ADVANCE_PER_TICK", "1")))
    except ValueError:
        configured = 1
    return min(max(0, int(day_cap)), configured)


def reclaim_inherited_running(line, executor):
    """Reclaim only running tasks that have no task-level Worker lock; a live Worker and a new tick may coexist."""
    reclaimed = []
    for task in load_tasks(line):
        if task.get("status") != "running":
            continue
        if task_lock_busy(line, task["id"]):
            continue
        if recover_completed_attempt(line, task, executor):
            continue
        path = tasks_path(line)
        if not set_cells(path, task["id"], {
                "status": "pending", "next_advance_after": "-",
                "updated_at": fmt(now()),
        }, expected_status="running"):
            continue
        reclaimed.append(task["id"])
        msg = "reclaim %s/%s previous tick already exited and has no complete receipt → reclaim and re-drive immediately" % (
            line, task["id"])
        print(msg)
        log(msg)
    return reclaimed


def active_task_workers():
    active = []
    for entry in clock_lines():
        line = entry["line"]
        for task in load_tasks(line):
            if task.get("status") == "running" and task_lock_busy(line, task["id"]):
                active.append((line, task["id"]))
    return active


def _cheap_available_accounts():
    override = os.environ.get("CORTEX_CHEAP_AVAILABLE_ACCOUNTS")
    if override is not None:
        try:
            return max(0, int(override))
        except ValueError:
            return 0
    db = os.path.expanduser("~/.cc-switch/cc-switch.db")
    if not os.path.isfile(db):
        return 0
    try:
        import sqlite3
        conn = sqlite3.connect("file:%s?mode=ro" % db, uri=True)
        rows = conn.execute(
            "SELECT settings_config FROM providers "
            "WHERE app_type='claude' AND name LIKE ?", ("MiniMax%",)).fetchall()
        conn.close()
    except Exception:
        return 0
    available = 0
    for (raw,) in rows:
        try:
            cfg = json.loads(raw)
            env = cfg.get("env") or {}
            token = env.get("ANTHROPIC_AUTH_TOKEN") or ""
            if not (token and env.get("ANTHROPIC_BASE_URL") and env.get("ANTHROPIC_MODEL")):
                continue
            token_hash = hashlib.sha256(token.encode()).hexdigest()[:12]
            if os.path.isdir("/tmp/spotlight/cortex-cheap-accounts/%s" % token_hash):
                continue
            available += 1
        except (TypeError, ValueError, json.JSONDecodeError):
            continue
    return available


def workspace_disk_admissible():
    root = os.path.expanduser(os.environ.get(
        "CORTEX_WORKSPACE_ROOT", "${CORTEX_WORKSPACE_ROOT}"))
    probe = root
    while not os.path.exists(probe):
        parent = os.path.dirname(probe)
        if parent == probe:
            return False, None
        probe = parent
    try:
        free_kb = (os.statvfs(probe).f_bavail * os.statvfs(probe).f_frsize) // 1024
        floor = int(os.environ.get("CORTEX_WORKSPACE_MIN_FREE_KB", "1048576"))
    except (OSError, ValueError):
        return False, None
    return free_kb >= floor, free_kb


def workspace_admission_capacity(executor):
    try:
        worker_slots = max(0, int(os.environ.get("CORTEX_MAX_WORKERS", "3")))
    except ValueError:
        worker_slots = 0
    disk_ok, free_kb = workspace_disk_admissible()
    if not disk_ok:
        return 0, {"worker_slots": worker_slots, "cheap_accounts": None,
                   "free_kb": free_kb, "reason": "workspace-disk-gate"}
    cheap_accounts = _cheap_available_accounts() if executor == "cheap" else worker_slots
    capacity = min(worker_slots, cheap_accounts)
    return capacity, {"worker_slots": worker_slots,
                      "cheap_accounts": cheap_accounts if executor == "cheap" else None,
                      "free_kb": free_kb, "reason": "ok"}


def _write_sets_overlap(left, right):
    if "" in left or "" in right:
        return True
    return any(_path_is_within(a.rstrip("/"), b.rstrip("/"))
               or _path_is_within(b.rstrip("/"), a.rstrip("/"))
               for a in left for b in right)


def active_worker_write_sets():
    sets = []
    for line, task_id in active_task_workers():
        task = pick(line, task_id)
        try:
            paths = workspace_contract_paths(task or {})["writable_paths"]
        except ValueError:
            paths = [""]  # An unknown active write set conflicts with every task; fail closed.
        sets.append((line, task_id, paths))
    return sets


def admit_disjoint_tasks(tasks, occupied, limit):
    """Greedy independent set of the write-set conflict graph; rejected items stay pending and do not count as failures."""
    admitted, deferred = [], []
    chosen = [paths for _line, _task, paths in occupied]
    for task in tasks:
        if len(admitted) >= max(0, limit):
            deferred.append((task, "capacity"))
            continue
        try:
            paths = workspace_contract_paths(task)["writable_paths"]
        except ValueError as exc:
            deferred.append((task, "contract:%s" % exc))
            continue
        if any(_write_sets_overlap(paths, active) for active in chosen):
            deferred.append((task, "write-conflict"))
            continue
        admitted.append((task, paths))
        chosen.append(paths)
    return admitted, deferred


def spawn_task_worker(line, task_id):
    """Start an independent Worker asynchronously; the scheduler does not wait on the model or hold the tick lock into the execution window."""
    cmd = [sys.executable, os.path.abspath(__file__), "task-run",
           "--line", line, "--task", task_id]
    try:
        proc = subprocess.Popen(
            cmd, cwd=ROOT, env=os.environ.copy(),
            stdin=subprocess.DEVNULL, close_fds=True, start_new_session=True,
        )
    except OSError as exc:
        print("FAIL | %s/%s Worker failed to start: %s" % (line, task_id, exc))
        return False
    print("launch| %s/%s → worker pid=%s (async, does not hold the tick/ledger/Git lock)" % (
        line, task_id, proc.pid))
    log("worker-launch %s/%s pid=%s" % (line, task_id, proc.pid))
    return True


def cmd_tick(args):
    # No longer holds the global tick flock. launchd itself does not re-enter; if a manual/recovery tick overlaps,
    # the remote line lease + the local per-task lock + ledger CAS each stop duplicate work.
    # The global lock once spread one 25min Worker/network retry into a freeze of the whole queue, costing far more than it saved.
    note = sleep_gap_note()
    if note:
        print(note)
        log(note)

    # The heartbeat must be sent before health -- it means "I am still alive", not "everything is fine".
    # Originally only cmd_sync sent a beat, and a red health made tick return early:
    # a node that went health-red then went silent to the whole swarm, and was declared dead and taken over after 3 hours.
    # "Alive" and "healthy" are two different things; mixing them makes a sick node look like a corpse.
    fetch_refs()
    _prof = node_profile()
    beat_publish(_prof)
    _exec, _tier, _why = executor_ladder(_prof)
    if _tier != "L0":
        print("⚠️ degradation tier %s: %s" % (_tier, _why))
        log("degraded %s %s" % (_tier, _why))
        if args.auto:      # degradation should not be only an alert; actively rescue itself (revive + promote)
            print("→ attempting self-heal automatically")
            cmd_revive(argparse.Namespace(executor=None))

    if args.auto and cmd_health(argparse.Namespace()) != 0:
        print("\nrefusing automatic advance: driver self-check is red (fix health before talking about advance)")
        return 1

    if args.auto:
        allowed, why = auto_execution_allowed_by_guardrails()
        if not allowed:
            print("\nrefusing automatic advance: a guardrail breach has triggered degradation (%s)" % why)
            print("recovery: audit the event source + a human recovery gate; if needed, explicitly set CORTEX_ALLOW_GUARDRAIL_BREACH_AUTO=1 breakglass")
            return 1

    total = 0
    workers_in_use = len(active_task_workers())
    occupied_write_sets = active_worker_write_sets()
    nodes = read_swarm()
    _self_prof = write_profile()  # refresh the self profile every tick (hour precision, so it does not create git noise)
    commit_own_profile(_self_prof)  # IMM-T30: on an unattended machine nobody will happen to commit this file
    for entry in clock_lines():
        line = entry["line"]
        if entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
            continue
        if not owns_line(entry, nodes):
            print("skip | %s is owned by %s (this node %s)" % (line, entry.get("owner"), node_id()))
            continue
        if args.auto:
            # Sharding decides "who should own it"; the lease decides "who can actually act right now".
            # Both layers are required: sharding prevents everyday fights, the lease prevents split-brain -- during a partition both sides think they should take over,
            # but the git server's CAS lets only one of them get the lease.
            got, why = acquire_lease(line, ttl_min=SCHEDULER_LEASE_MIN)
            if not got:
                print("skip | %s %s" % (line, why))
                continue
        window_min = int(entry.get("advance_window_min") or 240)
        executor = entry.get("executor") or "human"
        cap = int(entry.get("max_advance_per_day") or 4)

        # Whether running is still alive is decided only by that task's kernel lock; tick no longer owns a global advance lock.
        # A complete receipt is resumed for acceptance; reclaim only when there is no lock and no receipt, so there is no 45-minute vacuum.
        reclaim_inherited_running(line, executor)
        # [EX15 | T37] Stale-heartbeat reclaim for long tasks: if a task this node is running right now
        # misses its mid-run heartbeat (adapter stuck / ticker OOM-killed), it must be reclaimed to pending
        # so the rest of the tick can claim normally. reclaim_inherited_running only looks at "the process died";
        # this looks at "the task-level heartbeat died" -- complementary, not overlapping.
        reap_stale_running_tasks(line)
        # Settlement surface: settling tasks whose short_test already passed and that are stuck on git only land; they do not burn the LLM.
        # When git is busy, settle_line_tasks returns immediately for the whole batch (it does not run short_test),
        # leaving in-tick time for the claim-pending work below -- otherwise running stays 0 forever.
        # A successful settle still counts toward total; a skip does not count as failure.
        if args.auto:
            n_settle = settle_line_tasks(line)
            if n_settle:
                print("settle| %s settled %d settling→done this tick" % (line, n_settle))
                total += n_settle
        for task in load_tasks(line):
            status = task.get("status")
            guard_path, _guard_test = _guard_paths(line, task["id"])
            orphan_done = status == "done" and os.path.isfile(guard_path)
            if status != "pending" and not orphan_done:
                continue
            # pending can also have a new receipt from "the main call was killed and a tool subprocess finished later".
            # Reclaim only tool-layer receipts written after the update time, so old raw text results are not replayed.
            result_file = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task["id"])
            updated = parse_ts(task.get("updated_at"))
            pending_receipt = (
                status == "pending" and updated and os.path.isfile(result_file)
                and datetime.fromtimestamp(os.path.getmtime(result_file), now().tzinfo) > updated
            )
            pending_dirty_attempt = False
            if status == "pending":
                attempt = _load_latest_attempt_claim(line, task["id"])
                pending_dirty_attempt = bool(
                    attempt and _workspace_has_changes(attempt.get("worktree")))
            if pending_receipt or orphan_done or pending_dirty_attempt:
                if recover_completed_attempt(line, task, executor):
                    continue

        if args.auto:
            resume_recoverable_blocked(line)
        for task, days in stuck_tasks(line):
            escalate(line, task, days)
        detect_systemic_failure(line)

        due = due_tasks(line)
        # A ledger that has selection fields must actually go through the selector; do not merely offer a
        # `select` command that nobody calls. Legacy ledgers lack those columns and keep the old order.
        if due and any((t.get("resource_class") or "").strip() for t in load_tasks(line)):
            # T21 fix: quota probes must call exec_suppressed, not lazily treat "file exists" as a capability claim.
            # When quota is exhausted, quota_exhausted=True → resource_state drops to unknown,
            # select_task_rows filters out llm-heavy and only local-only remains runnable.
            suppressed, reason, _ = exec_suppressed(executor)
            quota_exhausted = suppressed and reason == "quota"
            resource_state = ("ok" if executor != "human"
                              and not quota_exhausted
                              and os.path.isfile(executor_adapter_path(executor))
                              else "unknown")
            due = select_task_rows(due, resource_state)
        if not due:
            print("idle | %s no task has reached its window" % line)
            continue
        print("due  | %s: %s" % (line, ", ".join(t["id"] for t in due)))
        total += len(due)
        if args.auto:
            capacity, admission = workspace_admission_capacity(executor)
            worker_free = max(0, admission["worker_slots"] - workers_in_use)
            account_free = (admission["cheap_accounts"]
                            if admission["cheap_accounts"] is not None else worker_free)
            available = 0 if capacity == 0 else min(worker_free, account_free)
            if "CORTEX_MAX_ADVANCE_PER_TICK" in os.environ:
                try:
                    available = min(available, max(
                        0, int(os.environ["CORTEX_MAX_ADVANCE_PER_TICK"])))
                except ValueError:
                    available = 0
            if available == 0:
                print("queue | %s admission=0 reason=%s workers=%d/%d free_kb=%s; stay pending" % (
                    line, admission["reason"], workers_in_use,
                    admission["worker_slots"], admission["free_kb"]))
                continue
            admitted, deferred = admit_disjoint_tasks(
                due, occupied_write_sets, min(available, cap))
            for deferred_task, reason in deferred:
                print("queue | %s/%s %s; do not claim, do not record a failure" % (
                    line, deferred_task["id"], reason))
            advanced_this_tick = 0
            for task, write_paths in admitted:
                reserved, used, why = reserve_daily_advance(
                    line, cap, task_id=task["id"])
                if not reserved:
                    print("skip | %s daily advance budget: %s" % (line, why))
                    log("daily-cap %s used=%d cap=%d reason=%s" % (
                        line, used, cap, why))
                    break
                print("budget| %s %s" % (line, why))
                if spawn_task_worker(line, task["id"]):
                    advanced_this_tick += 1
                    workers_in_use += 1
                    occupied_write_sets.append((line, task["id"], write_paths))

    if args.auto and total == 0:
        # No work due != stopped. Mechanically checkable gaps in CORTEX are a natural pool of small tasks:
        # find them yourself, chew the small ones, accumulate trust -- that is what it means to keep running.
        # All three steps of the immune loop must really happen here: discover → auto-publish → auto-claim and execute.
        # Do not stop after printing "should we publish?"; that is the same as having no self-heal.
        print("\nno task has reached its window → look for work autonomously (immune loop)")
        # [Take old work before looking for new work] Measured 2026-07-29: every tick unconditionally published a new plan and ran only
        # the one it had just published, so the same candidates were repeatedly dispatched as **new plan ids**. Of 24 plans, 7
        # were never claimed at all (published by another node, and this node never looked at them).
        # The pass-rate denominator is the result-ref count = the number of (plan, task) pairs, so every republish
        # gives the same work another slot in the denominator -- the numerator stays put, the denominator explodes, and the ratio must keep falling.
        # Reusing an existing plan has another key property: retrying the same task in the same plan **overwrites the same
        # result ref**. The ledger is idempotent and does not count it again.
        open_plan = _oldest_open_plan()
        if open_plan:
            print("found unfinished old plan %s → take the old work first" % open_plan)
            _open_tasks = plan_tasks(open_plan)
            _deterministic_batch = bool(_open_tasks) and all(
                task.get("source") == "map-backlink-gap" for task in _open_tasks)
            _batch_weight = sum(
                int(task.get("weight") or 1) for task in _open_tasks
            ) if _deterministic_batch else 0
            _run_and_gather(open_plan, argparse.Namespace(
                plan=open_plan, executor=None,
                max_load=3 + _batch_weight if _deterministic_batch else 3,
                ttl_min=60, limit=0))
            # [Taking old work must not block new work] Livelock confirmed 2026-07-29: the first version returned 0 unconditionally,
            # so "took old work" and "took old work but did not move one step" were treated as the same thing.
            # On the real machine, 18:15→19:21 produced five consecutive ticks of byte-identical idle logs.
            # The criterion is **whether this pass really advanced** (ran, or judged a terminal state), not "whether an old plan exists":
            #   advanced → stop this tick here, and keep chewing next tick (prevents an avalanche; the original design intent stays)
            #   zero progress → this plan is already a stone with nothing I can do; keep looking further down for new work
            # This does not relax any gate -- tasks that did not move one step were never let through by the gate.
            if getattr(cmd_run, "last_progress", 0) > 0:
                # moot=N lets `cortex-loop idle` separate "recorded terminal" from "truly idle":
                # without it, a tick that finished judging an old plan terminal would be miscounted as idle (the ledger did advance).
                log("tick due=%d auto=%s resumed=%s moot=%d"
                    % (total, bool(args.auto), open_plan,
                       getattr(cmd_run, "last_moot", 0)))
                return 0
            print("old plan %s made zero progress this tick (no work I can do) → keep looking for new work, do not idle out the tick"
                  % open_plan)
            log("tick due=%d auto=%s resumed=%s progress=0 fallthrough"
                % (total, bool(args.auto), open_plan))
        cands = discover_candidates()
        if not cands:
            print("every mechanically checkable gap is green -- there really is no work")
        else:
            _h, _facts = haas_score(node_id())
            _lvl_names = ["L1", "L2", "L3", "L4", "L5"]
            _lvl = _lvl_names.index(trust_level(_h))
            # [Publish != execute] A plan is a **swarm-shared ledger**. Trimming it by the publisher's personal trust
            # lets a low-trust node's view decide what work a high-trust node can see.
            # Measured 2026-07-29: when laptop(L2) published, 11 L3/L4 candidates
            # (5×lowland-* / 4×debt-* / fm-bulk / dispute-all) were never written into
            # any plan, while the worker is L3 and fully qualified -- the work was invisible to the node that was qualified for it.
            #
            # Fix: the publish side looks at the **highest trust among living nodes in the swarm**. The execution side's C2
            # (covenant_check) is unchanged, character for character. A node that cannot reach the work is still blocked when it claims,
            # the work is just put on the table. This is "making the work public", not "lowering the bar".
            _ceiling = _lvl
            _ceiling_by = node_id()
            for _n, _p in read_swarm().items():
                if not node_alive(_p)[0]:
                    continue
                _nh, _ = haas_score(_n)
                _nl = _lvl_names.index(trust_level(_nh))
                if _nl > _ceiling:
                    _ceiling, _ceiling_by = _nl, _n
            ok = [c for c in cands
                  if _lvl_names.index(c["min_trust"]) <= _ceiling]
            routed = route_discovered_file_tasks([
                c for c in ok if _lvl_names.index(c["min_trust"]) <= _lvl
            ])
            if routed:
                print("imported %d admitted file tasks into the controller ledger: %s" % (
                    len(routed), ", ".join(routed[:8])))
                print("the next tick runs workspace→candidate→integrator; it no longer writes the root worktree")
                log("controller-route n=%d tasks=%s" % (
                    len(routed), ",".join(routed)))
                return 0
            print("found %d candidates, this node's trust %s; swarm executable ceiling %s (from %s) → %d can be published"
                  % (len(cands), trust_level(_h), _lvl_names[_ceiling], _ceiling_by, len(ok)))
            _mine = len([c for c in cands if _lvl_names.index(c["min_trust"]) <= _lvl])
            if _mine < len(ok):
                print("%d of them are out of this node's reach; publish them and wait for a qualified node to claim (the C2 gate is unchanged)"
                      % (len(ok) - _mine))
            if not ok:
                print("0 qualified -- the whole swarm cannot reach them; accumulate trust first, and unlock once HAAS rises")
            else:
                pid = "imm-%s" % now().strftime("%m%d%H%M%S")
                # The per-tick cap for an immune plan is unrelated to a direction line's max_advance_per_day (that is the
                # loop variable cap, whose value depends on the last line in clock_lines, which is the wrong meaning),
                # so this uses its own small constant: claim at most 2 per tick, to prevent an avalanche.
                #
                # The pick cannot be a bare `ok[:2]`: once the publish ceiling is opened to the swarm ceiling, if sort order puts
                # high-bar tasks first, this node will publish, for several ticks in a row, plans **it cannot do a single one of** --
                # the ledger looks full while this node stays idle, which just moves idleness from dispatch to execution.
                # Rule: work this node can reach takes 1 slot first (so I have work this tick),
                # and the remaining slots go to the swarm in the original order (so high-bar work can still get out).
                _selfok = [c for c in ok if _lvl_names.index(c["min_trust"]) <= _lvl]
                take = _selfok[:1]
                for _c in ok:
                    if len(take) >= 2:
                        break
                    if _c not in take:
                        take.append(_c)
                fetch_refs()
                if rev_ref("%s/%s" % (PLAN_NS, pid)):
                    print("plan %s already exists (rare same-second collision); skip this tick" % pid)
                elif not freeze_discoveries(take, pid):
                    print("discovery freeze failed for auto immune plan %s; do not publish this tick" % pid)
                else:
                    lines = [plan_task_line(c) for c in take]
                    payload = "\n".join([
                        "plan=%s" % pid, "intent=immune response: auto-fix mechanically verifiable governance gaps",
                        "by=%s" % node_id(), "created=%s" % fmt(now()),
                        "tasks=%d" % len(lines), ""] + lines)
                    okp, _ = write_ref("%s/%s" % (PLAN_NS, pid), payload)
                    print("auto-published immune plan %s (%d items): %s"
                          % (pid, len(lines), "ok" if okp else "FAIL"))
                    log("auto-dispatch %s n=%d" % (pid, len(lines)))
                    if okp:
                        # Claim and execute immediately after publishing -- otherwise the work is only listed,
                        # which is not an autonomous closed loop. cmd_run already includes the six-law three gates + the mechanical gate +
                        # independent acceptance; failure is recorded as failed and is not pretended to be success.
                        run_ns = argparse.Namespace(
                            plan=pid, executor=None, max_load=3, ttl_min=60, limit=0)
                        _run_and_gather(pid, run_ns)
    log("tick due=%d auto=%s" % (total, bool(args.auto)))
    return 0


# ── IMM-T33: worker-bee idle-node task matchmaking (read-only diagnosis)────────────────────────
# Background: CLOCK.owner is now only an affinity hint; `owns_line()` no longer requires the owner to
# reach the silent-takeover threshold first. Every healthy node can compete for the short scheduler lease; task-level claim
# and ledger CAS prevent duplicates. When the owner is busy, health is red, or a node exits, pending
# does not structurally lose its path to other nodes.
#
# This command does not execute directly (it does not write TASKS.md and does not touch the owner field): it keeps a read-only scan
# that explains which pending tasks still have not been claimed by any node. Real cross-node execution uses the existing
# discover → plan → claim trio (CAS race; any node that meets the bar can take it).

MATCH_MIN_TRUST = "L2"   # The TASKS.md ledger has no per-task min_trust column (that is a discover
                          # candidate-only field; see discover_candidates()). A direct
                          # line-level task can only use one general ruler: L2 = HAAS>=0.5, the
                          # minimum bar for any automatic execution in the swarm (L1 is "confirm every step" and should not be handed work).


def _trust_order():
    return [name for name, _ in TRUST_LEVELS]


def _build_claim_index():
    """Read every CLAIM_NS ref once in a batch and build a task_id → (holder, expires) index.

    Fixed 2026-07-31 (the second IMM-T29-class pit hit the moment IMM-T33 went live): the old
    `_task_live_claim` called `list_refs` again and `read_ref` one by one on every call (2
    git subprocesses each), and `cmd_match_idle` called it in a loop over due tasks, which degenerated into
    a subprocess storm of O(task count × claim ref count) -- the same pattern as the old `haas_score` bug,
    except this time it was "calling an already-expensive function repeatedly" rather than "the function itself is expensive".
    Reuse `read_refs_batch()`, which IMM-T29 already fixed, and read every payload in one subprocess.
    """
    refs = list_refs(CLAIM_NS)
    batch = read_refs_batch(refs)
    index = {}
    if batch is None:
        for ref in refs:
            kv = parse_kv(read_ref(ref))
            _claim_index_add(index, kv)
        return index
    for ref, payload in batch.items():
        kv = parse_kv(payload or "")
        _claim_index_add(index, kv)
    return index


def _claim_index_add(index, kv):
    task_id = kv.get("task")
    if not task_id:
        return
    expires = parse_ts(kv.get("expires"))
    if expires and expires > now():
        index[task_id] = kv.get("holder") or "?"


def _task_live_claim(task_id, claim_index=None):
    """Whether this task id is already actively claimed (not expired) under any plan -- prevents duplicate assignment.

    CLAIM_NS ref paths are <plan>/<task_id>, but plan can be any string
    (immune plans imm-*, manually published plans, and so on). The only field that can recognize "the same task" across plans
    is task= inside the payload, so scan everything instead of guessing a plan prefix from the path.

    Pass `claim_index` (the return value of `_build_claim_index()`) for an O(1) lookup;
    omit it and the original slow per-ref path is used (kept for compatibility; future callers that omit it are not wrong,
    only slow, and they do not compute a wrong answer).
    """
    if claim_index is not None:
        holder = claim_index.get(task_id)
        return (True, holder) if holder else (False, "")
    for ref in list_refs(CLAIM_NS):
        kv = parse_kv(read_ref(ref))
        if kv.get("task") != task_id:
            continue
        expires = parse_ts(kv.get("expires"))
        if expires and expires > now():
            return True, kv.get("holder") or "?"
    return False, ""


def _node_busy_elsewhere(name, lines):
    """Whether this candidate node has a line of its own that is busy, or an unsettled ad-hoc claim in hand.

    Handing out new work just because it is "alive", without looking at whether it is "busy", uses "trust is sufficient" as a reason to create a second bottleneck,
    the other face of the same class of bug as this task's failure-mode list ("judge alive, but not the trust bar").
    """
    if node_load(name) > 0:
        return True, "has an unsettled ad-hoc claim in hand (node_load>0)"
    for entry in lines:
        if entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
            continue
        if entry.get("owner") != name:
            continue
        if any(t.get("status") == "running" for t in load_tasks(entry["line"])):
            return True, "a line it owns, %s, is running a task" % entry["line"]
    return False, ""


def cmd_match_idle(args):
    """Matchmaking diagnosis: report a pairing when the owner is busy + there is unclaimed pending + the swarm has an idle node that meets the bar.

    All three gates are required before reporting "match" (three-state output, not a boolean yes/no):
      1. the line really has due pending tasks that no node has actively claimed;
      2. the line owner is busy (has a running task) -- if the owner is not busy, the normal heartbeat cadence will pick it up,
         so report "skip" rather than "match", and do not create over-matching noise;
      3. the candidate node != owner, is alive, is not itself busy, its declared executors include the executor the line requires,
         and HAAS trust_level >= MATCH_MIN_TRUST -- if any of the four fails
         it does not count as "idle and usable", and each miss is given a concrete reason.
    Never do this: assign past CLOCK.md's owner directly (that is tick/advance_once's job,
    protected by owns_line sharding). This command only prints; it does not write_ref and does not edit TASKS.md.

    Fixed 2026-07-31: the first version called fetch_refs() unconditionally. After launch, an independent review found that once refs grew to
    that night's scale it stuck for 30s+ and timed out with zero output -- the same pit the `trust` command hit
    (IMM-T29), except this time a new feature hit it the moment it launched, not a historical leftover. Added --no-fetch;
    a diagnostic command should not force a network pull by default.
    """
    if not getattr(args, "no_fetch", False):
        fetch_refs()
    _budget_start = time.time()
    MATCH_IDLE_TIME_BUDGET_SEC = 15
    _budget_hit = [False]

    def _over_budget():
        if time.time() - _budget_start > MATCH_IDLE_TIME_BUDGET_SEC:
            _budget_hit[0] = True
            return True
        return False

    nodes = read_swarm()
    lines = clock_lines()
    claim_index = _build_claim_index()
    if args.line:
        lines = [e for e in lines if e.get("line") == args.line]
        if not lines:
            print("unknown | line %s is not declared in CLOCK.md" % args.line)
            return 1

    any_pending = False
    any_match = False
    for entry in lines:
        if entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
            continue
        line = entry["line"]
        owner = entry.get("owner") or node_id()
        executor = entry.get("executor") or "human"
        tasks = load_tasks(line)
        due = due_tasks(line)

        unclaimed = []
        for t in due:
            if _over_budget():
                print("timeout | %s: local ref scan exceeded the %ds time budget; stopped after checking %d/%d due tasks "
                      "-- not 'nothing found'; the local git subprocess volume was too large to finish (the unfixed IMM-T29 root cause)"
                      % (line, MATCH_IDLE_TIME_BUDGET_SEC, len(unclaimed), len(due)))
                break
            live, holder = _task_live_claim(t["id"], claim_index)
            if live:
                print("skip  | %s/%s is already actively claimed by %s; do not assign it again" % (line, t["id"], holder))
                continue
            unclaimed.append(t)
        if _budget_hit[0]:
            continue

        if not unclaimed:
            print("idle  | %s: no unclaimed pending tasks (due=%d, all claimed or there was no due work)"
                  % (line, len(due)))
            continue
        any_pending = True

        owner_busy = any(t.get("status") == "running" for t in tasks)
        if not owner_busy:
            print("skip  | %s: owner %s is not busy; the normal heartbeat will pick it up (pending=%s); no matchmaking needed"
                  % (line, owner, ",".join(t["id"] for t in unclaimed)))
            continue

        order = _trust_order()
        candidates = []
        rejected = []
        for name, prof in nodes.items():
            if _over_budget():
                rejected.append("(time budget exhausted; remaining nodes were not checked, see IMM-T29)")
                break
            if name == owner:
                continue
            alive, why_alive = node_alive(prof)
            if not alive:
                rejected.append("%s (offline: %s)" % (name, why_alive))
                continue
            busy, why_busy = _node_busy_elsewhere(name, lines)
            if busy:
                rejected.append("%s (busy: %s)" % (name, why_busy))
                continue
            execs = (prof.get("executors") or "").split()
            if executor not in execs:
                rejected.append("%s (missing executor=%s; this node declares %s)"
                                 % (name, executor, " ".join(execs) or "-"))
                continue
            haas, _facts = haas_score(name)
            trust = trust_level(haas)
            if order.index(trust) < order.index(MATCH_MIN_TRUST):
                rejected.append("%s (trust %s HAAS %.3f is below the bar %s)"
                                 % (name, trust, haas, MATCH_MIN_TRUST))
                continue
            candidates.append((name, haas, trust))

        if not candidates:
            print("no-match | %s: owner %s is busy + %d unclaimed (%s), and the swarm has no idle node that meets the bar -- %s"
                  % (line, owner, len(unclaimed), ",".join(t["id"] for t in unclaimed),
                     ";".join(rejected) if rejected else "no other visible node in the swarm besides the owner"))
            continue

        candidates.sort(key=lambda c: -c[1])
        best_name, best_haas, best_trust = candidates[0]
        any_match = True
        for t in unclaimed:
            print("match | %s/%s ← suggest %s (HAAS %.3f, %s) -- owner %s is busy;"
                  "this version only diagnoses and does not execute; real matchmaking goes through discover/plan/claim to move the task into the swarm-claimable pool"
                  % (line, t["id"], best_name, best_haas, best_trust, owner))

    if _budget_hit[0]:
        print("\nconclusion: ⚠️ hit the time budget before finishing -- the above is a partial check, not"
              "a 'confirmed no matchmaking is needed', only a 'did not finish checking'; the two differ (DIMENSIONAL law, third state)")
        return 2
    if not any_pending:
        print("\nconclusion: the whole swarm (%s) currently has no unclaimed pending task -- no matchmaking needed"
              % (args.line or "all enabled lines were scanned"))
    elif not any_match:
        print("\nconclusion: unclaimed pending tasks exist, but every one has an owner that is not busy (the normal cadence will handle it)"
              " or the swarm has no idle node that meets the bar -- no executable matchmaking this tick")
    return 0


def cmd_status(args):
    # [T12] Split task counts by line (line_breakdown): one line of stats per line,
    # then one total=all row -- a sum != the truth; when the same id collides across lines, the sum hides
    # "how much this line really ran". T12 formally puts the by_line / per_line dimension into the view.
    per_line = []  # [(line, counts, dict_fields)]
    overall = {}
    for entry in clock_lines():
        line = entry["line"]
        tasks = load_tasks(line)
        counts = {}
        for task in tasks:
            status = task.get("status", "?")
            counts[status] = counts.get(status, 0) + 1
            overall[status] = overall.get(status, 0) + 1
        per_line.append((line, entry, counts))
        print("%-16s enabled=%-4s executor=%-8s %s"
              % (line, entry.get("enabled"), entry.get("executor"),
                 " ".join("%s=%d" % kv for kv in sorted(counts.items())) or "(empty table)"))
    # Final line_breakdown total (by_line design intent: a person or a machine can slice it)
    print("%-16s %-22s %s"
          % ("── total all ──", "by_line=" + str(len(per_line)),
             " ".join("%s=%d" % kv for kv in sorted(overall.items())) or "(empty table)"))
    if args and getattr(args, "json", False):
        import json as _json
        print(_json.dumps(
            {"by_line": [{"line": ln, "counts": c} for ln, _, c in per_line],
             "overall": overall},
            ensure_ascii=False, indent=2))
    return 0


def main():
    # Force stdout to be unbuffered (equivalent to -u/PYTHONUNBUFFERED=1, but it takes effect inside the script and works across environments).
    # Do not use the old sys.stdout = os.fdopen(...) approach -- reconfigure() is an atomic operation on Python 3.7+,
    # it works with the local Python 3.14, and it does not affect stderr (stderr is unbuffered by default).
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except Exception:  # noqa: BLE001 (very unlikely to fail when not a tty; do not block the run)
        pass
    signal.signal(signal.SIGTERM, _forward_termination)
    parser = argparse.ArgumentParser(prog="cortex-loop", description="CORTEX heartbeat engine")
