    idl = sub.add_parser("idle", help="four-state tick-accounting census (denominator excludes sleep ticks)")
    idl.add_argument("--date", help="YYYY-MM-DD, default today")
    idl.add_argument("--json", action="store_true")
    idl.set_defaults(func=cmd_idle)

    nxt = sub.add_parser("next", help="render the next-step prompt to stdout")
    nxt.add_argument("--line", required=True)
    nxt.add_argument("--task")
    nxt.add_argument("--claim", action="store_true")
    nxt.set_defaults(func=cmd_next)

    tl = sub.add_parser("task-list", help="atomic task query (filter by status / JSON output)")
    tl.add_argument("--line", required=True)
    tl.add_argument("--status",
                    choices=["pending", "running", "done", "waiting_external",
                             "blocked", "settling"])
    tl.add_argument("--json", action="store_true")
    tl.set_defaults(func=cmd_task_list)

    tled = sub.add_parser(
        "task-ledger",
        help="all-line task ledger + scoring audit (done/rejected/missed credit/L2-L5 gold stars; atomic tool bin/cortex-loop-task-ledger)",
    )
    tled.add_argument("--json", action="store_true")
    tled.add_argument("--section", choices=["all", "tasks", "score"], default="all")
    tled.add_argument("--line", default=None)
    tled.set_defaults(func=cmd_task_ledger)

    ts = sub.add_parser("task-show", help="exact query by line+id; human-readable by default, --json for machines")
    ts.add_argument("--line", required=True)
    ts.add_argument("--task", required=True)
    ts.add_argument("--json", action="store_true", help="emit the stable JSON contract")
    ts.add_argument("--settlement", action="store_true",
                    help="read-only explanation of the artifact→commit→origin→canonical settlement chain")
    ts.set_defaults(func=cmd_task_show)

    rc = sub.add_parser(
        "run-contract",
        help="read-only output of the frozen attempt's canonical run-contract-v1",
