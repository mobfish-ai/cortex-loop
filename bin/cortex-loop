        func=lambda args: (print(node_id()), 0)[1])
    sub.add_parser("orchestrator-id", help="print this machine's orchestrator node id (the only source of truth)").set_defaults(
        func=lambda args: (print(orchestrator_id()), 0)[1])
    sub.add_parser("reconcile", help="declared vs actual driver").set_defaults(func=cmd_reconcile)
    sfs = sub.add_parser("systemic-status", help="read-only: whether a systemic fault is suspected now (>=3 tasks with the same signature); zero side effects, writes no state and sends no Discord")
    sfs.add_argument("--line", help="check only this line; default is every line in CLOCK")
    sfs.add_argument("--json", action="store_true")
    sfs.set_defaults(func=cmd_systemic_status)
    sub.add_parser("swarm", help="swarm: refresh the self profile + the group liveness table").set_defaults(func=cmd_swarm)
    sub.add_parser("caps", help="capability discovery: swarm-wide capability matrix + single-point capability alerts").set_defaults(func=cmd_caps)
    rv = sub.add_parser("revive", help="self-heal: diagnose executors → fix what can be fixed → if not, drop the capability so the swarm routes around it")
    rv.add_argument("--executor")
    rv.set_defaults(func=cmd_revive)
    hr = sub.add_parser("harness-run", help="really drive sister-repo cortex-harness/packages/agent-runtime through one local-MVP run (scaffold check, not real business execution; not a substitute for tick)")
    hr.add_argument("title", nargs="*", help="goal title (optional, passed through to agent-runtime goal.title)")
    hr.add_argument("--timeout", type=int, default=60)
    hr.add_argument("--json", action="store_true")
    hr.set_defaults(func=cmd_harness_run)
    dx = sub.add_parser("diagnose-executor", help="diagnose one executor's root cause (cheap/minimax/glm/...), printing ok|missing|config|quota|auth|network|unknown")
    dx.add_argument("executor")
    dx.set_defaults(func=lambda a: _print_diag(a.executor))
    at = sub.add_parser("attest", help="verify that the model behind the executor really is the declared one (three strength levels)")
    at.add_argument("--executor")
    at.set_defaults(func=cmd_attest)
    sp_why = sub.add_parser("why", help="why trust rose/fell: trace each entry + detect score farming")
    sp_why.add_argument("--node", default=None)
    sp_why.add_argument("--limit", type=int, default=12)
    sp_why.set_defaults(func=cmd_why)
    sub.add_parser("readjudicate", help="re-judge historical rejected items with the current criteria (review of wrongful rejections, not a pardon)").set_defaults(func=cmd_readjudicate)
    sp_ci = sub.add_parser("checkin", help="main thread joins/leaves the swarm (a heartbeat peer to automatic nodes)")
    sp_ci.add_argument("--out", action="store_true", help="leave: push one offline heartbeat")
    sp_ci.set_defaults(func=cmd_checkin)
    sp_cr = sub.add_parser("credit", help="main thread records one thing it finished on its own (a penalty must have a matching credit)")
    sp_cr.add_argument("--kind", required=True,
                       choices=["decided", "self-fixed", "defect-reported", "defect-fixed", "correct-refusal", "mechanism-adopted"])
    sp_cr.add_argument("--detail", required=True)
    sp_cr.add_argument("--evidence", default="",
                       help="verifiable evidence (file path / commit hash / source location; required for a veto or a report)")
    sp_cr.add_argument("--corrected-target", default="",
                       help="who was corrected (node name; required for a commendation)")
    sp_cr.add_argument("--verified-by", default="",
                       help="independent verifier; must match the evidence report's owner/line fields")
    sp_cr.add_argument("--backfill", action="store_true",
                       help="one-shot cold-start backfill (per-event fingerprint prevents duplicates)")
    sp_cr.add_argument("--occurred-at", default="",
                       help="when the historical event happened; required with --backfill and must be earlier than the mechanism's launch")
    sp_cr.set_defaults(func=cmd_credit)
    # Anti-regression 2: claw back a veto that was later overturned (cmd_refund)
    sp_rf = sub.add_parser("refund", help="claw back when a veto is overturned (anti-regression 2: a wrong veto is zero-cost noise)")
    sp_rf.add_argument("--ref", required=True, help="path of the original ref that was overturned")
    sp_rf.add_argument("--reason", required=True, help="why it was overturned (file evidence)")
    sp_rf.add_argument("--evidence", required=True, help="tracked evidence file/commit that overturns the conclusion")
    sp_rf.add_argument("--verified-by", required=True,
                       help="independent verifier; must match the evidence report's owner/line fields")
    sp_rf.set_defaults(func=cmd_refund)
    sub.add_parser("credit-list", help="list every credit event (atomic tool)").set_defaults(func=cmd_credit_list)
    sp_csh = sub.add_parser("credit-show", help="show the full payload of one credit event (atomic tool)")
    sp_csh.add_argument("--ref", required=True, help="full ref path or token suffix")
    sp_csh.set_defaults(func=cmd_credit_show)
    sp_cq = sub.add_parser("credit-query", help="filter credit events by kind/node/keyword (atomic tool)")
    sp_cq.add_argument("--kind", default="")
    sp_cq.add_argument("--node", default="")
    sp_cq.add_argument("--grep", default="")
    sp_cq.set_defaults(func=cmd_credit_query)
    sp_cd = sub.add_parser("credit-delete", help="revoke one mistakenly written credit event, clear it locally and on origin, and keep an audit trail (atomic tool)")
    sp_cd.add_argument("--ref", required=True, help="full ref path or token suffix")
    sp_cd.add_argument("--reason", required=True)
    sp_cd.add_argument("--confirm", action="store_true", help="without this flag, only preview and do not execute")
    sp_cd.set_defaults(func=cmd_credit_delete)
    sp_fault = sub.add_parser("fault", help="main thread records its own breach (the orchestrator is bound by the trust mechanism too)")
    sp_fault.add_argument("--kind", required=True,
                          choices=["decision-dodge", "false-premise", "broken-gauge",
                                   "rule-ignored", "rework", "adhoc-failed", "adhoc-breach"])
    sp_fault.add_argument("--detail", required=True)
    sp_fault.set_defaults(func=cmd_fault)
    sm = sub.add_parser("swarm-mode", help="report solo/swarm/unknown (unknown is conservatively treated as swarm)")
    sm.set_defaults(func=cmd_swarm_mode)
    al = sub.add_parser("adhoc-list", help="list ad-hoc tasks registered on this node")
    al.set_defaults(func=cmd_adhoc_list)
    sp_trust = sub.add_parser("trust", help="trust level: HAAS computed for real as L1-L5 (six laws, C2)")
    sp_trust.add_argument("--no-fetch", action="store_true",
                          help="skip the network fetch_refs(); read only locally cached refs (for high-frequency dashboard polling)")
    sp_trust.set_defaults(func=cmd_trust)
    sub.add_parser("model", help="model tier: availability of each tier + the current pick (steps down automatically when quota is tight)").set_defaults(func=cmd_model)
    ap = sub.add_parser("api", help="single external entry: the same six-law gate, JSON out")
    ap.add_argument("verb")
    ap.add_argument("--caller", required=True, help="caller identity (trust is computed from its history)")
    ap.add_argument("--approved-by", default="", help="human signature for an irreversible operation")
    ap.add_argument("--line", default="", help="direction line for a run-contract query")
    ap.add_argument("--task", default="", help="task id for a run-contract query")
    ap.add_argument("--run-id", default="", help="exact run_id for a run-contract query")
    ap.add_argument("--no-fetch", action="store_true",
                    help="a read-only query skips the network fetch and uses locally cached refs")
    ap.set_defaults(func=cmd_api)
    sub.add_parser("value", help="value composition: V1/V2/V3 mechanical verification + leverage (six laws V1-V3)").set_defaults(func=cmd_value)
    dash = sub.add_parser("dashboard", help="one screen: nodes/ledger/plans/clock/DRIFT")
    dash.add_argument("--json", action="store_true", help="also emit machine-readable JSON")
    dash.set_defaults(func=cmd_dashboard)
    sub.add_parser("sync", help="swarm bus: send and receive heartbeats at the ref layer (does not touch the worktree)").set_defaults(func=cmd_sync)

    dc = sub.add_parser("discover", help="find work autonomously: scan mechanically checkable gaps → candidate tasks (really publishes only with --publish)")
    dc.add_argument("--publish", action="store_true")
    dc.add_argument("--plan-id")
    dc.add_argument("--source", help="list/publish only candidates from the named scanner source")
    dc.set_defaults(func=cmd_discover)

    pl = sub.add_parser("plan", help="publish an immutable plan (any node can publish = decentralized orchestration entry)")
    pl.add_argument("--id", required=True)
    pl.add_argument("--intent", required=True)
    pl.add_argument("--tasks", required=True, help="7 fields per line, separated by |")
    pl.set_defaults(func=cmd_plan)

    cl = sub.add_parser("claim", help="self-assess capability/shape/load → CAS-claim a task")
    cl.add_argument("--plan", required=True)
    cl.add_argument("--max-load", type=int, default=3)
    cl.add_argument("--ttl-min", type=int, default=60)
    cl.add_argument("--limit", type=int, default=0)
    cl.set_defaults(func=cmd_claim)

    rn = sub.add_parser("run", help="claim→execute→write back in one shot (distribution-layer execution entry)")
    rn.add_argument("--plan", required=True)
    rn.add_argument("--executor")
    rn.add_argument("--max-load", type=int, default=3)
    rn.add_argument("--ttl-min", type=int, default=60)
    rn.add_argument("--limit", type=int, default=0)
    rn.set_defaults(func=cmd_run)

    rs = sub.add_parser("result", help="the claimer writes the result back")
    rs.add_argument("--plan", required=True)
    rs.add_argument("--task", required=True)
    rs.add_argument("--status", default="done")
    rs.add_argument("--artifact")
    rs.set_defaults(func=cmd_result)

    ga = sub.add_parser("gather", help="any node summarizes; if the set is incomplete, refuse to declare completion")
    ga.add_argument("--plan", required=True)
    ga.add_argument("--settle", action="store_true", help="after the set is complete, write the settlement ref (CAS prevents duplicates)")
    ga.set_defaults(func=cmd_gather)
    lease = sub.add_parser("lease", help="take a line's execution lease (git CAS atomic lock)")
    lease.add_argument("--line", required=True)
    lease.add_argument("--ttl-min", type=int, default=60)
    lease.set_defaults(func=lambda a: (lambda r: (print(r[1]), 0 if r[0] else 1)[1])(
        acquire_lease(a.line, a.ttl_min)))
    sub.add_parser("health", help="driver self-check").set_defaults(func=cmd_health)
    sp_st = sub.add_parser("status", help="human-readable overview (expanded by line by default + a final total; --json is machine-readable)")
    sp_st.add_argument("--json", action="store_true", help="also emit by_line machine-readable JSON")
    sp_st.set_defaults(func=cmd_status)

    sel = sub.add_parser("select", help="heartbeat selection: leverage descending + resource_class three-state filter")
    sel.add_argument("--tasks", required=True, help="path to the loop_tasks table (TASKS.md or a fixture)")
    sel.add_argument("--resource-state", required=True, choices=["ok", "llm-exhausted", "unknown"],
                      help="only ok opens llm-light/llm-heavy; anything else fail-closes and allows only local-only")
    sel.set_defaults(func=cmd_select)

    exp = sub.add_parser("explain", help="unified ground-truth explanation: --node/--task/--topic lays out status/cause/evidence")
    exp_grp = exp.add_mutually_exclusive_group(required=True)
    exp_grp.add_argument("--node", help="node id, for example laptop / worker")
    exp_grp.add_argument("--task", help="line/task_id, for example cortex-immune/IMM-T20")
    exp_grp.add_argument("--topic", choices=sorted(EXPLAIN_TOPICS),
                          help="mechanism name: %s" % ", ".join(sorted(EXPLAIN_TOPICS)))
    exp.set_defaults(func=cmd_explain)

    mi = sub.add_parser("match-idle", help="IMM-T33: read-only diagnosis -- report a pairing when the owner is busy + pending is unclaimed + the swarm has an idle node that meets the bar")
    mi.add_argument("--line", help="look at only this line (default: scan every enabled line in CLOCK.md)")
    mi.add_argument("--no-fetch", action="store_true",
                    help="skip the network fetch_refs(); read only locally cached refs (same fix as trust --no-fetch, see IMM-T29)")
    mi.set_defaults(func=cmd_match_idle)

    args = parser.parse_args()
    if args.cmd in {
        "tick", "task-run", "submit", "try-complete", "run", "revive",
    }:
        ensure_guardrail_event_sources()
    # Ledger commands no longer share the tick lock with a long Worker. Each field write is a millisecond
    # atomic read-modify-replace by set_cells() on the corresponding TASKS.md; there is no lock during the model, network, or short_test.
    sys.exit(args.func(args))


if __name__ == "__main__":
    main()
