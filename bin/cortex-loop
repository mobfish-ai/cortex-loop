    tcp.add_argument("--task", required=True)
    tcp.add_argument("--judge", action="store_true")
    tcp.set_defaults(func=cmd_try_complete)

    dec = sub.add_parser("decompose", help="AI decomposes an intent → task rows (entered only after structural acceptance)")
