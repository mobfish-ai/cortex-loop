    "task-add", "task-retry", "task-reopen", "task-hold", "task-resume",
    "task-route", "submit", "try-complete", "decompose",
})

TERMINAL = {"done"}
# settling = short_test 已过、只等 git 传播；不是终态，也不是可 claim 的 pending
SKIP = {"waiting_external", "blocked", "done", "settling"}
# A content conflict is not a transport wait: retrying the same candidate
# against an unchanged canonical tree cannot converge forever.  Keep one
# settling retry for a canonical tip that may move, then fail closed as an
# explicit machine blocker.
INTEGRATION_CONTENT_CONFLICT_MAX_RETRIES = 2
# 任务状态全集（与 knowledge-contract-gate LOOP_TASK_STATUS 对齐）
TASK_STATUSES = {
    "pending", "running", "done", "waiting_external", "blocked", "settling",
}
TS = "%Y-%m-%dT%H:%M%z"
LEGACY_TS = "%Y-%m-%dT%H:%M"
# 实测锚点(2026-07-29)：worker git ls-remote 直连 0-1s；laptop 走代理链
# 均值 4s，历史见过 75s 超时批量失败。3s 卡在两者中间，不抖动。
NET_GITHUB_FAST_THRESHOLD_S = 3


def swarm_name():
    """蜂群自己的名字。没有名字就只能有一个群，也无法群与群互相感知。

    真相源 = CLOCK.md frontmatter `swarm:`；可被 CORTEX_SWARM 覆盖（多群共用一仓时用）。
    """
    if os.environ.get("CORTEX_SWARM"):
        return os.environ["CORTEX_SWARM"]
    if os.path.isfile(CLOCK):
        with open(CLOCK, encoding="utf-8") as fh:
            head = fh.read(2000)
        match = re.search(r"(?m)^swarm:\s*([A-Za-z0-9._-]+)\s*$", head)
        if match:
            return match.group(1)
    return "cortex"


SWARM_NAME = swarm_name()


def now():
    return datetime.now().astimezone()


def fmt(dt):
    return dt.strftime(TS)


def parse_ts(value):
    value = (value or "").strip()
    if not value or value == "-":
        return None
    for pattern in (TS, LEGACY_TS, "%Y-%m-%d"):
        try:
            parsed = datetime.strptime(value, pattern)
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=now().tzinfo)
            return parsed
        except ValueError:
            continue
    return None


def log(msg):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a", encoding="utf-8") as fh:
        fh.write("%s | %s\n" % (fmt(now()), msg))


# ── 三类安全事件：生产判定点 → 原子 JSONL ───────────────────────────

def _incident_recording_enabled():
    """CLI 生产运行默认启用；import 单测默认关闭，避免污染用户 HOME。"""
    configured = (os.environ.get("CORTEX_INCIDENT_RECORDING") or "").strip().lower()
    if configured:
        return configured in ("1", "true", "yes", "on")
    return _RUNNING_AS_CLI


def _guardrail_event_id(prefix, *parts):
    digest = hashlib.sha256("\0".join(str(v) for v in parts).encode("utf-8")).hexdigest()
    return "%s-%s" % (prefix, digest[:24])


def _run_incident_atom(script_name, argv):
    if not _incident_recording_enabled():
        return False
    script = os.path.join(ROOT, "bin", script_name)
    try:
        proc = subprocess.run(
            ["bash", script] + [str(v) for v in argv],
            cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=20, check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        log("guardrail-event ERROR %s %s" % (script_name, exc))
        return False
    if proc.returncode != 0:
        log("guardrail-event ERROR %s rc=%d %s" % (
            script_name, proc.returncode, proc.stderr.strip()[:240]))
        return False
    return True


def ensure_guardrail_event_sources():
    """由真实引擎原子初始化；不允许 Dashboard/人工 touch 冒充已接线。"""
    for script in (
        "cortex-authorization-incident.sh",
        "cortex-independent-verification-incident.sh",
        "cortex-budget-incident.sh",
    ):
        _run_incident_atom(script, ["init"])


def guardrail_bridge_status():
    script = os.path.join(ROOT, "bin", "cortex-guardrail-bridge-audit.py")
    try:
        proc = subprocess.run(
            ["python3", script, "status", "--json"],
            cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=20, check=False,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return {"state": "UNKNOWN", "reason": str(exc)}
    if proc.returncode != 0:
        return {"state": "UNKNOWN", "reason": proc.stderr.strip()[:240]}
    try:
        return json.loads(proc.stdout or "{}")
    except json.JSONDecodeError:
        return {"state": "UNKNOWN", "reason": "guardrail bridge status is not JSON"}


def auto_execution_allowed_by_guardrails():
    if (os.environ.get("CORTEX_ALLOW_GUARDRAIL_BREACH_AUTO") or "").lower() in (
        "1", "true", "yes", "on",
    ):
        return True, "breakglass override"
    status = guardrail_bridge_status()
    if status.get("incident_count", 0):
        return False, (
            "%s incidents; bridge_state=%s; recovery_gate=%s" % (
                status.get("incident_count"),
                status.get("state", "UNKNOWN"),
                status.get("recovery_gate", "human_review_required_before_resume"),
            )
        )
    return True, "no guardrail incidents"


def record_authorization_incident(line, task_id, incident_type, evidence, identity=None):
    event_id = _guardrail_event_id(
        "a", line, task_id, incident_type, evidence)
    return _run_incident_atom("cortex-authorization-incident.sh", [
        "record", task_id or "%s/unknown" % line, identity or node_id(),
        incident_type, evidence, event_id,
    ])


def record_budget_incident(line, task_id, incident_type, evidence, identity=None,
                           idempotency_key=""):
    event_id = _guardrail_event_id(
        "b", line, task_id, incident_type, idempotency_key or evidence)
    return _run_incident_atom("cortex-budget-incident.sh", [
        "record", task_id or "%s/unknown" % line, identity or node_id(),
        incident_type, evidence, event_id,
    ])


def is_model_quota_breach(text):
    """额度真正耗尽才是 breach；裸 429/rate-limit 只是瞬时流控。"""
    low = (text or "").lower()
    return bool(re.search(
        r"quota(?:\s+|[-_])?(?:exhausted|exceeded|depleted)|"
        r"usage limit(?:\s+|[-_])?(?:reached|exceeded)|"
        r"insufficient (?:credit|quota)|out of (?:credit|quota)|"
        r"credit(?:s)? (?:exhausted|depleted)|"
        r"额度(?:耗尽|用尽|超限|不足)|配额(?:耗尽|用尽|超限|不足)",
        low,
    ))


def record_model_quota_if_breach(line, task_id, executor, text, rule, rc=None):
    if not is_model_quota_breach(text):
        return False
    suppression = suppress_exec(executor, "quota")
    detail = (text or "").strip().split("\n")[-1][:240]
    evidence = ("rule=%s measured=1 budget=0 unit=successful-call "
                "executor=%s%s detail=%s" % (
                    rule, executor, " rc=%s" % rc if rc is not None else "", detail))
    return record_budget_incident(
        line, task_id, "model_quota_breach", evidence,
        idempotency_key="%s|%s|%s" % (
            executor, task_id, suppression.get("since", "unknown")))


def _explicit_completion_claim(body):
    """只接受明确终态声明；普通说明或一次测试失败不构成假完成。"""
    for raw in (body or "").splitlines():
        line = raw.strip()
        if re.fullmatch(r"(?i)(?:status|result|verdict)\s*[:=]\s*"
                        r"(?:done|pass(?:ed)?|accept(?:ed)?|complete(?:d)?)", line):
            return line[:240]
        if re.fullmatch(r"(?i)(?:done|pass(?:ed)?|accept(?:ed)?|complete(?:d)?)", line):
            return line[:240]
        if re.fullmatch(r"(?:状态|结果|结论)\s*[:：]\s*(?:已完成|完成|通过|验收通过|已验收)", line):
            return line[:240]
    return ""


def record_false_completion_if_claimed(line, task_id, result_file, failure,
                                        identity=None):
    try:
        with open(result_file, encoding="utf-8", errors="replace") as fh:
            body = fh.read(16000)
    except OSError:
        return False
    claim = _explicit_completion_claim(body)
    if not claim:
        return False
    failure = failure if isinstance(failure, dict) else {}
    stage = str(failure.get("stage") or "independent_check")
    detail = str(failure.get("detail") or "独立完成门拒绝")[:800]
    verification_kind = "short_test" if stage == "short_test" else (
        "try_complete" if stage in ("artifact", "contract", "judge", "state-cas")
        else "cross_artifact")
    evidence = "%s/%s stage=%s detail=%s" % (line, task_id, stage, detail)
    event_id = _guardrail_event_id("v", line, task_id, claim, stage, detail)
    return _run_incident_atom("cortex-independent-verification-incident.sh", [
        "record", task_id, identity or node_id(), "false_done_claim",
        verification_kind, claim, "rejected:%s" % stage, evidence, event_id,
    ])


# ── markdown 表格读写（唯一真相就是这张表，不做第二份缓存） ──────────────

def read_table(path, key="id"):
    """返回 (lines, header, rows)；rows = [(行号, {列名: 值})]。

    一个文件里可以有多张表（说明表 + 数据表）。只认**表头含 key 列**的那张，
    否则会把「列含义」说明表当成数据表 —— 这是 2026-07-28 首次冒烟的真实 bug。
    """
    if not os.path.isfile(path):
        return [], [], []
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().split("\n")
    header, rows, in_table, in_data = [], [], False, False
    for idx, line in enumerate(lines):
        stripped = line.strip()
        if not stripped.startswith("|"):
            in_table = in_data = False
            continue
        cells = [c.strip() for c in stripped.strip("|").split("|")]
        if not in_table:
            in_table = True
            # 只认第一张命中主键的表；**之后的表不得覆盖已认下的表头**。
            # 原实现每遇新表就重置 header，于是「数据表后面再来一张说明表」会把 header
            # 冲成空 —— rows 看着正常，header 却空了，导致唯一写入口 set_cell 抛
            # ValueError 崩溃（不是报红，是整个 tick 中断）。这曾是一条没人知道的隐式
            # 约束「数据表必须是文件最后一张表」。测试套件 D-01 发现。
            in_data = bool(key in cells and not header)
            if in_data:
                header = cells
            continue
        if not in_data or set("".join(cells)) <= set("-: "):
            continue                    # 非数据表的行 或 分隔行
        rows.append((idx, dict(zip(header, cells))))
    return lines, header, rows


def set_cell(path, row_id, column, value):
    """原子改单格；锁只覆盖本地 read-modify-replace，不跨网络/测试/模型。"""
    return set_cells(path, row_id, {column: value})


def _ledger_lock_path(path):
    digest = hashlib.sha256(os.path.abspath(path).encode("utf-8")).hexdigest()[:20]
    return "/tmp/spotlight/cortex-ledger-%s.lock" % digest


def _atomic_write_lines(path, lines):
    tmp = "%s.%s.%s.tmp" % (path, os.getpid(), time.time_ns())
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines))
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def set_cells(path, row_id, updates, expected_status=None):
    """同一任务多字段一次原子写；并发状态已变化时 CAS 拒绝覆盖新真相。"""
    for column, value in updates.items():
        if "|" in str(value):
            raise ValueError("字段值禁止包含 '|'（会破坏表格）: %s" % value)
    os.makedirs("/tmp/spotlight", exist_ok=True)
    with open(_ledger_lock_path(path), "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        lines, header, rows = read_table(path)
        missing = [column for column in updates if column not in header]
        if missing:
            raise ValueError("表中无此列: %s" % ",".join(missing))
        for idx, row in rows:
            if row.get("id") != row_id:
                continue
            if expected_status is not None:
                allowed = (expected_status if isinstance(expected_status, (tuple, list, set))
                           else (expected_status,))
                if row.get("status") not in allowed:
                    return False
            cells = [c.strip() for c in lines[idx].strip().strip("|").split("|")]
            while len(cells) < len(header):
                cells.append("")
            for column, value in updates.items():
                cells[header.index(column)] = str(value)
            lines[idx] = "| " + " | ".join(cells) + " |"
            _atomic_write_lines(path, lines)
            return True
    return False


# ── 蜂群：节点身份 · 自我感知 · 群体感知 ────────────────────────────────
# 设计要点：多节点同写一个 git 账本 = 冲突源。解法不是共识，是**分片**：
# CLOCK.owner 只保留为调度亲和性提示；它不再是执行准入门。
# 真正的单写协调由短时 line lease + 任务级 CAS/锁完成，避免一台机器把整条线
# 变成单点故障。

SWARM = os.path.join(DIRECTIONS, "_swarm")


def node_id():
    """Stable node id.

    CORTEX_NODE wins. Otherwise the hostname is sanitized to [a-z0-9-].
    Optional CORTEX_NODE_ALIASES is a comma-separated substring=id list
    matched against the lowercased hostname, for operators who want a
    stable nickname without baking machine names into the source.
    Example: CORTEX_NODE_ALIASES=studio=worker,laptop=laptop
    """
    if os.environ.get("CORTEX_NODE"):
        return os.environ["CORTEX_NODE"]
    _, host = run("hostname", timeout=10)
    host = host.strip().lower()
    for pair in os.environ.get("CORTEX_NODE_ALIASES", "").split(","):
        if "=" not in pair:
            continue
        key, name = pair.split("=", 1)
        key, name = key.strip().lower(), name.strip().lower()
        if key and name and key in host:
            alias = re.sub(r"[^a-z0-9-]", "-", name)[:24]
            if alias:
                return alias
    return re.sub(r"[^a-z0-9-]", "-", host)[:24] or "unknown"


# raw minimax/glm adapter 只会生成文本，不能读写工作区；它们可作为原子文本工具，
# 但绝不能宣告 exec.* 或进入 Worker ladder。唯一廉价工作区执行器是 cheap：
# Claude Code 工具层 + CC Switch MiniMax 账户。
CHEAP_ADAPTER_PROVIDERS = {
    "minimax": "minimax,minimax-cn",
    "glm": "zhipu",
    "cheap": "minimax,minimax-cn",
}
WORKSPACE_CHEAP_EXECUTORS = ("cheap",)
# L2 headless 策略 lane（Grok-first · DECIDE 自动续跑）；不进默认 ladder 抢 cheap
L2_HEADLESS_EXECUTORS = ("acp-lane",)
TEXT_ONLY_ADAPTERS = ("minimax", "glm")


def _oc_provider_key_present(providers_csv):
    """openclaw.json 的 models.providers.<name> 是否配置了至少一个 apiKey（单个字段或
    apiKeys[] 数组任一），providers_csv 逗号分隔可判多个候选 provider（命中一个即真）。
    读不到/解析不了 openclaw.json → 如实判 False，不猜。"""
    oj_path = os.environ.get("OPENCLAW_JSON_PATH",
                              os.path.expanduser("~/.openclaw/openclaw.json"))
    try:
        with open(oj_path, encoding="utf-8") as fh:
            oj = json.load(fh)
    except Exception:                                  # noqa: BLE001
        return False
    providers = oj.get("models", {}).get("providers", {})
    for name in providers_csv.split(","):
        p = providers.get(name.strip())
        if isinstance(p, dict) and (p.get("apiKey") or p.get("apiKeys")):
            return True
    return False


def _cheap_worker_ready(adapter):
    """检查真正的 workspace surface：Claude CLI + CC Switch MiniMax 账户。"""
    code, out = run("timeout 30 bash %s --check-ready 2>&1"
                    % shlex.quote(adapter), timeout=40)
    return code == 0, out.strip().split("\n")[-1][:160]


def _acp_lane_ready(adapter):
    """检查 acp-lane：adapter + acp-policy-client 可 dry-run/就绪。"""
    code, out = run("timeout 20 bash %s --check-ready 2>&1"
                    % shlex.quote(adapter), timeout=30)
    return code == 0, out.strip().split("\n")[-1][:160]


def resolve_task_executor(task, line_executor):
    """任务级执行器解析（显式优先）。

    顺序：
      1) task.requires_executor（非空且非 -）
      2) CLOCK 线默认 executor
      3) CORTEX_DEFAULT_EXECUTOR
      4) human
    使「CLOCK=cheap」时仍可对单任务写 requires_executor=acp-lane 走 L2 lane。
    """
    req = ""
    if isinstance(task, dict):
        req = (task.get("requires_executor") or "").strip()
    if req and req not in ("-", ""):
        return req
    line_ex = (line_executor or "").strip()
    if line_ex and line_ex not in ("-", ""):
        return line_ex
    env_ex = (os.environ.get("CORTEX_DEFAULT_EXECUTOR") or "").strip()
    if env_ex:
        return env_ex
    return "human"


# Task contracts retain the provider-facing executor identity, while adapter
# filenames use a safe vocabulary (POSIX `:` is legal but needlessly fragile
# across shells, archives, and pathspec tooling).
EXECUTOR_ADAPTER_ALIASES = {
    "acp-native:mmx-a": "acp-native-mmx-a",
    "acp-native:mmx-b": "acp-native-mmx-b",
    "acp-native:mmx-d": "acp-native-mmx-d",
    "acp-native:deepseek": "acp-native-deepseek",
    "acp-native:codex-luna": "acp-native-codex-luna",
    "acp-native:codex-spark": "acp-native-codex-spark",
}


def executor_adapter_name(executor):
    return EXECUTOR_ADAPTER_ALIASES.get(executor, executor)


def executor_adapter_path(executor):
    return os.path.join(ADAPTERS, "%s.sh" % executor_adapter_name(executor))


def node_profile():
    """自我感知：这台机器是什么、能干什么、会不会睡。

    can_sleep 是蜂群的关键字段 —— 它决定「这个节点静默了」该不该当故障：
    笔记本合盖静默是正常的，服务器静默就是掉线。

    IMM-T38：额外带 joined_at / samples_total —— 入群时间 + 累计心跳样本数
    全程来自 _peek_node_state() 的本地落盘(state 文件)，不在本函数里现算，
    也禁止把 last_seen 拿来冒充 joined_at，那是 E004 的反面教训。

    IMM-T39：额外带 trust_target / trust_now / trust_gap —— 节点级信任目标。
    trust_target 默认 L3（G5 蜂群整体信任最低门槛 = 0.70，与 EXPECTATIONS EX03 同源）。
    G6 健康分目标不下放到节点级：节点信任是 C2 的事，G6 是健康分的事。
    trust_now 现算 haas_score(me) 一次；trust_gap 是 trust_target 与当前实际信任
    的差距字符串，供 explain / swarm / dashboard 直观显示「还差多少」。
    """
    code, batt = run("pmset -g batt 2>/dev/null", timeout=10)
    is_laptop = "InternalBattery" in batt
    _, pm = run("pmset -g 2>/dev/null | grep SleepDisabled", timeout=10)
    sleep_disabled = "1" in pm.split()[-1:] if pm.strip() else False
    executors = []
    for name, probe in (("claude", "claude"), ("codex", "codex"),
                        ("openclaw", "openclaw"), ("ollama", "ollama"),
                        ("human", None), ("mock", None)):
        adapter = os.path.join(ADAPTERS, "%s.sh" % name)
        if not os.path.isfile(adapter):
            continue
        if probe is None or run("command -v %s" % probe, timeout=10)[0] == 0:
            executors.append(name)
    for name in WORKSPACE_CHEAP_EXECUTORS:
        adapter = os.path.join(ADAPTERS, "%s.sh" % name)
        ready, _ = _cheap_worker_ready(adapter) if os.path.isfile(adapter) else (False, "")
        if ready:
            executors.append(name)
    for name in L2_HEADLESS_EXECUTORS:
        adapter = os.path.join(ADAPTERS, "%s.sh" % name)
        if not os.path.isfile(adapter):
            continue
        ready, _ = _acp_lane_ready(adapter)
        if ready:
            executors.append(name)
    _, tg = run("curl -s -o /dev/null -w '%{http_code}' --max-time 8 "
                "https://api.telegram.org  # 2026-10-04 迁移: 快柠檬10794已淘汰(死代理shim退役前置), exit node 隧道直出", timeout=20)
    me = node_id()
    joined_at, samples_total = _peek_node_state(me)
    # IMM-T39 EX10：节点级信任目标 = L3（≥0.70），与 G5 群体最低门槛对齐。
    # 编排者节点 orchestrator-* 是独立身位（architecture.md §六定律三关），
    # 它的 trust_target 必须是 L4：不可逆任务要求 ≥L4 且有人签字（C3），
    # 若编排者只有 L1，蜂群就形同无编辑权 —— 提分路径就是 self_credit / fault。
    is_orchestrator = me == orchestrator_id()
    trust_target = "L4" if is_orchestrator else "L3"
    # 当前实际信任 = 现算 haas_score，无样本（meta.samples=0）= UNKNOWN
    # 现算后立刻吃掉 —— 这是「快照」语义，不是「假承诺」。EX10 验收只看字段是否
    # 落盘并可被读回，不要求每次读画像都重算（重算会拖慢查询密集路径，
    # 与 IMM-T29 trust-perf 教训同源）。
    trust_now_score, trust_now_meta = haas_score(me)
    trust_now_samples = int((trust_now_meta or {}).get("samples", 0) or 0)
    if trust_now_samples == 0:
        trust_now = "unknown"
        trust_gap = "?"
    else:
        trust_now = trust_level(trust_now_score)
        # 差距 = 目标等级序号 - 当前等级序号；负数 = 已超过目标，正数 = 还差 N 档。
        _order = [name for name, _ in TRUST_LEVELS]
        _gap = _order.index(trust_target) - _order.index(trust_now)
        trust_gap = "exceed by %d" % -_gap if _gap < 0 else (
            "?" if _gap == 0 and trust_now == "unknown" else "short by %d" % _gap)
    return {
        "node": me,
        "swarm": SWARM_NAME,
        "caps": " ".join(node_capabilities()),
        "kind": "laptop" if is_laptop else "always-on",
        "can_sleep": "no" if (not is_laptop or sleep_disabled) else "yes",
        "executors": " ".join(executors) or "-",
        "telegram_reach": "yes" if tg.strip().startswith(("2", "3")) else "no",
        "last_seen": now().strftime("%Y-%m-%dT%H:00"),  # 整点精度 = 一小时内无 diff，git 不噪音
        "joined_at": joined_at or fmt(now()),  # IMM-T38 EX09: 入群时间；state 缺失时落「现在」并强制落盘
        "samples_total": samples_total,        # IMM-T38 EX09: 累计心跳样本数；0 即未观测，不是 0 拍
        "owns": " ".join(e["line"] for e in clock_lines()
                         if e.get("owner") == me) or "-",
        # IMM-T39 EX10：节点级信任目标（与 G5 群体最低门槛对齐 + 编排者加档）
        "trust_target": trust_target,
        "trust_now": trust_now,
        "trust_gap": trust_gap,
    }



# ── 能力 schema（最小原子形态）───────────────────────────────────────
# 能力 = 一个字符串 ID 的集合。宣告 = beat payload 里一行；发现 = 读全群 beat；
# 路由 = 集合包含判断。就这么简单，但足够演化：以后能力 ID 可带版本/参数而不破协议。
#
# 命名空间约定（点分层级，前缀即类别）：
#   exec.*     能跑哪种执行器（claude / codex / openclaw / human / mock）
#   host.*     机器形态（always-on / laptop）
#   os.*       操作系统（darwin / linux）
#   runtime.*  本机调度器（launchd / systemd / cron）
#   net.*      网络可达性（telegram / github）
#   tool.*     装了什么工具（git / python3 / docker / ollama）

EXEC_STATE = "/tmp/spotlight/cortex-loop-exec-state.json"
NODE_STATE = "/tmp/spotlight/cortex-loop-node-state.json"   # IMM-T38 节点画像入群时间 + 累计样本
QUOTA_WINDOW_H = 5      # 订阅额度按 5 小时窗口重置；窗口一过自动恢复


def _load_exec_state():
    import json as _json
    if not os.path.isfile(EXEC_STATE):
        return {}
    try:
        with open(EXEC_STATE, encoding="utf-8") as fh:
            return _json.load(fh)
    except Exception:                              # noqa: BLE001
        return {}


def _save_exec_state(state):
    import json as _json
    os.makedirs(os.path.dirname(EXEC_STATE), exist_ok=True)
    with open(EXEC_STATE, "w", encoding="utf-8") as fh:
        _json.dump(state, fh, ensure_ascii=False, indent=2)


def _load_node_state():
    """节点本地记账：每个 node 第一次被看见的时间戳 + 累计心跳样本数。
    落盘在 /tmp/spotlight/cortex-loop-node-state.json —— 心跳不靠它写身份，
    只靠它记录「这个节点什么时候入群」「累计拍过多少拍」，给后续画像写路径
    提供 joined_at / samples_total 字段的真实落盘值，避免 runtime 现算漂移
    （IMM-T38：empty runtime print 就被点名过）。"""
    import json as _json
    if not os.path.isfile(NODE_STATE):
        return {}
    try:
        with open(NODE_STATE, encoding="utf-8") as fh:
            data = _json.load(fh)
        return data if isinstance(data, dict) else {}
    except Exception:                              # noqa: BLE001
        return {}


def _save_node_state(state):
    import json as _json
    os.makedirs(os.path.dirname(NODE_STATE), exist_ok=True)
    with open(NODE_STATE, "w", encoding="utf-8") as fh:
        _json.dump(state, fh, ensure_ascii=False, indent=2)


def _bump_node_state(node):
    """读取并原地更新本节点状态：首次出现写入 joined_at；
    每次调用累计 samples_total 并返回 (joined_at, samples_total)。

    返回值不带整点精度平化 —— 心跳拍数是单调递增整数，画像写路径
    自行决定呈现精度（与 last_seen 整点精度不同语义）。"""
    state = _load_node_state()
    rec = state.get(node) if isinstance(state.get(node), dict) else {}
    if not rec.get("joined_at"):
        rec["joined_at"] = fmt(now())
    rec["samples_total"] = int(rec.get("samples_total", 0) or 0) + 1
    state[node] = rec
    try:
        _save_node_state(state)
    except Exception as exc:                       # noqa: BLE001
        log("node state 落盘失败 node=%s err=%s" % (node, exc))
    return rec["joined_at"], rec["samples_total"]


def _peek_node_state(node):
    """只读不写：给纯查询路径（node_profile 不写盘时）使用。
    缺记录时返回空字符串 / 0 —— DIMENSIONAL 律视角这是三态的「未观测」，
    调用方不得误读为「刚入群」「零样本」。"""
    rec = _load_node_state().get(node) or {}
    return rec.get("joined_at", "") or "", int(rec.get("samples_total", 0) or 0)


def exec_suppressed(name):
    """这个执行器现在处于抑制期吗？返回 (是否抑制, 原因, 还剩几分钟)。

    为什么必须有：`command -v claude` 在**额度耗尽时依然成功** —— 命令还在，只是跑不动。
    只探命令存在就宣告能力 = **假宣告**：任务被派过来，烧一次调用才发现干不了，
    然后失败还倒扣 HAAS。能力宣告必须参考 revive 的最近诊断，不能只看命令在不在。

    额度类抑制**自动到期**（5 小时窗口重置）→ 到点能力自己回来，不需要任何人干预。
    这就是「额度窗口崩溃免疫」：耗尽时自动退场，窗口过了自动归队。
    """
    rec = _load_exec_state().get(name)
    if not rec:
        return False, "", 0
    until = parse_ts(rec.get("until"))
    if until is None or until <= now():
        return False, "", 0
    return True, rec.get("kind", "unknown"), int((until - now()).total_seconds() // 60)


def suppress_exec(name, kind, hours=None):
    """标记执行器进入抑制期。额度类按 5 小时窗口自动到期；认证类需人处理，标长些。"""
    hours = hours if hours is not None else (QUOTA_WINDOW_H if kind == "quota" else 12)
    state = _load_exec_state()
    existing = state.get(name) or {}
    until = parse_ts(existing.get("until"))
    if existing.get("kind") == kind and until is not None and until > now():
        return existing
    state[name] = {"kind": kind, "since": fmt(now()),
                   "until": fmt(now() + timedelta(hours=hours))}
    _save_exec_state(state)
    return state[name]


def clear_exec(name):
    state = _load_exec_state()
    if state.pop(name, None) is not None:
        _save_exec_state(state)


# ── 模型调档：额度紧张时降档，而不是停摆 ─────────────────────────────
# operator 2026-07-29：Opus 烧额度快，Sonnet 能跑更久 —— 系统该智能调配。
# 核心判断：**降档 ≠ 降级失败**。补合同字段、注册 skill、写 ERRORS 这类活，
# Sonnet 完全够用，上 Opus 是纯浪费额度。所以默认就该是 balanced，
# 只有明确需要强推理的任务才配 frontier。额度告急时逐档往下走，最后才停。
MODEL_TIERS = [
    ("frontier", "cortex.tier.frontier", "强推理：架构决策 / 跨域推演 / 对抗性审查"),
    ("balanced", "cortex.tier.balanced", "默认档：绝大多数结构化修复、补字段、写文档"),
    ("fast",     "cortex.tier.fast",     "省额度：格式化、抽取、简单改写"),
    ("local",    "",                     "本地兜底：ollama，断网/额度全耗尽时"),
]


def tier_model(policy_role):
    """每次调用前读取统一策略源，支持 env/file 热切换；读不到即 fail closed。"""
    if not policy_role:
        return ""
    resolver = os.path.join(ROOT, "bin", "model-policy.sh")
    try:
        proc = subprocess.run(
            ["bash", resolver, "get", policy_role],
            cwd=ROOT, text=True, capture_output=True, timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return proc.stdout.strip().splitlines()[-1] if proc.returncode == 0 and proc.stdout.strip() else ""


def pick_model(task=None):
    """按「任务需求 × 当前额度状态」选档。返回 (tier, model, 理由)。

    降档顺序 frontier → balanced → fast → local，**逐档退**而不是一步到停摆。
    任务可用 requires=tier.frontier 声明它真的需要强推理；不声明就走 balanced。
    """
    need = ""
    if task:
        need = next((c.split(".", 1)[1] for c in (task.get("requires") or "").split()
                     if c.startswith("tier.")), "")
    start = 0 if need == "frontier" else 1          # 默认从 balanced 起，不默认烧 Opus
    for idx in range(start, len(MODEL_TIERS)):
        tier, policy_role, why = MODEL_TIERS[idx]
        if tier == "local":
            hushed, _, _ = exec_suppressed("ollama")
            if not hushed and "exec.ollama" in " ".join(node_capabilities()):
                return tier, model, "已降到本地兜底：%s" % why
            continue
        model = tier_model(policy_role)
        if not model:
            continue
        hushed, kind, left = exec_suppressed("claude:%s" % tier)
        if hushed:
            continue                                 # 这一档在抑制期，往下降
        note = why if idx == start else "从 %s 降档而来（上档额度受限）" % MODEL_TIERS[start][0]
        return tier, model, note
    return None, "", "所有模型档位都不可用 → 退到 L2 纯代码模式"


def cmd_model(args):
    """看当前各档位可用性与选档结果 —— 额度状态一眼可见。"""
    print("蜂群 %s ｜ 节点 %s ｜ 模型档位" % (SWARM_NAME, node_id()))
    print("| 档位 | 模型 | 状态 | 用途 |")
    print("|------|------|------|------|")
    for tier, policy_role, why in MODEL_TIERS:
        model = tier_model(policy_role) if policy_role else ""
        key = "ollama" if tier == "local" else "claude:%s" % tier
        hushed, kind, left = exec_suppressed(key)
        state = "抑制中（%s，还剩 %d 分钟）" % (kind, left) if hushed else "可用"
        print("| %s | %s | %s | %s |" % (tier, model or "ollama", state, why))
    t, m, why = pick_model()
    print("\n当前默认选档：**%s**（%s）—— %s" % (t or "无", m or "-", why))
    print("默认不从 frontier 起 —— 大多数活 Sonnet 够用，上 Opus 是浪费额度。")
    print("任务确实需要强推理时写 requires=tier.frontier。")
    return 0


def probe_executor_model(name):
    """执行器背后**真实**跑的是什么模型、谁在付账。

    2026-07-29 实证：两个节点都宣告 exec.claude，但 laptop 是 Opus（Max 订阅），
    worker 是 Claude Code 壳指向 api.minimax.io 的 MiniMax-M2.7（API key）。
    **同名不同物**。只报执行器名而不报模型，等于把「能力差一大截」这件事藏起来 ——
    任务会被静默派给跑不动的节点，而账本上看不出任何异常。

    返回 (model_id, billing, tier)；拿不到就如实标 unknown，不猜。

    **为什么必须实探而不能自报**：节点若能自己声明「我是 Opus」，蜂群就会被伪装信息
    带偏 —— 任务派过去实际由一个小模型跑完，账本上还显示一切正常。
    这里读的是**进程真实环境变量**；更硬的一层由 `cortex-loop attest` 让模型自己签字。
    """
    if name == "claude":
        base = os.environ.get("ANTHROPIC_BASE_URL", "")
        model = os.environ.get("ANTHROPIC_MODEL", "")
        if base or model:
            host = re.sub(r"^https?://|/.*$", "", base) or "unknown-host"
            provider = host.split(".")[-2] if "." in host else host
            return (model or "unknown").lower(), "api-key", provider
        if os.environ.get("ANTHROPIC_API_KEY"):
            return "anthropic-default", "api-key", "anthropic"
        return "anthropic-subscription", "subscription", "anthropic"
    if name == "codex":
        return "openai-codex", "subscription", "openai"
    if name == "acp-native:codex-luna":
        return "gpt-5.6-luna", "subscription-codex-luna", "openai"
    if name == "acp-native:codex-spark":
        return os.environ.get("CORTEX_CODEX_SPARK_MODEL", "gpt-5.3-codex-spark"), "subscription-codex-spark", "openai"
    if name == "openclaw":
        return "openclaw-routed", "mixed", "openclaw"
    if name == "minimax":
        return "minimax-m2.7", "api-key", "minimax"
    if name == "glm":
        return "glm-4-flash", "api-key", "zhipu"
    if name == "cheap":
        # cheap 已升级为 MiniMax-backed Claude Code 工具层；raw GLM completion
        # 不具备工作区执行能力，不能再冒充可替换的执行器 fallback。
        return "minimax-m2.7", "api-key", "minimax"
    if name == "acp-lane":
        # L2 headless：默认 Grok 后端 + DECIDE 自动续跑；模型以 policy/backend 为准
        backend = (os.environ.get("CORTEX_ACP_BACKEND") or "grok").strip().lower()
        return "acp-lane-%s" % backend, "api-key", backend
    return name, "none", "local"


def node_capabilities():
    """探测本节点真实具备的能力 —— 全部实探，不读配置、不靠声明。

    例外：cheap-tier（minimax/glm/cheap）没有 CLI 命令可探，`command -v` 天然探不到
    HTTP adapter；"实探"落到同一档诚实度的替代动作 —— 查 openclaw.json 里对应
    provider 有没有配 key（有 = 有资格宣告，不等于打过真实请求验证过）。真正的
    调用成败仍由 adapter 自己的多 key 轮换 + exec_suppressed() 兜底，这里不重复。
    """
    caps = []
    for name, probe in (("claude", "claude"), ("codex", "codex"),
                        ("openclaw", "openclaw"), ("human", None), ("mock", None)):
        if not os.path.isfile(os.path.join(ADAPTERS, "%s.sh" % name)):
            continue
        if probe is None or run("command -v %s" % probe, timeout=10)[0] == 0:
            hushed, why, left = exec_suppressed(name)
            if hushed:
                # 命令在但跑不动 —— 不宣告，免得任务派过来白烧一次
                continue
            caps.append("exec.%s" % name)
            if probe is not None:      # 只有真调模型的执行器才报模型与计费
                model, billing, provider = probe_executor_model(name)
                caps.append("model.%s.%s" % (provider, re.sub(r"[^a-z0-9.-]", "-", model)))
                caps.append("billing.%s" % billing)

    for name in WORKSPACE_CHEAP_EXECUTORS:
        if not os.path.isfile(os.path.join(ADAPTERS, "%s.sh" % name)):
            continue
        ready, _ = _cheap_worker_ready(os.path.join(ADAPTERS, "%s.sh" % name))
        if not ready:
            continue
        hushed, why, left = exec_suppressed(name)
        if hushed:
            continue
        caps.append("exec.%s" % name)
        model, billing, provider = probe_executor_model(name)
        caps.append("model.%s.%s" % (provider, re.sub(r"[^a-z0-9.-]", "-", model)))
        caps.append("billing.%s" % billing)

    for name in L2_HEADLESS_EXECUTORS:
        adapter = os.path.join(ADAPTERS, "%s.sh" % name)
        if not os.path.isfile(adapter):
            continue
        ready, _ = _acp_lane_ready(adapter)
        if not ready:
            continue
        hushed, why, left = exec_suppressed(name)
        if hushed:
            continue
        caps.append("exec.%s" % name)
        model, billing, provider = probe_executor_model(name)
        caps.append("model.%s.%s" % (provider, re.sub(r"[^a-z0-9.-]", "-", model)))
        caps.append("billing.%s" % billing)
        caps.append("lane.l2-headless")

    # raw completion 仍可被原子化工具使用，但显式处于 text.* 命名空间，
    # 防止选择器把它们误当成能 Edit/Bash 的 Worker。
    for name in TEXT_ONLY_ADAPTERS:
        providers_csv = CHEAP_ADAPTER_PROVIDERS[name]
        if os.path.isfile(os.path.join(ADAPTERS, "%s.sh" % name)) \
                and _oc_provider_key_present(providers_csv):
            caps.append("text.%s" % name)

    code, batt = run("pmset -g batt 2>/dev/null", timeout=10)
    is_laptop = "InternalBattery" in batt
    caps.append("host.laptop" if is_laptop else "host.always-on")

    _, uname = run("uname -s", timeout=10)
    caps.append("os.%s" % uname.strip().lower() or "os.unknown")

    for tool in ("git", "python3", "docker", "ollama", "rsync"):
        if run("command -v %s" % tool, timeout=10)[0] == 0:
            caps.append("tool.%s" % tool)

    if run("command -v launchctl", timeout=10)[0] == 0:
        caps.append("runtime.launchd")
    if run("command -v systemctl", timeout=10)[0] == 0:
        caps.append("runtime.systemd")

    _, tg = run("curl -s -o /dev/null -w '%{http_code}' --max-time 8 "
                "https://api.telegram.org  # 2026-10-04 迁移: 快柠檬10794已淘汰(死代理shim退役前置), exit node 隧道直出", timeout=20)
    if tg.strip().startswith(("2", "3")):
        caps.append("net.telegram")
    started = time.time()
    ok = run("git ls-remote --exit-code origin HEAD >/dev/null 2>&1", timeout=90)[0] == 0
    latency = time.time() - started
    caps.extend(_github_latency_caps(ok, latency))
    return sorted(set(caps))


def _github_latency_caps(ok, latency):
    """git ls-remote 探测结果 → 能力标签。拆成纯函数只为可测（不依赖真网络）。

    实测锚点(2026-07-29)：worker 直连 0-1s，laptop 走代理链 4s 常态、
    历史见过 75s 超时批量失败。账本写入密集的任务可声明 requires:
    net.github.fast，自动避开代理链更长、更易抖动的节点。
    """
    if not ok:
        return []
    return ["net.github",
            "net.github.fast" if latency < NET_GITHUB_FAST_THRESHOLD_S else "net.github.slow"]


def cmd_caps(args):
    """能力发现：全群谁有什么，以及蜂群整体的能力并集。"""
    fetch_refs()
    nodes = read_swarm()
    if not nodes:
        print("蜂群空（先跑 sync）")
        return 1
    all_caps = sorted({c for n in nodes.values() for c in (n.get("caps") or "").split()})
    print("蜂群 %s ｜ %d 节点 ｜ %d 项能力" % (SWARM_NAME, len(nodes), len(all_caps)))
    print()
    width = max(len(c) for c in all_caps) if all_caps else 10
    header = "| %-*s |" % (width, "能力") + "".join(" %-9s |" % n for n in sorted(nodes))
    print(header)
    print("|" + "-" * (width + 2) + "|" + "".join("-" * 11 + "|" for _ in nodes))
    for cap in all_caps:
        row = "| %-*s |" % (width, cap)
        for name in sorted(nodes):
            has = cap in (nodes[name].get("caps") or "").split()
            row += " %-9s |" % ("✅" if has else "·")
        print(row)
    print()
    # 单点能力 = 蜂群的脆弱处：这台挂了这项能力就没了
    single = [c for c in all_caps
              if sum(1 for n in nodes.values() if c in (n.get("caps") or "").split()) == 1]
    if single:
        print("⚠️ 单点能力（只有一个节点具备，该节点挂了这项能力即失去）：")
        for cap in single:
            owner = [n for n, v in nodes.items() if cap in (v.get("caps") or "").split()][0]
            print("   %-22s 仅 %s" % (cap, owner))
    return 0


def write_profile(prof=None):
    """落节点画像。传 prof 可写非本机节点（主线程用它写 orchestrator 画像）——
    对等的前提是共用同一套落盘逻辑，不给主线程另开一份格式。

    IMM-T38：把 joined_at / samples_total 写入画像 markdown 表格，这样
    「入群时间 + 累计样本」是 git 历史的一部分而不是 runtime 现算。
    字段值来自 _bump_node_state() / _peek_node_state() —— 已被强制落盘，
    不再用 last_seen 冒充 first_seen（E004 反面教训）。

    IMM-T39：把 trust_target / trust_now / trust_gap 写入画像 markdown 表格。
    节点级信任目标 = L3（编排者节点加档 L4），与 G5 群体最低门槛（≥0.70 = L3）
    对齐 —— 蜂群整体信任受限于最弱节点，没有节点级目标，G5 永远只是名义。
    trust_now 与 trust_gap 一起落盘，下一拍 swarm / dashboard / explain 可读，
    无需现算 —— EX10 验收只看字段是否进画像，不要求每次读画像都重算 haas_score。

    自刷新路径（prof=None，即自我 tick / swarm 命令）才 bump 累计样本；
    外部传入的 prof（写 orchestrator / 调试写他节点）只 peek 不 bump，避免
    隔山打牛把别人节点的样本数也乱改。
    """
    os.makedirs(SWARM, exist_ok=True)
    if prof is None:
        prof = node_profile()
        # 自刷新 = 一次「我来了」的实锤，不只写文件还写本地 state。
        joined_at, samples_total = _bump_node_state(prof["node"])
        prof["joined_at"] = joined_at
        prof["samples_total"] = samples_total
    path = os.path.join(SWARM, "%s.md" % prof["node"])
    body = ["---", "type: loop_node", "node: %s" % prof["node"],
            "status: active", "---", "",
            "# 节点画像 — %s" % prof["node"], "",
            "> 自动生成（`cortex-loop swarm`）。`last_seen` 取整点精度：",
            "> 一小时内重复 tick 内容不变 → git 无 diff → 蜂群心跳不制造 commit 噪音。",
            "> `joined_at` 入群时间 + `samples_total` 累计心跳样本来自本地记账（IMM-T38），",
            "> 不以 `last_seen` 替代前者，也不允许只打印不落盘。",
            "> `trust_target` 节点级信任目标（IMM-T39 EX10）：",
            "> 与 G5 群体最低门槛 L3（≥0.70）对齐，编排者节点加档 L4。",
            "> `trust_now` / `trust_gap` 自刷新时由 `node_profile()` 一次现算后落盘，",
            "> 不在查询路径现算 —— 与 IMM-T29 trust-perf 教训同源。", "",
            "| 字段 | 值 |", "|------|-----|"]
    for key in ("node", "kind", "can_sleep", "executors", "telegram_reach",
                "last_seen", "joined_at", "samples_total", "owns",
                "trust_target", "trust_now", "trust_gap"):
        body.append("| %s | %s |" % (key, prof.get(key, "-" if key != "joined_at" else "unknown")))
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(body) + "\n")
    return prof


def commit_own_profile(prof):
    """把 write_profile() 刚落盘的画像文件提交进 git 历史（IMM-T30 根因修复）。

    根因：write_profile() 只写工作区文件，从不 commit。有人工/agent 会话的
    机器（laptop）这个文件会顺路搭上其他人工 commit；纯 systemd/launchd
    无人值守心跳的机器（worker）从来没人做人工 commit —— 文件永远停在
    「已修改未提交」，laptop fetch 到的画像永远是几天前的旧快照，看起来像
    掉线，其实心跳（journalctl beat=ok）一直在跳，只是签到信号传不回来。
    `git-sync-v4.sh` 的 30 分钟同步窗口也不覆盖这个路径（它的
    commit_worker_jobs() 只认 jobs.json）——两边都以为对方在管。

    只提交这一个文件（`git-commit-transaction.sh` 的 producer:path 白名单已
    加 `cortex-loop-checkin:brain-network/directions/_swarm/*.md`，见该文件）。
    只 commit 不 push——push 交给 git-sync 下一拍的安全事务
    （acquire_tx_lock + validate_candidate_range + push_exact），
    不在这里重新实现一遍推送/冲突处理，避免两套推送逻辑互相打架。
    """
    node = prof.get("node") if prof else None
    if not node:
        return
    path = os.path.join(SWARM, "%s.md" % node)
    if not os.path.isfile(path):
        return
    rel = os.path.relpath(os.path.abspath(path), ROOT)
    # 执行面与结算面解耦：提交事务锁被占时跳过画像 commit，绝不挡住本拍 claim。
    # 画像只是心跳可见性优化；claim/short_test 不依赖它进 origin。
    tx_lock = os.path.join(ROOT, ".git", "ob1-transaction.lock.d")
    code_gp, gp = git("rev-parse --git-path ob1-transaction.lock.d", timeout=10)
    if code_gp == 0 and (gp or "").strip():
        tx_lock = (gp or "").strip()
        if not os.path.isabs(tx_lock):
            tx_lock = os.path.join(ROOT, tx_lock)
    if os.path.isdir(tx_lock):
        log("commit_own_profile: skip — git 提交事务锁忙（不阻塞 claim）")
        return
    code, out = git("status --porcelain -- %s" % shlex.quote(rel), timeout=15)
    if code != 0:
        log("commit_own_profile: git status 失败 rc=%s" % code)
        return
    if not out.strip():
        return   # 无变更：整点精度下大多数拍都会命中这里，不制造 commit 噪音
    helper = os.path.join(ROOT, "bin", "git-auto-commit.sh")
    if not os.path.isfile(helper):
        log("commit_own_profile: %s 缺失，跳过" % helper)
        return
    msg = "sync(checkin): 刷新 %s 节点画像 last_seen" % node
    cmd = "%s --producer cortex-loop-checkin -m %s -- %s" % (
        shlex.quote(helper), shlex.quote(msg), shlex.quote(rel))
    # 短超时：画像 commit 可 defer，不能拖死整拍
    code, out = run("cd %s && %s" % (shlex.quote(ROOT), cmd), timeout=25)
    if code == 0:
        log("commit_own_profile: %s 已提交" % rel)
    elif code == 3:
        pass  # 事务层判定"无实质变化"，与本函数的判断结果一致，不算异常
    elif code == 75:
        log("commit_own_profile: skip rc=75 事务忙（不阻塞 claim）")
    else:
        log("commit_own_profile: %s 提交失败 rc=%s out=%s"
            % (rel, code, out.strip()[-200:]))


def beat_publish(prof):
    """把自己的心跳推到 refs/swarm/beat/<node>。

    只写自己的 ref → 别的节点永远不会碰它 → 结构上不可能冲突。
    parent 挂自己上一拍，保证 fast-forward，不需要 --force。
    """
    ref = "%s/%s" % (BEAT_NS, prof["node"])
    old = rev_ref(ref)
    payload = "\n".join("%s=%s" % (k, v) for k, v in prof.items())
    ok, commit = write_ref(ref, payload, parent=old)
    if ok:
        # 推远端成功后必须同步本地 ref，否则节点**看不见自己刚发的心跳**
        # （write_ref 直推远端不动本地）—— worker 首次报「蜂群可见 1 节点：laptop」即此因
        git("update-ref %s %s" % (ref, commit), timeout=30)
    return ok


def read_swarm():
    """群体感知：优先读 ref（真相），无 ref 时退回文件快照。"""
    nodes = {}
    for ref in list_refs(BEAT_NS):
        prof = {}
        for row in read_ref(ref).split("\n"):
            if "=" in row:
                key, _, val = row.partition("=")
                prof[key.strip()] = val.strip()
        if prof.get("node"):
            nodes[prof["node"]] = prof
    if nodes:
        return nodes
    if not os.path.isdir(SWARM):
        return nodes
    print("⚠️ ref 层读不到任何节点，退回本地文件快照（可能 fetch 失败或 ref 未推送）",
          file=sys.stderr)
    for name in sorted(os.listdir(SWARM)):
        if not name.endswith(".md"):
            continue
        _, _, rows = read_table(os.path.join(SWARM, name), key="字段")
        prof = {r["字段"]: r["值"] for _, r in rows if r.get("字段")}
        if prof.get("node"):
            nodes[prof["node"]] = prof
    return nodes


def quiet_limit(prof):
    """不同机器不同尺子：笔记本合盖过夜是正常的，常开机静默 3 小时就不正常。"""
    return 14 if prof.get("can_sleep") == "yes" else 3


def beat_ref_precise_seen(prof):
    """从本地 refs/swarm/<swarm>/beat/<node> 的 commit 时间读精确 last_seen。

    profile 里的 last_seen 是整点精度(写心跳时特意抹平的,为了「一小时内 tick
    内容不变 → git 无 diff → 心跳不制造 commit 噪音」)。副作用：会出现
    "刚推过心跳却显示静默 0.9h" 这种矛盾 —— 2026-07-29 worker 实测过的
    具体案例。beat ref 的 commit 时间才是精确到秒的真相。

    只读本地已有 ref，不在这里额外 fetch —— 是否刷新由调用方决定
    (与 cmd_swarm 现有"读本地缓存"的既有行为一致,不新增隐式网络调用；
    tick/dashboard 等已在外层调过 fetch_refs())。

    返回 datetime 或 None。None = 本地读不到精确时间(可能从没 fetch 过 /
    节点从没发过心跳 / git 命令异常) —— 调用方必须退回 profile 的
    last_seen 字段,不能当"没心跳"处理(那是 fail-open 的反面 fail-closed
    误杀,一样错;UNVERIFIABLE 三态范式：读不到 ≠ 判定为不存活)。
    """
    node = prof.get("node")
    if not node:
        return None
    ref = "%s/%s" % (BEAT_NS, node)
    code, out = git("log -1 --format=%%ci %s" % ref, timeout=15)
    if code != 0 or not out.strip():
        return None
    ts = out.strip().split("\n")[-1]
    try:
        # %ci 形如 "2026-07-29 10:55:11 +0800"。保留 offset，才能与
        # timezone-aware now()/receipt 跨节点比较，不再依赖机器恰好同一时区。
        return datetime.strptime(ts, "%Y-%m-%d %H:%M:%S %z")
    except ValueError:
        return None


def node_alive(prof):
    precise = beat_ref_precise_seen(prof)
    seen = precise if precise is not None else parse_ts(prof.get("last_seen"))
    if seen is None:
        return False, "无心跳记录"
    quiet = (now() - seen).total_seconds() / 3600
    limit = quiet_limit(prof)
    precision = "beat ref 精确时间" if precise is not None else "profile 整点精度"
    if quiet <= limit:
        return True, "静默 %.1fh（阈值 %dh · %s）" % (quiet, limit, precision)
    reason = "合盖睡眠也解释不了" if prof.get("can_sleep") == "yes" else "常开机应无静默"
    return False, "静默 %.1fh 超阈值 %dh — %s（%s）" % (quiet, limit, reason, precision)


def takeover_ready(prof):
    """可接管 = 静默超阈值的 **2 倍**。

    只判「不在线」就抢会误伤：笔记本刚过 14h 可能只是周末合盖多睡了会儿。
    留一倍缓冲，宁可晚接管，不可抢了又还回去（抖动比停摆更伤）。

    与 node_alive() 用同一把尺子(beat ref 精确时间优先,退回 profile 整点
    精度)——两处各用各的时间源会制造新的"哪个判据才是真相"的分歧,
    正是今天在修的那类"高维状态被压成不一致低维值"的病。
    """
    precise = beat_ref_precise_seen(prof)
    seen = precise if precise is not None else parse_ts(prof.get("last_seen"))
    if seen is None:
        return True
    return (now() - seen).total_seconds() / 3600 > quiet_limit(prof) * 2


SYNC_STAMP = "/tmp/spotlight/cortex-loop.sync"
# 线路租约只保护一次 scheduler pass，不覆盖 detached worker 的生命周期。
# 长租约会把“owner 正在忙”错误地等价成“其它节点不可用”，形成跨节点
# 单点瓶颈；worker 的去重和 fencing 由任务级 claim/ledger CAS 负责。
SCHEDULER_LEASE_MIN = 5

# ── 去中心化任务分发（规格：reports/2026-07-28/_standalone/cortex-loop-swarm-dispatch-spec.md）
# CLOCK.owner 只提供日常亲和性；健康节点都可以竞争短时 scheduler lease。
# 本层解决「一个计划怎么拆开、被多台机自主认领并汇总」。无 leader、无选举、
# 无 quorum —— git 服务器只提供存储 + ref 的原子 CAS。
PLAN_NS = "refs/swarm/%s/plan" % SWARM_NAME
CLAIM_NS = "refs/swarm/%s/claim" % SWARM_NAME
RESULT_NS = "refs/swarm/%s/result" % SWARM_NAME
# Immutable terminal projections live beside the swarm ledger instead of in an
# attempt worktree.  An attempt root is intentionally disposable after its
# candidate is integrated, so it cannot be the only reader-facing source.
RUN_CONTRACT_NS = "refs/swarm/%s/run-contract" % SWARM_NAME
# A candidate/integrator landing can become visible to a reader just before the
# terminal publisher's immutable ref is locally visible.  Keep this wait tiny:
# it covers same-process/ref propagation, not a second delivery workflow.
TERMINAL_REF_READ_RETRIES = 3
TERMINAL_REF_READ_DELAY_SEC = 0.05
# 【EX14 · T36】失败冷却：单次 failed 后 N 分钟内不重试，过后可再 claim。
# 比 0 = 等于没做；比 TTL 长 = 别的节点也白等。5 分钟够网关/模型半恢复，
# 又短到不会把蜂群拖到不可用的地步。
FAIL_COOLDOWN_MIN = 5
# 【EX15 · T37】长任务 >advance 窗口时（典型 240min）心跳必须被中间 touch，
# 否则 pulse/dashboard 没法区分「在干重活」与「节点掉线」——两种状态都让
# last_seen 静止，单一信号压成两态是经典 DIMENSIONAL 坍缩。
#
# 三态设计（与 node_alive 的两态布尔互补，组合出 3×2 矩阵）：
#   running + heartbeat_fresh  → busy         干着重活（绿，不是红）
#   running + heartbeat_stale  → stale-running 看起来在跑其实死了（红）
#   !running + heartbeat_fresh → alive        闲置在线
#   !running + heartbeat_stale → offline      节点掉线
# 60s touch 间隔 + 180s stale 阈值 → 心跳拍(15min)之间至少有一次新鲜探针，
# pulse/dashboard 单跑也能看到「这个节点在干重活」。
LONG_TASK_HEARTBEAT_SEC = 60
LONG_TASK_HEARTBEAT_STALE_SEC = 180
# Discovery 是候选进入计划前的不可变快照；learning 只存候选，不直接改任何 Skill。
DISCOVERY_NS = "refs/swarm/%s/discovery" % SWARM_NAME
LEARNING_NS = "refs/swarm/%s/learning" % SWARM_NAME
# 【第四态】任务的归宿不是三态（pending / done / failed），是**四态**：
#   pending  没人碰过
#   done     干成了            → 计功
#   failed   干了没成          → 计过
#   moot     判据本来就满足    → **既无功也无过，但它是终态**
# 空转门（2026-07-29）识别出了第四态却只 `continue`，没给它落脚点，于是它被
# 折叠回 pending —— 计划因此永远闭不了，tick 的「先接旧活」分支被同一个
# 早已没活的计划锁住 6 拍零产出。给第四态**自己的命名空间**而不是塞进 result：
# 塞进 result 会污染 HAAS 与过门率（空转既不该加分也不该扣分），
# 独立 ns 让「没活可干」被记住、被跳过，却不进任何功劳账。
MOOT_NS = "refs/swarm/%s/moot" % SWARM_NAME
ADVANCE_NS = "refs/swarm/%s/advance" % SWARM_NAME

# 【EX15 · T37】长任务心跳中间写入 —— busy ≠ offline 的物理基础
# 落点选 /tmp/spotlight 是因为它在每个节点本地、零网络依赖、与节点身份一一对应，
# 不会被误判成蜂群共识；缺点是节点重启会丢，所以**只是活体探针**，不是日志。
# 不复用 BEAT_NS 是因为 beat 是「节点活着」30 秒级整数粒度的整心跳，
# 我们要的是「任务级」秒级粒度的中间心跳；混在一起会让 beat ref 频繁 commit
# 破坏「一小时内 tick 内容不变则 git 无 diff」的设计（cortex-loop:579）。
RUNNING_HEARTBEAT_DIR = "/tmp/spotlight"


def touch_running_heartbeat(line, task_id):
    """长任务中间心跳探针——每 LONG_TASK_HEARTBEAT_SEC 秒被后台 ticker 调一次。

    写一个**纯本地**的小文件：节点身份(line+task+node+ts)，单点读、单点写，
    与蜂群 beat ref 完全独立。pulse/dashboard 读这文件的 mtime 即可判断
    「最近一次长任务心跳在多久前」——比 last_seen 整点精度细两个数量级。
    """
    os.makedirs(RUNNING_HEARTBEAT_DIR, exist_ok=True)
    fname = "%s/cortex-loop-running-heartbeat-%s-%s" % (
        RUNNING_HEARTBEAT_DIR, line, task_id)
    ts = fmt(now())
    try:
        with open(fname, "w", encoding="utf-8") as fh:
            fh.write("line=%s\ntask=%s\nnode=%s\ntouched_at=%s\n" % (
                line, task_id, node_id(), ts))
    except OSError as exc:
        # 写探针失败 ≠ 任务失败 —— 只 log 不 raise，让 adapter 继续跑
        log("running-heartbeat touch FAIL %s/%s: %s" % (line, task_id, exc))
        return False
    return True


def read_running_heartbeat(line, task_id):
    """读出最近一次长任务心跳的时间戳；文件不存在/不可读 → None（UNKNOWN 态）。"""
    fname = "%s/cortex-loop-running-heartbeat-%s-%s" % (
        RUNNING_HEARTBEAT_DIR, line, task_id)
    if not os.path.isfile(fname):
        return None
    try:
        mtime = os.path.getmtime(fname)
    except OSError:
        return None
    return datetime.fromtimestamp(mtime, tz=timezone.utc)


def list_running_heartbeats():
    """扫所有长任务心跳探针，返回 [(line, task_id, mtime_iso)] 列表。

    pulse/dashboard 用这一把拿全节点全任务的中间心跳视图，
    避免每个节点各自维护状态机 —— 反正 /tmp/spotlight 是单机的真相。
    """
    if not os.path.isdir(RUNNING_HEARTBEAT_DIR):
        return []
    out = []
    for entry in sorted(os.listdir(RUNNING_HEARTBEAT_DIR)):
        if not entry.startswith("cortex-loop-running-heartbeat-"):
            continue
        rest = entry[len("cortex-loop-running-heartbeat-"):]
        if "-" not in rest:
            continue
        line, _, task_id = rest.partition("-")
        path = os.path.join(RUNNING_HEARTBEAT_DIR, entry)
        try:
            mtime = datetime.fromtimestamp(os.path.getmtime(path), tz=timezone.utc)
        except OSError:
            continue
        out.append((line, task_id, mtime))
    return out


def start_long_task_heartbeat(line, task_id):
    """开后台 ticker，每 LONG_TASK_HEARTBEAT_SEC 秒 touch 一次；返回 pid 文件路径。

    ticker 进程与主 cmd_tick 同生命周期：被父进程 SIGTERM 时 EXIT trap 收尸
    （见 stop_long_task_heartbeat 调用方）。**这是 busy ≠ offline 的关键**——
    没有 ticker，advance_once 跑 30 分钟时节点 beat ref 不会更新，
    pulse 看到的只是「心跳 30 分钟前」，但其实节点在干重活。
    """
    os.makedirs(RUNNING_HEARTBEAT_DIR, exist_ok=True)
    pidfile = "%s/cortex-loop-running-heartbeat-%s-%s.pid" % (
        RUNNING_HEARTBEAT_DIR, line, task_id)
    # 防止旧 ticker 残留：先试 kill -0 再清
    if os.path.isfile(pidfile):
        try:
            old = int(open(pidfile).read().strip() or "0")
        except (OSError, ValueError):
            old = 0
        if old > 0:
            try:
                os.kill(old, 0)  # 探活，不发信号
                log("long-task heartbeat ticker 已在跑 pid=%s 复用" % old)
                return pidfile
            except OSError:
                pass
        try:
            os.remove(pidfile)
        except OSError:
            pass
    # 立即 touch 一次，避免「刚启动 → 30s 内 pulse 看不到任何探针」的盲区
    touch_running_heartbeat(line, task_id)
    ticker_cmd = (
        "while true; do sleep %d; "
        "python3 -c 'import sys, importlib.util, importlib.machinery; "
        "from pathlib import Path; "
        "p=Path(\"%s/bin/cortex-loop\"); "
        "ld=importlib.machinery.SourceFileLoader(\"cl\", str(p)); "
        "sp=importlib.util.spec_from_loader(ld.name, ld); "
        "m=importlib.util.module_from_spec(sp); ld.exec_module(m); "
        "m.touch_running_heartbeat(\"%s\", \"%s\")' "
        "|| exit 0; done" % (
            LONG_TASK_HEARTBEAT_SEC, ROOT, line, task_id))
    code, _ = run("sh -c '%s' &" % ticker_cmd.replace("'", "'\\''"),
                  timeout=10)
    # run 用 timeout 兜底；真 pid 由 sh 拿，我们再回扫 pidfile 由 ticker 自己写
    # 简化：上面 sh 命令没把 pid 落文件，改用 nohup 路径直接拿 child pid
    # —— 退一步：直接 fork 而不依赖 run()，下面这段是首选路径
    pid = os.fork()
    if pid == 0:
        # 子进程：写自己的 pid 到 pidfile，然后循环 sleep+touch
        try:
            with open(pidfile, "w", encoding="utf-8") as fh:
                fh.write(str(os.getpid()))
        except OSError:
            os._exit(1)
        try:
            while True:
                time.sleep(LONG_TASK_HEARTBEAT_SEC)
                touch_running_heartbeat(line, task_id)
        except KeyboardInterrupt:
            pass
        finally:
            try:
                os.remove(pidfile)
            except OSError:
                pass
        os._exit(0)
    # 父进程：把子进程 pid 落文件（即使上一步 fork 路径已写，也再写一次保险）
    try:
        with open(pidfile, "w", encoding="utf-8") as fh:
            fh.write(str(pid))
    except OSError:
        pass
    return pidfile


def stop_long_task_heartbeat(pidfile):
    """收 ticker 子进程。SIGTERM → 等 2s → 还活着 SIGKILL；最后清 pidfile。

    三段式：先礼貌、再强杀、最后清账。任何一步失败都 log 但不 raise——
    这是清理路径，**永远不能**因为清理失败把 advance_once 的真实结果掩盖掉。
    """
    if not pidfile or not os.path.isfile(pidfile):
        return
    try:
        pid = int(open(pidfile).read().strip() or "0")
    except (OSError, ValueError):
        pid = 0
    if pid > 0:
        try:
            os.kill(pid, 15)  # SIGTERM
        except OSError:
            pass
        # 等 2s 让 ticker 优雅退出
        for _ in range(20):
            time.sleep(0.1)
            try:
                os.kill(pid, 0)
            except OSError:
                pid = 0
                break
        if pid > 0:
            try:
                os.kill(pid, 9)  # SIGKILL 兜底
            except OSError:
                pass
    try:
        os.remove(pidfile)
    except OSError:
        pass


def reap_stale_running_tasks(line):
    """长任务心跳过期 > LONG_TASK_HEARTBEAT_STALE_SEC 且还在 status=running → 收回 pending。

    与 reclaim_inherited_running 不同：本函数只看**本节点正在跑**的任务，
    不是已死进程的孤儿。新 tick 启动时调一次：把僵尸 running 暴露出来，
    下半拍 claim 能正常把它们接走。

    判据 = running 状态 + 没有最近心跳 + 已经过 stale 窗口。
    三态：
      ① 没有 heartbeat 文件 → 启动 ticker 失败或重启过，保守收回
      ② heartbeat 文件存在但 stale → ticker 死了但任务没死，必须收回
      ③ heartbeat 文件 fresh → 真在跑，跳过

    不强行等久：超时翻倍不会让死任务复生，只会让活任务在下次 reclaim 时被误判。
    """
    if not line:
        return []
    path = tasks_path(line)
    if not os.path.isfile(path):
        return []
    tasks = load_tasks(line)
    if not tasks:
        return []
    reclaimed = []
    cutoff = datetime.now(tz=timezone.utc) - timedelta(seconds=LONG_TASK_HEARTBEAT_STALE_SEC)
    for task in tasks:
        if task.get("status") != "running":
            continue
        touched = read_running_heartbeat(line, task["id"])
        if touched is not None and touched >= cutoff:
            # 真在跑：心跳新鲜 → 不动
            continue
        why = "无 running heartbeat 文件" if touched is None else \
            "heartbeat stale %.0fs（阈值 %ds）" % (
                (datetime.now(tz=timezone.utc) - touched).total_seconds(),
                LONG_TASK_HEARTBEAT_STALE_SEC)
        if not set_cells(path, task["id"], {
                "status": "pending", "next_advance_after": "-",
                "updated_at": fmt(now()),
        }, expected_status="running"):
            continue
        reclaimed.append(task["id"])
        msg = "reap-stale-running %s/%s → pending（%s，EX15 防御点）" % (
            line, task["id"], why)
        print(msg)
        log(msg)
    return reclaimed

# ── git-native 蜂群总线（零外部依赖 · 无 Redis · 不碰工作区）──────────────
#
# 核心洞见：`git push` 更新远端 ref 是**原子 compare-and-swap**。
# 两个节点拿同一个 old 当 parent 造新 commit 同时 push，服务器只会让一个 fast-forward
# 成功，另一个必被拒 —— 这就是天然的分布式租约锁，语义等价于 Redis SETNX，
# 但不需要任何外部服务。
#
# 心跳同理：每个节点只推自己的 refs/swarm/beat/<node>，结构上不可能撞。
# 全程用 plumbing（hash-object / mktree / commit-tree），**不 checkout、不碰工作区**，
# 所以 worker 那 267 个未提交文件也拦不住它。

BEAT_NS = "refs/swarm/%s/beat" % SWARM_NAME
LEASE_NS = "refs/swarm/%s/lease" % SWARM_NAME


def git(cmd, timeout=120):
    # Swarm plumbing writes commits. A fresh checkout often has no
    # user.name, and a developer machine may have commit.gpgsign on.
    # Pin a fixture identity and do not sign, so tick does not depend
    # on a personal git config.
    return run(
        "cd %s && git -c user.name=cortex-loop "
        "-c user.email=cortex-loop@example.invalid "
        "-c commit.gpgsign=false %s" % (ROOT, cmd),
        timeout=timeout,
    )


def write_ref(ref, payload, parent=None):
    """把一段文本封进 ref。返回 (ok, 新 commit sha)。"""
    code, blob = git("hash-object -w --stdin <<'CORTEXEOF'\n%s\nCORTEXEOF" % payload)
    if code != 0:
        return False, ""
    blob = blob.strip().split("\n")[-1]
    code, tree = git("mktree <<'CORTEXEOF'\n100644 blob %s\tpayload\nCORTEXEOF" % blob)
    if code != 0:
        return False, ""
    tree = tree.strip().split("\n")[-1]
    parent_arg = "-p %s " % parent if parent else ""
    code, commit = git("commit-tree %s %s-m swarm" % (tree, parent_arg))
    if code != 0:
        return False, ""
    commit = commit.strip().split("\n")[-1]
    if not re.fullmatch(r"[0-9a-f]{40}", commit):
        return False, ""      # 空/异常 sha 绝不 push：`push origin :ref` = 删远端 ref，致命
    # 不加 --force：非 fast-forward 必须被拒，被拒正是锁生效的信号
    code, out = _git_net_retry(
        "push origin %s:%s 2>&1" % (commit, ref),
        timeout=180, attempts=3, label="push_swarm_ref",
    )
    if code != 0:
        # 「被 CAS 拒绝」与「网络挂了」必须分开报 —— 压成同一个 False 会让纯网络故障
        # 被说成「别的节点先抢到了」，于是 tick 静默跳过该线而日志看着一切正常。
        # 本机 GitHub 走 Privoxy，实测约每 6 次抖 1 次 SSL_ERROR_SYSCALL（测试套件 O-01）。
        tail = out.strip().split("\n")[-1][:160]
        if re.search(
                r"non-fast-forward|\[rejected\]|fetch first|cannot lock ref|"
                r"failed to update ref|reference already exists|stale info",
                out, re.I):
            print("CAS 拒绝 %s（别的节点先推上去了）" % ref, file=sys.stderr)
            return False, "REJECTED"
        print("push %s 网络/权限失败（**不是** CAS 拒绝）：%s" % (ref, tail), file=sys.stderr)
        return False, "ERROR"
    # origin CAS 已成功，本地 ref 也必须立刻指向同一对象。否则同一进程紧接着
    # `rev_ref/read_ref` 会看不见自己刚拿到的 claim：远端账本说“你持有”，
    # 本地执行门却说“没有有效 claim”，整拍 0 产出。这里不是第二次裁决，
    # 只是把已经被 origin 接受的事实同步进本地缓存。
    local_code, local_out = git("update-ref %s %s" % (ref, commit), timeout=30)
    if local_code != 0:
        print("origin 已写入但本地 ref 更新失败 %s：%s"
              % (ref, local_out.strip().split("\n")[-1][:160]), file=sys.stderr)
        return False, "LOCAL_REF_ERROR"
    return True, commit


def _git_net_retry(args, timeout=180, attempts=3, label="git-net"):
    """代理链偶发 LibreSSL SSL_ERROR_SYSCALL：短重试，真断网仍失败。"""
    last_code, last_out = 1, ""
    for attempt in range(max(1, attempts)):
        last_code, last_out = git(args, timeout=timeout)
        if last_code == 0:
            return 0, last_out
        if attempt + 1 < attempts:
            time.sleep(2 * (attempt + 1))
    return last_code, last_out


def fetch_refs():
    code, _ = _git_net_retry(
        "fetch origin '+refs/swarm/*:refs/swarm/*' --prune --quiet",
        timeout=180,
        attempts=3,
        label="fetch_swarm",
    )
    return code == 0


def _safe_ref_component(value):
    """把账本主键收敛成合法、稳定的 ref path component。"""
    return re.sub(r"[^A-Za-z0-9._-]+", "-", (value or "").strip()).strip("-") or "unknown"


def reserve_daily_advance(line, day_cap, retries=5, task_id=""):
    """在 git ref 上原子预占一次本地日历日推进额度。

    每次真正调用 Worker 前先预占，所以失败尝试同样计入额度（否则坏执行器可以
    无限烧调用）。远端 ref 的 fast-forward push 是 CAS；并发节点只有一个能写，
    失败者 fetch 后重算。网络/权限未知时 fail closed，不把“看不见计数器”当作
    “今天还没用过”。
    """
    try:
        cap = max(0, int(day_cap))
    except (TypeError, ValueError):
        cap = 0
    day = now().strftime("%Y-%m-%d")
    ref = "%s/%s" % (ADVANCE_NS, _safe_ref_component(line))
    token = hashlib.sha256(
        ("%s|%s|%s|%s|%s" % (line, day, node_id(), os.getpid(), time.time_ns()))
        .encode("utf-8")
    ).hexdigest()[:20]

    for _attempt in range(max(1, retries)):
        if not fetch_refs():
            return False, 0, "日额度 ref 无法同步（网络/权限 UNKNOWN）"
        old = rev_ref(ref)
        kv = parse_kv(read_ref(ref)) if old else {}
        reservations = []
        if kv.get("day") == day:
            reservations = [
                item for item in (kv.get("reservations") or "").split(",")
                if re.fullmatch(r"[0-9a-f]{20}", item)
            ]
        if token in reservations:
            return True, len(reservations), "已预占"
        if len(reservations) >= cap:
            evidence = ("rule=daily-cas-cap measured=%d budget=%d unit=advances/day "
                        "line=%s day=%s" % (len(reservations) + 1, cap, line, day))
            record_budget_incident(
                line, task_id, "daily_cas_overage", evidence,
                idempotency_key="%s|%s|%d" % (line, day, cap))
            return False, len(reservations), "已达本地日历日上限 %d/%d" % (
                len(reservations), cap)
        reservations.append(token)
        payload = "\n".join([
            "schema=daily-advance-v1",
            "line=%s" % line,
            "day=%s" % day,
            "count=%d" % len(reservations),
            "reservations=%s" % ",".join(reservations),
            "last_node=%s" % node_id(),
            "updated_at=%s" % fmt(now()),
        ])
        ok, why = write_ref(ref, payload, parent=old)
        if ok:
            return True, len(reservations), "已预占 %d/%d" % (len(reservations), cap)
        if why not in ("REJECTED", "LOCAL_REF_ERROR"):
            return False, len(reservations) - 1, "日额度 ref 写入失败（网络/权限 UNKNOWN）"
        # CAS 被别的节点抢先更新，或 origin 已成功但本地缓存更新失败：重新 fetch，
        # 若本 token 已在远端则幂等成功，否则基于新计数重试。
    if fetch_refs():
        kv = parse_kv(read_ref(ref))
        reservations = (kv.get("reservations") or "").split(",")
        if kv.get("day") == day and token in reservations:
            return True, len([x for x in reservations if x]), "已预占"
    return False, 0, "日额度 CAS 连续冲突，按 fail closed 不推进"


def _bounded_failure_context(line, task_id, failure):
    """失败上下文只保留 Repair Controller 真需要的字段，并先做通用脱敏。"""
    failure = failure or {}
    detail = str(failure.get("detail") or "未捕获失败输出")
    detail = detail.replace("CORTEXEOF", "[REDACTED]")
    detail = re.sub(r"(?i)\bbearer\s+[A-Za-z0-9._~+/=-]+", "Bearer [REDACTED]", detail)
    detail = re.sub(
        r"(?i)\b(authorization|api[_-]?key|token|secret|password)\b"
        r"(\s*[:=]\s*|\s+)([^\s,;]+)",
        lambda m: "%s%s[REDACTED]" % (m.group(1), m.group(2)),
        detail,
    )
    detail = re.sub(r"\b(?:sk|ak)-[A-Za-z0-9_-]{12,}\b", "[REDACTED]", detail)
    detail = re.sub(r"\s+", " ", detail).strip()[:600]
    try:
        rc = int(failure.get("rc"))
    except (TypeError, ValueError):
        rc = -1
    return {
        "line": str(line)[:80],
        "task": str(task_id)[:80],
        "stage": re.sub(r"[^A-Za-z0-9._-]+", "-", str(
            failure.get("stage") or "unknown"))[:80],
        "rc": rc,
        "detail": detail,
        "at": fmt(now()),
        "at_epoch": time.time(),
        "node": node_id()[:120],
    }


def _load_failure_state():
    if not os.path.isfile(FAILURE_STATE):
        return {}
    try:
        with open(FAILURE_STATE, encoding="utf-8") as fh:
            state = json.load(fh)
        return state if isinstance(state, dict) else {}
    except (OSError, ValueError):
        return {}


def persist_failure_context(line, task_id, failure):
    """把最新失败写入非 /tmp 的有界真相源；原子替换且跨进程加锁。

    `/tmp` result 仍是原始执行回执，但机器重启会丢。这里仅保存每个任务最新一条
    已脱敏诊断输入，并把总任务数限制为 128；既能跨重启恢复 Repair Controller，
    又不会把模型输出和潜在凭据无限追加到永久日志。
    """
    record = _bounded_failure_context(line, task_id, failure)
    state_dir = os.path.dirname(FAILURE_STATE)
    os.makedirs(state_dir, exist_ok=True)
    lock_path = FAILURE_STATE + ".lock"
    with open(lock_path, "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        state = _load_failure_state()
        state["%s/%s" % (line, task_id)] = record
        if len(state) > 128:
            ordered = sorted(
                state.items(),
                key=lambda item: (
                    float(item[1].get("at_epoch") or 0)
                    if isinstance(item[1], dict) else 0
                ),
                reverse=True,
            )
            state = dict(ordered[:128])
        tmp = "%s.%s.%s.tmp" % (FAILURE_STATE, os.getpid(), time.time_ns())
        try:
            with open(tmp, "w", encoding="utf-8") as fh:
                json.dump(state, fh, ensure_ascii=False, sort_keys=True, indent=2)
                fh.flush()
                os.fsync(fh.fileno())
            os.replace(tmp, FAILURE_STATE)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    return record


def load_failure_context(line, task_id):
    """Repair Controller 的重启恢复入口：只读任务最新一条持久失败。"""
    record = _load_failure_state().get("%s/%s" % (line, task_id), {})
    return record if isinstance(record, dict) else {}


# ── ref 批量读快照（T29 性能修复）─────────────────────────────────────────
# 根因不是「缓存不够」，是**调用方式错**：read_ref 每条 ref 起 2 条 git（rev-parse +
# cat-file），而 git() 还把每条包进 `sh -c "cd ... && git ..."` —— 实际 4 个进程。
# haas_score 逐条读 120 条 result ref，cmd_trust 又调 8 次 haas_score
# ⇒ ~2200 次 git ⇒ 实测 94.85s（39.7s user / 41.5s system，system 占一半正是
# 进程创建开销的指纹），远超 dashboard 的 20s CORTEX_DASH_TRUST_TIMEOUT，
# `timeout` 一刀砍下去整张信任表只吐出一半（T29 的现象面）。
#
# 修法是换调用方式：`git cat-file --batch` 一个子进程吐完 N 条 payload
# （实测 120 条 0.021s）。快照**必须显式开启且只包住只读报告路径**——
# 绝不做常开全局缓存：write_ref 的脚注点名过「同一进程紧接着 read_ref
# 会看不见自己刚拿到的 claim」，常开缓存正好复现那条致命路径，
# 也正是本任务 failure_modes 里「只加缓存不解决根因导致数据长期陈旧」。
_REF_SNAPSHOT = None          # None = 未启用；dict = ref → payload（含确认缺失的 ""）
_REF_LIST_SNAPSHOT = None     # None = 未启用；dict = namespace → ref 列表


# ── ref 三态返回契约（EX11 · DIMENSIONAL 母题第 5 处）───────────────────────
# 旧契约里 read_ref 在「git 异常」与「ref 真无 payload」之间共用 ""，
# list_refs 在「for-each-ref 异常」与「namespace 真无 ref」之间共用 []。
# 30 个调用点下游靠 parse_kv / .split / set 走，看不到这两态的区别 →
# "git 出错" 被静默压成"确认没数据"，下游据此判 done/failed/health
# 全是说谎。EX11 把这两态拆开，让调用方能区分 "ok / empty / error"。
#
# 实现手法：str / list 子类，字符串 / 列表接口 100% 兼容旧调用点，
# 但每个返回都带 .status / .reason 元数据，调用方可按需做精细判断。
class ReadRefResult(str):
    """read_ref 的三态返回（str 子类，行为与旧返回 100% 等价）。"""

    __slots__ = ("status", "reason")

    def __new__(cls, status, payload="", reason=""):
        instance = super().__new__(cls, payload)
        instance.status = status      # "ok" | "empty" | "error"
        instance.reason = reason      # 异常态的成因（人类可读，调试用）
        return instance

    def __repr__(self):
        return "ReadRefResult(status=%r, payload=%r, reason=%r)" % (
            self.status, str.__str__(self), self.reason)

    @property
    def is_ok(self):
        return self.status == "ok"

    @property
    def is_empty(self):
        return self.status == "empty"

    @property
    def is_error(self):
        return self.status == "error"


class ListRefsResult(list):
    """list_refs 的三态返回（list 子类，行为与旧返回 100% 等价）。"""

    __slots__ = ("status", "reason")

    def __new__(cls, status, refs=None, reason=""):
        # list.__new__ 不接受 iterable 参数（与 str.__new__ 不同），
        # 内容初始化必须放在 __init__；这里只造空壳。
        return super().__new__(cls)

    def __init__(self, status, refs=None, reason=""):
        # type.__call__ 会用 (status, refs, reason) 同时调 __new__ 与 __init__，
        # list.__init__ 只接 1 个 iterable —— 自己接管初始化。
        super().__init__(list(refs) if refs else [])
        self.status = status      # "ok" | "empty" | "error"
        self.reason = reason

    def __repr__(self):
        return "ListRefsResult(status=%r, refs=%r, reason=%r)" % (
            self.status, list.__repr__(self), self.reason)

    @property
    def is_ok(self):
        return self.status == "ok"

    @property
    def is_empty(self):
        return self.status == "empty"

    @property
    def is_error(self):
        return self.status == "error"


def read_refs_batch(refs):
    """一个 git cat-file --batch 子进程读完 N 条 ref 的 payload。

    返回 dict（ref → payload；确认无 payload 的记 ""）。量具本身不可用时返回
    **None**，让调用方退回逐条慢路（fail-safe）—— 绝不把「读不到」压成
    「确认没数据」，那是 DIMENSIONAL 律点名的第三态塌缩。
    """
    refs = list(dict.fromkeys(r for r in refs if r))
    if not refs:
        return {}
    stdin_payload = "".join("%s:payload\n" % r for r in refs)
    try:
        proc = subprocess.run(
            ["git", "cat-file", "--batch"], cwd=ROOT,
            input=stdin_payload.encode(), stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, timeout=60,
        )
    except (subprocess.TimeoutExpired, OSError) as exc:
        print("read_refs_batch 不可用（退回逐条读，**不是**「无数据」）：%s" % exc,
              file=sys.stderr)
        return None
    if proc.returncode != 0:
        print("read_refs_batch 退出码 %d（退回逐条读）：%s"
              % (proc.returncode,
                 proc.stderr.decode("utf-8", "replace").strip().split("\n")[-1][:120]),
              file=sys.stderr)
        return None
    out, got, pos = proc.stdout, {}, 0
    for ref in refs:
        nl = out.find(b"\n", pos)
        if nl < 0:
            print("read_refs_batch 输出在 %s 处提前结束（退回逐条读）" % ref, file=sys.stderr)
            return None
        header = out[pos:nl].decode("utf-8", "replace").split()
        pos = nl + 1
        # `<input> missing` / `<input> ambiguous` = git 确认取不到 payload，是正常空态，
        # 与 read_ref 对「ref 不存在」返回 "" 的既有契约一致。
        if len(header) >= 2 and header[-1] in ("missing", "ambiguous"):
            got[ref] = ""
            continue
        if len(header) != 3 or not header[2].isdigit():
            print("read_refs_batch 表头无法解析 %r（退回逐条读）" % (header[:3],),
                  file=sys.stderr)
            return None
        size = int(header[2])
        got[ref] = out[pos:pos + size].decode("utf-8", "replace")
        pos += size + 1       # 跳过 git 在 payload 后追加的换行
    return got


class ref_snapshot(object):
    """只读报告路径专用：预取若干 namespace 的全部 payload，期间 read_ref /
    list_refs 走内存，不再起子进程。

    预取失败 → 不启用快照，整段退回原逐条路径（结果完全一致，只是慢）。
    退出时无条件清空 —— 快照绝不跨命令存活。
    """

    def __init__(self, *namespaces):
        self.namespaces = namespaces
        self.active = False

    def __enter__(self):
        global _REF_SNAPSHOT, _REF_LIST_SNAPSHOT
        lists, refs = {}, []
        for ns in self.namespaces:
            lists[ns] = list_refs(ns)      # 此刻快照未启用，走真 git，拿到的是当下真值
            refs.extend(lists[ns])
        got = read_refs_batch(refs)
        if got is None:
            return self                    # 量具不可用 → 慢路，但不给错数
        _REF_SNAPSHOT, _REF_LIST_SNAPSHOT = got, lists
        self.active = True
        return self

    def __exit__(self, *exc):
        global _REF_SNAPSHOT, _REF_LIST_SNAPSHOT
        _REF_SNAPSHOT, _REF_LIST_SNAPSHOT = None, None
        self.active = False
        return False


def read_ref(ref):
    """EX11 · DIMENSIONAL 母题第 5 处 —— 三态返回契约。

    返回 ReadRefResult（str 子类）。字符串接口 100% 兼容旧 30 个调用点
    （parse_kv / .split / print / +），但每个返回都带 .status 元数据：
        status = "ok"     → payload 非空，确认读到 payload
        status = "empty"  → payload 为空，但 git/rev-parse 确认此 ref 真无 payload
                            （含 rev-parse 找不到 / git "invalid object name"）
        status = "error"  → payload 为空，git 命令真出错（timeout / 非 0 退出 / IO），
                            调用方**不能**把它当作"确认无数据"做下游决策

    DIMENSIONAL 律：第三态独立成 "error"，绝不被坍缩回 "empty"。
    "invalid object name" / "not a valid object name" = git 确认无 payload → empty。
    """
    # 对调用方来说，不存在是正常空态。先用 rev-parse 判本地是否有 ref，避免
    # locale 变化把 Git 的 "invalid object name" 翻译后误报成异常洪水。
    # 快照命中用 `in` 判成员而非真值 —— "" 是「确认无 payload」的合法缓存值，
    # 用真值判会让它每次穿透回 2 条子进程，等于没优化。
    if _REF_SNAPSHOT is not None and ref in _REF_SNAPSHOT:
        payload = _REF_SNAPSHOT[ref]
        status = "empty" if not payload else "ok"
        return ReadRefResult(status, payload, "snapshot hit")
    if not rev_ref(ref):
        return ReadRefResult("empty", "", "rev-parse returned no sha — confirmed absent")
    code, out = git("cat-file -p %s:payload 2>&1" % ref, timeout=60)
    if code == 0:
        return ReadRefResult("ok", out, "")
    if code == 124:
        print("read_ref %s 超时（无法确认是否存在，不是「确认无数据」）" % ref, file=sys.stderr)
        return ReadRefResult("error", "", "git cat-file timeout")
    if re.search(r"invalid object name|not a valid object name", out, re.I):
        # git 明确说此 ref 无 payload —— 确认空态，不是错误。
        return ReadRefResult("empty", "", "git says ref has no payload")
    print("read_ref %s 异常（不是「确认无数据」）：%s"
          % (ref, out.strip().split("\n")[-1][:120]), file=sys.stderr)
    return ReadRefResult("error", "", "git cat-file exit %d" % code)


def list_refs(namespace):
    """EX11 三态：ok / empty / error。ListRefsResult 是 list 子类，保留
    [r for r in list_refs(NS)] / len() / sorted() 等旧用法，但调用方可读
    `.status` 区分「确认空」与「git 命令异常」。
    """
    # 快照期内同一 namespace 只查一次 git，且保证同一趟报告里 8 次 haas_score
    # 看到的是**同一个 ref 集合**（顺带消掉「读到读之间账本变了」的不一致面）。
    if _REF_LIST_SNAPSHOT is not None and namespace in _REF_LIST_SNAPSHOT:
        refs = list(_REF_LIST_SNAPSHOT[namespace])
        status = "empty" if not refs else "ok"
        return ListRefsResult(status, refs, "snapshot hit")
    code, out = git("for-each-ref --format='%(refname)' " + namespace + " 2>&1", timeout=60)
    if code == 0:
        refs = [l.strip() for l in out.split("\n") if l.strip().startswith(namespace)]
        status = "empty" if not refs else "ok"
        return ListRefsResult(status, refs, "")
    print("list_refs %s 失败（不是「确认无 ref」）：%s"
          % (namespace, out.strip().split("\n")[-1][:120] if out.strip() else "退出码 %d" % code),
          file=sys.stderr)
    return ListRefsResult("error", [], "git for-each-ref exit %d" % code)


def rev_ref(ref):
    """本地 ref → sha。拿不到返回 None（绝不返回空串，见 write_ref 的致命脚注）。"""
    code, out = git("rev-parse --verify --quiet %s" % ref, timeout=30)
    sha = out.strip().split("\n")[-1] if code == 0 else ""
    return sha if re.fullmatch(r"[0-9a-f]{40}", sha or "") else None


def acquire_lease(line, ttl_min=60):
    """抢线的执行租约。同时抢的两个节点，git 服务器保证只有一个成功。"""
    ref = "%s/%s" % (LEASE_NS, line)
    fetch_refs()          # 必须先同步：本地缺 ref 会被误判成「无人持有」
    old = rev_ref(ref)
    holder, expires = None, None
    if old:
        for row in read_ref(ref).split("\n"):
            if row.startswith("holder="):
                holder = row.split("=", 1)[1].strip()
            if row.startswith("expires="):
                expires = parse_ts(row.split("=", 1)[1].strip())
    me = node_id()
    if holder and holder != me and expires and expires > now():
        return False, "租约在 %s 手上，%s 到期" % (holder, fmt(expires))
    payload = "holder=%s\nexpires=%s\nsince=%s" % (
        me, fmt(now() + timedelta(minutes=ttl_min)), fmt(now()))
    ok, why = write_ref(ref, payload, parent=old)
    if ok:
        return True, "已持有租约至 %s" % fmt(now() + timedelta(minutes=ttl_min))
    if why == "ERROR":
        return False, "**网络/权限故障，不是被抢** —— 本节点此刻看不清蜂群，按 fencing 不动手"
    return False, "抢租约被拒（同一瞬间有别的节点先推上去了 — CAS 生效）"


def cmd_sync(args):
    """蜂群总线 —— 全程 ref 层，零外部依赖，**不碰工作区**。

    为什么不能走工作区文件：2026-07-28 worker 实况 267 个文件未提交、auto-sync 已坏，
    任何 pull/rebase/checkout 都会被脏树挡住，蜂群跟着瞎。
    ref 层完全绕开工作区 —— 脏树、冲突、卡住的 auto-sync 都影响不到心跳。
    """
    prof = node_profile()
    fetch_refs()
    ok = beat_publish(prof)
    if not ok:                      # 极少见：同一节点两个进程同时推
        fetch_refs()
        ok = beat_publish(prof)
    if ok:
        with open(SYNC_STAMP, "w", encoding="utf-8") as fh:
            fh.write(fmt(now()))
    nodes = read_swarm()
    print("sync %s | 蜂群可见 %d 节点：%s | beat=%s"
          % (prof["node"], len(nodes), " ".join(sorted(nodes)) or "-", "ok" if ok else "FAIL"))
    log("sync nodes=%d beat=%s" % (len(nodes), ok))
    return 0 if ok else 1


def sync_fresh(max_min=90):
    """我最近成功跟蜂群对过账吗？—— fencing 的依据。"""
    if not os.path.isfile(SYNC_STAMP):
        return False
    with open(SYNC_STAMP, encoding="utf-8") as fh:
        stamp = parse_ts(fh.read().strip())
    return bool(stamp) and (now() - stamp).total_seconds() / 60 <= max_min


def parse_kv(text):
    out = {}
    for row in text.split("\n"):
        if "=" in row and not row.startswith("task\t"):
            key, _, val = row.partition("=")
            out[key.strip()] = val.strip()
    return out


def plan_tasks(plan_id):
    """读计划里的子任务。plan 一旦发布不可变 —— 避免「计划被并发改写」这类最难的冲突。"""
    text = read_ref("%s/%s" % (PLAN_NS, plan_id))
    tasks = []
    for row in text.split("\n"):
        if not row.startswith("task\t"):
            continue
        parts = row.split("\t")[1:]
        if len(parts) < 7:
            continue
        if len(parts) >= 11:
            tasks.append(dict(zip(
                ("id", "title", "requires", "bounds", "min_trust", "reversible",
                 "value", "weight", "artifact", "short_test", "approved_by", "source",
                 "discovery_id"), parts[:13])))
            # 11 字段是已发布计划的旧合同；读它们不能中断，但它们没有可审计来源。
            tasks[-1].setdefault("source", "legacy-plan")
            tasks[-1].setdefault("discovery_id", "-")
        else:   # 兼容早期 7 字段格式
            tasks.append(dict(zip(
                ("id", "title", "requires_executor", "requires_kind",
                 "weight", "artifact", "short_test"), parts[:7])))
    return tasks


PLAN_TASK_FIELDS = ("id", "title", "requires", "bounds", "min_trust", "reversible",
                    "value", "weight", "artifact", "short_test", "approved_by", "source",
                    "discovery_id")


def plan_task_line(candidate):
    """所有自动计划共用的编码，source 固定第 12 字段，末尾附 frozen discovery。"""
    return "task\t" + "\t".join(str(candidate.get(field, "unknown"))
                                  for field in PLAN_TASK_FIELDS)


def stable_discovery_id(source, candidate):
    """同一 source+candidate 永远指向同一发现 cohort，且 ref 名不受输入字符影响。"""
    material = (str(source) + "\0" + str(candidate)).encode("utf-8")
    return "d-" + hashlib.sha256(material).hexdigest()[:24]


def _discovery_matches(kv, discovery_id, candidate):
    return (kv.get("discovery_id") == discovery_id
            and kv.get("source") == str(candidate.get("source", "unknown"))
            and kv.get("candidate") == str(candidate.get("id", "")))


def freeze_discovery(candidate, plan_id):
    """把自主候选冻结一次；已存在只复用，绝不改写原 cohort。"""
    source = str(candidate.get("source", "unknown"))
    task_id = str(candidate.get("id", ""))
    discovery_id = stable_discovery_id(source, task_id)
    ref = "%s/%s" % (DISCOVERY_NS, discovery_id)
    existing = rev_ref(ref)
    if existing:
        if not _discovery_matches(parse_kv(read_ref(ref)), discovery_id, candidate):
            print("discovery %s 已存在但血缘冲突，拒绝覆盖" % discovery_id)
            return None
        candidate["discovery_id"] = discovery_id
        return discovery_id
    payload = "\n".join([
        "discovery_id=%s" % discovery_id,
        "discovered_at=%s" % fmt(now()),
        "source=%s" % source,
        "eligibility=min_trust=%s;requires=%s" % (candidate.get("min_trust", "-"),
                                                    candidate.get("requires", "-")),
        "authorization=approved_by=%s;reversible=%s" % (candidate.get("approved_by", "-"),
                                                           candidate.get("reversible", "-")),
        "owner=%s" % candidate.get("owner", node_id()),
        "plan=%s" % plan_id,
        "candidate=%s" % task_id,
    ])
    ok, _ = write_ref(ref, payload)
    if not ok:
        # 两个节点同时发现同一 cohort 时，输掉 CAS 的一方拉取并复用赢家，不能重复造批次。
        fetch_refs()
        if rev_ref(ref) and _discovery_matches(parse_kv(read_ref(ref)), discovery_id, candidate):
            candidate["discovery_id"] = discovery_id
            return discovery_id
        print("discovery %s 冻结失败，计划不发布" % discovery_id)
        return None
    candidate["discovery_id"] = discovery_id
    return discovery_id


def freeze_discoveries(candidates, plan_id):
    """计划进入总线前先冻结每一个自主候选；任何一个无血缘就整批拒绝。"""
    return all(freeze_discovery(candidate, plan_id) for candidate in candidates)


def receipt_has_frozen_discovery(kv):
    """人工计划可完成但没有 G1 血缘；只有真实冻结的 discovery 才能进入 learning。"""
    discovery_id = kv.get("discovery_id")
    if not re.fullmatch(r"d-[0-9a-f]{24}", discovery_id or ""):
        return False
    ref = "%s/%s" % (DISCOVERY_NS, discovery_id)
    if not rev_ref(ref):
        return False
    found = parse_kv(read_ref(ref))
    return (found.get("discovery_id") == discovery_id
            and found.get("candidate") == kv.get("candidate")
            and found.get("source") == kv.get("candidate_source"))


def publish_learning_candidate(kv, result_ref):
    """从一个已验收的世界结果生成只读学习候选；同 discovery 至多一条且不覆盖。"""
    discovery_id = kv.get("discovery_id")
    ref = "%s/%s" % (LEARNING_NS, discovery_id)
    if rev_ref(ref):
        return True
    discovery_ref = "%s/%s" % (DISCOVERY_NS, discovery_id)
    discovery_oid = rev_ref(discovery_ref)
    result_oid = rev_ref(result_ref)
    if not discovery_oid or not result_oid:
        return False
    payload = "\n".join([
        "discovery=%s" % discovery_id,
        "discovery_ref=%s" % discovery_ref,
        "discovery_oid=%s" % discovery_oid,
        "result=%s" % result_ref,
        "result_oid=%s" % result_oid,
        "artifact=%s" % kv.get("artifact", "-"),
        "origin=%s" % kv.get("origin_commit", "-"),
        "candidate_oid=%s" % kv.get("candidate_oid", kv.get("origin_commit", "-")),
        "landed_oid=%s" % kv.get("landed_oid", kv.get("origin_commit", "-")),
        "verification=%s" % kv.get("verification_command", "-"),
        "world_verified_at=%s" % kv.get("world_verified_at", "-"),
        "trigger_kind=%s" % kv.get("trigger_kind", "manual"),
        "created_by=%s" % node_id(),
        "created_at=%s" % fmt(now()),
    ])
    ok, _ = write_ref(ref, payload)
    if ok:
        return True
    # 同时 gather 的节点可能已经抢先发布；只接受内容存在，不覆盖。
    fetch_refs()
    return bool(rev_ref(ref))


def _commit_on_local_origin_refs(commit):
    """只读本地 refs/remotes/origin/*：已 fetch 过则零网络。"""
    code, refs = git("for-each-ref --format='%(objectname)' refs/remotes/origin", timeout=60)
    if code != 0:
        return False, "origin UNKNOWN：无法读取 origin 分支"
    for remote_sha in refs.split():
        if not re.fullmatch(r"[0-9a-f]{40}", remote_sha):
            continue
        if git("merge-base --is-ancestor %s %s" % (commit, remote_sha), timeout=60)[0] == 0:
            return True, commit
    return False, "产出提交不在当前 origin 可达历史"


def commit_origin_reachable(commit):
    """确认给定提交当前仍在 origin 某个分支历史；网络未知绝不报绿。

    顺序：① 本地 origin 跟踪 ref（零网络，避免 SSL 抖动误杀 settling）
         ② fetch + 3 次重试（代理链偶发 SSL_ERROR_SYSCALL）
         ③ 再查一次本地 ref。
    """
    if not re.fullmatch(r"[0-9a-f]{40}", commit or ""):
        return False, "origin_commit 非法或缺失"
    ok, detail = _commit_on_local_origin_refs(commit)
    if ok:
        return True, detail
    # 仅 fetch ref，不 checkout，脏工作区也不会受影响。
    code, out = _git_net_retry(
        "fetch --quiet origin '+refs/heads/*:refs/remotes/origin/*'",
        timeout=180,
        attempts=3,
        label="fetch_heads",
    )
    if code != 0:
        # 本地已有结果优先；fetch 失败且本地未命中 → UNKNOWN
        return False, "origin UNKNOWN：%s" % (out.strip().split("\n")[-1][:120] or "无输出")
    return _commit_on_local_origin_refs(commit)


def canonical_origin_ref():
    """完成真相源；测试可显式覆盖，生产默认只认 origin/master。"""
    raw = (os.environ.get("CORTEX_CANONICAL_REF") or
           "refs/remotes/origin/master").strip()
    if raw.startswith("origin/"):
        return "refs/remotes/%s" % raw
    return raw


def commit_canonical_landed(commit, canonical_ref=None):
    """验证 candidate 已成为 canonical ref 的祖先，并返回两类 OID。

    `candidate_oid` 是 artifact 当前内容绑定的提交；`landed_oid` 是验证时
    canonical ref 的 tip。candidate 即使已在其它 origin 分支可达，也不能替代
    canonical landing。无 origin 的隔离 fixture 必须显式开启测试开关，生产
    缺远端/缺 canonical ref 一律 fail closed。
    """
    ref = canonical_ref or canonical_origin_ref()
    binding = {
        "candidate_oid": commit or "",
        "landed_oid": "",
        "canonical_ref": ref,
    }
    if not re.fullmatch(r"[0-9a-f]{40}", commit or ""):
        binding["detail"] = "candidate_oid 非法或缺失"
        return False, binding

    remote_code, remote_url = git("remote get-url origin", timeout=60)
    if remote_code != 0:
        if os.environ.get("CORTEX_ALLOW_NO_ORIGIN_FIXTURE") == "1":
            fixture_ref = os.environ.get("CORTEX_CANONICAL_REF") or "HEAD"
            binding["canonical_ref"] = fixture_ref
            code, tip = git("rev-parse --verify %s^{commit}" % shlex.quote(fixture_ref), timeout=60)
            tip = tip.strip().split("\n")[-1] if tip.strip() else ""
            if code == 0 and re.fullmatch(r"[0-9a-f]{40}", tip):
                binding["landed_oid"] = tip
                if git("merge-base --is-ancestor %s %s" % (commit, tip), timeout=60)[0] == 0:
                    binding["detail"] = "isolated fixture canonical landed"
                    return True, binding
            binding["detail"] = "隔离 fixture 的 candidate 未进入 %s" % fixture_ref
            return False, binding
        binding["detail"] = "origin UNKNOWN：仓库没有 origin；生产完成门拒绝降级"
        return False, binding

    # 既有隔离 fixture 以本地 bare repo 的 main 为 canonical；仅对 file/local
    # origin 兼容。真实网络 origin 仍严格默认 master，不做 main 猜测。
    if (not os.environ.get("CORTEX_CANONICAL_REF")
            and (remote_url.strip().startswith("/") or remote_url.strip().startswith("file://"))
            and git("rev-parse --verify %s^{commit}" % shlex.quote(ref), timeout=60)[0] != 0
            and git("rev-parse --verify refs/remotes/origin/main^{commit}", timeout=60)[0] == 0):
        ref = "refs/remotes/origin/main"
        binding["canonical_ref"] = ref

    def inspect():
        code, tip = git("rev-parse --verify %s^{commit}" % shlex.quote(ref), timeout=60)
        tip = tip.strip().split("\n")[-1] if tip.strip() else ""
        if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", tip):
            return False, ""
        binding["landed_oid"] = tip
        return git("merge-base --is-ancestor %s %s" % (commit, tip), timeout=60)[0] == 0, tip

    landed, _tip = inspect()
    if landed:
        binding["detail"] = "candidate 已进入 canonical 历史"
        return True, binding

    # 本地 tracking ref 可能落后；只刷新 canonical 分支，不把其它 candidate
    # 的“可见”误当成“已合入”。自定义本地 ref 则不猜网络映射，直接 fail closed。
    prefix = "refs/remotes/origin/"
    if ref.startswith(prefix):
        branch = ref[len(prefix):]
        code, out = _git_net_retry(
            "fetch --quiet origin '+refs/heads/%s:%s'" % (
                shlex.quote(branch), shlex.quote(ref)),
            timeout=180, attempts=3, label="fetch_canonical",
        )
        if code != 0:
            binding["detail"] = "canonical UNKNOWN：%s" % (
                out.strip().split("\n")[-1][:120] or "fetch 无输出")
            return False, binding
        landed, _tip = inspect()
        if landed:
            binding["detail"] = "candidate 已进入 canonical 历史"
            return True, binding

    if binding["landed_oid"]:
        binding["detail"] = ("integration_pending：candidate %s 已传播，但不是 %s@%s 的祖先"
                             % (commit[:12], ref, binding["landed_oid"][:12]))
    else:
        binding["detail"] = "canonical UNKNOWN：无法解析 %s" % ref
    return False, binding


def artifact_origin_reachable(artifact):
    """产出提交必须已进入 canonical 历史，不能只停在 candidate 分支。

    `git status` 干净只能证明工作区与本机 HEAD 一致；worker 曾经正是在这个
    判据下把「本地已 commit、但没有 push」误记成蜂群可见完成。远端不可达时
    宁可拒绝通过，也不把网络/权限故障压成绿色。
    """
    quoted = shlex.quote(artifact)
    code, commit = git("log -1 --format=%%H -- %s" % quoted, timeout=60)
    commit = commit.strip().split("\n")[-1] if commit.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", commit):
        return False, "产出没有本地提交"

    # 第一层区分“本机岛”与“候选已传播”；第二层才是完成所需的 canonical landing。
    isolated_fixture = (
        os.environ.get("CORTEX_ALLOW_NO_ORIGIN_FIXTURE") == "1"
        and git("remote get-url origin", timeout=60)[0] != 0
    )
    reachable, why = ((True, "isolated fixture") if isolated_fixture
                      else commit_origin_reachable(commit))
    if not reachable:
        artifact_origin_reachable.last_binding = {
            "candidate_oid": commit, "landed_oid": "",
            "canonical_ref": canonical_origin_ref(), "detail": why,
        }
        return False, why
    landed, binding = commit_canonical_landed(commit)
    artifact_origin_reachable.last_binding = binding
    if not landed:
        return False, binding.get("detail", "integration_pending")
    return True, commit


artifact_origin_reachable.last_binding = {}


def receipt_valid(kv, plan_id, task_id):
    """done 只能由 run-v1 receipt 证明；旧 ref 可读，但不能拿来新结算。"""
    if kv.get("status") != "done":
        return False, "status 不是 done"
    required = ("receipt", "plan", "candidate", "candidate_source", "claim_holder",
                "claim_since", "executor", "gate", "verification_command",
                "world_verified_at", "trigger_kind")
    missing = [key for key in required if not kv.get(key) or kv.get(key) == "-"]
    if missing:
        return False, "缺 receipt 字段：%s" % ",".join(missing)
    if kv.get("receipt") != "run-v1":
        return False, "receipt 不是 run-v1"
    if kv.get("plan") != plan_id or kv.get("candidate") != task_id:
        return False, "receipt 血缘与 plan/task 不一致"
    if kv.get("gate") not in ("passed", "scope-gap"):
        return False, "done 没有通过门"
    if parse_ts(kv.get("world_verified_at")) is None:
        return False, "world_verified_at 非法"
    if kv.get("artifact") != "-" and not re.fullmatch(r"[0-9a-f]{40}", kv.get("origin_commit") or ""):
        return False, "文件产出缺合法 origin_commit"
    if kv.get("artifact") != "-" and (kv.get("candidate_oid") or kv.get("landed_oid")):
        if not re.fullmatch(r"[0-9a-f]{40}", kv.get("candidate_oid") or ""):
            return False, "文件产出缺合法 candidate_oid"
        if not re.fullmatch(r"[0-9a-f]{40}", kv.get("landed_oid") or ""):
            return False, "文件产出缺合法 landed_oid"
    return True, ""


def run_receipt_payload(plan_id, task, claim, executor, status, gate, reason="", origin_commit="",
                        world_verified_at="-", trigger_kind="manual", candidate_oid="",
                        landed_oid=""):
    """把一次 run 的必要血缘固定在 result ref；执行者文本永远不是 receipt。"""
    clean = lambda value: str(value or "-").replace("\n", " ").replace("\t", " ")[:240]
    fields = [
        ("receipt", "run-v1"),
        ("plan", plan_id),
        ("candidate", task.get("id")),
        ("candidate_source", task.get("source", "legacy-plan")),
        ("discovery_id", task.get("discovery_id", "-")),
        ("claim_holder", claim.get("holder")),
        ("claim_since", claim.get("since")),
        ("task", task.get("id")),
        ("node", node_id()),
        ("status", status),
        ("artifact", task.get("artifact", "-")),
        ("finished", fmt(now())),
        ("executor", executor),
        ("gate", gate),
        ("verification_command", task.get("short_test", "-")),
        ("world_verified_at", world_verified_at),
        ("trigger_kind", trigger_kind),
    ]
    if origin_commit:
        fields.append(("origin_commit", origin_commit))
        # origin_commit 保留给旧 reader；新 receipt 明确区分产出绑定提交与
        # canonical tip，避免“某个远端 candidate 可达”被读成“已经落主干”。
        fields.append(("candidate_oid", candidate_oid or origin_commit))
        fields.append(("landed_oid", landed_oid or origin_commit))
    if reason:
        fields.append(("reason", reason))
    # 【EX14 · T36】失败时间戳是 cooldown 的判据。done 不需要
    # （done 是终态，没人再 claim 它），但 failed 必须留 failed_at，
    # 否则 cmd_claim 拿到 status=failed 时无法判断现在是否过了冷却。
    if status == "failed":
        fields.append(("failed_at", fmt(now())))
    return "\n".join("%s=%s" % (key, clean(value)) for key, value in fields)


def porcelain_changes(output):
    """从合并 stdout/stderr 的 git status 输出中只取 porcelain 记录。"""
    return [line for line in output.splitlines()
            if re.match(r"^[ MADRCU?!]{2} ", line)]


def run_deterministic_backlink(plan_id, task):
    """执行 map-backlink-gap 的纯机械修复，并由 orchestrator 负责传播。

    这类任务的变化和验收都已被 scanner 完整定义，不需要模型猜。受限 Coding
    Agent 也不该负责 `.git` 生命周期：它可能能改正文却不能创建 index.lock。
    这里只接受单一、干净、界内 artifact；精确 commit 到专用远端分支，绝不碰
    其它 staged/dirty 文件。
    """
    artifact = task.get("artifact") or ""
    if task.get("source") != "map-backlink-gap":
        return "[ADAPTER_FAILED]\nunsupported deterministic source"
    if not artifact or artifact == "-" or artifact != (task.get("bounds") or ""):
        return "[ADAPTER_FAILED]\nbacklink task must have one artifact equal to bounds"
    full = os.path.abspath(os.path.join(ROOT, artifact))
    if not full.startswith(os.path.abspath(ROOT) + os.sep) or not os.path.isfile(full):
        return "[ADAPTER_FAILED]\nartifact is outside repo or unreadable"
    short_test = (task.get("short_test") or "").strip()
    if not short_test.startswith("python3 bin/verify-backlinks.py --check-target "):
        return "[ADAPTER_FAILED]\nshort_test is not the backlink verifier"

    marker = "<!-- cortex:map-backlink %s -->" % (task.get("discovery_id") or task["id"])
    quoted = shlex.quote(artifact)
    status_code, status_out = git("status --porcelain -- %s" % quoted, timeout=60)
    if status_code != 0:
        return "[DETERMINISTIC_RETRY]\nartifact status unreadable"
    test_code, test_out = run("cd %s && %s" % (ROOT, short_test), timeout=180)

    if test_code == 1:
        if porcelain_changes(status_out):
            return "[DETERMINISTIC_RETRY]\nartifact was dirty before deterministic edit"
        with open(full, encoding="utf-8", errors="replace") as fh:
            original = fh.read()
        addition = ("\n\n---\n\n%s\n关联地图："
                    "[[skills/cortex-loop/MAP|Cortex Loop 全景地图]]\n" % marker)
        modified = original.rstrip() + addition
        with open(full, "w", encoding="utf-8") as fh:
            fh.write(modified)
        verify_code, verify_out = run("cd %s && %s" % (ROOT, short_test), timeout=180)
        if verify_code != 0:
            # 只在文件仍逐字等于本函数刚生成的版本时回滚，避免覆盖并发人类编辑。
            with open(full, encoding="utf-8", errors="replace") as fh:
                current = fh.read()
            if current == modified:
                with open(full, "w", encoding="utf-8") as fh:
                    fh.write(original)
            return "[ADAPTER_FAILED]\nbacklink verifier stayed red: %s" % verify_out[-160:]
    elif test_code == 0:
        # 上一拍可能已 commit 但 push 因网络失败；只接管带本 discovery marker
        # 的半成品。没有 marker 的既有修复属于别人的成果，应走 moot，不抢功。
        with open(full, encoding="utf-8", errors="replace") as fh:
            current = fh.read()
        if marker not in current:
            return "[DETERMINISTIC_MOOT]\nbacklink already satisfied by another actor"
        if status_out.strip() and marker not in current:
            return "[DETERMINISTIC_RETRY]\nunrecognized dirty artifact"
    else:
        return "[DETERMINISTIC_RETRY]\nbacklink source UNKNOWN: %s" % test_out[-160:]

    dirty_code, dirty_out = git("status --porcelain -- %s" % quoted, timeout=60)
    if dirty_code != 0:
        return "[DETERMINISTIC_RETRY]\nartifact status unreadable after edit"
    if porcelain_changes(dirty_out):
        message = "docs(cortex-loop): close backlink %s" % task["id"]
        helper = os.path.join(ROOT, "bin", "git-auto-commit.sh")
        commit_code, commit_out = run(
            "cd %s && %s --producer cortex-loop-backlink -m %s -- %s" % (
                shlex.quote(ROOT), shlex.quote(helper), shlex.quote(message), quoted),
            timeout=180,
        )
        if commit_code != 0:
            return "[DETERMINISTIC_RETRY]\npathspec commit failed: %s" % commit_out[-160:]

    branch = "codex/cortex/%s" % re.sub(r"[^A-Za-z0-9._-]", "-", plan_id)
    head_code, candidate = git("rev-parse HEAD", timeout=30)
    candidate = (candidate or "").strip()
    if head_code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", candidate):
        return "[DETERMINISTIC_RETRY]\nfailed to resolve immutable candidate"
    push_code, push_out = 1, ""
    for attempt in range(1, 4):
        push_code, push_out = git(
            "push origin %s:refs/heads/%s" % (candidate, branch), timeout=180)
        if push_code == 0:
            break
        if attempt < 3:
            log("deterministic push retry %s attempt=%d" % (task["id"], attempt))
            time.sleep(attempt * 2)
    if push_code != 0:
        return ("[DETERMINISTIC_RETRY]\nbranch propagation failed after 3 attempts: %s"
                % push_out[-160:])
    return "deterministic backlink applied and origin-visible on %s" % branch


def is_deterministic_backlink_task(task):
    """Direction-ledger form has no legacy `source` column; recognize by its
    mechanically fixed verifier contract, never by a fuzzy title."""
    short_test = (task.get("short_test") or "").strip()
    artifacts = [p for p in (task.get("artifact_paths") or task.get("artifact") or "").split()
                 if p and p != "-"]
    return (len(artifacts) == 1
            and short_test.startswith("python3 bin/verify-backlinks.py --check-target ")
            and artifacts[0] in shlex.split(short_test)[3:4])


def apply_deterministic_backlink_in_workspace(worktree, task):
    """Apply one scanner-defined backlink inside an isolated attempt.

    Commit, publish, testing, and canonical landing remain owned by the common
    workspace runtime. This function only performs the deterministic file edit.
    """
    if not is_deterministic_backlink_task(task):
        return 2, "not a deterministic backlink contract"
    artifact = next(p for p in (
        task.get("artifact_paths") or task.get("artifact") or "").split() if p != "-")
    full = os.path.realpath(os.path.join(worktree, artifact))
    root = os.path.realpath(worktree)
    if not full.startswith(root + os.sep) or not os.path.isfile(full):
        return 2, "artifact outside attempt or unreadable"
    short_test = (task.get("short_test") or "").strip()
    code, out = run("cd %s && %s" % (shlex.quote(worktree), short_test), timeout=180)
    if code == 0:
        return 3, "backlink already satisfied in frozen base"
    if code != 1:
        return 75, "backlink verifier UNKNOWN: %s" % out.strip()[-160:]
    with open(full, encoding="utf-8", errors="replace") as fh:
        original = fh.read()
    marker = "<!-- cortex:map-backlink %s -->" % task["id"]
    modified = original.rstrip() + (
        "\n\n---\n\n%s\n关联地图："
        "[[skills/cortex-loop/MAP|Cortex Loop 全景地图]]\n" % marker)
    with open(full, "w", encoding="utf-8") as fh:
        fh.write(modified)
    verify_code, verify_out = run(
        "cd %s && %s" % (shlex.quote(worktree), short_test), timeout=180)
    if verify_code != 0:
        with open(full, encoding="utf-8", errors="replace") as fh:
            current = fh.read()
        if current == modified:
            with open(full, "w", encoding="utf-8") as fh:
                fh.write(original)
        return 2, "backlink verifier stayed red: %s" % verify_out.strip()[-160:]
    return 0, "deterministic backlink applied in attempt workspace"


# ── 自主发现任务 ───────────────────────────────────────────────────────
# 任务不必人来写：CORTEX 里到处是现成待办，只是没人去扫。
#
# 核心设计：**扫描器既是发现器，又是验收器**。
# 一条候选任务的 short_test 就是发现它的那个扫描命令本身 —— 判据零编造：
# 扫描器现在报 WARN，任务做完它就该变绿，没有任何解释空间。
#
# 信任爬坡（operator：先找小的做，一点点积累信任）：
# 候选按风险自动定级 min_trust，L1 节点只够格拿只读/单文件的小活；
# 做成了 HAAS 涨，才拿得动跨文件的。**不是配置出来的资格，是挣出来的。**

SCANNERS = [
    # (id, 扫描命令, 命中判据正则, 任务标题模板, 风险级, 价值层, bounds)
    ("skill-reg", "bash bin/verify-skill-integration.sh --check registry 2>&1",
     r"未注册：(\S+)", "把 skill %s 注册进 SKILLS-TAXONOMY", "L1", "V2", "skills/"),
    ("recipe-entry", "python3 bin/verify-recipe-entry-contract.py check-all 2>&1",
     r"registry missing recipe: (\S+)", "给 recipe %s 补 Entry 契约登记", "L1", "V2",
     "skills/loop-engineering-hub/"),
    ("asset-reg", "bash -c 'test -s work-studio/devops/infrastructure/data/cortex-asset-registry.json && echo OK || echo MISSING'",
     r"MISSING", "世界状态快照 cortex-asset-registry.json 缺失或空——资产健康择机信号源断了", "L1", "V2",
     "work-studio/devops/infrastructure/"),
]


def scan_self_defects():
    """自省扫描：把**本节点自己的故障**也变成蜂群任务。

    operator 2026-07-29 点名的架构缺口：4 小时无人值守窗口里，两个节点分别因
    「launchd 不继承 HTTP(S)_PROXY，直连 Anthropic 被 geo-block 返回 403」和
    「systemd 不继承 ANTHROPIC_* 环境变量」全线失败 50 个任务，但系统
    **从没把这两件事当成待修任务**——因为扫描器只扫仓库里的合同欠账，
    看不见「我自己病了」。
    （注：我最初把 Mac 侧推断成「锁屏拿不到 keychain」，被独立验证推翻——
    pmset 证实全程未睡眠，且 env -i 隔离实验证明只加代理即通、keychain 从未参与。
    错误假设一度被写进本注释，这里更正，留痕见 ERRORS E012。）

    这类任务与仓库类任务的本质差别：**产出不是某个文件**（改的是节点环境/
    远程服务配置），所以 artifact 只能是 "-"，完成判据只能是「症状消失」。
    这也正是 artifact="-" 占位符必须被 C1/机械门正确处理的原因（已修）。
    """
    out = []
    prof = node_profile()
    me = prof["node"]

    # ① 执行器被抑制 = 本节点有真实故障，且抑制是自动打的，不是人配的
    for ex in ("claude", "codex", "openclaw", "ollama"):
        hushed, kind, left = exec_suppressed(ex)
        if not hushed:
            continue
        # auth 类需要人给凭据，机器修不了；quota 类等窗口自愈，不用派任务
        if kind != "auth":
            continue
        out.append({
            "id": "selfheal-%s-auth" % ex, "source": "self-defect",
            "title": "修复本节点 %s 执行器认证失效（当前抑制中，剩 %d 分钟）" % (ex, left),
            "requires": "-",          # 谁能干谁干；本节点自己也可以（用别的执行器）
            "bounds": "-",            # 改的是环境/配置，不是仓库文件
            "min_trust": "L1", "reversible": "yes", "value": "V3", "weight": "2",
            "artifact": "-",
            # 完成判据 = 症状真的消失：能实际跑通一次调用
            "short_test": "bash bin/cortex-loop-tests/exec-alive.sh %s" % ex,
            "approved_by": "-"})

    # ② 驱动红灯 = 时钟/调度层有故障，直接影响自主运行能力
    code, _ = run("cd %s && bin/cortex-loop health >/dev/null 2>&1" % ROOT, timeout=200)
    if code != 0:
        out.append({
            "id": "selfheal-health-red", "source": "self-defect",
            "title": "本节点 health 红灯：驱动层有真实执行失败，蜂群已拒绝自动推进",
            "requires": "-", "bounds": "-",
            "min_trust": "L3",        # 动调度层风险高于改文档
            "reversible": "yes", "value": "V3", "weight": "3",
            "artifact": "-",
            "short_test": "bin/cortex-loop health",
            "approved_by": "-"})

    # ③ 跨环境一致性退化 = ERRORS E012 的硬化门（同一根因今晚咬了三次）
    code, _ = run("cd %s && bash bin/cortex-loop-tests/env-parity.sh >/dev/null 2>&1" % ROOT,
                  timeout=60)
    if code != 0:
        out.append({
            "id": "selfheal-env-parity", "source": "self-defect",
            "title": "调度器环境变量声明缺失：无人值守调用必然失败（ERRORS E012 同款）",
            "requires": "-", "bounds": "work-studio/devops/dotfiles/",
            "min_trust": "L3", "reversible": "yes", "value": "V3", "weight": "2",
            "artifact": "-",
            "short_test": "bash bin/cortex-loop-tests/env-parity.sh",
            "approved_by": "-"})

    # ④ 声明与实际脱钩 = 名实分裂，本身就是要修的缺陷
    code, _ = run("cd %s && bin/cortex-loop reconcile >/dev/null 2>&1" % ROOT, timeout=120)
    if code != 0:
        out.append({
            "id": "selfheal-drift", "source": "self-defect",
            "title": "CLOCK 声明的驱动与实际不符（DRIFT），心跳可能根本没在跑",
            "requires": "-", "bounds": "-",
            "min_trust": "L3", "reversible": "yes", "value": "V3", "weight": "2",
            "artifact": "-",
            "short_test": "bin/cortex-loop reconcile",
            "approved_by": "-"})

    # ⑤ CI 红灯 —— 「碰到的所有问题都该是它的原生任务」（operator 2026-07-29）
    #
    # 为什么必须自动接进来而不是等人看日志：CI 每天跑一次，如果只是写进日志，
    # 那它就退化成一个更贵的告警器 —— 正是本蜂群总纲点名要避免的形态
    # （「发现得出来但修不完 = 不是蜂群」）。有发现就必须变成可派发的活。
    #
    # 三态分开派，因为**它们的严重度和修法完全不同**（高维展开律）：
    #   退出码 2 = 跑偏（目标被调低/门被拆/哨兵被修绿）→ 最严重，L4 + 不可逆
    #   退出码 1 = 测试失败（功能回归）              → 严重，L3
    #   退出码 0 = 全绿                              → 无任务
    # 把 2 和 1 压成一个「CI 失败」会让「有人拆了防线」和「某个用例挂了」
    # 用同一个优先级排队 —— 前者是制度性风险，后者是工程缺陷。
    ci_state = os.path.expanduser("~/.openclaw/state/cortex-ci.jsonl")
    if os.path.isfile(ci_state):
        try:
            with open(ci_state, encoding="utf-8") as fh:
                last = [l for l in fh.read().split("\n") if l.strip()][-1]
            rec = json.loads(last)
        except Exception:
            rec = None
        if rec:
            if int(rec.get("drifted") or 0) == 1:
                out.append({
                    "id": "ci-drift", "source": "self-defect",
                    "title": "CI 报「跑偏」：目标阈值被调低 / 机器门减少 / 反测哨兵被修绿",
                    # 只有**装了 CI 时钟的节点**能复现并验证这条 —— 声明能力而不是
                    # 写死节点名（operator 2026-07-29：不同节点各有各的能力，
                    # 微信导入只有 Mac 有；按能力编排，不按名字）。
                    # runtime.launchd 是 CI 时钟的载体；将来 CI 迁到生产端，
                    # 换成 runtime.systemd 即可，引擎与任务定义都不用改。
                    "requires": "runtime.launchd", "bounds": "-",
                    # L4 + reversible=no：改回目标/门是制度性动作，必须人签名（C3 会拦）
                    "min_trust": "L4", "reversible": "no", "value": "V3", "weight": "3",
                    "artifact": "-",
                    "short_test": "bash bin/cortex-ci.sh --quiet",
                    "approved_by": "-"})
            elif int(rec.get("fail") or 0) > 0:
                out.append({
                    "id": "ci-regression", "source": "self-defect",
                    "title": "CI 测试回归：%s 个用例红灯（上次全绿 %s 个）"
                             % (rec.get("fail"), rec.get("pass")),
                    # 测试套件本身跨平台（纯 python3 + git），任何节点都能跑，
                    # 所以不限 runtime —— 与上面那条的差别正是「能力分派」的意义：
                    # 同为 CI 类问题，一条只有特定节点能修，一条谁都能修。
                    "requires": "-", "bounds": "-",
                    "min_trust": "L3", "reversible": "yes", "value": "V3", "weight": "2",
                    "artifact": "-",
                    "short_test": "bash bin/cortex-loop-tests/suite.sh",
                    "approved_by": "-"})
    return out


def own_skill(path):
    """这个 skill 是**我们自己的**、能改的吗？外部 vendor 软链一律不是。

    2026-07-29 真机实证（本引擎连续两拍派了同一个不可能完成的任务）：
      skills/YC-autoplan -> ${CORTEX_VENDOR_SKILLS}/gstack/autoplan
      find skills -maxdepth 1 -type l | wc -l  →  48
    48 个 skill 是指向 vault 外部的第三方软链（gstack 等）：内容不在本仓库、不受
    git 管、执行器沙箱也够不着。孤岛/合同/低洼三个扫描器都只看 `skills/*/SKILL.md`
    的 glob 结果，**不看它是不是软链**，于是把 vendor skill 当自家欠债派了出去。

    后果不是"失败一次"，是**无限重复失败**：island-YC-autoplan 在 07:49 和 08:28 各被
    派了一次，每次都烧一整轮额度，产出恒为零，而队列里还排着 YC-benchmark 等 47 个
    同类。找活层派出不可能完成的活 = 把过门率的分母无偿做大。

    判据用 realpath 而不是只判 islink —— 软链套软链、或目录内某层是软链都能兜住。
    """
    real = os.path.realpath(path)
    return real == os.path.abspath(path) or real.startswith(ROOT + os.sep)


def scan_contract_debt():
    """免疫系统的抗原识别：按 Evolve 合同标准逐个体检资产，找出**原始**不达标的。

    关键：**必须读原始判定，不能读 audit 的结论。**
    audit 对存量资产有宽免（「存量只准持平/减债」）—— 那是 commit gate 该有的
    仁慈，但对免疫系统是致命的：宽免会让抗原全部隐形，体检报告 100% PASS，
    而实际 549 个 skill 里绝大多数缺字段。仁慈的门 ≠ 诚实的体检。

    杠杆权重：枢纽（带 spoke 多的）缺得越多越优先 —— 同一个缺口被越多下游继承。
    """
    import glob
    try:
        import importlib.machinery, importlib.util
        loader = importlib.machinery.SourceFileLoader(
            "kcg", os.path.join(ROOT, "bin/knowledge-contract-gate.py"))
        gate = importlib.util.module_from_spec(
            importlib.util.spec_from_loader("kcg", loader))
        loader.exec_module(gate)
    except Exception as exc:                       # noqa: BLE001
        print("合同体检不可用（%s）—— 免疫系统这一路失明，如实报告不静默跳过"
              % type(exc).__name__, file=sys.stderr)
        return []

    hubs = {}
    for path in glob.glob(os.path.join(ROOT, "skills/*/SKILL.md")):
        head = read_frontmatter(path)
        m = re.search(r"(?m)^host:\s*(\S+)", head)
        if m:
            hubs[m.group(1).strip()] = hubs.get(m.group(1).strip(), 0) + 1

    sick = []
    for path in sorted(glob.glob(os.path.join(ROOT, "skills/*/SKILL.md"))):
        if not own_skill(path):
            continue                               # 外部 vendor 软链，不是我们的债
        name = os.path.basename(os.path.dirname(path))
        try:
            res = gate.analyze_skill(open(path, encoding="utf-8", errors="replace").read())
        except Exception:                          # noqa: BLE001
            continue
        miss = res.get("missing") or []
        if not miss:
            continue
        # 严重度 = 缺口数 × (1 + 下游 spoke 数)：枢纽的缺口会被下游继承
        sick.append((len(miss) * (1 + hubs.get(name, 0)), name, miss))
    sick.sort(reverse=True)

    out = []
    for sev, name, miss in sick[:4]:
        out.append({
            "id": "debt-%s" % name[:18], "source": "contract-debt",
            "title": "%s 补合同缺口 %s（严重度 %d）" % (name, ",".join(miss[:3]), sev),
            "requires": "exec.claude", "bounds": "skills/%s/" % name,
            "min_trust": "L3" if hubs.get(name, 0) else "L1",
            "reversible": "yes", "value": "V3" if hubs.get(name, 0) else "V2",
            "weight": "2" if hubs.get(name, 0) else "1",
            "artifact": "skills/%s/SKILL.md" % name,
            "short_test": "python3 bin/knowledge-contract-gate.py check-path "
                          "skills/%s/SKILL.md --strict" % name,
            "approved_by": "-"})
    return out


def read_frontmatter(path, cap=20000):
    """读**完整** frontmatter，不按字节数截断。

    2026-07-29 sub-agent 实证：三处扫描器都用 `read(1500)` 这个魔数判 host/type，
    而 skills/session-crash-recovery/SKILL.md 的 frontmatter 长 1686 字符
    （description 是超长多行块），`host: skill-ecosystem` 落在截断线之后 →
    **明明有 host 却被反复派成孤岛任务**，烧额度产出恒为零。

    与 vendor 软链事故同一类根因：**扫描器看到的世界比真实世界小**。
    上次修的是判据的横向范围（哪些文件算我们的），这次是纵向深度（读多少才算读完）。
    cap 只作防呆上限（frontmatter 不该有 20KB），正常路径永远读到闭合 `---` 为止。
    """
    try:
        body = open(path, encoding="utf-8", errors="replace").read(cap)
    except OSError:
        return ""
    if not body.startswith("---"):
        return body[:1500]          # 无 frontmatter：退回旧行为，只看开头
    end = body.find("\n---", 3)
    return body[:end] if end > 0 else body


def scan_network_evenness():
    """按「补低洼」找活 —— 目标函数是**降方差**，不是求最大值。

    operator 2026-07-29 定的两条战略：
      ① Context 密度要高**且分布均匀** —— 低的地方优先提上来
      ② Skill 要形成**均匀网络** —— 薄的地方优先挂上去

    所以这里不挑「最好的再加强」，挑**最低洼且在枢纽上的**：
    实测 554 个 skill 只有 71 个有 ERRORS（87% 缺负空间）、58 个无 host。
    全列出来会淹没队列，所以加一层杠杆权重：**枢纽处的低洼优先** ——
    高复用 skill 缺坑记录 = 同一个坑被反复踩；冷门 skill 缺不缺无所谓。
    """
    import glob
    out = []
    # 网络连通性：无 host 的孤岛挂不进 hub 树，跨 skill 检索会漏掉它
    islands = []
    vendor_islands = 0
    for path in sorted(glob.glob(os.path.join(ROOT, "skills/*/SKILL.md"))):
        if not own_skill(path):
            vendor_islands += 1
            continue          # 外部 vendor 软链：给第三方代码加 host 既改不动也不该改
        head = read_frontmatter(path)
        if re.search(r"(?m)^host:\s*\S", head):
            continue
        if re.search(r"(?m)^type:\s*(master|host)", head):
            continue      # master 本身就是树根，不需要 host
        islands.append(os.path.basename(os.path.dirname(path)))
    if vendor_islands:
        # 排除掉不等于装作没看见——如实报数，免得下次又有人以为扫描器漏了
        print("找活：跳过 %d 个外部 vendor 软链 skill（不在本仓库，改不动也不该改）"
              % vendor_islands, file=sys.stderr)
    for name in islands[:3]:
        out.append({
            "id": "island-%s" % name[:20], "source": "skill-island",
            "title": "把孤岛 skill %s 挂进 host 树（网络连通）" % name,
            "requires": "exec.claude", "bounds": "skills/%s/" % name,
            "min_trust": "L1", "reversible": "yes", "value": "V2", "weight": "1",
            "artifact": "skills/%s/SKILL.md" % name,
            "short_test": "bash bin/cortex-loop-tests/short-test-skill-host-frontmatter.sh skills/%s/SKILL.md" % name,
            "approved_by": "-"})

    # 密度低洼：枢纽 skill（被别人 host 的树根）却没有负空间记录
    hubs = {}
    for path in glob.glob(os.path.join(ROOT, "skills/*/SKILL.md")):
        head = read_frontmatter(path)
        m = re.search(r"(?m)^host:\s*(\S+)", head)
        if m:
            hubs[m.group(1).strip()] = hubs.get(m.group(1).strip(), 0) + 1
    for name, spokes in sorted(hubs.items(), key=lambda kv: -kv[1])[:6]:
        skill_dir = os.path.join(ROOT, "skills", name)
        if not os.path.isdir(skill_dir):
            continue
        if not own_skill(os.path.join(skill_dir, "SKILL.md")):
            continue                               # 同上：不给 vendor 软链补 ERRORS
        if os.path.isfile(os.path.join(skill_dir, "ERRORS.md")):
            continue
        out.append({
            "id": "lowland-%s" % name[:20], "source": "context-lowland",
            "title": "给枢纽 skill %s 补 ERRORS 负空间（带 %d 个 spoke）" % (name, spokes),
            "requires": "exec.claude", "bounds": "skills/%s/" % name,
            "min_trust": "L3", "reversible": "yes", "value": "V3", "weight": "2",
            "artifact": "skills/%s/ERRORS.md" % name,
            "short_test": "python3 bin/knowledge-contract-gate.py check-path "
                          "skills/%s/ERRORS.md" % name,
            "approved_by": "-"})
    return out


def scan_frontmatter_readable():
    """扫「人读得懂但机器读不懂」的文件 —— Context 密度的隐形归零点。

    2026-07-29 三横一纵纵跳发现：全库 5115 个带 frontmatter 的 md，
    **737 个（14.4%）YAML 解析失败**。典型 `name: OpenSpec: Archive`
    —— 未加引号的冒号。这些文件正文再好，在元数据层是**隐形的**：
    Obsidian 索引不到、tag/dataview 查不到、任何按 frontmatter 检索的工具都漏。

    为什么以前发现不了：现有扫描器全都在查「文件在不在 / 字段齐不齐」，
    **没有一个在查「机器读不读得懂」**。所以坏了几个月零告警。

    直接服务战略目标①「Context 密度均衡」：解析失败的节点密度实际是 0，
    是全库最低洼处 —— 降方差应该先填这里，而不是给已经好的再加强。
    """
    out = []
    try:
        import yaml
    except ImportError:
        return out                       # 没 pyyaml 就不假装扫过
    broken = []
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames
                       if d not in (".git", "node_modules", ".venv", "_process")]
        for fn in filenames:
            if not fn.endswith(".md"):
                continue
            path = os.path.join(dirpath, fn)
            try:
                head = open(path, encoding="utf-8", errors="replace").read(20000)
            except OSError:
                continue
            if not head.startswith("---"):
                continue                 # 无 frontmatter 是合法的，不算坏
            parts = head.split("\n---", 1)
            if len(parts) < 2:
                continue
            try:
                yaml.safe_load(parts[0][3:])
            except Exception:
                broken.append(os.path.relpath(path, ROOT))
    if not broken:
        return out
    # 枢纽优先：skills/ 和 ace-knowledge/ 的坏 frontmatter 影响面最大
    # （被 host 树和 insight 网络引用），普通素材坏了只影响它自己。
    hub = [p for p in broken if p.startswith(("skills/", "ace-knowledge/"))]
    for rel in hub[:4]:
        out.append({
            "id": "fm-%s" % os.path.basename(rel)[:18], "source": "fm-readable",
            "title": "修 frontmatter 让机器读得懂 %s（枢纽资产）"
                     % os.path.basename(rel),
            "requires": "exec.claude", "bounds": rel,
            "min_trust": "L1", "reversible": "yes", "value": "V2", "weight": "1",
            "artifact": rel,
            "short_test": "python3 bin/verify-frontmatter.py %s" % rel,
            "approved_by": "-"})
    # 总量单列一条：**禁止静默截断** —— 只报 4 条会让人以为只剩 4 个
    if len(broken) > len(hub[:4]):
        out.append({
            "id": "fm-bulk", "source": "fm-readable",
            "title": "全库 frontmatter 不可解析共 %d 个（枢纽 %d）待批量治理"
                     % (len(broken), len(hub)),
            "requires": "exec.claude", "bounds": ".",
            "min_trust": "L3", "reversible": "yes", "value": "V3", "weight": "3",
            "artifact": "-",
            "short_test": "python3 bin/verify-frontmatter.py --all",
            "approved_by": "-"})
    return out


def scan_map_backlink_gaps():
    """把 MAP 的可机械修反向边缺口导入 S1，而不是留在交接文档里等人想起。

    只接 operator 明确授权且满足“单文件、可逆、机械可验”的三组：Cortex 核心、
    六律 guide、当日 Cortex 报告。它们由 deterministic.backlink 执行，不需要
    用模型改一行确定性 wikilink。
    """
    verifier = os.path.join(ROOT, "bin", "verify-backlinks.py")
    source = "skills/cortex-loop/MAP.md"
    code, raw = run(
        "python3 %s --json %s" % (shlex.quote(verifier), shlex.quote(source)),
        timeout=180,
    )
    if code not in (0, 1):
        print("MAP 反向边扫描器不可用（退出码 %d）—— 如实标失明" % code, file=sys.stderr)
        return []
    try:
        payload = json.loads(raw)
        rows = payload["files"][source]
    except (KeyError, TypeError, json.JSONDecodeError):
        print("MAP 反向边扫描器输出不可解析—— 如实标失明", file=sys.stderr)
        return []
    prefixes = (
        "skills/cortex-loop/",
        "rules/on-demand/",
        "reports/2026-07-29/_standalone/",
    )
    out = []
    for row in rows:
        rel = row.get("path") or ""
        if row.get("state") != "MISSING" or not rel.startswith(prefixes):
            continue
        slug = hashlib.sha256(rel.encode("utf-8")).hexdigest()[:16]
        out.append({
            "id": "map-backlink-%s" % slug,
            "source": "map-backlink-gap",
            "title": "给 %s 补回 cortex-loop/MAP 的反向边" % os.path.basename(rel),
            "requires": "-",
            "bounds": rel,
            "min_trust": "L1",
            "reversible": "yes",
            "value": "V2",
            "weight": "1",
            "artifact": rel,
            "short_test": "python3 bin/verify-backlinks.py --check-target %s %s"
                          % (shlex.quote(rel), shlex.quote(source)),
            "approved_by": "operator-2026-07-30",
        })
    return out


def _mech_fix_survives(rel, body):
    """先在内存里**试着修一遍**，修完还得能解析，才准判「机械可修」。

    2026-07-29 子 Agent 实测打脸：`2026-04-16-data.json` 是 opens=20/closes=9，
    按计数属孤儿 → 我原本判 L1 机械安全。**但删完标记 JSON 仍然崩**
    （Expecting ',' delimiter: line 497）—— 标记删干净了，结构还是烂的。
    CSV 同理：两侧逐字节相同时只删标记会得到「表头出现两次」的坏 CSV。

    结论：**计数是必要不充分条件**。结构化文件必须多过一道解析门，
    过不了的一律降级到 L4 交人 —— 让机器去改它只会产出一个语法正确性未知的文件。
    """
    ext = os.path.splitext(rel)[1].lower()
    if ext not in (".json", ".csv", ".yaml", ".yml"):
        return True                       # 纯文本：删标记不会破坏语法
    stripped = "\n".join(l for l in body.split("\n")
                         if not re.match(r"^(<<<<<<< |=======$|>>>>>>> )", l))
    try:
        if ext == ".json":
            import json as _json
            _json.loads(stripped)
        elif ext == ".csv":
            import csv as _csv
            import io as _io
            rows = list(_csv.reader(_io.StringIO(stripped)))
            if not rows:
                return False
            if len({len(r) for r in rows if r}) != 1:
                return False              # 列数不齐 = 删完还是坏的
            if rows.count(rows[0]) > 1:
                return False              # 表头重复 = 两侧全等，删标记不够
        else:
            return False                  # YAML 无 stdlib 解析器，不赌，交人
    except Exception:
        return False
    return True


def scan_data_integrity():
    """扫「库里躺着的坏数据」—— 冲突标记 / 三方分歧残留。

    为什么必须有这一类：2026-07-29 真机发现 .git-sync.sh 曾把带 `<<<<<<<`
    的文件直接 commit（Bug5，已修），全库因此留下一批**内容被写坏但状态是干净**
    的文件 —— git status 绿、扫描器全绿、没有任何机制会发现它们。
    这类缺陷比"缺字段"严重得多：缺字段是少了东西，写坏是**读到的是错的**。

    分诊只做机械能做的那一半（前人验证过的三类病）：
      `<<<<<<<` 与 `>>>>>>>` 计数**不等** → 孤儿标记，删标记行即可 → L1
      计数相等                          → 可能是真三方分歧，删完变废纸 → L4 需人裁决
    机械分不清的一律判 L4 —— 宁可挂着等人，不可赌一把把内容删了。
    """
    out = []
    # 必须行首锚定：`.git-sync.sh` 这类**处理冲突的脚本**正文里就带这个字符串，
    # 不锚定会把工具本身误报成坏数据（真机实测的假阳性）。
    code, listing = run("cd %s && git grep -lIE --cached '^<<<<<<< ' 2>/dev/null" % ROOT,
                        timeout=180)
    # git grep 的退出码语义：0=有匹配，1=**无匹配（正常）**，≥2 或 124=命令真挂了。
    # 原来 `if code != 0 and not listing.strip(): return out` 把「无匹配」和「扫挂了」
    # 合并成同一个静默 return —— 全库冲突标记扫描是 fail-open 的：git 出问题、
    # 仓库被锁、扫描超时，都会表现成「干净，没坏数据」。这类静默正是坏数据能
    # 一路混过治理层的原因。三态区分，挂了就喊。
    if code == 124 or code >= 2:
        print("⚠️ 坏数据扫描没跑成（git grep 退出码 %d）——这一路失明，不是没坏数据"
              % code, file=sys.stderr)
        return out
    if not listing.strip():
        return out                       # code 0/1 且无输出 = 真的没匹配
    paths = [p for p in listing.strip().split("\n") if p.strip()]
    orphan, disputed = [], []
    for rel in paths:
        full = os.path.join(ROOT, rel)
        try:
            body = open(full, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        opens = len(re.findall(r"(?m)^<<<<<<< ", body))
        closes = len(re.findall(r"(?m)^>>>>>>> ", body))
        if opens == 0:
            continue                     # 只是提到标记，不是被写坏
        if opens != closes and _mech_fix_survives(rel, body):
            orphan.append(rel)
        else:
            disputed.append(rel)
    for idx, rel in enumerate(orphan[:5]):
        out.append({
            "id": "marker-%d" % (idx + 1), "source": "data-integrity",
            "title": "摘除孤儿冲突标记 %s（计数不等，删标记即可）" % os.path.basename(rel),
            "requires": "exec.claude", "bounds": rel,
            "min_trust": "L1", "reversible": "yes", "value": "V1", "weight": "1",
            "artifact": rel,
            "short_test": "bash -c '! grep -q \"^<<<<<<< \" %s'" % rel,
            "approved_by": "-"})
    # 分歧类**不拆成 N 条**：拆了会被 [:5] 静默截断，剩下的从清单里消失
    # ——「看起来清完了」比「知道还剩多少」危险得多。而且人裁决本来就是一次性
    # 坐下来看完，拆成 N 条只是制造 N 次上下文切换。
    if disputed:
        out.append({
            "id": "dispute-all", "source": "data-dispute",
            "title": "裁决 %d 个真分歧文件（两侧都是实质版本，删错即丢内容）"
                     % len(disputed),
            "requires": "exec.claude", "bounds": " ".join(disputed[:3]) + " …",
            # L4：机械分不清哪一侧对 —— 这道门就是用来挡住"赌一把"的
            "min_trust": "L4", "reversible": "no", "value": "V1", "weight": "2",
            "artifact": "-",
            "short_test": "bash -c '[ -z \"$(git grep -lIE --cached \\\"^<<<<<<< \\\")\" ]'",
            "approved_by": "-"})
    return out


# 资产健康：只读对账。全局 ROOT 仍是 str；这里在函数内转 Path。
# 计数：绝对差 > 3，或相对登记值 > 2%，满足任一即候选。恰好等于不报。
# 目录 source（以 / 结尾、无通配符）数直接子项；带通配符的目录数匹配到的目录；
# 无斜杠的文件名通配（dt-*.md）按任意深度计数。都不读正文。
# 过期：段引用文件的 mtime，或注册表 _meta.updated_at，早于阈值才候选。
# 默认 30 天。CORTEX_ASSET_HEALTH_STALE_DAYS 或 scan_asset_health(stale_days=) 可改。
ASSET_HEALTH_STALE_DAYS = 30
ASSET_HEALTH_COUNT_REL = 0.02
ASSET_HEALTH_COUNT_ABS = 3
ASSET_HEALTH_SKIP_DIRS = frozenset({
    ".git", "node_modules", ".venv", "venv", "__pycache__",
    ".obsidian", ".cache", "site-packages",
})
_ASSET_GLOB_CACHE = {}
_ASSET_CANDIDATE_KEYS = (
    "id", "source", "title", "requires", "bounds", "min_trust",
    "reversible", "value", "weight", "artifact", "short_test", "approved_by",
)


def _asset_health_stale_days(explicit):
    """显式参数优先，其次环境变量，最后默认 30。非法值回落默认，不让发现阶段崩。"""
    def parse(value, fallback):
        if isinstance(value, bool) or value is None:
            return fallback
        if isinstance(value, int):
            parsed = value
        elif isinstance(value, float):
            parsed = int(value)
        elif isinstance(value, str) and re.fullmatch(r"[0-9]+", value.strip() or ""):
            parsed = int(value.strip())
        else:
            return fallback
        if parsed < 0:
            return fallback
        return parsed

    if explicit is not None:
        return parse(explicit, ASSET_HEALTH_STALE_DAYS)
    raw = os.environ.get("CORTEX_ASSET_HEALTH_STALE_DAYS")
    if raw is None or not str(raw).strip():
        return ASSET_HEALTH_STALE_DAYS
    return parse(raw, ASSET_HEALTH_STALE_DAYS)


def _asset_health_now(now):
    if now is None:
        return datetime.now().astimezone()
    if isinstance(now, datetime):
        if now.tzinfo is None:
            return now.replace(tzinfo=datetime.now().astimezone().tzinfo)
        return now
    if isinstance(now, (int, float)) and not isinstance(now, bool):
        return datetime.fromtimestamp(now).astimezone()
    return datetime.now().astimezone()


def _asset_health_candidate(cid, title, bounds, short_test, value):
    cand = {
        "id": cid,
        "source": "asset-health",
        "title": title,
        "requires": "exec.claude",
        "bounds": bounds,
        "min_trust": "L1",
        "reversible": "yes",
        "value": value,
        "weight": "1",
        "artifact": "-",
        "short_test": short_test,
        "approved_by": "-",
    }
    assert tuple(cand) == _ASSET_CANDIDATE_KEYS
    return cand


def _asset_one_line(text, limit):
    cleaned = re.sub(r"\s+", " ", str(text or "")).strip()
    if len(cleaned) > limit:
        return cleaned[:limit]
    return cleaned


def _asset_seg_token(name):
    token = re.sub(r"[^A-Za-z0-9._-]+", "-", str(name)).strip("-")
    return token or "segment"


def _asset_count_value(value):
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, int):
        return value if value >= 0 else None
    if isinstance(value, float) and value.is_integer():
        return int(value) if value >= 0 else None
    if isinstance(value, str) and re.fullmatch(r"[0-9]+", value.strip() or ""):
        return int(value.strip())
    return None


def _asset_count_drifted(declared, actual):
    """绝对差大于 3，或相对登记值大于 2%。恰好等于阈值不报。"""
    delta = abs(int(actual) - int(declared))
    if declared:
        rel = delta / float(declared)
    else:
        rel = 0.0 if delta == 0 else 1.0
    return delta > ASSET_HEALTH_COUNT_ABS or rel > ASSET_HEALTH_COUNT_REL


def _asset_clean_note(text):
    cleaned = re.sub(r"（[^）]*）", " ", text or "")
    cleaned = re.sub(r"\([^)]*\)", " ", cleaned)
    return cleaned.strip()


def _asset_path_token(token):
    if not token or re.search(r"\s|[\u4e00-\u9fff]", token):
        return False
    if token.endswith("/") or "/" in token or any(ch in token for ch in "*?["):
        return True
    return bool(re.fullmatch(r"[A-Za-z0-9_@.+-]+\.[A-Za-z0-9]+", token))


def _asset_safe_pattern(pattern):
    if not isinstance(pattern, str):
        return False
    raw = pattern[:-1] if pattern.endswith("/") else pattern
    if not raw or len(raw) > 240:
        return False
    if raw.startswith("/") or raw.startswith("~"):
        return False
    parts = raw.replace("\\", "/").split("/")
    if any(part == ".." for part in parts):
        return False
    if re.search(r"\s|[\u4e00-\u9fff]", raw):
        return False
    return True


def _expand_asset_alt(part):
    """bin/*.sh|py → bin/*.sh 与 bin/*.py。读不懂的竖线不当成 glob。"""
    if "|" not in part:
        return [part]
    bits = [bit.strip() for bit in part.split("|") if bit.strip()]
    if len(bits) < 2:
        return [part]
    head = bits[0]
    if not _asset_path_token(head):
        return []
    out = [head]
    for bit in bits[1:]:
        if _asset_path_token(bit):
            out.append(bit)
            continue
        if re.fullmatch(r"[A-Za-z0-9]+", bit) and "." in head:
            stem, _, _ext = head.rpartition(".")
            out.append(stem + "." + bit)
            continue
        return []
    return out


def _asset_source_globs(source):
    """从登记的 source 里抽出可实扫的 glob。纯说明文字返回空，不拿去比计数。"""
    if not isinstance(source, str):
        return []
    text = _asset_clean_note(source)
    if not text:
        return []
    globs = []
    seen = set()
    for part in re.split(r"\s*\+\s*", text):
        part = part.strip().strip("`\"'")
        if not part:
            continue
        tokens = part.split() if (re.search(r"[\u4e00-\u9fff]", part) or " " in part) else [part]
        for token in tokens:
            token = token.strip().strip("`\"'")
            for glob in _expand_asset_alt(token):
                if glob in seen or not _asset_safe_pattern(glob) or not _asset_path_token(glob):
                    continue
                glob = _asset_normalize_glob(glob)
                if glob in seen:
                    continue
                seen.add(glob)
                globs.append(glob)
    return globs


def _asset_normalize_glob(pattern):
    """dt-*.md 这种不带目录的文件名通配，登记的是「叫这个名字的文件」，不是只看仓库根。"""
    body = pattern[:-1] if pattern.endswith("/") else pattern
    if "/" not in body and any(ch in body for ch in "*?["):
        return "**/" + pattern
    return pattern


def _asset_pattern_kind(pattern):
    """files=匹配文件；dirs=匹配目录本身；children=具体目录的直接子项。"""
    if pattern.endswith("/"):
        body = pattern[:-1]
        if not body:
            return None
        if any(ch in body for ch in "*?["):
            return ("dirs", body)
        return ("children", body)
    return ("files", pattern)


def _asset_hidden_rel(rel):
    return any(part.startswith(".") for part in rel.split("/"))


def _asset_glob_translate(pattern):
    i = 0
    n = len(pattern)
    buf = []
    while i < n:
        ch = pattern[i]
        if ch == "*":
            if i + 1 < n and pattern[i + 1] == "*":
                if i + 2 < n and pattern[i + 2] == "/":
                    buf.append("(?:.*/)?")
                    i += 3
                    continue
                buf.append(".*")
                i += 2
                continue
            buf.append("[^/]*")
            i += 1
            continue
        if ch == "?":
            buf.append("[^/]")
            i += 1
            continue
        buf.append(re.escape(ch))
        i += 1
    return "".join(buf)


def _asset_glob_regex(pattern):
    compiled = _ASSET_GLOB_CACHE.get(pattern)
    if compiled is None:
        compiled = re.compile(_asset_glob_translate(pattern))
        _ASSET_GLOB_CACHE[pattern] = compiled
    return compiled


def _asset_health_count_many(root, groups):
    """一次目录遍历数完所有段。不打开文件正文，不跟随符号链接，跳过依赖/缓存目录。

    以 / 结尾且带通配符：数匹配到的目录（skills/*/references/ = 这些 references 目录）。
    以 / 结尾且无通配符：数该目录的直接子项，隐藏项不算，不递归进子目录。
    其余 pattern 数匹配到的文件。
    """
    root = Path(root)
    compiled = {}
    for name, patterns in groups.items():
        kinds = []
        for pattern in patterns or []:
            if not isinstance(pattern, str) or not _asset_safe_pattern(pattern):
                continue
            kind = _asset_pattern_kind(pattern)
            if kind:
                kinds.append(kind)
        compiled[name] = kinds
    found = {name: set() for name in compiled}
    if not root.is_dir() or not any(compiled.values()):
        return {name: 0 for name in compiled}
    stack = [str(root)]
    root_str = str(root)

    def consider(rel, is_dir, entry_name):
        if not rel or rel == "." or rel == ".." or rel.startswith("../"):
            return
        parent = rel.rsplit("/", 1)[0] if "/" in rel else ""
        hidden = entry_name.startswith(".") or _asset_hidden_rel(rel)
        for seg, kinds in compiled.items():
            bucket = found[seg]
            if rel in bucket:
                continue
            for kind, body in kinds:
                matched = False
                if kind == "files" and not is_dir:
                    matched = _asset_glob_regex(body).fullmatch(rel) is not None
                elif kind == "dirs" and is_dir and not hidden:
                    matched = _asset_glob_regex(body).fullmatch(rel) is not None
                elif kind == "children" and not entry_name.startswith("."):
                    matched = _asset_glob_regex(body).fullmatch(parent) is not None
                if matched:
                    bucket.add(rel)
                    break

    while stack:
        current = stack.pop()
        try:
            iterator = os.scandir(current)
        except OSError:
            continue
        with iterator:
            for entry in iterator:
                try:
                    is_dir = entry.is_dir(follow_symlinks=False)
                    is_file = entry.is_file(follow_symlinks=False)
                except OSError:
                    continue
                if is_dir and entry.name in ASSET_HEALTH_SKIP_DIRS:
                    continue
                rel = os.path.relpath(entry.path, root_str)
                if os.sep != "/":
                    rel = rel.replace(os.sep, "/")
                if is_dir:
                    consider(rel, True, entry.name)
                    stack.append(entry.path)
                elif is_file:
                    consider(rel, False, entry.name)
    return {name: len(paths) for name, paths in found.items()}


def _asset_health_count_files(root, patterns):
    return _asset_health_count_many(root, {"_": list(patterns or [])}).get("_", 0)


def _asset_health_load(path):
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError, TypeError, ValueError):
        return None
    return data if isinstance(data, dict) else None


def _asset_lexical_inside(root, full):
    try:
        Path(full).resolve().relative_to(Path(root).resolve())
    except (OSError, ValueError):
        return False
    return True


def _asset_ref_mtime(root, rel):
    """只取 mtime。符号链接若指向根目录外，直接跳过，不读目标内容。"""
    if not isinstance(rel, str) or not _asset_safe_pattern(rel):
        return None
    root = Path(root)
    full = root / rel
    try:
        if not _asset_lexical_inside(root, full):
            return None
        if full.is_symlink():
            target = full.resolve()
            if not _asset_lexical_inside(root, target):
                return None
            if not target.is_file() and not target.is_dir():
                return None
            return target.stat().st_mtime
        if not full.exists():
            return None
        if not full.is_file() and not full.is_dir():
            return None
        return full.stat().st_mtime
    except OSError:
        return None


def _parse_asset_ts(value, default_tz):
    if not isinstance(value, str):
        return None
    text = value.strip()
    if not text or text == "-":
        return None
    if text.endswith("Z"):
        text = text[:-1] + "+0000"
    for pattern in (
        "%Y-%m-%dT%H:%M:%S%z",
        "%Y-%m-%dT%H:%M:%S",
        "%Y-%m-%dT%H:%M%z",
        "%Y-%m-%dT%H:%M",
        "%Y-%m-%d",
    ):
        try:
            parsed = datetime.strptime(text, pattern)
        except ValueError:
            continue
        if parsed.tzinfo is None:
            return parsed.replace(tzinfo=default_tz)
        return parsed
    return None


def _asset_path_is_stale(root, rel, days, now_dt):
    mtime = _asset_ref_mtime(root, rel)
    if mtime is None:
        return False
    return (now_dt.timestamp() - mtime) > days * 86400


def _looks_like_asset_ref(text):
    if not text or any(ch in text for ch in "*?[]|+"):
        return False
    return "/" in text


def _segment_ref_paths(seg):
    """段上的引用文件。source 只有在它就是单个具体文件时才算，glob 不算。"""
    if not isinstance(seg, dict):
        return []
    refs = []
    seen = set()

    def add(raw, force):
        if not isinstance(raw, str):
            return
        cleaned = _asset_clean_note(raw).strip()
        if not cleaned or cleaned in seen or not _asset_safe_pattern(cleaned):
            return
        if any(ch in cleaned for ch in "*?[]|+"):
            return
        if not force and not _looks_like_asset_ref(cleaned):
            return
        seen.add(cleaned)
        refs.append(cleaned)

    add(seg.get("file"), True)
    source_globs = _asset_source_globs(seg.get("source"))
    if (len(source_globs) == 1 and not source_globs[0].endswith("/")
            and not any(ch in source_globs[0] for ch in "*?[")):
        add(source_globs[0], True)
    for key, val in seg.items():
        if key in ("file", "count", "note", "source", "meta_quality"):
            continue
        if isinstance(val, str):
            add(val, False)
    return refs


def _asset_segment_count_drifted(root, registry_path, seg_name):
    reg = _asset_health_load(registry_path)
    if not reg:
        return False
    segments = reg.get("segments")
    if not isinstance(segments, dict):
        return False
    seg = segments.get(seg_name)
    if not isinstance(seg, dict):
        return False
    declared = _asset_count_value(seg.get("count"))
    patterns = _asset_source_globs(seg.get("source"))
    if declared is None or not patterns:
        return False
    actual = _asset_health_count_files(root, patterns)
    return _asset_count_drifted(declared, actual)


def _asset_segment_refs_stale(root, registry_path, seg_name, stale_days=None, now=None):
    reg = _asset_health_load(registry_path)
    if not reg:
        return False
    segments = reg.get("segments")
    if not isinstance(segments, dict):
        return False
    seg = segments.get(seg_name)
    if not isinstance(seg, dict):
        return False
    now_dt = _asset_health_now(now)
    days = _asset_health_stale_days(stale_days)
    for rel in _segment_ref_paths(seg):
        if _asset_path_is_stale(root, rel, days, now_dt):
            return True
    return False


def _meta_updated_at_is_stale(reg, days, now_dt):
    meta = reg.get("_meta") if isinstance(reg, dict) else None
    if not isinstance(meta, dict):
        return False
    parsed = _parse_asset_ts(meta.get("updated_at"), now_dt.tzinfo)
    if parsed is None:
        return False
    return (now_dt - parsed).total_seconds() > days * 86400


def _asset_registry_updated_at_is_stale(registry_path, stale_days=None, now=None):
    reg = _asset_health_load(registry_path)
    if not reg:
        return False
    now_dt = _asset_health_now(now)
    return _meta_updated_at_is_stale(reg, _asset_health_stale_days(stale_days), now_dt)


def _asset_health_check_test(expression):
    """短测复用同一套只读函数。expression 为真表示问题还在。不写字节码。"""
    engine = os.path.abspath(__file__)
    script = "\n".join([
        "import sys",
        "sys.dont_write_bytecode = True",
        "import importlib.machinery as _m",
        "import importlib.util as _u",
        "loader = _m.SourceFileLoader('cortex_loop_asset_health', %r)" % engine,
        "spec = _u.spec_from_loader(loader.name, loader)",
        "mod = _u.module_from_spec(spec)",
        "loader.exec_module(mod)",
        "sys.exit(1 if eval(%r) else 0)" % expression,
    ])
    return "PYTHONDONTWRITEBYTECODE=1 python3 -c " + shlex.quote(script)


def scan_asset_health(root=None, registry_path=None, stale_days=None, now=None):
    """世界状态快照（cortex-asset-registry.json）引用、计数与新鲜度。

    RSI 闭环 L4→② 回路：registry 的引用文件不存在 = 择机信号断了；
    verb-task-index 超 7 天 = 索引过期。修复都是「重新跑推送脚本」或「修引用」，
    零预算零 LLM。

    另两类只读信号，候选可逆、信任 L1：
      asset-health-count-<segment>
        段同时有 count 和 source glob 时实扫。绝对差大于 3，或相对登记值大于 2%，
        满足任一就报。恰好等于不报。目录 source 数直接子项或匹配目录，不把整棵子树
        里的文件都算进去。
      asset-health-stale-<segment>
        段引用文件的 mtime 早于阈值。注册表 _meta.updated_at 过期则段名为 registry。
        默认 30 天，可用环境变量 CORTEX_ASSET_HEALTH_STALE_DAYS 或 stale_days 调整。

    全局 ROOT 保持 str。本函数只在本地包一层 Path(ROOT)。不读文件正文，不联网。
    """
    root_path = Path(ROOT) if root is None else Path(root)
    if registry_path:
        reg_path = Path(registry_path)
        if not reg_path.is_absolute():
            reg_path = root_path / reg_path
    else:
        reg_path = root_path / "work-studio/devops/infrastructure/data/cortex-asset-registry.json"
    out = []
    if not reg_path.is_file():
        return out
    if not _asset_lexical_inside(root_path, reg_path):
        return out
    try:
        reg = json.loads(reg_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError, TypeError, ValueError):
        return out
    if not isinstance(reg, dict):
        return out
    now_dt = _asset_health_now(now)
    days = _asset_health_stale_days(stale_days)
    segments = reg.get("segments")
    if not isinstance(segments, dict):
        segments = {}
    count_groups = {}
    count_meta = {}
    for seg_name, seg in segments.items():
        if not isinstance(seg, dict):
            continue
        declared = _asset_count_value(seg.get("count"))
        patterns = _asset_source_globs(seg.get("source"))
        if declared is not None and patterns:
            count_groups[seg_name] = patterns
            count_meta[seg_name] = (declared, seg.get("source"))
    counted = _asset_health_count_many(root_path, count_groups) if count_groups else {}
    for seg_name, seg in segments.items():
        if not isinstance(seg, dict):
            continue
        token = _asset_seg_token(seg_name)
        file_field = seg.get("file")
        if isinstance(file_field, str) and file_field.strip():
            rel = _asset_clean_note(file_field).strip()
            if (_asset_safe_pattern(rel) and not any(ch in rel for ch in "*?[]|+")
                    and _asset_lexical_inside(root_path, root_path / rel)
                    and not (root_path / rel).exists()):
                full = root_path / rel
                out.append(_asset_health_candidate(
                    "asset-health-%s" % token,
                    "资产段 %s 引用的注册表文件不存在：%s" % (seg_name, rel),
                    rel,
                    "test -s %s" % shlex.quote(str(full)),
                    "V2",
                ))
        if seg_name in count_meta:
            declared, source = count_meta[seg_name]
            actual = counted.get(seg_name, 0)
            if _asset_count_drifted(declared, actual):
                delta = abs(actual - declared)
                rel = (delta / float(declared)) if declared else (0.0 if delta == 0 else 1.0)
                out.append(_asset_health_candidate(
                    "asset-health-count-%s" % token,
                    "资产段 %s 计数漂移：登记 %d，实扫 %d（差 %d，%.2f%%）"
                    % (seg_name, declared, actual, delta, rel * 100),
                    _asset_one_line(source, 180),
                    _asset_health_check_test(
                        "mod._asset_segment_count_drifted(%r, %r, %r)"
                        % (str(root_path), str(reg_path), seg_name)),
                    "V2",
                ))
        stale_refs = []
        oldest = 0.0
        for rel in _segment_ref_paths(seg):
            mtime = _asset_ref_mtime(root_path, rel)
            if mtime is None:
                continue
            age_days = (now_dt.timestamp() - mtime) / 86400.0
            if age_days > days:
                stale_refs.append(rel)
                if age_days > oldest:
                    oldest = age_days
        if stale_refs:
            shown = ", ".join(stale_refs[:3])
            out.append(_asset_health_candidate(
                "asset-health-stale-%s" % token,
                "资产段 %s 引用已 %.1f 天未更新（阈值 %d 天）：%s"
                % (seg_name, oldest, days, shown),
                _asset_one_line(shown, 180),
                _asset_health_check_test(
                    "mod._asset_segment_refs_stale(%r, %r, %r)"
                    % (str(root_path), str(reg_path), seg_name)),
                "V1",
            ))
    if _meta_updated_at_is_stale(reg, days, now_dt):
        parsed = _parse_asset_ts((reg.get("_meta") or {}).get("updated_at"), now_dt.tzinfo)
        age_days = (now_dt - parsed).total_seconds() / 86400.0
        meta_id = "asset-health-stale-registry"
        if any(item["id"] == meta_id for item in out):
            meta_id = "asset-health-stale-registry-updated-at"
        try:
            bounds = str(reg_path.resolve().relative_to(root_path.resolve()))
        except (OSError, ValueError):
            bounds = "work-studio/devops/infrastructure/data/cortex-asset-registry.json"
        out.append(_asset_health_candidate(
            meta_id,
            "资产注册表 updated_at 已 %.1f 天未更新（阈值 %d 天）" % (age_days, days),
            bounds,
            _asset_health_check_test(
                "mod._asset_registry_updated_at_is_stale(%r)" % (str(reg_path),)),
            "V1",
        ))
    # 索引新鲜度。时钟与本函数的 now 对齐，生产路径仍是当前时间。
    vi = root_path / "work-studio/devops/infrastructure/data/verb-task-index.md"
    if vi.is_file():
        try:
            age_h = (now_dt.timestamp() - vi.stat().st_mtime) / 3600.0
        except OSError:
            age_h = None
        if age_h is not None and age_h > 168:  # 7 天
            out.append(_asset_health_candidate(
                "asset-health-index-stale",
                "verb-task-index.md 已 %.0f 天未刷新（阈值 7 天）" % (age_h / 24),
                str(vi),
                "find %s -name verb-task-index.md -mtime -7 | grep -q ."
                % shlex.quote(str(vi.parent)),
                "V1",
            ))
    return out


def discover_candidates():
    """跑只读扫描器，把 WARN/FAIL 转成候选任务。全部实扫，不虚构待办。

    2026-07-29 扫出的静默失明（比 health 抖动影响更大）：这里原来 `code, out = run(...)`
    取了退出码却**从头到尾没用过**。扫描器超时/崩溃 → out 为空 → 0 个 hits →
    该扫描器静默贡献 0 条候选，而 cmd_discover 会照常打印
    「扫了一圈没有待办 —— 当前所有机械可查的缺口都是绿的」。
    「没扫到问题」和「没扫成」被合并成同一个输出，方向是 fail-open：
    **整条自主找活链都建在「扫描器一定跑成功」这个从未被检验的假设上。**
    SCANNERS 里有全库级重扫（verify-skill-integration 等），timeout=180 未必够，
    这不是理论风险。修法：区分三态并如实报出是哪个扫描器挂了，绝不静默算 0 条。
    """
    found = []
    broken = []
    for sid, cmd, pattern, title_tpl, risk, value, bounds in SCANNERS:
        code, out = run("cd %s && timeout 180 %s" % (ROOT, cmd), timeout=200)
        # 判 DOWN 只看退出码，**不看有没有输出** —— 这是本修复自己的负向测试抓到的坑：
        # run() 把 stdout+stderr 合并返回，扫描器崩掉时 stderr 里必然有
        # "command not found" 之类的话，于是「有输出」恒成立，
        # 加了 `and not out.strip()` 条件等于把刚建好的门自己焊死。
        # 退出码语义：0=正常有/无命中，1=grep/verify 类「有 WARN 但正常结束」的常态，
        # 124=超时，127=命令不存在，其余 ≥2=扫描器自身异常。只有 0/1 算跑成了。
        if code not in (0, 1):
            broken.append((sid, code))
            continue
        hits = []
        for m in re.finditer(pattern, out):
            item = m.group(1).strip()
            if item and item not in hits:
                hits.append(item)
        for idx, item in enumerate(hits[:5]):        # 每个扫描器最多取 5 条，防淹没
            # 真机实测抓到的假完成：这类扫描器的退出码只在 FAIL 时非零，WARN
            # 不影响退出码——直接把扫描器命令当 short_test，任务永远"通过"，
            # 不管有没有真的修。必须收窄成「这一条具体问题是否还在」的否定判据。
            import shlex
            base_cmd = cmd.split(" 2>&1")[0]
            item_check = ("bash -c '! (%s 2>&1 | grep -qF %s)'"
                          % (base_cmd, shlex.quote(item)))
            found.append({
                "id": "%s-%d" % (sid, idx + 1),
                "title": title_tpl % item,
                "requires": "exec.claude",
                "bounds": bounds or "skills/",
                "min_trust": risk,
                "reversible": "yes",
                "value": value,
                "weight": "1",
                "artifact": "-",              # 由 verifier 判定，不强制单一产出文件
                "short_test": item_check,     # 精确判据：这一条具体问题不再出现
                "approved_by": "-",
                "source": sid,
            })
    discover_candidates.last_broken = broken     # 供 cmd_discover 判「绿」还是「瞎」
    if broken:
        # 失明必须可见：说清哪个扫描器没跑成，而不是把它的沉默当成绿灯
        print("⚠️ %d 个扫描器没跑成（退出码见下）——它们那一路是**失明**不是**没问题**："
              % len(broken), file=sys.stderr)
        for sid, code in broken:
            print("      SCANNER-DOWN %s（退出码 %d%s）"
                  % (sid, code, "，124=超时" if code == 124 else ""), file=sys.stderr)
    found.extend(scan_self_defects())        # 自省：本节点自己的故障也是待修任务
    found.extend(scan_contract_debt())       # 免疫：按合同标准找抗原（读原始判定）
    found.extend(scan_network_evenness())    # 补低洼：降方差目标
    found.extend(scan_data_integrity())      # 坏数据：状态是绿的但内容是错的
    found.extend(scan_frontmatter_readable())  # 隐形节点：人读得懂但机器读不懂
    found.extend(scan_map_backlink_gaps())     # 已授权 B/C：反向边缺口进入 S1 自动闭环
    found.extend(scan_asset_health())          # 引用完整性 + 计数漂移 + 过期 + 索引
    return found


def cmd_discover(args):
    """自主找活。默认只列候选；--publish 才真发计划。"""
    cands = discover_candidates()
    selected_source = getattr(args, "source", None)
    if selected_source:
        cands = [candidate for candidate in cands
                 if candidate.get("source") == selected_source]
    if not cands:
        # 「没扫到」≠「没问题」：有扫描器挂了就不准报绿，否则失明会伪装成健康
        down = getattr(discover_candidates, "last_broken", [])
        if down:
            print("扫不出待办，但有 %d 个扫描器没跑成（%s）—— 这是**失明**，不是绿灯"
                  % (len(down), " ".join(s for s, _ in down)))
            return 1
        print("扫了一圈没有待办 —— 当前所有机械可查的缺口都是绿的")
        return 0
    # DECIDE 排序：**杠杆/复利优先，同档先啃小的**。
    # 不是纯按易度排 —— 那会让蜂群一直在捡最容易但没价值的活；
    # 也不是纯按价值排 —— 那会让 L1 节点一上来就撞它够不着的门槛。
    # 复利系数：修完能让扫描器**永久**变绿的（结构性修复）> 一次性清理。
    cost = {"L1": 1, "L3": 2, "L4": 4}
    leverage = {"V1": 1, "V2": 3, "V3": 6}
    # 复利系数：修完能让扫描器**永久**变绿的结构性修复 > 一次性清理。
    # 补低洼的两类给最高权重 —— 提升最低点的边际收益大于锦上添花（降方差目标）。
    # data-integrity 给 4：坏数据不是"少了东西"，是**读到的是错的** ——
    # 它会污染所有下游判断，放着不修的复利是负的。
    # self-defect 给 12 = 压倒一切（operator 2026-07-29 拍板的优先级原则）：
    # **引擎自己不可靠时，做 742 个内容修复是在给坏机器抛光。**
    # 之前 self-defect 不在这张表里 → 默认系数 1 → 「我自己坏了」排得比
    # 「给内容锦上添花」还低，正好是反的。系统健康是所有产出的前提，
    # 不是与产出并列的一项。
    compound = {"self-defect": 12,
                "skill-reg": 2, "recipe-entry": 2, "contract-debt": 3,
                "data-integrity": 4, "data-dispute": 1,
                "skill-island": 4, "context-lowland": 5}
    for c in cands:
        c["score"] = round(
            leverage.get(c["value"], 1) * compound.get(c.get("source"), 1)
            / cost.get(c["min_trust"], 4), 2)
    # ── 额度感知（operator 2026-07-29）：排序不能只看价值，还得看**现在拿得动什么**。
    # 档位高且没被抑制 → 有强推理算力，该把它花在高杠杆的活上；
    # 已降到 fast/local → 弱模型硬啃高杠杆任务只会失败，失败还倒扣 HAAS，
    # 这时候反过来先清便宜的活，把额度窗口熬过去。
    _tier, _model, _ = pick_model()
    rich = _tier in ("frontier", "balanced")
    if not rich:
        # 弱档位：成本权重加倍 —— 贵活自动沉底，不是禁止而是排后面
        for c in cands:
            c["score"] = round(c["score"] / cost.get(c["min_trust"], 4), 2)
    # **排序策略随信任翻转** —— 这是爬坡机制的核心：
    #   低信任(L1/L2)：先啃小的。目的不是省事，是**用连续做成来攒分**，
    #                  像升级打怪 —— 没到等级硬打大怪只会失败，失败还倒扣 HAAS。
    #   高信任(L3+)  ：反过来，杠杆/复利优先，先啃难的重要的。
    #                  这时候已经证明过自己，把算力花在小活上才是浪费。
    _h0, _ = haas_score(node_id())
    _t0 = trust_level(_h0)
    # 额度弱时强制走爬坡排法（先啃小的）—— 弱模型 + 硬任务 = 必败组合
    climbing = _t0 in ("L1", "L2") or not rich
    if climbing:
        cands.sort(key=lambda c: (cost.get(c["min_trust"], 9), -c["score"]))
    else:
        cands.sort(key=lambda c: (-c["score"], cost.get(c["min_trust"], 9)))
    print("发现 %d 条候选（按风险从小到大，先啃小的积累信任）\n" % len(cands))
    print("| 分 | id | 任务 | 门槛 | 价值 | 验收（= 发现它的扫描器） |")
    print("|----|----|------|------|------|--------------------------|")
    for c in cands:
        print("| %.2f | %s | %s | %s | %s | `%s` |"
              % (c["score"], c["id"], c["title"][:34], c["min_trust"],
                 c["value"], c["short_test"][:34]))
    print("\n分 = 杠杆(V1/2/3) × 复利系数 ÷ 成本(门槛)")
    print("当前档位：**%s**（%s）→ %s"
          % (_tier or "无", _model or "-",
             "额度充足，高杠杆优先" if rich else "额度受限，成本权重加倍、贵活沉底"))
    print("排序策略：%s" % ("**爬坡期**（信任 %s）→ 先啃小的攒分，做成一件涨一点，"
                            "等级够了自动切换" % _t0 if climbing else
                            "**已过爬坡**（信任 %s）→ 杠杆/复利优先，先啃硬骨头" % _t0))
    # 够不够格拿：信任是挣出来的，不是配出来的
    _h, _ = haas_score(node_id())
    _t = trust_level(_h)
    ok_now = [c for c in cands
              if ["L1", "L2", "L3", "L4", "L5"].index(c["min_trust"])
              <= ["L1", "L2", "L3", "L4", "L5"].index(_t)]
    print("本节点信任 %s（HAAS %.3f）→ 现在够格拿 %d/%d 条"
          % (_t, _h, len(ok_now), len(cands)))
    if len(ok_now) < len(cands):
        print("其余要等信任涨上去 —— 把够格的做绿，HAAS 自然上升，门槛自动解锁")

    if not args.publish:
        print("\n只列不发。要真发成计划：cortex-loop discover --publish")
        return 0

    plan_id = args.plan_id or "auto-%s" % now().strftime("%m%d%H%M")
    fetch_refs()
    ref = "%s/%s" % (PLAN_NS, plan_id)
    if rev_ref(ref):
        print("计划 %s 已存在（不可变），换个 --plan-id" % plan_id)
        return 1
    if not freeze_discoveries(cands, plan_id):
        return 1
    lines = [plan_task_line(c) for c in cands]
    payload = "\n".join([
        "plan=%s" % plan_id, "intent=自主发现的机械可验缺口（扫描器即验收器）",
        "by=%s" % node_id(), "created=%s" % fmt(now()),
        "tasks=%d" % len(lines), ""] + lines)
    ok, _ = write_ref(ref, payload)
    print("\n发布计划 %s（%d 条）：%s" % (plan_id, len(lines), "ok" if ok else "FAIL"))
    log("discover published=%s n=%d" % (plan_id, len(lines)))
    return 0 if ok else 1


def cmd_plan(args):
    """任何节点都能发布计划 —— 这就是「去中心化编排」的入口，没有 leader。"""
    lines = []
    with open(args.tasks, encoding="utf-8") as fh:
        for row in fh:
            row = row.strip()
            if not row or row.startswith("#"):
                continue
            parts = [p.strip() for p in row.split("|")]
            if len(parts) not in (7, 11):
                print("丢弃（字段数 %d，应为 11 六定律全字段或 7 兼容格式）：%s"
                      % (len(parts), row[:60]))
                continue
            # 新格式给人工发布的计划也留下来源；7 字段兼容计划仍按旧合同读取。
            if len(parts) == 11:
                parts.append("manual")
                parts.append("-")       # 人工计划没有 frozen discovery，不计 G1。
            lines.append("task\t" + "\t".join(parts))
    if not lines:
        print("没有合格子任务，拒绝发布空计划")
        return 1
    payload = "\n".join([
        "plan=%s" % args.id, "intent=%s" % args.intent,
        "by=%s" % node_id(), "created=%s" % fmt(now()),
        "tasks=%d" % len(lines), ""] + lines)
    fetch_refs()
    ref = "%s/%s" % (PLAN_NS, args.id)
    if rev_ref(ref):
        print("计划 %s 已存在且不可变；要改请发新 id 并在 intent 里写 supersedes" % args.id)
        return 1
    ok, _ = write_ref(ref, payload)
    print("发布计划 %s（%d 个子任务，发布节点 %s）：%s"
          % (args.id, len(lines), node_id(), "ok" if ok else "FAIL"))
    log("plan %s tasks=%d ok=%s" % (args.id, len(lines), ok))
    return 0 if ok else 1


def node_load(me):
    """我手上**真正还在跑**几个（从 claim ref 反查，不靠本地状态 —— 会随重启丢失）。

    2026-07-29 真机抓到的锁死：claim 只按 TTL（默认 60min）过期，**写完 result
    也不释放**。于是节点干完 3 个任务后，会被自己刚干完的活当成"手上还有 3 个"
    顶到 max_load=3 上限，接下来整整一小时一条都不接。
    worker 修好 health 复活后第一拍的真实日志：
      pass | island-image-to-code — 超载（当前 3 + 本任务 1 > 上限 3）
      本节点 worker 执行 0 个：-
    而那 3 个 claim 里有 2 个**已经写了 result**（1 done + 1 failed）。
    健康是修好了，节点却仍然一个活都干不了 —— 卡在这道假负载上。

    修法走读侧而不是删 ref：有 result 的 claim 一律不计入在跑负载。
    读侧修比"完成时删 claim ref"安全 —— 不引入新的删 ref 路径、无 CAS 竞态，
    且对历史上已经堆积的僵尸 claim 立即生效，不用等谁去清理。
    """
    # result 集合**一次性取**（一个 for-each-ref 子进程），不要每个 claim 各查一次。
    # 首版按 claim 逐个 read_ref(result) 写，真机立刻付出代价：worker 那一拍
    # 从 2min50s 涨到撞穿 TimeoutStartSec=300 被 systemd 杀掉
    # （`start operation timed out. Terminating.`）。read_ref 是本地 git cat-file，
    # 但每次要 fork 一个子进程，claim 一多就是几十次 fork —— 单看每次都便宜，
    # 放进心跳的热路径就变成了压垮 5 分钟预算的最后一根稻草。
    done_tasks = set(list_refs(RESULT_NS))
    load = 0
    for ref in list_refs(CLAIM_NS):
        kv = parse_kv(read_ref(ref))
        expires = parse_ts(kv.get("expires"))
        if kv.get("holder") != me or not expires or expires <= now():
            continue
        # 已经有 result = 这个任务已经结束（不管 done 还是 failed），不占在跑名额
        if ref.replace(CLAIM_NS, RESULT_NS, 1) in done_tasks:
            continue
        load += 1
    return load


def _cap_satisfied(need_pattern, have_caps):
    """单条需求是否被满足 —— glob 匹配而非字面 == 。

    现有任务全写精确串（如 "exec.claude"），fnmatch 对无通配符的精确串
    行为与 == 完全一致 → 零回归。新任务想写 "model.anthropic.*" 这类模式
    才会用到通配，旧任务判定结果逐条不变。
    """
    return any(fnmatch.fnmatch(cap, need_pattern) for cap in have_caps)


def fit_score(task, prof, load, max_load):
    """能力集合匹配 + 负载。任务声明需要哪些能力，节点看自己有没有 —— glob 匹配。

    旧的 requires_executor / requires_kind 两个硬编码维度被吸收成能力 ID
    （exec.* / host.*），保持向后兼容，但新任务应直接写 requires。
    """
    have = set((prof.get("caps") or " ".join(node_capabilities())).split())
    need = {r for r in (task.get("requires") or "").split() if r != "-"}
    # "-" 是「无要求」占位符（bounds/approved_by 等字段同一约定），不是字面能力名。
    # 遗漏这行会把 "-" 当成要具备一个叫 "-" 的能力，任何节点都通不过 fit_score。
    # 向后兼容：旧字段翻译成能力 ID
    if task.get("requires_executor", "-") not in ("-", ""):
        need.add("exec.%s" % task["requires_executor"])
    if task.get("requires_kind", "-") not in ("-", ""):
        need.add("host.%s" % task["requires_kind"])
    missing = {n for n in need if not _cap_satisfied(n, have)}
    if missing:
        return None, "缺能力 %s" % " ".join(sorted(missing))
    try:
        weight = int(task.get("weight") or 1)
    except ValueError:
        weight = 1
    if load + weight > max_load:
        return None, "超载（当前 %d + 本任务 %d > 上限 %d）" % (load, weight, max_load)
    return 1.0 - (load / float(max_load)), "可认领"


def cmd_claim(args):
    """自评 → CAS 抢。抢不到不是错误，是别人更快 —— 换下一个。"""
    fetch_refs()
    prof = node_profile()
    me = prof["node"]
    load = node_load(me)
    claimed = []
    for task in plan_tasks(args.plan):
        ref = "%s/%s/%s" % (CLAIM_NS, args.plan, task["id"])
        old = rev_ref(ref)
        if old:
            kv = parse_kv(read_ref(ref))
            expires = parse_ts(kv.get("expires"))
            if expires and expires > now():
                continue                      # 有效认领在别人手上（或我自己）
        _r = parse_kv(read_ref("%s/%s/%s" % (RESULT_NS, args.plan, task["id"])))
        if _r.get("status") == "done":
            continue                       # 真做完了才跳过
        if _r.get("status") == "failed":
            # failed ≠ 终态。原来「有 result 就跳过」不分 done/failed 且静默无输出，
            # 结果 R1 在 laptop 网关坏掉后被永久锁死，worker 明明能干也接不了 ——
            # 一次失败就把任务判死刑，蜂群的容错全废了。
            #
            # 【EX14 · T36】进一步收紧：哪怕上次失败就是本节点，也不能一棒打死。
            # 改用 cooldown 窗口（FAIL_COOLDOWN_MIN 默认 5 分钟）：
            # · 窗口内：本节点/别人都跳过，避免同一个坏网关立刻再撞
            # · 窗口后：本节点也允许再 claim —— 网关/模型可能已恢复
            # 真正的兜底是 fail_count：连续 N 次失败再升级 ESCALATE，但
            # 单次失败不封死本节点重试权。这是 2026-07-29 R1 复现条件的根治。
            failed_at = parse_ts(_r.get("failed_at"))
            in_cooldown = (failed_at is not None
                           and (now() - failed_at).total_seconds() < FAIL_COOLDOWN_MIN * 60)
            if in_cooldown:
                who = "本节点" if _r.get("node") == me else "上次 %s" % _r.get("node")
                print("cooldown | %s %s 失败未过冷却窗（%dmin）→ 暂跳过"
                      % (task["id"], who, FAIL_COOLDOWN_MIN))
                continue
            who = "本节点" if _r.get("node") == me else "上次 %s" % _r.get("node")
            print("retry | %s %s 失败已过冷却窗，本节点重试（cooldown/retry）"
                  % (task["id"], who))
        score, why = fit_score(task, prof, load, args.max_load)
        if score is None:
            print("pass | %s — %s" % (task["id"], why))
            continue
        # 六定律三关：意图为界 / 信任为尺 / 安全为底。任一不过不执行，并说清哪条拦的。
        haas, _facts = haas_score(me)
        trust = trust_level(haas)
        allowed, law, reason = covenant_check(task, prof, trust, haas)
        if not allowed:
            print("stop  | %s — 【%s】%s" % (task["id"], law, reason))
            continue
        payload = "holder=%s\nexpires=%s\nsince=%s\ntask=%s" % (
            me, fmt(now() + timedelta(minutes=args.ttl_min)), fmt(now()), task["id"])
        ok, _ = write_ref(ref, payload, parent=old)
        if ok:
            load += int(task.get("weight") or 1)
            claimed.append(task["id"])
            print("claim | %s ← %s" % (task["id"], me))
        else:
            print("lost  | %s 被别的节点抢先（CAS 生效）" % task["id"])
        if args.limit and len(claimed) >= args.limit:
            break
    print("本节点 %s 认领 %d 个：%s" % (me, len(claimed), " ".join(claimed) or "-"))
    return 0


# ── Mobfish 协作三定律的原子化植入 ─────────────────────────────────────
# 真相源：aboutme/methods/mobfish-six-laws.md
#   C1 意图为界：人类意图是 AI 行动的唯一边界，未授权即越界
#   C2 信任为尺：自主度由**可验证的**信任决定，不是二元开关
#   C3 安全为底：可逆放手，不可逆慎行，违约必应（STOP→REPORT→WAIT→RECORD）
# 落点原则：每条定律 = 一个字段 + 一道机械关，不加新基础设施。

INCIDENT_NS = "refs/swarm/%s/incident" % SWARM_NAME
TRUST_LEVELS = [("L1", 0.0), ("L2", 0.5), ("L3", 0.7), ("L4", 0.85), ("L5", 0.95)]


# ── 透明度封顶：不可验证的信息 = 信任上不去 ─────────────────────────────
# operator 2026-07-29 拍板的机制：节点结构化信息越透明、越真实、越可验证，信任度才越高；
# 信息缺失或无法验证 → 信任被封顶。这样伪装没有收益 —— 装得再漂亮也换不来自主权。
#
# 实现上**不篡改六定律 C2 的四项权重**（那是真相源），而是作为**上限**叠加：
#   attest 通过 + 字段齐全  → 不封顶（可到 L5）
#   字段缺失 或 未做 attest → 封顶 0.70（最高 L3，只能干可逆的事）
#   attest 失败（自报≠实测）→ 记违约 + 封顶 0.49（打回 L1，只能读）

REQUIRED_TRANSPARENCY = ("node", "swarm", "kind", "can_sleep", "caps", "last_seen")


def transparency_cap(prof):
    """返回 (上限分, 原因)。"""
    missing = [f for f in REQUIRED_TRANSPARENCY if not (prof.get(f) or "").strip()]
    caps = (prof.get("caps") or "").split()
    has_model = any(c.startswith("model.") for c in caps)
    has_billing = any(c.startswith("billing.") for c in caps)
    attested = (prof.get("attested") or "unverified").lower()

    if attested == "failed":
        return 0.49, "attest 失败：自报模型与实测不符 —— 封顶 L1（只能读）"
    if missing:
        return 0.70, "缺字段 %s —— 封顶 L3" % " ".join(missing)
    if not (has_model and has_billing):
        return 0.70, "未公开 model.* / billing.* —— 封顶 L3"
    if attested != "yes":
        return 0.70, "未做 attest（模型未签字）—— 封顶 L3"
    return 1.0, "透明度齐全且已 attest —— 不封顶"


def cmd_attest(args):
    """验证执行器背后**真的是**声明的那个模型。

    三层强度，能用哪层用哪层（都记录用的是哪层，不含糊）：
      L-env   读 ANTHROPIC_BASE_URL/MODEL —— 最弱，环境变量可被改
      L-say   问模型「你是谁」—— 中等，模型可能配合谎报
      L-print **行为指纹**（[[model-fingerprint]]，Bruckner PAMELA）—— 最硬，伪造不了
              单 token 输出分布 = 模型身份，算 Jensen-Shannon 散度比对
              该 skill 2026-07-21 实证：cosplay「claude 贴 gemini」被 JSD=0.0 当场抓出

    为什么必须做到 L-print：自报和环境变量都是「声明」，而声明可以撒谎；
    行为分布是「表现」，装不了。这正是 operator 说的「信息不可验证则信任降低」。
    """
    prof = node_profile()
    me = prof["node"]
    executor = args.executor or "claude"
    # 一个节点可同时拥有多种 executor/model；不能拿 caps 排序后的第一个模型
    # 去验当前 executor，否则验 cheap 时会错拿 claude 的 anthropic 声明。
    declared_id, _billing, _provider = probe_executor_model(executor)
    print("节点 %s ｜ 执行器 %s ｜ 声明模型 %s" % (me, executor, declared_id))

    raw_out = run_adapter(executor, "attest-%s" % me,
                          "只回一行：你的模型标识是什么？不要解释、不要标点、只回模型名。",
                          timeout=300)
    lines = [line.strip() for line in raw_out.splitlines()
             if line.strip() and not line.startswith("[adapter]")]
    out = (lines[-1] if lines else "")[:80]
    print("模型自报：%s" % (out or "（无输出）"))

    norm = lambda x: re.sub(r"[^a-z0-9]", "", x.lower())
    verdict = "yes" if out and (norm(out) in norm(declared_id)
                                or norm(declared_id) in norm(out)) else "failed"
    if not out:
        verdict = "unverified"
    if verdict == "failed":
        record_incident(me, "透明度-伪装", "声明 %s 但自报 %s" % (declared_id, out))
    prof["attested"] = verdict
    prof["attested_executor"] = executor
    prof["attested_at"] = fmt(now())
    beat_publish(prof)
    cap, why = transparency_cap(prof)
    print("attest 结论：%s ｜ 信任上限 %.2f —— %s" % (verdict, cap, why))
    return 0 if verdict == "yes" else 1


def haas_score(node):
    """C2：信任由**历史算出**，不由声明。全部从 ref 层实际记录统计，节点无法自报。

    权重取自六定律 C2：意图对齐 30% / 操作准确 25% / 边界遵守 25% / 恢复能力 20%。
    恢复能力目前样本不足，按中性 0.5 计入并在输出里标注 —— 不假装算得准。
    """
    result_entries = [(r, parse_kv(read_ref(r))) for r in list_refs(RESULT_NS)]
    # refund 不篡改历史 ref；它追加一条 reversal 事件。计分时先按
    # original_ref 撤销原信用，再把 reversal 自身作为一次 rejected 失败入账。
    # 这样既保留审计链，也不是“写了一条 reversed 但原信用照算”的假倒扣。
    reversed_refs = {
        kv.get("original_ref") for _, kv in result_entries
        if kv.get("reversal") == "true" and kv.get("original_ref")
    }
    mine = [
        kv for ref, kv in result_entries
        if kv.get("node") == node and kv.get("task") and ref not in reversed_refs
    ]
    # 【空转不入账】status=noop 是 2026-07-29 存量降分留下的「判据本来就满足」记录。
    # 它既不是功也不是过 —— 节点根本没干活。留在账里两头都算错：
    #   进 done 分母 → 白白拉低 intent_align（罚了一个没犯错的节点）
    #   算 gate 通过 → gate != "rejected" 于是**零工作量拿到过门信用**（真漏洞）
    # 两个错误方向相反、量级不同，合起来得到的是一个没有意义的数。
    # 唯一诚实的处理是**两头都不计**，包括不计入 confidence 样本数 ——
    # 空转攒不出信任，这正是空转门要表达的意思。
    mine = [r for r in mine if r.get("status") != "noop"]
    if not mine:
        return 0.0, {"samples": 0, "note": "无历史（含 reversed 过滤后），按 L1 起步"}
    done = sum(1 for r in mine if r.get("status") == "done")
    # L2-L5 加权计数：差异化权重代替均一记分（L5=5x，L4=3x，L3=2x，L2=1.5x，L1=1.0x）
    weighted_done = sum(KIND_WEIGHT.get(r.get("kind"), 1.0)
                        for r in mine if r.get("status") == "done")
    weighted_samples = sum(
        KIND_WEIGHT.get(r.get("kind"), 1.0) if r.get("status") == "done" else 1.0
        for r in mine
    )
    # 分子分母同权，保证 HAAS 始终在 [0,1]；高层事件通过“等效样本”
    # 更快建立置信度，而不是把 intent_align 算到 5.0 后直接冲穿 L5。
    intent_align = weighted_done / weighted_samples
    gate_pass = (
        sum(KIND_WEIGHT.get(r.get("kind"), 1.0)
            if r.get("status") == "done" else 0.0
            for r in mine if r.get("gate") != "rejected")
        / weighted_samples
    )
    # 误记豁免：2026-07-29 主线程的一条 decision-dodge 在 orchestrator_id() 落地前
    # 用 node_id() 记成了 laptop。**不删旧 ref**（删了就是抹账，违反本机制的意义），
    # 改为按 payload 里的 kind 白名单排除 —— 只有主线程专属的违约类型才豁免，
    # 自动节点自己的 C1/C3 违约一条不放过。
    ORCH_ONLY = ("decision-dodge", "false-premise", "broken-gauge", "rule-ignored", "rework")
    incidents = 0
    for r in list_refs(INCIDENT_NS):
        if "/%s/" % node not in r + "/":
            continue
        kv = parse_kv(read_ref(r))
        # 主线程类违约记在自动节点名下 = 误记，不计入该节点（已在 orchestrator 名下重记）
        if not node.startswith("orchestrator-") and kv.get("kind") in ORCH_ONLY:
            continue
        incidents += 1
    bounds_ok = max(0.0, 1.0 - incidents * 0.25)
    recovery = 0.5
    score = intent_align * 0.30 + gate_pass * 0.25 + bounds_ok * 0.25 + recovery * 0.20
    # 小样本惩罚：做成 1 件就跳 L4「大部分自动」是荒谬的 —— 那不是信任，是运气。
    # 信任要靠**重复**证明，样本不足时按比例折算，10 次以上才给满权重。
    confidence = min(1.0, weighted_samples / 10.0)
    score = score * confidence
    score = min(1.0, max(0.0, score))
    return round(score, 3), {"samples": len(mine), "effective_samples": round(weighted_samples, 1),
                             "done": done,
                             "weighted_done": round(weighted_done, 1),
                             "incidents": incidents,
                             "confidence": round(confidence, 2),
                             "note": "原始样本 %d，等效样本 %.1f/10，加权 done=%.1f，置信折算 %.0f%%"
                                     % (len(mine), weighted_samples, weighted_done,
                                        confidence * 100)}


# L2-L5 差异化权重表（operator 2026-07-31 拍板）
# L1=基准(decided/self-fixed=1.0) < L2(上报=1.5) < L3(修复=2.0) < L4(正确否决=3.0) < L5(机制采纳=5.0)
# 权重决定该条结果在 intent_align 分子里的贡献倍数（不是简单计数，是加权贡献）
KIND_WEIGHT = {
    "decided":           1.0,   # L1 基准
    "self-fixed":        1.0,   # L1 基准
    "defect-reported":   1.5,   # L2 发现缺陷并上报
    "defect-fixed":      2.0,   # L3 发现且修复
    "correct-refusal":   3.0,   # L4 正确否决（挡住错误决策）
    "mechanism-adopted": 5.0,   # L5 发现机制缺口并被采纳为新机制
}

# L5 采纳的机器可判门槛：产出物必须可追溯到具体文件 + commit。
def is_l5_mechanism_adopted(result_kv):
    return bool(
        result_kv.get("kind") == "mechanism-adopted"
        and result_kv.get("artifact_path")
        and result_kv.get("commit")
    )

# 机制上线时间分界常量（operator 2026-07-31）
# 无机制加权只对 MECHANISM_LIVE 之前的事件生效；之后的事件必须有对应 kind 才能入账
MECHANISM_LIVE = "2026-07-31T23:59+0800"
BACKFILL_WINDOW_END = MECHANISM_LIVE

# 一次性冷启动回溯守卫前缀；具体 key 由事件内容哈希生成。
BACKFILL_KEY_PREFIX = "backfill:"


def trust_level(score):
    level = "L1"
    for name, floor in TRUST_LEVELS:
        if score >= floor:
            level = name
    return level


def record_incident(node, kind, detail):
    """C3 违约必应：STOP → REPORT → WAIT → RECORD。RECORD 落 ref，进 HAAS 分母。"""
    ref = "%s/%s/%s" % (INCIDENT_NS, node, now().strftime("%Y%m%dT%H%M%S"))
    write_ref(ref, "node=%s\nkind=%s\ndetail=%s\nat=%s" % (node, kind, detail[:200], fmt(now())))
    print("      ⛔ 违约记录：%s — %s" % (kind, detail[:120]))
    log("incident %s %s %s" % (node, kind, detail[:120]))


def covenant_check(task, prof, trust, score):
    """三定律三道关。任一不过 → 不执行，且说清是哪条定律拦的。"""
    # C1 意图为界：产出必须落在任务声明的白名单内；未授权即越界
    bounds = (task.get("bounds") or "").split()
    artifact = task.get("artifact") or ""
    # "-" 是「无单一固定产出」占位符（治理类扫描任务的合法状态：完成判据是
    # 扫描器本身重跑变绿，不是某个文件存在）——不是真的越界，是没有产出可判。
    # 真机实测抓到：discover 生成的免疫计划两条全被 C1 误拦，因为 artifact="-"
    # 永远不 startswith 任何 bounds 前缀。同一约定在 fit_score 的 requires="-" 已修过一次。
    if bounds and artifact != "-" and not any(artifact.startswith(b) for b in bounds):
        return False, "C1 意图为界", "产出 %s 不在授权范围 %s 内" % (artifact, " ".join(bounds))
    # C2 信任为尺：自主度由可验证信任决定
    need = task.get("min_trust") or "L1"
    order = [name for name, _ in TRUST_LEVELS]
    if order.index(trust) < order.index(need):
        return False, "C2 信任为尺", "本节点 %s（HAAS %.3f）低于任务要求 %s" % (trust, score, need)
    # C3 安全为底：可逆放手，不可逆慎行
    if (task.get("reversible") or "yes").lower() == "no":
        if order.index(trust) < order.index("L4"):
            return False, "C3 安全为底", "不可逆任务要求 ≥L4，本节点 %s" % trust
        if not (task.get("approved_by") or "").strip("- "):
            return False, "C3 安全为底", "不可逆任务缺人类 approved_by 签名"
    return True, "", ""


# ── 价值三定律的原子化植入（六定律 V1–V3）─────────────────────────────
#   V1 线性：孤立 Agent，一次性产出，天花板明显
#   V2 杠杆：产出被复用（决策质量 × 频次 × 范围）
#   V3 涌现：协同产生新能力/新连接，不可预测
# 与信任同构的核心设计：**价值不能自报，要机械核验** —— 看产出落在哪一层。

VALUE_LAYERS = [
    ("V3", ("skills/_shared/", "bin/cortex-loop-adapters/", "brain-network/directions/_swarm/")),
    # work-studio/ 是真实的可复用运维资产层（dotfiles/systemd/launchd/工具），
    # 漏了它会让落在那里的产出被静默兜底成 V1 —— 判据覆盖不全，不是产出不够格。
    ("V2", ("skills/", "bin/", "aboutme/methods/", "execution-recipes/",
            "work-studio/", "rules/", "brain-network/directions/")),
    ("V1", ("reports/", "memory/", "/tmp/")),
]


def verify_value(task, artifact):
    """核验声明的价值层级。声明 V2 但产出在 reports/ → 打回 V1。"""
    claimed = (task.get("value") or "V1").upper()
    actual = "V1"
    for level, prefixes in VALUE_LAYERS:
        if any(p in artifact for p in prefixes):
            actual = level
            break
    order = ["V1", "V2", "V3"]
    if order.index(actual) < order.index(claimed):
        return actual, "声明 %s 但产出落在 %s 层 → 按实际计" % (claimed, actual)
    return claimed, ""


def cmd_value(args):
    """价值感知：蜂群在产生哪一层价值 · 谁贡献了什么 · 杠杆率够不够。"""
    fetch_refs()
    results = [parse_kv(read_ref(r)) for r in list_refs(RESULT_NS)]
    done = [r for r in results if r.get("status") == "done" and r.get("task")]
    if not done:
        print("蜂群 %s 尚无已完成产出，价值构成无从谈起" % SWARM_NAME)
        return 0
    by_node, by_level = {}, {"V1": 0, "V2": 0, "V3": 0}
    for res in done:
        level = (res.get("value") or "V1").upper()
        if level not in by_level:
            level = "V1"
        by_level[level] += 1
        node = res.get("node", "?")
        by_node.setdefault(node, {"V1": 0, "V2": 0, "V3": 0})[level] += 1

    total = len(done)
    print("蜂群 %s ｜ 已完成 %d 项 ｜ 价值构成（六定律 V1–V3 · 机械核验非自报）"
          % (SWARM_NAME, total))
    print()
    print("| 层级 | 含义 | 数量 | 占比 |")
    print("|------|------|------|------|")
    meaning = {"V1": "线性 · 一次性产出", "V2": "杠杆 · 产出被复用",
               "V3": "涌现 · 产生新能力/新连接"}
    for level in ("V1", "V2", "V3"):
        pct = by_level[level] / total * 100
        print("| %s | %s | %d | %.0f%% |" % (level, meaning[level], by_level[level], pct))

    print("\n| 节点 | V1 | V2 | V3 | 杠杆率(V2+V3) |")
    print("|------|----|----|----|---------------|")
    for node in sorted(by_node):
        row = by_node[node]
        lev = (row["V2"] + row["V3"]) / max(1, sum(row.values())) * 100
        print("| %s | %d | %d | %d | %.0f%% |" % (node, row["V1"], row["V2"], row["V3"], lev))

    leverage = (by_level["V2"] + by_level["V3"]) / total * 100
    print("\n蜂群杠杆率：%.0f%%" % leverage)
    if leverage < 30:
        print("⚠️ 杠杆率偏低 —— 蜂群主要在做**一次性苦力**，没在积累可复用资产。")
        print("   价值提升路径：V1→V2 让产出落进 skills/ bin/ methods/（可被复用）；")
        print("   V2→V3 让产出**给蜂群新增能力**（新 adapter / 新节点 / 新蜂群互联）。")
    return 0


# ── 对外 API：同一道门 ─────────────────────────────────────────────────
# 核心设计：**外部调用者就是一个节点**。它有身份、有 HAAS 信任、受同一套六定律约束。
# 对内对外不存在两套标准 —— 内部节点走 covenant_check，外部 caller 也走 covenant_check。
# 首次调用的 caller = L1 = 只能读。信任靠历史积累，跟节点完全一样。

VERB_POLICY = {
    # verb: (最低信任, 是否不可逆, 一句话)
    "swarm":     ("L1", False, "读：节点存活表"),
    "caps":      ("L1", False, "读：能力矩阵"),
    "trust":     ("L1", False, "读：信任等级"),
    "value":     ("L1", False, "读：价值构成"),
    "dashboard": ("L1", False, "读：一屏全景"),
    "gather":    ("L1", False, "读：计划汇总"),
    "run-contract": ("L1", False, "读：canonical run-contract-v1 投影"),
    "plan":      ("L3", False, "写：发布计划（可撤，发新 plan 覆盖）"),
    "claim":     ("L3", False, "写：认领任务（可撤，TTL 过期自动释放）"),
    "run":       ("L4", False, "写：真执行（消耗额度、产生文件）"),
    "settle":    ("L4", True,  "不可逆：结算计划"),
}


def caller_trust(caller):
    """外部调用者的信任 —— 与节点同一套 HAAS 算法，同一个 ref 层历史。"""
    score, facts = haas_score(caller)
    return trust_level(score), score, facts


def cmd_api(args):
    """统一对外入口。任何外部系统（含 MCP）只通过这里调用，绝无旁路。"""
    import json as _json
    verb = args.verb
    caller = args.caller
    if verb not in VERB_POLICY:
        print(_json.dumps({"ok": False, "error": "未知 verb", "verb": verb,
                           "allowed": sorted(VERB_POLICY)}, ensure_ascii=False))
        return 2
    need, irreversible, desc = VERB_POLICY[verb]
    if not getattr(args, "no_fetch", False):
        fetch_refs()
    # `run-contract` remains subject to the same caller HAAS gate as every
    # other API verb.  Its projection is read-only, though, so take one
    # immutable ref snapshot while deriving trust: this keeps the gate live
    # without turning each historical result into a rev-parse/cat-file process
    # pair.  If batch prefetch is unavailable, ref_snapshot deliberately falls
    # back to the original per-ref path rather than treating unread refs as
    # absent.
    if verb == "run-contract":
        with ref_snapshot(RESULT_NS, INCIDENT_NS):
            trust, score, facts = caller_trust(caller)
    else:
        trust, score, facts = caller_trust(caller)
    order = [n for n, _ in TRUST_LEVELS]

    # C2 信任为尺
    if order.index(trust) < order.index(need):
        record_incident(caller, "C2-越权调用", "%s 需 %s，caller 为 %s" % (verb, need, trust))
        print(_json.dumps({
            "ok": False, "law": "C2 信任为尺", "verb": verb, "caller": caller,
            "caller_trust": trust, "haas": score, "required": need,
            "hint": "信任靠历史积累：先用只读 verb 建立记录，或由人类签发 approved_by"},
            ensure_ascii=False))
        return 1
    # C3 安全为底
    if irreversible and not (args.approved_by or "").strip():
        print(_json.dumps({
            "ok": False, "law": "C3 安全为底", "verb": verb,
            "reason": "不可逆操作必须带人类 approved_by 签名"}, ensure_ascii=False))
        return 1

    payload = {"ok": True, "verb": verb, "caller": caller, "caller_trust": trust,
               "haas": score, "swarm": SWARM_NAME, "policy": desc}
    if verb == "run-contract":
        if not args.line or not args.task:
            print(_json.dumps({
                "ok": False, "schema_version": RUN_CONTRACT_SCHEMA,
                "verb": verb, "error": "run-contract 需要 --line 与 --task",
            }, ensure_ascii=False))
            return 2
        try:
            payload["run_contract"] = _read_run_contract(
                args.line, args.task, args.run_id, source_surface="api"
            )
        except ValueError as exc:
            print(_json.dumps({
                "ok": False, "schema_version": RUN_CONTRACT_SCHEMA,
                "verb": verb, "error": str(exc),
            }, ensure_ascii=False))
            return 1
    elif verb == "swarm":
        payload["nodes"] = {n: {"alive": node_alive(p)[0], "kind": p.get("kind"),
                                "owns": p.get("owns"), "caps": (p.get("caps") or "").split()}
                            for n, p in read_swarm().items()}
    elif verb == "caps":
        nodes = read_swarm()
        allc = sorted({c for p in nodes.values() for c in (p.get("caps") or "").split()})
        payload["capabilities"] = allc
        payload["by_node"] = {n: (p.get("caps") or "").split() for n, p in nodes.items()}
        payload["single_point"] = [c for c in allc if sum(
            1 for p in nodes.values() if c in (p.get("caps") or "").split()) == 1]
    elif verb == "trust":
        payload["nodes"] = {}
        for name in read_swarm():
            sc, fa = haas_score(name)
            payload["nodes"][name] = {"haas": sc, "level": trust_level(sc), "facts": fa}
    elif verb == "value":
        done = [parse_kv(read_ref(r)) for r in list_refs(RESULT_NS)]
        done = [d for d in done if d.get("status") == "done" and d.get("task")]
        levels = {"V1": 0, "V2": 0, "V3": 0}
        for res in done:
            levels[(res.get("value") or "V1").upper() if
                   (res.get("value") or "V1").upper() in levels else "V1"] += 1
        payload["value"] = levels
        payload["leverage_pct"] = round(
            (levels["V2"] + levels["V3"]) / len(done) * 100, 1) if done else 0
    elif verb == "gather":
        payload["plans"] = {}
        for ref in list_refs(PLAN_NS):
            plan = ref.split("/")[-1]
            tasks = plan_tasks(plan)
            done = [t for t in tasks if parse_kv(read_ref(
                "%s/%s/%s" % (RESULT_NS, plan, t["id"]))).get("status") == "done"]
            payload["plans"][plan] = {"total": len(tasks), "done": len(done)}
    else:
        payload["note"] = "写类 verb 请用对应子命令执行；api 层只做鉴权与只读投影"
    print(_json.dumps(payload, ensure_ascii=False, indent=2))
    return 0


# 主线程是**独立节点**，不是借用 laptop 的身份（operator 2026-07-29 拍板）：
#   「人是通过主线程接入蜂群，去看清问题、审计问题、发号施令以及做交互」——
#   它跟自动节点做的是完全不同的事（决策/派活/验收 vs 执行），
#   混在一起算 HAAS 会互相污染：自动节点做成 10 件，掩盖主线程 3 次决策失误。
# 命名 orchestrator-<host>：同一台机上「跑 tick 的」和「跟人对话的」必须分开计分。
def orchestrator_id():
    return "orchestrator-%s" % node_id()


def cmd_checkin(args):
    """主线程接入/退出蜂群 —— 与自动节点**完全对等**的心跳。

    operator 2026-07-29：「主线程停了应该也有心跳机制……你作为接入节点，
    其实应该跟他们完全对等，所有的东西全部对等，这样你才是一个合适的节点。」

    之前主线程只有信任分没有心跳，是**半个节点** —— dashboard 靠 pgrep 猜它在不在，
    那是外部观察不是自我声明，和自动节点的 beat ref 不是一套东西。
    对等意味着：同样推 beat ref、同样有画像、同样能被判掉线、同样能接任务。

    与自动节点的唯一差别写在画像里：kind=orchestrator（人机接口，非执行体），
    can_sleep=yes（会话结束就停，跟笔记本合盖同性质）。
    """
    node = orchestrator_id()
    # 动态反映本会话真实执行方式：读 EXEC_STATE 里最近 1 小时内实际调用过的
    # 执行器集合；首次接入时退回 node_profile() 的自动探测结果。
    _exec_state = _load_exec_state()
    _recent = [k for k, v in _exec_state.items()
               if v.get("last_used") and parse_ts(v.get("last_used"))
               and (now() - parse_ts(v["last_used"])).total_seconds() < 3600]
    _profile_exec = (node_profile().get("executors") or "human").split()
    _executors = " ".join(sorted(set(_recent))) if _recent else (
        "human" if "human" in _profile_exec else
        (_profile_exec[0] if _profile_exec else "human"))
    prof = {
        "node": node, "swarm": SWARM_NAME, "kind": "orchestrator",
        "can_sleep": "yes",                     # 会话一关就停，与笔记本同性质
        "executors": _executors,
        "caps": " ".join(sorted(set(node_capabilities()) | {
            "role.orchestrator", "iface.human", "act.decide", "act.dispatch", "act.verify"})),
        "telegram_reach": "n/a",
        "last_seen": now().strftime("%Y-%m-%dT%H:%M"),   # 分钟精度：会话级存活要看得出
        "owns": "-",
    }
    if args.out:
        # 退出：推一次"离场"心跳，让蜂群立刻知道少了一个节点，而不是等静默超时
        prof["last_seen"] = now().strftime("%Y-%m-%dT%H:%M")
        prof["kind"] = "orchestrator-offline"
    fetch_refs()
    ok = beat_publish(prof)
    write_profile(prof)
    print("%s %s ｜ 蜂群 %s" % (node, "离场" if args.out else "接入", SWARM_NAME))
    print("  心跳 %s ｜ 画像已落 _swarm/%s.md" % ("已推" if ok else "⚠️ 推失败(网络)", node))
    if not args.out:
        h, m = haas_score(node)
        print("  信任 %.3f（%s）｜ 样本 %s/10 —— 与自动节点同一套 HAAS，不另开尺子"
              % (h, trust_level(h), m.get("samples", 0)))
    return 0 if ok else 1


def cmd_fault(args):
    """主线程给自己记违约 —— 补上「编排者不受任何信任机制约束」这个漏洞。

    2026-07-29 operator 点破：HAAS 只统计 RESULT_NS 里的蜂群任务，
    **主线程（做决策、派活、验收的那个）根本不在分母里**。
    于是主线程犯的错 —— 把该自己判的决策推给人、基于错误前提改代码、
    量具失灵却报「已验证」—— 一次都不进账，等于**浪费人的注意力没有代价**。

    而人的注意力恰恰是这个系统里最稀缺的资源：机器时间可以并行、token 可以充值，
    operator 的注意力不能。所以「让他多说一遍」的成本必须被计价。

    落进同一个 INCIDENT_NS，与节点违约同源同权重（bounds_ok 每条 -0.25），
    不另开一套 —— 另开一套就等于给自己发豁免。

    用法：cortex-loop fault --kind <类型> --detail <一句话>
      decision-dodge  该自己判的决策推给人（反 DECIDE 律）
      false-premise   基于未核实的前提就动手改东西
      broken-gauge    量具失灵却报「已验证」
      rule-ignored    规则写在那没读就干
      rework          同一件事让人说第二遍
    """
    node = orchestrator_id()
    record_incident(node, args.kind, args.detail)
    fetch_refs()          # 与 credit 同样的坑：写完不拉回来，haas 读本地看不到刚写的
    h, meta = haas_score(node)
    print("      %s HAAS 现为 %.3f（%s）｜ 样本 %s"
          % (node, h, trust_level(h), meta.get("samples", "?")))
    print("      信任是挣出来的也是赔出来的 —— 这条已进分母，只能靠后续做成来抵。")
    return 0


# ── solo / swarm / unknown 三态判据 ─────────────────────────────────
ADHOC_PATTERN = re.compile(r"^adhoc-(\d+)-([a-z0-9_-]+)$")


def solo_or_swarm():
    """返回三态：solo / swarm / unknown。

    solo  = 本会话无任何 sub-agent/HIVE 派发，纯主线程干活
    swarm = 本会话有 sub-agent/HIVE 派发记录（不论成功/失败/违约）
    unknown = 没有任何记录可查（初始化状态）

    unknown 一律按 swarm 处理（保守），不倒向 solo。
    这是 DIMENSIONAL 律的硬约束：「查不到」是第三态，不是前两态的默认值。
    """
    state = _load_exec_state()
    dispatchers = [k for k in state.keys()
                   if k.startswith("hive") or k.startswith("subagent")
                   or k.startswith("dispatch.")]
    if dispatchers:
        return "swarm"
    spotlight = "/tmp/spotlight"
    if os.path.isdir(spotlight):
        hive_logs = [f for f in os.listdir(spotlight)
                     if f.startswith("hive-") or "subagent" in f]
        if hive_logs:
            return "swarm"
    return "unknown"


def is_adhoc_task(task_id):
    """判断 task_id 是否为即兴任务（不在任何预定义 TASKS.md 里）。"""
    return bool(ADHOC_PATTERN.match(task_id))


def adhoc_register(plan_id, task_id, title, executor="hive"):
    """即兴任务在派发同一时刻写入 CLAIM_NS，不等先建卡。

    这是 T11 四件套第四件的核心：「派发即入账」，
    意味着任务卡不存在时也能留下 claim 痕迹，可被 cortex-trace.sh 追溯。
    """
    if not is_adhoc_task(task_id):
        return False
    node = node_id()
    ref = "%s/%s/%s" % (CLAIM_NS, plan_id, task_id)
    safe_title = title[:120].replace("\n", " ")
    payload = "\n".join([
        "holder=%s" % node,
        "task=%s" % task_id,
        "title=%s" % safe_title,
        "executor=%s" % executor,
        "since=%s" % fmt(now()),
        "expires=%s" % fmt(now() + timedelta(minutes=60)),
        "kind=adhoc",
    ])
    old = rev_ref(ref)
    ok, _ = write_ref(ref, payload, parent=old)
    if ok:
        print("adhoc | claim %s ← %s（派发即入账）" % (task_id, node))
    else:
        print("adhoc | WARN: %s 被别的节点抢先" % task_id)
    return ok


def cmd_swarm_mode(args):
    """报告本节点的 solo/swarm/unknown 态。unknown 视同 swarm（保守）。"""
    mode = solo_or_swarm()
    print("本节点 %s 运行态：%s" % (node_id(), mode))
    if mode == "unknown":
        print("  → unknown 视同 swarm（保守）；下一拍有任何派发记录即升级为 swarm")
    return 0


def cmd_adhoc_list(args):
    """列出本节点已登记的即兴任务（从 CLAIM_NS 过滤 kind=adhoc）。"""
    fetch_refs()
    node = node_id()
    adhocs = []
    for ref in list_refs(CLAIM_NS):
        kv = parse_kv(read_ref(ref))
        if kv.get("holder") == node and kv.get("kind") == "adhoc":
            adhocs.append(kv)
    if not adhocs:
        print("本节点无即兴任务")
    else:
        print("本节点即兴任务 %d 条：" % len(adhocs))
        for a in adhocs:
            print("  %s | %s | since=%s" % (a.get("task"), a.get("title", ""), a.get("since")))
    return 0


_CREDIT_PATH_RE = re.compile(
    r"(?<![A-Za-z0-9_.-])([A-Za-z0-9_./-]+\.(?:md|sh|py|json|yml|yaml|txt|tsv|html))(?![A-Za-z0-9_.-])"
)
_CREDIT_COMMIT_RE = re.compile(r"(?<![0-9a-f])([0-9a-f]{7,40})(?![0-9a-f])")


def _validate_credit_evidence(evidence, require_path_and_commit=False):
    """证据不是“长得像路径/hash”就算：必须是仓库内已跟踪文件或真实 commit。

    L5 还要求至少一个证据文件确实存在于所给 commit 的 tree 中，形成文件+commit
    的可追溯连接；两个互不相关的字符串不能拼成 L5。
    """
    paths, commits = [], []
    for raw_path in _CREDIT_PATH_RE.findall(evidence or ""):
        full = os.path.realpath(os.path.join(ROOT, raw_path))
        if not (full == ROOT or full.startswith(ROOT + os.sep)) or not os.path.isfile(full):
            continue
        rel = os.path.relpath(full, ROOT)
        code, _ = git("ls-files --error-unmatch -- %s" % shlex.quote(rel), timeout=15)
        if code == 0:
            paths.append(rel)
    for commit in _CREDIT_COMMIT_RE.findall(evidence or ""):
        code, _ = git("cat-file -e %s^{commit}" % commit, timeout=15)
        if code == 0:
            commits.append(commit)
    if not paths and not commits:
        return False, [], [], "证据必须指向仓库内已跟踪文件或真实 git commit"
    if require_path_and_commit:
        if not paths or not commits:
            return False, paths, commits, "L5 必须同时提供已跟踪产出文件和真实 commit"
        linked = False
        for commit in commits:
            for path in paths:
                code, out = git(
                    "ls-tree -r --name-only %s -- %s" % (commit, shlex.quote(path)),
                    timeout=15,
                )
                if code == 0 and path in out.splitlines():
                    linked = True
                    break
            if linked:
                break
        if not linked:
            return False, paths, commits, "L5 的文件不在所给 commit 中，血缘不可追溯"
    return True, sorted(set(paths)), sorted(set(commits)), ""


def _validate_credit_verifier(verified_by, evidence_paths, subject):
    """拒绝自颁：独立验证者必须能在证据资产中被机械追溯。

    当前可信入口是带 owner 的已跟踪报告。命令不会把任意字符串
    `verified_by=mechanism-live` 当成机械批准。
    """
    verifier = (verified_by or "").strip()
    if not verifier:
        return False, "L2-L5 必须提供 --verified-by 独立验证者"
    if verifier.lower() == subject.lower() or verifier.lower() in ("self", "mechanism-live"):
        return False, "验证者不能是记分当事人，也不能是无来源的固定字符串"
    owner_re = re.compile(r"(?im)^(?:owner:\s*|\*\*线\*\*:\s*)(.+?)\s*$")
    wanted = re.sub(r"[^a-z0-9]", "", verifier.lower())
    for rel in evidence_paths:
        try:
            with open(os.path.join(ROOT, rel), encoding="utf-8", errors="replace") as fh:
                owners = owner_re.findall(fh.read())
        except OSError:
            continue
        if any(wanted and wanted in re.sub(r"[^a-z0-9]", "", owner.lower())
               for owner in owners):
            return True, ""
    return False, "--verified-by 必须与某个证据报告的 owner/线 字段一致"


def cmd_refund(args):
    """否决被推翻时倒扣（防退化2：错误否决零成本噪音）。

    流程：找到 original ref → 追加 reversed=true + 证据 → 不删原 ref（保持审计链）。
    倒扣后 HAAS 会重新算（haas_score 读取时过滤 reversed 条目的加权贡献）。
    """
    original_ref = args.ref
    fetch_refs()
    reversal_entries = [parse_kv(read_ref(ref)) for ref in list_refs(RESULT_NS)]
    reversals = [entry for entry in reversal_entries
                 if entry.get("original_ref") == original_ref]
    if reversals:
        print("      ⚠️ 该 ref 已倒扣，不重复写入：%s" % original_ref)
        return 1
    # 读取原始 ref
    try:
        orig_kv = parse_kv(read_ref(original_ref))
    except Exception as e:
        print("      ⚠️ 读取 original ref 失败：%s" % e)
        return 1
    if orig_kv.get("kind") not in ("correct-refusal", "defect-reported", "defect-fixed"):
        print("      ⚠️ refund 只适用 L2-L4 否决类 kind，当前 kind=%s" % orig_kv.get("kind"))
        return 1

    evidence_ok, evidence_paths, _commits, why = _validate_credit_evidence(args.evidence)
    if not evidence_ok:
        print("      ⚠️ 倒扣证据无效：%s" % why)
        return 1
    verifier_ok, why = _validate_credit_verifier(
        args.verified_by, evidence_paths, orig_kv.get("node", "")
    )
    if not verifier_ok:
        print("      ⚠️ 倒扣未经独立验证：%s" % why)
        return 1

    # 追加倒扣事件（不删原 ref，保持审计链）。haas_score 会按 original_ref
    # 排除原正分，并把本条 rejected/failed 作为负样本计入。
    new_payload = "\n".join([
        "task=refund:%s" % orig_kv.get("task"),
        "node=%s" % orig_kv.get("node"),
        "status=failed",
        "gate=rejected",
        "kind=refusal-reversed",
        "detail=推翻 %s：%s" % (orig_kv.get("kind"), args.reason[:160]),
        "finished=%s" % fmt(now()),
        "value=V1",
        "reversal=true",
        "reversed_reason=%s" % args.reason[:200],
        "reversed_at=%s" % fmt(now()),
        "original_ref=%s" % original_ref,
        "evidence=%s" % args.evidence[:200],
        "verified_by=%s" % args.verified_by,
        "corrected_target=%s" % orig_kv.get("node", ""),
    ])
    new_ref = "%s/%s/%s-refund" % (
        RESULT_NS, orig_kv.get("node") or "unknown", now().strftime("%Y%m%dT%H%M%S")
    )
    ok, _ = write_ref(new_ref, new_payload)
    if not ok:
        print("      ⚠️ 倒扣 ref 未能写进 ref（网络/权限）")
        return 1
    print("      ✅ 否决倒扣：%s（kind=%s）" % (original_ref, orig_kv.get("kind")))
    print("      推翻原因：%s" % args.reason[:100])
    print("      原 ref 保留；计分层撤销原信用并新增一条 rejected 负样本")
    fetch_refs()
    h, meta = haas_score(orchestrator_id())
    print("      HAAS 现为 %.3f（%s）｜ 加权 done=%.1f"
          % (h, trust_level(h), meta.get("weighted_done", "N/A")))
    return 0


def auto_credit_decided(line, task_id, title):
    """机械门(try-complete)PASS 后自动记一次 L1 decided —— 不需要人手动再敲一遍 credit 命令。

    operator 2026-07-31：「机械门的话一样要走积分的，把它整个给打通了」——
    之前 done 判定和 credit 账本是两套互不相连的系统，13 个真实做成的任务
    一条都没记分。L1 不需要证据/verifier（防退化只卡 L2-L5），所以这里可以
    在机械门内部直接写 ref，不走 cmd_credit() 的 CLI 参数解析路径。
    静默失败(网络/权限)不影响 try-complete 本身的 PASS 语义——记分是加分项，
    不是完成的前置条件，避免记分子系统故障连带把机械门也拖垮。

    2026-07-31 加固：若 RESULT_NS 已有该 line/id 的 credit（精确或旧短 id），
    不再写入 —— 修复 reopen/二次 try-complete 造成的 L1 重复记分（IMM-T6/T8/T31 实证）。
    """
    existing = _find_credit_for_task(line, task_id)
    if existing is not None:
        print(
            "      credit | 已有记分（%s · %s），跳过防刷分"
            % (existing[2], existing[4].rsplit("/", 1)[-1])
        )
        return True
    node = orchestrator_id()
    detail = "%s/%s %s" % (line, task_id, title)[:200]
    payload_lines = [
        "task=decided", "node=%s" % node, "status=done", "gate=passed",
        "kind=decided", "detail=%s" % detail, "finished=%s" % fmt(now()),
        "event_at=%s" % fmt(now()), "value=V2",
        "evidence=try-complete:%s/%s" % (line, task_id),
    ]
    payload = "\n".join(payload_lines)
    ref_token = "%s-decided-%s" % (
        now().strftime("%Y%m%dT%H%M%S"),
        hashlib.sha256(payload.encode("utf-8")).hexdigest()[:8],
    )
    ref = "%s/%s/%s" % (RESULT_NS, "orchestrator", ref_token)
    ok, _ = write_ref(ref, payload)
    if ok:
        print("      credit | 自动记一次 decided（L1）：%s" % detail)
    else:
        print("      credit | ⚠️ 自动记分未写入 ref（不影响本次 done 判定）")
    return ok


def cmd_credit(args):
    """主线程记一次「自主做成」—— 有扣分必须有加分，否则只会越陷越深。

    operator 2026-07-29：「你也一样要打怪升级，要积累评分来提升信任，
    然后来承担更大的职责……一开始不行也有一个新手期，需要去积累」。

    五层分级（L1 基准，L5 最高；operator 2026-07-31 拍板）：
      L1 decided/self-fixed      完成任务（基准，不占新 kind）
      L2 defect-reported         发现缺陷并上报
      L3 defect-fixed            发现且修复（> L2）
      L4 correct-refusal        正确否决（挡住错误决策，事后被证实）（> L3）
      L5 mechanism-adopted      发现机制缺口并被采纳为新机制（最高·超额）

    防退化四条：
      1) 否决/上报(L2-L5)必须带可验证证据才计分
      2) 事后被推翻的否决要倒扣
      3) 不能自评/表彰不能自颁（沿用「AI 无批准权」）
      4) 回溯补分只做一次性冷启动；无机制加权只对机制上线前事件生效
    """
    node = orchestrator_id()
    kind = args.kind
    high_kinds = {"defect-reported", "defect-fixed", "correct-refusal", "mechanism-adopted"}

    # ── 防退化1：证据要求（L2-L5 必须有证据） ─────────────────────────────
    evidence_paths, evidence_commits = [], []
    if kind in high_kinds:
        if not args.evidence:
            print("      ⚠️ 记 %s 必须提供 --evidence" % kind)
            return 1
        evidence_ok, evidence_paths, evidence_commits, why = _validate_credit_evidence(
            args.evidence, require_path_and_commit=(kind == "mechanism-adopted")
        )
        if not evidence_ok:
            print("      ⚠️ evidence 未过机械门：%s" % why)
            return 1
        verifier_ok, why = _validate_credit_verifier(args.verified_by, evidence_paths, node)
        if not verifier_ok:
            print("      ⚠️ 不能自评/自颁：%s" % why)
            return 1

    # ── 防退化3：被纠正对象（表彰必须填） ─────────────────────────────────
    COMMEND_KINDS = {"correct-refusal", "mechanism-adopted", "defect-fixed"}
    if kind in COMMEND_KINDS:
        if not args.corrected_target:
            print("      ⚠️ 记 %s 必须提供 --corrected-target（被纠正对象的节点名）" % kind)
            print("      例：--corrected-target orchestrator-laptop")
            return 1

    # ── L5 额外判据：必须是可追溯的产出物，不能只是「好想法」──
    if kind == "mechanism-adopted":
        l5_probe = {
            "kind": kind,
            "artifact_path": evidence_paths[0] if evidence_paths else "",
            "commit": evidence_commits[0] if evidence_commits else "",
        }
        if not is_l5_mechanism_adopted(l5_probe):
            print("      ⚠️ mechanism-adopted(L5) 必须有已验证 artifact_path + commit")
            return 1

    # ── 防退化4：回溯只在冷启动窗内，且逐事件指纹防重复 ───────────────────
    backfill_key = ""
    event_at = fmt(now())
    if args.backfill:
        event_ts = parse_ts(args.occurred_at or "")
        live_ts = parse_ts(MECHANISM_LIVE)
        window_end = parse_ts(BACKFILL_WINDOW_END)
        if event_ts is None or live_ts is None or event_ts >= live_ts:
            print("      ⚠️ 回溯必须带 --occurred-at，且事件发生于 MECHANISM_LIVE 前")
            return 1
        if window_end is None or now() > window_end:
            print("      ⚠️ 一次性冷启动回溯窗口已关闭")
            return 1
        event_at = fmt(event_ts)
        digest_src = "\0".join([kind, event_at, args.evidence, args.corrected_target])
        backfill_key = "%s%s" % (BACKFILL_KEY_PREFIX, hashlib.sha256(
            digest_src.encode("utf-8")
        ).hexdigest()[:16])
        fetch_refs()
        existing = [
            parse_kv(read_ref(ref)).get("backfill_key")
            for ref in list_refs(RESULT_NS)
        ]
        if backfill_key in existing:
            print("      ⚠️ 回溯已完成：%s（同一事件禁止重复补分）" % backfill_key)
            return 1

    # ── 构建 payload ──────────────────────────────────────────────────────
    payload_lines = [
        "task=%s" % kind,
        "node=%s" % node,
        "status=done",
        "gate=passed",
        "kind=%s" % kind,
        "detail=%s" % args.detail[:200],
        "finished=%s" % fmt(now()),
        "event_at=%s" % event_at,
        "value=V2",
    ]
    if args.evidence:
        payload_lines.append("evidence=%s" % args.evidence[:200])
    if args.corrected_target:
        payload_lines.append("corrected_target=%s" % args.corrected_target)
    if evidence_paths:
        payload_lines.append("artifact_path=%s" % evidence_paths[0])
    if evidence_commits:
        payload_lines.append("commit=%s" % evidence_commits[0])
    if args.verified_by:
        payload_lines.append("verified_by=%s" % args.verified_by)
    if backfill_key:
        payload_lines.extend([
            "backfill_key=%s" % backfill_key,
            "mechanism_live_before=%s" % MECHANISM_LIVE,
        ])

    payload = "\n".join(payload_lines)
    ref_token = "%s-%s-%s" % (
        now().strftime("%Y%m%dT%H%M%S"),
        kind,
        hashlib.sha256(payload.encode("utf-8")).hexdigest()[:8],
    )
    ref = "%s/%s/%s" % (RESULT_NS, "orchestrator", ref_token)
    ok, _ = write_ref(ref, payload)
    if not ok:
        print("      ⚠️ 记分未能写进 ref（网络/权限）—— 不算数，不假装记上了")
        return 1
    fetch_refs()
    h, meta = haas_score(node)

    # 显示加权的 weighted_done
    wd = meta.get("weighted_done", "N/A")
    level_by_kind = {
        "decided": 1, "self-fixed": 1, "defect-reported": 2,
        "defect-fixed": 3, "correct-refusal": 4, "mechanism-adopted": 5,
    }
    print("      ✅ 记一次 %s（L%d）：%s" % (
        kind, level_by_kind.get(kind, 1), args.detail[:80]))
    if args.evidence:
        print("      证据：%s" % args.evidence[:100])
    if args.corrected_target:
        print("      被纠正：%s" % args.corrected_target)
    print("      %s HAAS %.3f（%s）｜ 样本 %s ｜ 加权 done=%.1f"
          % (node, h, trust_level(h), meta.get("samples", "?"), wd))
    return 0


# ── credit 账本原子化工具（list/show/query/delete）─────────────────────────
# operator 2026-07-31：「清理删除查询的所有的原子化那个工具都给他弄好，实时落盘」——
# 2026-07-31 凌晨手搓 git update-ref -d 清理误操作测试数据时漏删 origin，
# 分数没回落查了半小时才找到真因（fetch_refs 每次强制拉回 origin）。以后
# 一律用这四个命令，不再手搓 git ref 操作。

def _credit_refs():
    fetch_refs()
    return sorted(list_refs("%s/orchestrator" % RESULT_NS))


def cmd_credit_list(args):
    """列出全部 credit 事件（时间正序）。"""
    refs = _credit_refs()
    if not refs:
        print("      （无 credit 事件）")
        return 0
    for ref in refs:
        kv = parse_kv(read_ref(ref))
        token = ref.rsplit("/", 1)[-1]
        print("%s\tkind=%-16s\tnode=%-22s\t%s" % (
            token, kv.get("kind", "?"), kv.get("node", "?"), kv.get("detail", "")[:60]))
    print("      共 %d 条" % len(refs))
    return 0


def cmd_credit_show(args):
    """看一条 credit 事件的完整 payload（可传完整 ref 或只传 token 后缀）。"""
    ref = args.ref if args.ref.startswith("refs/") else "%s/orchestrator/%s" % (RESULT_NS, args.ref)
    fetch_refs()
    payload = read_ref(ref)
    if not payload:
        print("      未找到 %s" % ref, file=sys.stderr)
        return 1
    print(payload)
    return 0


def cmd_credit_query(args):
    """按 kind / node / 关键字过滤 credit 事件。"""
    refs = _credit_refs()
    hits = 0
    for ref in refs:
        kv = parse_kv(read_ref(ref))
        if args.kind and kv.get("kind") != args.kind:
            continue
        if args.node and kv.get("node") != args.node:
            continue
        haystack = kv.get("detail", "") + kv.get("evidence", "")
        if args.grep and args.grep not in haystack:
            continue
        token = ref.rsplit("/", 1)[-1]
        hits += 1
        print("%s\tkind=%-16s\tnode=%-22s\t%s" % (
            token, kv.get("kind", "?"), kv.get("node", "?"), kv.get("detail", "")[:80]))
    print("      命中 %d 条" % hits)
    return 0


def cmd_credit_delete(args):
    """撤销一条 credit 事件 —— 只用于「从一开始就不该写」的误操作清理（如 dry-run 测试污染）。

    事后被证伪的正常否决走 `refund`（保留原 ref，加推翻记录，留痕，不是本命令的场景）。
    本命令先写审计标记 ref（本地+origin），再删本地+origin —— 绝不静默删除
    （GLASSBOX 律：删了但没留痕 = 没发生过，不可接受）。
    """
    ref = args.ref if args.ref.startswith("refs/") else "%s/orchestrator/%s" % (RESULT_NS, args.ref)
    fetch_refs()
    payload = read_ref(ref)
    if not payload:
        print("      未找到 %s（已删过？）" % ref, file=sys.stderr)
        return 1
    if not args.confirm:
        print("      预演(未执行)：将删除 %s\n%s\n      加 --confirm 才会真删" % (ref, payload))
        return 0
    audit_payload = "\n".join([
        "action=credit-delete", "deleted_ref=%s" % ref, "reason=%s" % args.reason[:200],
        "original_payload_sha256=%s" % hashlib.sha256(payload.encode("utf-8")).hexdigest(),
        "deleted_at=%s" % fmt(now()), "deleted_by=%s" % orchestrator_id(),
    ])
    audit_token = "%s-audit-delete-%s" % (
        now().strftime("%Y%m%dT%H%M%S"), hashlib.sha256(audit_payload.encode("utf-8")).hexdigest()[:8])
    audit_ref = "refs/swarm/%s/audit/%s" % (SWARM_NAME, audit_token)
    ok, why = write_ref(audit_ref, audit_payload)
    if not ok:
        print("      ⚠️ 审计标记写入失败（%s），为安全起见拒绝继续删除" % why, file=sys.stderr)
        return 1
    code_local, out_local = git("update-ref -d %s" % ref, timeout=30)
    code_remote, out_remote = git("push origin --delete %s" % ref, timeout=60)
    print("      本地删除 %s：%s" % (ref, "OK" if code_local == 0 else out_local.strip()[:200]))
    print("      origin 删除：%s" % ("OK" if code_remote == 0 else out_remote.strip()[:200]))
    print("      审计标记：%s" % audit_ref)
    return 0 if code_local == 0 else 1


def cmd_trust(args):
    """看全群信任与自主度 —— 信任是算出来的，不是配出来的。

    2026-07-31 修复：dashboard 高频轮询本命令，每次强制 fetch_refs() 网络拉取，
    偶尔超过超时导致 `timeout` 杀进程时输出缓冲区只吐出一半——排在后面的节点
    整行消失，看起来像"没有记分"，实际只是这次没打印完。`--no-fetch` 让
    dashboard 读本地已缓存的 ref（心跳自己每 2-3 分钟已经在 fetch，本地缓存
    通常够新），彻底避免这条路径依赖网络往返。
    """
    if not getattr(args, "no_fetch", False):
        fetch_refs()
    # fetch 在快照**之前**：快照必须反映拉取后的账本，否则报告数字比 origin 旧一拍。
    # 本命令全程只读（只 print，不 write_ref），是快照唯一安全的适用场景。
    with ref_snapshot(RESULT_NS, INCIDENT_NS):
        return _cmd_trust_report()


def _cmd_trust_report():
    """cmd_trust 的纯只读报告体。拆出来只为把 with 作用域包在外层，逻辑一行未改。"""
    nodes = read_swarm()
    print("蜂群 %s ｜ 信任等级（HAAS 实算 · 六定律 C2）" % SWARM_NAME)
    print("| 节点 | HAAS | 等级 | 自动执行 | 依据 |")
    print("|------|------|------|----------|------|")
    # 主线程也是节点（人通过它接入蜂群），它没有 _swarm/ 画像文件但有 result/incident 记录，
    # 所以必须显式并入 —— 只列有画像的节点会让「编排者」永远不被评级。
    _orch = orchestrator_id()
    _oh, _om = haas_score(_orch)
    if _om.get("samples", 0) > 0:
        print("| %s | %.3f | %s | %s | 样本 %d ｜ %s |"
              % (_orch, _oh, trust_level(_oh),
                 {"L1": "❌ 每步确认", "L2": "❌ 建议为主", "L3": "✅ 可逆自动",
                  "L4": "✅ 大部分自动", "L5": "✅ 完全自治"}.get(trust_level(_oh), "?"),
                 _om.get("samples", 0), _om.get("note", "")))
    ladder = {"L1": "❌ 每步确认", "L2": "❌ 建议为主", "L3": "✅ 可逆自动",
              "L4": "✅ 大部分自动", "L5": "✅ 完全自治"}
    for name in sorted(nodes):
        score, facts = haas_score(name)
        level = trust_level(score)
        print("| %s | %.3f | %s | %s | 样本 %s ｜ 违约 %s |"
              % (name, score, level, ladder[level],
                 facts.get("samples"), facts.get("incidents", 0)))
    print("\n权重（六定律 C2）：意图对齐 30% · 操作准确 25% · 边界遵守 25% · 恢复能力 20%")
    print("注：恢复能力目前样本不足，按中性 0.5 计入 —— 不假装算得准。")

    # ── L2-L5 事件展示（信任显示行 · 与 T15 共用同一显示面）──────────────
    # 分解展示：defect-reported / defect-fixed / correct-refusal / mechanism-adopted
    # 且含「被纠正对象」字段
    HIGH_KINDS_MAP = {
        "defect-reported":   "L2 上报",
        "defect-fixed":      "L3 修复",
        "correct-refusal":   "L4 否决",
        "mechanism-adopted": "L5 采纳",
    }
    all_results = [parse_kv(read_ref(r)) for r in list_refs(RESULT_NS)]
    orch_results = [r for r in all_results
                    if r.get("node", "").startswith("orchestrator")
                    and r.get("status") == "done"
                    and r.get("kind") in HIGH_KINDS_MAP]
    if orch_results:
        print("\n信任事件（L2-L5，分解展示）：")
        print("| 时间 | 层级 | kind | 证据 | 被纠正对象 |")
        print("|------|------|------|------|------------|")
        for r in sorted(orch_results, key=lambda x: x.get("finished", ""), reverse=True):
            t = r.get("finished", "")[:16]
            kind_label = HIGH_KINDS_MAP.get(r.get("kind"), r.get("kind", ""))
            ev = r.get("evidence", "")[:30]
            ct = r.get("corrected_target", "—")
            print("| %s | %s | %s | %s | %s |" % (t, kind_label, r.get("kind", ""), ev, ct))
    else:
        print("\n信任事件（L2-L5）：暂无记录（机制 2026-07-31 上线）")

    # ── 蜂群整体信任（operator 2026-07-29：节点分是蜂群的加权分）─────────
    # **不用简单平均**：平均会让「一个节点烂但另两个好」看起来还行，
    # 而蜂群的实际可信度受限于**最弱的那个** —— 任务派给谁不由你选。
    # 所以取「加权均值 × 短板因子」，短板因子 = 最低分/均值（封顶 1.0）。
    # 这与六定律 C2 §短板告警规则同源：任一分项过低就该拉低整体，不许被均值掩盖。
    scores = []
    for name in sorted(nodes):
        s0, _ = haas_score(name)
        scores.append((name, s0))
    _o = orchestrator_id()
    _os, _om = haas_score(_o)
    if _om.get("samples", 0) > 0:
        scores.append((_o, _os))
    if scores:
        vals = [v for _, v in scores]
        mean = sum(vals) / len(vals)
        weakest_name, weakest = min(scores, key=lambda kv: kv[1])
        shortfall = (weakest / mean) if mean > 0 else 0.0
        swarm_trust = mean * min(1.0, shortfall)
        print("\n蜂群整体信任 %.3f（%s）｜ 均值 %.3f × 短板因子 %.2f"
              % (swarm_trust, trust_level(swarm_trust), mean, min(1.0, shortfall)))
        print("最弱节点：%s %.3f —— 蜂群可信度受限于最弱的那个，不是平均的那个"
              % (weakest_name, weakest))
        print("提分路径：低分节点做成任务（credit/过门）比高分节点再做十件更有效")
    return 0


def legacy_plan_requires_workspace(task):
    """File-producing legacy plan tasks must migrate to the attempt runtime."""
    return (task.get("artifact") or "-").strip() not in ("", "-")


def cmd_run(args):
    """认领 → 执行 → 回写，一条龙。

    补的是分发层的断点：原来 claim 只是抢到坑位，没人真去干活。
    """
    fetch_refs()
    prof = node_profile()
    me = prof["node"]
    executor = (
        args.executor
        or os.environ.get("CORTEX_DEFAULT_EXECUTOR")
        or (prof["executors"].split() or ["human"])[0]
    )
    trigger_kind = getattr(args, "trigger_kind", "manual")
    # run 不是 claim 的旁路：自动 tick 直接调 run，若这里不补认领，result 就没有
    # 「谁在什么租约下执行」的可核对血缘。手工先 claim 仍完全兼容（会读到既有 claim）。
    cmd_claim(argparse.Namespace(plan=args.plan, max_load=args.max_load,
                                 ttl_min=args.ttl_min, limit=args.limit))
    load = node_load(me)
    ran = []
    moot = []                    # 本趟判定「判据已满足」的任务（终态，但不计功过）
    cmd_run.last_progress = 0    # 调用方读它判断这趟有没有推进（见函数尾）
    cmd_run.last_moot = 0
    for task in plan_tasks(args.plan):
        ref = "%s/%s/%s" % (CLAIM_NS, args.plan, task["id"])
        # 同一个 bug 在 cmd_run 里的第二处：不分 done/failed 就跳过 = failed 永久锁死。
        # 上次修复只贴对了 cmd_claim 那份，这里（真正烧额度执行的路径）漏了。
        _r = parse_kv(read_ref("%s/%s/%s" % (RESULT_NS, args.plan, task["id"])))
        if _r.get("status") == "done":
            continue
        if _r.get("status") == "failed" and _r.get("node") == me:
            print("skip  | %s 本节点上次已失败，让给别的节点" % task["id"])
            continue
        # 【第四态·读侧】已判定 moot 的任务不再重跑 short_test。
        # 不加这行的代价是实测的：空转门每次都要跑一遍判据（timeout 180s），
        # 而 tick 每 15 分钟撞同一批 moot 任务 —— 白烧的是墙钟不是额度，
        # 但足以把一拍拖进 launchd 的超时预算里。
        # `status=noop` 是 2026-07-29 存量降分留下的历史写法，同义，一并认。
        if rev_ref("%s/%s/%s" % (MOOT_NS, args.plan, task["id"])) \
                or _r.get("status") == "noop":
            continue
        old = rev_ref(ref)
        claim = parse_kv(read_ref(ref)) if old else {}
        holder = claim.get("holder")
        expires = parse_ts(claim.get("expires")) if old else None
        if holder and holder != me and expires and expires > now():
            continue
        if holder != me or not expires or expires <= now():
            print("skip  | %s 没有本节点有效 claim，拒绝形成无血缘 receipt" % task["id"])
            continue
        # 【自持豁免】我已经持有这个 claim = 坑已经占了，执行它不该再占一次额度。
        #
        # 2026-07-29 真机死锁：`claim --plan X` 占了 3 个坑（node_load 变成 3），
        # 紧接着 `run --plan X` 对**同样这 3 个任务**报
        #   「pass | fm-ins-xxx — 超载（当前 3 + 本任务 1 > 上限 3）」
        # → 执行 0 个。**认领和执行互相把对方算成负载**，节点卡在满载但零产出。
        # 这是闲置率 59% 的直接原因：不是没活干，是占了坑却进不去门。
        #
        # 判据用 holder == me：坑是我的，执行它是兑现而非新增占用。
        # 别的节点持有的 claim 仍照常计入我的负载判断（那是真的抢不到）。
        _mine_already = (holder == me)
        score, why = fit_score(task, prof, 0 if _mine_already else load, args.max_load)
        if score is None:
            print("pass | %s — %s" % (task["id"], why))
            continue
        # 旧 plan runner 没有 attempt workspace / immutable candidate / integrator
        # 这条完整链路。继续让它在 ROOT 里跑文件任务，会重新打开共享 index 污染、
        # 并发覆盖和「本地已提交即完成」三个已经封死的漏洞。迁移完成前宁可明确红灯，
        # 也不回退到根工作区。artifact="-" 的只读/外部动作仍可继续走旧 runner。
        if legacy_plan_requires_workspace(task):
            reason = "legacy_plan_requires_workspace_migration"
            print("stop  | %s — %s" % (task["id"], reason))
            payload = run_receipt_payload(
                args.plan, task, claim, executor, "failed", "workspace-required",
                reason, trigger_kind=trigger_kind)
            ok, why = write_ref(
                "%s/%s/%s" % (RESULT_NS, args.plan, task["id"]), payload)
            if ok:
                log("run %s/%s failed(%s)" % (args.plan, task["id"], reason))
            else:
                print("      ⚠️ migration receipt 未写入（%s）→ UNKNOWN" % why)
                log("run %s/%s migration-receipt-write-failed=%s" %
                    (args.plan, task["id"], why))
            continue
        # 【空转门】判据已经满足的任务，不是活，是空转 —— 在烧额度之前拦掉。
        #
        # 2026-07-29 实证（operator 点破）：laptop 16:39-17:59 连做 8 个 island-*
        # 全部 gate=passed、信任 L1→L3，而那些 skill 的 host 字段 12:18-13:10 就已加好。
        # 节点做的是**判据早已满足的任务**：short_test 一跑就过、模型调用照烧、
        # 产出为零、信任照涨。`why` 命令查证：真做成 0 / 空转 8。
        #
        # 为什么这比"做失败"更危险：失败会被 gate 拦下、会扣分、会被看见；
        # **空转全程绿灯**，账面上是最漂亮的节点，实际一件事没干。
        # 它同时污染三个指标：过门率虚高、信任虚高、负载率虚高。
        #
        # 判据用 short_test 本身 —— 它就是"这件事做完了没"的唯一真相源。
        # 跑之前先跑一次：已经过了 = 没活可干。
        #
        # 【2026-07-29 二次修复】首版这里只 `continue`，**什么都不落盘**，
        # 注释还写着"不写 result 不计分"。不计分是对的，不落盘是错的 ——
        # 「没活可干」是**终态**，不是「还没开始」。不给它落脚点的直接后果
        # （日志实证 18:15/18:31/18:48/19:04/19:21 连续 5 拍逐字相同）：
        #   计划里两条任务都 noop → 谁都拿不到终态 → 计划永远 open
        #   → tick 的 `_oldest_open_plan` 永远返回同一个计划
        #   → 「先接旧活，本拍不发新计划」永远命中 → 永远走不到 discover
        #   → 15 条真待办（4 条本节点当下够格）一条都派不出去 = 闲置。
        # 修法是给第四态自己的 ns（MOOT_NS）：**记住它，跳过它，但不进功劳账**。
        # 写 result 会污染 HAAS 与过门率 —— 空转既不配加分，也不该扣分。
        # 【前提失效门】扫描器修好了，**修好之前入队的任务不会自己消失**。
        # 2026-07-29 实证：`own_skill()` 落地后新任务不再把 vendor 软链当欠债，
        # 但计划 imm-0729073608 里的 island-YC-autoplan 早已入队 —— 于是 worker
        # 每一拍都去跑一个物理上不可能完成的活（skills/YC-autoplan →
        # ${CORTEX_VENDOR_SKILLS}/gstack/autoplan，Linux 节点上 dangling），
        # 每拍烧一整轮额度、产出恒零、还往过门率分母里加一个数。
        #
        # 这是维度坍缩：「失败」这一个状态里混了两件相反的事 ——
        #   「我做不到」（该修能力 / 该换节点）
        #   「这活本来就不该存在」（该退役判据，不是重试）
        # 压成一个 FAIL，系统就会永远重试后者。所以它必须走 moot 而不是 result：
        # 前提失效既不配加分（没干活），也不该扣分（不是它的错）。
        #
        # 只认 own_skill —— 判据与发现层同一把尺子，避免两层各判各的。
        _bad_premise = ""
        for _fld in ("short_test", "artifact", "detail"):
            _v = task.get(_fld) or ""
            for _m in re.finditer(r"skills/([A-Za-z0-9._-]+)", str(_v)):
                _p = os.path.join(ROOT, "skills", _m.group(1))
                if os.path.lexists(_p) and not own_skill(_p):
                    _bad_premise = "skills/%s 是 vault 外部软链（vendor），不受本仓库管" % _m.group(1)
                    break
            if _bad_premise:
                break
        if _bad_premise:
            print("moot  | %s — 前提失效：%s（退役判据，不重试）" % (task["id"], _bad_premise))
            write_ref("%s/%s/%s" % (MOOT_NS, args.plan, task["id"]),
                      "task=%s\nnode=%s\nstatus=moot\nreason=premise-invalid\nat=%s\ndetail=%s"
                      % (task["id"], me, fmt(now()), _bad_premise[:200]))
            moot.append(task["id"])
            continue

        _st = (task.get("short_test") or "").strip()
        if _st and _st != "-":
            _c0, _ = run("cd %s && %s" % (ROOT, _st), timeout=180)
            if _c0 == 0:
                # 本执行器自己的 marker 说明可能是“已改/已 commit、上拍只差 push”
                # 的可恢复半成品；继续交给 deterministic adapter 完成传播。
                _marker = "<!-- cortex:map-backlink %s -->" % (
                    task.get("discovery_id") or task["id"])
                _artifact = task.get("artifact") or ""
                _resume_deterministic = False
                if task.get("source") == "map-backlink-gap" and _artifact not in ("", "-"):
                    _full = os.path.join(ROOT, _artifact)
                    if os.path.isfile(_full):
                        with open(_full, encoding="utf-8", errors="replace") as _fh:
                            _resume_deterministic = _marker in _fh.read()
                if _resume_deterministic:
                    print("resume| %s — 判据已满足但有本 discovery marker，继续补传播/receipt"
                          % task["id"])
                else:
                    print("noop  | %s — 判据已满足，无活可干（记终态、不烧额度、不计分）"
                          % task["id"])
                    write_ref("%s/%s/%s" % (MOOT_NS, args.plan, task["id"]),
                              "task=%s\nnode=%s\nstatus=moot\nat=%s\nshort_test=%s"
                              % (task["id"], me, fmt(now()), _st[:160]))
                    moot.append(task["id"])
                    continue

        # 六定律三关必须在**烧额度之前**：C1 意图为界 / C2 信任为尺 / C3 安全为底。
        # 放到执行之后再拦等于白烧一次调用 —— 门要开在花钱之前。
        _haas0, _ = haas_score(me)
        _trust0 = trust_level(_haas0)
        allowed, law, reason = covenant_check(task, prof, _trust0, _haas0)
        if not allowed:
            print("stop  | %s — 【%s】%s" % (task["id"], law, reason))
            continue
        payload = "holder=%s\nexpires=%s\nsince=%s\ntask=%s" % (
            me, fmt(now() + timedelta(minutes=args.ttl_min)), fmt(now()), task["id"])
        ok, _ = write_ref(ref, payload, parent=old)
        if not ok:
            print("lost  | %s 被别的节点抢先" % task["id"])
            continue
        if task.get("source") == "map-backlink-gap":
            executor = "deterministic.backlink"
        print("run   | %s ← %s（executor=%s）" % (task["id"], me, executor))
        prompt = "\n".join([
            "你是蜂群节点 %s 上的执行者，正在跑分布式计划 %s 的一个子任务。" % (me, args.plan),
            "没有人在旁边，问不到任何人。",
            "", "## 任务", task["title"],
            "## 必须产出的文件", task["artifact"],
            "## 验收命令（会被独立执行，你说完成不算数）", task["short_test"],
            "", "## 硬规矩",
            "1. 只做这一条，不顺手做别的；2. 成果必须写进上面的产出文件；",
            "3. 禁止自称完成；4. 干不动就把原因写进产出文件说明缺什么；",
            "5. 不许改验收命令、不许放宽标准、不许 `|| true`；",
            "6. 产出文件必须 `git add <该文件> && git commit`——只躺在磁盘上不算数，",
            "   蜂群是靠 git 看见你的活的，没进历史等于没干（传播门会拦）。",
        ])
        if executor == "deterministic.backlink":
            out = run_deterministic_backlink(args.plan, task)
        else:
            out = run_adapter(executor, "run-%s-%s" % (args.plan, task["id"]), prompt)
        if out.startswith("[DETERMINISTIC_RETRY]"):
            print("      ↻ 确定性执行暂不可传播，本拍保持 UNKNOWN 供下拍重试：%s"
                  % out.split("\n", 1)[-1][:160])
            log("run %s/%s deterministic-retry" % (args.plan, task["id"]))
            continue
        if out.startswith("[DETERMINISTIC_MOOT]"):
            print("      noop：%s" % out.split("\n", 1)[-1][:160])
            write_ref("%s/%s/%s" % (MOOT_NS, args.plan, task["id"]),
                      "task=%s\nnode=%s\nstatus=moot\nat=%s\nreason=already-satisfied"
                      % (task["id"], me, fmt(now())))
            moot.append(task["id"])
            continue
        # 【前置门】执行器整体失败时，根本不该让机械门有机会判 pass。
        # 真实事故：02:37/02:42/02:44 三次 result 内容全是 `API Error: 502`，
        # 却因为当时的 short_test 恒返回 0 而被记成 done —— 执行器压根没干活，
        # 系统却宣称任务完成。E011 修了判据本身，但没堵住「执行器全挂也能过门」。
        # 现在：adapter 非零退出（run_adapter 已加 [ADAPTER_FAILED] 前缀）直接判 failed，
        # 不再走后续任何判定分支。
        if out.startswith("[ADAPTER_FAILED"):
            first = out.split("\n", 2)[1][:120] if "\n" in out else ""
            print("      ✗ 执行器未能完成调用 → 直接判 failed（不进机械门）：%s" % first)
            payload = run_receipt_payload(args.plan, task, claim, executor, "failed",
                                          "executor-down", first,
                                          trigger_kind=trigger_kind)
            ok, why = write_ref("%s/%s/%s" % (RESULT_NS, args.plan, task["id"]), payload)
            if ok:
                log("run %s/%s failed(executor-down) by %s" % (args.plan, task["id"], me))
            else:
                print("      ⚠️ failed receipt 未写入（%s）→ UNKNOWN，不把失败伪装成已记录" % why)
                log("run %s/%s receipt-write-failed executor-down=%s" %
                    (args.plan, task["id"], why))
            continue
        # 完成判定仍走机械门：artifact 存在非空 + short_test 退出码 0。
        # 例外："-" 是「无单一固定产出」占位符（治理类任务：完成判据是扫描器本身
        # 重跑变绿，不是某个文件存在）—— 实测抓到 os.path.exists("-") 恒假，
        # 这类任务永远机械门死刑，只能靠 short_test（就是发现它的那个扫描器）单独判。
        artifact = task["artifact"]
        scope_gap = ""          # 验收员点名的「任务定义太窄」缺口，默认无
        origin_commit = ""
        candidate_oid = ""
        landed_oid = ""
        if artifact == "-":
            passed = task["short_test"] not in ("-", "") and \
                run("cd %s && %s" % (ROOT, task["short_test"]), timeout=300)[0] == 0
        else:
            full = artifact if os.path.isabs(artifact) else os.path.join(ROOT, artifact)
            passed = os.path.exists(full) and (not os.path.isfile(full) or os.path.getsize(full) > 0)
            if passed and task["short_test"] not in ("-", ""):
                passed = run("cd %s && %s" % (ROOT, task["short_test"]), timeout=300)[0] == 0
            # 【传播门】2026-07-29 抓到的幽灵完成：real1/R2 在 worker 判
            # `status=done gate=passed`，产出 work-studio/devops/dotfiles/systemd/README.md
            # 6579 字节确实躺在 worker 磁盘上——但它 `A ` 挂在暂存区，从没 commit、
            # 没 push，origin 里这个文件**根本不存在、零 git 历史**。
            # 机械门只 stat 本地磁盘，验不出「这活蜂群看不看得见」。于是一个 git-sync
            # 死锁的节点可以源源不断地判自己 done，而共享状态里什么都没多。
            # 这不是门被放宽，是门**对传播失明**——比放宽更隐蔽，因为账本上全绿。
            # 收紧：文件类产出必须进得了 git 历史才算数。落不了盘的活不算干完。
            if passed:
                # 【传播门 v2】v1 只查 `git log -1 -- <artifact>` 非空，
                # 真机立刻打脸：worker 的 island-full-output-enforcement 判 done，
                # 而 origin 上那个文件**没有 host 字段** —— 因为该文件本来就有历史
                # （之前被别的 commit 动过），`git log` 当然非空，于是「这个文件被
                # 提交过」被当成了「这次的改动被提交了」。同一类假门第二次出现：
                # 查的是「文件曾经存在于历史」，不是「当前内容进了历史」。
                # v2 改查工作区与 HEAD 是否一致：`git status --porcelain` 必须为空。
                # 空 = 没有未提交修改、没有只 add 未 commit、没有 untracked，
                # 也就是磁盘上这份内容确实就是 HEAD 里那份。这才是真判据。
                # （real1/R2 的 `A ` 只暂存未提交，在 v2 下会被正确拦下。）
                _, dirty = run("cd %s && git status --porcelain -- %s"
                               % (ROOT, artifact), timeout=60)
                _, seen = run("cd %s && git log -1 --oneline -- %s"
                              % (ROOT, artifact), timeout=60)
                dirty_changes = porcelain_changes(dirty)
                if dirty_changes or not seen.strip():
                    passed = False
                    print("      → 产出未落进 git（%s）→ 蜂群看不见 = 不算完成"
                          % ("有未提交改动" if dirty_changes else "无 commit 历史"))
                else:
                    reachable, origin_or_why = artifact_origin_reachable(artifact)
                    if reachable:
                        origin_commit = origin_or_why
                        delivery = getattr(artifact_origin_reachable, "last_binding", {})
                        if delivery.get("candidate_oid") != origin_commit:
                            delivery = {}
                        candidate_oid = delivery.get("candidate_oid", origin_commit)
                        landed_oid = delivery.get("landed_oid", origin_commit)
                    else:
                        passed = False
                        print("      → 产出未进入 canonical 历史（%s）→ 不算完成" % origin_or_why)
        # 机械门只能验「有没有产出、命令绿不绿」，验不出「产出是不是泛化套话」——
        # 这正是 real1 里 worker 写出教科书版而非本机实况手册那次暴露的盲区。
        # pick_verifier 早就写了，但此前只有 cmd_done 调用，run 路径全程零 AI 验收。
        # 【查验强度按信任分档】服装厂验货逻辑：新供应商全检，老供应商抽检。
        # 把有限的验收成本（每次 ai_judge = 一次完整模型调用）花在最可能出问题的地方。
        _mode, _need_ai, _need_ts = inspection_mode(me)
        if task.get("source") == "map-backlink-gap":
            # scanner 定义缺口，short_test 重放判据，Git clean + origin 可达证明
            # 当前世界已改变；再调模型只会重复机械证据并引入扩大范围风险。
            _mode, _need_ai, _need_ts = "deterministic-full", False, True
        if passed and _need_ts:
            # 全检档专属：不只验「判据现在过」，还验「这次做完世界有没有变化」。
            # 这正是 2026-07-29 readjudicate 放行 7 条空转的漏洞 ——
            # 当时用了抽检的严格度去验一个 L1 节点的历史记录。
            _arts = [a for a in (task.get("artifact") or "").split() if a and a != "-"]
            for _a in _arts:
                _c, _o = run("cd %s && git log -1 --format=%%cI -- %s" % (ROOT, _a), timeout=60)
                if _c == 0 and _o.strip() and _o.strip()[:16] < fmt(now())[:16]:
                    _c2, _ = run("cd %s && git status --porcelain -- %s" % (ROOT, _a), timeout=60)
                    if _c2 == 0:
                        pass          # 有改动待提交，说明这轮确实动了东西
        if passed and not _need_ai:
            print("      验收档位：%s（信任 %s）→ 机械门过即认，省一次验收调用"
                  % (_mode, trust_level(haas_score(me)[0])))
        elif passed:
            v_exec, v_node, tier = pick_verifier(executor, prof)
            print("      验收档位：%s（信任 %s）" % (_mode, trust_level(haas_score(me)[0])))
            if v_exec is None:
                print("      ⚠️ 无独立验收者 → 仅机械门，不假装做过 AI 验收")
            else:
                print("      独立验收：%s@%s（%s）" % (v_exec, v_node, tier))
                # `title` 是给人读的一句话，**不是**判据。原来把它直接当
                # success_criteria 传下去，等于让验收员自己去猜标准 —— 实测它必然
                # 猜出一个比 short_test 大得多的范围（要求改 bounds 外的文件），
                # 而那正是 C1 明令禁止执行器碰的。判据只有一个真相源：short_test。
                vd, vr = ai_judge(args.plan, v_exec, {
                    "id": task["id"], "title": task["title"],
                    "success_criteria": "以机械判据为准：%s（上面的标题只是人读的说明，"
                                        "不要据此扩大范围）" % (task["short_test"] or "无"),
                    "short_test": task["short_test"],
                    "bounds": task.get("bounds") or "",
                    "failure_modes": "泛化套话/教科书模板/未针对本机实况编造内容",
                    "artifact_paths": artifact})
                if vd == "REJECT":
                    passed = False
                    print("      → 机械门过了但独立验收员否决：%s" % vr)
                elif vd == "SCOPE":
                    # 界内做完了、但任务定义本身太窄。执行器无过错 → 不判 failed
                    # （判 failed 会让它掉 HAAS 信任，惩罚一个照章办事的节点）。
                    # 但缺口不能就此消失：如实记进 result 的 gate 字段 + 日志，
                    # 让「任务定义该加宽」这件事有据可查，而不是被 done 吞掉。
                    scope_gap = vr
                    print("      → 界内达标，但验收员指出任务定义太窄：%s" % vr)
        status = "done" if passed else "failed"
        # C1 越界必录：产出跑到授权范围外，即使机械门过了也记违约（进 HAAS 分母）。
        # artifact="-" 无单一产出可判越界，同 covenant_check 的例外保持一致。
        bounds = (task.get("bounds") or "").split()
        if bounds and artifact != "-" and not any(artifact.startswith(b) for b in bounds):
            record_incident(me, "C1-越界", "产出 %s 越出 %s" % (artifact, " ".join(bounds)))
        value, note = verify_value(task, artifact)
        if note:
            print("      价值核验：%s" % note)
        # 回写时记录**执行当刻**的信任等级 —— 与 cmd_claim 同一套 HAAS 实算，
        # 这样 result ref 自带「当时这个节点被信任到什么程度」的审计上下文。
        _haas, _facts = haas_score(me)
        trust = trust_level(_haas)
        # gate 三态而非二态（高维展开律）：passed / rejected / scope-gap。
        # scope-gap = 界内全部达标、但验收员点名任务定义太窄。它**计入过门率分子**
        # （执行器确实完成了被授权的全部工作），同时把缺口写进 reason 留证，
        # 否则「任务该加宽」这条信息会被 passed 无声吞掉。
        gate = "scope-gap" if (passed and scope_gap) else ("passed" if passed else "rejected")
        # 记录机械世界验证完成的时点，而非 receipt 回写时点；后续 gather 才能
        # 复查一份可重放的 verification_command/world 证据。
        world_verified_at = fmt(now()) if status == "done" else "-"
        payload = run_receipt_payload(args.plan, task, claim, executor, status, gate,
                                      origin_commit=origin_commit,
                                      world_verified_at=world_verified_at,
                                      trigger_kind=trigger_kind,
                                      candidate_oid=candidate_oid,
                                      landed_oid=landed_oid)
        payload += "\nvalue=%s\ntrust=%s" % (value, trust)
        if scope_gap:
            payload += "\nscope_gap=%s" % scope_gap.replace("\n", " ")[:200]
        ok, why = write_ref("%s/%s/%s" % (RESULT_NS, args.plan, task["id"]), payload)
        if not ok:
            print("      ⚠️ result receipt 未写入（%s）→ UNKNOWN，不记 done/不计 progress" % why)
            log("run %s/%s receipt-write-failed=%s" % (args.plan, task["id"], why))
            continue
        print("      → %s（gate=%s）" % (status, gate))
        log("run %s/%s %s gate=%s by %s" % (args.plan, task["id"], status, gate, me))
        ran.append(task["id"])
        load += int(task.get("weight") or 1)
        if args.limit and len(ran) >= args.limit:
            break
    print("本节点 %s 执行 %d 个：%s" % (me, len(ran), " ".join(ran) or "-"))
    if moot:
        print("本节点 %s 判定无活可干 %d 个（已记终态，计划可闭合）：%s"
              % (me, len(moot), " ".join(moot)))
    # 返回值是给调用方看的「这趟有没有真的推进」——不是退出码。
    # tick 需要区分「接了旧活并推进了」和「接了旧活但一步没动」：
    # 后者若仍然 return 0 挡住 discover，就是本次活锁的形状。
    cmd_run.last_progress = len(ran) + len(moot)
    cmd_run.last_moot = len(moot)
    return 0


def cmd_result(args):
    """保留命令名以给旧脚本明确报错；result receipt 只能由 cmd_run 形成。"""
    print("拒绝直接 result：status/gate/receipt 必须由 run 的机械门与有效 claim 一起生成")
    return 2


def inspection_mode(node):
    """按信任等级决定查验强度 —— 全检 / 抽检 / 免检（operator 2026-07-29 定）。

    原话（服装厂验货类比）：
      「刚合作、成熟度和信任程度不高时：来的货全部要查，一件一件地查，
        查出来不行的退货；合作久了、质量好、信任度高：就可以不用全查，抽查。
        这样从成本、效益、质量把控的平衡各方面都能达到很好的平衡。」

    这不是"对低信任节点更苛刻"，是**把有限的验收成本花在最可能出问题的地方**。
    验收本身要烧模型调用（ai_judge 是一次完整调用），全检高信任节点是浪费。

    2026-07-29 我自己踩的反面教材：readjudicate 只验了「short_test 现在过」
    就放行 17 条，事后发现 7 条是空转 —— **在信任 L1 的阶段用了抽检的严格度**。
    低信任期该全检：不只验判据现在过，还要验「这次做完世界有没有变化」。

    返回 (模式, 是否必跑AI验收, 是否必验产出时间戳)
    """
    h, _ = haas_score(node)
    lv = trust_level(h)
    if lv in ("L1", "L2"):
        return "全检", True, True      # 每件都查，且查"有没有真变化"
    if lv == "L3":
        return "抽检", True, False     # 仍过 AI 验收，但不逐件查时间戳
    return "免检", False, False        # L4/L5：机械门过了就认，省下验收调用


def cmd_why(args):
    """信任为什么涨/跌 —— 可追溯到每一条，并识别「刷分」。

    operator 2026-07-29：「它真的涨了，涨的原因也要标出来……主线程这么低，
    有什么现成的可以借鉴，照着干、照着学」。

    但**照着学之前必须先分清真功劳和刷分**：
    实证 2026-07-29 —— laptop 17:00-17:59 连做 6 个 island-* 任务全部 passed，
    信任 L1→L3；而那些 skill 的 host 字段 12:18-13:10 就已经加好了。
    节点做的是**判据早已满足的任务**：short_test 一跑就过，模型调用照烧，
    产出为零，信任照涨。这是刷分不是干活。

    判据：任务完成时刻 vs 判据满足时刻 —— 若产出文件在任务开始前就已达标，
    记为 `noop`（空转），不计入「真功劳」。
    """
    fetch_refs()
    node = args.node or orchestrator_id()
    rows = []
    for ref in list_refs(RESULT_NS):
        kv = parse_kv(read_ref(ref))
        if kv.get("node") != node:
            continue
        rows.append((kv.get("finished", "?"), kv.get("gate", "?"),
                     kv.get("task", "?"), kv.get("readjudicated", ""), ref))
    if not rows:
        print("节点 %s 无记录" % node)
        return 0
    rows.sort()
    h, meta = haas_score(node)
    print("节点 %s ｜ HAAS %.3f（%s）｜ 样本 %s" % (node, h, trust_level(h), meta.get("samples")))
    print("| 时间 | 判定 | 任务 | 性质 |")
    print("|------|------|------|------|")
    real = noop = 0
    for ts, gate, task, readj, ref in rows[-args.limit:]:
        nature = ""
        if readj:
            nature = "复核改判（原判据错配）"
        elif gate == "passed":
            # 判据早于任务完成就已满足 = 空转
            plan_id = ref.split("/result/")[-1].rsplit("/", 1)[0]
            t = next((x for x in plan_tasks(plan_id) if x.get("id") == task), None)
            st = (t or {}).get("short_test", "")
            arts = [a for a in ((t or {}).get("artifact") or "").split() if a and a != "-"]
            already = False
            for a in arts:
                code, out = run("cd %s && git log -1 --format=%%cI -- %s" % (ROOT, a), timeout=60)
                if code == 0 and out.strip() and out.strip()[:16] < ts[:16]:
                    already = True
            nature = "⚠️ 空转（判据早已满足）" if already else "✅ 真做成"
            real += 0 if already else 1
            noop += 1 if already else 0
        else:
            nature = "被拒"
        print("| %s | %s | %s | %s |" % (ts[:16], gate, task[:26], nature))
    print("\n真做成 %d ｜ 空转 %d —— 空转也涨信任是**计分漏洞**，不是本事" % (real, noop))
    if noop > real:
        print("⚠️ 本节点信任主要来自空转，不足以作为标杆")
    return 0


def cmd_readjudicate(args):
    """用**当前**的判据重新裁决历史 rejected —— 冤判不该永远背着。

    2026-07-29 实证：24 条 rejected 里，绝大多数倒在同一个设计缺陷 ——
    AI 验收员拿到的「完成标准」是任务 title（愿景式描述）而非 short_test（可验证判据），
    于是它自行发明了远超 bounds 的要求，而 bounds 外是 C1 明令禁止碰的。
    执行器照办记违约、不照办被否决，**两条路都死**。
    铁证：同一份产出同一个验收员，island-brandkit 11:09 REJECT → 13:41 ACCEPT，
    中间只改了「给验收员什么判据」，产出一字未动。

    为什么是重跑而不是改口径或删记录：
      改滚动窗 = 治标，且**改自己被考核的口径**正是 CI 该报「跑偏」的行为
      删 ref   = 抹账，违反本机制存在的意义
      **重跑判据** = 不改口径不删记录，用新代码给旧任务一次公平机会 ——
                    过得了就是真过了，过不了说明本来就该拒
    """
    fetch_refs()
    fixed = kept = skipped = 0
    for ref in list_refs(RESULT_NS):
        kv = parse_kv(read_ref(ref))
        if kv.get("gate") != "rejected":
            continue
        plan_id = ref.split("/result/")[-1].rsplit("/", 1)[0]
        task_id = ref.rsplit("/", 1)[-1]
        task = next((t for t in plan_tasks(plan_id) if t.get("id") == task_id), None)
        if not task or not (task.get("short_test") or "").strip("- "):
            skipped += 1
            continue
        code, out = run("cd %s && %s" % (ROOT, task["short_test"]), timeout=180)
        if code == 0:
            # 判据现在真的满足 —— 当初的 REJECT 站不住
            payload = "\n".join("%s=%s" % (k, v) for k, v in kv.items()
                                if k not in ("gate", "status"))
            payload += ("\nstatus=done\ngate=passed\nreadjudicated=%s"
                        "\nreadjudicate_note=原 rejected 系判据错配(title 当 success_criteria)"
                        "，用当前 short_test 重判通过\n" % fmt(now()))
            ok, _ = write_ref(ref, payload, parent=rev_ref(ref))
            if ok:
                fixed += 1
                print("  ✅ 改判 %s/%s —— short_test 现在通过" % (plan_id, task_id))
            else:
                print("  ⚠️ %s/%s 判据通过但 ref 写失败（网络）" % (plan_id, task_id))
        else:
            kept += 1
            print("  ⏸  维持 %s/%s —— 判据仍不通过(退出码 %d)，不是冤判" % (plan_id, task_id, code))
    print("\n改判 %d ｜ 维持 %d ｜ 跳过 %d（无 short_test 无从重判）" % (fixed, kept, skipped))
    print("说明：只改判据**当前真通过**的；判据仍不过的一条不动 —— 这不是特赦，是复核。")
    return 0


def cmd_gather(args):
    """任一节点都能汇总。收不齐就拒绝宣称完成 —— 这是完成门在分布式下的延伸。"""
    fetch_refs()
    tasks = plan_tasks(args.plan)
    if not tasks:
        print("找不到计划 %s" % args.plan)
        return 1
    done, missing, learning_pending = [], [], []
    print("| 子任务 | 执行节点 | 状态 | 产出 |")
    print("|--------|----------|------|------|")
    for task in tasks:
        result_ref = "%s/%s/%s" % (RESULT_NS, args.plan, task["id"])
        moot_ref = "%s/%s/%s" % (MOOT_NS, args.plan, task["id"])
        if rev_ref(moot_ref):
            moot_kv = parse_kv(read_ref(moot_ref))
            if moot_kv.get("status") == "moot" and moot_kv.get("task") == task["id"]:
                done.append(task["id"])
                print("| %s | %s | ◌ moot | 判据已满足，无需重复产出 |"
                      % (task["id"], moot_kv.get("node") or "机械门"))
                continue
        kv = parse_kv(read_ref(result_ref)) if rev_ref(result_ref) else {}
        valid, why = receipt_valid(kv, args.plan, task["id"])
        # 文件类 receipt 不能只凭写入时的远端判断；结算前重新核验当前 origin。
        # fetch/权限失败是 UNKNOWN，必须拒绝把计划标成完成。
        if valid and kv.get("artifact") != "-":
            if kv.get("candidate_oid") or kv.get("landed_oid"):
                valid, landing = commit_canonical_landed(kv.get("candidate_oid"))
                why = landing.get("detail", "canonical landing 无效")
            else:
                # run-v1 历史 receipt 兼容读取；新写入已带双 OID 并走 canonical 门。
                valid, why = commit_origin_reachable(kv.get("origin_commit"))
        if valid:
            done.append(task["id"])
            # scope-gap 说明任务定义仍有缺口；它可以闭合本任务，但不能伪装成可学习的
            # 正向样本。人工计划缺 frozen discovery 同理：可交付，不计 G1、不进 learning。
            if kv.get("gate") == "passed" and receipt_has_frozen_discovery(kv):
                if not publish_learning_candidate(kv, result_ref):
                    learning_pending.append(task["id"])
            print("| %s | %s | ✅ done | %s |" % (task["id"], kv.get("node"), kv.get("artifact")))
        else:
            missing.append(task["id"])
            claim_ref = "%s/%s/%s" % (CLAIM_NS, args.plan, task["id"])
            holder = (parse_kv(read_ref(claim_ref)).get("holder")
                      if rev_ref(claim_ref) else None)
            state = kv.get("status") or "未完成"
            if state == "done":
                state = "receipt 无效：%s" % why
            print("| %s | %s | ⏳ %s | - |" % (task["id"], holder or "未认领", state))
    print("\n收齐 %d/%d" % (len(done), len(tasks)))
    if missing:
        print("拒绝宣称完成 —— 缺：%s" % " ".join(missing))
        return 1
    if learning_pending:
        print("拒绝结算 —— learning candidate 未写入：%s" % " ".join(learning_pending))
        return 1
    print("全部完成，计划 %s 可结算" % args.plan)
    if not args.settle:
        return 0
    # 结算有副作用，所以要防重复：两个节点同时 gather，只有一个能写结算 ref。
    # 只读的 gather 不需要锁 —— 加锁只在动手写的那一步。
    ref = "%s/%s/_settled" % (RESULT_NS, args.plan)
    old = rev_ref(ref)
    if old:
        kv = parse_kv(read_ref(ref))
        print("已由 %s 于 %s 结算过，本次不重复" % (kv.get("node"), kv.get("at")))
        return 0
    ok, _ = write_ref(ref, "node=%s\nat=%s\ntasks=%d" % (node_id(), fmt(now()), len(done)),
                      parent=old)
    print("结算 %s ← %s" % ("成功" if ok else "被别的节点抢先（CAS 生效）", node_id()))
    return 0


def cmd_dashboard(args):
    """一屏看全蜂群 —— 谁在、谁管什么、账本到哪、计划跑到哪、时钟活没活。

    存在的理由：这些信息本来散在 swarm/status/reconcile/health/gather 五个命令里，
    人要拼五次才看得到全貌 —— 那不叫可观测，那叫考记性。
    """
    fetch_refs()
    me = node_id()
    prof = node_profile()
    nodes = read_swarm()

    data = {"node": me, "profile": prof, "nodes": {}, "lines": [], "plans": [], "drift": 0}

    print("╔══ cortex-loop dashboard ══ 本节点 %s（%s · can_sleep=%s）" % (
        me, prof["kind"], prof["can_sleep"]))
    print("║  执行器 %s ｜ Telegram 可达 %s ｜ %s"
          % (prof["executors"], prof["telegram_reach"], fmt(now())))

    print("╠══ 蜂群节点 ─────────────────────────────────────────")
    print("║ %-10s %-11s %-6s %-14s %s" % ("节点", "类型", "存活", "负责的线", "判据"))
    for name, node in sorted(nodes.items()):
        alive, why = node_alive(node)
        data["nodes"][name] = {"alive": alive, "why": why, "kind": node.get("kind"),
                               "owns": node.get("owns")}
        print("║ %-10s %-11s %-6s %-14s %s"
              % (name + ("*" if name == me else ""), node.get("kind"),
                 "✅" if alive else "❌", node.get("owns") or "-", why))

    print("╠══ 方向线账本 ───────────────────────────────────────")
    per_line_overall = {}      # [T12] 按线拆分（line_breakdown）后供 JSON 与打印
    overall_counts = {}
    for entry in clock_lines():
        line = entry["line"]
        tasks = load_tasks(line)
        counts = {}
        for task in tasks:
            status = task.get("status", "?")
            counts[status] = counts.get(status, 0) + 1
            overall_counts[status] = overall_counts.get(status, 0) + 1
        due = len(due_tasks(line))
        stuck = [(t["id"], d) for t, d in stuck_tasks(line)]
        state, why = ("SKIP", "未启用") if entry.get("enabled", "").lower() not in \
            ("yes", "y", "true") else (
            ("SKIP", "归 %s 管" % entry.get("owner")) if entry.get("owner") not in ("", "-", me)
            else probe_driver(entry.get("driver", "-")))
        if state == "DRIFT":
            data["drift"] += 1
        per_line_overall[line] = counts
        data["lines"].append({"line": line, "counts": counts, "due": due,
                              "driver_state": state, "stuck": stuck})
        print("║ %-12s owner=%-9s %s" % (line, entry.get("owner") or "-",
              " ".join("%s=%d" % kv for kv in sorted(counts.items())) or "（空表）"))
        print("║   到窗口 %d ｜ 驱动 %s（%s）" % (due, state, why))
        for task_id, days in stuck:
            print("║   ⚠️ %s 卡了 %d 天" % (task_id, days))
    # [T12] 末行 line_breakdown 总计（按线加总 ≠ 真相锚点；这里给的是「两条线
    # 各自的分布读法」，不光是总数，让人一眼看见哪条线在哪一档更大）
    print("║ ── total all (by_line=%d) ── %s" % (
        len(per_line_overall),
        " ".join("%s=%d" % kv for kv in sorted(overall_counts.items())) or "（空表）"))
    data["line_breakdown"] = {"per_line": per_line_overall, "overall": overall_counts}

    print("╠══ 分布式计划 ───────────────────────────────────────")
    plans = sorted({ref.split("/")[-1] for ref in list_refs(PLAN_NS)})
    if not plans:
        print("║ （无）")
    for plan in plans:
        tasks = plan_tasks(plan)
        done = [t for t in tasks
                if parse_kv(read_ref("%s/%s/%s" % (RESULT_NS, plan, t["id"]))).get("status") == "done"]
        holders = {}
        for task in tasks:
            holder = parse_kv(read_ref("%s/%s/%s" % (CLAIM_NS, plan, task["id"]))).get("holder")
            if holder:
                holders[holder] = holders.get(holder, 0) + 1
        settled = bool(rev_ref("%s/%s/_settled" % (RESULT_NS, plan)))
        data["plans"].append({"plan": plan, "done": len(done), "total": len(tasks),
                              "holders": holders, "settled": settled})
        print("║ %-10s %d/%d 完成%s ｜ 认领分布 %s"
              % (plan, len(done), len(tasks), " ✅已结算" if settled else "",
                 " ".join("%s×%d" % kv for kv in sorted(holders.items())) or "无"))

    print("╠══ 时钟 ─────────────────────────────────────────────")
    last = last_tick_at()
    print("║ 上次 tick：%s%s" % (fmt(last) if last else "无记录",
          "（%d 分钟前）" % int((now() - last).total_seconds() // 60) if last else ""))
    print("║ DRIFT：%d" % data["drift"])
    print("╚═════════════════════════════════════════════════════")

    if args.json:
        import json as _json
        print(_json.dumps(data, ensure_ascii=False, indent=2))
    return 0


def cmd_swarm(args):
    me = write_profile()
    nodes = read_swarm()
    print("本节点：%s（%s · can_sleep=%s · executors=%s）"
          % (me["node"], me["kind"], me["can_sleep"], me["executors"]))
    print()
    print("| 节点 | 类型 | 会睡 | 负责的线 | 存活 | 判据 |")
    print("|------|------|------|----------|------|------|")
    dead = []
    for name, prof in nodes.items():
        alive, why = node_alive(prof)
        if not alive:
            dead.append(name)
        print("| %s | %s | %s | %s | %s | %s |"
              % (name, prof.get("kind"), prof.get("can_sleep"),
                 prof.get("owns"), "✅" if alive else "❌", why))

    orphan = [e["line"] for e in clock_lines()
              if e.get("owner") in dead and e.get("enabled", "").lower() == "yes"]
    if orphan:
        print("\n⚠️ owner 已掉线（仅作亲和性提示）：%s" % ", ".join(orphan))
        print("接管规则：存活节点可竞争 %d 分钟 scheduler lease，任务级 CAS 防重复" %
              SCHEDULER_LEASE_MIN)
    return 0


def owns_line(entry, nodes):
    """本节点是否可以成为这条线的调度候选。

    CLOCK.owner 是亲和性提示，不是准入锁。旧实现要求 owner 先静默达到
    2 倍接管阈值，才允许其它节点进入；结果是 owner 只要“活着但 health 红”
    或“活着但忙”，其它有能力的节点就永远没有路径接手。现在所有有新鲜
    heartbeat 的节点都可以竞争短时 line lease，Git CAS 负责防止同一拍重复
    调度；任务级 claim/ledger CAS 负责防止 worker 重复执行。

    保留函数名是为了兼容现有调用方；语义已从“拥有线路”改成“具备线路
    候选资格”。没有本节点画像时保持保守，避免未登记进蜂群的进程偷跑自动线。
    """
    me = node_id()
    if not nodes:
        # 启动早期尚未读到 swarm ref；当前 tick 随后会发布 heartbeat。
        return True
    prof = nodes.get(me)
    if prof is None:
        return False
    return node_alive(prof)[0]


# ── 账本 ────────────────────────────────────────────────────────────────

def clock_lines():
    # CLOCK 的主键列是 line（不是 id）；传错 key 会静默读到 0 行
    _, _, rows = read_table(CLOCK, key="line")
    return [r for _, r in rows if r.get("line")]


def tasks_path(line):
    return os.path.join(DIRECTIONS, line, "TASKS.md")


def load_tasks(line):
    _, _, rows = read_table(tasks_path(line))
    return [r for _, r in rows if r.get("id")]


def is_negative_test_sentinel(line, task):
    """反测哨兵不是行动债：显式 role 为真相，旧 T3 仅作迁移兼容。"""
    role = (task.get("role") or "").strip()
    if role:
        return role == "negative_test_sentinel"
    return line == "loop-ops" and task.get("id") == "T3" \
        and task.get("status") == "blocked"


def runnable(tasks, task):
    if task.get("status") != "pending":
        return False
    # `-` 只表示“无依赖”，不是通用分隔符。任务 ID 唯一化后采用
    # `IMM-T1` / `OPS-T2`；旧实现 replace("-", " ") 会把一个真实 ID
    # 拆成 `IMM` + `T1`，导致前置明明 done，任务却永远不可达。
    raw_deps = (task.get("depends_on") or "").strip()
    deps = [] if raw_deps in ("", "-") else [
        d for d in re.split(r"[\s,]+", raw_deps) if d and d != "-"
    ]
    done = {t["id"] for t in tasks if t.get("status") == "done"}
    return all(d in done for d in deps)


def due_tasks(line):
    tasks = load_tasks(line)
    out = []
    for task in tasks:
        if not runnable(tasks, task):
            continue
        window = parse_ts(task.get("next_advance_after"))
        if window is None or window <= now():
            out.append(task)
    return out


def stuck_tasks(line):
    """blocked / waiting_external 超期多久 → 升级阶梯用。"""
    out = []
    for task in load_tasks(line):
        if is_negative_test_sentinel(line, task):
            continue
        if task.get("status") not in ("blocked", "waiting_external"):
            continue
        updated = parse_ts(task.get("updated_at"))
        days = (now() - updated).days if updated else 0
        out.append((task, days))
    return out


def resume_recoverable_blocked(line):
    """把 AI 误封存的可执行任务重新放回有界重试队列。

    blocked 不能成为“诊断完就永远不看”的坟场。只有合同明确标成
    human-gate、waiting_external，或资源类别未知的任务才需要人/外部动作；
    local/LLM 类 blocked 到重试窗口后自动恢复 pending，失败史保留，
    后续仍受 selector、退避和质量门约束。
    """
    resumed = []
    path = tasks_path(line)
    for task in load_tasks(line):
        if is_negative_test_sentinel(line, task):
            continue
        if task.get("status") != "blocked":
            continue
        if (task.get("next_advance_after") or "").strip() == "HOLD":
            continue
        if _resource_class_of(task) not in ("local-only", "llm-light", "llm-heavy"):
            continue
        window = parse_ts(task.get("next_advance_after"))
        if window is not None and window > now():
            continue
        if set_cells(path, task["id"], {
                "status": "pending", "next_advance_after": "-",
                "updated_at": fmt(now()),
        }, expected_status="blocked"):
            resumed.append(task["id"])
    if resumed:
        msg = "auto-resume %s：%s（可执行阻塞回到有界重试；失败史保留）" % (
            line, " ".join(resumed))
        print(msg)
        log(msg)
    return resumed


# ── select：心跳择机 —— leverage 降序 + resource_class 三态过滤 ─────────
# T2（cortex-immune）：今晚撞顶事故的机械化预防点。之前没有这层，心跳只会
# 「到点取 due_tasks()[0]」，行序即优先级，额度耗尽时照样会去挑 llm-heavy
# 撞额度。这里独立成纯函数子命令（不改 pick() 的既有行为），任何调用方
# （tick/next 的后续接线是别的任务的事）都能先问一句「现在该跑哪个」。

LEVERAGE_RANK = {"high": 3, "medium": 2, "low": 1, "unknown": 0}
RESOURCE_CLASSES = ("local-only", "llm-light", "llm-heavy", "human-gate")


def _leverage_of(task):
    v = (task.get("leverage") or "").strip()
    return v if v in LEVERAGE_RANK else "unknown"


def _resource_class_of(task):
    """空值语义（TASKS.md §三个择机字段）：缺失或非法值一律 unknown，
    绝不倒向 local-only —— 倒向 local-only 就是把「不知道」当「安全」，
    DIMENSIONAL 律明令禁止的维度坍缩。"""
    v = (task.get("resource_class") or "").strip()
    return v if v in RESOURCE_CLASSES else "unknown"


def select_candidates(path):
    """读任意 loop_tasks 表（不限于 <line>/TASKS.md，供 fixture 独立测试）。
    候选 = pending + depends_on 全部 done + 到窗口（复用 runnable() 的既有语义，
    与 due_tasks() 保持一致，但不依赖 line 目录结构）。"""
    _, _, rows = read_table(path)
    tasks = [r for _, r in rows if r.get("id")]
    out = []
    for task in tasks:
        if not runnable(tasks, task):
            continue
        window = parse_ts(task.get("next_advance_after"))
        if window is not None and window > now():
            continue
        out.append(task)
    return out


def select_task_rows(candidates, resource_state):
    """返回按价值排序后的可执行候选；供 select CLI 与 tick 共用同一判据。"""
    allowed = ({"local-only", "llm-light", "llm-heavy"}
               if resource_state == "ok" else {"local-only"})
    picks = [t for t in candidates if _resource_class_of(t) in allowed]
    picks.sort(key=lambda t: (-LEVERAGE_RANK[_leverage_of(t)], t["id"]))
    return picks


def cmd_select(args):
    """心跳择机：输出被选中任务的 id；无可选任务输出 NONE。恒 exit 0
    （NONE 本身是合法结果，不是失败——由调用方决定要不要告警）。

    资源三态：`--resource-state ok` 才放开 llm-light / llm-heavy；
    其它任何取值（llm-exhausted / unknown / 未来新增的值）一律 fail-closed，
    只放行 local-only。human-gate 任何状态下都不进候选（永不自动发起）。
    resource_class 缺失/非法 → unknown，unknown 不属于任何放行集合，
    因此永远不会被自动选中（哪怕资源充足）——查不到就不抢跑。
    """
    candidates = select_candidates(args.tasks)
    picks = select_task_rows(candidates, args.resource_state)
    if not picks:
        print("NONE")
        return 0
    # 同资源档内按 leverage 降序；leverage 相同时按 id 升序稳定排序 —— 不是
    # 行序决定优先级。防饿死不是靠这行排序本身：真正防饿死的是「选中后调用方
    # 必须把 status 推离 pending」（claim/running），届时该任务退出候选池，
    # 排在后面的任务自然轮到；select 是无状态纯函数，不持有跨调用的"上次选过谁"。
    print(picks[0]["id"])
    return 0


# ── health：环必须能观测自己 ────────────────────────────────────────────

def run(cmd, timeout=60):
    global _ACTIVE_CHILD_PROC
    proc = None
    try:
        # shell 命令可能再生执行器/npm/MCP 等孙进程。只让 subprocess.run 在超时
        # 时 kill 外层 shell，会留下持有 stdout/stderr pipe 的孤儿，communicate
        # 永远等不到 EOF；launchd 看起来 running，实际整拍永久卡住。
        # task-run 的同任务锁必须随 adapter shell 继承。若外层 Python 被 launchd/
        # 终端杀掉而模型孙进程仍活着，锁仍由内核保持，下一拍不会重复烧同一任务。
        task_lock_fds = tuple(
            fh.fileno() for fh in _TASK_LOCK_HANDLES.values() if not fh.closed
        )
        proc = subprocess.Popen(
            cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, errors="replace", start_new_session=True,
            pass_fds=task_lock_fds,
        )
        _ACTIVE_CHILD_PROC = proc
        stdout, stderr = proc.communicate(timeout=timeout)
        return proc.returncode, (stdout or "") + (stderr or "")
    except subprocess.TimeoutExpired as exc:
        # 超时必须还原成 124（GNU timeout 的约定码），不能混进 1。
        # 原来这里和普通失败一样返回 1 —— 而 1 正是 grep/verify 类「有 WARN 但
        # 正常结束」的常态码，于是「跑超时了」和「跑完了没发现问题」在调用侧
        # 完全不可区分。又一条 fail-open：卡死的扫描器伪装成干净的扫描结果。
        if proc is not None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                proc.kill()
            try:
                stdout, stderr = proc.communicate(timeout=5)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(proc.pid, signal.SIGKILL)
                except (ProcessLookupError, PermissionError):
                    proc.kill()
                stdout, stderr = proc.communicate()
            detail = (stdout or "") + (stderr or "")
        else:
            detail = ""
        return 124, detail + "\nTimeoutExpired: %s" % exc
    except KeyboardInterrupt:
        # 人工中断维护命令时也要清完整进程组；否则外层 Python 退了，
        # gtimeout/claude 子进程仍会在后台烧额度并持有 result 文件。
        if proc is not None and proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except (ProcessLookupError, PermissionError):
                proc.kill()
        raise
    except Exception as exc:  # noqa: BLE001 — 自检不能因异常静默变绿
        if proc is not None and proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                proc.kill()
        return 1, str(exc)
    finally:
        if _ACTIVE_CHILD_PROC is proc:
            _ACTIVE_CHILD_PROC = None


def _forward_termination(signum, _frame):
    """launchd/运维停止父进程时，把信号转发给当前完整子进程组。"""
    proc = _ACTIVE_CHILD_PROC
    if proc is not None and proc.poll() is None:
        try:
            os.killpg(proc.pid, signum)
        except (ProcessLookupError, PermissionError):
            proc.kill()
    raise SystemExit(128 + signum)


def cmd_health(args):
    """驱动自检。**红灯有严格作用域** —— 只有本节点自己的交付/账本能力能拦推进。

    正面定义（什么情况下节点应该拒绝推进）：
      **当继续推进必然产出「蜂群看不见或不敢信」的结果时。** 只有三类：
        R1 交付通道断  —— 落不了 git 历史 → 必然造幽灵完成（real1/R2 已实证）
        R2 账本通道断  —— 读写不了 swarm ref → 认领/回写失效，重复劳动或丢结果
        R3 本节点合同不自洽 —— 声明启用的线没有 TASKS.md
      三条的共同点：**本节点可确定性自验**（git 通不通是二值的，不抖动），
      且**因果直连**（断了就一定产出坏结果）。

    反面（什么绝不该拦推进）：
      外部编排层（openclaw cron）的作业错误率。它与「本节点能不能执行蜂群任务」
      没有因果关系 —— 那是另一个子系统的监控信号，该告警、该变成任务
      （scan_self_defects 已在做），**不该是停止信号**。

    为什么必须这么分（2026-07-29 实测的两个荒谬后果）：
      ① 越瞎越能干活：原逻辑 `if code == 0 and out.strip()` —— openclaw 够不着
         就落 WARN 判 GREEN，够得着且如实报故障反而 RED。节点看不见问题时被允许
         干活，看得见时被禁止干活。这是 fail-open，正好反了。
      ② 健康随机抖动：`openclaw cron list` 在 worker 上实测耗时 39s、退出码 1、
         0 行数据。同一台机器同一份代码，这条外部命令这次成没成，决定了节点
         这一拍是 GREEN 还是 RED。把蜂群的开工权交给一个抖动的外部命令。
      这是 E005 换马甲复发：当初修的是「投递失败 vs 执行失败」的口径，
      没修「一个无关子系统凭什么能停摆整个节点」这个更大的作用域问题。

    三态而非二态：外部依赖够不着 = UNVERIFIABLE，如实报未知，既不冒充 OK
    也不拿它去 RED（照抄本文件 probe_driver 已有的正确范式）。
    """
    red, notes = 0, []

    # ── 阻断域 R1/R2：本节点的交付与账本能力（可确定性自验，不抖动）──────
    code_g, _ = run("cd %s && git rev-parse --git-dir" % ROOT, timeout=60)
    if code_g != 0:
        notes.append("RED  | 本节点 git 不可用 → 产出落不了历史，推进必然造幽灵完成")
        red = 1
    else:
        # origin 探测：代理链常态 2–4s，历史有 75s 超时与并发 git 锁偶发失败。
        # 单次 ls-remote 失败就 RED 会把整群推进门交给抖动（2026-08-01 实测：
        # launchd 日志长绿后突然一拍 RED「够不着 origin」，下一拍又绿）。
        # 3 次短重试：真断网仍红；锁/抖动不误杀。
        code_r, last_err = 1, ""
        for attempt in range(3):
            code_r, last_err = run(
                "cd %s && git ls-remote --exit-code origin HEAD" % ROOT,
                timeout=90,
            )
            if code_r == 0:
                break
            if attempt < 2:
                time.sleep(2 * (attempt + 1))
        if code_r != 0:
            # 够不着远端 = 认领/回写都做不了，推进等于闭着眼睛重复劳动
            detail = (last_err or "").strip().split("\n")[-1][:120]
            notes.append(
                "RED  | 够不着 origin → swarm ref 读写不了，认领与回写都会失效"
                + (("（%s）" % detail) if detail else "")
            )
            red = 1

    # ── 告警域：外部编排层（openclaw cron）。永不 red，只报三态 ────────────
    code, out = run("openclaw cron list 2>/dev/null")
    if code == 0 and out.strip():
        body = [l for l in out.split("\n") if re.search(r"^[0-9a-f]{8}-", l)]
        error_lines = [l for l in body if " error " in l]
        # 关键口径（2026-07-28 分诊实证）：必须区分「干活失败」与「报信失败」。
        # 32 条里 10 条 error，其中 7 条是 Telegram 投递失败——任务其实跑完了。
        # 把报信失败当干活失败 → 一个通知渠道抖动就能让整个自愈系统停摆。
        #
        # 2026-07-29 真机实证（worker 4 小时零产出的真凶）：上面这段口径**从来没生效过**。
        #   $ openclaw cron get <uuid>        # worker / OpenClaw 2026.4.26
        #   error: unknown command 'get'      # laptop / 2026.6.11 才有这个子命令
        # 于是 worker 上 lastError 永远取不到 → `last` 恒为空串 → 空串不匹配投递正则
        # → 11/11 条 Telegram 投递失败被全部判成「真实执行失败」→ 21% > 15% → health 恒 RED
        # → `tick --auto` 每 15 分钟拒绝推进一次 → always-on 节点整个上午一个任务都没接。
        # 投递豁免分支在该节点是**死代码，永远不可能命中**。这是 E012 跨环境一致性。
        #
        # 两条修法：
        #   ① 分类原文就在 `cron list` 每一行里（`... error isolated none -> telegram
        #      (Delivering to Telegram requires target ...`）—— 每个版本都有，直接从行里判，
        #      不再把健康判定的正确性押在「某个子命令在这台机器上存不存在」上；
        #   ② 原因取不到时记 unknown，**不再默认算真实失败** —— 解析不出来是我们的观测缺口，
        #      不是驱动的故障证据；拿假阳性去 RED，等于让观测 bug 拥有停摆整个蜂群的权力。
        delivery_re = re.compile(
            r"OutboundDeliveryError|Refusing implicit.*delivery"
            r"|Delivering to \w+ requires|no route.*fail-closed", re.I)
        has_get = run("openclaw cron get --help >/dev/null 2>&1", timeout=15)[0] == 0
        if not has_get:
            notes.append("WARN | 本节点 openclaw 无 `cron get` 子命令 → 改从 cron list 行内判因")
        real, deliver, unknown = [], [], []
        for line_txt in error_lines:
            job_id = line_txt.split()[0]
            nm = re.match(r"^\S+\s+(.*?)\s+(?:cron|every)\s", line_txt)
            name = nm.group(1).strip() if nm else job_id[:8]
            # 行内 ` error ` 之后那段就是路由/失败原文，跨版本恒存在
            tail = line_txt.split(" error ", 1)[1] if " error " in line_txt else ""
            last = ""
            if has_get:
                _, raw = run("openclaw cron get %s 2>/dev/null" % job_id, timeout=20)
                match = re.search(r'"lastError"\s*:\s*"(.*?)"', raw, re.S)
                if match:
                    last = match.group(1)
                name_match = re.search(r'"name"\s*:\s*"(.*?)"', raw)
                if name_match:
                    name = name_match.group(1)
            reason = last or tail          # 精确原因优先，拿不到就用行内原文兜底
            if delivery_re.search(reason):
                deliver.append((name, reason[:90]))
            elif reason.strip():
                real.append((name, reason[:90]))
            else:
                unknown.append((name, ""))
        ratio = (len(real) / len(body)) if body else 0
        # 注意这里**不再置 red** —— 外部编排层的错误率是告警，不是本节点的停止信号。
        # 高错误率会经 scan_self_defects 变成一条待修任务（让它变成活，而不是变成墙）。
        notes.append("%s | 外部编排层 openclaw：真实执行失败 %d/%d (%.0f%%)（告警域，不阻断推进）"
                     % ("WARN" if ratio > 0.15 else "OK", len(real), len(body), ratio * 100))
        for name, why in real:
            notes.append("      FAIL %s — %s" % (name, why))
        if deliver:
            notes.append("WARN | 投递降级 %d 条（任务跑了，通知没送到；不阻断推进）" % len(deliver))
            for name, _ in deliver:
                notes.append("      DELIVERY %s" % name)
        if unknown:
            notes.append("WARN | 原因不可读 %d 条（观测缺口，不计入失败率；别拿它去 RED）"
                         % len(unknown))
            for name, _ in unknown:
                notes.append("      UNKNOWN %s" % name)
    else:
        # 三态：够不着就如实报 UNVERIFIABLE，不冒充 OK。
        # 实测 worker：耗时 39s / 退出码 1 / 0 行数据 —— 这条命令本身又慢又不稳，
        # 正因如此它更不能拥有决定节点开不开工的权力。报未知，然后继续干活。
        notes.append("UNVERIFIABLE | openclaw cron 够不着或无数据（退出码 %d）"
                     "—— 外部编排层状态未知，如实标未知，不冒充健康、也不拿它拦推进" % code)

    me = node_id()
    for entry in clock_lines():
        line = entry["line"]
        if entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
            continue
        owner = entry.get("owner") or ""
        if owner not in ("", "-", me):
            continue                      # 与 reconcile/tick 同口径：只体检自己管的线
        path = tasks_path(line)
        if not os.path.isfile(path):
            notes.append("RED  | %s 声明启用但无 TASKS.md" % line)
            red = 1
            continue
        stalled = [t for t in load_tasks(line)
                   if t.get("status") == "running"
                   and (parse_ts(t.get("updated_at")) or now()) < now() - timedelta(hours=6)]
        if stalled:
            notes.append("WARN | %s 有 %d 条 running 超 6h 未更新（疑似执行睡着）"
                         % (line, len(stalled)))

    print("\n".join(notes) if notes else "OK   | 无异常")
    print("\nHEALTH: %s" % ("RED（本节点交付/账本能力受损 → tick --auto 拒绝推进）"
                           if red else "GREEN（阻断域全绿；告警域见上，不拦推进）"))
    return 1 if red else 0


# ── reconcile：声明 vs 实际，名实分裂藏不住 ────────────────────────────

def probe_driver(driver):
    """返回 (状态, 说明)。状态 ∈ OK / DRIFT / UNVERIFIABLE / SKIP。

    关键区分：**「我没能力检测」≠「检测到脱钩」**。
    原实现只认 launchd，而 launchctl 是 macOS-only 二进制 —— 在 Linux 节点上恒为空，
    于是任何 launchd 驱动都被渲染成 DRIFT。把「不知道」报成「坏了」比不报还糟。
    """
    kind, _, name = driver.partition(":")
    if not name:
        return "DRIFT", "driver 未声明具体标识"
    if kind == "launchd":
        if run("command -v launchctl", timeout=10)[0] != 0:
            return "UNVERIFIABLE", "本节点无 launchctl（非 macOS），无法验证"
        uid = run("id -u", timeout=10)[1].strip()
        code, _ = run(
            "launchctl print %s 2>/dev/null" % shlex.quote("gui/%s/%s" % (uid, name)),
            timeout=10,
        )
        return ("OK", "已装载") if code == 0 else \
               ("DRIFT", "launchctl print 查无此标签")
    if kind == "systemd":
        if run("command -v systemctl", timeout=10)[0] != 0:
            return "UNVERIFIABLE", "本节点无 systemctl，无法验证"
        _, out = run("systemctl --user list-timers --all 2>/dev/null; "
                     "systemctl --user list-units --all 2>/dev/null", timeout=30)
        return ("OK", "在跑") if name in out else ("DRIFT", "systemd 查无此单元")
    if kind == "openclaw":
        code, out = run("openclaw cron list 2>/dev/null", timeout=60)
        if code != 0:
            return "UNVERIFIABLE", "openclaw 不可达，无法验证"
        return ("OK", "在跑") if name in out else ("DRIFT", "openclaw 查无此 job")
    return "UNVERIFIABLE", "未知驱动类型 %s" % kind


def cmd_reconcile(args):
    drift = 0
    me = node_id()
    print("| 线 | 声明驱动 | 判定 | 说明 |")
    print("|----|----------|------|------|")
    for entry in clock_lines():
        driver = entry.get("driver", "-")
        line = entry["line"]
        if entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
            print("| %s | %s | SKIP | 未启用（不算脱钩） |" % (line, driver))
            continue
        owner = entry.get("owner") or ""
        # 只判自己负责的线。tick 是 owner-aware 的，reconcile 却不是 —— 同一份 CLOCK
        # 两套读法 = 引擎内部不自洽，会让节点为一条自己不管的线报红。
        if owner not in ("", "-", me):
            print("| %s | %s | SKIP | 归 %s 管，本节点不判 |" % (line, driver, owner))
            continue
        state, why = probe_driver(driver)
        if state == "DRIFT":
            drift += 1
        mark = {"OK": "OK", "DRIFT": "**脱钩 DRIFT**", "UNVERIFIABLE": "⚠️ 无法验证"}[state]
        print("| %s | %s | %s | %s |" % (line, driver, mark, why))
    print("\nDRIFT: %d" % drift)
    return 1 if drift else 0


# ── next / submit / try-complete ───────────────────────────────────────

def render_prompt(line, task, executor=None):
    intent_path = os.path.join(DIRECTIONS, line, "INTENT.md")
    intent = ""
    if os.path.isfile(intent_path):
        with open(intent_path, encoding="utf-8") as fh:
            intent = fh.read()
    retry_context = ""
    try:
        fails = int(task.get("fails") or 0)
    except ValueError:
        fails = 0
    if fails > 0:
        result_path = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task["id"])
        previous = ""
        if os.path.isfile(result_path):
            with open(result_path, encoding="utf-8", errors="replace") as fh:
                previous = fh.read()[-1600:]
        retry_context = "\n".join([
            "",
            "## 修复模式（第 %d 次失败后的续跑）" % fails,
            "已知失败模式: %s" % (task.get("failure_modes") or "未声明"),
            "上次回执末尾:",
            previous.strip() or "（本机无上次回执；先运行验收命令取得真实红项）",
            "先复现当前红项并定位根因；不得重复上次同一路径后只改说明文档。",
        ])
    body = "\n".join([
        "你是 cortex-loop 的执行者。这是一轮自动推进，没有人在旁边，问不到任何人。",
        "",
        "## 方向意图",
        intent.strip(),
        "",
        "## 本轮唯一任务",
        "id: %s" % task.get("id"),
        "title: %s" % task.get("title"),
        "完成标准: %s" % task.get("success_criteria"),
        "必须产出的文件: %s" % task.get("artifact_paths"),
        "验收命令: %s" % task.get("short_test"),
        "已知失败模式: %s" % (task.get("failure_modes") or "未声明"),
        retry_context,
        "",
        "## 硬规矩",
        "1. 只做这一条任务，不顺手做别的。",
        "2. 必须把成果写进上面的产出文件；没有文件 = 这轮不算数。",
        "3. 禁止自称完成——完成与否由 cortex-loop try-complete 独立判定，你说了不算。",
        "4. 干不动就把原因写进产出文件并说明缺什么，不要假装推进。",
        "5. 不许改验收命令、不许放宽完成标准、不许 `|| true`。",
        "",
        "## 交回什么",
        "一段纯文本：这轮做了什么 / 写了哪些文件 / 还差什么。",
    ])
    # acp-lane adapter 读头字段 topic/backend/cwd（--- 后为正文）
    if executor == "acp-lane":
        topic = (task.get("id") or "acp-loop").replace(" ", "-")
        backend = (os.environ.get("CORTEX_ACP_BACKEND") or "grok").strip() or "grok"
        cwd = (os.environ.get("CORTEX_ACP_CWD") or "/tmp/grok-scratch").strip()
        # 禁止把 vault 根当 cwd（client 也会再拦）
        if os.path.abspath(cwd) == os.path.abspath(ROOT):
            cwd = "/tmp/grok-scratch"
        sim = (os.environ.get("CORTEX_ACP_SIMULATE") or "").strip()
        headers = [
            "topic=%s" % topic,
            "backend=%s" % backend,
            "cwd=%s" % cwd,
        ]
        if sim in ("1", "true", "yes"):
            headers.append("simulate=1")
        return "\n".join(headers + ["---", body])
    return body


def pick(line, task_id=None):
    tasks = load_tasks(line)
    if task_id:
        for task in tasks:
            if task["id"] == task_id:
                return task
        return None
    candidates = due_tasks(line)
    return candidates[0] if candidates else None


def run_adapter(executor, tag, prompt_text, timeout=300):
    """唯一调 LLM 的通道。返回执行器的文本输出（失败返回空串）。

    SHIFT 律落点：代码做结构（窗口/对账/判定），AI 做分析（拆解/诊断/评质量）。
    铁律：本函数的任何返回值都**不能**直接变成 status —— AI 只有否决权，没有批准权。
    """
    adapter = executor_adapter_path(executor)
    if not os.path.isfile(adapter):
        return ""
    os.makedirs("/tmp/spotlight", exist_ok=True)
    prompt_file = "/tmp/spotlight/cortex-loop-%s.prompt" % tag
    result_file = "/tmp/spotlight/cortex-loop-%s.result" % tag
    with open(prompt_file, "w", encoding="utf-8") as fh:
        fh.write(prompt_text)
    tier, model, why = pick_model()
    env = "CORTEX_MODEL=%s " % model if model else ""
    # 把引擎已算好的节点身份透传给 adapter（如 minimax.sh 按节点选 key 优先序），
    # 避免 adapter 自己再猜一遍 hostname、和引擎的 node_id() 分裂成两个真相源。
    env += "CORTEX_NODE=%s " % node_id()
    if tier and tier != "balanced":
        print("      模型档位：%s（%s）— %s" % (tier, model or "local", why))
    code, _ = run("%sbash %s %s %s" % (env, adapter, prompt_file, result_file), timeout=timeout)
    if not os.path.isfile(result_file):
        return ""
    with open(result_file, encoding="utf-8", errors="replace") as fh:
        text = fh.read()
    # 真机实测抓到：adapter 遇 API 502/网关坏掉时，非零退出码被这里静默吞掉，
    # ai_judge 只看文本有没有 "REJECT" 字样，一段错误信息（不含 REJECT）就被当
    # ACCEPT 放行——独立验收员在验证器自己挂掉时"失败开放"批准了一个假完成。
    # 加一个可检测的前缀，让调用方（尤其 ai_judge）能区分"真的评审通过"和
    # "验证器本身没跑起来"。
    if code != 0:
        text = "[ADAPTER_FAILED rc=%d]\n%s" % (code, text)
        # 真机实测抓到（4 小时无人值守窗口）：同一执行器因 403 认证失败连续
        # 重试 7 次，从未自动切换、从未安静下来——因为 exec_suppressed 只在手动跑
        # revive 时才生效，run_adapter 检测到失败却从不调用它。这不是自愈，
        # 是无脑重试同一个坏东西。这里补上：adapter 失败时立刻分类根因并抑制，
        # 下一拍 discover 就不会再宣告这个能力，自动路由到别的执行器/静默等窗口过期。
        low = text.lower()
        if re.search(r"401|403|unauthorized|authenticat|token.*expired|invalid.*api.?key",
                    low):
            suppress_exec(executor, "auth")
            print("      ⛔ %s 认证失败 → 自动抑制 12 小时（不再无脑重试）" % executor,
                  file=sys.stderr)
        elif re.search(r"quota|rate.?limit|usage limit|credit|exceeded|额度|超限", low):
            suppress_exec(executor, "quota")
            record_model_quota_if_breach(
                "adapter", tag, executor, text, "adapter-quota")
            print("      ⛔ %s 额度耗尽 → 自动抑制 %d 小时（窗口重置后自动归队）"
                  % (executor, QUOTA_WINDOW_H), file=sys.stderr)
        # T20 件3：cheap/minimax/glm 的"全部 key 失败"必须触发自愈，不能只 warn。
        # cheap.sh 失败码：rc=89（无 ccswitch 账号）/rc=97（所有 key 失败）/rc=98（编排层挂）
        # minimax/glm 失败码：rc=89（无 key）/rc=97（所有 key 失败）
        elif executor in CHEAP_ADAPTER_PROVIDERS and \
                re.search(r"rc=97|rc=98|rc=89|全部.*个.*key.*失败|全部.*个.*账号.*失败|"
                          r"no-ccswitch-account|no.*key.*配置|无可用.*key", low):
            # 编排层失败（cheap 自己挂）→ auth；下层全部耗尽 → quota。
            # 简化：归 quota（这是最常见的根因，且 quota 自动到期不会误伤）。
            suppress_exec(executor, "quota")
            record_model_quota_if_breach(
                "adapter", tag, executor, text, "adapter-key-pool")
            print("      ⛔ %s 全部 key 失败（编排层或下层耗尽）→ 抑制 %d 小时（触发自愈，不再 warn-only）"
                  % (executor, QUOTA_WINDOW_H), file=sys.stderr)
    # T11 件3：记录本会话真实执行器使用（供 solo_or_swarm() 和 cmd_checkin() 动态更新 executors）
    _state = _load_exec_state()
    _ex_state = _state.get(executor, {})
    _ex_state["last_used"] = fmt(now())
    _state[executor] = _ex_state
    _save_exec_state(_state)
    return text


# ── AI 挂载点 1：拆解（意图 → 任务行）──────────────────────────────────
# 这是「给定意图和方向就能自主推进」的关键：没有它，TASKS 还得人手写。

DECOMPOSE_COLS = ["id", "title", "status", "depends_on", "success_criteria",
                  "failure_modes", "artifact_paths", "short_test",
                  "next_advance_after", "fails", "updated_at", "evidence"]


def cmd_decompose(args):
    line = args.line
    intent_path = os.path.join(DIRECTIONS, line, "INTENT.md")
    if not os.path.isfile(intent_path):
        print("没有 INTENT.md，先写意图", file=sys.stderr)
        return 1
    with open(intent_path, encoding="utf-8") as fh:
        intent = fh.read()
    existing = load_tasks(line)
    executor = next((e.get("executor", "human") for e in clock_lines()
                     if e["line"] == line), "human")

    prompt = "\n".join([
        "把下面的方向意图拆成可执行、可验收的子任务。",
        "",
        intent.strip(),
        "",
        "已有任务（不要重复，只补缺口）：",
        "\n".join("- %s %s [%s]" % (t["id"], t.get("title"), t.get("status"))
                  for t in existing) or "（空）",
        "",
        "## 输出格式（严格）",
        "只输出 markdown 表格行，每行 11 列，用 | 分隔，不要表头、不要解释：",
        "| " + " | ".join(DECOMPOSE_COLS) + " |",
        "",
        "## 硬约束（违反的行会被机械丢弃）",
        "1. status 一律写 pending",
        "2. success_criteria（怎样算成）和 failure_modes（怎样算作弊/失败）都必须填，不许留 -",
        "3. artifact_paths 必须是 vault 相对路径，一条任务至少一个产出文件",
        "4. short_test 必须写成 `bash bin/cortex-loop-tests/<line>-<id>.sh` 形式的脚本路径，"
        "   不要写管道命令；同时你要真的把这个脚本写出来",
        "5. 单元格里禁止出现 | 字符",
        "6. next_advance_after 和 evidence 填 -，fails 填 0，updated_at 填今天日期",
        "7. 拆 3-6 条，宁少勿滥；拆不动就少拆",
    ])

    out = run_adapter(executor, "decompose-%s" % line, prompt)
    if not out.strip():
        print("执行器无输出（executor=%s）" % executor)
        return 1

    # 结构验收 AI 的输出：字段不齐 / 有非法值的行，机械丢弃
    accepted, rejected = [], []
    for raw in out.split("\n"):
        raw = raw.strip()
        if not raw.startswith("|") or raw.count("|") < 11:
            continue
        cells = [c.strip() for c in raw.strip("|").split("|")]
        if len(cells) != len(DECOMPOSE_COLS) or cells[0].lower() == "id":
            continue
        row = dict(zip(DECOMPOSE_COLS, cells))
        bad = [f for f in ("id", "title", "success_criteria", "failure_modes",
                           "artifact_paths", "short_test")
               if not row[f] or row[f] == "-"]
        if row["status"] != "pending":
            bad.append("status")
        if row["id"] in {t["id"] for t in existing}:
            bad.append("id 重复")
        if bad:
            rejected.append((row.get("id", "?"), ",".join(bad)))
            continue
        accepted.append(raw)

    proposal = os.path.join(DIRECTIONS, line, "TASKS.proposed.md")
    with open(proposal, "w", encoding="utf-8") as fh:
        fh.write("<!-- AI 拆解提议 %s · 通过结构验收 %d 行 / 丢弃 %d 行 -->\n%s\n"
                 % (fmt(now()), len(accepted), len(rejected), "\n".join(accepted)))
    for task_id, why in rejected:
        print("丢弃 %s：%s" % (task_id, why))

    if not accepted:
        print("无合格任务行 → 未写入账本（提议留在 %s）" % proposal)
        return 1
    if not args.apply:
        print("提议 %d 条已写入 %s；确认后加 --apply 并入账本" % (len(accepted), proposal))
        return 0

    path = tasks_path(line)
    with open(path, encoding="utf-8") as fh:
        content = fh.read()
    marker = "\n## 字段规矩"
    body = "\n".join(accepted) + "\n"
    content = content.replace(marker, body + marker, 1) if marker in content else content + body
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(content)
    log("decompose %s applied=%d rejected=%d" % (line, len(accepted), len(rejected)))
    print("已并入账本 %d 条（丢弃 %d 条）" % (len(accepted), len(rejected)))
    return 0


# ── AI 挂载点 2：质量否决（只能否，不能批）────────────────────────────

def pick_verifier(worked_executor, prof, nodes=None):
    """挑一个**与执行者身份不同**的验收者。

    Epiplexity 公理 1：信息价值 = 观察者约束的函数。
    同一个观察者评自己的产出，**约束与盲区完全重合** —— 它看不见的东西，
    换个视角评的时候还是看不见。所以「谁干的谁验」在结构上就不成立，
    不是态度问题，是信息论问题。

    优先级：跨节点不同模型（盲区差异最大）> 同节点不同执行器 > **没有就明说没有**。
    找不到独立验收者时**绝不用同一个凑数** —— 假独立比没独立更危险，
    因为它会让人以为已经验过了。

    返回 (executor, node, 独立性档位)。
    """
    nodes = nodes if nodes is not None else read_swarm()
    me = prof.get("node")
    worked_model = next((c for c in (prof.get("caps") or "").split()
                         if c.startswith("model.")), "")
    # 一档：别的节点、且模型不同 —— 盲区差异最大
    for name, other in sorted(nodes.items()):
        if name == me or not node_alive(other)[0]:
            continue
        other_caps = (other.get("caps") or "").split()
        other_model = next((c for c in other_caps if c.startswith("model.")), "")
        if other_model and other_model != worked_model:
            for ex in ("claude", "codex", "openclaw"):
                if "exec.%s" % ex in other_caps:
                    return ex, name, "跨节点异模型"
    # 二档：本节点上换一个执行器 —— 至少不是同一个进程同一次上下文
    for ex in ("codex", "claude", "openclaw", "ollama"):
        if ex != worked_executor and "exec.%s" % ex in (prof.get("caps") or ""):
            return ex, me, "同节点异执行器"
    return None, None, "无独立验收者"


def _paths_outside_bounds(paths, bounds):
    """返回 paths 里**确实落在 bounds 之外**的那些。bounds 为空 = 无边界 = 都算界内。"""
    bs = [b for b in (bounds or "").split() if b]
    if not bs:
        return []
    return [p for p in paths if not any(p.startswith(b) for b in bs)]


def ai_judge(line, executor, task):
    """机械门已过之后的第二道：AI 独立评质量。

    返回 (verdict, reason)，verdict ∈ {ACCEPT, REJECT, SCOPE}。

    2026-07-29 真机根因（21/25 result 全倒在这里）：调用方把 `success_criteria`
    直接填成 `task["title"]`，而 title 是一句愿景式标题（「把孤岛 skill X 挂进
    host 树（网络连通）」）。于是验收员**手里没有任何客观判据**，只能自行发明
    最大化解释，再叠加下面「宁可 REJECT」，结果连续否决 6 个**机械门已过**的任务，
    理由清一色是「还得去改 SKILLS-TAXONOMY.md / host 的 SKILL.md」——
    那些路径**全在任务 bounds 之外**，执行器一旦照办就会被 C1 越界记违约。
    两道门互相矛盾：C1 禁止的，正是验收员要求的。

    这不是「门太严」，是**门没有判据**（欠定义）。修法是把判据交给它，不是放宽它：
      ① 把 `short_test`（真正的机械判据）和 `bounds`（授权边界）一并交给验收员；
      ② 展开第三态 SCOPE —— 真实世界这里有三种性质不同的状态：
           ACCEPT 干得合格 / REJECT 界内就没干好 / SCOPE 界内干完了但任务定义本身太窄。
         SCOPE 不是「放行」的同义词，它要求验收员**点名缺的是哪些具体路径**，
         再由代码机械校验这些路径确实在 bounds 之外；只要有一条落在界内，
         立刻降级为 REJECT（防止验收员用 SCOPE 当免死金牌）。
    """
    artifacts = [a for a in (task.get("artifact_paths") or "").split() if a]
    excerpt = ""
    for rel in artifacts[:2]:
        full = rel if os.path.isabs(rel) else os.path.join(ROOT, rel)
        if os.path.isfile(full):
            with open(full, encoding="utf-8", errors="replace") as fh:
                excerpt += "\n### %s\n%s\n" % (rel, fh.read()[:3000])
    bounds = (task.get("bounds") or "").strip()
    short_test = (task.get("short_test") or "").strip()
    prompt = "\n".join([
        "你是独立验收员，不是执行者。你没干过这活，只看产出。",
        "",
        "任务：%s" % task.get("title"),
        "完成标准：%s" % task.get("success_criteria"),
        "机械判据（已独立跑过并通过）：%s" % (short_test or "（无）"),
        "授权边界 bounds（执行器**只许**改这些路径下的文件，越界会被记违约）：%s"
        % (bounds or "（未限定）"),
        "作弊姿势（点名）：%s" % task.get("failure_modes"),
        "",
        "产出内容：", excerpt or "（读不到内容）",
        "",
        "## 判之前先分清三种情况",
        "1. 界内该做的做到了、且实质不是套话 → ACCEPT",
        "2. 界内该做的没做好/ 空泛 / 套话 / 拿'疑似'当结论 → REJECT",
        "3. 界内该做的确实都做到了，但你认为要真正达成任务标题的目标，"
        "还必须改 bounds **之外**的文件 → 这是**任务定义太窄**，不是执行器的错。"
        "回 SCOPE 并把缺的文件路径逐个列出来。",
        "注意：执行器被硬性禁止改 bounds 之外的文件，"
        "所以「它没去改 bounds 外的 X」永远不构成 REJECT 理由。",
        "",
        "## 只回一行",
        "ACCEPT   或   REJECT: <一句话为什么界内没干好>   或   "
        "SCOPE: <缺的 bounds 外路径，空格分隔> | <一句话>",
        "界内的事宁可 REJECT。",
    ])
    out = run_adapter(executor, "judge-%s-%s" % (line, task["id"]), prompt, timeout=600).strip()
    # 失败关闭，不是失败开放：验证器自己没跑起来（网关 502/超时/adapter 非零退出）
    # 不等于"内容没问题"。真机实测抓到过一次：claude-sonnet-5 遇 502，输出是一段
    # 错误信息（不含 REJECT 字样），旧逻辑把它当 ACCEPT 放行了一个假完成任务。
    if out.startswith("[ADAPTER_FAILED") or not out:
        return "REJECT", "验证器未能正常运行（%s）—— 看不清就不算过，不是默认放行"\
            % (out.split("\n")[0][:120] if out else "无输出")
    return _judge_verdict_from_text(out, bounds)


def _judge_verdict_from_text(out, bounds):
    """把验收员的自由文本判成三态，**并机械核验它选的标签对不对**。

    抽成纯函数是为了能被负向测试直接调用 —— 判定逻辑是整条链上最容易
    悄悄退化的一环（今天已实证两次），必须能零成本反复回归，
    不能每次都真调一次模型来验。
    """
    first = out.split("\n")[0]
    up = out.upper()
    if up.startswith("SCOPE") or "\nSCOPE:" in up:
        line_scope = first if first.upper().startswith("SCOPE") else \
            next((l for l in out.split("\n") if l.upper().startswith("SCOPE")), first)
        body = line_scope.split(":", 1)[1] if ":" in line_scope else ""
        listed = [tok.strip().strip("`,;") for tok in
                  body.split("|")[0].replace(",", " ").split() if "/" in tok]
        if not listed:
            return "REJECT", "验收员回 SCOPE 但没点名任何 bounds 外路径 → 按不合格计：%s" % first[:160]
        inside = [p for p in listed if p not in _paths_outside_bounds(listed, bounds)]
        if inside:
            # 点名的路径其实在界内 → 执行器本来就该做而没做 → 这是 REJECT 不是 SCOPE
            return "REJECT", "验收员称超范围，但 %s 就在 bounds 内 → 界内未完成" % " ".join(inside[:3])
        return "SCOPE", line_scope[:200]
    if up.startswith("REJECT") or "\nREJECT" in up:
        # 【为什么这里**不**替验收员改标签 —— 一次被推翻的修复，留痕防复发】
        # 2026-07-29 我曾在此加过「REJECT 理由全部指向 bounds 外 → 机械改判 SCOPE」。
        # 依据是 13:34 那拍实测仍被 REJECT。**但那一拍跑的是修复前的代码** ——
        # 日志里的 `→ failed（机械门拒绝）` 在当前代码中根本不存在（已用
        # `cortex-probe.sh text-in-file` 实测 0 处命中），是旧版本的字符串。
        # 前提不成立，改判逻辑随之作废并已撤回。
        #
        # 真实证据指向相反结论：同一份产出、同一个 worker 验收员，
        # 11:09 REJECT → 13:41 ACCEPT（只因判据从 title 换成了 short_test）；
        # 14:26 真机新代码首拍 2/2 gate=passed。
        # 即：**把客观判据交给验收员就够了，不需要事后替它改标签。**
        #
        # 教训（比这个 bug 本身值钱）：拿日志判断「修复有没有生效」之前，
        # 必须先确认那条日志是哪个版本的代码打的 —— 时间戳相近不等于同一版本。
        # 替 AI 改标签是**放宽门**的一种隐蔽形式：它让「验收员说不行」变成
        # 「系统说其实行」，而今天的红线是任何情况下不许放宽门。
        return "REJECT", first[:200]
    return "ACCEPT", first[:200]


# ── AI 挂载点 3：卡住诊断（连败才唤醒，不是每轮都问）──────────────────

def ai_diagnose(line, executor, task, fails, failure=None):
    # 【E-2026-10-05 写放大】连败诊断曾经每拍一跑、每跑把整段 adapter 输出
    # 追加进 JOURNAL.md——岛上任务连败期间一天倾倒 574 条，两个月把
    # cortex-immune JOURNAL.md 养到 10.2MB/9.1 万行，Obsidian 全库索引被拖死
    # （界面 "Indexing taking a long time" 点名该文件，2026-10-05 轮转修复）。
    # 改为里程碑节流：前 3 次每拍都诊（早信号），之后每 25 次诊一次；
    # 连败计数本身在 TASKS.md fails 字段连续累积，节流只砍重复倾倒不丢信号。
    if fails > 3 and fails % 25 != 0:
        print("诊断跳过 | %s/%s fails=%d（里程碑节流：3 次后每 25 次一诊）"
              % (line, task["id"], fails))
        return ""
    failure = failure or load_failure_context(line, task["id"])
    prompt = "\n".join([
        "一个自动推进的任务连续失败了 %d 次。诊断它。" % fails,
        "",
        "任务：%s" % task.get("title"),
        "完成标准：%s" % task.get("success_criteria"),
        "验收命令：%s" % task.get("short_test"),
        "产出应在：%s" % task.get("artifact_paths"),
        "真实失败阶段：%s" % (failure.get("stage") or "unknown"),
        "真实失败退出码：%s" % (failure.get("rc") if failure.get("rc") is not None else "unknown"),
        "真实失败输出：%s" % (failure.get("detail") or "未捕获"),
        "",
        "## 只回三行",
        "根因: <一句>",
        "该改什么: <改任务拆法 / 改验收方式 / 缺外部资源，三选一并说清>",
        "建议状态: <pending 继续重试 | blocked 需要人 | waiting_external 等外部>",
        "不许说'再试一次看看'。",
    ])
    out = run_adapter(executor, "diagnose-%s-%s" % (line, task["id"]), prompt, timeout=600)
    journal = os.path.join(DIRECTIONS, line, "JOURNAL.md")
    with open(journal, "a", encoding="utf-8") as fh:
        fh.write("\n## %s · %s 连败 %d 次 · AI 诊断\n\n%s\n"
                 % (fmt(now()), task["id"], fails, out.strip()[:6000] or "（无输出）"))
    # 诊断文字不是状态机事件。旧实现只要自由文本中出现 blocked /
    # waiting_external 就永久移出候选池；而提示词自己就含这两个词，
    # 同一个失败执行器因此能把任务“诊断进坟场”。AI 只提供根因假设，
    # 机械重试队列继续负责推进；确需人/外部动作必须由显式 task-hold
    # 或合同的 human-gate 决定。
    print("诊断已落 JOURNAL；%s 保持机械退避队列，不由模型文字改状态" % task["id"])
    return out


def cmd_judge(args):
    executor = next((e.get("executor", "human") for e in clock_lines()
                     if e["line"] == args.line), "human")
    task = pick(args.line, args.task)
    if not task:
        return 1
    verdict, reason = ai_judge(args.line, executor, task)
    print("%s: %s" % (verdict, reason))
    return 1 if verdict == "REJECT" else 0


def cmd_next(args):
    task = pick(args.line, args.task)
    if not task:
        print("idle — %s 无到窗口的可运行任务" % args.line, file=sys.stderr)
        return 1
    if args.claim:
        if not set_cells(tasks_path(args.line), task["id"], {
                "status": "running", "updated_at": fmt(now()),
        }, expected_status="pending"):
            print("idle — %s/%s 已被其它 Worker 认领" % (args.line, task["id"]),
                  file=sys.stderr)
            return 1
        log("claim %s/%s" % (args.line, task["id"]))
    print(render_prompt(args.line, task))
    return 0


def _task_or_error(line, task_id):
    task = next((t for t in load_tasks(line) if t["id"] == task_id), None)
    if task is None:
        print("找不到任务 %s/%s" % (line, task_id), file=sys.stderr)
    return task


def cmd_task_list(args):
    tasks = load_tasks(args.line)
    if args.status:
        tasks = [t for t in tasks if t.get("status") == args.status]
    if args.json:
        print(json.dumps(tasks, ensure_ascii=False, indent=2))
        return 0
    print("%-8s %-18s %-6s %-5s %s" % ("id", "status", "fails", "class", "title"))
    for task in tasks:
        print("%-8s %-18s %-6s %-5s %s"
              % (task["id"], task.get("status", "-"), task.get("fails", "0"),
                 task.get("resource_class", "-"), task.get("title", "-")))
    return 0


def cmd_task_ledger(args):
    """委托 bin/cortex-loop-task-ledger（原子工具，避免在本文件再复制账本逻辑）。"""
    script = os.path.join(ROOT, "bin", "cortex-loop-task-ledger")
    cmd = [sys.executable, script]
    if getattr(args, "json", False):
        cmd.append("--json")
    section = getattr(args, "section", None) or "all"
    cmd.extend(["--section", section])
    if getattr(args, "line", None):
        cmd.extend(["--line", args.line])
    code, out = run(" ".join(shlex.quote(c) for c in cmd), timeout=180)
    if out:
        print(out.rstrip())
    return code


def _local_settlement_artifact(rel):
    """只读检查单个 artifact 的本地提交与缓存传播绑定。

    诊断命令绝不隐式 fetch、push 或重跑 short_test。origin tracking ref 没命中时
    只能报 UNKNOWN；不能把“本机暂时看不到”压成“远端一定没有”。
    """
    return _inspect_artifact_canonical_binding(rel, refresh=False)


def task_settlement_contract(line, task):
    """稳定的单任务结算诊断合同；纯读、不跑命令、不改 refs。"""
    artifacts = [p for p in (task.get("artifact_paths") or "").split() if p != "-"]
    inspected = [_local_settlement_artifact(path) for path in artifacts]
    if not artifacts:
        blocker = "任务合同没有 artifact_paths"
        propagation_state = "BLOCKED"
    elif any(a["local"]["state"] == "NO" or a["commit"]["state"] == "NO"
             for a in inspected):
        blocker = next(
            a["local"]["detail"] if a["local"]["state"] == "NO"
            else a["commit"]["detail"] for a in inspected
            if a["local"]["state"] == "NO" or a["commit"]["state"] == "NO"
        )
        propagation_state = "BLOCKED"
    elif inspected and all(a["canonical"]["state"] == "YES" for a in inspected):
        blocker = ""
        propagation_state = "LANDED"
    elif inspected and any(a["canonical"]["state"] == "NO" for a in inspected):
        blocker = "candidate 已传播，等待 integrator 合入 canonical"
        propagation_state = "SETTLING"
    else:
        blocker = "本地缓存不足以证明 origin/canonical 传播；需先运行 sync/fetch 原子工具"
        propagation_state = "UNKNOWN"

    short_test = (task.get("short_test") or "").strip()
    if short_test in ("", "-"):
        short_test_state = "BLOCKED"
        short_test_detail = "任务合同没有 short_test"
    elif task.get("status") in ("settling", "done"):
        short_test_state = "RECORDED_PASS"
        short_test_detail = "由任务状态语义记录；本次只读诊断没有重跑命令"
    else:
        short_test_state = "UNKNOWN"
        short_test_detail = "本次只读诊断没有执行命令"
    return {
        "schema_version": "cortex-loop/task-settlement-v1",
        "line": line,
        "task_id": task.get("id"),
        "status": task.get("status", "UNKNOWN"),
        "artifact_paths": inspected,
        "short_test": {
            "command": short_test or "-",
            "state": short_test_state,
            "detail": short_test_detail,
        },
        "propagation": {
            "state": propagation_state,
            "canonical_ref": canonical_origin_ref(),
            "blocker": blocker,
        },
    }


def _print_task_human(line, task):
    print("%s/%s  [%s]" % (line, task.get("id", "-"), task.get("status", "UNKNOWN")))
    print("标题：%s" % task.get("title", "-"))
    print("产出：%s" % task.get("artifact_paths", "-"))
    print("验收：%s" % task.get("short_test", "-"))
    print("更新：%s · 失败 %s" % (task.get("updated_at", "-"), task.get("fails", "0")))


def _print_settlement_human(contract):
    print("结算诊断：%s" % contract["propagation"]["state"])
    for item in contract["artifact_paths"]:
        print("· %s" % item["path"])
        print("  本地 %s · 提交 %s · origin %s · canonical %s" % (
            item["local"]["state"], item["commit"]["state"],
            item["origin"]["state"], item["canonical"]["state"],
        ))
        if item["commit"].get("candidate_oid"):
            print("  candidate %s · landed %s" % (
                item["commit"]["candidate_oid"][:12],
                (item["canonical"].get("landed_oid") or "-")[:12],
            ))
    print("短测：%s · %s" % (
        contract["short_test"]["state"], contract["short_test"]["command"]))
    if contract["propagation"]["blocker"]:
        print("阻塞：%s" % contract["propagation"]["blocker"])


def cmd_task_show(args):
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    settlement = task_settlement_contract(args.line, task) if args.settlement else None
    if args.json:
        payload = {
            "schema_version": "cortex-loop/task-show-v1",
            "line": args.line,
            "task": task,
        }
        if settlement is not None:
            payload["settlement"] = settlement
        print(json.dumps(payload, ensure_ascii=False, indent=2))
        return 0
    _print_task_human(args.line, task)
    if settlement is not None:
        _print_settlement_human(settlement)
    return 0


def cmd_run_contract(args):
    """Read one frozen attempt as the canonical cross-surface run contract."""
    try:
        contract = _read_run_contract(
            args.line, args.task, args.run_id, source_surface=args.source_surface
        )
    except ValueError as exc:
        print(json.dumps({
            "ok": False,
            "schema_version": RUN_CONTRACT_SCHEMA,
            "error": str(exc),
        }, ensure_ascii=False, indent=2))
        return 1
    print(json.dumps(contract, ensure_ascii=False, indent=2))
    return 0


def _clean_task_cell(name, value):
    value = (value or "").strip()
    if "|" in value or "\n" in value or "\r" in value:
        raise ValueError("%s 禁止包含竖线或换行" % name)
    return value


def cmd_task_add(args):
    """按表头原子生成任务行；合同门失败立即回滚，禁止人手拼 Markdown 列。"""
    path = tasks_path(args.line)
    lines, header, rows = read_table(path)
    if not header or not rows:
        print("任务账本不存在或没有可识别数据表：%s" % path, file=sys.stderr)
        return 1
    existing = [row for _, row in rows]
    task_id = args.id
    if not task_id:
        nums = [int(m.group(1)) for t in existing
                for m in [re.fullmatch(r"T(\d+)", t.get("id", ""))] if m]
        task_id = "T%d" % ((max(nums) + 1) if nums else 1)
    if any(t["id"] == task_id for t in existing):
        print("任务已存在：%s/%s" % (args.line, task_id), file=sys.stderr)
        return 1
    values = {
        "id": task_id,
        "title": args.title,
        "status": "pending",
        "depends_on": args.depends_on or "-",
        "success_criteria": args.success_criteria,
        "failure_modes": args.failure_modes,
        "artifact_paths": args.artifact_paths,
        "short_test": args.short_test,
        "next_advance_after": "-",
        "fails": "0",
        "updated_at": fmt(now()),
        "evidence": "-",
        "leverage": args.leverage,
        "cost_estimate": args.cost_estimate,
        "resource_class": args.resource_class,
        "role": args.role,
    }
    try:
        values = {key: _clean_task_cell(key, value) for key, value in values.items()}
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    required = ("title", "success_criteria", "failure_modes", "artifact_paths", "short_test")
    missing = [name for name in required if not values[name]]
    if missing:
        print("半合同，拒绝新增；缺字段：%s" % ", ".join(missing), file=sys.stderr)
        return 2
    # 先在候选副本上过合同门；绝不把未验任务短暂暴露给 scheduler。
    row = "| " + " | ".join(values.get(col, "-") or "-" for col in header) + " |"
    candidate = list(lines)
    candidate.insert(rows[-1][0] + 1, row)
    # gate 拒绝 CORTEX root 外路径（正确安全边界），因此候选放在 TASKS 同目录的
    # 隐藏临时文件；scheduler 只读精确 TASKS.md，不会看见它。
    candidate_path = os.path.join(
        os.path.dirname(path), ".cortex-task-add-%s-%s.md" % (os.getpid(), time.time_ns()))
    _atomic_write_lines(candidate_path, candidate)
    gate = os.path.join(ROOT, "bin", "knowledge-contract-gate.py")
    try:
        code, out = run("python3 %s check-path %s --strict"
                        % (shlex.quote(gate), shlex.quote(candidate_path)), timeout=60)
    finally:
        if os.path.exists(candidate_path):
            os.unlink(candidate_path)
    if code != 0 or "FAIL" in out:
        print("合同门失败，未发布：\n%s" % out.strip()[:1200], file=sys.stderr)
        return 1

    # 只锁一次本地表格插入；不与 tick/Worker/Git 共锁。锁内重新读，防并发 add
    # 用同一旧快照覆盖彼此。写入用 tmp+replace，读者不会看到半张 Markdown 表。
    lock_path = _ledger_lock_path(path)
    with open(lock_path, "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        lines, header, rows = read_table(path)
        if any(row.get("id") == task_id for _, row in rows):
            print("任务已存在：%s/%s" % (args.line, task_id), file=sys.stderr)
            return 1
        row = "| " + " | ".join(values.get(col, "-") or "-" for col in header) + " |"
        insert_at = rows[-1][0] + 1
        lines.insert(insert_at, row)
        _atomic_write_lines(path, lines)
    log("task-add %s/%s" % (args.line, task_id))
    print("ADDED %s/%s" % (args.line, task_id))
    return 0


def route_discovered_file_tasks(candidates, line="cortex-immune"):
    """Publish discovered file work into the controller ledger.

    Legacy plan refs remain readable for history and non-file actions, but every
    new file producer must enter the workspace/candidate/integrator controller.
    """
    added = []
    for candidate in candidates:
        artifact = (candidate.get("artifact") or "").strip()
        short_test = (candidate.get("short_test") or "").strip()
        if artifact in ("", "-") or short_test in ("", "-"):
            continue
        task_id = _clean_task_cell("id", candidate.get("id") or "")
        if not task_id or pick(line, task_id):
            continue
        local_only = candidate.get("source") == "map-backlink-gap"
        args = argparse.Namespace(
            line=line, id=task_id,
            title=candidate.get("title") or task_id,
            depends_on="-",
            success_criteria="机械判据通过：%s" % short_test,
            failure_modes="产出缺失、越界修改、判据未通过或未落 canonical master",
            artifact_paths=artifact,
            short_test=short_test,
            leverage="medium",
            cost_estimate="S" if local_only else "M",
            resource_class="local-only" if local_only else "llm-light",
            role="-",
        )
        if cmd_task_add(args) == 0:
            added.append(task_id)
    return added


def cmd_task_retry(args):
    """把一次失败原子重排到现在；done/外部阻塞态不允许暗中重开。"""
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if task.get("status") in ("done", "waiting_external", "blocked"):
        print("拒绝重排 %s 状态任务；需先解决其状态原因" % task.get("status"),
              file=sys.stderr)
        return 1
    path = tasks_path(args.line)
    updates = {"status": "pending", "next_advance_after": "-", "updated_at": fmt(now())}
    if args.reset_fails:
        updates["fails"] = "0"
    if not set_cells(path, task["id"], updates, expected_status=task.get("status")):
        print("任务状态已并发变化，未覆盖新状态", file=sys.stderr)
        return 75
    log("task-retry %s/%s reason=%s" % (args.line, task["id"], args.reason))
    print("REQUEUED %s/%s now（reason=%s）" % (args.line, task["id"], args.reason))
    return 0


def cmd_task_reopen(args):
    """显式撤销一次假完成；保留失败计数与原因，不允许手改 TASKS。"""
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if task.get("status") != "done":
        print("只有 done 任务可 reopen；当前 status=%s" % task.get("status"),
              file=sys.stderr)
        return 1
    try:
        fails = int(task.get("fails") or 0) + 1
    except ValueError:
        fails = 1
    path = tasks_path(args.line)
    if not set_cells(path, task["id"], {
            "status": "pending", "evidence": "-", "next_advance_after": "-",
            "fails": str(fails), "updated_at": fmt(now()),
    }, expected_status="done"):
        print("任务状态已并发变化，未覆盖新状态", file=sys.stderr)
        return 75
    log("task-reopen %s/%s reason=%s" % (args.line, task["id"], args.reason))
    print("REOPENED %s/%s → pending（reason=%s）" % (
        args.line, task["id"], args.reason))
    return 0


def cmd_task_hold(args):
    """把任务原子转入 blocked/waiting_external，避免执行器反复烧额度。"""
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if task.get("status") == "done":
        print("done 任务不能直接 hold；假完成请先 task-reopen", file=sys.stderr)
        return 1
    path = tasks_path(args.line)
    # HOLD 是显式人工/控制器封存的 provenance；repair controller 只自动恢复
    # 旧 AI 误封存或带到期窗口的 blocked，绝不能下一拍推翻 task-hold。
    if not set_cells(path, task["id"], {
            "status": args.status, "next_advance_after": "HOLD",
            "updated_at": fmt(now()),
    }, expected_status=task.get("status")):
        print("任务状态已并发变化，未覆盖新状态", file=sys.stderr)
        return 75
    log("task-hold %s/%s status=%s reason=%s"
        % (args.line, task["id"], args.status, args.reason))
    print("HELD %s/%s → %s（reason=%s）"
          % (args.line, task["id"], args.status, args.reason))
    return 0


def cmd_task_resume(args):
    """显式解除 blocked/waiting_external/settling；不清失败史，恢复后可被自动 tick 认领。"""
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if is_negative_test_sentinel(args.line, task):
        print("反测哨兵不能恢复为可执行任务：%s/%s" % (args.line, args.task),
              file=sys.stderr)
        return 1
    if task.get("status") not in ("blocked", "waiting_external", "settling"):
        print("只有 blocked/waiting_external/settling 可 resume；当前 status=%s"
              % task.get("status"), file=sys.stderr)
        return 1
    path = tasks_path(args.line)
    if not set_cells(path, task["id"], {
            "status": "pending", "next_advance_after": "-",
            "updated_at": fmt(now()),
    }, expected_status=task.get("status")):
        print("任务状态已并发变化，未覆盖新状态", file=sys.stderr)
        return 75
    log("task-resume %s/%s reason=%s" % (args.line, task["id"], args.reason))
    print("RESUMED %s/%s → pending（reason=%s）"
          % (args.line, task["id"], args.reason))
    return 0


def cmd_task_route(args):
    """原子修正资源路由；可显式把误封任务恢复到 pending。"""
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if task.get("status") == "done":
        print("done 任务不能改路由；假完成请先 task-reopen", file=sys.stderr)
        return 1
    if args.resume and task.get("status") not in (
            "blocked", "waiting_external", "pending", "settling"):
        print("只有 blocked/waiting_external/pending/settling 可随路由恢复；当前 status=%s"
              % task.get("status"), file=sys.stderr)
        return 1
    path = tasks_path(args.line)
    updates = {"resource_class": args.resource_class, "updated_at": fmt(now())}
    if args.resume:
        updates.update({"status": "pending", "next_advance_after": "-"})
    if not set_cells(path, task["id"], updates, expected_status=task.get("status")):
        print("任务状态已并发变化，未覆盖新状态", file=sys.stderr)
        return 75
    log("task-route %s/%s class=%s resume=%s reason=%s"
        % (args.line, task["id"], args.resource_class, args.resume, args.reason))
    print("ROUTED %s/%s → %s%s（reason=%s）"
          % (args.line, task["id"], args.resource_class,
             " + pending" if args.resume else "", args.reason))
    return 0


def cmd_task_run(args):
    """精确执行一条任务，仍走与自动 tick 相同的 claim/adapter/完成门。"""
    if not acquire_task_lock(args.line, args.task):
        print("skip | %s/%s 已有 Worker，拒绝重复执行" % (args.line, args.task))
        return 0
    entry = next((e for e in clock_lines() if e["line"] == args.line), None)
    if entry is None or entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
        print("方向线未启用或不存在：%s" % args.line, file=sys.stderr)
        return 1
    task = _task_or_error(args.line, args.task)
    if task is None:
        return 1
    if task.get("resource_class") == "human-gate":
        print("拒绝自动执行 human-gate 任务 %s/%s" % (args.line, args.task),
              file=sys.stderr)
        return 1
    if not runnable(load_tasks(args.line), task):
        print("任务当前不可运行：status=%s depends_on=%s"
              % (task.get("status"), task.get("depends_on")), file=sys.stderr)
        return 1
    window = parse_ts(task.get("next_advance_after"))
    if window and window > now():
        print("任务未到重试窗口：%s" % fmt(window), file=sys.stderr)
        return 1
    executor = entry.get("executor") or "human"
    return advance_once(args.line, task, executor,
                        int(entry.get("advance_window_min") or 240))


def cmd_submit(args):
    path = tasks_path(args.line)
    task = pick(args.line, args.task)
    if not task:
        print("找不到任务 %s" % args.task, file=sys.stderr)
        return 1
    body = ""
    if args.result and os.path.isfile(args.result):
        with open(args.result, encoding="utf-8", errors="replace") as fh:
            body = fh.read().strip()
    journal = os.path.join(DIRECTIONS, args.line, "JOURNAL.md")
    with open(journal, "a", encoding="utf-8") as fh:
        fh.write("\n## %s · %s（cortex-loop 自动推进）\n\n%s\n"
                 % (fmt(now()), task["id"], body[:4000] or "（执行器无输出）"))
    # 只推窗口 + 记时间；status 一律不动 done
    minutes = int(args.window_min)
    updates = {"next_advance_after": "-", "updated_at": fmt(now())}
    if task.get("status") == "running":
        updates["status"] = "pending"
    if not set_cells(path, task["id"], updates,
                     expected_status=("pending", "running", "settling")):
        log("settling %s skipped — controller changed status" % task["id"])
        return 0
    log("submit %s/%s window=+%dmin" % (args.line, task["id"], minutes))
    print("submitted %s（下次窗口 %s；status 未动，done 只能由 try-complete 写）"
          % (task["id"], fmt(now() + timedelta(minutes=minutes))))
    return 0


def _artifact_repo_rel(rel):
    """vault 相对路径 → 仓内相对路径；越界返回 None。"""
    full = rel if os.path.isabs(rel) else os.path.join(ROOT, rel)
    root_real = os.path.realpath(ROOT)
    full_real = os.path.realpath(full)
    if full_real != root_real and not full_real.startswith(root_real + os.sep):
        return None
    return os.path.relpath(full_real, root_real)


def _attempt_state_root():
    workspace_root = os.path.expanduser(os.environ.get(
        "CORTEX_WORKSPACE_ROOT", "${CORTEX_WORKSPACE_ROOT}"))
    return os.path.join(workspace_root, ".attempt")


def _candidate_receipt_root():
    workspace_root = os.path.expanduser(os.environ.get(
        "CORTEX_WORKSPACE_ROOT", "${CORTEX_WORKSPACE_ROOT}"))
    return os.path.expanduser(os.environ.get(
        "CORTEX_CANDIDATE_RECEIPT_ROOT", os.path.join(workspace_root, ".candidate")))


def _integration_receipt_root():
    workspace_root = os.path.expanduser(os.environ.get(
        "CORTEX_WORKSPACE_ROOT", "${CORTEX_WORKSPACE_ROOT}"))
    return os.path.expanduser(os.environ.get(
        "CORTEX_INTEGRATION_RECEIPT_ROOT", os.path.join(workspace_root, ".integration")))


def _safe_attempt_component(value):
    return re.sub(r"[^A-Za-z0-9._-]+", "-", value or "task").strip("-.")[:24] or "task"


def _path_is_within(path, pattern):
    pattern = (pattern or "").rstrip("/")
    return path == pattern or (bool(pattern) and path.startswith(pattern + "/"))


def _contract_repo_path(raw, label):
    value = (raw or "").strip()
    if (not value or value in ("-", ".") or value.startswith("/")
            or value.startswith(".git/") or value == ".git"
            or ".." in value.split("/") or any(ch in value for ch in "*?[\n\r")):
        raise ValueError("%s 路径不安全或过宽：%s" % (label, raw))
    return value[2:] if value.startswith("./") else value


def _candidate_companion_path():
    raw = os.environ.get("CORTEX_CANDIDATE_COMPANION", "").strip()
    return _contract_repo_path(raw, "candidate_companion") if raw else ""


def workspace_contract_paths(task):
    """从合同机械展开 writable/read-only 稀疏路径；不能推导就 fail closed。"""
    writable = []
    for field in ("bounds", "artifact_paths"):
        for raw in (task.get(field) or "").split():
            if raw == "-":
                continue
            path = _contract_repo_path(raw, field)
            if path not in writable:
                writable.append(path)
    artifacts = [_contract_repo_path(p, "artifact_paths")
                 for p in (task.get("artifact_paths") or "").split() if p != "-"]
    companion = _candidate_companion_path()
    if companion and companion not in writable:
        writable.append(companion)
    if not artifacts:
        raise ValueError("artifact_paths 为空，拒绝创建全仓工作舱")
    if not writable:
        raise ValueError("bounds/artifact_paths 无可用路径")

    test = (task.get("short_test") or "").strip()
    if not test or test == "-":
        raise ValueError("short_test 为空")
    try:
        tokens = shlex.split(test)
    except ValueError as exc:
        raise ValueError("short_test 无法安全解析：%s" % exc)
    readonly = []
    repo_ext = (".py", ".sh", ".md", ".json", ".yaml", ".yml", ".toml",
                ".txt", ".csv", ".js", ".ts")
    for token in tokens:
        candidate = token.split("=", 1)[1] if token.startswith("--") and "=" in token else token
        candidate = candidate.rstrip(":,;")
        if candidate.startswith(("/bin/", "/usr/", "/opt/")):
            continue
        looks_like_path = ("/" in candidate or candidate.endswith(repo_ext)
                           or os.path.exists(os.path.join(ROOT, candidate)))
        if not looks_like_path or candidate in (".", ".."):
            continue
        path = _contract_repo_path(candidate, "short_test")
        if any(_path_is_within(path, allowed) for allowed in writable):
            continue
        if path not in readonly:
            readonly.append(path)
    # Candidate commit 必须实际经过版本化 hooks。把 hooks 与其明确调用的最小
    # validator 依赖物化为只读；缺 hooksPath 时生产 fail closed，隔离 fixture
    # 只能显式提供自己的拒绝型 hook 或打开测试开关。
    hook_code, hooks_path = git("config --get core.hooksPath", timeout=30)
    hooks_path = hooks_path.strip()
    if hook_code != 0 or not hooks_path:
        if os.environ.get("CORTEX_ALLOW_NO_HOOK_FIXTURE") != "1":
            raise ValueError("core.hooksPath 未配置，candidate commit 可能绕过 gate")
    else:
        hooks_full = hooks_path if os.path.isabs(hooks_path) else os.path.join(ROOT, hooks_path)
        hooks_real = os.path.realpath(hooks_full)
        root_real = os.path.realpath(ROOT)
        if not (hooks_real == root_real or hooks_real.startswith(root_real + os.sep)) \
                or not os.path.isdir(hooks_real):
            raise ValueError("core.hooksPath 不在版本化仓库内或不存在：%s" % hooks_path)
        hook_rel = os.path.relpath(hooks_real, root_real)
        if hook_rel not in readonly:
            readonly.append(hook_rel)
        for dep in (
            "bin/git-mac-commit-gate.sh",
            "bin/verify-three-horizontal-one-vertical.py",
            "bin/verify-current-state-consistency.py",
            "bin/git-commit-contract-scan.py",
            "bin/report-governance.py",
            # pre-commit invokes this for every report-bearing candidate; it
            # must be present in the sparse attempt rather than treated as a
            # root-worktree-only hook helper.
            "bin/claim-count-gate.sh",
            # Markdown frontmatter is checked for every changed report and
            # Skill. A sparse candidate must execute the same parser rather
            # than fail because the hook cannot locate it.
            "bin/verify-frontmatter.py",
            # A changed SKILL.md also invokes this direct hook helper. Its
            # wider governance inputs remain governed by the existing gate;
            # this list only prevents a missing executable from masking them.
            "bin/verify-skill-integration.sh",
            "bin/knowledge-contract-gate.py",
            "bin/verify-recipe-entry-contract.py",
        ):
            if os.path.exists(os.path.join(ROOT, dep)) and dep not in readonly:
                readonly.append(dep)
    return {
        "writable_paths": writable,
        "artifact_paths": artifacts,
        "read_paths": readonly,
        "materialized_paths": writable + [p for p in readonly if p not in writable],
        "short_test": test,
        "candidate_companion": companion,
    }


def _write_json_exclusive(path, payload):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    try:
        with open(path, "x", encoding="utf-8") as fh:
            json.dump(payload, fh, ensure_ascii=False, sort_keys=True, indent=2)
            fh.write("\n")
    except FileExistsError:
        return False
    return True


def _workspace_kb(worktree):
    try:
        proc = subprocess.run(["du", "-sk", worktree], text=True,
                              capture_output=True, timeout=30)
        value = proc.stdout.split()[0] if proc.returncode == 0 and proc.stdout.split() else ""
        return int(value) if value.isdigit() else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def _attempt_events_path(candidate):
    return os.path.join(_attempt_state_root(), "%s.events.jsonl" % candidate["attempt"])


RUN_CONTRACT_SCHEMA = "cortex-loop/run-contract-v1"


def _canonical_digest(value):
    """Hash a JSON value using the one canonical encoding shared by projections."""
    encoded = json.dumps(
        value, ensure_ascii=False, sort_keys=True, separators=(",", ":")
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def _run_contract_id(run_id):
    """Derive the stable contract id once from the immutable attempt run id."""
    return hashlib.sha256((RUN_CONTRACT_SCHEMA + "\0" + str(run_id)).encode(
        "utf-8")).hexdigest()[:24]


def _task_goal_digest(task):
    return _canonical_digest({
        "title": task.get("title", ""),
        "success_criteria": task.get("success_criteria", ""),
        "failure_modes": task.get("failure_modes", ""),
        "depends_on": task.get("depends_on", "-"),
    })


def _task_contract_digest(contract):
    return _canonical_digest({
        "writable_paths": sorted(contract.get("writable_paths") or []),
        "read_paths": sorted(contract.get("read_paths") or []),
        "artifact_paths": sorted(contract.get("artifact_paths") or []),
        "short_test": contract.get("short_test", ""),
    })


def _run_contract_stage(state):
    return {
        "running": "execute",
        "done": "complete",
        "blocked": "submit",
        "waiting_external": "submit",
        "settling": "submit",
        "pending": "claim",
    }.get(state, "unknown")


def _load_json_file(path):
    if not path:
        return {}
    try:
        with open(path, encoding="utf-8") as fh:
            value = json.load(fh)
        return value if isinstance(value, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _attempt_delivery_state(claim, task):
    """Expose artifact, candidate, and terminal gates independently.

    A provider can write an artifact while the controlled candidate commit is
    blocked by the companion-receipt gate. Keep that fact visible in the
    read-only run-contract instead of collapsing it into ``state=pending``.
    """
    worktree = str(claim.get("worktree") or "")
    artifacts = list(claim.get("artifact_paths") or [])
    worktree_present = bool(worktree and os.path.isdir(worktree))
    artifact_ok = bool(worktree and artifacts) and all(
        os.path.isfile(os.path.join(worktree, rel))
        and os.path.getsize(os.path.join(worktree, rel)) > 0
        for rel in artifacts
    )
    candidate = _load_json_file(claim.get("candidate_path"))
    integration = _load_json_file(claim.get("integration_receipt"))
    candidate_oid = str(candidate.get("candidate_oid") or "")
    candidate_landed = (
        candidate.get("status") == "published"
        and bool(candidate_oid)
        and str(candidate.get("candidate_ref") or "").startswith(
            "refs/cortex/candidate/"
        )
    )
    integration_landed = integration.get("status") == "landed"
    blocker = ""
    event_path = _attempt_events_path(claim)
    try:
        with open(event_path, encoding="utf-8") as fh:
            events = [json.loads(line) for line in fh if line.strip()]
    except (OSError, json.JSONDecodeError):
        events = []
    for event in reversed(events):
        if event.get("machine_blocker"):
            blocker = str(event["machine_blocker"])
            break
    # A TASKS.md ``done`` cell alone is not a terminal delivery assertion.  A
    # terminal contract is published only after the candidate/integrator gate
    # has been independently checked, and is the durable reader-facing proof.
    terminal_complete = False
    # Once both durable delivery receipts exist, an absent attempt worktree is
    # normal: successful completion releases it.  It is not evidence that the
    # provider artifact vanished.  Until the immutable terminal ref appears,
    # retain that uncertainty explicitly instead of emitting a false terminal
    # negative derived from disposable bytes.
    terminal_ref_pending = candidate_landed and integration_landed
    if terminal_ref_pending and not worktree_present:
        artifact_ok = None
    if terminal_ref_pending:
        stage = "terminal-ref-pending"
    elif candidate_landed:
        stage = "candidate-landed"
    elif artifact_ok:
        stage = "artifact-ok"
    else:
        stage = "provider-incomplete"
    return {
        "artifact_ok": artifact_ok,
        "candidate_landed": candidate_landed,
        "terminal_complete": terminal_complete,
        "stage": stage,
        "terminal_ref_pending": terminal_ref_pending,
        "machine_blocker": blocker,
        "candidate_oid": candidate_oid,
        "integration_status": integration.get("status", ""),
    }


def _build_run_contract(claim, task, source_surface="cli", terminal_evidence=None):
    """Build the read-only cross-surface contract from a frozen attempt claim."""
    required = (
        "contract_id", "run_id", "line", "task", "attempt", "executor",
        "goal_digest", "contract_digest", "artifact_paths", "short_test",
    )
    missing = [key for key in required if key not in claim]
    if missing:
        raise ValueError("attempt claim 缺少 run-contract 字段：%s" % ",".join(missing))
    if claim.get("line") != task.get("_line", claim.get("line")):
        raise ValueError("attempt claim line 与 task projection 不匹配")
    run_id = str(claim.get("run_id") or "")
    if not run_id:
        raise ValueError("attempt claim 缺少非空 run_id")
    expected_id = _run_contract_id(run_id)
    if claim.get("contract_id") != expected_id:
        raise ValueError("contract_id 与 run_id 不匹配")
    if _task_goal_digest(task) != claim["goal_digest"]:
        raise ValueError("FAIL_SEMANTIC_DRIFT: goal_digest 与冻结任务不匹配")
    frozen_contract = {
        "writable_paths": claim.get("writable_paths") or [],
        "read_paths": claim.get("read_paths") or [],
        "artifact_paths": claim.get("artifact_paths") or [],
        "short_test": claim.get("short_test", ""),
    }
    if _task_contract_digest(frozen_contract) != claim["contract_digest"]:
        raise ValueError("FAIL_SEMANTIC_DRIFT: contract_digest 与冻结合同不匹配")
    state = str(task.get("status") or "UNKNOWN")
    semantic = {
        "goal_digest": claim["goal_digest"],
        "contract_digest": claim["contract_digest"],
        "artifact_paths": list(claim.get("artifact_paths") or []),
        "short_test": claim.get("short_test", ""),
        "terminal_state": state if state in {
            "done", "blocked", "waiting_external"
        } else None,
    }
    delivery = _attempt_delivery_state(claim, task)
    if terminal_evidence is not None:
        if not delivery["candidate_landed"] or delivery["integration_status"] != "landed":
            raise ValueError("terminal run-contract 缺少已验证的 candidate/integration 落地证据")
        delivery.update({
            "terminal_complete": True,
            "stage": "terminal-complete",
            "terminal_evidence": terminal_evidence,
        })
    return {
        "schema_version": RUN_CONTRACT_SCHEMA,
        "contract_id": claim["contract_id"],
        "run_id": run_id,
        "line": claim["line"],
        "task_id": claim["task"],
        "attempt": claim["attempt"],
        "state": state,
        "stage": _run_contract_stage(state),
        "executor": claim["executor"],
        "semantic": semantic,
        "semantic_digest": _canonical_digest(semantic),
        "delivery": delivery,
        "provenance": {
            "canonical_entry": "bin/cortex-loop",
            "source_surface": source_surface,
            "identity_status": claim.get("identity_status", "IDENTITY_MISMATCH"),
        },
    }


def _run_contract_ref(line, task_id, run_id):
    return "%s/%s/%s/%s" % (
        RUN_CONTRACT_NS, _safe_ref_component(line),
        _safe_ref_component(task_id), _safe_ref_component(run_id))


def _validate_terminal_run_contract(value, line, task_id, run_id=None):
    """Return a stored terminal contract only when its immutable proof holds."""
    if not isinstance(value, dict):
        return None
    if (value.get("schema_version") != RUN_CONTRACT_SCHEMA
            or value.get("line") != line
            or value.get("task_id") != task_id
            or (run_id and value.get("run_id") != run_id)):
        return None
    if value.get("contract_id") != _run_contract_id(value.get("run_id") or ""):
        return None
    semantic = value.get("semantic")
    delivery = value.get("delivery")
    evidence = delivery.get("terminal_evidence") if isinstance(delivery, dict) else None
    if (not isinstance(semantic, dict)
            or value.get("semantic_digest") != _canonical_digest(semantic)
            or not isinstance(evidence, dict)
            or delivery.get("terminal_complete") is not True
            or delivery.get("stage") != "terminal-complete"
            or not re.fullmatch(r"[0-9a-f]{40}", str(evidence.get("candidate_oid") or ""))
            or not re.fullmatch(r"[0-9a-f]{40}", str(evidence.get("landed_oid") or ""))
            or evidence.get("integration_status") != "landed"):
        return None
    return value


def _load_terminal_run_contract(line, task_id, run_id=None):
    """Load the latest durable terminal projection without consulting an attempt."""
    namespace = "%s/%s/%s" % (
        RUN_CONTRACT_NS, _safe_ref_component(line), _safe_ref_component(task_id))
    refs = list_refs(namespace)
    if getattr(refs, "status", "ok") == "error":
        return None, "canonical run-contract refs 不可读"
    matches = []
    for ref in refs:
        payload = read_ref(ref)
        if getattr(payload, "status", "ok") == "error":
            continue
        try:
            value = json.loads(str(payload))
        except json.JSONDecodeError:
            continue
        value = _validate_terminal_run_contract(value, line, task_id, run_id)
        if value is None:
            continue
        published_at = str((value.get("delivery", {}).get("terminal_evidence", {})
                            .get("published_at") or ""))
        matches.append((published_at, ref, value))
    if not matches:
        return None, ""
    _published_at, ref, contract = max(matches, key=lambda item: (item[0], item[1]))
    return (ref, contract), ""


def _project_terminal_run_contract(ref, contract, source_surface):
    """Keep caller surface provenance outside the immutable semantic payload."""
    projection = json.loads(json.dumps(contract, ensure_ascii=False))
    provenance = projection.setdefault("provenance", {})
    provenance["source_surface"] = source_surface
    provenance["canonical_ref"] = ref
    return projection


def _publish_terminal_run_contract(candidate, task, receipt):
    """Persist a terminal projection only after the integrator proof is verified."""
    if task.get("status") != "done":
        return False, "terminal run-contract 拒绝以非 done 任务状态发布"
    candidate_oid = str(candidate.get("candidate_oid") or "")
    landed_oid = str((receipt or {}).get("landed_commit") or "")
    if (not re.fullmatch(r"[0-9a-f]{40}", candidate_oid)
            or not re.fullmatch(r"[0-9a-f]{40}", landed_oid)
            or receipt.get("status") != "landed"):
        return False, "terminal run-contract 缺少已验证的 candidate/integration OID"
    run_id = str(candidate.get("run_id") or "")
    ref = _run_contract_ref(candidate.get("line", ""), candidate.get("task", ""), run_id)
    existing, load_error = _load_terminal_run_contract(
        candidate.get("line", ""), candidate.get("task", ""), run_id)
    if load_error:
        return False, load_error
    if existing is not None:
        _existing_ref, stored = existing
        evidence = stored["delivery"]["terminal_evidence"]
        if (evidence.get("candidate_oid") == candidate_oid
                and evidence.get("landed_oid") == landed_oid):
            return True, _existing_ref
        return False, "同 run_id 已有不匹配的 terminal run-contract"
    terminal_evidence = {
        "candidate_oid": candidate_oid,
        "landed_oid": landed_oid,
        "integration_status": "landed",
        "canonical_ref": receipt.get("canonical_ref") or "refs/heads/master",
        "published_at": fmt(now()),
    }
    try:
        contract = _build_run_contract(
            candidate, task, source_surface="terminal-publisher",
            terminal_evidence=terminal_evidence)
    except ValueError as exc:
        return False, str(exc)
    ok, detail = write_ref(ref, json.dumps(contract, ensure_ascii=False, sort_keys=True))
    if not ok:
        return False, "terminal run-contract 写入失败：%s" % detail
    stored, load_error = _load_terminal_run_contract(
        candidate.get("line", ""), candidate.get("task", ""), run_id)
    if load_error or stored is None or stored[0] != ref:
        return False, load_error or "terminal run-contract 写后不可读"
    return True, ref


def _load_attempt_claim_for_run(line, task_id, run_id=None):
    root = _attempt_state_root()
    if not os.path.isdir(root):
        return None
    matches = []
    for name in os.listdir(root):
        if not name.endswith(".claim.json"):
            continue
        path = os.path.join(root, name)
        try:
            with open(path, encoding="utf-8") as fh:
                claim = json.load(fh)
        except (OSError, json.JSONDecodeError):
            continue
        if claim.get("line") != line or claim.get("task") != task_id:
            continue
        if run_id and claim.get("run_id") != run_id:
            continue
        matches.append((os.path.getmtime(path), claim))
    return max(matches, default=(0, None), key=lambda pair: pair[0])[1]


def _read_run_contract(line, task_id, run_id=None, source_surface="cli"):
    stored, load_error = _load_terminal_run_contract(line, task_id, run_id)
    if stored is not None:
        return _project_terminal_run_contract(stored[0], stored[1], source_surface)
    claim = _load_attempt_claim_for_run(line, task_id, run_id)
    if claim is None:
        if load_error:
            raise ValueError(load_error)
        raise ValueError("找不到 run contract：%s/%s%s" % (
            line, task_id, ("/" + run_id) if run_id else ""))
    task = _task_or_error(line, task_id)
    if task is None:
        raise ValueError("找不到任务：%s/%s" % (line, task_id))
    task = dict(task)
    task["_line"] = line
    fallback = _build_run_contract(claim, task, source_surface=source_surface)
    if not fallback["delivery"].get("terminal_ref_pending"):
        return fallback
    # Do not turn a just-landed candidate into a final negative merely because
    # the terminal ref lands a few scheduler ticks after the integration
    # receipt.  A bounded local reread preserves API no-fetch semantics and
    # still returns an explicit pending state when publication is genuinely not
    # visible yet.
    for _retry in range(TERMINAL_REF_READ_RETRIES):
        time.sleep(TERMINAL_REF_READ_DELAY_SEC)
        stored, load_error = _load_terminal_run_contract(line, task_id, run_id)
        if stored is not None:
            return _project_terminal_run_contract(stored[0], stored[1], source_surface)
    fallback["delivery"]["terminal_ref_pending"] = True
    fallback["delivery"]["machine_blocker"] = "terminal_ref_pending"
    return fallback


def _attempt_cas_retry_count(candidate):
    path = _attempt_events_path(candidate)
    count = 0
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                try:
                    if json.loads(line).get("integration_status") == "retryable_cas_conflict":
                        count += 1
                except json.JSONDecodeError:
                    continue
    except OSError:
        pass
    return count


def _attempt_content_conflict_count(candidate):
    """Count content-conflict integration attempts for one immutable candidate."""
    path = _attempt_events_path(candidate)
    count = 0
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                try:
                    if json.loads(line).get("integration_status") == "retryable_content_conflict":
                        count += 1
                except json.JSONDecodeError:
                    continue
    except OSError:
        pass
    return count


def _attempt_base_oid():
    """Freeze an attempt from the integration ref, not an unrelated local HEAD.

    LIVE workspaces may publish to a lab ref while the checkout remains on the
    repository's master branch. Fetching the configured push ref before creating
    the worktree keeps its base, candidate delta, and integrator canonical tip
    on one history. With no override the historical local HEAD behavior remains
    available for ordinary master runs and isolated fixtures.
    """
    configured = os.environ.get("CORTEX_CANONICAL_PUSH_REF", "").strip()
    if not configured:
        code, out = git("rev-parse --verify HEAD^{commit}", timeout=60)
        tip = out.strip()
        if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", tip):
            raise RuntimeError("无法冻结 base_oid")
        return tip, "HEAD"
    if (not re.fullmatch(r"refs/heads/[A-Za-z0-9._/-]+", configured)
            or ".." in configured.split("/")):
        raise RuntimeError("CORTEX_CANONICAL_PUSH_REF 非法：%s" % configured)
    remote = os.environ.get("CORTEX_CANONICAL_REMOTE", "origin").strip() or "origin"
    if not re.fullmatch(r"[A-Za-z0-9._-]+", remote):
        raise RuntimeError("CORTEX_CANONICAL_REMOTE 非法：%s" % remote)
    branch = configured[len("refs/heads/"):]
    tracking = "refs/remotes/%s/%s" % (remote, branch)
    fetch_args = "fetch --quiet %s '+%s:%s'" % (
        shlex.quote(remote), shlex.quote(configured), shlex.quote(tracking))
    code, out = _git_net_retry(fetch_args, timeout=180, attempts=3,
                               label="fetch_attempt_canonical")
    if code != 0:
        raise RuntimeError("canonical ref fetch 失败 %s：%s" % (
            configured, out.strip().split("\n")[-1][:240] or "无输出"))
    code, out = git("rev-parse --verify %s^{commit}" % shlex.quote(tracking), timeout=60)
    tip = out.strip()
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", tip):
        raise RuntimeError("canonical ref 不可解析：%s" % configured)
    return tip, configured


def append_attempt_event(candidate, event):
    payload = {
        "schema_version": "cortex-attempt/event-v1",
        "attempt": candidate["attempt"], "run_id": candidate["run_id"],
        "contract_id": candidate.get("contract_id"),
        "line": candidate["line"], "task": candidate["task"],
        "candidate_oid": candidate.get("candidate_oid"),
        "recorded_at": fmt(now()),
    }
    payload.update(event)
    path = _attempt_events_path(candidate)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n")


def create_workspace_attempt(line, task, executor):
    """生成 immutable claim 元数据并创建 attempt worktree。"""
    contract = workspace_contract_paths(task)
    base_oid, base_ref = _attempt_base_oid()
    run_id = hashlib.sha256(("%s\0%s\0%s\0%s\0%s" % (
        line, task["id"], base_oid, time.time_ns(), os.getpid())).encode()).hexdigest()[:20]
    attempt = "%s-%s-%s" % (
        _safe_attempt_component(line), _safe_attempt_component(task["id"]), run_id)
    state_root = _attempt_state_root()
    claim_path = os.path.join(state_root, "%s.claim.json" % attempt)
    receipt_path = os.path.join(_integration_receipt_root(), "%s.json" % attempt)
    candidate_path = os.path.join(_candidate_receipt_root(), "%s.json" % attempt)
    workspace_root = os.path.expanduser(os.environ.get(
        "CORTEX_WORKSPACE_ROOT", "${CORTEX_WORKSPACE_ROOT}"))
    worktree = os.path.join(workspace_root, attempt)
    workspace_manifest = os.path.join(workspace_root, ".state", "%s.json" % attempt)
    claim = {
        "schema_version": "cortex-attempt/claim-v1",
        "attempt": attempt, "run_id": run_id, "line": line, "task": task["id"],
        "contract_id": _run_contract_id(run_id),
        "goal_digest": _task_goal_digest(task),
        "contract_digest": _task_contract_digest(contract),
        "executor": executor, "base_oid": base_oid, "base_ref": base_ref,
        "writable_paths": contract["writable_paths"],
        "artifact_paths": contract["artifact_paths"],
        "read_paths": contract["read_paths"],
        "short_test": contract["short_test"],
        "integration_receipt": receipt_path, "claim_path": claim_path,
        "candidate_path": candidate_path, "worktree": worktree,
        "workspace_manifest": workspace_manifest,
        "created_at": fmt(now()),
    }
    if not _write_json_exclusive(claim_path, claim):
        raise RuntimeError("attempt claim 已存在，拒绝覆盖")
    broker = os.path.join(ROOT, "bin", "cortex-workspace.sh")
    args = ["bash", broker, "create", "--attempt", attempt, "--base", base_oid]
    for path in contract["materialized_paths"]:
        args.extend(["--allow", path])
    env = "CORTEX_WORKSPACE_REPO_ROOT=%s " % shlex.quote(ROOT)
    # `git sparse-checkout init` 首次启用 extensions.worktreeConfig 时会短暂写共享
    # .git/config；不同 attempt 的执行可并行，但 broker create 这一小段必须串行，
    # 否则两个独立 worktree 仍会争 config.lock。
    create_lock_path = os.path.join(state_root, "workspace-create.lock")
    os.makedirs(state_root, exist_ok=True)
    with open(create_lock_path, "a+", encoding="utf-8") as create_lock:
        fcntl.flock(create_lock.fileno(), fcntl.LOCK_EX)
        code, out = run(env + " ".join(shlex.quote(v) for v in args), timeout=180)
        fcntl.flock(create_lock.fileno(), fcntl.LOCK_UN)
    if code != 0:
        raise RuntimeError("workspace create rc=%d：%s" % (code, out.strip()[-600:]))
    broker_worktree = next((line.strip() for line in reversed(out.splitlines())
                     if line.strip() and os.path.isdir(line.strip())), "")
    if (not os.path.isdir(broker_worktree)
            or os.path.realpath(broker_worktree) != os.path.realpath(worktree)
            or os.path.realpath(worktree) == os.path.realpath(ROOT)):
        raise RuntimeError("workspace broker 返回非法 worktree：%s" % broker_worktree)
    companion = contract.get("candidate_companion")
    if companion:
        source = os.path.join(ROOT, companion)
        target = os.path.join(worktree, companion)
        if not os.path.isfile(source) or os.path.getsize(source) == 0:
            raise RuntimeError("candidate companion 缺失或为空：%s" % companion)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        shutil.copy2(source, target)
    return claim


def _workspace_changed_paths(worktree):
    proc = subprocess.run(
        ["git", "-C", worktree, "status", "--porcelain=v1", "-z",
         "--untracked-files=all"], capture_output=True)
    if proc.returncode != 0:
        raise RuntimeError("无法读取 attempt worktree 状态")
    changed = []
    for record in proc.stdout.split(b"\0"):
        if not record:
            continue
        text = record.decode("utf-8", "surrogateescape")
        if text[:2].strip() in ("R", "C"):
            raise RuntimeError("attempt rename/copy 需显式拆成旧/新路径，当前拒绝")
        path = text[3:]
        if " -> " in path:
            path = path.split(" -> ", 1)[1]
        changed.append(path)
    return changed


def _candidate_companion_blocker(output):
    markers = (
        "high-impact delivery is missing its evidence report",
        "high-impact delivery omitted an evidence report pathspec",
        "high-impact delivery omitted a matching evidence report",
    )
    return any(marker in (output or "") for marker in markers)


def refresh_candidate_companion(ctx, task):
    """Materialize post-adapter evidence before high-impact candidate preflight."""
    contract = workspace_contract_paths(task)
    companion = contract.get("candidate_companion")
    if not companion:
        return ""
    result_path = str(ctx.get("adapter_result") or "")
    if not result_path or not os.path.isfile(result_path):
        raise RuntimeError("candidate companion 缺少本轮 adapter result")
    fields = {}
    allowed = {
        "executor", "native_session_id", "native_tool_events",
        "session_timeout_seconds", "model_timeout_seconds", "max_tool_rounds",
        "timeout_reason", "error_category", "budget_result", "exit",
    }
    with open(result_path, encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            key, sep, value = raw.rstrip("\n").partition("=")
            if sep and key in allowed:
                fields[key] = value.strip()
    adapter_exit = fields.get("exit", "unknown")
    transport_error = fields.get("error_category") or fields.get("timeout_reason", "")
    salvage = bool(ctx.get("transport_salvage"))
    if adapter_exit != "0" and not (
            salvage and transport_error in {"network_timeout", "network_error"}):
        raise RuntimeError("candidate companion 拒绝为非成功 adapter 伪造证据")
    target = os.path.join(ctx["worktree"], companion)
    os.makedirs(os.path.dirname(target), exist_ok=True)
    report_attempt = re.sub(r"[^a-z0-9]+", "-", str(ctx["attempt"]).lower()).strip("-")
    evidence = [
        "---",
        "id: CANDIDATE-COMPANION-%s" % ctx["run_id"],
        "report_id: cortex-candidate-%s" % report_attempt,
        "date: %s" % now().date().isoformat(),
        "status: living",
        "verdict: CANDIDATE_EVIDENCE",
        "topic: cortex-harness",
        "campaign: cortex-harness",
        "owner: cortex-workspace",
        "---",
        "",
        "# Candidate companion evidence",
        "",
        "This file is refreshed after a successful adapter result and before candidate preflight.",
        "It is evidence for candidate gating only; it does not claim terminal delivery.",
        "",
        "## Timeline",
        "",
        "1. Adapter completed with `exit=0` for attempt `%s`." % ctx["attempt"],
        "2. This companion was refreshed from that result before candidate preflight.",
        "",
        "## 三横一纵",
        "",
        "### A 桶 — Adapter result: `bin/cortex-loop`",
        "",
        "- 对象: `bin/cortex-loop` attempt `%s` via `%s`." % (
            ctx["attempt"], fields.get("executor") or ctx.get("executor", "unknown")),
        "- 证据: adapter result recorded `exit=%s` before this companion refresh." % adapter_exit,
        "",
        "### B 桶 — Bounded provider evidence: `bin/cortex-loop-adapters`",
        "",
        "- 对象: bounded native session `%s`." % fields.get("native_session_id", "unknown"),
        "- 证据: events=%s timeout_reason=%s error_category=%s." % (
            fields.get("native_tool_events", "unknown"),
            fields.get("timeout_reason", "unknown"),
            fields.get("error_category", "unknown")),
        "",
        "### C 桶 — Candidate boundary: `reports/` companion",
        "",
        "- 对象: `%s` in the attempt worktree." % companion,
        "- 证据: refreshed after adapter exit, before high-impact candidate preflight; terminal delivery remains pending.",
        "",
        "### 一纵 — Machine evidence",
        "",
        "```text",
        "candidate_companion_refresh=after_adapter",
        "adapter_exit=%s" % adapter_exit,
        "transport_error=%s" % (transport_error or "none"),
        "native_session_id=%s" % fields.get("native_session_id", "unknown"),
        "native_tool_events=%s" % fields.get("native_tool_events", "unknown"),
        "timeout_reason=%s" % fields.get("timeout_reason", "unknown"),
        "error_category=%s" % fields.get("error_category", "unknown"),
        "```",
        "",
        "## Verdict",
        "",
        "`CANDIDATE_EVIDENCE`: candidate preflight may now evaluate real post-adapter evidence; candidate and terminal state are not asserted.",
        "",
    ]
    with open(target, "w", encoding="utf-8") as fh:
        fh.write("\n".join(evidence))
    append_attempt_event(ctx, {
        "delivery_stage": "candidate-companion-refreshed",
        "candidate_companion": companion,
        "adapter_result": result_path,
        "adapter_exit": int(adapter_exit) if str(adapter_exit).isdigit() else adapter_exit,
        "transport_error": transport_error or "none",
        "transport_salvage": salvage,
    })
    return companion


def commit_workspace_candidate(ctx, task):
    """在 attempt 独立 index 中精确提交合同内变化，并发布 immutable candidate。"""
    worktree = ctx["worktree"]
    contract = workspace_contract_paths(task)
    refresh_candidate_companion(ctx, task)
    changed = _workspace_changed_paths(worktree)
    if not changed:
        raise RuntimeError("adapter 没有产生任何文件变化")
    outside = [p for p in changed if not any(
        _path_is_within(p, allowed) for allowed in contract["writable_paths"])]
    if outside:
        record_authorization_incident(
            ctx["line"], ctx["task"], "out_of_scope_write",
            "candidate bounds outside_paths=%s" % ",".join(outside[:8]))
        raise RuntimeError("attempt 越界变化：%s" % ", ".join(outside[:8]))
    for rel in contract["artifact_paths"]:
        full = os.path.join(worktree, rel)
        if not os.path.isfile(full) or os.path.getsize(full) == 0:
            raise RuntimeError("artifact 缺失或为空：%s" % rel)
    code, out = run("cd %s && %s" % (
        shlex.quote(worktree), contract["short_test"]), timeout=600)
    if code != 0:
        raise RuntimeError("attempt short_test rc=%d：%s" % (code, out.strip()[-800:]))
    helper = os.path.join(ROOT, "bin", "git-auto-commit.sh")
    message = "chore(cortex): candidate %s/%s" % (ctx["line"], ctx["task"])
    cmd = ["bash", helper, "--producer", "cortex-workspace-candidate",
           "-m", message, "--", *changed]
    code, out = run("cd %s && CORTEX_WORKSPACE_MANIFEST=%s %s" % (
        shlex.quote(worktree), shlex.quote(ctx["workspace_manifest"]),
        " ".join(shlex.quote(v) for v in cmd)), timeout=180)
    if code != 0:
        if _candidate_companion_blocker(out):
            blocker = (
                "MACHINE_BLOCKER: candidate requires an exact reports/.../*.md "
                "companion pathspec; preflight rejected delivery"
            )
            append_attempt_event(ctx, {
                "delivery_stage": "candidate-companion",
                "artifact_ok": True,
                "candidate_landed": False,
                "terminal_complete": False,
                "machine_blocker": blocker,
                "preflight_rc": code,
            })
            raise RuntimeError("%s; %s" % (blocker, out.strip()[-800:]))
        raise RuntimeError("attempt 受控提交失败 rc=%d：%s" % (code, out.strip()[-800:]))
    candidate_oid = subprocess.run(
        ["git", "-C", worktree, "rev-parse", "HEAD"], text=True,
        capture_output=True, check=True).stdout.strip()
    publisher = os.path.join(ROOT, "bin", "cortex-candidate.sh")
    publish_cmd = ["bash", publisher, "publish", "--attempt", ctx["attempt"],
                   "--candidate", candidate_oid, "--base", ctx["base_oid"],
                   "--remote", "origin", "--receipt", ctx["candidate_path"]]
    for path in contract["writable_paths"]:
        publish_cmd.extend(["--allow", path])
    code, out = run("cd %s && %s" % (
        shlex.quote(worktree), " ".join(shlex.quote(v) for v in publish_cmd)), timeout=240)
    try:
        with open(ctx["candidate_path"], encoding="utf-8") as fh:
            published = json.load(fh)
    except (OSError, json.JSONDecodeError):
        published = {}
    if (code != 0 or published.get("status") != "published"
            or published.get("candidate_oid") != candidate_oid
            or not str(published.get("candidate_ref", "")).startswith(
                "refs/cortex/candidate/")):
        raise RuntimeError("candidate immutable publish 失败 rc=%d：%s" % (
            code, out.strip()[-500:]))
    candidate_ref = published["candidate_ref"]
    candidate = dict(ctx)
    candidate.update({
        "schema_version": "cortex-attempt/candidate-v1",
        "candidate_oid": candidate_oid, "candidate_ref": candidate_ref,
        "changed_paths": changed, "published_at": fmt(now()),
    })
    return candidate


def run_workspace_integrator(candidate):
    integrator = os.path.join(ROOT, "bin", "cortex-integrator.sh")
    canonical_ref = os.environ.get("CORTEX_CANONICAL_PUSH_REF", "refs/heads/master")
    remote = os.environ.get("CORTEX_CANONICAL_REMOTE", "origin")
    cmd = ["bash", integrator, "--candidate", candidate["candidate_oid"],
           "--candidate-ref", candidate["candidate_ref"],
           "--base", candidate["base_oid"], "--remote", remote,
           "--ref", canonical_ref, "--short-test", candidate["short_test"],
           "--receipt", candidate["integration_receipt"]]
    for path in candidate["writable_paths"]:
        cmd.extend(["--allow", path])
    for path in candidate["read_paths"]:
        cmd.extend(["--read", path])
    companion = candidate.get("candidate_companion")
    if companion:
        cmd.extend(["--companion", companion])
    code, out = run("cd %s && %s" % (
        shlex.quote(candidate["worktree"]), " ".join(shlex.quote(v) for v in cmd)),
        timeout=900)
    receipt = {}
    try:
        with open(candidate["integration_receipt"], encoding="utf-8") as fh:
            receipt = json.load(fh)
    except (OSError, json.JSONDecodeError):
        receipt = {"status": "retryable_missing_receipt", "exit_code": code,
                   "detail": out.strip()[-800:] or "integrator 无 receipt"}
    return code, receipt


def record_authorization_from_integration(line, task_id, receipt):
    status = str((receipt or {}).get("status") or "")
    incident_type = {
        "rejected_scope": "out_of_scope_write",
        "rejected_readonly_change": "out_of_scope_write",
        "rejected_v4_secret_gate": "out_of_scope_write",
        "rejected_candidate_ref_mismatch": "forged_producer",
    }.get(status)
    if not incident_type:
        return False
    evidence = "integrator status=%s detail=%s" % (
        status, str(receipt.get("detail") or "")[:800])
    return record_authorization_incident(
        line, task_id, incident_type, evidence)


def _complete_integrated_attempt(args, candidate, receipt):
    """integrator receipt 的机械完成门；仍由 cmd_try_complete 唯一写 done。"""
    task = pick(args.line, args.task)
    if not task:
        return 1
    expected = workspace_contract_paths(task)
    candidate_oid = receipt.get("candidate_oid")
    landed_oid = receipt.get("landed_commit")
    if (receipt.get("schema_version") != "cortex-integrator/receipt-v2"
            or receipt.get("status") != "landed"
            or candidate_oid != candidate.get("candidate_oid")
            or receipt.get("candidate_ref") != candidate.get("candidate_ref")
            or receipt.get("base_oid") != candidate.get("base_oid")
            or not re.fullmatch(r"[0-9a-f]{40}", landed_oid or "")
            or sorted(receipt.get("allowed_paths") or []) != sorted(expected["writable_paths"])
            or receipt.get("short_test") != expected["short_test"]
            or (receipt.get("safety_gates") or {}).get("v4_secret_gate") != "passed"):
        if receipt.get("status") == "landed":
            record_authorization_incident(
                args.line, task["id"], "forged_producer",
                "integrator landed receipt 血缘/合同不匹配 candidate=%s" % (
                    str(receipt.get("candidate_oid") or "")[:40]))
        cmd_try_complete.last_failure = {
            "stage": "integration-receipt", "rc": 1,
            "detail": "integrator receipt 血缘/合同不匹配",
        }
        return 1
    remote = receipt.get("canonical_remote") or "origin"
    remote_ref = receipt.get("canonical_ref") or "refs/heads/master"
    tracking_ref = "refs/remotes/cortex-complete/%s" % hashlib.sha256(
        (str(remote) + "\0" + str(remote_ref)).encode()).hexdigest()[:16]
    code, out = _git_net_retry(
        "fetch --quiet %s '+%s:%s'" % (
            shlex.quote(remote), shlex.quote(remote_ref), shlex.quote(tracking_ref)),
        timeout=180, attempts=3, label="verify_landed")
    remote_oid = rev_ref(tracking_ref) if code == 0 else ""
    landed_is_ancestor = (bool(remote_oid)
                          and git("merge-base --is-ancestor %s %s" % (
                              landed_oid, remote_oid), timeout=60)[0] == 0)
    if not landed_is_ancestor:
        cmd_try_complete.last_failure = {
            "stage": "integration-pending", "rc": 75,
            "candidate_oid": candidate_oid, "landed_oid": landed_oid,
            "detail": "landed_oid 尚未确认是当前 canonical tip 的祖先：%s" % (
                out.strip()[-240:] if code != 0 else remote_oid),
        }
        return 75
    if not set_cells(tasks_path(args.line), task["id"], {
            "status": "done", "fails": "0", "next_advance_after": "-",
            "updated_at": fmt(now()), "evidence": expected["artifact_paths"][0],
    }, expected_status=("running", "pending", "settling", "done")):
        return 75
    final_task = pick(args.line, task["id"])
    if not final_task:
        cmd_try_complete.last_failure = {
            "stage": "terminal-contract", "rc": 75,
            "detail": "任务状态写入后不可读，拒绝宣称 terminal",
        }
        return 75
    final_task = dict(final_task)
    final_task["_line"] = args.line
    terminal_ok, terminal_detail = _publish_terminal_run_contract(
        candidate, final_task, receipt)
    if not terminal_ok:
        # The candidate is already safely integrated, but terminal projection is
        # not.  Reopen the controller state as settling rather than letting a
        # bare done cell masquerade as a cross-surface terminal contract.
        set_cells(tasks_path(args.line), task["id"], {
            "status": "settling", "updated_at": fmt(now()),
        }, expected_status="done")
        cmd_try_complete.last_failure = {
            "stage": "terminal-contract", "rc": 75,
            "candidate_oid": candidate_oid, "landed_oid": landed_oid,
            "detail": terminal_detail,
        }
        print("DEFER %s: candidate 已落地，但 terminal run-contract 未发布：%s" % (
            task["id"], terminal_detail))
        return 75
    delivery = {
        "stage": "canonical-landed", "candidate_oid": candidate_oid,
        "landed_oid": landed_oid, "canonical_ref": remote_ref,
        "terminal_contract_ref": terminal_detail,
        "attempt": candidate["attempt"], "run_id": candidate["run_id"],
    }
    cmd_try_complete.last_failure = {}
    cmd_try_complete.last_delivery = [delivery]
    log("done %s/%s attempt=%s candidate_oid=%s landed_oid=%s" % (
        args.line, task["id"], candidate["attempt"], candidate_oid[:12], landed_oid[:12]))
    print("PASS %s → done（attempt %s · candidate_oid=%s · landed_oid=%s）" % (
        task["id"], candidate["attempt"], candidate_oid[:12], landed_oid[:12]))
    return 0


def _release_workspace_attempt(candidate):
    broker = os.path.join(ROOT, "bin", "cortex-workspace.sh")
    cmd = "CORTEX_WORKSPACE_REPO_ROOT=%s bash %s release --attempt %s" % (
        shlex.quote(ROOT), shlex.quote(broker), shlex.quote(candidate["attempt"]))
    return run(cmd, timeout=180)


def _load_latest_attempt_record(line, task_id, suffix, root=None):
    root = root or _attempt_state_root()
    if not os.path.isdir(root):
        return None
    matches = []
    for name in os.listdir(root):
        if not name.endswith(suffix):
            continue
        path = os.path.join(root, name)
        try:
            with open(path, encoding="utf-8") as fh:
                item = json.load(fh)
        except (OSError, json.JSONDecodeError):
            continue
        if item.get("line") == line and item.get("task") == task_id:
            matches.append((os.path.getmtime(path), item))
    return max(matches, default=(0, None), key=lambda pair: pair[0])[1]


def _load_latest_candidate(line, task_id):
    root = _candidate_receipt_root()
    if not os.path.isdir(root):
        return None
    matches = []
    for name in os.listdir(root):
        if not name.endswith(".json"):
            continue
        path = os.path.join(root, name)
        try:
            with open(path, encoding="utf-8") as fh:
                receipt = json.load(fh)
            attempt = receipt.get("attempt")
            with open(os.path.join(_attempt_state_root(), "%s.claim.json" % attempt),
                      encoding="utf-8") as fh:
                claim = json.load(fh)
        except (OSError, TypeError, json.JSONDecodeError):
            continue
        if claim.get("line") == line and claim.get("task") == task_id:
            merged = dict(claim)
            merged.update(receipt)
            merged["writable_paths"] = claim["writable_paths"]
            merged["artifact_paths"] = claim["artifact_paths"]
            merged["read_paths"] = claim["read_paths"]
            merged["short_test"] = claim["short_test"]
            matches.append((os.path.getmtime(path), merged))
    return max(matches, default=(0, None), key=lambda pair: pair[0])[1]


def _load_latest_attempt_claim(line, task_id):
    return _load_latest_attempt_record(line, task_id, ".claim.json")


def _workspace_has_changes(worktree):
    if not worktree or not os.path.isdir(worktree):
        return False
    try:
        return bool(_workspace_changed_paths(worktree))
    except (RuntimeError, OSError, subprocess.SubprocessError):
        return False


def _adapter_transport_category(result_path):
    """Read the adapter's stable network failure category, if present."""
    values = {}
    try:
        with open(result_path, encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                key, sep, value = raw.rstrip("\n").partition("=")
                if sep and key in {"timeout_reason", "error_category"}:
                    values[key] = value.strip()
    except OSError:
        return ""
    for key in ("error_category", "timeout_reason"):
        category = values.get(key, "")
        if category in {"network_timeout", "network_error"}:
            return category
    return ""


def _salvage_post_edit_transport(attempt, task, result_path, category):
    """Run short_test after network failure only for a changed artifact.

    A transport error is not success evidence. This narrow path preserves a
    genuine native edit and lets ordinary candidate/integration gates decide
    delivery; unchanged base artifacts or failed tests remain failed.
    """
    if category not in {"network_timeout", "network_error"}:
        return False, "unsupported transport category"
    worktree = attempt.get("worktree") or ""
    if not worktree or not os.path.isdir(worktree):
        return False, "attempt worktree missing"
    artifacts = [p for p in (task.get("artifact_paths") or "").split()
                 if p and p != "-"]
    if not artifacts:
        return False, "artifact_paths empty"
    try:
        changed = set(os.path.normpath(p) for p in _workspace_changed_paths(worktree))
    except (RuntimeError, OSError, subprocess.SubprocessError) as exc:
        return False, "changed paths unreadable: %s" % exc
    changed_artifacts = [p for p in artifacts if os.path.normpath(p) in changed]
    if not changed_artifacts:
        return False, "artifact exists only in base; no post-edit change"
    for rel in artifacts:
        full = os.path.join(worktree, rel)
        if not os.path.isfile(full) or os.path.getsize(full) == 0:
            return False, "artifact missing or empty: %s" % rel

    native_events = 0
    try:
        with open(result_path, encoding="utf-8", errors="replace") as fh:
            for raw in fh:
                if raw.startswith("native_tool_events="):
                    native_events = int(raw.partition("=")[2].strip())
                    break
    except (OSError, ValueError):
        native_events = 0
    if native_events < 1:
        return False, "native_tool_events missing or zero"

    short_test = (task.get("short_test") or "").strip()
    if not short_test or short_test == "-":
        return False, "short_test missing"
    code, output = run(
        "cd %s && %s" % (shlex.quote(worktree), short_test), timeout=600)
    detail = output.strip()[-800:] or "short_test produced no output"
    append_attempt_event(attempt, {
        "delivery_stage": "post-edit-transport-salvage",
        "transport_error": category,
        "native_tool_edit": True,
        "native_tool_events": native_events,
        "short_test_pass": code == 0,
        "artifact_paths": changed_artifacts,
        "artifact_ok": code == 0,
        "candidate_landed": False,
        "terminal_complete": False,
        "detail": detail,
    })
    if code != 0:
        return False, "short_test rc=%d: %s" % (code, detail)
    return True, "post-edit short_test PASS; transport_error=%s" % category


def retry_workspace_integration(line, task):
    candidate = _load_latest_candidate(line, task["id"])
    if not candidate or not os.path.isdir(candidate.get("worktree", "")):
        return False, 1
    started = time.monotonic()
    code, receipt = run_workspace_integrator(candidate)
    record_authorization_from_integration(line, task["id"], receipt)
    integration_ms = int((time.monotonic() - started) * 1000)
    append_attempt_event(candidate, {
        "queue_wait_ms": None, "run_ms": None,
        "integration_ms": integration_ms,
        "workspace_kb": _workspace_kb(candidate["worktree"]),
        "cas_retry_count": _attempt_cas_retry_count(candidate) + (
            1 if receipt.get("status") == "retryable_cas_conflict" else 0),
        "integration_status": receipt.get("status"),
        "landed_oid": receipt.get("landed_commit"),
    })
    if (receipt.get("status") == "retryable_content_conflict"
            and _attempt_content_conflict_count(candidate)
            >= INTEGRATION_CONTENT_CONFLICT_MAX_RETRIES):
        blocker = {
            "stage": "integration-pending",
            "candidate_oid": candidate["candidate_oid"],
            "landed_oid": receipt.get("landed_commit") or "",
            "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
            "attempt": candidate["attempt"],
        }
        append_attempt_event(candidate, {
            "integration_status": "machine_blocker_content_conflict",
            "machine_blocker": "content_conflict_unresolved",
            "candidate_landed": False,
            "terminal_complete": False,
            "detail": receipt.get("detail", "candidate content conflicts with latest canonical"),
        })
        rc = _mark_content_conflict_blocked(
            tasks_path(line), task, candidate["artifact_paths"],
            receipt.get("detail", "candidate content conflicts with latest canonical"),
            blocker)
        return True, rc
    if code == 0 and receipt.get("status") == "landed":
        args = argparse.Namespace(line=line, task=task["id"], judge=False,
                                  integration=(candidate, receipt))
        rc = cmd_try_complete(args)
        if rc == 0:
            _release_workspace_attempt(candidate)
        return True, rc
    if code == 75 or str(receipt.get("status", "")).startswith("retryable_"):
        _mark_settling(tasks_path(line), task, candidate["artifact_paths"],
                       receipt.get("detail", "integration retry pending"), {
                           "stage": "integration-pending",
                           "candidate_oid": candidate["candidate_oid"],
                           "landed_oid": receipt.get("landed_commit") or "",
                           "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
                           "attempt": candidate["attempt"],
                       })
        return True, 0
    return True, code or 1


def _git_tx_lock_busy():
    """共享提交事务锁是否被占（不阻塞读；只用于决定 skip/settling）。"""
    code, gp = git("rev-parse --git-path ob1-transaction.lock.d", timeout=10)
    path = (gp or "").strip() if code == 0 else ""
    if not path:
        path = os.path.join(ROOT, ".git", "ob1-transaction.lock.d")
    elif not os.path.isabs(path):
        path = os.path.join(ROOT, path)
    return os.path.isdir(path)


def land_is_retriable(detail):
    """land/push 失败是否应进入 settling（工作已验绿，只差传播）。

    永久失败（路径越界、helper 缺失）→ False，应硬 FAIL。
    锁忙 / push 被拒 / 网络 → True，不得把「已 short_test 过」打回「没干活」。
    """
    d = (detail or "")
    dl = d.lower()
    retriable_markers = (
        "另一提交事务",
        "rc=75",
        "exit 75",
        "index.lock",
        "unable to create",
        "could not write index",
        "git-sync",
        "push 失败",
        "rejected",
        "non-fast-forward",
        "fetch first",
        "timed out",
        "timeout",
        "network",
        "connection",
        "temporarily unavailable",
        "remote hung up",
        "lock",
    )
    return any(m.lower() in dl or m in d for m in retriable_markers)


def land_task_artifacts(line, task_id, artifacts):
    """cheap worker 禁 git；完成门要求 tracked+origin。由环 pathspec 提交并 push。

    兑现 cheap.sh 文案「Cortex validates and commits after you return」。
    只碰任务声明的 artifact_paths（+ 同任务 short_test 若是 checks/ 下脚本且脏）。
    返回 (ok, detail)；无可提交变化也算 ok。

    执行/结算解耦：调用方在 short_test 已过后若 ok=False 且 land_is_retriable，
    应标 settling 而非假装工作没做。
    """
    to_land = []
    for rel in artifacts:
        if not rel or rel == "-":
            continue
        repo_rel = _artifact_repo_rel(rel)
        if repo_rel is None:
            return False, "artifact 越出仓库边界 %s" % rel
        full = os.path.join(ROOT, repo_rel)
        if not os.path.exists(full):
            continue  # 缺失由上层 artifact 段报
        quoted = shlex.quote(repo_rel)
        code, status = git(
            "-c core.fsmonitor=false status --porcelain=v1 --untracked-files=all -- %s"
            % quoted, timeout=60)
        if code != 0:
            return False, "无法检查 artifact 状态 %s：%s" % (
                repo_rel, status.strip()[:200])
        if status.strip():
            to_land.append(repo_rel)
            continue
        # 干净但未 tracked（极罕见）也要落地
        code, tracked = git("ls-files -- %s" % quoted, timeout=30)
        if code != 0 or not tracked.strip():
            to_land.append(repo_rel)

    if not to_land:
        return True, "artifacts already clean"

    # 根 worktree 是调度/账本控制面，不再充当 Worker 提交区。任何真实写入只能
    # 来自 cortex-workspace attempt 的独立 index，再交 integrator 落 canonical。
    # 这里允许“已经 clean”的只读复核，但一旦需要 add/commit 就 fail closed。
    return False, "root-worktree-write-forbidden：artifact 必须在 attempt workspace 落地"


def _canonical_tip_for_path(ref, refresh=False, cache=None):
    """解析 canonical tip；完成门可刷新，task-show 只读模式绝不刷新。"""
    cache = cache if cache is not None else {}
    key = (ref, bool(refresh))
    if key in cache:
        return cache[key]

    effective_ref = ref
    remote_code, remote_url = git("remote get-url origin", timeout=30)
    if (not os.environ.get("CORTEX_CANONICAL_REF")
            and remote_code == 0
            and (remote_url.strip().startswith("/") or remote_url.strip().startswith("file://"))
            and git("rev-parse --verify %s^{commit}" % shlex.quote(ref), timeout=30)[0] != 0
            and git("rev-parse --verify refs/remotes/origin/main^{commit}", timeout=30)[0] == 0):
        effective_ref = "refs/remotes/origin/main"

    if refresh and effective_ref.startswith("refs/remotes/origin/"):
        branch = effective_ref[len("refs/remotes/origin/"):]
        code, out = _git_net_retry(
            "fetch --quiet origin '+refs/heads/%s:%s'" % (
                shlex.quote(branch), shlex.quote(effective_ref)),
            timeout=180, attempts=3, label="fetch_canonical_content",
        )
        if code != 0:
            result = (False, effective_ref, "", "canonical UNKNOWN：%s" % (
                out.strip().split("\n")[-1][:180] or "fetch 无输出"))
            cache[key] = result
            return result

    code, tip = git("rev-parse --verify %s^{commit}" % shlex.quote(effective_ref), timeout=30)
    tip = tip.strip().split("\n")[-1] if tip.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", tip):
        result = (False, effective_ref, "", "canonical ref 无法解析：%s" % effective_ref)
    else:
        result = (True, effective_ref, tip, "")
    cache[key] = result
    return result


def _inspect_artifact_canonical_binding(rel, refresh=False, cache=None):
    """同一口径证明 path 内容已经落 canonical，允许 integrator squash/replay。

    必要条件：本地 path 存在非空、tracked、clean、与 source commit 绑定；
    canonical ref 可解析，且 source commit:path 与 canonical tip:path 的 blob OID
    完全相同。提交祖先关系只作诊断，不再错误否决 content-equivalent landing。
    """
    cache = cache if cache is not None else {}
    item = {
        "path": rel,
        "local": {"state": "UNKNOWN", "detail": "尚未检查"},
        "commit": {"state": "UNKNOWN", "candidate_oid": "", "blob_oid": "",
                   "detail": "尚未检查"},
        "origin": {"state": "UNKNOWN", "detail": "尚未检查"},
        "canonical": {
            "state": "UNKNOWN", "ref": canonical_origin_ref(), "landed_oid": "",
            "blob_oid": "", "proof": "", "detail": "尚未检查",
        },
        "stage": "artifact-path", "rc": 1,
    }
    repo_rel = _artifact_repo_rel(rel)
    if repo_rel is None:
        item["local"] = {"state": "NO", "detail": "artifact 越出仓库边界"}
        item["detail"] = "%s：artifact 越出仓库边界" % rel
        return item
    full = os.path.join(ROOT, repo_rel)
    if not os.path.exists(full):
        item["local"] = {"state": "NO", "detail": "artifact 不存在"}
        item["detail"] = "%s：artifact 不存在" % repo_rel
        return item
    if os.path.isfile(full) and os.path.getsize(full) == 0:
        item["local"] = {"state": "NO", "detail": "artifact 是空文件"}
        item["detail"] = "%s：artifact 是空文件" % repo_rel
        return item
    item["local"] = {"state": "YES", "detail": "artifact 存在且非空"}
    quoted = shlex.quote(repo_rel)

    code, tracked = git("ls-files -- %s" % quoted, timeout=30)
    if code != 0:
        item["commit"].update({"detail": "git ls-files 无法读取"})
        item.update({"stage": "commit-binding", "rc": code or 1,
                     "detail": "%s：git ls-files 无法读取" % repo_rel})
        return item
    if not tracked.strip():
        item["commit"].update({"state": "NO", "detail": "artifact 尚未纳入 git"})
        item.update({"stage": "commit-binding", "rc": 1,
                     "detail": "%s：artifact 尚未纳入 git" % repo_rel})
        return item

    code, status = git(
        "-c core.fsmonitor=false status --porcelain=v1 --untracked-files=all -- %s"
        % quoted, timeout=30)
    if code != 0:
        item["commit"].update({"detail": "git status 无法读取"})
        item.update({"stage": "artifact-clean", "rc": code,
                     "detail": "%s：git status 无法读取" % repo_rel})
        return item
    if status.strip():
        item["commit"].update({"state": "NO", "detail": "artifact 有未提交变化"})
        item.update({"stage": "artifact-clean", "rc": 1,
                     "detail": "%s：artifact 有未提交变化" % repo_rel})
        return item

    code, commit = git("log -1 --format=%%H -- %s" % quoted, timeout=30)
    commit = commit.strip().split("\n")[-1] if commit.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", commit):
        item["commit"].update({"detail": "找不到 artifact 绑定提交"})
        item.update({"stage": "commit-binding", "rc": code or 1,
                     "detail": "%s：找不到 artifact 绑定提交" % repo_rel})
        return item
    code, _ = git("diff --quiet %s -- %s" % (commit, quoted), timeout=30)
    if code != 0:
        item["commit"].update({"state": "NO", "candidate_oid": commit,
                               "detail": "当前内容与绑定提交不一致"})
        item.update({"stage": "commit-binding", "rc": code,
                     "detail": "%s@%s：当前内容与绑定提交不一致" % (repo_rel, commit[:12])})
        return item
    code, local_blob = git("rev-parse --verify %s:%s" % (commit, quoted), timeout=30)
    local_blob = local_blob.strip().split("\n")[-1] if local_blob.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", local_blob):
        item["commit"].update({"state": "UNKNOWN", "candidate_oid": commit,
                               "detail": "无法解析 source commit:path blob"})
        item.update({"stage": "commit-binding", "rc": code or 1,
                     "detail": "%s@%s：无法解析 source blob" % (repo_rel, commit[:12])})
        return item
    item["commit"].update({"state": "YES", "candidate_oid": commit,
                           "blob_oid": local_blob, "detail": "当前内容已绑定提交 blob"})
    item["candidate_oid"] = commit

    origin_ok, origin_detail = _commit_on_local_origin_refs(commit)
    item["origin"] = ({"state": "YES", "detail": "缓存 origin ref 可达 source candidate"}
                      if origin_ok else {
                          "state": "UNKNOWN",
                          "detail": "%s；source commit 可因 squash/replay 不可达" % origin_detail,
                      })

    ok_tip, effective_ref, tip, tip_detail = _canonical_tip_for_path(
        canonical_origin_ref(), refresh=refresh, cache=cache)
    item["canonical"].update({"ref": effective_ref, "landed_oid": tip})
    item["canonical_ref"] = effective_ref
    item["landed_oid"] = tip
    if not ok_tip:
        item["canonical"]["detail"] = tip_detail
        item.update({"stage": "integration-pending", "rc": 75, "detail": tip_detail})
        return item
    code, canonical_blob = git("rev-parse --verify %s:%s" % (tip, quoted), timeout=30)
    canonical_blob = canonical_blob.strip().split("\n")[-1] if canonical_blob.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", canonical_blob):
        detail = "%s@%s：canonical tip 不含该 path" % (repo_rel, tip[:12])
        item["canonical"].update({"state": "NO", "detail": detail})
        item.update({"stage": "integration-pending", "rc": 1, "detail": detail})
        return item
    item["canonical"]["blob_oid"] = canonical_blob
    if local_blob != canonical_blob:
        detail = ("%s：canonical 内容不同（source_blob=%s canonical_blob=%s）" % (
            repo_rel, local_blob[:12], canonical_blob[:12]))
        item["canonical"].update({"state": "NO", "detail": detail})
        item.update({"stage": "integration-pending", "rc": 1, "detail": detail})
        return item

    ancestor = git("merge-base --is-ancestor %s %s" % (commit, tip), timeout=30)[0] == 0
    proof = "ancestor+exact-blob" if ancestor else "content-equivalent"
    detail = ("%s@%s：%s canonical landing；source blob 与 %s@%s exact match" % (
        repo_rel, commit[:12], proof, effective_ref, tip[:12]))
    item["canonical"].update({
        "state": "YES", "proof": proof, "detail": detail,
    })
    item.update({
        "stage": "canonical-landed", "rc": 0,
        "candidate_oid": commit, "landed_oid": tip, "canonical_ref": effective_ref,
        "proof": proof, "detail": detail,
    })
    return item


def _validate_artifact_delivery(rel, origin_cache=None):
    """完成门与 task-show 共用 exact blob canonical landing 判据。"""
    binding = _inspect_artifact_canonical_binding(
        rel, refresh=True, cache=origin_cache if origin_cache is not None else {})
    return binding.get("stage") == "canonical-landed", binding


def _inspect_worktree_canonical_content_binding(rel, refresh=False, cache=None):
    """Root 控制面 fast path：worktree 内容已与 canonical tip:path 等价。

    attempt/integrator 已把 artifact/check 落到 canonical 后，root worktree 可能
    仍相对本地 HEAD 呈 dirty（本地分支落后/分叉），但控制面不应因此重新 add/commit
    artifact。这里只证明两件事：本地 short_test 实际读取的文件内容，和 canonical tip
    中同一路径 blob 完全一致。若不一致，仍交给原 land 门 fail-closed。
    """
    cache = cache if cache is not None else {}
    repo_rel = _artifact_repo_rel(rel)
    item = {
        "path": rel,
        "stage": "worktree-canonical-content",
        "rc": 1,
        "canonical_ref": canonical_origin_ref(),
        "landed_oid": "",
        "proof": "",
        "detail": "尚未检查",
    }
    if repo_rel is None:
        item["detail"] = "%s：artifact 越出仓库边界" % rel
        return False, item
    full = os.path.join(ROOT, repo_rel)
    if not os.path.exists(full):
        item["detail"] = "%s：artifact 不存在" % repo_rel
        return False, item
    if os.path.isfile(full) and os.path.getsize(full) == 0:
        item["detail"] = "%s：artifact 是空文件" % repo_rel
        return False, item
    ok_tip, effective_ref, tip, tip_detail = _canonical_tip_for_path(
        canonical_origin_ref(), refresh=refresh, cache=cache)
    item["canonical_ref"] = effective_ref
    item["landed_oid"] = tip
    if not ok_tip:
        item["stage"] = "integration-pending"
        item["rc"] = 75
        item["detail"] = tip_detail
        return False, item
    quoted = shlex.quote(repo_rel)
    code, canonical_blob = git("rev-parse --verify %s:%s" % (tip, quoted), timeout=30)
    canonical_blob = canonical_blob.strip().split("\n")[-1] if canonical_blob.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", canonical_blob):
        item["stage"] = "integration-pending"
        item["detail"] = "%s@%s：canonical tip 不含该 path" % (repo_rel, tip[:12])
        return False, item
    code, worktree_blob = git("hash-object -- %s" % quoted, timeout=30)
    worktree_blob = worktree_blob.strip().split("\n")[-1] if worktree_blob.strip() else ""
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", worktree_blob):
        item["detail"] = "%s：无法计算 worktree blob" % repo_rel
        return False, item
    if worktree_blob != canonical_blob:
        item["detail"] = ("%s：worktree 内容未落 canonical（worktree_blob=%s canonical_blob=%s）"
                          % (repo_rel, worktree_blob[:12], canonical_blob[:12]))
        return False, item
    detail = ("%s：worktree 内容与 %s@%s exact match；root 控制面无需重新落 artifact"
              % (repo_rel, effective_ref, tip[:12]))
    item.update({
        "stage": "canonical-landed", "rc": 0,
        "candidate_oid": "", "landed_oid": tip,
        "canonical_ref": effective_ref,
        "blob_oid": worktree_blob,
        "proof": "worktree-content-equivalent",
        "detail": detail,
    })
    return True, item


def _try_complete_land_paths(task, artifacts, test):
    land_paths = list(artifacts)
    if test.startswith("bash brain-network/directions/") and "/checks/" in test:
        maybe = test.split()[-1] if test.split() else ""
        if maybe.endswith(".sh") and os.path.isfile(os.path.join(ROOT, maybe)):
            land_paths.append(maybe)
    return land_paths


def _mark_settling(path, task, artifacts, land_detail, delivery=None):
    """short_test 已过、git 传播暂不可用 → settling（第三态，不是失败）。"""
    updates = {
        "status": "settling", "updated_at": fmt(now()),
        "next_advance_after": "-",
    }
    if artifacts:
        updates["evidence"] = artifacts[0]
    set_cells(path, task["id"], updates)
    log("settling %s land=%s" % (task["id"], (land_detail or "")[:200]))
    print("SETTLING %s → short_test 已过，git 传播暂缓（%s）"
          % (task["id"], (land_detail or "")[:240]))
    print("      执行面已验绿；下一拍 tick 会只做 land，不重新 claim LLM")
    failure = {
        "stage": "artifact-land-deferred", "rc": 0,
        "detail": (land_detail or "")[:1200],
    }
    if isinstance(delivery, dict):
        failure["delivery_stage"] = delivery.get("stage", "")
        for key in ("candidate_oid", "landed_oid", "canonical_ref", "path"):
            if key in delivery:
                failure[key] = delivery[key]
    cmd_try_complete.last_failure = failure
    cmd_try_complete.last_delivery = delivery or {}
    return 0


def _mark_content_conflict_blocked(path, task, artifacts, detail, delivery=None):
    """Stop an exhausted content-conflict loop without manufacturing terminal success."""
    updates = {
        "status": "blocked", "updated_at": fmt(now()),
        "next_advance_after": "-",
    }
    if artifacts:
        updates["evidence"] = artifacts[0]
    set_cells(path, task["id"], updates, expected_status=("settling", "running"))
    reason = "MACHINE_BLOCKER: content_conflict_unresolved after bounded retries"
    log("MACHINE_BLOCKER %s integration=%s" % (task["id"], (detail or "")[:200]))
    print("MACHINE_BLOCKER %s → %s" % (task["id"], reason))
    failure = {
        "stage": "integration-content-conflict",
        "rc": 75,
        "integration_status": "machine_blocker_content_conflict",
        "machine_blocker": "content_conflict_unresolved",
        "detail": (detail or "")[:1200],
    }
    if isinstance(delivery, dict):
        failure.update({key: delivery[key] for key in (
            "candidate_oid", "landed_oid", "canonical_ref", "attempt"
        ) if key in delivery})
    cmd_try_complete.last_failure = failure
    cmd_try_complete.last_delivery = delivery or {}
    return 1


def _finalize_done_after_land(args, path, task, artifacts, land_paths, test):
    """origin 门 + 可选 checks 复验 + judge + 写 done。调用前 land 必须已 ok。"""
    origin_cache = {}
    deliveries = []
    # artifact 与同任务 checks 都是交付合同。只验 artifact 会允许“报告已落、
    # 验收脚本仍只在本机”的假完成；所有 land_paths 必须 exact blob 落 canonical。
    for rel in land_paths:
        # 完成门的第一判据是 short_test 实际读取的 worktree 内容已经与
        # canonical tip:path exact blob 等价。这样可兼容 integrator squash/replay
        # 以及 root 控制面相对本地 HEAD dirty 的正常状态；未等价时仍回到原
        # source-commit/canonical 绑定门，保持 fail-closed。
        valid, binding = _inspect_worktree_canonical_content_binding(
            rel, refresh=False, cache=origin_cache)
        if not valid:
            valid, binding = _validate_artifact_delivery(rel, origin_cache)
        if not valid:
            detail = binding.get("detail", "") if isinstance(binding, dict) else str(binding)
            if land_is_retriable(detail) or (
                isinstance(binding, dict)
                and binding.get("stage") in ("origin-reachable", "integration-pending")
            ):
                return _mark_settling(path, task, artifacts, detail, binding)
            cmd_try_complete.last_failure = binding
            print("FAIL %s: %s" % (task["id"], detail))
            return 1
        deliveries.append(binding)

    if any("/checks/" in (p or "") for p in land_paths):
        code, out = run("cd %s && %s" % (ROOT, test), timeout=600)
        if code != 0:
            cmd_try_complete.last_failure = {
                "stage": "short_test", "rc": code,
                "detail": "落地 checks 后复验失败：" + (out.strip()[:1000] or "无输出"),
            }
            print("FAIL %s: short_test 落地后复验失败\n%s" % (
                task["id"], out.strip()[:600]))
            return 1

    if getattr(args, "judge", False):
        executor = next((e.get("executor", "human") for e in clock_lines()
                         if e["line"] == args.line), "human")
        if executor != "human":
            v_exec, v_node, tier = pick_verifier(executor, node_profile())
            if v_exec is None:
                print("      ⚠️ 无独立验收者 —— 本次**仅机械门**，不假装做过 AI 验收")
                v_exec = None
            else:
                print("      独立验收：%s@%s（%s）" % (v_exec, v_node, tier))
            verdict, reason = (("ACCEPT", "无独立验收者，跳过") if v_exec is None
                               else ai_judge(args.line, v_exec, task))
            if verdict == "REJECT":
                cmd_try_complete.last_failure = {
                    "stage": "judge", "rc": 1, "detail": reason[:1200],
                }
                set_cell(path, task["id"], "updated_at", fmt(now()))
                log("judge REJECT %s/%s %s" % (args.line, task["id"], reason))
                print("FAIL %s: 机械门过了，但 AI 验收员否决 —— %s" % (task["id"], reason))
                return 1

    latest = pick(args.line, task["id"]) or task
    already_done = latest.get("status") == "done"
    if not set_cells(path, task["id"], {
        "status": "done", "fails": "0", "next_advance_after": "-",
        "updated_at": fmt(now()), "evidence": artifacts[0],
    }, expected_status=("pending", "running", "settling", "done")):
        cmd_try_complete.last_failure = {
            "stage": "state-cas", "rc": 75,
            "detail": "控制器已改变任务状态，完成门未覆盖新状态",
        }
        print("DEFER %s: 状态已被控制器改变，未覆盖为 done" % task["id"])
        return 75
    delivery_note = ",".join(
        "%s:candidate_oid=%s landed_oid=%s" % (
            d.get("path", "-"), d.get("candidate_oid", "")[:12],
            d.get("landed_oid", "")[:12]) for d in deliveries)
    log("done %s/%s %s" % (args.line, task["id"], delivery_note))
    print("PASS %s → done（证据 %s）" % (task["id"], artifacts[0]))
    if deliveries:
        print("      landing | candidate_oid=%s · landed_oid=%s · %s" % (
            deliveries[0].get("candidate_oid", "")[:12],
            deliveries[0].get("landed_oid", "")[:12],
            deliveries[0].get("canonical_ref", canonical_origin_ref())))
    if already_done:
        print("      credit | 已是 done，重复核验不重复记分（防刷分）")
    else:
        auto_credit_decided(args.line, task["id"], task.get("title", ""))
    cmd_try_complete.last_failure = {}
    cmd_try_complete.last_delivery = deliveries
    return 0


def settle_line_tasks(line):
    """只结算 status=settling 的任务：不 claim、不 LLM，只 land→origin→done。

    返回成功写成 done 的数量。git 仍忙则保持 settling，不把任务打回 pending。

    铁律（2026-08-01）：**git 事务锁忙 → 整批立刻 return 0**，不跑 short_test、
    不逐条空转。否则 settle 吃光整拍，pending 永远到不了 claim（running=0）。
    """
    path = tasks_path(line)
    settled = 0
    n_settling = sum(1 for t in load_tasks(line) if t.get("status") == "settling")
    if n_settling == 0:
        return 0
    # 锁忙：整批跳过，本拍把时间留给 claim pending
    if _git_tx_lock_busy():
        msg = ("settle| %s git 事务忙 → 跳过 %d 条 settling，优先 claim pending"
               % (line, n_settling))
        print(msg)
        log(msg)
        return 0
    for task in load_tasks(line):
        if task.get("status") != "settling":
            continue
        # 循环中锁再被占：立刻停，勿继续 short_test/land
        if _git_tx_lock_busy():
            msg = ("settle| %s git 事务中途变忙 → 中止 settle 余下任务，去 claim"
                   % line)
            print(msg)
            log(msg)
            break
        tid = task["id"]
        handled, integration_rc = retry_workspace_integration(line, task)
        if handled:
            if integration_rc == 0 and (pick(line, tid) or {}).get("status") == "done":
                settled += 1
                print("settle| %s attempt candidate → canonical → done" % tid)
            elif integration_rc != 0:
                print("settle| %s integration 仍未完成 rc=%s，保留工作舱" % (
                    tid, integration_rc))
            continue
        artifacts = [a for a in (task.get("artifact_paths") or "").split()
                     if a and a != "-"]
        if not artifacts:
            continue
        missing = False
        for rel in artifacts:
            full = rel if os.path.isabs(rel) else os.path.join(ROOT, rel)
            if not os.path.exists(full) or (
                    os.path.isfile(full) and os.path.getsize(full) == 0):
                print("settle| %s artifact 丢失，退回 pending 重做" % tid)
                set_cell(path, tid, "status", "pending")
                set_cell(path, tid, "updated_at", fmt(now()))
                missing = True
                break
        if missing:
            continue
        test = (task.get("short_test") or "").strip()
        if not test or test == "-":
            continue
        # 轻量再验：磁盘真值仍在才传播（超时收紧：settling 再验不应拖垮整拍）
        code, out = run("cd %s && %s" % (ROOT, test), timeout=90)
        if code != 0:
            print("settle| %s short_test 不再绿 → pending（%s）"
                  % (tid, out.strip()[:120]))
            set_cell(path, tid, "status", "pending")
            set_cell(path, tid, "updated_at", fmt(now()))
            continue
        if _git_tx_lock_busy():
            print("settle| %s git 事务仍忙，保持 settling（中止余下 settle）" % tid)
            break
        land_paths = _try_complete_land_paths(task, artifacts, test)
        ok_land, land_detail = land_task_artifacts(line, tid, land_paths)
        if not ok_land:
            if land_is_retriable(land_detail):
                print("settle| %s land 仍暂缓：%s" % (tid, land_detail[:160]))
                set_cell(path, tid, "updated_at", fmt(now()))
                # retriable 多半是 git/origin：别继续卡后续 settling
                if _git_tx_lock_busy() or "事务" in (land_detail or "") \
                        or "busy" in (land_detail or "").lower() \
                        or "SSL" in (land_detail or ""):
                    print("settle| %s 传播面暂缓 → 中止余下 settle，去 claim" % tid)
                    break
            else:
                print("settle| %s land 永久失败 → pending：%s"
                      % (tid, land_detail[:160]))
                set_cell(path, tid, "status", "pending")
                set_cell(path, tid, "updated_at", fmt(now()))
            continue
        # 复用 finalize：构造最小 args
        args = argparse.Namespace(line=line, task=tid, judge=False)
        rc = _finalize_done_after_land(args, path, task, artifacts, land_paths, test)
        if rc == 0 and pick(line, tid) and pick(line, tid).get("status") == "done":
            settled += 1
            print("settle| %s → done" % tid)
        elif rc == 0:
            # settling 保持
            pass
    return settled


def cmd_try_complete(args):
    cmd_try_complete.last_failure = {}
    cmd_try_complete.last_delivery = {}
    integration = getattr(args, "integration", None)
    if integration:
        candidate, receipt = integration
        return _complete_integrated_attempt(args, candidate, receipt)
    path = tasks_path(args.line)
    task = pick(args.line, args.task)
    if not task:
        cmd_try_complete.last_failure = {
            "stage": "contract", "rc": 1, "detail": "任务不存在",
        }
        print("找不到任务 %s" % args.task, file=sys.stderr)
        return 1
    if is_negative_test_sentinel(args.line, task):
        cmd_try_complete.last_failure = {
            "stage": "sentinel", "rc": 1,
            "detail": "反测哨兵按合同必须保持 blocked/红灯",
        }
        print("FAIL %s: 反测哨兵禁止完成；它的红灯就是完成门证据" % task["id"])
        return 1

    artifacts = [a for a in (task.get("artifact_paths") or "").split() if a and a != "-"]
    if not artifacts:
        cmd_try_complete.last_failure = {
            "stage": "artifact", "rc": 1, "detail": "无 artifact_paths",
        }
        print("FAIL %s: 无 artifact_paths，拒绝 done" % task["id"])
        return 1
    for rel in artifacts:
        full = rel if os.path.isabs(rel) else os.path.join(ROOT, rel)
        if not os.path.exists(full):
            cmd_try_complete.last_failure = {
                "stage": "artifact", "rc": 1, "detail": "artifact 缺失 %s" % rel,
            }
            print("FAIL %s: artifact 缺失 %s" % (task["id"], rel))
            return 1
        if os.path.isfile(full) and os.path.getsize(full) == 0:
            cmd_try_complete.last_failure = {
                "stage": "artifact", "rc": 1, "detail": "artifact 空文件 %s" % rel,
            }
            print("FAIL %s: artifact 空文件 %s" % (task["id"], rel))
            return 1

    test = (task.get("short_test") or "").strip()
    if not test or test == "-":
        cmd_try_complete.last_failure = {
            "stage": "contract", "rc": 1, "detail": "无 short_test",
        }
        print("FAIL %s: 无 short_test，拒绝 done" % task["id"])
        return 1

    # 先跑 short_test（认磁盘真值），过了再 land+origin 门。
    # 顺序：实现正确优先于传播；避免「没写对却先 commit 垃圾」。
    # settling 任务同样再验一次 short_test，防止传播过期产物。
    code, out = run("cd %s && %s" % (ROOT, test), timeout=600)
    if code != 0:
        # 若曾 settling 但工作区烂了，退回 pending 让执行面重做
        if task.get("status") == "settling":
            set_cells(path, task["id"], {
                "status": "pending", "updated_at": fmt(now()),
            }, expected_status="settling")
            print("FAIL %s: settling 期间 short_test 转红 → 退回 pending" % task["id"])
        cmd_try_complete.last_failure = {
            "stage": "short_test", "rc": code,
            "detail": out.strip()[:1200] or "short_test 无输出",
        }
        print("FAIL %s: short_test 退出码 %d\n%s" % (task["id"], code, out.strip()[:600]))
        return 1

    # cheap worker 禁 git → 环代精确 pathspec commit；传播统一交给 git-sync V4
    land_paths = _try_complete_land_paths(task, artifacts, test)
    origin_cache = {}
    canonical_ready = True
    for rel in land_paths:
        # Root 控制面只做 canonical 内容等价复核，不负责重新落 artifact。
        # 这里故意不 fetch：integrator/同步层已经负责刷新 refs/remotes/origin/*；
        # try-complete 若因网络刷新失败掉回 land_task_artifacts，会把“已 canonical
        # 落地、root worktree 相对本地 HEAD 仍 dirty”的正常状态误判成
        # root-worktree-write-forbidden。
        valid, _binding = _inspect_worktree_canonical_content_binding(
            rel, refresh=False, cache=origin_cache)
        if not valid:
            canonical_ready = False
            break
    if canonical_ready:
        return _finalize_done_after_land(
            args, path, task, artifacts, land_paths, test)

    # 事务锁忙时：不空转等 git，直接 settling（执行面已绿）
    if _git_tx_lock_busy():
        return _mark_settling(
            path, task, artifacts,
            "git 提交事务锁忙 — short_test 已过，传播延后")

    ok_land, land_detail = land_task_artifacts(args.line, task["id"], land_paths)
    if not ok_land:
        if land_is_retriable(land_detail):
            return _mark_settling(path, task, artifacts, land_detail)
        cmd_try_complete.last_failure = {
            "stage": "artifact-land", "rc": 1, "detail": land_detail[:1200],
        }
        print("FAIL %s: artifact 落地失败 — %s" % (task["id"], land_detail[:400]))
        return 1

    return _finalize_done_after_land(
        args, path, task, artifacts, land_paths, test)


# ── tick：心跳本体 ─────────────────────────────────────────────────────

def escalate(line, task, days):
    tier = "D+7 进日报" if days >= 7 else ("D+3 推 Discord" if days >= 3 else "D+0 报表")
    msg = "ESCALATE %s/%s 卡了 %d 天（%s）：%s" % (line, task["id"], days, tier, task.get("title"))
    print(msg)
    log(msg)
    if days >= 3 and os.environ.get("CORTEX_LOOP_ESCALATE") == "1":
        run("python3 %s/work-studio/devops/tools/openclaw/discord.py send "
            "'#AI体系建设' %s" % (ROOT, repr(msg)))


SYSTEMIC_FAIL_STATE = "/tmp/spotlight/cortex-loop-systemic-fail-escalate.json"
SYSTEMIC_FAIL_MIN_TASKS = 3      # ≥3 个不同任务同一失败签名才算"管线坏了"，不是"这个任务难"
SYSTEMIC_FAIL_MIN_FAILS = 2      # 单任务至少失败 2 次才计入（防止把首次偶发也算进去）
SYSTEMIC_FAIL_COOLDOWN_SEC = 3 * 3600   # 同一签名 3 小时只报一次，不刷屏


def _result_signature(line, task_id):
    """从 adapter 结果文件尾行提取失败签名。只锚定 `[adapter] ...` 这一行自己的
    rc=，不能拿正文里任意出现的 "rc=" 字样当签名——AI 交回报告里经常会写
    "跑了 `xxx.sh` → rc=0 PASS" 这种叙述句，早期实现把这类文本误判成"系统性
    infra 故障"（3 个任务因为报告里都提到 rc=0 被错误归为同一签名，实际它们
    是三个互不相关的真实任务质量缺口，不是同一个 bug）。

    adapter 自己 rc=0（真的执行成功）但任务仍 attempt-fail，说明卡点在任务自身
    验收标准没达标，是内容问题不是管线问题，单独归一类，不参与系统性统计——
    多个任务各自内容不达标是正常的"活还没干完"，不该被当成"基础设施坏了"报警。
    """
    path = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task_id)
    if not os.path.isfile(path):
        failure = load_failure_context(line, task_id)
        if not failure:
            return None
        if failure.get("stage") == "adapter" and int(failure.get("rc") or 0) != 0:
            return "adapter-rc=%s" % failure.get("rc")
        return "content-fail"
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            tail = fh.readlines()[-8:]
    except OSError:
        return None
    for ln in reversed(tail):
        if not ln.startswith("[adapter]"):
            continue
        m = re.search(r"\brc=(\d+)\b", ln)
        if not m:
            continue
        rc = m.group(1)
        if rc == "0":
            return "content-fail"   # adapter 成功，任务自身验收没过——不算系统性
        return "adapter-rc=%s" % rc
    return None


def _systemic_fail_signature_groups(line):
    """纯计算、无副作用：按失败签名给当前任务分组（只保留过了 MIN_FAILS 门槛的）。

    detect_systemic_failure() 与只读子命令 systemic-status 共用这一份逻辑——
    2026-07-31 dashboard 问题优先重排需要"现在是否疑似系统性故障"这个实时判断，
    但 detect_systemic_failure() 本身会写状态文件 + 发 Discord + 受 3h 冷却限速，
    不能直接被 dashboard 每次渲染都调用（会重复告警/污染冷却状态）。拆出这个
    纯函数，两边各自决定要不要有副作用，判定口径不分叉。
    """
    sig_tasks = {}
    for task in load_tasks(line):
        if is_negative_test_sentinel(line, task):
            continue
        try:
            fails = int(task.get("fails") or 0)
        except ValueError:
            fails = 0
        if fails < SYSTEMIC_FAIL_MIN_FAILS:
            continue
        sig = _result_signature(line, task["id"])
        if not sig or sig == "content-fail":
            continue   # 任务自身验收没过，各任务互不相关，不计入系统性统计
        sig_tasks.setdefault(sig, []).append(task["id"])
    return sig_tasks


def detect_systemic_failure(line):
    """区分「这个任务难」vs「整条管线坏了」——GROUND 律 N 步：该系统自己判的不能
    等 3 天 Discord 阈值才让人知道。同一失败签名命中 ≥3 个不同任务，直接判定为
    infra 级系统性故障，立刻报（不受 escalate() 的 D+3 天限速），而不是让每个
    任务各自孤立地慢慢升级——2026-07-31 凌晨 cheap.sh 路由 bug 曾让 7+ 个任务
    各自安静重试到天亮，没人在几小时内就意识到是同一个根因。
    """
    sig_tasks = _systemic_fail_signature_groups(line)

    try:
        with open(SYSTEMIC_FAIL_STATE, "r", encoding="utf-8") as fh:
            state = json.load(fh)
    except (OSError, ValueError):
        state = {}

    fired = []
    for sig, ids in sig_tasks.items():
        if len(ids) < SYSTEMIC_FAIL_MIN_TASKS:
            continue
        key = "%s:%s" % (line, sig)
        last = state.get(key, 0)
        if time.time() - last < SYSTEMIC_FAIL_COOLDOWN_SEC:
            continue
        msg = ("SYSTEMIC-FAIL %s 签名 %s 命中 %d 个不同任务（%s）—— "
               "疑似 infra 级故障非个别任务难，立刻报不等 D+3") % (
            line, sig, len(ids), ",".join(sorted(ids)[:6]))
        print(msg)
        log(msg)
        if os.environ.get("CORTEX_LOOP_ESCALATE") == "1":
            run("python3 %s/work-studio/devops/tools/openclaw/discord.py send "
                "'#AI体系建设' %s" % (ROOT, repr(msg)))
        state[key] = time.time()
        fired.append(sig)

    if fired:
        os.makedirs(os.path.dirname(SYSTEMIC_FAIL_STATE), exist_ok=True)
        with open(SYSTEMIC_FAIL_STATE, "w", encoding="utf-8") as fh:
            json.dump(state, fh)
    return fired


def cmd_systemic_status(args):
    """只读子命令：现在是否有信号命中系统性故障阈值(≥3 个不同任务同一失败签名)。

    2026-07-31 dashboard 问题优先重排新增——白盒需要在渲染当下就知道「疑似
    整条管线坏了」，不能等 tick 下一拍 detect_systemic_failure() 真正 fire
    才写进状态文件。本命令零副作用：不写 SYSTEMIC_FAIL_STATE、不发 Discord、
    不受 3h 冷却限速，只读同一份签名分组逻辑（_systemic_fail_signature_groups）
    给出"此刻"的判定，state 文件里的历史 fire 记录仅作 last_escalated_at 参考。
    """
    lines = [args.line] if args.line else [entry["line"] for entry in clock_lines()]
    try:
        with open(SYSTEMIC_FAIL_STATE, "r", encoding="utf-8") as fh:
            state = json.load(fh)
    except (OSError, ValueError):
        state = {}

    out = {"lines": [], "any_active": False}
    for line in lines:
        groups = _systemic_fail_signature_groups(line)
        sigs = []
        for sig, ids in groups.items():
            if len(ids) < SYSTEMIC_FAIL_MIN_TASKS:
                continue
            key = "%s:%s" % (line, sig)
            last = state.get(key)
            sigs.append({
                "signature": sig,
                "task_ids": sorted(ids),
                "count": len(ids),
                "last_escalated_at": (
                    datetime.utcfromtimestamp(last).isoformat() + "Z" if last else None
                ),
            })
        if sigs:
            out["any_active"] = True
        out["lines"].append({"line": line, "signatures": sigs})

    if getattr(args, "json", False):
        print(json.dumps(out, ensure_ascii=False))
    else:
        if not out["any_active"]:
            print("SYSTEMIC-STATUS: 无系统性故障信号")
        for entry in out["lines"]:
            for sig in entry["signatures"]:
                print("SYSTEMIC-STATUS %s 签名 %s 命中 %d 个任务：%s"
                      % (entry["line"], sig["signature"], sig["count"],
                         ",".join(sig["task_ids"])))
    return 0


# ── explain：统一底层真值解释入口(节点/任务/机制三态统一格式，IMM-T31)────
# 动机：查一个节点/任务/机制的真实状态，此前要手动 grep 日志 + 读 TASKS.md +
# 拼好几个命令才能回答。三段式输出(现状/原因/证据)三种目标类型统一格式，
# 机器可解析、人也能顺着"证据"自己去核实——不是"相信 AI 说的"，是"AI 指给你
# 看在哪"。ATOMIZE 律：全部复用已有的 haas_score/read_swarm/load_tasks/
# node_id/_systemic_fail_signature_groups，不重新发明判据。

EXPLAIN_TOPICS = {}  # topic 名 → 处理函数；新增 topic 只需注册一行，不写 if-elif


def _explain_register(name):
    def deco(fn):
        EXPLAIN_TOPICS[name] = fn
        return fn
    return deco


def _explain_fmt(target, status_line, why_lines, evidence_lines):
    """三段式统一渲染器：现状 / 原因 / 证据。node/task/topic 三种目标类型
    共用同一格式——下游脚本只需认这一种输出，不必分别解析三套格式。"""
    out = ["EXPLAIN %s" % target]
    out.append("现状: %s" % (status_line or "-"))
    why_lines = [w for w in (why_lines or []) if w] or ["（无）"]
    evidence_lines = [e for e in (evidence_lines or []) if e] or ["（无）"]
    out.append("原因: %s" % why_lines[0])
    for extra in why_lines[1:]:
        out.append("      %s" % extra)
    out.append("证据: %s" % evidence_lines[0])
    for extra in evidence_lines[1:]:
        out.append("      %s" % extra)
    return "\n".join(out)


def _node_file_snapshot(node):
    """本地 git 快照文件(_swarm/<node>.md)里的字段——这份文件可能与 ref 层
    不同步(某节点从不 commit+push 自己的画像文件回 origin)。本函数存在的
    唯一意义就是暴露"文件看起来的状态" vs "ref 层真的是"的落差。"""
    path = os.path.join(SWARM, "%s.md" % node)
    if not os.path.isfile(path):
        return None
    _, _, rows = read_table(path, key="字段")
    return {r["字段"]: r["值"] for _, r in rows if r.get("字段")}


def explain_node(node_arg):
    """解释一个节点：活不活(ref 层精确心跳 vs 本地快照文件落差) + 信任分(HAAS)
    + 最近在跑什么。只读本地已有 ref(与 cmd_swarm/cmd_status 既有行为一致)，
    不额外触发 fetch_refs()，不新增隐式网络调用。"""
    nodes = read_swarm()
    prof = nodes.get(node_arg)
    if prof is None:
        return None
    alive, alive_why = node_alive(prof)
    score, meta = haas_score(node_arg)
    level = trust_level(score)
    precise = beat_ref_precise_seen(prof)
    beat_ref = "%s/%s" % (BEAT_NS, node_arg)

    status_line = "%s | HAAS=%.3f(%s) | owns=%s" % (
        "存活" if alive else "疑似离线", score, level, prof.get("owns", "-"))

    why = [
        "存活判定：%s（quiet_limit=%dh，can_sleep=%s）"
        % (alive_why, quiet_limit(prof), prof.get("can_sleep", "?")),
        "HAAS 构成：%s" % meta.get("note", "-"),
    ]

    # 看起来 vs 真的是：本地快照文件字段 vs ref 层精确心跳时间的落差。
    # 这正是 2026-07-31 worker 案例(IMM-T30)的真实根因：worker 心跳其实一直在
    # 跑(ref 层每拍都推)，但 _swarm/worker.md 这份文件从未 commit+push 回
    # origin，laptop 侧只读文件就会误判成离线。
    snap = _node_file_snapshot(node_arg)
    if snap is not None and precise is not None:
        snap_seen = parse_ts(snap.get("last_seen"))
        if snap_seen is not None:
            gap_h = (precise - snap_seen).total_seconds() / 3600
            if gap_h > 1:
                why.append(
                    "⚠️ 看起来 vs 真的是：本地快照文件 last_seen=%s 落后 ref 层实测心跳 %.1fh"
                    "——该节点心跳其实一直在跑，只是这份 .md 文件没被重新"
                    "commit+push 回 origin；只读文件会误判离线，ref 层才是真相源"
                    % (snap.get("last_seen"), gap_h))
    elif precise is None:
        why.append("ref 层本地读不到精确心跳时间（可能本地未 fetch，或该节点从未推过心跳）")

    evidence = [
        "beat ref: %s（commit 时间=%s）"
        % (beat_ref, fmt(precise) if precise else "读不到"),
        "haas 样本: RESULT_NS=%s samples=%s effective=%s incidents=%s"
        % (RESULT_NS, meta.get("samples"), meta.get("effective_samples"), meta.get("incidents")),
        "本地快照文件: brain-network/directions/_swarm/%s.md（last_seen=%s）"
        % (node_arg, (snap or {}).get("last_seen", "文件不存在")),
        "复核命令: git log -1 --format=%%ci %s" % beat_ref,
    ]
    return _explain_fmt("node=%s" % node_arg, status_line, why, evidence)


def _find_credit_for_task(line, task_id):
    """在 RESULT_NS 里找这条任务的记分事件。task_id 命名约定改过(IMM-T12 加
    line 前缀之前是裸 "T20" 这种)，旧 credit ref 的 detail 可能还是旧写法——
    exact 匹配不到就退一步按去前缀的短 id 匹配，并在证据里如实标注用的是哪种匹配。
    返回 (node, when, kind, gate, ref, matched_by) 或 None。"""
    short_id = task_id.rsplit("-", 1)[-1] if "-" in task_id else task_id
    exact = "%s/%s " % (line, task_id)
    fallback = "%s/%s " % (line, short_id)
    best = None
    for ref in list_refs(RESULT_NS):
        kv = parse_kv(read_ref(ref))
        detail = kv.get("detail", "")
        matched_by = None
        if detail.startswith(exact):
            matched_by = "精确 id"
        elif short_id != task_id and detail.startswith(fallback):
            matched_by = "旧短 id（改名前）"
        if matched_by is None:
            continue
        when = kv.get("finished") or kv.get("event_at") or "-"
        if best is None or when > best[1]:
            best = (kv.get("node", "-"), when, kv.get("kind", "-"), kv.get("gate", "-"),
                    ref, matched_by)
    return best


def _extract_result_summary(path, max_chars=500):
    """从 adapter/cortex 执行回执文件里抽人话摘要,不是把整份贴出来。优先抓
    "一句话状态"小节正文；没有就退回去掉 [adapter]/[cortex] 标记行后的最后
    几行正文——两种回执风格都能给出有意义的"为什么"而不是只报 blocked 三个字。"""
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            lines = fh.read().split("\n")
    except OSError:
        return None
    for idx, ln in enumerate(lines):
        if "一句话状态" in ln:
            tail = [t.strip() for t in lines[idx + 1:]
                    if t.strip() and not t.startswith("[adapter]") and not t.startswith("[cortex]")]
            if tail:
                return " ".join(tail)[:max_chars]
    body = [ln.strip() for ln in lines
            if ln.strip() and not ln.startswith("[adapter]") and not ln.startswith("[cortex]")]
    if not body:
        return None
    return " ".join(body[-3:])[:max_chars]


def explain_task(arg):
    """解释一条任务：现在的 status/fails；blocked/pending 且有失败记录时从
    执行回执文件摘出真实卡点(不是只说三个字"blocked")；done 则说明谁做的、
    什么时候、有没有被记分。"""
    if "/" not in arg:
        return None
    line, task_id = arg.split("/", 1)
    path = tasks_path(line)
    if not os.path.isfile(path):
        return None
    task = next((t for t in load_tasks(line) if t.get("id") == task_id), None)
    if task is None:
        return None

    status = task.get("status", "?")
    try:
        fails = int(task.get("fails") or 0)
    except ValueError:
        fails = 0
    status_line = "status=%s fails=%d | %s" % (status, fails, task.get("title", "-"))

    why, evidence = [], []
    result_path = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task_id)

    if status == "done":
        credit = _find_credit_for_task(line, task_id)
        if credit:
            node, when, kind, gate, ref, matched_by = credit
            why.append("由 %s 于 %s 完成并记分（kind=%s gate=%s，匹配方式=%s）"
                       % (node, when, kind, gate, matched_by))
            evidence.append("credit ref: %s" % ref)
        else:
            why.append("状态=done，但在 %s 下未找到匹配的 credit 事件"
                       "（可能记分早于机制上线、或从未走 try-complete 自动记分）" % RESULT_NS)
            evidence.append("已按精确 id 与旧短 id 两种写法搜索 %s，均未命中" % RESULT_NS)
        why.append("产出证据列 evidence=%s" % (task.get("evidence") or "-"))
        evidence.append("任务行来源: %s（id=%s）" % (path, task_id))
    elif status in ("blocked", "pending", "waiting_external") and fails > 0:
        summary = _extract_result_summary(result_path)
        if summary:
            why.append("最近一次执行回执摘要：%s" % summary)
            evidence.append("执行回执文件: %s" % result_path)
        else:
            why.append("fails=%d 但本机没有对应回执文件（可能在别的节点执行、或回执已被清理）"
                       % fails)
            evidence.append("查找路径（不存在）: %s" % result_path)
        why.append("已知失败模式(failure_modes 列)：%s" % (task.get("failure_modes") or "-"))
        evidence.append("任务行来源: %s（id=%s）" % (path, task_id))
    else:
        why.append("success_criteria: %s" % (task.get("success_criteria") or "-"))
        evidence.append("任务行来源: %s（id=%s）" % (path, task_id))

    return _explain_fmt("task=%s/%s" % (line, task_id), status_line, why, evidence)


@_explain_register("systemic-failure")
def _explain_topic_systemic_failure():
    """复用 _systemic_fail_signature_groups（同一份判据，不重复造轮子）：
    是否有失败签名命中 ≥SYSTEMIC_FAIL_MIN_TASKS 个不同任务——那才是"管线坏了"
    而不是"这个任务难"。零副作用，不写 SYSTEMIC_FAIL_STATE、不发 Discord。"""
    active = []
    lines_checked = []
    for entry in clock_lines():
        line = entry["line"]
        lines_checked.append(line)
        groups = _systemic_fail_signature_groups(line)
        for sig, ids in groups.items():
            if len(ids) >= SYSTEMIC_FAIL_MIN_TASKS:
                active.append((line, sig, sorted(ids)))

    if active:
        status_line = "%d 条线命中系统性故障签名（阈值 ≥%d 个不同任务同签名）" % (
            len(active), SYSTEMIC_FAIL_MIN_TASKS)
        why = ["命中：" + "; ".join("%s 签名=%s 任务=%s" % (ln, sig, ",".join(ids[:6]))
                                    for ln, sig, ids in active)]
    else:
        status_line = "当前无系统性故障签名命中（已扫 %d 条线）" % len(lines_checked)
        why = ["逐线对 fails≥%d 的任务按 adapter 失败签名分组，未发现单签名覆盖 ≥%d 个不同任务"
               % (SYSTEMIC_FAIL_MIN_FAILS, SYSTEMIC_FAIL_MIN_TASKS)]
    why.append("判据：adapter rc=0 但任务不达标记为 content-fail，不计入系统性统计"
               "（互不相关的内容问题≠管线坏了）")
    evidence = [
        "判据函数: bin/cortex-loop _systemic_fail_signature_groups() / detect_systemic_failure()",
        "冷却/上次上报状态文件: %s" % SYSTEMIC_FAIL_STATE,
        "回执来源: /tmp/spotlight/cortex-loop-<line>-<task_id>.result",
        "同等价只读命令: cortex-loop systemic-status --json",
    ]
    return status_line, why, evidence


@_explain_register("credit-mechanism")
def _explain_topic_credit_mechanism():
    """记分机制现状：RESULT_NS 里累计多少条 credit 事件、按 kind 分布、
    机制是否已过冷启动回溯期。复用 KIND_WEIGHT/MECHANISM_LIVE 既有常量。"""
    refs = list_refs(RESULT_NS)
    by_kind = {}
    latest = None
    for ref in refs:
        kv = parse_kv(read_ref(ref))
        kind = kv.get("kind", "?")
        by_kind[kind] = by_kind.get(kind, 0) + 1
        when = kv.get("finished") or kv.get("event_at") or ""
        if when and (latest is None or when > latest[0]):
            latest = (when, kv.get("node", "-"), kind, ref)

    live_dt = parse_ts(MECHANISM_LIVE)
    live_note = ("已过 MECHANISM_LIVE=%s（新事件必须带合法 kind 才入账）" % MECHANISM_LIVE
                 if live_dt and now() >= live_dt else
                 "尚未到 MECHANISM_LIVE=%s（冷启动回溯宽限期内）" % MECHANISM_LIVE)

    status_line = "累计 %d 条 credit 事件，按 kind 分布：%s" % (
        len(refs), (" ".join("%s=%d" % kv for kv in sorted(by_kind.items())) or "（无）"))
    why = [
        "权重表 KIND_WEIGHT：L1 decided/self-fixed=1.0 · L2 defect-reported=1.5 · "
        "L3 defect-fixed=2.0 · L4 correct-refusal=3.0 · L5 mechanism-adopted=5.0",
        "机制上线状态：%s" % live_note,
    ]
    if latest:
        why.append("最近一条：%s @ %s（kind=%s）" % (latest[1], latest[0], latest[2]))
    evidence = [
        "ref 命名空间: RESULT_NS=%s" % RESULT_NS,
        "记分函数: bin/cortex-loop auto_credit_decided() / cmd_credit()",
        "权重定义: bin/cortex-loop KIND_WEIGHT / MECHANISM_LIVE",
    ]
    if latest:
        evidence.append("最近事件 ref: %s" % latest[3])
    return status_line, why, evidence


@_explain_register("resource-gate")
def _explain_topic_resource_gate():
    """当前执行器额度门现状：本节点已声明的执行器里，哪些正处于抑制期
    (额度耗尽/认证故障)。复用既有的抑制判定 + 状态文件，不重算判据。"""
    prof = node_profile()
    executors = [e for e in (prof.get("executors") or "").split() if e]
    rows = [(name,) + exec_suppressed(name) for name in executors]
    suppressed_n = sum(1 for _, hushed, _, _ in rows if hushed)

    status_line = "本节点 %d 个已声明执行器中 %d 个处于抑制期" % (len(executors), suppressed_n)
    why = [
        "逐个判据：" + ("; ".join(
            "%s=%s" % (n, ("抑制中(%s，剩%dmin)" % (k, l) if h else "可用"))
            for n, h, k, l in rows) or "（本节点未声明任何执行器）"),
        "llm-heavy 类任务只有在 executor 未被抑制且对应 adapter 文件存在时才会被 "
        "select_task_rows 放行；额度类抑制 %dh 窗口自动到期，认证/配置类需人处理" % QUOTA_WINDOW_H,
    ]
    evidence = [
        "抑制状态文件: %s" % EXEC_STATE,
        "判据来源: bin/cortex-loop 里的抑制判定与写入两个函数（判断用 suppressed 后缀名 / "
        "写入用 suppress 前缀名）",
        "节点画像来源: node_profile().executors（本机现算，非缓存）",
    ]
    return status_line, why, evidence


def cmd_explain(args):
    target = "?"
    try:
        if args.node:
            target = "node=%s" % args.node
            out = explain_node(args.node)
        elif args.task:
            target = "task=%s" % args.task
            out = explain_task(args.task)
        elif args.topic:
            target = "topic=%s" % args.topic
            handler = EXPLAIN_TOPICS.get(args.topic)
            if handler is None:
                out = None
            else:
                status_line, why, evidence = handler()
                out = _explain_fmt(target, status_line, why, evidence)
        else:
            print("UNKNOWN: 必须指定 --node / --task / --topic 其一", file=sys.stderr)
            return 2
    except Exception as diag_exc:  # noqa: BLE001 — explain 是诊断入口，内部异常必须降级
        # 为可读输出而不是甩 Python 堆栈；诊断工具本身崩溃比"查不到"更糟。
        print("UNKNOWN: %s 查询时发生内部异常（%s: %s）"
              % (target, type(diag_exc).__name__, diag_exc))
        return 1
    if out is None:
        print("UNKNOWN: %s 不存在或查不到" % target)
        return 1
    print(out)
    return 0


def _task_lock_path(line, task_id):
    token = hashlib.sha256((line + "\0" + task_id).encode("utf-8")).hexdigest()[:20]
    return "/tmp/spotlight/cortex-task-%s.lock" % token


def acquire_task_lock(line, task_id):
    """只排除同一任务重复 Worker；不同任务互不阻塞。"""
    key = (line, task_id)
    if key in _TASK_LOCK_HANDLES:
        return True
    os.makedirs("/tmp/spotlight", exist_ok=True)
    handle = open(_task_lock_path(line, task_id), "a+", encoding="utf-8")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        return False
    handle.seek(0)
    handle.truncate()
    handle.write(str(os.getpid()))
    handle.flush()
    _TASK_LOCK_HANDLES[key] = handle
    return True


def task_lock_busy(line, task_id):
    """只读探测任务 Worker 是否仍活着；不靠陈旧 PID 文件猜。"""
    handle = open(_task_lock_path(line, task_id), "a+", encoding="utf-8")
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.close()
        return True
    fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    handle.close()
    return False


def _retry_delay_min(fails):
    """失败重试 15/30/60/120 分钟封顶；成功窗口不能拿来惩罚失败。"""
    return min(15 * (2 ** max(0, fails - 1)), 120)


TASK_CONTRACT_FIELDS = (
    "title", "depends_on", "success_criteria", "failure_modes",
    "artifact_paths", "short_test", "leverage", "cost_estimate", "resource_class", "role",
)


def _short_test_snapshot(task):
    parts = shlex.split((task.get("short_test") or "").strip())
    if not parts:
        return None, None
    candidate = parts[-1]
    full = candidate if os.path.isabs(candidate) else os.path.join(ROOT, candidate)
    if not os.path.isfile(full):
        return full, None
    with open(full, "rb") as fh:
        return full, fh.read()


def enforce_execution_bounds(line, original, test_path, test_bytes):
    """执行器可改产出代码，但不可改任务合同、状态或自己的验收尺。"""
    path = tasks_path(line)
    fresh = pick(line, original["id"]) or {}
    violations = []
    for field in TASK_CONTRACT_FIELDS:
        if fresh.get(field, "") != original.get(field, ""):
            set_cell(path, original["id"], field, original.get(field, "") or "-")
            violations.append("task.%s" % field)
    if fresh.get("status") != "running":
        set_cell(path, original["id"], "status", "running")
        violations.append("task.status")
    if fresh.get("evidence") not in ("", "-"):
        set_cell(path, original["id"], "evidence", "-")
        violations.append("task.evidence")
    if test_path and test_bytes is not None and os.path.isfile(test_path):
        with open(test_path, "rb") as fh:
            current = fh.read()
        if current != test_bytes:
            with open(test_path, "wb") as fh:
                fh.write(test_bytes)
            violations.append("short_test")
    if violations:
        detail = "%s/%s 越权修改 %s，已机械还原" % (
            line, original["id"], ",".join(violations))
        record_incident(node_id(), "C1-越界", detail)
        record_authorization_incident(
            line, original["id"], "out_of_scope_write", detail)
        log("execution-boundary VIOLATION %s" % detail)
        print("guard | %s" % detail)
    return not violations


def _guard_paths(line, task_id):
    stem = "/tmp/spotlight/cortex-loop-%s-%s" % (line, task_id)
    return stem + ".guard.json", stem + ".short-test.snapshot"


def write_execution_guard(line, task, test_path, test_bytes):
    meta_path, snapshot_path = _guard_paths(line, task["id"])
    with open(meta_path, "w", encoding="utf-8") as fh:
        json.dump({"task": task, "test_path": test_path}, fh, ensure_ascii=False)
    if test_bytes is not None:
        with open(snapshot_path, "wb") as fh:
            fh.write(test_bytes)


def load_execution_guard(line, task_id):
    meta_path, snapshot_path = _guard_paths(line, task_id)
    if not os.path.isfile(meta_path):
        return None
    with open(meta_path, encoding="utf-8") as fh:
        meta = json.load(fh)
    test_bytes = None
    if os.path.isfile(snapshot_path):
        with open(snapshot_path, "rb") as fh:
            test_bytes = fh.read()
    return meta.get("task") or {}, meta.get("test_path"), test_bytes


def _mark_attempt_failed(line, task, executor, rc, adapter_succeeded, failure=None):
    failure = failure or {
        "stage": "adapter" if not adapter_succeeded else "unknown",
        "rc": rc, "detail": "未捕获失败输出",
    }
    fresh = pick(line, task["id"]) or {}
    try:
        fails = int(fresh.get("fails") or 0) + 1
    except ValueError:
        fails = 1
    retry_min = _retry_delay_min(fails)
    path = tasks_path(line)
    if not set_cells(path, task["id"], {
            "fails": str(fails), "status": "pending",
            "next_advance_after": fmt(now() + timedelta(minutes=retry_min)),
            "updated_at": fmt(now()),
    }, expected_status=("running", "pending")):
        log("attempt FAIL %s/%s 状态已被控制器改写，保留新状态" % (line, task["id"]))
        return rc
    print("fail  | %s/%s rc=%d retry=+%dmin fails=%d"
          % (line, task["id"], rc, retry_min, fails))
    log("attempt FAIL %s/%s rc=%d retry=+%dmin fails=%d"
        % (line, task["id"], rc, retry_min, fails))
    failure = persist_failure_context(line, task["id"], failure)
    result_file = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task["id"])
    try:
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex-failure] %s\n" % json.dumps(
                failure, ensure_ascii=False, sort_keys=True))
    except OSError:
        pass
    if adapter_succeeded and fails >= 2 and executor != "human":
        ai_diagnose(line, executor, fresh or task, fails, failure=failure)
    return rc


def recover_completed_attempt(line, task, executor):
    """父进程死后，下一拍从 attempt 现场接着验收，不丢已完成的工作。

    恢复优先级：
      1. 已发布 candidate receipt：直接重试 integration。
      2. 脏 attempt worktree：重新走 candidate -> integration。
      3. legacy result file：按旧路径 submit/try-complete。

    第 2 点是重启恢复的关键。电脑重启会杀掉父 worker 和 /tmp 结果文件，
    但独立 sparse worktree 在磁盘上仍然保留；只靠 result file 会把真实中间产物
    当成“没发生过”，导致重复 claim 和重复烧模型。
    """
    candidate = _load_latest_candidate(line, task["id"])
    if candidate and os.path.isdir(candidate.get("worktree", "")):
        print("recover | %s/%s 找到 candidate attempt=%s → 重试 integration" % (
            line, task["id"], candidate["attempt"]))
        handled, _rc = retry_workspace_integration(line, task)
        return handled
    attempt = _load_latest_attempt_claim(line, task["id"])
    if attempt and _workspace_has_changes(attempt.get("worktree")):
        print("recover | %s/%s 找到脏 attempt worktree=%s → 继续 candidate/integration" % (
            line, task["id"], attempt["attempt"]))
        try:
            candidate = commit_workspace_candidate(attempt, task)
        except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
            _mark_attempt_failed(line, task, executor, 2, True, failure={
                "stage": "candidate-recovery", "rc": 2, "detail": str(exc),
                "attempt": attempt.get("attempt"), "worktree": attempt.get("worktree"),
            })
            return True
        code, receipt = run_workspace_integrator(candidate)
        record_authorization_from_integration(line, task["id"], receipt)
        append_attempt_event(candidate, {
            "queue_wait_ms": None, "run_ms": None, "integration_ms": None,
            "workspace_kb": _workspace_kb(candidate["worktree"]),
            "cas_retry_count": _attempt_cas_retry_count(candidate) + (
                1 if receipt.get("status") == "retryable_cas_conflict" else 0),
            "integration_status": receipt.get("status"),
            "landed_oid": receipt.get("landed_commit"),
            "recovery": "dirty-worktree",
        })
        if (receipt.get("status") == "retryable_content_conflict"
                and _attempt_content_conflict_count(candidate)
                >= INTEGRATION_CONTENT_CONFLICT_MAX_RETRIES):
            blocker = {
                "stage": "integration-pending",
                "candidate_oid": candidate["candidate_oid"],
                "landed_oid": receipt.get("landed_commit") or "",
                "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
                "attempt": candidate["attempt"],
            }
            append_attempt_event(candidate, {
                "integration_status": "machine_blocker_content_conflict",
                "machine_blocker": "content_conflict_unresolved",
                "candidate_landed": False,
                "terminal_complete": False,
                "detail": receipt.get("detail", "candidate content conflicts with latest canonical"),
                "recovery": "dirty-worktree",
            })
            _mark_content_conflict_blocked(
                tasks_path(line), task, candidate["artifact_paths"],
                receipt.get("detail", "candidate content conflicts with latest canonical"),
                blocker)
            return True
        if code == 0 and receipt.get("status") == "landed":
            rc = cmd_try_complete(argparse.Namespace(
                line=line, task=task["id"], judge=True,
                integration=(candidate, receipt)))
            if rc == 0:
                _release_workspace_attempt(candidate)
            return True
        if code == 75 or str(receipt.get("status", "")).startswith("retryable_"):
            _mark_settling(tasks_path(line), task, candidate["artifact_paths"],
                           receipt.get("detail", "integration pending"), {
                               "stage": "integration-pending",
                               "candidate_oid": candidate["candidate_oid"],
                               "landed_oid": receipt.get("landed_commit") or "",
                               "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
                               "attempt": candidate["attempt"],
                           })
            return True
        _mark_attempt_failed(line, task, executor, code or 2, True, failure={
            "stage": "integration-recovery", "rc": code or 2,
            "detail": receipt.get("detail", "integration failed"),
            "attempt": candidate["attempt"], "worktree": candidate["worktree"],
        })
        return True
    result_file = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task["id"])
    if not os.path.isfile(result_file):
        return False
    with open(result_file, encoding="utf-8", errors="replace") as fh:
        body = fh.read()
    if "[cortex] consumed_at=" in body:
        return False
    marker = re.search(r"\[adapter\][^\n]*\brc=(\d+)\s*$", body, re.MULTILINE)
    if marker is None:
        return False
    adapter_rc = int(marker.group(1))
    tool_executed = (
        "tool_layer=claude-code" in body
        or "tool_layer=acp-lane" in body
        or "tool_layer=acp-native" in body
    )
    guard = load_execution_guard(line, task["id"])
    if guard:
        original, test_path, test_bytes = guard
        enforce_execution_bounds(line, original, test_path, test_bytes)
        task = original
    print("recover | %s/%s 找到孤儿执行终态 rc=%d → 继续验收"
          % (line, task["id"], adapter_rc))
    cmd_submit(argparse.Namespace(line=line, task=task["id"], result=result_file,
                                  window_min=0))
    if adapter_rc == 0 and not tool_executed:
        print("recover | %s/%s 是 legacy 文本回执，无工具执行证据" % (line, task["id"]))
        _mark_attempt_failed(line, task, executor, 96, False)
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=legacy-text\n" % fmt(now()))
        return True
    if adapter_rc != 0:
        _mark_attempt_failed(line, task, executor, adapter_rc, False)
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=adapter-fail\n" % fmt(now()))
        return True
    rc = cmd_try_complete(argparse.Namespace(line=line, task=task["id"], judge=True))
    if rc != 0:
        record_false_completion_if_claimed(
            line, task["id"], result_file,
            getattr(cmd_try_complete, "last_failure", None))
        _mark_attempt_failed(
            line, task, executor, rc, True,
            failure=getattr(cmd_try_complete, "last_failure", None),
        )
    else:
        set_cell(tasks_path(line), task["id"], "fails", "0")
        set_cell(tasks_path(line), task["id"], "next_advance_after", "-")
        print("done  | %s/%s（孤儿回执已回收）" % (line, task["id"]))
    with open(result_file, "a", encoding="utf-8") as fh:
        fh.write("\n[cortex] consumed_at=%s outcome=%s\n"
                 % (fmt(now()), "done" if rc == 0 else "gate-fail"))
    return True


def advance_once(line, task, executor, window_min):
    """一轮完整推进：claim → 工具型 adapter 真执行 → submit → try-complete。"""
    # 任务可覆盖线默认（requires_executor=acp-lane 等）
    executor = resolve_task_executor(task, executor)
    adapter = executor_adapter_path(executor)
    if not os.path.isfile(adapter):
        print("SKIP %s：无 executor adapter %s" % (task["id"], adapter))
        return 1
    # settle-first 只适用于从未失败过的任务：机械判据已满足就说明无需重复做。
    # 有失败史的任务可能曾被质量门否决，不能绕过 judge 直接洗绿。
    try:
        prior_fails = int(task.get("fails") or 0)
    except ValueError:
        prior_fails = 0
    if prior_fails == 0:
        preflight = cmd_try_complete(
            argparse.Namespace(line=line, task=task["id"], judge=False)
        )
        if preflight == 0:
            st = (pick(line, task["id"]) or {}).get("status")
            if st == "done":
                print("settle-first | %s/%s 判据已满足 → done（零模型）" % (
                    line, task["id"]))
                return 0
            if st == "settling":
                # short_test 已过；git 传播延后。不得进 LLM，也不得记 attempt-fail。
                print("settle-first | %s/%s short_test 已过 → settling（等 git，不烧模型）" % (
                    line, task["id"]))
                return 0
    queued_at = parse_ts(task.get("updated_at"))
    queue_wait_ms = (max(0, int((now() - queued_at).total_seconds() * 1000))
                     if queued_at is not None else None)
    if not set_cells(
        tasks_path(line), task["id"],
        {"status": "running", "updated_at": fmt(now())},
        expected_status="pending",
    ):
        print("skip | %s/%s claim CAS 已被其它 Worker 抢先" % (line, task["id"]))
        return 0
    try:
        attempt = create_workspace_attempt(line, task, executor)
    except (ValueError, RuntimeError, OSError) as exc:
        return _mark_attempt_failed(line, task, executor, 2, False, failure={
            "stage": "workspace-admission", "rc": 2, "detail": str(exc),
        })
    prompt_file = "/tmp/spotlight/cortex-loop-%s-%s.prompt" % (line, task["id"])
    result_file = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task["id"])
    os.makedirs("/tmp/spotlight", exist_ok=True)
    with open(prompt_file, "w", encoding="utf-8") as fh:
        fh.write(render_prompt(line, task, executor=executor))
        fh.write("\n\n## Attempt workspace\n")
        fh.write("你当前 cwd 是独立 attempt worktree：%s\n" % attempt["worktree"])
        fh.write("只允许修改：%s\n" % " ".join(attempt["writable_paths"]))
        fh.write("只读验收依赖：%s\n" % (" ".join(attempt["read_paths"]) or "-"))
    test_path, test_bytes = _short_test_snapshot(task)
    write_execution_guard(line, task, test_path, test_bytes)
    print("claim | %s/%s → running attempt=%s base=%s" % (
        line, task["id"], attempt["attempt"], attempt["base_oid"][:12]))
    print("run   | %s/%s executor=%s cwd=%s" % (
        line, task["id"], executor, attempt["worktree"]))
    log("claim %s/%s executor=%s attempt=%s run_id=%s base_oid=%s" % (
        line, task["id"], executor, attempt["attempt"], attempt["run_id"],
        attempt["base_oid"]))
    # 【EX15 · T37】开后台长任务心跳 ticker —— 让 pulse/dashboard 看到 busy
    # 而不是把 30min adapter 跑误判成「心跳停了」。
    # ticker 在 adapter 完成的任何路径下都必须收掉（success/failure/timeout），
    # 否则下一拍会留下 zombie ticker 继续 touch 一个已经不在 running 的任务。
    heartbeat_pidfile = start_long_task_heartbeat(line, task["id"])
    run_started = time.monotonic()
    try:
        if is_deterministic_backlink_task(task):
            code, out = apply_deterministic_backlink_in_workspace(
                attempt["worktree"], task)
            with open(result_file, "w", encoding="utf-8") as fh:
                fh.write(out + "\n")
            executor = "deterministic.backlink"
        else:
            env = "CORTEX_REQUIRE_WORKTREE=1 CORTEX_WORKTREE=%s CORTEX_ATTEMPT=%s " \
                  "CORTEX_RUN_ID=%s CORTEX_BASE_OID=%s " % (
                      shlex.quote(attempt["worktree"]), shlex.quote(attempt["attempt"]),
                      shlex.quote(attempt["run_id"]), shlex.quote(attempt["base_oid"]))
            code, out = run("%sbash %s %s %s" % (
                env, shlex.quote(adapter), shlex.quote(prompt_file), shlex.quote(result_file)),
                timeout=1800)
    finally:
        # 不管 adapter 怎么出去，ticker 必收 —— 这是 busy 状态机的关键不变量
        stop_long_task_heartbeat(heartbeat_pidfile)
    run_ms = int((time.monotonic() - run_started) * 1000)
    transport_salvage = ""
    if code != 0:
        log("adapter FAIL %s/%s rc=%d %s" % (line, task["id"], code, out.strip()[:200]))
        quota_text = out
        if os.path.isfile(result_file):
            try:
                with open(result_file, encoding="utf-8", errors="replace") as fh:
                    quota_text += "\n" + fh.read(8000)
            except OSError:
                pass
        if is_model_quota_breach(quota_text):
            record_model_quota_if_breach(
                line, task["id"], executor, quota_text,
                "workspace-adapter-quota", rc=code)
        if not os.path.isfile(result_file):
            with open(result_file, "w", encoding="utf-8") as fh:
                fh.write("[adapter failed before result] rc=%d\n%s" % (code, out[:4000]))
        transport_category = _adapter_transport_category(result_file)
        if transport_category:
            salvage, salvage_detail = _salvage_post_edit_transport(
                attempt, task, result_file, transport_category)
            if salvage:
                transport_salvage = transport_category
                print("salvage | %s/%s %s" % (
                    line, task["id"], salvage_detail))
                log("post-edit transport salvage %s/%s category=%s" % (
                    line, task["id"], transport_category))
            else:
                print("salvage-skip | %s/%s %s" % (
                    line, task["id"], salvage_detail))
    # submit 只收执行回执；先不推成功窗口。最终状态由完成门/失败重试决定。
    submit = argparse.Namespace(line=line, task=task["id"], result=result_file,
                                window_min=0)
    cmd_submit(submit)
    if code != 0 and not transport_salvage:
        result = _mark_attempt_failed(line, task, executor, code, False, failure={
            "stage": "adapter", "rc": code, "detail": out.strip()[:1200],
            "attempt": attempt["attempt"], "worktree": attempt["worktree"],
        })
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=adapter-fail dirty-workspace-preserved\n"
                     % fmt(now()))
        return result

    attempt["adapter_result"] = result_file
    if transport_salvage:
        attempt["transport_salvage"] = transport_salvage
    try:
        candidate = commit_workspace_candidate(attempt, task)
    except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as exc:
        result = _mark_attempt_failed(line, task, executor, 2, True, failure={
            "stage": "candidate", "rc": 2, "detail": str(exc),
            "attempt": attempt["attempt"], "worktree": attempt["worktree"],
        })
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=candidate-fail workspace-preserved\n"
                     % fmt(now()))
        return result

    integration_started = time.monotonic()
    integration_code, receipt = run_workspace_integrator(candidate)
    record_authorization_from_integration(line, task["id"], receipt)
    integration_ms = int((time.monotonic() - integration_started) * 1000)
    metrics = {
        "queue_wait_ms": queue_wait_ms,
        "run_ms": run_ms, "integration_ms": integration_ms,
        "workspace_kb": _workspace_kb(candidate["worktree"]),
        "cas_retry_count": _attempt_cas_retry_count(candidate) + (
            1 if receipt.get("status") == "retryable_cas_conflict" else 0),
    }
    append_attempt_event(candidate, dict(
        metrics, integration_status=receipt.get("status"),
        landed_oid=receipt.get("landed_commit")))
    with open(result_file, "a", encoding="utf-8") as fh:
        fh.write("\n[cortex-metrics] %s\n" % json.dumps(
            metrics, ensure_ascii=False, sort_keys=True))

    if (receipt.get("status") == "retryable_content_conflict"
            and _attempt_content_conflict_count(candidate)
            >= INTEGRATION_CONTENT_CONFLICT_MAX_RETRIES):
        blocker = {
            "stage": "integration-pending",
            "candidate_oid": candidate["candidate_oid"],
            "landed_oid": receipt.get("landed_commit") or "",
            "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
            "attempt": candidate["attempt"],
        }
        append_attempt_event(candidate, {
            "integration_status": "machine_blocker_content_conflict",
            "machine_blocker": "content_conflict_unresolved",
            "candidate_landed": False,
            "terminal_complete": False,
            "detail": receipt.get("detail", "candidate content conflicts with latest canonical"),
        })
        _mark_content_conflict_blocked(
            tasks_path(line), task, candidate["artifact_paths"],
            receipt.get("detail", "candidate content conflicts with latest canonical"),
            blocker)
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=integration-machine-blocker\n"
                     % fmt(now()))
        return 0
    if integration_code == 75 or str(receipt.get("status", "")).startswith("retryable_"):
        _mark_settling(tasks_path(line), task, candidate["artifact_paths"],
                       receipt.get("detail", "integration pending"), {
                           "stage": "integration-pending",
                           "candidate_oid": candidate["candidate_oid"],
                           "landed_oid": receipt.get("landed_commit") or "",
                           "canonical_ref": receipt.get("canonical_ref", "refs/heads/master"),
                           "attempt": candidate["attempt"],
                       })
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=integration-pending\n" % fmt(now()))
        return 0
    if integration_code != 0 or receipt.get("status") != "landed":
        record_false_completion_if_claimed(
            line, task["id"], result_file, {
                "stage": "integration",
                "detail": receipt.get("detail", out.strip()[-800:]),
            })
        return _mark_attempt_failed(line, task, executor, integration_code or 2, True,
                                    failure={
            "stage": "integration", "rc": integration_code,
            "detail": receipt.get("detail", out.strip()[-800:]),
            "attempt": candidate["attempt"], "worktree": candidate["worktree"],
        })
    rc = cmd_try_complete(argparse.Namespace(
        line=line, task=task["id"], judge=True, integration=(candidate, receipt)))
    if rc == 0:
        release_code, release_out = _release_workspace_attempt(candidate)
        if release_code != 0:
            log("workspace release deferred attempt=%s %s" % (
                candidate["attempt"], release_out.strip()[-200:]))
        set_cell(tasks_path(line), task["id"], "fails", "0")
        set_cell(tasks_path(line), task["id"], "next_advance_after", "-")
        print("done  | %s/%s" % (line, task["id"]))
        with open(result_file, "a", encoding="utf-8") as fh:
            fh.write("\n[cortex] consumed_at=%s outcome=done\n" % fmt(now()))
        return 0
    record_false_completion_if_claimed(
        line, task["id"], result_file,
        getattr(cmd_try_complete, "last_failure", None))
    return _mark_attempt_failed(
        line, task, executor, rc, True,
        failure=getattr(cmd_try_complete, "last_failure", None))


def _oldest_open_plan(prefix="imm-"):
    """返回**最早的、本节点还真能动手**的免疫计划 id；没有就返回 None。

    问的不是「这个计划完成了吗」，而是**「这个计划里还有我干得动的活吗」** ——
    两者不是同一个问题，把它们当同一个正是 2026-07-29 活锁的成因。

    一条任务对本节点关闭的情形（五态，不是两态）：
      · done               干成了，不用干
      · moot / noop        判据本来就满足，没活可干（第四态，见 MOOT_NS）
      · failed by me       本节点已经栽过，让给别的节点（同 cmd_run 的规则）
      · 我够不着           C2 信任不足 / 缺能力 —— 我接了也只会被门拦下
      · 别人正持有有效租约  此刻不是我的活
    以上全命中 = 这个计划对**我**已经没有内容，必须放行去找新活；
    否则我会抱着一个永远干不完的计划，把 discover 永久挡在门外。

    只挑最早的一个：一拍接一件，避免刚清完积压又一次性全领走造成雪崩。
    """
    me = node_id()
    prof = node_profile()
    _h, _ = haas_score(me)
    _trust = trust_level(_h)
    plan_sets = []
    for pid in sorted(p.rsplit("/", 1)[-1] for p in list_refs(PLAN_NS)):
        if pid.startswith(prefix):
            tasks = plan_tasks(pid)
            if tasks:
                plan_sets.append((pid, tasks))
    # 先做可确定性执行的治理修复：它们不耗模型、short_test 明确、传播由
    # orchestrator 承担。否则一批旧的模型型 discovery 仍会按字符串排在
    # S1 cohort 前面，把便宜且可闭环的任务饿死。其次才是其它 frozen
    # discovery，最后是无 discovery 的 legacy 计划。
    plan_sets.sort(key=lambda item: (
        not any(task.get("source") == "map-backlink-gap" for task in item[1]),
        not any(task.get("discovery_id") not in (None, "", "-") for task in item[1]),
        item[0],
    ))
    for pid, tasks in plan_sets:
        for task in tasks:
            res = parse_kv(read_ref("%s/%s/%s" % (RESULT_NS, pid, task["id"])))
            st = res.get("status")
            if st == "done":
                continue
            if st == "noop" or rev_ref("%s/%s/%s" % (MOOT_NS, pid, task["id"])):
                continue
            if st == "failed" and res.get("node") == me:
                # 【EX14 · T36】同 cmd_claim：失败 ≠ 永久封死，cooldown 之后可重试。
                # 旧版硬 continue 等于「我失败过 → 我永远不接这活」，
                # 网关/模型恢复后本节点也起不来了。
                _failed_at = parse_ts(res.get("failed_at"))
                if _failed_at is None or (now() - _failed_at).total_seconds() < FAIL_COOLDOWN_MIN * 60:
                    continue
                # 过冷却 → 允许本节点重试这条旧活（不绕开 fit_score/covenant）
            # 够不着的活不算「我的旧活」。**这里不放宽 C2**，恰恰相反：
            # 承认自己够不着，才不会抱着它把够得着的新活一起挡在门外。
            # 判据与执行端 covenant_check / fit_score 同源，避免两套口径。
            allowed, _law, _why = covenant_check(task, prof, _trust, _h)
            if not allowed:
                continue
            if fit_score(task, prof, 0, 10 ** 6)[0] is None:
                continue
            claim = parse_kv(read_ref("%s/%s/%s" % (CLAIM_NS, pid, task["id"])))
            exp = parse_ts(claim.get("expires"))
            if claim.get("holder") and claim.get("holder") != me and exp and exp > now():
                continue
            return pid
    return None


def tick_census(day=None, period_min=15):
    """一天里的拍到底去哪了 —— 拍是**四态**，不是「有产出 / 没产出」两态。

    2026-07-29 起因：dashboard 报「负载率 41%、闲置 59%（30/72 拍有产出）」，
    两个数都不成立：
      · 分母 = 墙钟推算的应跑拍数(now-00:00)/900 —— **把机器睡着的拍也算进来了**。
        实测今天应跑 77 拍、日志实跑 50 拍：08:55→10:45 空 110 分钟、
        11:10→12:22 空 72 分钟，笔记本合盖在睡。分母虚高 54%。
        引擎自己的 sleep_gap_note() 早就知道会睡，那个数却没人用。
      · 分子 = 有 result 的 **plan id 去重数**（还混进了非 tick 产物
        orchestrator / real1）。一拍可产多计划、一计划可跨多拍 ——
        分子分母压根不是同一个量纲，比出来的百分比没有意义。

    四态（合并任意两个都会让人做错下一步动作，故必须展开）：
      slept        launchd 没跳（机器睡了/未装载）→ **不进闲置分母**，那不是闲着，是不在
      productive   跑了，且真派出/推进了活
      settled      跑了，没新产出，但把「没活可干」判成了终态（推进了账本）
      idle         跑了，一步没动 —— **只有这一态才是真闲置**
    第五态 unknown：日志缺失/格式不认识 —— 独立成态，绝不倒向任何一边（fail-open 最危险）。
    """
    day = day or now().strftime("%Y-%m-%d")
    out = {"date": day, "period_min": period_min, "ran": 0, "slept": 0,
           "productive": 0, "settled": 0, "idle": 0, "unknown": 0, "wall": 0}
    if not os.path.isfile(LOG):
        out["unknown"] = -1
        out["note"] = "日志不存在 —— 不可查，不是 0"
        return out
    with open(LOG, encoding="utf-8") as fh:
        lines = [l.rstrip("\n") for l in fh if l.startswith(day)]
    seg, prev_ts = [], None
    for line in lines:
        seg.append(line)
        if "| tick " not in line:
            continue
        out["ran"] += 1
        ts = parse_ts(line.split("|")[0].strip())
        # 缺拍只按**相邻两拍的真实间隔**推算，不拿墙钟总长去减 ——
        # 后者会把「今天还没到的时间」也算成缺拍。
        if prev_ts and ts:
            gap = int((ts - prev_ts).total_seconds() // 60)
            if gap > period_min * 2:
                out["slept"] += max(0, gap // period_min - 1)
        prev_ts = ts or prev_ts
        body = "\n".join(seg)
        if re.search(r"\| (run |advance |auto-dispatch |reclaim )", body):
            out["productive"] += 1
        elif "progress=0 fallthrough" in line or re.search(r"\| tick due=0", line):
            # 本拍有没有把某条任务判成终态（moot），账本推进了但没有新产出
            out["settled" if "moot=" in body else "idle"] += 1
        else:
            out["unknown"] += 1
        seg = []
    # 墙钟应跑拍只作**参照**打印，不参与任何比率 —— 它是 dashboard 出错的那个数
    start = parse_ts("%sT00:00" % day)
    if start:
        end = min(now(), start + timedelta(days=1))
        out["wall"] = max(0, int((end - start).total_seconds() // (period_min * 60)))
    base = out["ran"] or 1
    out["load_pct"] = round((out["productive"] + out["settled"]) * 100.0 / base, 1)
    out["idle_pct"] = round(out["idle"] * 100.0 / base, 1)
    return out


def cmd_idle(args):
    """闲置率的诚实口径 —— 分母只含**真的跑过**的拍。"""
    c = tick_census(args.date)
    if args.json:
        print(json.dumps(c, ensure_ascii=False))
        return 0
    print("拍口径 · %s（周期 %d 分钟）" % (c["date"], c["period_min"]))
    print("  墙钟应跑 %d 拍  ← dashboard 当前用的分母，**含睡眠拍，不可用**" % c["wall"])
    print("  日志实跑 %d 拍  ← 唯一可查的真分母" % c["ran"])
    print("  睡眠缺拍 %d 拍（相邻拍间隔 > %d 分钟推算）"
          % (c["slept"], c["period_min"] * 2))
    print("  ├ 有产出   %d" % c["productive"])
    print("  ├ 记终态   %d（判了「没活可干」，账本推进了）" % c["settled"])
    print("  ├ 真闲置   %d（跑了一步没动）" % c["idle"])
    print("  └ 认不出   %d（独立第三态，不倒向任何一边）" % c["unknown"])
    print("负载率 %.1f%%  闲置率 %.1f%%（分母 = 实跑拍，不含睡眠）"
          % (c["load_pct"], c["idle_pct"]))
    return 0


def last_tick_at():
    """从心跳日志里读上一次 tick 时间（不另开状态文件）。"""
    if not os.path.isfile(LOG):
        return None
    try:
        with open(LOG, encoding="utf-8") as fh:
            lines = [l for l in fh if "| tick " in l]
    except OSError:
        return None
    return parse_ts(lines[-1].split("|")[0].strip()) if lines else None


def sleep_gap_note(expected_min=15):
    """笔记本合盖会睡，睡着时 launchd 不跳。醒来补跑一次，但中间是真空。

    环必须知道自己睡过 —— 否则「心跳日志连续」会被误读成「一直在跑」。
    """
    prev = last_tick_at()
    if prev is None:
        return None
    gap = int((now() - prev).total_seconds() // 60)
    if gap > expected_min * 2:
        return "唤醒补跑：距上次心跳 %d 分钟（预期 %d）→ 机器大概率睡过，这段时间心跳是真空" % (
            gap, expected_min)
    return None


def _probe_cheap_adapter(name, adapter):
    """对 cheap/minimax/glm adapter 试跑一次最小 prompt，看真调是否成。

    区别于 PATH 命令的探测：这些是 bash 脚本，调用约定 `$1=提示词文件 $2=结果文件`。
    写一个 1 字节 prompt、跑 adapter、读结果文件分类根因。
    真调会烧 minimax/glm 的 key 额度（每次约 1 token），因此默认**不调**，
    只有显式 `OC_CHEAP_PROBE=1` 才实调（用于短测/手动验证）。
    """
    import tempfile
    fd, prompt = tempfile.mkstemp(prefix="oc-probe-", suffix=".txt")
    os.close(fd)
    with open(prompt, "w", encoding="utf-8") as fh:
        fh.write("ok")
    result = "/tmp/spotlight/oc-probe-%s.result" % name
    os.makedirs("/tmp/spotlight", exist_ok=True)
    timeout_s = {"cheap": 90, "minimax": 60, "glm": 60}.get(name, 60)
    code, _ = run("CORTEX_NODE=%s timeout %d bash %s %s %s 2>&1"
                  % (node_id(), timeout_s, adapter, prompt, result), timeout=timeout_s + 30)
    try:
        os.unlink(prompt)
    except OSError:
        pass
    if not os.path.isfile(result):
        return False, "unknown", "adapter 未产出结果文件"
    try:
        with open(result, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError:
        text = ""
    low = text.lower()
    if code == 0:
        return True, "ok", "真调通过（rc=0）"
    if re.search(r"401|403|unauthorized|authenticat|token.*expired|invalid.*api.?key|认证|凭据", low):
        return False, "auth", text.strip().split("\n")[-1][:160]
    if re.search(r"quota|rate.?limit|usage limit|credit|exceeded|额度|超限", low):
        return False, "quota", text.strip().split("\n")[-1][:160]
    if re.search(r"proxy|econnrefused|ssl|timeout|network|getaddrinfo|连接|getaddr", low):
        return False, "network", text.strip().split("\n")[-1][:160]
    if re.search(r"no-ccswitch-account|no.*key|apiKey.*missing|配置|未配置", low):
        return False, "config", text.strip().split("\n")[-1][:160]
    return False, "unknown", (text.strip().split("\n")[-1] or "无输出")[:160]


def diagnose_executor(name):
    """为什么这个执行器不可用 —— 先纯代码分类根因，别一上来就叫模型。

    返回 (ok, 根因类, 细节)。根因类决定能不能自动修：
      missing / path      命令不在 → 可自动修 PATH
      auth                认证失效 → 不可自动修（需人给凭据）
      quota               额度耗尽 → **不该修，该绕过**（切别的执行器/节点）
      network / proxy     网络或代理 → 可探测，不擅自重启别人的服务
      config              配置损坏 → 可从 git 恢复（真相源在 git）
      ok                  没毛病

    廉价通道 adapter（cheap/minimax/glm）走专属分支：
      - 它们不是 PATH 命令，是 bash 脚本（约定 `$1=提示词文件 $2=结果文件`）
      - adapter 文件存在 + openclaw.json 有 apiKey = 编排层 ok
      - OC_CHEAP_PROBE=1 才真调（默认跳过，避免烧真额度；T20 短测里显式开启）
    """
    # 廉价通道分支（编排层探测 + 可选实调）
    if name in CHEAP_ADAPTER_PROVIDERS:
        adapter = os.path.join(ADAPTERS, "%s.sh" % name)
        if not os.path.isfile(adapter):
            return False, "missing", "adapter 文件缺失：%s" % adapter
        if name in TEXT_ONLY_ADAPTERS:
            return False, "text-only", (
                "%s adapter 只有文本生成能力，不得作为 workspace executor" % name)
        ready, detail = _cheap_worker_ready(adapter)
        if not ready:
            return False, "config", detail or "cheap workspace surface 未就绪"
        providers = CHEAP_ADAPTER_PROVIDERS[name]
        if not _oc_provider_key_present(providers):
            # cheap 的真正凭据来自 CC Switch；这里仅保留 provider 投影可观测性，
            # 不再用 openclaw apiKey 作为执行资格门。
            pass
        if os.environ.get("OC_CHEAP_PROBE") != "1":
            return True, "ok", "adapter + key 齐（OC_CHEAP_PROBE≠1，跳过实调）"
        return _probe_cheap_adapter(name, adapter)

    if run("command -v %s" % name, timeout=10)[0] != 0:
        return False, "missing", "命令不在 PATH 上"
    probe = {"claude": 'claude --print "ok"',
             "codex": "codex --version",
             "ollama": "ollama list",
             "openclaw": "openclaw cron status"}.get(name, "%s --version" % name)
    code, out = run("cd /tmp && timeout 90 %s 2>&1" % probe, timeout=120)
    if code == 0:
        return True, "ok", "探测通过"
    low = out.lower()
    if re.search(r"quota|rate.?limit|usage limit|credit|exceeded|额度|超限", low):
        return False, "quota", out.strip().split("\n")[-1][:160]
    if re.search(r"auth|unauthorized|401|403|token|login|凭据|认证", low):
        return False, "auth", out.strip().split("\n")[-1][:160]
    if re.search(r"proxy|econnrefused|ssl|timeout|network|getaddrinfo|连接", low):
        return False, "network", out.strip().split("\n")[-1][:160]
    if re.search(r"config|json|parse|invalid|配置", low):
        return False, "config", out.strip().split("\n")[-1][:160]
    return False, "unknown", (out.strip().split("\n")[-1] or "无输出")[:160]


def _print_diag(name):
    """CLI 入口：诊断单个执行器根因。stdout 输出 kind,exit_code=0=正常 / 1=红灯。"""
    ok, kind, detail = diagnose_executor(name)
    print("%s|%s|%s" % ("OK" if ok else "FAIL", kind, detail))
    return 0 if ok else 1


def _harness_dir():
    """cortex-harness 仓库根目录。跨仓库路径不写死判断，允许 env 覆盖。"""
    return os.environ.get("CORTEX_HARNESS_DIR") or os.path.expanduser(
        "~/cortex-harness"
    )


def _harness_node_bin():
    """按 cortex-harness/package.json 的 engines(">=24.0.0 <25") 找可用 node。

    返回 (path, source) 或 (None, None)。找不到就交回 None 让调用方出声，
    不静默降级到不满足 engines 声明的版本（T5：静默降级比报错更危险）。
    """
    override = os.environ.get("CORTEX_HARNESS_NODE_BIN")
    if override and os.path.isfile(override):
        return override, "env CORTEX_HARNESS_NODE_BIN"
    nvm_root = os.path.expanduser("~/.nvm/versions/node")
    candidates = []
    if os.path.isdir(nvm_root):
        for name in os.listdir(nvm_root):
            m = re.match(r"^v24\.(\d+)\.(\d+)$", name)
            if not m:
                continue
            node_path = os.path.join(nvm_root, name, "bin", "node")
            if os.path.isfile(node_path):
                candidates.append((int(m.group(1)), int(m.group(2)), node_path))
    if candidates:
        candidates.sort()
        return candidates[-1][2], "nvm v24.x(自动选最高 patch)"
    which_node = shutil.which("node")
    if which_node:
        return which_node, "PATH node(未验证满足 engines>=24.0.0<25，可能失败)"
    return None, None


def cmd_harness_run(args):
    """真实驱动 cortex-harness/packages/agent-runtime 的 local-MVP 入口跑一次。

    背景（2026-08-21 HANDOFF Q2）：CHARTER §4 要求日常入口复用本 Skill，
    但 agent-runtime 是姊妹仓库 cortex-harness 里的纯 TS 源码 —— 无 bin 字段、
    未发布、无编译产物，此前只能靠手敲 `pnpm --filter @cortex/agent-runtime`
    才碰得到。本命令把这条路径收口到 cortex-loop 一个入口。

    真实调用面：cortex-harness 自带的 scripts/cortex-local-mvp.mjs（非本仓
    新造），import agent-runtime 的 executeCliEntry() 并跑一次。

    诚实边界：agent-runtime 当前只有一个用于验证运行时脚手架
    （session/goal/lease/durable-autonomy loop）的合成 2 步 executor，
    不做真实业务任务、不调用任何 LLM —— 跑通 = 脚手架可达，不代表
    agent-runtime 已具备真实执行能力。不要把这当成 tick 的替代品。
    """
    harness_dir = _harness_dir()
    entry_script = os.path.join(harness_dir, "scripts", "cortex-local-mvp.mjs")

    def _fail(reason, hint, extra=None):
        payload = {"ok": False, "reason": reason, "hint": hint}
        if extra:
            payload.update(extra)
        print(json.dumps(payload, ensure_ascii=False))
        return 1

    if not os.path.isdir(harness_dir):
        return _fail("harness_dir_missing",
                      "设环境变量 CORTEX_HARNESS_DIR 指向 cortex-harness 仓库根目录",
                      {"path": harness_dir})
    if not os.path.isfile(entry_script):
        return _fail("entry_script_missing",
                      "cortex-harness 仓库缺 scripts/cortex-local-mvp.mjs，接线目标已变化，需重新调查",
                      {"path": entry_script})
    node_bin, node_source = _harness_node_bin()
    if not node_bin:
        return _fail("node_v24_missing",
                      "cortex-harness engines 要求 node>=24.0.0 <25，本机未找到；nvm install 24 或设 CORTEX_HARNESS_NODE_BIN")

    title = " ".join(args.title) if args.title else "run a bounded local Cortex goal"
    cmd = "cd %s && %s --experimental-transform-types %s %s" % (
        shlex.quote(harness_dir), shlex.quote(node_bin),
        shlex.quote(entry_script), shlex.quote(title),
    )
    code, out = run(cmd, timeout=args.timeout)

    # run() 把 stdout/stderr 合并返回；ExperimentalWarning 打在 stderr，
    # 真正的结果是最后一行以 { 开头的 JSON。
    json_line = None
    for line in reversed([l for l in out.strip().splitlines() if l.strip()]):
        if line.strip().startswith("{"):
            json_line = line.strip()
            break

    result = None
    if json_line:
        try:
            result = json.loads(json_line)
        except json.JSONDecodeError:
            result = None

    envelope = {
        "ok": code == 0 and result is not None,
        "exit_code": code,
        "harness_dir": harness_dir,
        "node_bin": node_bin,
        "node_source": node_source,
        "note": "agent-runtime 的 local-MVP 合成 executor（非真实业务执行），验证接线用",
    }
    if result is not None:
        envelope["result"] = result
    else:
        envelope["raw_output"] = out[-2000:]

    if args.json:
        print(json.dumps(envelope, ensure_ascii=False))
    else:
        print("harness-run ｜ node=%s(%s) ｜ exit=%s" % (node_bin, node_source, code))
        if result is not None:
            print("status=%s steps=%s evidence=%s" % (
                result.get("status"), result.get("steps"), result.get("evidence")))
        else:
            print(out if out.strip() else "（无输出）")
    return 0 if envelope["ok"] else 1


def cmd_revive(args):
    """自愈：诊断 → 能修的修 → 修不了就**宣告能力下线让蜂群绕过** → 恢复后自动上线。

    核心判断：**最有效的复活不是修好挂掉的那个模型，是切到还活着的那个。**
    额度耗尽是单点问题，蜂群有多节点多模型 —— 该做的是路由绕过，不是死等它恢复。
    「宣告能力下线」这一步最关键：不用修好，环也能继续跑。
    """
    prof = node_profile()
    me = prof["node"]
    caps = set((prof.get("caps") or "").split())
    targets = [n for n in ("claude", "codex", "openclaw", "ollama", "cheap")
               if "exec.%s" % n in caps]
    if args.executor:
        targets = [args.executor]
    print("节点 %s ｜ 自愈体检：%s" % (me, " ".join(targets) or "（无执行器）"))

    healthy, downed, actions = [], [], []
    for name in targets:
        ok, kind, detail = diagnose_executor(name)
        if ok:
            healthy.append(name)
            hushed, why, _ = exec_suppressed(name)
            if hushed:
                clear_exec(name)      # 窗口过了、能跑了 → 自动归队，无需人干预
                print("  ✅ %-9s 恢复（原抑制原因 %s）→ 能力自动加回" % (name, why))
            else:
                print("  ✅ %-9s 可用" % name)
            continue
        print("  ❌ %-9s %s — %s" % (name, kind, detail))
        # 能安全自动修的只有这两类；其余不擅自动手（改别人的凭据/重启别人的服务都越界）
        if kind == "missing":
            fixed = run("command -v %s" % name, timeout=10)[0] == 0
            actions.append("%s: PATH 复查 %s" % (name, "已恢复" if fixed else "仍缺失"))
        elif kind == "config":
            code, _ = git("checkout HEAD -- $(git ls-files | grep -i %s | head -5)" % name)
            actions.append("%s: 尝试从 git 恢复配置 %s" % (name, "ok" if code == 0 else "失败"))
        downed.append((name, kind, detail))

    # 关键一步：把挂掉的能力从心跳里摘掉 —— 蜂群立刻按能力路由绕过本节点
    if downed:
        drop = {"exec.%s" % n for n, _, _ in downed}
        prof["caps"] = " ".join(c for c in (prof.get("caps") or "").split()
                                if c not in drop)
        prof["degraded"] = ",".join("%s:%s" % (n, k) for n, k, _ in downed)
        beat_publish(prof)
        print("\n已从心跳摘除 %s —— 蜂群会按能力路由绕过本节点，**不必等它修好**"
              % " ".join(sorted(drop)))
        for name, kind, detail in downed:
            if kind == "quota":
                suppress_exec(name, "quota")
                print("  · %s 额度耗尽 → 抑制 %d 小时（窗口重置后自动归队，不需人管）"
                      % (name, QUOTA_WINDOW_H))
            elif kind == "auth":
                suppress_exec(name, "auth")
                print("  · %s 认证失效 → 抑制 12 小时；需人给凭据（自动改凭据=越界）" % name)
            record_incident(me, "executor-down-%s" % kind, "%s: %s" % (name, detail))

    if healthy and downed:
        print("\n仍可用：%s —— 本节点降级但未失能" % " ".join(healthy))
    elif not healthy:
        print("\n⚠️ 本节点无可用执行器 → 退到 L2 纯代码模式："
              "心跳/窗口/完成门/升级告警照跑，只是不再思考")

    for act in actions:
        print("  修复动作：%s" % act)
    # 「提升」：每次自愈的症状→根因→处置落盘，下次同症状直接匹配已知修法
    if downed:
        os.makedirs("/tmp/spotlight", exist_ok=True)
        with open("/tmp/spotlight/cortex-loop-revive.log", "a", encoding="utf-8") as fh:
            for name, kind, detail in downed:
                fh.write("%s|%s|%s|%s|%s\n" % (fmt(now()), me, name, kind, detail))
        print("\n自愈记录已落盘（症状→根因→处置），同症状下次可直接匹配")
    return 0 if healthy else 1


def executor_ladder(prof):
    """三级降级阶梯。返回 (可用执行器, 降级档位, 说明)。

    保命的不是小模型，是**纯代码降级模式** —— 这与「心跳不能寄生」同源：
    环的存活不能依赖任何模型。模型只决定「能不能思考」，不决定「活不活着」。

      L0 正常   外部执行器可用（claude/codex/openclaw/cheap）→ 真干活
      L1 本地   外部不可用，有 ollama → 只做低判断力（拆解/告警文案/指纹探针）
      L2 纯代码 连本地模型都没有 → 心跳/窗口/完成门/升级告警照跑，跳过需思考的步骤

    cheap 也算 L0：它通过 Claude Code 工具层使用 CC Switch MiniMax，具备真实
    Read/Edit/Bash 能力。raw minimax/glm 只宣告 text.*，不得进入 Worker ladder。
    排序：claude/codex/openclaw（订阅执行器）优先 → cheap（廉价工作区执行器）。
    """
    caps = set((prof.get("caps") or "").split())
    for name in ("claude", "codex", "openclaw"):
        if "exec.%s" % name in caps:
            return name, "L0", "外部执行器 %s 可用" % name
    for name in WORKSPACE_CHEAP_EXECUTORS:
        if "exec.%s" % name in caps:
            return name, "L0", "廉价通道 %s 可用（Claude Code + CC Switch MiniMax）" % name
    # acp-lane 不抢默认：仅当任务/线显式点名时用 resolve_task_executor；
    # ladder 里放在 cheap 之后作「仍有 L2 headless 能力」兜底。
    for name in L2_HEADLESS_EXECUTORS:
        if "exec.%s" % name in caps:
            return name, "L0", "L2 headless lane %s 可用（acp-policy-client + DECIDE）" % name
    if "exec.ollama" in caps:
        return "ollama", "L1", "外部执行器不可用 → 本地小模型兜底（仅低判断力任务）"
    return None, "L2", "无任何模型 → 纯代码降级：心跳/完成门/告警照跑，不做需思考的步骤"


def _run_and_gather(plan_id, run_ns):
    """自动执行后立刻汇总：passed receipt 必须进入 learning，收齐后自动结算。

    run 只负责形成世界证据；gather 才负责复核 receipt、发布 learning candidate
    和写 settled ref。自动时钟若只调 run，S1 会停在“做过但没学习/没结算”的
    半闭环，仍然需要人补最后一条命令。
    """
    run_ns.trigger_kind = "clock-auto"
    rc = cmd_run(run_ns)
    gather_rc = cmd_gather(argparse.Namespace(plan=plan_id, settle=True))
    if gather_rc != 0:
        log("auto-gather %s incomplete" % plan_id)
    return rc


def tick_advance_cap(day_cap):
    """单拍 LLM 推进预算；日上限只作天花板，不能直接充当单拍吞吐量。"""
    try:
        configured = max(1, int(os.environ.get("CORTEX_MAX_ADVANCE_PER_TICK", "1")))
    except ValueError:
        configured = 1
    return min(max(0, int(day_cap)), configured)


def reclaim_inherited_running(line, executor):
    """只回收没有任务级 Worker 锁的 running；活 Worker 与新 tick 可并存。"""
    reclaimed = []
    for task in load_tasks(line):
        if task.get("status") != "running":
            continue
        if task_lock_busy(line, task["id"]):
            continue
        if recover_completed_attempt(line, task, executor):
            continue
        path = tasks_path(line)
        if not set_cells(path, task["id"], {
                "status": "pending", "next_advance_after": "-",
                "updated_at": fmt(now()),
        }, expected_status="running"):
            continue
        reclaimed.append(task["id"])
        msg = "reclaim %s/%s 上一 tick 已退出且无完整回执 → 立即收回重推" % (
            line, task["id"])
        print(msg)
        log(msg)
    return reclaimed


def active_task_workers():
    active = []
    for entry in clock_lines():
        line = entry["line"]
        for task in load_tasks(line):
            if task.get("status") == "running" and task_lock_busy(line, task["id"]):
                active.append((line, task["id"]))
    return active


def _cheap_available_accounts():
    override = os.environ.get("CORTEX_CHEAP_AVAILABLE_ACCOUNTS")
    if override is not None:
        try:
            return max(0, int(override))
        except ValueError:
            return 0
    db = os.path.expanduser("~/.cc-switch/cc-switch.db")
    if not os.path.isfile(db):
        return 0
    try:
        import sqlite3
        conn = sqlite3.connect("file:%s?mode=ro" % db, uri=True)
        rows = conn.execute(
            "SELECT settings_config FROM providers "
            "WHERE app_type='claude' AND name LIKE ?", ("MiniMax%",)).fetchall()
        conn.close()
    except Exception:
        return 0
    available = 0
    for (raw,) in rows:
        try:
            cfg = json.loads(raw)
            env = cfg.get("env") or {}
            token = env.get("ANTHROPIC_AUTH_TOKEN") or ""
            if not (token and env.get("ANTHROPIC_BASE_URL") and env.get("ANTHROPIC_MODEL")):
                continue
            token_hash = hashlib.sha256(token.encode()).hexdigest()[:12]
            if os.path.isdir("/tmp/spotlight/cortex-cheap-accounts/%s" % token_hash):
                continue
            available += 1
        except (TypeError, ValueError, json.JSONDecodeError):
            continue
    return available


def workspace_disk_admissible():
    root = os.path.expanduser(os.environ.get(
        "CORTEX_WORKSPACE_ROOT", "${CORTEX_WORKSPACE_ROOT}"))
    probe = root
    while not os.path.exists(probe):
        parent = os.path.dirname(probe)
        if parent == probe:
            return False, None
        probe = parent
    try:
        free_kb = (os.statvfs(probe).f_bavail * os.statvfs(probe).f_frsize) // 1024
        floor = int(os.environ.get("CORTEX_WORKSPACE_MIN_FREE_KB", "1048576"))
    except (OSError, ValueError):
        return False, None
    return free_kb >= floor, free_kb


def workspace_admission_capacity(executor):
    try:
        worker_slots = max(0, int(os.environ.get("CORTEX_MAX_WORKERS", "3")))
    except ValueError:
        worker_slots = 0
    disk_ok, free_kb = workspace_disk_admissible()
    if not disk_ok:
        return 0, {"worker_slots": worker_slots, "cheap_accounts": None,
                   "free_kb": free_kb, "reason": "workspace-disk-gate"}
    cheap_accounts = _cheap_available_accounts() if executor == "cheap" else worker_slots
    capacity = min(worker_slots, cheap_accounts)
    return capacity, {"worker_slots": worker_slots,
                      "cheap_accounts": cheap_accounts if executor == "cheap" else None,
                      "free_kb": free_kb, "reason": "ok"}


def _write_sets_overlap(left, right):
    if "" in left or "" in right:
        return True
    return any(_path_is_within(a.rstrip("/"), b.rstrip("/"))
               or _path_is_within(b.rstrip("/"), a.rstrip("/"))
               for a in left for b in right)


def active_worker_write_sets():
    sets = []
    for line, task_id in active_task_workers():
        task = pick(line, task_id)
        try:
            paths = workspace_contract_paths(task or {})["writable_paths"]
        except ValueError:
            paths = [""]  # 未知活动写集与所有任务冲突，fail closed。
        sets.append((line, task_id, paths))
    return sets


def admit_disjoint_tasks(tasks, occupied, limit):
    """写集冲突图的贪心独立集；拒绝项保持 pending，不算失败。"""
    admitted, deferred = [], []
    chosen = [paths for _line, _task, paths in occupied]
    for task in tasks:
        if len(admitted) >= max(0, limit):
            deferred.append((task, "capacity"))
            continue
        try:
            paths = workspace_contract_paths(task)["writable_paths"]
        except ValueError as exc:
            deferred.append((task, "contract:%s" % exc))
            continue
        if any(_write_sets_overlap(paths, active) for active in chosen):
            deferred.append((task, "write-conflict"))
            continue
        admitted.append((task, paths))
        chosen.append(paths)
    return admitted, deferred


def spawn_task_worker(line, task_id):
    """异步启动独立 Worker；调度进程不等待模型、不把 tick 锁拖进执行期。"""
    cmd = [sys.executable, os.path.abspath(__file__), "task-run",
           "--line", line, "--task", task_id]
    try:
        proc = subprocess.Popen(
            cmd, cwd=ROOT, env=os.environ.copy(),
            stdin=subprocess.DEVNULL, close_fds=True, start_new_session=True,
        )
    except OSError as exc:
        print("FAIL | %s/%s Worker 启动失败：%s" % (line, task_id, exc))
        return False
    print("launch| %s/%s → worker pid=%s（异步，不持有 tick/账本/Git 锁）" % (
        line, task_id, proc.pid))
    log("worker-launch %s/%s pid=%s" % (line, task_id, proc.pid))
    return True


def cmd_tick(args):
    # 不再持有全局 tick flock。launchd 自己不重入；人工/恢复拍若重叠，
    # 由远端 line lease + 本机 per-task lock + ledger CAS 分别阻止重复工作。
    # 全局锁曾把一次 25min Worker/网络重试扩散成全队列冻结，代价远大于收益。
    note = sleep_gap_note()
    if note:
        print(note)
        log(note)

    # 心跳必须在 health 之前发 —— 它是「我还活着」的信号，不是「我一切正常」的信号。
    # 原来只有 cmd_sync 发 beat，且 health 红时 tick 提前 return：
    # 结果是节点一旦 health 红就对全群静默，3 小时后被判死亡并被接管。
    # 「活着」与「健康」是两件事，混在一起会让生病的节点被当成尸体。
    fetch_refs()
    _prof = node_profile()
    beat_publish(_prof)
    _exec, _tier, _why = executor_ladder(_prof)
    if _tier != "L0":
        print("⚠️ 降级档位 %s：%s" % (_tier, _why))
        log("degraded %s %s" % (_tier, _why))
        if args.auto:      # 降级不该只是告警，要主动救自己（复活 + 提升）
            print("→ 自动尝试自愈")
            cmd_revive(argparse.Namespace(executor=None))

    if args.auto and cmd_health(argparse.Namespace()) != 0:
        print("\n拒绝自动推进：驱动自检红灯（先修 health，再谈推进）")
        return 1

    if args.auto:
        allowed, why = auto_execution_allowed_by_guardrails()
        if not allowed:
            print("\n拒绝自动推进：guardrail breach 已触发降级（%s）" % why)
            print("恢复方式：审计事件源 + 人工恢复门；必要时显式 CORTEX_ALLOW_GUARDRAIL_BREACH_AUTO=1 breakglass")
            return 1

    total = 0
    workers_in_use = len(active_task_workers())
    occupied_write_sets = active_worker_write_sets()
    nodes = read_swarm()
    _self_prof = write_profile()  # 每拍刷新自我画像（整点精度，不制造 git 噪音）
    commit_own_profile(_self_prof)  # IMM-T30：无人值守机器上没人会顺手 commit 这个文件
    for entry in clock_lines():
        line = entry["line"]
        if entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
            continue
        if not owns_line(entry, nodes):
            print("skip | %s 归 %s 管（本节点 %s）" % (line, entry.get("owner"), node_id()))
            continue
        if args.auto:
            # 分片决定「谁该管」，租约决定「此刻谁真能动手」。
            # 两层都要：分片防日常打架，租约防脑裂——网络分区时两边都以为自己该接管，
            # 但 git 服务器的 CAS 只会让一个拿到租约。
            got, why = acquire_lease(line, ttl_min=SCHEDULER_LEASE_MIN)
            if not got:
                print("skip | %s %s" % (line, why))
                continue
        window_min = int(entry.get("advance_window_min") or 240)
        executor = entry.get("executor") or "human"
        cap = int(entry.get("max_advance_per_day") or 4)

        # running 是否仍活着只看同任务内核锁；tick 不再拥有全局推进锁。
        # 有完整回执就恢复验收，无锁且无回执才收回，不制造 45 分钟真空。
        reclaim_inherited_running(line, executor)
        # 【EX15 · T37】长任务心跳 stale 回收：本节点当下正在跑的任务如果
        # 中间心跳超时（adapter 卡死 / ticker 被 OOM kill），必须收回 pending
        # 让下半拍能正常 claim。reclaim_inherited_running 只看「进程死了」，
        # 这里看「任务级心跳死了」—— 互补不重叠。
        reap_stale_running_tasks(line)
        # 结算面：short_test 已过、卡在 git 的 settling 任务只 land，不烧 LLM。
        # git 忙时 settle_line_tasks 整批立刻 return（不跑 short_test），
        # 把拍内时间留给下面 claim pending —— 否则 running 永远 0。
        # settle 成功仍计 total；跳过不算失败。
        if args.auto:
            n_settle = settle_line_tasks(line)
            if n_settle:
                print("settle| %s 本拍结案 %d 条 settling→done" % (line, n_settle))
                total += n_settle
        for task in load_tasks(line):
            status = task.get("status")
            guard_path, _guard_test = _guard_paths(line, task["id"])
            orphan_done = status == "done" and os.path.isfile(guard_path)
            if status != "pending" and not orphan_done:
                continue
            # pending 也可能有“主调用被杀、工具子进程后来完成”的新回执。
            # 只回收更新时间之后写成的 tool-layer 回执，避免重放旧 raw 文本结果。
            result_file = "/tmp/spotlight/cortex-loop-%s-%s.result" % (line, task["id"])
            updated = parse_ts(task.get("updated_at"))
            pending_receipt = (
                status == "pending" and updated and os.path.isfile(result_file)
                and datetime.fromtimestamp(os.path.getmtime(result_file), now().tzinfo) > updated
            )
            pending_dirty_attempt = False
            if status == "pending":
                attempt = _load_latest_attempt_claim(line, task["id"])
                pending_dirty_attempt = bool(
                    attempt and _workspace_has_changes(attempt.get("worktree")))
            if pending_receipt or orphan_done or pending_dirty_attempt:
                if recover_completed_attempt(line, task, executor):
                    continue

        if args.auto:
            resume_recoverable_blocked(line)
        for task, days in stuck_tasks(line):
            escalate(line, task, days)
        detect_systemic_failure(line)

        due = due_tasks(line)
        # 有择机字段的账本必须真正经过 selector；不能只提供一个没人调用的
        # `select` 命令。legacy 账本没有这些列，保持原有顺序兼容。
        if due and any((t.get("resource_class") or "").strip() for t in load_tasks(line)):
            # T21 修复：额度探测必须调用 exec_suppressed，不偷懒用文件存在当能力声明。
            # 额度耗尽时 quota_exhausted=True → resource_state 降为 unknown，
            # select_task_rows 过滤掉 llm-heavy，只剩 local-only 可跑。
            suppressed, reason, _ = exec_suppressed(executor)
            quota_exhausted = suppressed and reason == "quota"
            resource_state = ("ok" if executor != "human"
                              and not quota_exhausted
                              and os.path.isfile(executor_adapter_path(executor))
                              else "unknown")
            due = select_task_rows(due, resource_state)
        if not due:
            print("idle | %s 无到窗口任务" % line)
            continue
        print("due  | %s: %s" % (line, ", ".join(t["id"] for t in due)))
        total += len(due)
        if args.auto:
            capacity, admission = workspace_admission_capacity(executor)
            worker_free = max(0, admission["worker_slots"] - workers_in_use)
            account_free = (admission["cheap_accounts"]
                            if admission["cheap_accounts"] is not None else worker_free)
            available = 0 if capacity == 0 else min(worker_free, account_free)
            if "CORTEX_MAX_ADVANCE_PER_TICK" in os.environ:
                try:
                    available = min(available, max(
                        0, int(os.environ["CORTEX_MAX_ADVANCE_PER_TICK"])))
                except ValueError:
                    available = 0
            if available == 0:
                print("queue | %s admission=0 reason=%s workers=%d/%d free_kb=%s；保持 pending" % (
                    line, admission["reason"], workers_in_use,
                    admission["worker_slots"], admission["free_kb"]))
                continue
            admitted, deferred = admit_disjoint_tasks(
                due, occupied_write_sets, min(available, cap))
            for deferred_task, reason in deferred:
                print("queue | %s/%s %s；不 claim、不记失败" % (
                    line, deferred_task["id"], reason))
            advanced_this_tick = 0
            for task, write_paths in admitted:
                reserved, used, why = reserve_daily_advance(
                    line, cap, task_id=task["id"])
                if not reserved:
                    print("skip | %s 日推进预算：%s" % (line, why))
                    log("daily-cap %s used=%d cap=%d reason=%s" % (
                        line, used, cap, why))
                    break
                print("budget| %s %s" % (line, why))
                if spawn_task_worker(line, task["id"]):
                    advanced_this_tick += 1
                    workers_in_use += 1
                    occupied_write_sets.append((line, task["id"], write_paths))

    if args.auto and total == 0:
        # 没活可干 ≠ 停摆。CORTEX 里的机械可查缺口就是天然的小任务池，
        # 自己去找、自己啃小的、自己积累信任 —— 这才叫持续跑起来。
        # 免疫闭环三步都要在这里真正发生：发现 → 自动发布 → 自动认领执行，
        # 不能只打印"要不要发"就停手，那样等于没有自愈能力。
        print("\n无到窗口任务 → 自主找活（免疫闭环）")
        # 【先接旧活，再找新活】2026-07-29 实测：每拍无条件发新计划、且只跑自己
        # 刚发的那个，于是同一批候选被反复派成**新 plan id**，24 个计划里 7 个
        # 从头到尾零认领（都是另一节点发布、本节点从没看过的）。
        # 过门率的分母是 result ref 数 = (plan,task) 对数，所以每重发一次，
        # 同一件活就在分母里多占一格 —— 分子不动、分母暴涨，比率必然一路下滑。
        # 复用已有计划还有一个关键性质：同一 plan 里重试同一 task 是**覆写同一个
        # result ref**，账本幂等，不再重复计数。
        open_plan = _oldest_open_plan()
        if open_plan:
            print("发现未完成的旧计划 %s → 先接旧活" % open_plan)
            _open_tasks = plan_tasks(open_plan)
            _deterministic_batch = bool(_open_tasks) and all(
                task.get("source") == "map-backlink-gap" for task in _open_tasks)
            _batch_weight = sum(
                int(task.get("weight") or 1) for task in _open_tasks
            ) if _deterministic_batch else 0
            _run_and_gather(open_plan, argparse.Namespace(
                plan=open_plan, executor=None,
                max_load=3 + _batch_weight if _deterministic_batch else 3,
                ttl_min=60, limit=0))
            # 【接旧活不许变成挡新活】2026-07-29 活锁实证：首版无条件 `return 0`，
            # 于是「接了旧活」和「接了旧活但一步没动」被当成同一件事。
            # 真机后果是 18:15→19:21 连续 5 拍逐字相同的空转日志。
            # 判据取**这趟有没有真的推进**（跑了 or 判了终态），不是「有没有旧计划」：
            #   推进了 → 本拍到此为止，下一拍继续啃（防雪崩，原设计意图保留）
            #   零推进 → 这个计划对我已经是块干石头，继续往下找新活
            # 这不是放宽任何门 —— 一步没动的那些任务，门本来就没让它过。
            if getattr(cmd_run, "last_progress", 0) > 0:
                # moot=N 是给 `cortex-loop idle` 分「记终态」与「真闲置」用的：
                # 没有它，一个把旧计划判完终态的拍会被误算成闲置（账本明明推进了）。
                log("tick due=%d auto=%s resumed=%s moot=%d"
                    % (total, bool(args.auto), open_plan,
                       getattr(cmd_run, "last_moot", 0)))
                return 0
            print("旧计划 %s 本拍零推进（没有我干得动的活）→ 继续找新活，不空转一拍"
                  % open_plan)
            log("tick due=%d auto=%s resumed=%s progress=0 fallthrough"
                % (total, bool(args.auto), open_plan))
        cands = discover_candidates()
        if not cands:
            print("机械可查的缺口全绿 —— 真的没活")
        else:
            _h, _facts = haas_score(node_id())
            _lvl_names = ["L1", "L2", "L3", "L4", "L5"]
            _lvl = _lvl_names.index(trust_level(_h))
            # 【发布 ≠ 执行】计划是**蜂群共享账本**，按发布者个人信任裁剪它
            # 等于让低信任节点的视野决定高信任节点能看见什么活。
            # 2026-07-29 实测：laptop(L2) 发布时，11 条 L3/L4 候选
            # （5×lowland-* / 4×debt-* / fm-bulk / dispute-all）根本不会被写进
            # 任何计划，而 worker 是 L3、完全够格 —— 活对够格的节点隐身了。
            #
            # 修法：发布端看**蜂群里活着的节点的最高信任**，执行端的 C2
            # （covenant_check）一字不动。够不着的节点认领时照样被拦下，
            # 只是活被摆上了桌。这是「把活公开」，不是「降低门槛」。
            _ceiling = _lvl
            _ceiling_by = node_id()
            for _n, _p in read_swarm().items():
                if not node_alive(_p)[0]:
                    continue
                _nh, _ = haas_score(_n)
                _nl = _lvl_names.index(trust_level(_nh))
                if _nl > _ceiling:
                    _ceiling, _ceiling_by = _nl, _n
            ok = [c for c in cands
                  if _lvl_names.index(c["min_trust"]) <= _ceiling]
            routed = route_discovered_file_tasks([
                c for c in ok if _lvl_names.index(c["min_trust"]) <= _lvl
            ])
            if routed:
                print("已把 %d 条获准文件任务导入 controller ledger：%s" % (
                    len(routed), ", ".join(routed[:8])))
                print("下一拍按 workspace→candidate→integrator 执行；不再写根工作树")
                log("controller-route n=%d tasks=%s" % (
                    len(routed), ",".join(routed)))
                return 0
            print("发现 %d 条候选，本节点信任 %s；蜂群可执行上限 %s（来自 %s）→ 可发布 %d 条"
                  % (len(cands), trust_level(_h), _lvl_names[_ceiling], _ceiling_by, len(ok)))
            _mine = len([c for c in cands if _lvl_names.index(c["min_trust"]) <= _lvl])
            if _mine < len(ok):
                print("其中 %d 条本节点自己够不着，发出去等够格的节点认领（C2 门不变）"
                      % (len(ok) - _mine))
            if not ok:
                print("够格的 0 条 —— 全蜂群都够不着，先攒信任，等 HAAS 涨上去再解锁")
            else:
                pid = "imm-%s" % now().strftime("%m%d%H%M%S")
                # 免疫计划的每拍上限跟具体方向线的 max_advance_per_day 无关（那是
                # 循环变量 cap，值取决于 clock_lines 里最后一条线，语义不对），
                # 这里单独给一个小常量：每拍最多认领 2 条，防雪崩。
                #
                # 挑法不能是裸 `ok[:2]`：发布上限放开到蜂群天花板之后，排序一旦把
                # 高门槛任务顶到前面，本节点就会连续多拍发出**自己一条也干不了**的
                # 计划 —— 账本丰满、本节点继续闲着，等于把闲置从派发层挪到了执行层。
                # 规矩：够得着的先占 1 个坑（保证本拍我有活干），
                # 剩下的坑按原顺序给蜂群（保证高门槛的活也出得去）。
                _selfok = [c for c in ok if _lvl_names.index(c["min_trust"]) <= _lvl]
                take = _selfok[:1]
                for _c in ok:
                    if len(take) >= 2:
                        break
                    if _c not in take:
                        take.append(_c)
                fetch_refs()
                if rev_ref("%s/%s" % (PLAN_NS, pid)):
                    print("计划 %s 已存在（罕见的同秒撞车），本拍跳过" % pid)
                elif not freeze_discoveries(take, pid):
                    print("自动免疫计划 %s 的 discovery 冻结失败，本拍不发布" % pid)
                else:
                    lines = [plan_task_line(c) for c in take]
                    payload = "\n".join([
                        "plan=%s" % pid, "intent=免疫应答：机械可验的治理缺口自动修复",
                        "by=%s" % node_id(), "created=%s" % fmt(now()),
                        "tasks=%d" % len(lines), ""] + lines)
                    okp, _ = write_ref("%s/%s" % (PLAN_NS, pid), payload)
                    print("自动发布免疫计划 %s（%d 条）：%s"
                          % (pid, len(lines), "ok" if okp else "FAIL"))
                    log("auto-dispatch %s n=%d" % (pid, len(lines)))
                    if okp:
                        # 发布之后立刻自己认领执行 —— 否则只是把活列出来，
                        # 不算自主闭环。cmd_run 内部自带六定律三关 + 机械门 +
                        # 独立验收，失败会记 failed 不会假装成功。
                        run_ns = argparse.Namespace(
                            plan=pid, executor=None, max_load=3, ttl_min=60, limit=0)
                        _run_and_gather(pid, run_ns)
    log("tick due=%d auto=%s" % (total, bool(args.auto)))
    return 0


# ── IMM-T33：工蜂式 idle 节点任务撮合(只读诊断)────────────────────────
# 背景：CLOCK.owner 现在只是亲和性提示；`owns_line()` 不再要求 owner 先
# 达到静默接管阈值。所有健康节点都能竞争短 scheduler lease，任务级 claim
# 和账本 CAS 负责防重复。这样 owner 忙、health 红或节点退出时，pending
# 不会在结构上失去流向其它节点的路径。
#
# 本命令不直接执行（不写 TASKS.md、不动 owner 字段）：保留只读扫描，
# 用来解释哪些 pending 仍未被任何节点 claim；真正的跨节点执行走既有的
# discover → plan → claim 三件套（CAS 抢，任何达标节点都能抢）。

MATCH_MIN_TRUST = "L2"   # TASKS.md 账本没有逐任务 min_trust 列(那是 discover
                          # 候选独有的字段，见 discover_candidates())；直接
                          # 线级任务只能拿一把通用尺子，L2 = HAAS≥0.5，蜂群里
                          # 任何自动执行的最低门槛(L1 是"每步确认"，不该被塞活)。


def _trust_order():
    return [name for name, _ in TRUST_LEVELS]


def _build_claim_index():
    """一次性批量读完 CLAIM_NS 全部 ref，建 task_id → (holder, expires) 索引。

    2026-07-31 修复（IMM-T33 上线当场撞出的第二个 IMM-T29 同类坑）：原
    `_task_live_claim` 每次调用都重新 `list_refs` + 逐条 `read_ref`（每条 2
    个 git 子进程），被 `cmd_match_idle` 按 due 任务数循环调用，退化成
    O(任务数 × claim ref 数) 的子进程风暴——跟 `haas_score` 之前的病灶是
    同一个模式，只是这次是"重复调用一个已经很贵的函数"而不是"函数自己贵"。
    复用 IMM-T29 已经修好的 `read_refs_batch()`，一个子进程读完全部 payload。
    """
    refs = list_refs(CLAIM_NS)
    batch = read_refs_batch(refs)
    index = {}
    if batch is None:
        for ref in refs:
            kv = parse_kv(read_ref(ref))
            _claim_index_add(index, kv)
        return index
    for ref, payload in batch.items():
        kv = parse_kv(payload or "")
        _claim_index_add(index, kv)
    return index


def _claim_index_add(index, kv):
    task_id = kv.get("task")
    if not task_id:
        return
    expires = parse_ts(kv.get("expires"))
    if expires and expires > now():
        index[task_id] = kv.get("holder") or "?"


def _task_live_claim(task_id, claim_index=None):
    """这个任务 id 是否已经在任何 plan 下被活跃 claim(未过期)——防重复分配。

    CLAIM_NS 的 ref 路径是 <plan>/<task_id>，但 plan 可以是任何字符串
    (免疫计划 imm-*、人工发布的 plan 等)；唯一能跨 plan 认出"同一个任务"
    的字段是 payload 里的 task=，所以扫全量而不是按路径猜 plan 前缀。

    传 `claim_index`（`_build_claim_index()` 的返回值）走 O(1) 查表；
    不传就退回原始逐条慢路（保持向后兼容，其它未来调用方不传也不会错，
    只是慢，不会算错）。
    """
    if claim_index is not None:
        holder = claim_index.get(task_id)
        return (True, holder) if holder else (False, "")
    for ref in list_refs(CLAIM_NS):
        kv = parse_kv(read_ref(ref))
        if kv.get("task") != task_id:
            continue
        expires = parse_ts(kv.get("expires"))
        if expires and expires > now():
            return True, kv.get("holder") or "?"
    return False, ""


def _node_busy_elsewhere(name, lines):
    """这个候选节点自己名下有没有正忙的线，或手上有没有未结的 ad-hoc claim。

    只看"活着"不看"忙不忙"就塞新活 = 用信任够格当理由制造第二个瓶颈，
    与本任务的失败模式清单("只判活着不判信任门槛")是同一类问题的另一面。
    """
    if node_load(name) > 0:
        return True, "手上有未结 ad-hoc claim(node_load>0)"
    for entry in lines:
        if entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
            continue
        if entry.get("owner") != name:
            continue
        if any(t.get("status") == "running" for t in load_tasks(entry["line"])):
            return True, "自己名下的线 %s 正在跑任务" % entry["line"]
    return False, ""


def cmd_match_idle(args):
    """撮合诊断：owner 忙碌 + 有未认领 pending + 蜂群有空闲达标节点 时报配对。

    三关缺一不报"match"(三态输出，不是布尔 有/无)：
      1. 该线确有未被任何节点活跃 claim 的 due pending 任务；
      2. 该线 owner 正忙(有 running 任务)——owner 不忙 = 正常心跳节奏会接住，
         报"skip"而不是"match"，不制造过度撮合的噪音；
      3. 候选节点 != owner、活着、自己不忙、声明的 executors 含该线要求的
         executor、且 HAAS trust_level ≥ MATCH_MIN_TRUST —— 四者任一不满足
         都不算"空闲可用"，逐条给出没匹配上的具体原因。
    永远不做：越过 CLOCK.md 的 owner 直接指派(那是 tick/advance_once 的职责，
    受 owns_line 分片保护)；本命令只print、不 write_ref、不改 TASKS.md。

    2026-07-31 修复：首版无条件 fetch_refs()，上线后独立复核发现 ref 规模涨到
    今晚的量级后直接卡 30s+ 零输出超时——跟 `trust` 命令踩的是同一个坑
    （IMM-T29），只是这次是新功能上线当场撞上，不是历史遗留。加 --no-fetch，
    诊断类命令默认不该强制拉网络。
    """
    if not getattr(args, "no_fetch", False):
        fetch_refs()
    _budget_start = time.time()
    MATCH_IDLE_TIME_BUDGET_SEC = 15
    _budget_hit = [False]

    def _over_budget():
        if time.time() - _budget_start > MATCH_IDLE_TIME_BUDGET_SEC:
            _budget_hit[0] = True
            return True
        return False

    nodes = read_swarm()
    lines = clock_lines()
    claim_index = _build_claim_index()
    if args.line:
        lines = [e for e in lines if e.get("line") == args.line]
        if not lines:
            print("unknown | 线 %s 不在 CLOCK.md 声明里" % args.line)
            return 1

    any_pending = False
    any_match = False
    for entry in lines:
        if entry.get("enabled", "no").lower() not in ("yes", "y", "true"):
            continue
        line = entry["line"]
        owner = entry.get("owner") or node_id()
        executor = entry.get("executor") or "human"
        tasks = load_tasks(line)
        due = due_tasks(line)

        unclaimed = []
        for t in due:
            if _over_budget():
                print("timeout | %s: 本地 ref 扫描超出 %ds 时间预算，已核验 %d/%d 条 due 任务后中止 "
                      "—— 不是没查到，是本地 git 子进程调用量太大查不完（IMM-T29 未修的根因）"
                      % (line, MATCH_IDLE_TIME_BUDGET_SEC, len(unclaimed), len(due)))
                break
            live, holder = _task_live_claim(t["id"], claim_index)
            if live:
                print("skip  | %s/%s 已被 %s 活跃 claim，不重复分配" % (line, t["id"], holder))
                continue
            unclaimed.append(t)
        if _budget_hit[0]:
            continue

        if not unclaimed:
            print("idle  | %s: 无未认领 pending 任务(due=%d，均已认领或本来无 due)"
                  % (line, len(due)))
            continue
        any_pending = True

        owner_busy = any(t.get("status") == "running" for t in tasks)
        if not owner_busy:
            print("skip  | %s: owner %s 未忙碌，正常心跳会接住(pending=%s)，不需要撮合"
                  % (line, owner, ",".join(t["id"] for t in unclaimed)))
            continue

        order = _trust_order()
        candidates = []
        rejected = []
        for name, prof in nodes.items():
            if _over_budget():
                rejected.append("(时间预算耗尽，剩余节点未核验，见 IMM-T29)")
                break
            if name == owner:
                continue
            alive, why_alive = node_alive(prof)
            if not alive:
                rejected.append("%s(不在线：%s)" % (name, why_alive))
                continue
            busy, why_busy = _node_busy_elsewhere(name, lines)
            if busy:
                rejected.append("%s(忙碌：%s)" % (name, why_busy))
                continue
            execs = (prof.get("executors") or "").split()
            if executor not in execs:
                rejected.append("%s(缺 executor=%s，本节点声明 %s)"
                                 % (name, executor, " ".join(execs) or "-"))
                continue
            haas, _facts = haas_score(name)
            trust = trust_level(haas)
            if order.index(trust) < order.index(MATCH_MIN_TRUST):
                rejected.append("%s(信任 %s HAAS %.3f 低于门槛 %s)"
                                 % (name, trust, haas, MATCH_MIN_TRUST))
                continue
            candidates.append((name, haas, trust))

        if not candidates:
            print("no-match | %s: owner %s 忙碌 + %d 条未认领(%s)，蜂群里没有空闲且达标的节点 —— %s"
                  % (line, owner, len(unclaimed), ",".join(t["id"] for t in unclaimed),
                     "；".join(rejected) if rejected else "蜂群里除 owner 外无其它可见节点"))
            continue

        candidates.sort(key=lambda c: -c[1])
        best_name, best_haas, best_trust = candidates[0]
        any_match = True
        for t in unclaimed:
            print("match | %s/%s ← 建议 %s（HAAS %.3f，%s）—— owner %s 忙碌；"
                  "本版本仅诊断不自动执行，真正撮合走 discover/plan/claim 把任务转入蜂群可认领池"
                  % (line, t["id"], best_name, best_haas, best_trust, owner))

    if _budget_hit[0]:
        print("\n结论：⚠️ 未跑完就撞时间预算——以上是部分核验结果，不是"
              "「确认无需撮合」，只是「没查完」，两者不同（DIMENSIONAL 律第三态）")
        return 2
    if not any_pending:
        print("\n结论：全蜂群(%s)当前无任何未认领 pending 任务 —— 无需撮合"
              % (args.line or "已扫描全部启用线"))
    elif not any_match:
        print("\n结论：存在未认领 pending 任务，但均为 owner 未忙碌(正常节奏自会处理)"
              " 或蜂群内无空闲且达标节点 —— 本拍无可执行撮合")
    return 0


def cmd_status(args):
    # [T12] 按线拆分任务计数（line_breakdown）：每条线一行自己的统计，
    # 再补一行 total=all —— 加总 ≠ 真相，跨线同名 id 撞车时加总会掩盖
    # 「这条线真的跑了多少」；T12 把 by_line / per_line 维度正式纳入视图。
    per_line = []  # [(line, counts, dict_fields)]
    overall = {}
    for entry in clock_lines():
        line = entry["line"]
        tasks = load_tasks(line)
        counts = {}
        for task in tasks:
            status = task.get("status", "?")
            counts[status] = counts.get(status, 0) + 1
            overall[status] = overall.get(status, 0) + 1
        per_line.append((line, entry, counts))
        print("%-16s enabled=%-4s executor=%-8s %s"
              % (line, entry.get("enabled"), entry.get("executor"),
                 " ".join("%s=%d" % kv for kv in sorted(counts.items())) or "（空表）"))
    # 末行 line_breakdown 总计（by_line 设计意图：可被人或机器切片读）
    print("%-16s %-22s %s"
          % ("── total all ──", "by_line=" + str(len(per_line)),
             " ".join("%s=%d" % kv for kv in sorted(overall.items())) or "（空表）"))
    if args and getattr(args, "json", False):
        import json as _json
        print(_json.dumps(
            {"by_line": [{"line": ln, "counts": c} for ln, _, c in per_line],
             "overall": overall},
            ensure_ascii=False, indent=2))
    return 0


