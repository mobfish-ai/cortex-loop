        "--source-surface", default="cli",
        choices=["skill", "cli", "api", "cockpit"],
        help="record the observation source only; do not change the canonical semantic projection",
    )
    rc.set_defaults(func=cmd_run_contract)

    ta = sub.add_parser("task-add", help="atomic task generator protected by the contract gate")
    ta.add_argument("--line", required=True)
    ta.add_argument("--id", help="by default auto-generate the next sequential Tn")
