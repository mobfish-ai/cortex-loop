    ta.add_argument("--failure-modes", required=True)
    ta.add_argument("--artifact-paths", required=True)
    ta.add_argument("--short-test", required=True)
    ta.add_argument("--leverage", default="unknown",
                    choices=["high", "medium", "low", "unknown"])
    ta.add_argument("--cost-estimate", default="unknown",
                    choices=["S", "M", "L", "unknown"])
    ta.add_argument("--resource-class", default="unknown",
                    choices=["local-only", "llm-light", "llm-heavy", "human-gate", "unknown"])
